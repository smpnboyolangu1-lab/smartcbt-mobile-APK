<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Display Ruang Guru - Monitoring Kelas Kosong</title>
    <script src="/js/tailwind.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0F172A',
                        cardBg: '#1E293B',
                        neonBlue: '#38BDF8',
                        neonRed: '#F43F5E',
                        neonGreen: '#10B981',
                        neonAmber: '#F59E0B'
                    },
                    animation: {
                        pulsefast: 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0F172A; color: #E2E8F0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .amber-alert { animation: pulsefast 1.5s infinite; border-left: 4px solid #F59E0B; background-color: rgba(245, 158, 11, 0.1); }
        .red-alert { animation: pulsefast 1s infinite; border-left: 4px solid #F43F5E; background-color: rgba(244, 63, 94, 0.1); }
        .green-status { border-left: 4px solid #10B981; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1E293B; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">
    
    <!-- Top Header -->
    <header class="bg-cardBg shadow-lg p-4 flex justify-between items-center border-b border-gray-700">
        <div class="flex items-center gap-4">
            <div class="bg-blue-600 p-2 rounded-lg">
                <i class="fas fa-desktop text-white text-2xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white tracking-wider">COMMAND CENTER: MONITORING KELAS</h1>
                <p class="text-sm text-gray-400">SMART CBT SCHOOL - PUSAT DATA WAKUR & PIKET</p>
            </div>
        </div>
        <div class="text-right">
            <h2 id="liveClock" class="text-3xl font-mono font-bold text-neonBlue">00:00:00</h2>
            <p id="liveDate" class="text-sm text-gray-400 uppercase font-semibold">SENIN, 1 JANUARI 2026</p>
        </div>
    </header>

    <!-- Banner Guru Piket Penanggung Jawab Hari Ini -->
    <div class="bg-gray-800/95 border-b border-gray-700 px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 shadow-inner">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="bg-amber-500/20 text-amber-300 border border-amber-500/50 text-xs font-black uppercase px-3 py-1 rounded-lg flex items-center gap-2 shadow-sm">
                <i class="fas fa-user-shield text-amber-400 animate-pulse"></i> PENANGGUNG JAWAB GURU PIKET HARI INI:
            </span>
            <div id="todayPiketBadges" class="flex flex-wrap items-center gap-2 text-xs">
                <span class="text-gray-400 italic">Memeriksa penugasan guru piket...</span>
            </div>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-400 font-semibold">
            <i class="fas fa-calendar-check text-neonGreen"></i>
            <span id="todayPiketCount">0 Guru Bertugas</span>
        </div>
    </div>

    <!-- ALERT BANNER DARURAT JAM KOSONG (REAL-TIME COMMAND CENTER) -->
    <div id="activeAlertBanner" class="hidden bg-gradient-to-r from-rose-950 via-red-900 to-rose-950 border-b-2 border-rose-500 px-6 py-2.5 items-center justify-between shadow-2xl animate-pulse">
        <div class="flex items-center gap-3">
            <span class="text-2xl animate-bounce">🚨</span>
            <div>
                <p class="font-black text-white text-sm tracking-wide" id="alertBannerText">
                    PERINGATAN KELAS KOSONG: Terdeteksi Laporan Jam Kosong Menunggu Penanganan Guru Piket!
                </p>
                <p class="text-[11px] text-rose-200" id="alertBannerSub">
                    Sistem mendeteksi kelas belum terisi guru pengajar. Segera lakukan penugasan Guru Inval.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="switchViewMode('table')" class="bg-rose-600 hover:bg-rose-500 text-white font-black px-3.5 py-1.5 rounded-lg text-xs shadow-lg transition-all flex items-center gap-1.5">
                <i class="fas fa-user-shield"></i> <span>Tinjau & Tugaskan Inval</span>
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1 p-6 overflow-hidden flex flex-col gap-4">
        
        <!-- Summary Cards -->
        <div class="grid grid-cols-4 gap-4 mb-2">
            <div class="bg-cardBg p-4 rounded-xl border border-gray-700 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-blue-900/50 flex items-center justify-center text-neonBlue"><i class="fas fa-chalkboard-teacher text-xl"></i></div>
                <div><p class="text-gray-400 text-xs font-bold">TOTAL LAPORAN HARI INI</p><h3 id="statTotal" class="text-2xl font-bold">0</h3></div>
            </div>
            <div class="bg-cardBg p-4 rounded-xl border border-gray-700 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-amber-900/50 flex items-center justify-center text-neonAmber"><i class="fas fa-exclamation-triangle text-xl"></i></div>
                <div><p class="text-gray-400 text-xs font-bold">MENUNGGU PENANGANAN</p><h3 id="statPending" class="text-2xl font-bold text-neonAmber">0</h3></div>
            </div>
            <div class="bg-cardBg p-4 rounded-xl border border-gray-700 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-green-900/50 flex items-center justify-center text-neonGreen"><i class="fas fa-check-circle text-xl"></i></div>
                <div><p class="text-gray-400 text-xs font-bold">SUDAH DI-INVAL / DITANGANI</p><h3 id="statResolved" class="text-2xl font-bold text-neonGreen">0</h3></div>
            </div>
            <div class="bg-cardBg p-4 rounded-xl border border-gray-700 flex items-center justify-between cursor-pointer hover:bg-gray-700 transition" onclick="triggerAudioTest()">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center text-gray-400"><i class="fas fa-volume-up text-xl"></i></div>
                    <div><p class="text-gray-400 text-xs font-bold">STATUS AUDIO</p><h3 class="text-lg font-bold text-white">Audio Aktif</h3></div>
                </div>
            </div>
        </div>

        <!-- View Mode Switcher Toolbar -->
        <div class="flex items-center justify-between bg-cardBg/80 border border-gray-700 px-4 py-2 rounded-xl text-xs">
            <div class="flex items-center gap-2">
                <span class="text-gray-400 font-bold uppercase tracking-wider"><i class="fas fa-sliders-h text-neonBlue mr-1"></i> Tampilan Layar:</span>
                <div class="flex bg-gray-900 p-1 rounded-lg border border-gray-700">
                    <button id="btnViewCctv" onclick="switchViewMode('cctv')" class="px-4 py-1.5 rounded font-bold transition-all bg-blue-600 text-white shadow">
                        <i class="fas fa-video mr-1.5"></i> 📺 MODE CCTV GRID (MULTI-MONITOR)
                    </button>
                    <button id="btnViewTable" onclick="switchViewMode('table')" class="px-4 py-1.5 rounded font-bold transition-all text-gray-400 hover:text-white">
                        <i class="fas fa-list mr-1.5"></i> 📋 MODE TABEL LAPORAN
                    </button>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-neonGreen font-semibold">
                    <span class="w-2.5 h-2.5 rounded-full bg-neonGreen animate-pulse"></span>
                    <span>Multi-Cam Security Active</span>
                </span>
                <span class="text-gray-500">|</span>
                <span class="text-gray-400">Total Ruang: <b class="text-white">11 Kelas</b></span>
            </div>
        </div>

        <!-- 1. CCTV MULTI-MONITOR SECURITY GRID -->
        <div id="cctvGridWrapper" class="bg-cardBg rounded-xl border border-gray-700 flex-1 overflow-hidden flex flex-col shadow-2xl">
            <div class="p-3 bg-gray-900 border-b border-gray-800 flex justify-between items-center text-xs">
                <div class="flex items-center gap-2 font-mono text-neonBlue font-bold">
                    <i class="fas fa-shield-alt text-neonBlue"></i> LIVE CCTV SECURITY WALL • 11 KELAS
                </div>
                <div class="flex items-center gap-3 text-[11px] font-mono">
                    <span class="text-neonGreen flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-neonGreen"></span> NORMAL (TERISI)</span>
                    <span class="text-neonAmber flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-neonAmber"></span> ADA TUGAS</span>
                    <span class="text-neonRed flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-neonRed animate-pulse"></span> KELAS KOSONG!</span>
                    <span class="text-blue-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-400"></span> DI-INVAL</span>
                </div>
            </div>
            <div id="cctvGridContainer" class="flex-1 overflow-y-auto p-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 bg-black/40">
                <!-- CCTV Monitor Tiles injected by JS -->
            </div>
        </div>

        <!-- 2. DATA TABLE VIEW -->
        <div id="tableViewWrapper" class="bg-cardBg rounded-xl border border-gray-700 flex-1 overflow-hidden flex flex-col shadow-2xl hidden">
            <div class="p-4 bg-gray-800/50 border-b border-gray-700 flex justify-between items-center">
                <h3 class="font-bold text-white uppercase text-sm"><i class="fas fa-list text-neonBlue mr-2"></i> ANTRIAN & STATUS KELAS SAAT INI</h3>
                <span class="text-xs text-gray-400 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-neonGreen animate-pulse"></span> Live Stream Active</span>
            </div>
            <div class="flex-1 overflow-y-auto p-0">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-800/80 text-xs uppercase font-bold text-gray-400 sticky top-0 z-10 shadow">
                        <tr>
                            <th class="p-4 py-3 border-b border-gray-700 w-16 text-center">Waktu</th>
                            <th class="p-4 py-3 border-b border-gray-700 w-24 text-center">Kelas</th>
                            <th class="p-4 py-3 border-b border-gray-700 w-48">Jam & Mapel</th>
                            <th class="p-4 py-3 border-b border-gray-700">Guru Terjadwal</th>
                            <th class="p-4 py-3 border-b border-gray-700">Status Tugas / Keberadaan</th>
                            <th class="p-4 py-3 border-b border-gray-700 w-64 text-center">Tindakan Piket / Inval</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="text-sm divide-y divide-gray-800">
                        <!-- Data rows will be injected here via SSE -->
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Invisible Audio Element -->
    <audio id="chimeSound" preload="auto">
        <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
    </audio>

    <!-- Handle Modal for Piket -->
    <div id="modalHandle" class="fixed inset-0 bg-black/80 hidden flex items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-cardBg rounded-xl border border-gray-600 shadow-2xl w-[500px] overflow-hidden transform transition-all">
            <div class="bg-gray-800 p-4 border-b border-gray-700 flex justify-between items-center">
                <h3 class="font-bold text-white text-lg"><i class="fas fa-user-edit text-neonAmber mr-2"></i> Tindak Lanjut Piket</h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-white"><i class="fas fa-times text-xl"></i></button>
            </div>
            <div class="p-6 flex flex-col gap-4">
                <input type="hidden" id="handleId">
                <div class="bg-gray-900 p-3 rounded-lg border border-gray-700 text-sm">
                    <p class="text-gray-400">Kelas: <span id="mKelas" class="font-bold text-white"></span></p>
                    <p class="text-gray-400">Mapel: <span id="mMapel" class="font-bold text-white"></span></p>
                </div>
                
                <div>
                    <label class="block text-xs font-bold text-gray-400 mb-1">PILIH TINDAKAN</label>
                    <select id="actionType" class="w-full bg-gray-900 border border-gray-600 text-white rounded p-2 focus:border-neonBlue outline-none" onchange="toggleInval(this.value)">
                        <option value="GURU_INVAL_ASSIGNED">📌 Tugaskan Guru Inval (Pengganti)</option>
                        <option value="TUGAS_MANDIRI">📚 Beri Tugas Mandiri tanpa Inval</option>
                    </select>
                </div>

                <div id="invalWrapper">
                    <label class="block text-xs font-bold text-gray-400 mb-1">PILIH GURU INVAL (STANDBY)</label>
                    <select id="substituteTeacher" class="w-full bg-gray-900 border border-gray-600 text-white rounded p-2 focus:border-neonBlue outline-none">
                        <option value="">-- Pilih Guru --</option>
                        <option value="Guru Piket Hari Ini">Guru Piket Hari Ini (Standby)</option>
                        <option value="Bpk. Hendra, S.Kom">Bpk. Hendra, S.Kom (Standby)</option>
                        <option value="Ibu Desy, M.Pd">Ibu Desy, M.Pd (Standby)</option>
                        <option value="Tim Piket / Kurikulum">Tim Piket Umum</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-400 mb-1">CATATAN / INSTRUKSI TAMBAHAN</label>
                    <textarea id="substituteNotes" rows="2" class="w-full bg-gray-900 border border-gray-600 text-white rounded p-2 focus:border-neonBlue outline-none" placeholder="Opsional..."></textarea>
                </div>
                
                <button onclick="submitHandle()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg shadow-lg transition-colors mt-2">
                    SIMPAN TINDAKAN
                </button>
            </div>
        </div>
    </div>

    <script>
        // Clock
        setInterval(() => {
            const now = new Date();
            document.getElementById('liveClock').textContent = now.toLocaleTimeString('id-ID', { hour12: false });
            document.getElementById('liveDate').textContent = now.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        }, 1000);

        const chime = document.getElementById('chimeSound');
        function triggerAudioTest() {
            chime.play().catch(e => console.log('Autoplay blocked:', e));
            Swal.fire({ title: 'Audio Diizinkan', text: 'Sistem notifikasi suara aktif untuk monitor ini.', icon: 'success', background: '#1E293B', color: '#fff' });
        }
        
        let lastKnownId = null; // To prevent duplicate chimes on first load

        let lastKnownId = null; // To prevent duplicate chimes on first load

        // Load initial data
        async function loadReports(playChime = false) {
            try {
                // 1. Ambil status real-time seluruh ruang kelas (Hijau/Merah/Kuning/Biru)
                const resMon = await fetch('/api/piket/class-monitoring-status');
                const monData = await resMon.json();
                if (monData.classes) {
                    renderCctvGrid(monData.classes);
                }

                // 2. Ambil daftar laporan jam kosong untuk tabel & ringkasan
                const res = await fetch('/api/piket/empty-class-reports');
                const data = await res.json();
                renderTable(data, playChime);
            } catch(e) { console.error('Gagal memuat data:', e); }
        }

        function switchViewMode(mode) {
            const btnCctv = document.getElementById('btnViewCctv');
            const btnTable = document.getElementById('btnViewTable');
            const cctvWrapper = document.getElementById('cctvGridWrapper');
            const tableWrapper = document.getElementById('tableViewWrapper');

            if (mode === 'cctv') {
                cctvWrapper.classList.remove('hidden');
                tableWrapper.classList.add('hidden');
                btnCctv.className = 'px-4 py-1.5 rounded font-bold transition-all bg-blue-600 text-white shadow';
                btnTable.className = 'px-4 py-1.5 rounded font-bold transition-all text-gray-400 hover:text-white';
            } else {
                cctvWrapper.classList.add('hidden');
                tableWrapper.classList.remove('hidden');
                btnTable.className = 'px-4 py-1.5 rounded font-bold transition-all bg-blue-600 text-white shadow';
                btnCctv.className = 'px-4 py-1.5 rounded font-bold transition-all text-gray-400 hover:text-white';
            }
            try { localStorage.setItem('commandCenterViewMode', mode); } catch(e){}
        }

        function renderCctvGrid(classes) {
            const grid = document.getElementById('cctvGridContainer');
            if (!grid) return;
            grid.innerHTML = '';

            const nowStr = new Date().toLocaleTimeString('id-ID', { hour12: false });

            classes.forEach((cls) => {
                const tile = document.createElement('div');
                tile.className = 'relative rounded-xl overflow-hidden border transition-all duration-300 flex flex-col justify-between shadow-lg min-h-[200px]';

                if (cls.status === 'GREEN') {
                    // 🟢 HIJAU: GURU HADIR DI KELAS & KBM AKTIF
                    tile.className += ' border-emerald-500 bg-emerald-950/30 green-status shadow-emerald-950/50';
                    tile.innerHTML = `
                        <div class="bg-emerald-900/80 text-white px-3 py-1.5 flex justify-between items-center text-[11px] font-mono border-b border-emerald-500/50">
                            <span class="font-bold flex items-center gap-1.5 text-emerald-200">
                                <i class="fas fa-video text-emerald-300"></i> ${cls.cam} • ${cls.className}
                            </span>
                            <span class="flex items-center gap-1 text-emerald-300 font-bold">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> 🟢 GURU HADIR
                            </span>
                        </div>
                        <div class="p-3.5 flex-1 flex flex-col justify-center items-center text-center">
                            <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/50 text-[10.5px] font-black px-3 py-1 rounded-full uppercase tracking-wider mb-2">
                                <i class="fas fa-check-circle mr-1"></i> KBM AKTIF & GURU HADIR
                            </span>
                            <div class="text-sm font-black text-white">${cls.subjectName}</div>
                            <div class="text-xs text-emerald-200 font-bold mt-0.5"><i class="fas fa-chalkboard-teacher mr-1"></i> ${cls.teacherName}</div>
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-900/60 border border-emerald-500/40 text-[11px] font-mono text-emerald-300 font-bold mt-1.5">
                                <i class="fas fa-clock text-emerald-400"></i> Datang: ${cls.checkInTime || cls.inTimeStr || '07:05 WIB'}
                            </div>
                            <p class="text-[10px] text-gray-400 mt-1">${cls.timeRange ? '🕒 ' + cls.timeRange : ''} • ${cls.details}</p>
                        </div>
                        <div class="bg-black/60 px-3 py-1 text-[10px] font-mono text-emerald-400 flex justify-between">
                            <span>FPS: 30 • TERISI</span>
                            <span>${nowStr}</span>
                        </div>
                    `;
                } else if (cls.status === 'RED') {
                    // 🚨 MERAH: KELAS KOSONG! (Laporan Siswa ATAU >10 Menit Tanpa Guru)
                    tile.className += ' border-rose-500 red-alert animate-pulsefast bg-rose-950/40 shadow-rose-950/60';
                    tile.innerHTML = `
                        <div class="bg-rose-900/90 text-white px-3 py-1.5 flex justify-between items-center text-[11px] font-mono border-b border-rose-500/50">
                            <span class="font-bold flex items-center gap-1.5">
                                <i class="fas fa-video text-rose-300"></i> ${cls.cam} • ${cls.className}
                            </span>
                            <span class="flex items-center gap-1 text-rose-200 font-bold">
                                <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span> 🚨 KOSONG
                            </span>
                        </div>
                        <div class="p-3 flex-1 flex flex-col justify-center">
                            <div class="bg-rose-600/30 border border-rose-500/60 rounded-lg p-2 text-center mb-2">
                                <div class="text-xs font-black text-rose-200 uppercase flex items-center justify-center gap-1.5">
                                    <i class="fas fa-exclamation-triangle text-amber-300"></i> ${cls.badge}
                                </div>
                                <div class="text-[11px] text-white font-bold mt-0.5">${cls.subjectName}</div>
                                <div class="text-[10px] text-gray-300">${cls.periodIndex || 'Jam Pelajaran Ini'}</div>
                            </div>
                            <div class="text-[11px] text-gray-300 mb-1">
                                <span class="text-gray-400">Guru Terjadwal:</span> <b class="text-rose-200">${cls.teacherName}</b>
                            </div>
                            ${cls.reportedBy ? `
                            <div class="text-[10px] text-amber-300 bg-amber-950/60 border border-amber-500/40 rounded px-2 py-1 mb-1 font-semibold">
                                <i class="fas fa-bullhorn text-amber-400 mr-1"></i> Pelapor: <b>${cls.reportedBy}</b>
                            </div>
                            ` : ''}
                            <div class="text-[10px] text-amber-300 font-semibold mb-2">
                                ${cls.hasAssignment ? '📚 Ada Tugas: ' + (cls.assignmentDetails || 'Tugas Mandiri') : '⚠️ ' + cls.details}
                            </div>
                            ${cls.reportId ? `
                            <button onclick="openHandleModal('${cls.reportId}', '${cls.className}', '${cls.subjectName}')" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-1.5 px-3 rounded-lg text-xs shadow-md transition-transform hover:scale-105 flex items-center justify-center gap-1.5">
                                <i class="fas fa-user-edit"></i> TUGASKAN INVAL
                            </button>
                            ` : `
                            <button onclick="switchViewMode('table')" class="bg-rose-700 hover:bg-rose-600 text-white font-bold py-1.5 px-3 rounded-lg text-xs shadow-md flex items-center justify-center gap-1.5">
                                <i class="fas fa-bullhorn"></i> TINJAU KELAS KOSONG
                            </button>
                            `}
                        </div>
                        <div class="bg-black/60 px-3 py-1 text-[10px] font-mono text-rose-400 flex justify-between">
                            <span>FPS: 30 • ALARM</span>
                            <span>${nowStr}</span>
                        </div>
                    `;
                } else if (cls.status === 'AMBER') {
                    // ⏳ AMBER / KUNING: MENUNGGU GURU (Baru Dimulai < 10 Menit)
                    tile.className += ' border-amber-500/60 bg-amber-950/30 amber-alert';
                    tile.innerHTML = `
                        <div class="bg-amber-900/70 text-amber-200 px-3 py-1.5 flex justify-between items-center text-[11px] font-mono border-b border-amber-500/40">
                            <span class="font-bold flex items-center gap-1.5">
                                <i class="fas fa-video text-amber-300"></i> ${cls.cam} • ${cls.className}
                            </span>
                            <span class="flex items-center gap-1 text-amber-300 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> ⏳ MENUNGGU GURU
                            </span>
                        </div>
                        <div class="p-3.5 flex-1 flex flex-col justify-center items-center text-center">
                            <span class="bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold px-2.5 py-1 rounded-md mb-2">
                                ⏳ JAM DIMULAI (${cls.elapsedMinutes || 0} MENIT LALU)
                            </span>
                            <div class="text-xs font-bold text-white mb-0.5">${cls.subjectName}</div>
                            <div class="text-[11px] text-gray-300">Guru: <b class="text-amber-200">${cls.teacherName}</b></div>
                            <p class="text-[10px] text-gray-400 mt-1">${cls.details}</p>
                        </div>
                        <div class="bg-black/60 px-3 py-1 text-[10px] font-mono text-amber-400 flex justify-between">
                            <span>FPS: 30 • MENUNGGU</span>
                            <span>${nowStr}</span>
                        </div>
                    `;
                } else if (cls.status === 'BLUE') {
                    // 🟦 DITANGANI GURU INVAL
                    tile.className += ' border-blue-500/60 bg-blue-950/30';
                    tile.innerHTML = `
                        <div class="bg-blue-900/70 text-blue-200 px-3 py-1.5 flex justify-between items-center text-[11px] font-mono border-b border-blue-600/40">
                            <span class="font-bold flex items-center gap-1.5">
                                <i class="fas fa-video text-blue-300"></i> ${cls.cam} • ${cls.className}
                            </span>
                            <span class="flex items-center gap-1 text-neonGreen font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-neonGreen"></span> INVAL
                            </span>
                        </div>
                        <div class="p-3.5 flex-1 flex flex-col justify-center items-center text-center">
                            <span class="bg-blue-500/20 text-blue-300 border border-blue-500/40 text-[10px] font-bold px-2 py-1 rounded-md mb-2">
                                <i class="fas fa-check-circle mr-1"></i> DITANGANI GURU INVAL
                            </span>
                            <div class="text-xs font-bold text-white mb-0.5">${cls.subjectName}</div>
                            <div class="text-[11px] text-gray-300">Inval: <b class="text-blue-300">${cls.teacherName}</b></div>
                            <p class="text-[10px] text-gray-400 mt-1">${cls.details}</p>
                        </div>
                        <div class="bg-black/60 px-3 py-1 text-[10px] font-mono text-gray-400 flex justify-between">
                            <span>FPS: 30 • INVAL</span>
                            <span>${nowStr}</span>
                        </div>
                    `;
                } else {
                    // 🔘 IDLE: TIDAK ADA JADWAL KBM
                    tile.className += ' border-gray-800 bg-gray-900/80 hover:border-gray-700';
                    tile.innerHTML = `
                        <div class="bg-gray-950/80 text-gray-400 px-3 py-1.5 flex justify-between items-center text-[11px] font-mono border-b border-gray-800">
                            <span class="font-bold text-gray-300 flex items-center gap-1.5">
                                <i class="fas fa-video text-gray-500"></i> ${cls.cam} • ${cls.className}
                            </span>
                            <span class="text-gray-500 text-[10px]">
                                IDLE
                            </span>
                        </div>
                        <div class="p-3.5 flex-1 flex flex-col justify-center items-center text-center">
                            <div class="w-10 h-10 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-gray-500 mb-2">
                                <i class="fas fa-door-closed text-lg"></i>
                            </div>
                            <span class="bg-gray-800 text-gray-400 text-[10px] font-bold px-2.5 py-1 rounded-full">
                                TIDAK ADA JADWAL KBM
                            </span>
                            <p class="text-[11px] text-gray-400 mt-2">Ruang Kelas ${cls.className}</p>
                            <p class="text-[10px] text-gray-500">${cls.details || 'Istirahat / di luar jam sekolah'}</p>
                        </div>
                        <div class="bg-black/60 px-3 py-1 text-[10px] font-mono text-gray-500 flex justify-between">
                            <span>CH: ${cls.cam}</span>
                            <span>${nowStr}</span>
                        </div>
                    `;
                }

                grid.appendChild(tile);
            });
        }

        function renderTable(data, playChime = false) {
            // Render CCTV Grid sekaligus
            renderCctvGrid(data);

            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            
            let total = data.length;
            let pending = 0;
            let resolved = 0;
            let hasNewPending = false;

            data.forEach((r, idx) => {
                if (r.status === 'PENDING') pending++;
                else resolved++;

                if (r.status === 'PENDING' && idx === 0 && r.id !== lastKnownId) {
                    hasNewPending = true;
                    lastKnownId = r.id;
                }

                const d = new Date(r.createdAt);
                const timeStr = d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                
                let rowClass = '';
                let statusBadge = '';
                let actionBtn = '';

                if (r.status === 'PENDING') {
                    rowClass = r.hasAssignment ? 'amber-alert' : 'red-alert';
                    statusBadge = `<span class="bg-amber-500/20 text-amber-400 px-3 py-1 rounded-full text-xs font-bold border border-amber-500/50"><i class="fas fa-spinner fa-spin mr-1"></i> MENUNGGU PENANGANAN</span>`;
                    actionBtn = `<button onclick="openHandleModal('${r.id}', '${r.className}', '${r.subjectName}')" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded font-bold text-xs shadow-lg transition-transform hover:scale-105">📌 TUGASKAN INVAL</button>`;
                } else {
                    rowClass = 'green-status';
                    const invalName = r.substituteTeacher || 'Guru Piket';
                    statusBadge = `<span class="bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full text-xs font-bold border border-emerald-500/50"><i class="fas fa-check mr-1"></i> DITANGANI INVAL: ${invalName}</span>`;
                    actionBtn = `<span class="text-gray-500 text-xs italic"><i class="fas fa-lock"></i> Selesai ditangani</span>`;
                }

                let tugasHtml = r.hasAssignment 
                    ? `<div class="mt-1 text-xs text-amber-300 font-semibold"><i class="fas fa-file-alt mr-1"></i> ADA TUGAS: ${r.assignmentDetails || 'LKS/Tulis'}</div>`
                    : `<div class="mt-1 text-xs text-red-400 font-semibold"><i class="fas fa-times-circle mr-1"></i> TIDAK ADA TUGAS / INFO</div>`;

                let reporterBadge = '';
                if (r.reporterName) {
                    const rep = r.reporterName;
                    let icon = 'fas fa-bullhorn';
                    let badgeClass = 'bg-sky-500/20 text-sky-300 border border-sky-400/40';
                    if (rep.includes('Ketua Kelas') && !rep.includes('Wakil')) {
                        icon = 'fas fa-crown text-amber-300';
                        badgeClass = 'bg-amber-500/25 text-amber-200 border border-amber-400/60 shadow-sm';
                    } else if (rep.includes('Wakil')) {
                        icon = 'fas fa-medal text-cyan-300';
                        badgeClass = 'bg-cyan-500/25 text-cyan-200 border border-cyan-400/60';
                    } else if (rep.includes('Sekretaris')) {
                        icon = 'fas fa-feather-alt text-purple-300';
                        badgeClass = 'bg-purple-500/25 text-purple-200 border border-purple-400/60';
                    } else if (rep.includes('Bendahara')) {
                        icon = 'fas fa-coins text-emerald-300';
                        badgeClass = 'bg-emerald-500/25 text-emerald-200 border border-emerald-400/60';
                    }
                    reporterBadge = `<div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-black ${badgeClass}"><i class="${icon}"></i> <span>${rep}</span></div>`;
                }

                const tr = document.createElement('tr');
                tr.className = `hover:bg-gray-800/50 transition-colors ${rowClass}`;
                tr.innerHTML = `
                    <td class="p-4 border-b border-gray-700/50 text-center font-mono text-gray-300">${timeStr}</td>
                    <td class="p-4 border-b border-gray-700/50 text-center">
                        <span class="bg-blue-900 text-blue-200 px-3 py-1 rounded font-bold border border-blue-700 text-base shadow-inner">${r.className}</span>
                        ${reporterBadge}
                    </td>
                    <td class="p-4 border-b border-gray-700/50">
                        <div class="font-bold text-white">${r.subjectName}</div>
                        <div class="text-xs text-gray-400 mt-1"><i class="far fa-clock"></i> ${r.periodLesson}</div>
                    </td>
                    <td class="p-4 border-b border-gray-700/50">
                        <div class="font-semibold text-gray-200"><i class="fas fa-chalkboard-teacher text-gray-500 mr-1"></i> ${r.scheduledTeacher}</div>
                    </td>
                    <td class="p-4 border-b border-gray-700/50">
                        <div class="font-semibold text-gray-300">${r.teacherStatus.replace('_', ' ')}</div>
                        ${tugasHtml}
                    </td>
                    <td class="p-4 border-b border-gray-700/50 text-center flex flex-col gap-2 items-center justify-center h-full pt-6">
                        <div>${statusBadge}</div>
                        <div>${actionBtn}</div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('statTotal').innerText = total;
            document.getElementById('statPending').innerText = pending;
            document.getElementById('statResolved').innerText = resolved;

            // Update Active Alert Banner
            const alertBanner = document.getElementById('activeAlertBanner');
            const alertText = document.getElementById('alertBannerText');
            if (pending > 0) {
                if (alertBanner) {
                    alertBanner.classList.remove('hidden');
                    alertBanner.classList.add('flex');
                }
                const pendingReports = data.filter(r => r.status === 'PENDING');
                const classesList = pendingReports.map(r => r.className).join(', ');
                if (alertText) alertText.innerHTML = `PERINGATAN KELAS KOSONG (${pending} Ruang): Ruang Kelas <span class="text-amber-300 font-bold">${classesList}</span> belum ada guru & memerlukan penugasan Inval!`;
            } else {
                if (alertBanner) {
                    alertBanner.classList.add('hidden');
                    alertBanner.classList.remove('flex');
                }
            }

            if (playChime && hasNewPending) {
                const latestPending = data.find(r => r.status === 'PENDING');
                if (latestPending) {
                    showEmptyClassAlert(latestPending);
                }
            }
        }

        let alertedReportIds = new Set();
        function showEmptyClassAlert(r) {
            if (!r || alertedReportIds.has(r.id)) return;
            alertedReportIds.add(r.id);

            // Play Chime
            chime.play().catch(e => console.log('Autoplay blocked', e));

            // Speak out loud (Web Speech API)
            if ('speechSynthesis' in window) {
                try {
                    const msg = new SpeechSynthesisUtterance(`Perhatian! Laporan jam kosong baru di Kelas ${r.className}, mata pelajaran ${r.subjectName}. Mohon guru piket segera menindaklanjuti.`);
                    msg.lang = 'id-ID';
                    window.speechSynthesis.speak(msg);
                } catch(e) {}
            }

            Swal.fire({
                title: '<div class="flex items-center justify-center gap-2 text-rose-500 font-black text-xl animate-pulse"><i class="fas fa-exclamation-triangle"></i> PERINGATAN KELAS KOSONG!</div>',
                html: `
                    <div class="text-left bg-gray-950 p-4 rounded-xl border border-rose-500/60 shadow-lg text-xs space-y-2 mt-3 font-sans">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                            <span class="text-gray-400 font-bold uppercase">Ruang Kelas:</span>
                            <span class="bg-blue-600 text-white font-black text-sm px-3 py-0.5 rounded-lg shadow">${r.className}</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                            <span class="text-gray-400 font-bold uppercase">Mata Pelajaran:</span>
                            <span class="font-bold text-neonBlue text-sm">${r.subjectName}</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                            <span class="text-gray-400 font-bold uppercase">Jam Pelajaran:</span>
                            <span class="font-mono text-amber-300 font-bold">${r.periodLesson || 'Jam KBM Hari Ini'}</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                            <span class="text-gray-400 font-bold uppercase">Guru Terjadwal:</span>
                            <span class="text-white font-semibold">${r.scheduledTeacher || '-'}</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                            <span class="text-gray-400 font-bold uppercase">Status Guru:</span>
                            <span class="text-rose-400 font-black uppercase px-2 py-0.5 bg-rose-950/80 border border-rose-600/40 rounded">${(r.teacherStatus || 'TIDAK_HADIR').replace(/_/g, ' ')}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400 font-bold uppercase">Keterangan / Tugas:</span>
                            <span class="${r.hasAssignment ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold'}">${r.hasAssignment ? 'Ada: ' + (r.assignmentDetails || 'Tugas Terlampir') : 'Belum Ada Tugas'}</span>
                        </div>
                    </div>
                    <p class="text-xs text-amber-300 mt-3 font-semibold text-center">
                        ⚠️ Laporan jam kosong baru terdeteksi! Mohon Guru Piket segera menugaskan Guru Inval.
                    </p>
                `,
                icon: 'warning',
                iconColor: '#F43F5E',
                showCancelButton: true,
                confirmButtonColor: '#2563EB',
                cancelButtonColor: '#475569',
                confirmButtonText: '<i class="fas fa-user-shield mr-1"></i> Tindak Lanjuti (Tugaskan Inval)',
                cancelButtonText: '<i class="fas fa-eye mr-1"></i> Tinjau Layar',
                background: '#0F172A',
                color: '#F8FAFC',
                allowOutsideClick: false,
                backdrop: 'rgba(244, 63, 94, 0.25)'
            }).then((res) => {
                if (res.isConfirmed) {
                    openHandleModal(r.id, r.className, r.subjectName);
                }
            });
        }

        // SSE Listener
        const source = new EventSource('/api/piket/empty-class-stream');
        source.onmessage = (event) => {
            try {
                const eData = JSON.parse(event.data);
                loadReports(eData.type === 'EMPTY_CLASS_REPORTED');
                if (eData.report && eData.type === 'EMPTY_CLASS_REPORTED') {
                    showEmptyClassAlert(eData.report);
                }
            } catch(err) {
                loadReports(false);
            }
        };

        // Socket.IO Real-time Listener (Room Handover & Jadwal KBM)
        try {
            if (typeof io !== 'undefined') {
                const socket = io();
                socket.on('room_handover_update', (data) => {
                    console.log('⚡ [Socket] Room handover update received:', data);
                    loadReports(false);
                });
                socket.on('schedule_updated', (data) => {
                    console.log('⚡ [Socket] Schedule updated:', data);
                    loadReports(false);
                });
            }
        } catch(sockErr) {
            console.warn('Socket.IO init notice:', sockErr);
        }

        // Auto-refresh interval setiap 15 detik untuk deteksi otomatis kelas kosong >10 menit
        setInterval(() => {
            loadReports(false);
        }, 15000);

        // Modal Logic
        function openHandleModal(id, kelas, mapel) {
            // Need a dummy token since we require JWT for actions (In real app, Guru Piket must be logged in in another tab or we prompt PIN)
            // For now, let's assume they have a session or we bypass. 
            // Since this display might not be logged in, we will prompt for a quick PIN/Token or just rely on session.
            const token = localStorage.getItem('token');
            if(!token) {
                Swal.fire('Akses Ditolak', 'Silakan Login sebagai Guru Piket di tab lain terlebih dahulu untuk mengambil tindakan.', 'error');
                return;
            }

            document.getElementById('handleId').value = id;
            document.getElementById('mKelas').innerText = kelas;
            document.getElementById('mMapel').innerText = mapel;
            document.getElementById('modalHandle').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modalHandle').classList.add('hidden');
        }

        function toggleInval(val) {
            const wrap = document.getElementById('invalWrapper');
            wrap.style.display = (val === 'GURU_INVAL_ASSIGNED') ? 'block' : 'none';
        }

        async function submitHandle() {
            const id = document.getElementById('handleId').value;
            const actionType = document.getElementById('actionType').value;
            const substituteTeacher = document.getElementById('substituteTeacher').value;
            const substituteNotes = document.getElementById('substituteNotes').value;

            if (actionType === 'GURU_INVAL_ASSIGNED' && !substituteTeacher) {
                Swal.fire('Peringatan', 'Pilih Guru Inval terlebih dahulu!', 'warning');
                return;
            }

            const token = localStorage.getItem('token');
            try {
                const res = await fetch(`/api/piket/empty-class-reports/${id}/handle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({ actionType, substituteTeacher, substituteNotes })
                });
                
                if (res.ok) {
                    Swal.fire({ title: 'Berhasil!', text: 'Kelas telah ditangani.', icon: 'success', timer: 1500, background: '#1E293B', color: '#fff' });
                    closeModal();
                    loadReports(); // manual reload just in case
                } else {
                    const err = await res.json();
                    Swal.fire('Gagal', err.message || 'Gagal menyimpan', 'error');
                }
            } catch(e) {
                Swal.fire('Error', 'Terjadi kesalahan sistem', 'error');
            }
        }

        async function loadTodayDutyPiket() {
            try {
                const res = await fetch('/api/piket/today-duty');
                const data = await res.json();
                const container = document.getElementById('todayPiketBadges');
                const countEl = document.getElementById('todayPiketCount');
                if(!container) return;

                if (data && data.success && Array.isArray(data.teachers) && data.teachers.length > 0) {
                    container.innerHTML = '';
                    data.teachers.forEach(t => {
                        const notesBadge = t.notes ? `<span class="text-[10px] text-gray-300 font-normal bg-gray-900/60 px-1.5 py-0.5 rounded ml-1">${t.notes}</span>` : '';
                        container.innerHTML += `
                            <span class="bg-blue-900/70 hover:bg-blue-800 border border-blue-500/50 text-white font-bold px-3 py-1 rounded-lg flex items-center gap-1.5 shadow-sm transition-all">
                                <i class="fas fa-chalkboard-teacher text-neonBlue"></i>
                                <span>${t.name}</span>
                                ${notesBadge}
                            </span>
                        `;
                    });
                    if (countEl) countEl.innerText = `${data.teachers.length} Guru Bertugas Hari Ini`;
                } else {
                    container.innerHTML = `<span class="text-amber-400 font-semibold bg-amber-900/30 border border-amber-500/40 px-3 py-1 rounded-lg flex items-center gap-1.5"><i class="fas fa-exclamation-circle text-amber-400"></i> Belum ada jadwal guru piket yang aktif untuk hari ini</span>`;
                    if (countEl) countEl.innerText = `0 Guru Bertugas`;
                }
            } catch(e) {
                console.error('Gagal memuat guru piket hari ini:', e);
            }
        }

        loadReports();
        loadTodayDutyPiket();
        setInterval(loadTodayDutyPiket, 30000);
    </script>
</body>
</html>