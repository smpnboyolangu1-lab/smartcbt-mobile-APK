        // ==================== REKAP TPP GURU KURIKULUM ====================
        let kurTppData = null;

        async function loadKurikulumTppData() {
            const tahunSelect = document.getElementById('kurTppTahunSelect');
            const targetYear = tahunSelect ? tahunSelect.value : new Date().getFullYear();
            const tbody = document.getElementById('kurTppTableBody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400">Memuat data rekapitulasi TPP seluruh guru...</td></tr>';
            }

            try {
                const res = await kurikulumFetch(`/api/tpp/kurikulum/monitoring?tahun=${targetYear}`);
                const data = await res.json();
                if (data.success) {
                    kurTppData = data;
                    document.getElementById('kurTppTotalGuru').innerText = `${data.kpi?.totalGuru || 0} Guru`;
                    document.getElementById('kurTppSudahCair').innerText = `${data.kpi?.totalSudahCair || 0} Guru`;
                    document.getElementById('kurTppBelumCair').innerText = `${data.kpi?.totalBelumCair || 0} Guru`;
                    filterKurikulumTppTable();
                } else {
                    if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-rose-500 font-bold">Gagal memuat TPP: ${data.message || 'Error'}</td></tr>`;
                }
            } catch (err) {
                console.error('Error loadKurikulumTppData:', err);
                if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-rose-500 font-bold">Gagal menghubungi server TPP</td></tr>`;
            }
        }

        function filterKurikulumTppTable() {
            const tbody = document.getElementById('kurTppTableBody');
            if (!tbody || !kurTppData || !kurTppData.teachers) return;

            const searchVal = (document.getElementById('kurTppSearchInput')?.value || '').toLowerCase().trim();
            const twVal = document.getElementById('kurTppTwSelect')?.value || 'ALL';

            let filtered = kurTppData.teachers;
            if (searchVal) {
                filtered = filtered.filter(t => 
                    (t.name && t.name.toLowerCase().includes(searchVal)) ||
                    (t.nip && t.nip.toLowerCase().includes(searchVal)) ||
                    (t.mapel && t.mapel.toLowerCase().includes(searchVal))
                );
            }

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400 font-semibold">Tidak ditemukan data guru yang cocok dengan pencarian.</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map((t, idx) => {
                const getTwPill = (twNum) => {
                    const twPeriods = (t.periods || []).filter(p => p.triwulan === twNum);
                    const cairCount = twPeriods.filter(p => p.status === 'SUDAH_CAIR').length;
                    if (cairCount === 3) {
                        return `<span class="px-2.5 py-1 rounded-xl text-[10.5px] font-black bg-emerald-100 text-emerald-800 border border-emerald-300 inline-flex items-center gap-1 shadow-xs">🔒 3/3 Cair</span>`;
                    } else if (cairCount > 0) {
                        return `<span class="px-2 py-0.5 rounded-lg text-[10.5px] font-bold bg-amber-100 text-amber-800 border border-amber-300 inline-flex items-center gap-1">🔒 ${cairCount}/3 Cair</span>`;
                    } else {
                        return `<span class="px-2 py-0.5 rounded-lg text-[10px] font-semibold bg-slate-100 text-slate-500 border border-slate-200">Belum Cair</span>`;
                    }
                };

                const totalCairMonths = (t.periods || []).filter(p => p.status === 'SUDAH_CAIR').length;
                const totalPill = totalCairMonths === 12
                    ? `<span class="px-2.5 py-1 rounded-full text-xs font-black bg-emerald-600 text-white shadow-xs">🔒 12/12 Tuntas</span>`
                    : `<span class="px-2.5 py-1 rounded-full text-xs font-bold ${totalCairMonths > 0 ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-slate-100 text-slate-600'}">${totalCairMonths} / 12 Bulan</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-3 text-slate-400 font-mono font-bold">${idx + 1}</td>
                        <td class="p-3">
                            <span class="font-bold text-slate-800 block text-xs">${t.name}</span>
                            <span class="text-[10.5px] text-slate-400 font-mono">NIP: ${t.nip || '-'} • Mapel: ${t.mapel || '-'}</span>
                        </td>
                        <td class="p-3 text-center">${getTwPill(1)}</td>
                        <td class="p-3 text-center">${getTwPill(2)}</td>
                        <td class="p-3 text-center">${getTwPill(3)}</td>
                        <td class="p-3 text-center">${getTwPill(4)}</td>
                        <td class="p-3 text-center">${totalPill}</td>
                    </tr>
                `;
            }).join('');
        }

        // ==================== PORTAL DARK / LIGHT THEME ====================
        function updateThemeUI(isDark) {
            const icon = document.getElementById('themeToggleIcon');
            if (icon) icon.innerText = isDark ? '☀️' : '🌙';
        }

        function togglePortalTheme() {
            const isDark = document.body.classList.toggle('dark-mode');
            localStorage.setItem('portal_theme', isDark ? 'dark' : 'light');
            updateThemeUI(isDark);
        }

        (function applySavedTheme() {
            const savedTheme = localStorage.getItem('portal_theme');
            const isDark = savedTheme === 'dark';
            if (isDark) {
                document.body.classList.add('dark-mode');
            }
            updateThemeUI(isDark);
        })();
    </script>
</body>
</html>
