<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Kurikulum • SMP Negeri 1 Boyolangu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAFC; }
        .tab-btn.active {
            background: linear-gradient(135deg, #064E3B 0%, #059669 100%);
            color: #FFFFFF;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: #FFFFFF !important; font-size: 11pt; }
        }
        .print-only { display: none; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="text-slate-800 antialiased flex flex-col min-h-screen">

    <!-- TOPBAR RESMI SIBOY FRESH -->
    <header class="no-print bg-slate-900 border-b border-slate-800 text-white sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-600 flex items-center justify-center font-black text-xl shadow-md border border-emerald-400/40">
                    🏛️
                </div>
                <div>
                    <h1 class="text-sm sm:text-base font-black tracking-tight text-white flex items-center gap-2">
                        PORTAL KURIKULUM
                        <span class="bg-emerald-500/20 text-emerald-400 text-[10px] font-extrabold px-2 py-0.5 rounded-full border border-emerald-400/30">SIBOY FRESH</span>
                    </h1>
                    <p class="text-[11px] text-slate-400 font-medium truncate">SMP Negeri 1 Boyolangu • Terakreditasi A</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="hidden sm:flex flex-col text-right">
                    <span class="text-xs font-bold text-slate-200" id="headerUserName">Tim Kurikulum</span>
                    <span class="text-[10px] text-emerald-400 font-semibold" id="headerServerTime">WIB</span>
                </div>
                <div class="h-6 w-[1px] bg-slate-800 hidden sm:block"></div>
                <a href="/guru" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-300 transition-all flex items-center gap-1.5 border border-slate-700">
                    <span>👨‍🏫</span> <span class="hidden md:inline">Portal Guru</span>
                </a>
                <button type="button" onclick="togglePortalTheme()" id="themeToggleBtn" title="Ganti Mode Terang / Gelap" class="p-2 rounded-xl text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-all flex items-center justify-center flex-shrink-0 cursor-pointer" aria-label="Ganti Tema">
                    <span id="themeToggleIcon" class="text-base">🌙</span>
                </button>
                <a href="/logout" class="px-3 py-1.5 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-400 text-xs font-bold transition-all border border-rose-500/30">
                    Keluar
                </a>
            </div>
        </div>
    </header>

    <!-- NAVIGATION TABS (7 FITUR INTI KURIKULUM) -->
    <nav class="no-print bg-white border-b border-slate-200 shadow-sm sticky top-16 z-30 overflow-x-auto scroll-smooth" style="-webkit-overflow-scrolling: touch;">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-1.5 py-2.5 min-w-max">
            <button onclick="switchTab('dashboard')" id="btnTab-dashboard" class="tab-btn active px-4 py-2 rounded-xl text-xs font-bold flex items-center gap-2 transition-all">
                <span>🏠</span> <span>Dashboard</span>
            </button>
            <button onclick="switchTab('approval')" id="btnTab-approval" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>✅</span> <span>Approval Izin Guru</span>
                <span id="badgePendingIzin" class="bg-rose-500 text-white text-[10px] font-black px-1.5 py-0.2 rounded-full hidden">0</span>
            </button>
            <button onclick="switchTab('rekap-guru')" id="btnTab-rekap-guru" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>📊</span> <span>Presensi Guru</span>
            </button>
            <button onclick="switchTab('rekap-siswa')" id="btnTab-rekap-siswa" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>👥</span> <span>Presensi Siswa</span>
            </button>
            <button onclick="switchTab('kelas-kosong')" id="btnTab-kelas-kosong" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>📡</span> <span>Monitoring Kelas Kosong</span>
                <span id="badgeEmptyClasses" class="bg-amber-500 text-white text-[10px] font-black px-1.5 py-0.2 rounded-full hidden">0</span>
            </button>
            <button onclick="switchTab('cbt')" id="btnTab-cbt" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>🖥️</span> <span>Monitoring &amp; Proktor CBT</span>
            </button>
            <a href="/kurikulum/cbt" class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-50 text-indigo-700 hover:bg-indigo-100 flex items-center gap-2 transition-all border border-indigo-200">
                <span>📝</span> <span>Pusat CBT Terpadu</span>
            </a>
            <button onclick="switchTab('tpp')" id="btnTab-tpp" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>💰</span> <span>Rekap TPP Guru</span>
            </button>
            <button onclick="switchTab('laporan')" id="btnTab-laporan" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all">
                <span>📄</span> <span>Laporan &amp; Cetak</span>
            </button>
        </div>
    </nav>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <!-- 1. TAB DASHBOARD -->
        <section id="section-dashboard" class="space-y-6">
            <!-- Header Banner -->
            <div class="bg-gradient-to-r from-emerald-800 via-teal-800 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-emerald-500/30 text-emerald-300 text-xs uppercase px-3 py-1 rounded-full font-black border border-emerald-400/30">
                        SISTEM TERPADU KURIKULUM SIBOY
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black mt-3 leading-tight">Selamat Datang di Pusat Komando Kurikulum</h2>
                    <p class="text-emerald-100 text-xs sm:text-sm mt-2 leading-relaxed">
                        Data kehadiran, persetujuan perizinan guru, monitoring kelas kosong real-time, dan pemantauan asesmen CBT secara langsung dari database sekolah tanpa data dummy.
                    </p>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-slate-500 text-xs font-semibold">Total Guru Aktif</span>
                    <p class="text-2xl font-black text-slate-800 mt-2" id="statTotalGuru">-</p>
                    <span class="text-[10px] text-emerald-600 font-bold mt-1">Staf Pengajar</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-slate-500 text-xs font-semibold">Total Siswa</span>
                    <p class="text-2xl font-black text-slate-800 mt-2" id="statTotalSiswa">-</p>
                    <span class="text-[10px] text-blue-600 font-bold mt-1">Peserta Didik</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-slate-500 text-xs font-semibold">Total Rombel</span>
                    <p class="text-2xl font-black text-slate-800 mt-2" id="statTotalKelas">-</p>
                    <span class="text-[10px] text-purple-600 font-bold mt-1">Kelas VII - IX</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-slate-500 text-xs font-semibold">Izin Guru Pending</span>
                    <p class="text-2xl font-black text-rose-600 mt-2" id="statPendingIzin">-</p>
                    <span class="text-[10px] text-rose-600 font-bold mt-1">Perlu Verifikasi</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-slate-500 text-xs font-semibold">Kelas Kosong Hari Ini</span>
                    <p class="text-2xl font-black text-amber-600 mt-2" id="statKelasKosong">-</p>
                    <span class="text-[10px] text-amber-600 font-bold mt-1">> 5 Menit Tanpa Guru</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-slate-500 text-xs font-semibold">Asesmen CBT Aktif</span>
                    <p class="text-2xl font-black text-teal-600 mt-2" id="statCbtAktif">-</p>
                    <span class="text-[10px] text-teal-600 font-bold mt-1">Ujian Berjalan</span>
                </div>
            </div>

            <!-- Two Columns: Kehadiran Hari Ini & Posko Piket -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Kehadiran Realtime -->
                <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-base text-slate-800 flex items-center gap-2">
                            <span>📈</span> Tingkat Kehadiran KBM Hari Ini
                        </h3>
                        <span class="text-xs font-bold text-slate-400" id="dashTodayDate">-</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Guru -->
                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                            <div>
                                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Presensi Mengajar Guru</span>
                                <div class="flex items-baseline gap-2 mt-2">
                                    <span class="text-3xl font-black text-slate-800" id="dashGuruPercent">0%</span>
                                    <span class="text-xs font-bold px-2 py-0.5 rounded-full" id="dashGuruBadge">Memuat...</span>
                                </div>
                            </div>
                            <div class="w-full bg-slate-200 h-2.5 rounded-full mt-4 overflow-hidden">
                                <div id="dashGuruBar" class="bg-emerald-600 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>

                        <!-- Siswa -->
                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                            <div>
                                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Presensi Masuk Siswa</span>
                                <div class="flex items-baseline gap-2 mt-2">
                                    <span class="text-3xl font-black text-slate-800" id="dashSiswaPercent">0%</span>
                                    <span class="text-xs font-bold px-2 py-0.5 rounded-full" id="dashSiswaBadge">Memuat...</span>
                                </div>
                            </div>
                            <div class="w-full bg-slate-200 h-2.5 rounded-full mt-4 overflow-hidden">
                                <div id="dashSiswaBar" class="bg-teal-600 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 p-4 rounded-xl bg-emerald-50 border border-emerald-100 text-xs text-emerald-800 flex items-center gap-2">
                        <span>ℹ️</span> <span>Standar Evaluasi SIBOY FRESH: <b>🟢 Baik (&gt;80%)</b>, <b>🟡 Perlu Perhatian (60-80%)</b>, <b>🔴 Bermasalah (&lt;60%)</b>.</span>
                    </div>
                </div>

                <!-- Guru Piket Bertugas Hari Ini -->
                <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col">
                    <h3 class="font-black text-base text-slate-800 flex items-center gap-2 mb-3">
                        <span>🛡️</span> Posko Piket Hari Ini
                    </h3>
                    <p class="text-xs text-slate-500 mb-4">Guru piket yang siaga menerima disposisi pendampingan kelas kosong dan izin guru.</p>
                    
                    <div id="dashPiketList" class="space-y-2.5 flex-1 overflow-y-auto max-h-64">
                        <p class="text-xs text-slate-400 py-4 text-center">Memuat guru piket...</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. TAB APPROVAL IZIN GURU -->
        <section id="section-approval" class="space-y-6 hidden">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                    <div>
                        <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                            <span>✅</span> Verifikasi &amp; Persetujuan Izin Guru
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">Persetujuan otomatis mendisposisikan jadwal KBM terdampak ke Posko Guru Piket hari ini.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <select id="filterIzinStatus" onchange="loadApprovalLeaves()" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 focus:outline-none">
                            <option value="PENDING">Status: Menunggu Persetujuan (Pending)</option>
                            <option value="APPROVED">Status: Sudah Disetujui (Approved)</option>
                            <option value="REJECTED">Status: Ditolak (Rejected)</option>
                            <option value="ALL">Semua Status</option>
                        </select>
                        <button onclick="loadApprovalLeaves()" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow flex items-center gap-1.5 transition-all">
                            <span>🔄</span> Refresh
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto mt-4">
                    <table class="w-full text-left text-xs text-slate-600 min-w-[680px]">
                        <thead class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase border-b border-slate-200">
                            <tr>
                                <th class="p-3.5 w-12 text-center">No</th>
                                <th class="p-3.5">Nama Guru</th>
                                <th class="p-3.5">Jenis Izin</th>
                                <th class="p-3.5">Rentang Tanggal</th>
                                <th class="p-3.5">Alasan &amp; Bukti</th>
                                <th class="p-3.5">Jadwal Terdampak</th>
                                <th class="p-3.5 text-center">Status</th>
                                <th class="p-3.5 text-right">Aksi Kurikulum</th>
                            </tr>
                        </thead>
                        <tbody id="tableApprovalLeavesBody" class="divide-y divide-slate-100">
                            <tr><td colspan="8" class="p-8 text-center text-slate-400">Memuat data pengajuan izin guru...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 3. TAB REKAP PRESENSI GURU -->
        <section id="section-rekap-guru" class="space-y-6 hidden">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                    <div>
                        <h3 class="font-black text-lg text-slate-800 flex items-center gap-2">
                            <span>📊</span> Rekapitulasi Presensi Mengajar Guru
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">Agregasi kehadiran KBM berbasis geofencing GPS dan absensi sesi kelas tanpa dummy data.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="month" id="filterBulanGuru" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-700">
                        <button onclick="loadRekapGuru()" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow transition-all">
                            Tampilkan
                        </button>
                    </div>
                </div>

                <!-- DIAGRAM BULAT / DONUT CHART TREN KETERLAMBATAN & KETIDAKHADIRAN GURU -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 my-6 p-5 rounded-2xl bg-slate-50/70 border border-slate-200/80 items-center">
                    <div class="lg:col-span-1 flex flex-col items-center justify-center">
                        <div class="relative w-40 h-40 flex items-center justify-center">
                            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="38" fill="transparent" stroke="#E2E8F0" stroke-width="12"></circle>
                                <circle id="donutCircleTepat" cx="50" cy="50" r="38" fill="transparent" stroke="#10B981" stroke-width="12" stroke-dasharray="0 238.76" stroke-linecap="round"></circle>
                                <circle id="donutCircleTelat" cx="50" cy="50" r="38" fill="transparent" stroke="#F59E0B" stroke-width="12" stroke-dasharray="0 238.76" stroke-linecap="round"></circle>
                                <circle id="donutCircleIzin" cx="50" cy="50" r="38" fill="transparent" stroke="#3B82F6" stroke-width="12" stroke-dasharray="0 238.76" stroke-linecap="round"></circle>
                                <circle id="donutCircleAlfa" cx="50" cy="50" r="38" fill="transparent" stroke="#EF4444" stroke-width="12" stroke-dasharray="0 238.76" stroke-linecap="round"></circle>
                                <circle id="donutCircleCuti" cx="50" cy="50" r="38" fill="transparent" stroke="#8B5CF6" stroke-width="12" stroke-dasharray="0 238.76" stroke-linecap="round"></circle>
                            </svg>
                            <div class="absolute text-center">
                                <span id="donutCenterRate" class="text-xl font-black text-slate-800 block">--%</span>
                                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Tepat Waktu</span>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-2 space-y-2">
                        <h4 class="font-black text-sm text-slate-800">⭕ Tren Disiplin &amp; Ketidakhadiran Guru</h4>
                        <p class="text-xs text-slate-500">Persentase sesi KBM seluruh dewan guru SMPN 1 Boyolangu.</p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
                            <div class="p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                                <span class="text-[10px] font-bold text-emerald-600 block">🟢 Tepat Waktu</span>
                                <span id="donutCountTepat" class="text-sm font-black text-slate-800">0 Sesi (0%)</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                                <span class="text-[10px] font-bold text-amber-600 block">🟡 Terlambat</span>
                                <span id="donutCountTelat" class="text-sm font-black text-slate-800">0x (0%)</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                                <span class="text-[10px] font-bold text-blue-600 block">🔵 Izin &amp; Sakit</span>
                                <span id="donutCountIzin" class="text-sm font-black text-slate-800">0 (0%)</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                                <span class="text-[10px] font-bold text-rose-600 block">🔴 Alfa / Absen</span>
                                <span id="donutCountAlfa" class="text-sm font-black text-slate-800">0 (0%)</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                                <span class="text-[10px] font-bold text-purple-600 block">🟣 Cuti Resmi</span>
                                <span id="donutCountCuti" class="text-sm font-black text-slate-800">0x (0%)</span>
                            </div>
                            <div class="p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                                <span class="text-[10px] font-bold text-slate-500 block">📋 Total KBM</span>
                                <span id="donutCountTotal" class="text-sm font-black text-slate-800">0 Sesi</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEARCH & FILTER BAR -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mt-4 pt-4 border-t border-slate-100">
                    <div class="relative flex-1 max-w-md">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">🔍</span>
                        <input type="text" id="searchGuruInput" onkeyup="filterTableRekapGuru()" placeholder="Cari nama guru, NIP, atau mata pelajaran..." class="w-full pl-9 pr-3.5 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-emerald-500 focus:outline-none transition-all">
                    </div>
                    <div id="guruRecapCountBadge" class="text-xs font-bold text-slate-500">Memuat dewan guru...</div>
                </div>

                <div class="overflow-x-auto mt-4">
                    <table class="w-full text-left text-xs text-slate-600 min-w-[760px]">
                        <thead class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase border-b border-slate-200">
                            <tr>
                                <th class="p-3.5 w-12 text-center">No</th>
                                <th class="p-3.5">Nama Guru / NIP</th>
                                <th class="p-3.5">Mata Pelajaran</th>
                                <th class="p-3.5 text-center text-emerald-600">Tepat Waktu</th>
                                <th class="p-3.5 text-center text-amber-600">Terlambat</th>
                                <th class="p-3.5 text-center text-blue-600">Izin &amp; Sakit</th>
                                <th class="p-3.5 text-center text-rose-600">Alfa</th>
                                <th class="p-3.5 text-center text-indigo-600">Cuti Disetujui</th>
