    <!-- SCRIPT CLIENT LOGIC -->
    <script>
        const token = localStorage.getItem('token') || '';
        if (!token) {
            window.location.href = '/login';
        }

        async function kurikulumFetch(url, options = {}) {
            options.headers = options.headers || {};
            options.headers['Authorization'] = 'Bearer ' + token;
            const res = await fetch(url, options);
            if (res.status === 401 || res.status === 403) {
                alert('Sesi berakhir atau wewenang kurikulum tidak mencukupi.');
                window.location.href = '/guru';
            }
            return res;
        }

        function switchTab(tabId) {
            const tabs = ['dashboard', 'approval', 'rekap-guru', 'rekap-siswa', 'kelas-kosong', 'cbt', 'laporan', 'tpp'];
            tabs.forEach(t => {
                const btn = document.getElementById('btnTab-' + t);
                const sec = document.getElementById('section-' + t);
                if (btn && sec) {
                    if (t === tabId) {
                        btn.className = 'tab-btn active px-4 py-2 rounded-xl text-xs font-bold flex items-center gap-2 transition-all';
                        sec.classList.remove('hidden');
                    } else {
                        btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 flex items-center gap-2 transition-all';
                        sec.classList.add('hidden');
                    }
                }
            });

            if (tabId === 'dashboard') loadDashboardData();
            else if (tabId === 'approval') loadApprovalLeaves();
            else if (tabId === 'rekap-guru') loadRekapGuru();
            else if (tabId === 'rekap-siswa') loadRekapSiswa();
            else if (tabId === 'kelas-kosong') loadMonitoringKelasKosong();
            else if (tabId === 'cbt') loadMonitoringCbt();
            else if (tabId === 'tpp') loadKurikulumTppData();
        }

        // 1. Load Dashboard
        async function loadDashboardData() {
            try {
                const res = await kurikulumFetch('/api/kurikulum/dashboard');
                const data = await res.json();
                if (data.success && data.dashboard) {
                    const d = data.dashboard;
                    document.getElementById('statTotalGuru').innerText = d.stats.totalGuru;
                    document.getElementById('statTotalSiswa').innerText = d.stats.totalSiswa;
                    document.getElementById('statTotalKelas').innerText = d.stats.totalKelas;
                    document.getElementById('statPendingIzin').innerText = d.stats.pendingIzinGuru;
                    document.getElementById('statKelasKosong').innerText = d.stats.kelasKosongAktif;
                    document.getElementById('statCbtAktif').innerText = d.stats.cbtAktif;
                    document.getElementById('dashTodayDate').innerText = `${d.hari}, ${d.tanggal}`;

                    // Badges
                    if (d.stats.pendingIzinGuru > 0) {
                        const bI = document.getElementById('badgePendingIzin');
                        bI.innerText = d.stats.pendingIzinGuru;
                        bI.classList.remove('hidden');
                    }
                    if (d.stats.kelasKosongAktif > 0) {
                        const bE = document.getElementById('badgeEmptyClasses');
                        bE.innerText = d.stats.kelasKosongAktif;
                        bE.classList.remove('hidden');
                    }

                    // Progress Bars
                    document.getElementById('dashGuruPercent').innerText = d.stats.kehadiranGuruPersen + '%';
                    document.getElementById('dashGuruBar').style.width = d.stats.kehadiranGuruPersen + '%';
                    const gb = document.getElementById('dashGuruBadge');
                    gb.innerText = d.stats.kategoriGuru;
                    gb.className = `text-xs font-bold px-2 py-0.5 rounded-full ${d.stats.kategoriGuru === 'BAIK' ? 'bg-emerald-100 text-emerald-800' : (d.stats.kategoriGuru === 'PERHATIAN' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800')}`;

                    document.getElementById('dashSiswaPercent').innerText = d.stats.kehadiranSiswaPersen + '%';
                    document.getElementById('dashSiswaBar').style.width = d.stats.kehadiranSiswaPersen + '%';
                    const sb = document.getElementById('dashSiswaBadge');
                    sb.innerText = d.stats.kategoriSiswa;
                    sb.className = `text-xs font-bold px-2 py-0.5 rounded-full ${d.stats.kategoriSiswa === 'BAIK' ? 'bg-emerald-100 text-emerald-800' : (d.stats.kategoriSiswa === 'PERHATIAN' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800')}`;

                    // Guru Piket List
                    const piketContainer = document.getElementById('dashPiketList');
                    if (d.guruPiketHariIni && d.guruPiketHariIni.length > 0) {
                        piketContainer.innerHTML = d.guruPiketHariIni.map(p => `
                            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                                <div>
                                    <span class="font-bold text-xs text-slate-800 block">${p.nama}</span>
                                    <span class="text-[10px] text-slate-400">⏰ ${p.startTime} - ${p.endTime} WIB</span>
                                </div>
                                <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2 py-0.5 rounded-full">Siaga Piket</span>
                            </div>
                        `).join('');
                    } else {
                        piketContainer.innerHTML = '<p class="text-xs text-slate-400 py-4 text-center">Belum ada jadwal piket aktif hari ini.</p>';
                    }
                }
            } catch (e) {
                console.error('Error loadDashboardData:', e);
            }
        }

        // 2. Load Approval Izin Guru
        async function loadApprovalLeaves() {
            try {
                const st = document.getElementById('filterIzinStatus').value;
                const res = await kurikulumFetch(`/api/kurikulum/izin-guru?status=${st}`);
                const data = await res.json();
                const tbody = document.getElementById('tableApprovalLeavesBody');

                if (!data.izinList || data.izinList.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-slate-400">Tidak ada pengajuan izin guru (${st}).</td></tr>`;
                    return;
                }

                tbody.innerHTML = data.izinList.map((item, idx) => {
                    const start = new Date(item.tanggalMulai).toLocaleDateString('id-ID');
                    const end = new Date(item.tanggalSelesai).toLocaleDateString('id-ID');
                    const isPending = item.status === 'PENDING';
                    const schedules = item.jadwalTerdampakList || [];

                    let badgeStatus = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-800">Menunggu</span>';
                    if (item.status === 'APPROVED') badgeStatus = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">Disetujui</span>';
                    else if (item.status === 'REJECTED') badgeStatus = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-800">Ditolak</span>';

                    return `
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="p-3.5 text-center font-bold text-slate-400">${idx + 1}</td>
                            <td class="p-3.5 font-bold text-slate-800">${item.guruNama || 'Guru'}</td>
                            <td class="p-3.5 font-bold text-purple-700">${item.jenis}</td>
                            <td class="p-3.5 text-slate-600">${start} s/d ${end}</td>
                            <td class="p-3.5">
                                <span class="font-medium text-slate-700 block truncate max-w-xs">${item.alasan}</span>
                                ${item.lampiranUrl ? `<a href="${item.lampiranUrl}" target="_blank" class="text-[11px] text-emerald-600 font-bold hover:underline">📎 Lihat Lampiran</a>` : ''}
                            </td>
                            <td class="p-3.5 font-bold text-slate-700">${schedules.length} Sesi Terjadwal</td>
                            <td class="p-3.5 text-center">${badgeStatus}</td>
                            <td class="p-3.5 text-right space-x-1.5">
                                <button onclick="showDetailIzinModal('${item.id}')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[11px]">
                                    🔍 Detail
                                </button>
                                ${isPending ? `
                                    <button onclick="handleApproveIzin('${item.id}', '${item.guruNama}')" class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow">
                                        ✅ Setujui
                                    </button>
                                    <button onclick="handleRejectIzin('${item.id}', '${item.guruNama}')" class="px-2.5 py-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-bold text-[11px] shadow">
                                        ❌ Tolak
                                    </button>
                                ` : ''}
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (e) {
                console.error('Error loadApprovalLeaves:', e);
            }
        }

        async function handleApproveIzin(id, name) {
            const note = prompt(`Setujui izin ${name}?\nMasukkan catatan kurikulum (opsional):`, 'Disetujui Tim Kurikulum');
            if (note === null) return;

            try {
                const res = await kurikulumFetch(`/api/kurikulum/izin-guru/${id}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ catatan_kurikulum: note })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ Izin berhasil disetujui & didisposisikan ke Posko Guru Piket!');
                    loadApprovalLeaves();
                    loadDashboardData();
                } else {
                    alert('Gagal menyetujui izin: ' + data.message);
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        async function handleRejectIzin(id, name) {
            const reason = prompt(`Tolak izin ${name}?\nMasukkan alasan penolakan:`);
            if (!reason) return;

            try {
                const res = await kurikulumFetch(`/api/kurikulum/izin-guru/${id}/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ catatan_kurikulum: reason })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Izin telah ditolak.');
                    loadApprovalLeaves();
                    loadDashboardData();
                } else {
                    alert('Gagal menolak izin: ' + data.message);
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        async function showDetailIzinModal(id) {
            try {
                const res = await kurikulumFetch(`/api/kurikulum/izin-guru/${id}`);
                const data = await res.json();
                if (!data.success || !data.izin) return;

                const item = data.izin;
                const modal = document.getElementById('modalDetailIzin');
                const body = document.getElementById('mIzinBody');
                const schedules = item.jadwalTerdampakList || [];

                body.innerHTML = `
                    <div class="p-3 bg-slate-50 rounded-xl space-y-1">
                        <p><b>Nama Guru:</b> ${item.guruNama || item.teacherName || 'Guru'}</p>
                        <p><b>Jenis Izin:</b> ${item.jenis || item.category}</p>
                        <p><b>Rentang Tanggal:</b> ${new Date(item.tanggalMulai || item.startDate).toLocaleDateString('id-ID')} s/d ${new Date(item.tanggalSelesai || item.endDate).toLocaleDateString('id-ID')}</p>
                        <p><b>Alasan:</b> ${item.alasan || item.reason}</p>
                        ${item.catatanKurikulum ? `<p><b>Catatan Kurikulum:</b> ${item.catatanKurikulum}</p>` : ''}
                    </div>
                    <div>
                        <h5 class="font-bold text-slate-800 mb-2">📋 Jadwal KBM Terdampak (${schedules.length} Sesi):</h5>
                        <div class="space-y-1.5 max-h-48 overflow-y-auto">
                            ${schedules.length > 0 ? schedules.map(s => `
                                <div class="p-2 bg-emerald-50 text-emerald-900 rounded-lg flex items-center justify-between border border-emerald-100">
                                    <span><b>${s.kelasId || s.className}</b> • ${s.mapelId || s.subjectName}</span>
                                    <span class="font-mono text-[11px] font-bold">⏰ ${s.jamMulai || s.periodLesson || ''} - ${s.jamSelesai || ''}</span>
                                </div>
                            `).join('') : '<p class="text-slate-400">Tidak ada rincian sesi jadwal terdampak.</p>'}
                        </div>
                    </div>
                `;

                modal.classList.remove('hidden');
            } catch (e) {
                console.error(e);
            }
        }

        function closeModalDetailIzin() {
            document.getElementById('modalDetailIzin').classList.add('hidden');
        }

        // 3. Load Rekap Presensi Guru
        function updateGuruDonutChart(rekapList) {
            const list = rekapList || [];
            const sumTepat = list.reduce((acc, g) => acc + (g.tepatWaktu || 0), 0);
            const sumTelat = list.reduce((acc, g) => acc + (g.terlambat || 0), 0);
            const sumIzin = list.reduce((acc, g) => acc + ((g.izin || 0) + (g.sakit || 0)), 0);
            const sumAlfa = list.reduce((acc, g) => acc + (g.alfa || 0), 0);
            const sumCuti = list.reduce((acc, g) => acc + (g.cutiCount || 0), 0);
            const total = sumTepat + sumTelat + sumIzin + sumAlfa + sumCuti;

            const c = 238.76; // 2 * PI * 38
            const pctTepat = total > 0 ? (sumTepat / total) : 0;
            const pctTelat = total > 0 ? (sumTelat / total) : 0;
            const pctIzin = total > 0 ? (sumIzin / total) : 0;
            const pctAlfa = total > 0 ? (sumAlfa / total) : 0;
            const pctCuti = total > 0 ? (sumCuti / total) : 0;

            document.getElementById('donutCenterRate').textContent = total > 0 ? Math.round(pctTepat * 100) + '%' : '0%';
            document.getElementById('donutCountTepat').textContent = `${sumTepat} Sesi (${Math.round(pctTepat * 100)}%)`;
            document.getElementById('donutCountTelat').textContent = `${sumTelat}x (${Math.round(pctTelat * 100)}%)`;
            document.getElementById('donutCountIzin').textContent = `${sumIzin} (${Math.round(pctIzin * 100)}%)`;
            document.getElementById('donutCountAlfa').textContent = `${sumAlfa} (${Math.round(pctAlfa * 100)}%)`;
            document.getElementById('donutCountCuti').textContent = `${sumCuti}x (${Math.round(pctCuti * 100)}%)`;
            document.getElementById('donutCountTotal').textContent = `${total} Sesi`;

            // SVG Stroke Segments
            let offset = 0;
            function setSlice(elId, pct) {
                const el = document.getElementById(elId);
                if (!el) return;
                const len = pct * c;
                el.setAttribute('stroke-dasharray', `${len} ${c - len}`);
                el.setAttribute('stroke-dashoffset', -offset);
                offset += len;
            }

            setSlice('donutCircleTepat', pctTepat);
            setSlice('donutCircleTelat', pctTelat);
            setSlice('donutCircleIzin', pctIzin);
            setSlice('donutCircleAlfa', pctAlfa);
            setSlice('donutCircleCuti', pctCuti);
        }

        function renderRekapGuruTable(list) {
            const tbody = document.getElementById('tableRekapGuruBody');
            const countBadge = document.getElementById('guruRecapCountBadge');
            if (countBadge) {
                countBadge.textContent = `Menampilkan ${list.length} dewan guru`;
            }

            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="11" class="p-8 text-center text-slate-400">Tidak ada data presensi guru yang sesuai filter.</td></tr>';
                return;
            }

            tbody.innerHTML = list.map((g, idx) => {
                const cutiBadge = (g.cutiCount && g.cutiCount > 0)
                    ? `<button onclick="showModalDetailCuti(${idx})" class="px-2 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 rounded-lg font-bold text-[11px] transition-colors flex items-center gap-1 mx-auto" title="Klik untuk rincian cuti disetujui">
                         <span>🏖️ ${g.cutiCount}x (${g.cutiHariTotal || 0} hr)</span>
                         <span class="text-[9px] bg-indigo-200 text-indigo-800 px-1 rounded">Rincian</span>
                       </button>`
                    : `<span class="text-slate-400 font-medium">-</span>`;

                const terlambatText = (g.terlambat && g.terlambat > 0)
                    ? `<span class="font-bold text-amber-600">${g.terlambat}x</span><br><span class="text-[10px] text-amber-500 font-mono">${g.terlambatMenitTotal || 0}m</span>`
                    : `<span class="text-slate-400 font-medium">0</span>`;

                return `
                <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="p-3.5 text-center font-bold text-slate-400">${idx + 1}</td>
                    <td class="p-3.5">
                        <span class="font-bold text-slate-800 block">${g.nama}</span>
                        <span class="text-[10px] font-mono text-slate-400">NIP: ${g.nip || '-'}</span>
                    </td>
                    <td class="p-3.5 font-medium text-slate-700">${g.mapel || '-'}</td>
                    <td class="p-3.5 text-center font-bold text-emerald-600">${g.tepatWaktu}</td>
                    <td class="p-3.5 text-center">${terlambatText}</td>
                    <td class="p-3.5 text-center">
                        <span class="font-bold text-blue-600">${(g.izin || 0) + (g.sakit || 0)}</span>
