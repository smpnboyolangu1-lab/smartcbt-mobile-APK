        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadDashboardData();
            loadClassesForFilter();

            // Realtime Socket.io listener
            try {
                const socket = io();
                socket.emit('join_room', 'kurikulum');
                socket.on('izin_guru_pending', () => {
                    loadDashboardData();
                    if (!document.getElementById('section-approval').classList.contains('hidden')) {
                        loadApprovalLeaves();
                    }
                });
                socket.on('kelas_kosong_alert', () => {
                    loadDashboardData();
                    if (!document.getElementById('section-kelas-kosong').classList.contains('hidden')) {
                        loadMonitoringKelasKosong();
                    }
                });
                socket.on('cbt_exam_update', () => {
                    if (!document.getElementById('section-monitoring-cbt').classList.contains('hidden')) {
                        loadMonitoringCbt();
                    }
                });
                socket.on('class_monitoring_update', () => {
                    loadMonitoringKelasKosong();
                });
                socket.on('attendance_update', () => {
                    loadDashboardData();
                });
            } catch (e) {}

            // Auto-refresh monitoring seluruh kelas secara realtime setiap 15 detik
            setInterval(() => {
                if (!document.getElementById('section-kelas-kosong').classList.contains('hidden')) {
                    loadMonitoringKelasKosong();
                }
                if (!document.getElementById('section-monitoring-cbt').classList.contains('hidden')) {
                    loadMonitoringCbt();
                }
                if (!document.getElementById('section-overview').classList.contains('hidden')) {
                    loadDashboardData();
                }
            }, 15000);
        });

        // ==================== PORTAL DARK / LIGHT THEME ====================
        function updateThemeUI(isDark) {
            const icon = document.getElementById('themeToggleIcon');
            if (icon) icon.innerText = isDark ? '☀️' : '🌙';
        }

        function togglePortalTheme() {
            const isDark = document.body.classList.toggle('dark-mode');
            localStorage.setItem('portal_theme', isDark ? 'dark' : 'light');
            updateThemeUI(isDark);
        }

        (function applySavedTheme() {
            const savedTheme = localStorage.getItem('portal_theme');
            const isDark = savedTheme === 'dark';
            if (isDark) {
                document.body.classList.add('dark-mode');
            }
            updateThemeUI(isDark);
        })();
    </script>
</body>
