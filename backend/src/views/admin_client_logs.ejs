<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🚨 Log Error &amp; Analisis Masalah APK - SMPN 1 Boyolangu</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-50 text-slate-800 flex h-screen overflow-hidden">
    <!-- Unified Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto h-screen bg-slate-50/70 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>🚨</span> Log Error &amp; Analisis Masalah APK
                    </h1>
                    <p class="text-slate-500 text-xs mt-0.5">Pemantauan Masalah APK Senyap, Stack Trace, Model HP Siswa/Guru &amp; Resolusi Bug</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="cleanupResolvedLogs()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3.5 py-2 rounded-xl text-sm font-semibold border border-slate-200 transition-colors shadow-sm flex items-center gap-1.5">
                    <span>🧹</span> Bersihkan Log Selesai
                </button>
                <button onclick="loadLogs(1)" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow transition-colors flex items-center gap-1.5">
                    <span>🔄</span> Refresh Data
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Total Log Masalah</p>
                    <p class="text-2xl font-bold text-slate-800 mt-1" id="statTotalLogs">0</p>
                    <p class="text-xs text-slate-400 mt-1">Terekam dari APK Klien</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">📋</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Crash / Fatal Kritis</p>
                    <p class="text-2xl font-bold text-rose-600 mt-1" id="statCrashCount">0</p>
                    <p class="text-xs text-rose-500 font-medium mt-1">Prioritas Tinggi Perbaikan</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">💥</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Belum Selesai (Pending)</p>
                    <p class="text-2xl font-bold text-amber-600 mt-1" id="statUnresolvedCount">0</p>
                    <p class="text-xs text-amber-500 font-medium mt-1">Perlu Ditinjau Pengembang</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">⏳</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Status Silent Reporter</p>
                    <p class="text-lg font-bold text-emerald-600 mt-1">🟢 Aktif &amp; Siaga</p>
                    <p class="text-xs text-slate-400 mt-1">Tanpa Popup di HP Pengguna</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">🛡️</div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-6 flex flex-wrap items-center gap-3">
            <div class="flex-1 min-w-[220px]">
                <input type="text" id="searchInput" placeholder="Cari pesan error, model HP, username..." 
                    class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    onkeyup="if(event.key === 'Enter') loadLogs(1)">
            </div>

            <select id="filterLevel" onchange="loadLogs(1)" class="px-3 py-2 text-sm rounded-xl border border-slate-200 bg-white text-slate-700">
                <option value="ALL">Semua Keparahan</option>
                <option value="CRASH">💥 CRASH / FATAL</option>
                <option value="ERROR">⚠️ ERROR</option>
                <option value="WARN">🟡 WARN</option>
            </select>

            <select id="filterRole" onchange="loadLogs(1)" class="px-3 py-2 text-sm rounded-xl border border-slate-200 bg-white text-slate-700">
                <option value="ALL">Semua Peran (Role)</option>
                <option value="STUDENT">Siswa</option>
                <option value="TEACHER">Guru</option>
                <option value="PARENT">Orang Tua</option>
                <option value="BK">Guru BK</option>
                <option value="OPERATOR">Operator/Admin</option>
            </select>

            <select id="filterStatus" onchange="loadLogs(1)" class="px-3 py-2 text-sm rounded-xl border border-slate-200 bg-white text-slate-700">
                <option value="false">⏳ Belum Selesai (Pending)</option>
                <option value="true">✅ Sudah Selesai (Resolved)</option>
                <option value="ALL">Semua Status</option>
            </select>

            <button onclick="loadLogs(1)" class="bg-slate-800 hover:bg-slate-900 text-white px-4 py-2 rounded-xl text-sm font-medium shadow-sm transition-colors">
                Terapkan
            </button>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-6">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-slate-700 text-xs uppercase font-semibold border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-4">Waktu (WIB)</th>
                            <th class="py-3.5 px-3">Tingkat</th>
                            <th class="py-3.5 px-4">Pengguna &amp; Peran</th>
                            <th class="py-3.5 px-4">Perangkat &amp; OS</th>
                            <th class="py-3.5 px-4">Modul / Pesan Error</th>
                            <th class="py-3.5 px-3 text-center">Status</th>
                            <th class="py-3.5 px-4 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="logsTableBody" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mb-2"></div>
                                <p>Memuat data log error...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="p-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
                <span class="text-xs text-slate-500" id="paginationInfo">Menampilkan 0 data</span>
                <div class="flex items-center gap-1.5" id="paginationControls"></div>
            </div>
        </div>
    </main>

    <!-- Detail Stack Trace Modal -->
    <div id="detailModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center z-50 hidden p-4">
        <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[90vh]">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/80">
                <div class="flex items-center gap-2.5">
                    <span id="modalLevelBadge" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-100 text-rose-700">CRASH</span>
                    <h3 class="font-bold text-slate-800 text-base" id="modalTag">Detail Error APK</h3>
                </div>
                <button onclick="closeDetailModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 text-lg">✕</button>
            </div>

            <div class="p-6 overflow-y-auto space-y-4">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-3.5 bg-slate-50 rounded-xl border border-slate-100 text-xs">
                    <div>
                        <span class="text-slate-400 block">Waktu Kejadian:</span>
                        <strong class="text-slate-700" id="modalTimestamp">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Model Perangkat:</span>
                        <strong class="text-slate-700" id="modalDevice">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Versi Android:</span>
                        <strong class="text-slate-700" id="modalOs">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Versi APK:</span>
                        <strong class="text-slate-700" id="modalAppVersion">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Pengguna:</span>
                        <strong class="text-slate-700" id="modalUser">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Role Akun:</span>
                        <strong class="text-slate-700" id="modalRole">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Layar / Activity:</span>
                        <strong class="text-slate-700" id="modalActivity">-</strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block">Koneksi Jaringan:</span>
                        <strong class="text-slate-700" id="modalNetwork">-</strong>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-bold text-slate-700 uppercase mb-1">Pesan Error Lengkap:</h4>
                    <div class="p-3 bg-rose-50 border border-rose-100 text-rose-800 rounded-xl text-xs font-mono break-all" id="modalErrorMessage">-</div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <h4 class="text-xs font-bold text-slate-700 uppercase">Stack Trace Lengkap:</h4>
                        <button onclick="copyStackTrace()" class="text-xs text-blue-600 hover:text-blue-800 font-semibold flex items-center gap-1">
                            <span>📋</span> Salin Stack Trace
                        </button>
                    </div>
                    <pre class="p-4 bg-slate-900 text-emerald-400 rounded-xl text-xs font-mono overflow-x-auto max-h-[320px] select-all leading-relaxed" id="modalStackTrace">-</pre>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
                <button id="btnResolveModal" onclick="resolveCurrentModalLog()" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm flex items-center gap-1.5 transition-colors">
                    <span>✅</span> Tandai Sudah Selesai Diperbaiki
                </button>
                <button onclick="closeDetailModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentLogs = [];
        let activeModalLogId = null;
        let currentPage = 1;

        function getAuthToken() {
            let tok = localStorage.getItem('token') || localStorage.getItem('admin_token');
            if (!tok) {
                const match = document.cookie.match(/(?:^|;\s*)(?:token|admin_token|jwt_token)=([^;]+)/);
                if (match) tok = decodeURIComponent(match[1]);
            }
            return tok || '';
        }

        async function loadLogs(page = 1) {
            currentPage = page;
            const search = document.getElementById('searchInput').value.trim();
            const level = document.getElementById('filterLevel').value;
            const role = document.getElementById('filterRole').value;
            const resolved = document.getElementById('filterStatus').value;

            const tbody = document.getElementById('logsTableBody');
            tbody.innerHTML = `<tr><td colspan="7" class="py-10 text-center text-slate-400">
                <div class="inline-block animate-spin rounded-full h-5 w-5 border-b-2 border-blue-600 mb-2"></div>
                <p>Memuat data...</p>
            </td></tr>`;

            try {
                const params = new URLSearchParams({ page, limit: 25 });
                if (search) params.append('search', search);
                if (level !== 'ALL') params.append('level', level);
                if (role !== 'ALL') params.append('role', role);
                if (resolved !== 'ALL') params.append('resolved', resolved);

                const tok = getAuthToken();
                const headers = {};
                if (tok) headers['Authorization'] = 'Bearer ' + tok;

                const res = await fetch('/api/app/client-logs?' + params.toString(), {
                    credentials: 'include',
                    headers: headers
                });
                const json = await res.json();

                if (!res.ok || !json.success) {
                    tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-rose-500">Gagal memuat log: ${json.message || 'Terjadi kesalahan'}</td></tr>`;
                    return;
                }

                currentLogs = json.data || [];
                renderTable(currentLogs);
                renderPagination(json.pagination);
                updateStats(json.stats);
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-rose-500">Kesalahan jaringan: ${err.message}</td></tr>`;
            }
        }

        function escapeHtml(str) {
            if (str == null) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderTable(logs) {
            const tbody = document.getElementById('logsTableBody');
            if (logs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-slate-400">
                    <p class="text-3xl mb-1">🎉</p>
                    <p class="font-semibold text-slate-600">Tidak ada log error yang cocok.</p>
                    <p class="text-xs text-slate-400">Semua aplikasi client berjalan dengan mulus tanpa kendala.</p>
                </td></tr>`;
                return;
            }

            tbody.innerHTML = logs.map(l => {
                const dateStr = new Date(l.createdAt).toLocaleString('id-ID', {
                    day: '2-digit', month: 'short', year: 'numeric',
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });

                let levelBadge = '';
                if (l.level === 'CRASH' || l.level === 'FATAL') {
                    levelBadge = '<span class="px-2 py-0.5 rounded-md text-xs font-bold bg-rose-100 text-rose-700 animate-pulse">💥 CRASH</span>';
                } else if (l.level === 'ERROR') {
                    levelBadge = '<span class="px-2 py-0.5 rounded-md text-xs font-bold bg-amber-100 text-amber-700">⚠️ ERROR</span>';
                } else {
                    levelBadge = '<span class="px-2 py-0.5 rounded-md text-xs font-semibold bg-blue-100 text-blue-700">🟡 WARN</span>';
                }

                const statusBadge = l.resolved
                    ? '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">✅ Selesai</span>'
                    : '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">⏳ Pending</span>';

                const deviceStr = [l.deviceModel, l.androidVersion].filter(Boolean).join(' • ') || 'Perangkat Anonim';
                const userStr = l.username ? `${l.username} (${l.role || 'User'})` : (l.role || 'Anonim');
                const safeId = encodeURIComponent(String(l.id || ''));

                return `
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td class="py-3.5 px-4 font-mono text-xs text-slate-500 whitespace-nowrap">${dateStr} WIB</td>
                        <td class="py-3.5 px-3 whitespace-nowrap">${levelBadge}</td>
                        <td class="py-3.5 px-4">
                            <div class="font-semibold text-slate-800">${escapeHtml(userStr)}</div>
                            <div class="text-xs text-slate-400">${escapeHtml(l.activityName || 'Global Context')}</div>
                        </td>
                        <td class="py-3.5 px-4">
                            <div class="font-medium text-slate-700">${escapeHtml(deviceStr)}</div>
                            <div class="text-xs text-slate-400">v${escapeHtml(l.appVersion || 'Unknown')} • ${escapeHtml(l.networkType || 'Unknown Net')}</div>
                        </td>
                        <td class="py-3.5 px-4 max-w-xs">
                            <span class="text-xs font-bold text-slate-500 block mb-0.5">[${escapeHtml(l.tag || 'General')}]</span>
                            <p class="text-xs text-slate-800 line-clamp-2 break-all font-mono" title="${escapeHtml(l.errorMessage)}">${escapeHtml(l.errorMessage)}</p>
                        </td>
                        <td class="py-3.5 px-3 text-center whitespace-nowrap">${statusBadge}</td>
                        <td class="py-3.5 px-4 text-center whitespace-nowrap">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="openDetailModal('${safeId}')" class="px-2.5 py-1.5 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 font-semibold text-xs transition-colors" title="Lihat Stack Trace">
                                    🔍 Detail
                                </button>
                                ${!l.resolved ? `
                                    <button onclick="toggleResolve('${safeId}', true)" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-100 font-semibold text-xs transition-colors" title="Tandai Selesai">
                                        ✅ Selesai
                                    </button>
                                ` : `
                                    <button onclick="deleteLog('${safeId}')" class="px-2 py-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 text-xs transition-colors" title="Hapus Log">
                                        🗑️
                                    </button>
                                `}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderPagination(pagination) {
            if (!pagination) return;
            document.getElementById('paginationInfo').textContent = `Menampilkan ${pagination.total > 0 ? (pagination.page - 1) * pagination.limit + 1 : 0} - ${Math.min(pagination.page * pagination.limit, pagination.total)} dari ${pagination.total} log`;

            const ctrl = document.getElementById('paginationControls');
            let btns = '';

            if (pagination.page > 1) {
                btns += `<button onclick="loadLogs(${pagination.page - 1})" class="px-3 py-1 rounded-lg text-xs bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 font-semibold">❮ Sebelumnya</button>`;
            }
            btns += `<span class="px-3 py-1 text-xs text-slate-500 font-semibold">Hal ${pagination.page} / ${pagination.totalPages || 1}</span>`;
            if (pagination.page < pagination.totalPages) {
                btns += `<button onclick="loadLogs(${pagination.page + 1})" class="px-3 py-1 rounded-lg text-xs bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 font-semibold">Berikutnya ❯</button>`;
            }
            ctrl.innerHTML = btns;
        }

        function updateStats(stats) {
            if (!stats) return;
            document.getElementById('statTotalLogs').textContent = stats.total || 0;
            document.getElementById('statCrashCount').textContent = stats.crashCount || 0;
            document.getElementById('statUnresolvedCount').textContent = stats.unresolvedCount || 0;
        }

        function openDetailModal(logId) {
            const log = currentLogs.find(l => l.id === logId);
            if (!log) return;
            activeModalLogId = logId;

            document.getElementById('modalLevelBadge').textContent = log.level;
            document.getElementById('modalLevelBadge').className = log.level === 'CRASH' || log.level === 'FATAL'
                ? 'px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-100 text-rose-700'
                : 'px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-100 text-amber-700';

            document.getElementById('modalTag').textContent = `[${log.tag || 'General'}] Detail Masalah APK`;
            document.getElementById('modalTimestamp').textContent = new Date(log.createdAt).toLocaleString('id-ID') + ' WIB';
            document.getElementById('modalDevice').textContent = log.deviceModel || '-';
            document.getElementById('modalOs').textContent = log.androidVersion || '-';
            document.getElementById('modalAppVersion').textContent = log.appVersion || '-';
            document.getElementById('modalUser').textContent = log.username || '-';
            document.getElementById('modalRole').textContent = log.role || '-';
            document.getElementById('modalActivity').textContent = log.activityName || '-';
            document.getElementById('modalNetwork').textContent = log.networkType || '-';

            document.getElementById('modalErrorMessage').textContent = log.errorMessage || '-';
            document.getElementById('modalStackTrace').textContent = log.stackTrace || 'Tidak ada stack trace terekam.';

            const btnResolve = document.getElementById('btnResolveModal');
            if (log.resolved) {
                btnResolve.classList.add('hidden');
            } else {
                btnResolve.classList.remove('hidden');
            }

            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
            activeModalLogId = null;
        }

        function copyStackTrace() {
            const st = document.getElementById('modalStackTrace').textContent;
            navigator.clipboard.writeText(st).then(() => {
                alert('✅ Stack trace berhasil disalin ke clipboard!');
            }).catch(() => {
                alert('Gagal menyalin otomatis, silakan pilih teks secara manual.');
            });
        }

        async function toggleResolve(logId, resolved) {
            try {
                const tok = getAuthToken();
                const headers = { 'Content-Type': 'application/json' };
                if (tok) headers['Authorization'] = 'Bearer ' + tok;

                const res = await fetch(`/api/app/client-logs/${logId}/resolve`, {
                    method: 'PUT',
                    credentials: 'include',
                    headers: headers,
                    body: JSON.stringify({ resolved })
                });
                const json = await res.json();
                if (res.ok && json.success) {
                    loadLogs(currentPage);
                    if (activeModalLogId === logId) closeDetailModal();
                } else {
                    alert('Gagal memperbarui status: ' + (json.message || ''));
                }
            } catch (e) {
                alert('Kesalahan jaringan: ' + e.message);
            }
        }

        function resolveCurrentModalLog() {
            if (activeModalLogId) {
                toggleResolve(activeModalLogId, true);
            }
        }

        async function deleteLog(logId) {
            if (!confirm('Hapus riwayat log error ini secara permanen?')) return;
            try {
                const tok = getAuthToken();
                const headers = {};
                if (tok) headers['Authorization'] = 'Bearer ' + tok;

                const res = await fetch(`/api/app/client-logs/${logId}`, {
                    method: 'DELETE',
                    credentials: 'include',
                    headers: headers
                });
                const json = await res.json();
                if (res.ok && json.success) {
                    loadLogs(currentPage);
                } else {
                    alert('Gagal menghapus log');
                }
            } catch (e) {
                alert('Kesalahan: ' + e.message);
            }
        }

        async function cleanupResolvedLogs() {
            if (!confirm('Hapus seluruh log yang berstatus "Sudah Selesai" dari database?')) return;
            try {
                const tok = getAuthToken();
                const headers = { 'Content-Type': 'application/json' };
                if (tok) headers['Authorization'] = 'Bearer ' + tok;

                const res = await fetch('/api/app/client-logs/cleanup', {
                    method: 'POST',
                    credentials: 'include',
                    headers: headers,
                    body: JSON.stringify({ type: 'resolved' })
                });
                const json = await res.json();
                alert(json.message || 'Pembersihan selesai');
                loadLogs(1);
            } catch (e) {
                alert('Kesalahan: ' + e.message);
            }
        }

        // Inisialisasi
        document.addEventListener('DOMContentLoaded', () => loadLogs(1));
    </script>
</body>
</html>
