<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Operator & Admin - Smart School CBT</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex antialiased">

    <!-- Modern Sidebar -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content Area -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Top Navbar Header -->
        <header class="flex flex-col md:flex-row md:items-center md:justify-between pb-6 mb-8 border-b border-slate-200/80 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-7 bg-indigo-600 rounded-full"></div>
                        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Dashboard Utama</h1>
                        <span class="bg-indigo-50 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-full border border-indigo-200/60">Administrator</span>
                    </div>
                    <p class="text-slate-500 text-xs mt-1 ml-5">Pusat kendali operasional sekolah, presensi harian, ujian CBT, dan materi siswa.</p>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-2.5">
                <button onclick="openBroadcastModal()" class="btn-primary-blue text-xs shadow-md shadow-blue-500/20 cursor-pointer flex items-center gap-1.5">
                    <span class="text-sm">📢</span>
                    <span>Buat Siaran Pengumuman</span>
                </button>
                <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border border-indigo-500/40 px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-semibold">🕒 Jam Server:</span>
                    <span id="serverLiveClock" class="server-clock-display font-mono text-emerald-400 font-extrabold text-sm tracking-wider">--:--:-- WIB</span>
                </div>
            </div>
        </header>

        <!-- 4 Key Metrics Overview Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            <!-- Card 1: Total Siswa -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-blue-300 transition-all flex items-center justify-between group">
                <div>
                    <span class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">Total Siswa</span>
                    <h3 class="text-2xl font-black text-slate-800 mt-1" id="dashTotalStudents">--</h3>
                    <span class="text-[11px] text-blue-600 font-semibold flex items-center gap-1 mt-1">
                        <span>●</span> Terdaftar aktif
                    </span>
                </div>
                <div class="w-13 h-13 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl group-hover:bg-blue-600 group-hover:text-white transition-all shadow-inner">
                    👨‍🎓
                </div>
            </div>

            <!-- Card 2: Kehadiran Hari Ini -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all flex items-center justify-between group">
                <div>
                    <span class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">Presensi Hari Ini</span>
                    <h3 class="text-2xl font-black text-emerald-600 mt-1" id="dashPresentCount">0</h3>
                    <span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1 mt-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Hadir di sekolah
                    </span>
                </div>
                <div class="w-13 h-13 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl group-hover:bg-emerald-600 group-hover:text-white transition-all shadow-inner">
                    ✅
                </div>
            </div>

            <!-- Card 3: Ujian CBT Aktif -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all flex items-center justify-between group">
                <div>
                    <span class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">Ujian CBT Aktif</span>
                    <h3 class="text-2xl font-black text-indigo-600 mt-1" id="dashActiveExams">0</h3>
                    <span class="text-[11px] text-indigo-600 font-semibold flex items-center gap-1 mt-1">
                        <span>●</span> Sesi berlangsung
                    </span>
                </div>
                <div class="w-13 h-13 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-inner">
                    📝
                </div>
            </div>

            <!-- Card 4: Tugas & Pembelajaran -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-amber-300 transition-all flex items-center justify-between group">
                <div>
                    <span class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">Tugas Terjadwal</span>
                    <h3 class="text-2xl font-black text-amber-600 mt-1" id="dashTotalHomeworks">0</h3>
                    <span class="text-[11px] text-amber-600 font-semibold flex items-center gap-1 mt-1">
                        <span>●</span> E-learning & PR
                    </span>
                </div>
                <div class="w-13 h-13 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl group-hover:bg-amber-600 group-hover:text-white transition-all shadow-inner">
                    📚
                </div>
            </div>
        </div>

        <!-- Live Server Hardware & Bandwidth Monitoring (RAM & Bandwidth Focus) -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 rounded-2xl p-6 text-white shadow-lg border border-slate-700/60 mb-8 relative overflow-hidden">
            <!-- Subtle Background Glow -->
            <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-10 -top-10 w-60 h-60 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-4 mb-5 border-b border-slate-700/80 gap-3 relative z-10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-xl text-indigo-300 shadow-inner">
                        🖥️
                    </div>
                    <div>
                        <div class="flex items-center gap-2.5">
                            <h2 class="text-base font-extrabold tracking-tight text-white">Monitoring Server & Bandwidth Real-Time</h2>
                            <span id="serverStatusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> ONLINE
                            </span>
                        </div>
                        <p class="text-xs text-slate-400 mt-0.5">Pemantauan kapasitas RAM fisik, lalu lintas jaringan (Bandwidth In/Out), beban CPU, dan uptime server.</p>
                    </div>
                </div>

                <div class="flex items-center gap-2.5 self-end lg:self-auto">
                    <div class="flex items-center gap-2 bg-slate-800/90 border border-slate-700 px-3 py-1.5 rounded-xl text-xs text-slate-300">
                        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                        <span id="serverLiveClock" class="font-mono font-bold text-sky-300">--:--:--</span>
                    </div>
                    <a href="/admin/feature-panel" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 transition-all flex items-center gap-1.5 shadow-md shadow-amber-500/20">
                        <span>🎛️ Panel Kontrol Fitur</span> &rarr;
                    </a>
                    <a href="/admin/cbt/capacity" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white transition-all flex items-center gap-1.5 shadow-md shadow-indigo-600/30">
                        <span>⚡ Diagnostik CBT</span> &rarr;
                    </a>
                    <button onclick="loadServerLiveStats(true)" title="Refresh Data Sekarang" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition-all cursor-pointer">
                        <svg id="refreshServerIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Grid of Telemetry Widgets (RAM, Bandwidth RX/TX, CPU & Uptime) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 relative z-10">
                
                <!-- Widget 1: RAM SERVER USAGE -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 flex flex-col justify-between hover:border-slate-600 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase">Kapasitas RAM Server</span>
                            <h3 class="text-xl font-black text-white mt-1 font-mono" id="valRamText">-- / -- GB</h3>
                        </div>
                        <span id="valRamBadge" class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">--%</span>
                    </div>
                    <!-- Progress Bar -->
                    <div class="mt-3">
                        <div class="w-full bg-slate-700/80 rounded-full h-2.5 overflow-hidden">
                            <div id="barRamProgress" class="bg-gradient-to-r from-emerald-500 to-teal-400 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                        <div class="flex justify-between items-center text-[10px] text-slate-400 mt-1.5">
                            <span>Sisa: <strong id="valRamFree" class="text-slate-200">-- GB</strong></span>
                            <span>Node.js: <strong id="valRamHeap" class="text-slate-200">-- MB</strong></span>
                        </div>
                    </div>
                </div>

                <!-- Widget 2: BANDWIDTH RX (DOWNLOAD / MASUK) -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 flex flex-col justify-between hover:border-slate-600 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase flex items-center gap-1">
                                <span class="text-emerald-400">📥</span> Bandwidth Masuk (RX)
                            </span>
                            <h3 class="text-xl font-black text-emerald-400 mt-1 font-mono flex items-center gap-1.5" id="valRxSpeed">
                                <span>0 KB/s</span>
                            </h3>
                        </div>
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-sm font-bold">
                            ↓
                        </div>
                    </div>
                    <div class="mt-3 pt-2 border-t border-slate-700/60 flex justify-between items-center text-[10px] text-slate-400">
                        <span>Total Diterima:</span>
                        <strong id="valTotalRx" class="text-slate-200 font-mono">-- MB</strong>
                    </div>
                </div>

                <!-- Widget 3: BANDWIDTH TX (UPLOAD / KELUAR) -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 flex flex-col justify-between hover:border-slate-600 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase flex items-center gap-1">
                                <span class="text-sky-400">📤</span> Bandwidth Keluar (TX)
                            </span>
                            <h3 class="text-xl font-black text-sky-400 mt-1 font-mono flex items-center gap-1.5" id="valTxSpeed">
                                <span>0 KB/s</span>
                            </h3>
                        </div>
                        <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 text-sm font-bold">
                            ↑
                        </div>
                    </div>
                    <div class="mt-3 pt-2 border-t border-slate-700/60 flex justify-between items-center text-[10px] text-slate-400">
                        <span>Total Terkirim:</span>
                        <strong id="valTotalTx" class="text-slate-200 font-mono">-- MB</strong>
                    </div>
                </div>

                <!-- Widget 4: CPU LOAD & UPTIME SERVER -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-4 flex flex-col justify-between hover:border-slate-600 transition-all">
                    <div class="flex justify-between items-start">
                        <div class="min-w-0 pr-2">
                            <div class="flex items-center gap-1.5">
                                <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase">⚡ Core Load</span>
                                <span id="valCpuStatusBadge" class="text-[9px] font-extrabold px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">NORMAL</span>
                            </div>
                            <div class="flex items-baseline gap-2 mt-1">
                                <h3 class="text-xl font-black text-amber-300 font-mono" id="valCpuLoad">--%</h3>
                                <span class="text-[10px] font-medium text-slate-300 truncate max-w-[130px]" id="valCpuModel" title="Intel(R) Core(TM) i3-4160 CPU @ 3.60GHz">Intel i3-4160</span>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-700 text-slate-300 whitespace-nowrap" id="valCpuCores">-- Core</span>
                    </div>
                    <!-- Progress Bar & Hardware Details -->
                    <div class="mt-3">
                        <div class="w-full bg-slate-700/80 rounded-full h-2.5 overflow-hidden">
                            <div id="barCpuProgress" class="bg-gradient-to-r from-amber-500 to-yellow-400 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                        <div class="flex justify-between items-center text-[10px] text-slate-400 mt-1.5">
                            <span>Uptime: <strong id="valServerUptime" class="text-slate-200 font-medium truncate max-w-[110px]">--</strong></span>
                            <span id="valCpuSpeedBadge" class="text-amber-300 font-mono font-semibold">3.60 GHz</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- 2 Column Section: Pengumuman (Left) & Presensi Realtime (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            
            <!-- Left: Pengumuman Sekolah & Broadcast Multi-Kanal (Modul 5) -->
            <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-slate-100 gap-2">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg">📢</span>
                            <h2 class="text-base font-extrabold text-slate-800">Siaran Pengumuman &amp; Respon Cepat</h2>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-0.5">Siaran bertingkat (Sekolah / Tingkat / Kelas / Role) dengan pelacakan respon real-time.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/admin/pengumuman" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 transition-colors bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-xl border border-indigo-200">
                            <span>Pusat Broadcast</span> &rarr;
                        </a>
                        <button onclick="loadAnnouncements()" class="text-xs font-semibold text-slate-600 hover:text-slate-800 p-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 transition-colors cursor-pointer" title="Segarkan Data">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        </button>
                    </div>
                </div>

                <!-- Priority Filters -->
                <div class="flex items-center gap-1.5 mb-3 overflow-x-auto pb-1 text-xs">
                    <button onclick="filterBroadcastPriority('ALL')" id="filterBtn-ALL" class="px-3 py-1 rounded-lg font-bold bg-slate-900 text-white text-[11px] transition-all cursor-pointer">Semua</button>
                    <button onclick="filterBroadcastPriority('MENDESAK')" id="filterBtn-MENDESAK" class="px-3 py-1 rounded-lg font-bold bg-slate-100 text-slate-600 hover:bg-rose-50 hover:text-rose-600 text-[11px] transition-all cursor-pointer">🚨 Mendesak</button>
                    <button onclick="filterBroadcastPriority('PENTING')" id="filterBtn-PENTING" class="px-3 py-1 rounded-lg font-bold bg-slate-100 text-slate-600 hover:bg-amber-50 hover:text-amber-600 text-[11px] transition-all cursor-pointer">⚠️ Penting</button>
                    <button onclick="filterBroadcastPriority('BIASA')" id="filterBtn-BIASA" class="px-3 py-1 rounded-lg font-bold bg-slate-100 text-slate-600 hover:bg-blue-50 hover:text-blue-600 text-[11px] transition-all cursor-pointer">📢 Biasa</button>
                </div>

                <div id="announcementList" class="space-y-3 flex-1 overflow-y-auto max-h-[420px] pr-1">
                    <div class="flex items-center justify-center py-12 text-slate-400 text-xs">
                        <div class="inline-block w-5 h-5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin mr-2"></div>
                        Memuat siaran pengumuman...
                    </div>
                </div>
            </div>

            <!-- Right: Presensi Hari Ini breakdown -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">📋</span>
                            <h2 class="text-base font-extrabold text-slate-800">Presensi Hari Ini</h2>
                        </div>
                        <a href="/admin/absensi" class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 transition-colors">
                            <span>Rekap</span> &rarr;
                        </a>
                    </div>

                    <div class="space-y-2.5">
                        <div class="flex justify-between items-center p-3 bg-emerald-50/70 rounded-xl border border-emerald-100 transition-all hover:bg-emerald-50">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                <span class="text-xs font-bold text-emerald-900">Hadir Tepat Waktu</span>
                            </div>
                            <span class="font-black text-sm text-emerald-700" id="absPresent">0</span>
                        </div>

                        <div class="flex justify-between items-center p-3 bg-amber-50/70 rounded-xl border border-amber-100 transition-all hover:bg-amber-50">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                                <span class="text-xs font-bold text-amber-900">Terlambat Masuk</span>
                            </div>
                            <span class="font-black text-sm text-amber-700" id="absLate">0</span>
                        </div>

                        <a href="/bk?tab=izin" title="Klik untuk verifikasi surat izin / sakit siswa" class="flex justify-between items-center p-3 bg-sky-50/70 rounded-xl border border-sky-100 transition-all hover:bg-sky-100/90 cursor-pointer group">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span>
                                <span class="text-xs font-bold text-sky-900 group-hover:text-sky-700">Izin / Sakit (Verifikasi) ↗</span>
                            </div>
                            <span class="font-black text-sm text-sky-700" id="absPermission">0</span>
                        </a>

                        <div class="flex justify-between items-center p-3 bg-rose-50/70 rounded-xl border border-rose-100 transition-all hover:bg-rose-50">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                                <span class="text-xs font-bold text-rose-900">Alpa (Tanpa Keterangan)</span>
                            </div>
                            <span class="font-black text-sm text-rose-700" id="absAbsent">0</span>
                        </div>

                        <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-200 transition-all hover:bg-slate-100">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                                <span class="text-xs font-bold text-slate-700">Belum Presensi</span>
                            </div>
                            <span class="font-black text-sm text-slate-700" id="absNotYet">0</span>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-3 border-t border-slate-100">
                    <a href="/admin/absensi" class="w-full btn-primary-blue text-xs text-center py-2.5 rounded-xl shadow-md">
                        Buka Laporan Presensi Lengkap
                    </a>
                </div>
            </div>
        </div>

        <!-- Quick Access Control Bar -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-slate-100 gap-2">
                <div class="flex items-center gap-2">
                    <span class="text-lg">⚡</span>
                    <h2 class="text-base font-extrabold text-slate-800">Pusat Layanan Terpadu</h2>
                </div>
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-[11px] font-bold px-3 py-1 rounded-full border border-emerald-200">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Anti-Cheat Proctor Ready
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 hover:bg-blue-50/50 hover:border-blue-200 transition-all flex items-center justify-between">
                    <div>
                        <p class="font-extrabold text-slate-800 text-sm">Server CBT & Bank Soal</p>
                        <p class="text-[11px] text-emerald-600 font-semibold mt-0.5">● Engine Online (High Performance)</p>
                    </div>
                    <a href="/admin/cbt" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-sm">
                        Kelola CBT
                    </a>
                </div>

                <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 hover:bg-blue-50/50 hover:border-blue-200 transition-all flex items-center justify-between">
                    <div>
                        <p class="font-extrabold text-slate-800 text-sm">Kunci Perangkat (Lockdown)</p>
                        <p class="text-[11px] text-slate-500 mt-0.5">Kiosk Mode & Anti-Split Screen</p>
                    </div>
                    <a href="/admin/monitoring" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-200 text-slate-700 hover:bg-slate-300 transition-colors">
                        Monitoring
                    </a>
                </div>

                <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 hover:bg-blue-50/50 hover:border-blue-200 transition-all flex items-center justify-between">
                    <div>
                        <p class="font-extrabold text-slate-800 text-sm">E-Library & Modul Siswa</p>
                        <p class="text-[11px] text-slate-500 mt-0.5">Bahan ajar & bank tugas mandiri</p>
                    </div>
                    <a href="/admin/tugas" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-white hover:bg-amber-600 transition-colors shadow-sm">
                        Modul Tugas
                    </a>
                </div>

                <div class="p-4 rounded-xl border border-purple-200/80 bg-purple-50/50 hover:bg-purple-100/50 hover:border-purple-300 transition-all flex items-center justify-between">
                    <div>
                        <p class="font-extrabold text-slate-800 text-sm">Rekap Sholat &amp; PAI</p>
                        <p class="text-[11px] text-purple-700 font-semibold mt-0.5">Monitoring Ibadah &amp; Cetak PDF</p>
                    </div>
                    <button onclick="openDownloadPrayerPdfModal()" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-purple-600 text-white hover:bg-purple-700 transition-colors shadow-sm cursor-pointer flex items-center gap-1">
                        <span>📥</span> Rekap PDF
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL BUAT SIARAN PENGUMUMAN BERTINGKAT (MODUL 5) -->
    <div id="modalAnnouncement" class="hidden fixed inset-0 bg-slate-950/70 backdrop-blur-xs flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl w-full max-w-xl shadow-2xl border border-slate-200 overflow-hidden animate-fade-in max-h-[90vh] flex flex-col">
            <div class="px-6 py-4 bg-gradient-to-r from-blue-700 via-indigo-800 to-indigo-900 text-white flex justify-between items-center flex-shrink-0">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📢</span>
                    <div>
                        <h2 class="text-base font-extrabold leading-tight">Buat Siaran Broadcast</h2>
                        <p class="text-[11px] text-blue-200">Kirim notifikasi prioritas resmi ke Siswa dan Orang Tua dengan estimasi penerima real-time</p>
                    </div>
                </div>
                <button type="button" onclick="closeBroadcastModal()" class="text-white/80 hover:text-white text-2xl font-bold transition-colors cursor-pointer">&times;</button>
            </div>
            
            <form id="announcementForm" class="p-6 space-y-4 overflow-y-auto flex-1 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1.5">Judul Pengumuman *</label>
                    <input type="text" id="annTitle" placeholder="Cth: Jadwal Penilaian Akhir Semester (PAS) Ganjil 2026" class="w-full border-2 border-slate-200 rounded-xl p-3 text-xs font-semibold focus:border-indigo-600 focus:outline-none bg-slate-50/50" required>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1.5">Tingkat Prioritas *</label>
                        <select id="annPrioritas" class="w-full border-2 border-slate-200 rounded-xl p-2.5 text-xs font-bold focus:border-indigo-600 focus:outline-none bg-slate-50/50" required>
                            <option value="BIASA">📢 BIASA (Informasi Standar)</option>
                            <option value="PENTING">⚠️ PENTING (Wajib Baca & Highlight)</option>
                            <option value="MENDESAK">🚨 MENDESAK (Darurat / Push Notif)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1.5">Target Penerima *</label>
                        <select id="annTargetLevel" onchange="onTargetLevelChange()" class="w-full border-2 border-slate-200 rounded-xl p-2.5 text-xs font-bold focus:border-indigo-600 focus:outline-none bg-slate-50/50" required>
                            <option value="STUDENT_ONLY">👨‍🎓 Siswa Saja</option>
                            <option value="STUDENT_PARENT">👨‍👩‍👦 Siswa &amp; Orang Tua</option>
                            <option value="PARENT_ONLY">👪 Orang Tua Saja</option>
                            <option value="TINGKAT">🎓 Tingkat Jenjang (Kelas 7 / 8 / 9)</option>
                            <option value="KELAS">🏢 Rombel / Kelas Tertentu</option>
                        </select>
                    </div>
                </div>

                <!-- Sub Target Dropdowns -->
                <div id="subTargetWrapper" class="hidden p-3.5 bg-slate-50 rounded-2xl border border-slate-200">
                    <div id="tingkatWrapper" class="hidden">
                        <label class="block font-bold text-slate-700 mb-1">Pilih Tingkat Jenjang</label>
                        <select id="annTargetTingkat" onchange="previewBroadcastAudience()" class="w-full border border-slate-300 rounded-xl p-2 text-xs font-semibold bg-white focus:border-indigo-600 focus:outline-none">
                            <option value="VII">Kelas 7 (Tingkat VII)</option>
                            <option value="VIII">Kelas 8 (Tingkat VIII)</option>
                            <option value="IX">Kelas 9 (Tingkat IX)</option>
                        </select>
                    </div>
                    <div id="kelasWrapper" class="hidden">
                        <label class="block font-bold text-slate-700 mb-1">Pilih Rombel / Kelas</label>
                        <select id="annTargetKelas" onchange="previewBroadcastAudience()" class="w-full border border-slate-300 rounded-xl p-2 text-xs font-semibold bg-white focus:border-indigo-600 focus:outline-none">
                            <option value="">Memuat data kelas...</option>
                        </select>
                    </div>
                    <div id="roleWrapper" class="hidden">
                        <label class="block font-bold text-slate-700 mb-1">Pilih Target Pengguna</label>
                        <select id="annTargetRole" onchange="previewBroadcastAudience()" class="w-full border border-slate-300 rounded-xl p-2 text-xs font-semibold bg-white focus:border-indigo-600 focus:outline-none">
                            <option value="STUDENT">👨‍🎓 Siswa Saja</option>
                            <option value="STUDENT_PARENT">👨‍👩‍👦 Siswa &amp; Orang Tua</option>
                            <option value="PARENT">👪 Orang Tua Saja</option>
                        </select>
                    </div>
                </div>

                <!-- Live Audience Preview Box -->
                <div id="annAudiencePreviewBox" class="p-3.5 bg-indigo-50/80 border border-indigo-200 rounded-2xl flex items-center gap-3 text-indigo-900 font-medium">
                    <span class="text-xl flex-shrink-0">👥</span>
                    <div class="text-[11.5px] leading-relaxed" id="annAudiencePreviewText">
                        Menghitung estimasi penerima broadcast...
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1.5">Isi Pesan / Instruksi Pengumuman *</label>
                    <textarea id="annContent" placeholder="Tuliskan isi pengumuman atau instruksi resmi dengan jelas..." class="w-full border-2 border-slate-200 rounded-xl p-3 text-xs font-semibold focus:border-indigo-600 focus:outline-none bg-slate-50/50" rows="4" required></textarea>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1.5">Tautan / URL Lampiran (Opsional)</label>
                    <input type="url" id="annLampiranUrl" placeholder="https://drive.google.com/... atau /uploads/surat.pdf" class="w-full border-2 border-slate-200 rounded-xl p-2.5 text-xs font-semibold focus:border-indigo-600 focus:outline-none bg-slate-50/50">
                </div>

                <div class="flex justify-end gap-2.5 pt-4 border-t border-slate-100 flex-shrink-0">
                    <button type="button" onclick="closeBroadcastModal()" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer">Batal</button>
                    <button type="submit" id="btnSubmitBroadcast" class="btn-primary-blue text-xs shadow-md shadow-blue-500/20 cursor-pointer flex items-center gap-1.5">
                        <span>🚀</span>
                        <span>Siarkan Sekarang</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/';
        }

        initServerClock();
        loadDashboardData();
        loadAnnouncements();
        loadServerLiveStats();
        setInterval(loadServerLiveStats, 3000);

        // Real-Time Server Clock (WIB 24 Jam)
        let serverClockOffset = 0;
        async function initServerClock() {
            try {
                const res = await fetch('/api/server-time');
                if (res.ok) {
                    const data = await res.json();
                    serverClockOffset = data.timestamp - Date.now();
                }
            } catch (e) {
                console.warn('Gagal sinkronisasi waktu server:', e);
            }
            updateServerClock();
            setInterval(updateServerClock, 1000);
        }

        function updateServerClock() {
            const clockEls = document.querySelectorAll('.server-clock-display, #serverLiveClock');
            if (!clockEls.length) return;
            const now = new Date(Date.now() + serverClockOffset);
            const timeStr = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Jakarta',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            }).format(now) + ' WIB';
            
            clockEls.forEach(el => {
                el.innerText = timeStr;
            });
        }

        async function loadDashboardData() {
            try {
                // Presensi stats
                const resAbs = await fetch('/api/attendance/today', { headers: { 'Authorization': 'Bearer ' + token } });
                const absData = await resAbs.json();
                if(absData && absData.stats) {
                    document.getElementById('dashTotalStudents').innerText = absData.stats.totalStudents || 0;
                    document.getElementById('dashPresentCount').innerText = (absData.stats.present || 0) + (absData.stats.late || 0);
                    document.getElementById('absPresent').innerText = absData.stats.present || 0;
                    document.getElementById('absLate').innerText = absData.stats.late || 0;
                    document.getElementById('absPermission').innerText = (absData.stats.permission || 0) + (absData.stats.sick || 0);
                    document.getElementById('absAbsent').innerText = absData.stats.absent || 0;
                    document.getElementById('absNotYet').innerText = absData.stats.notYet || 0;
                }

                // CBT Exams stats
                const resExams = await fetch('/api/guru/exams', { headers: { 'Authorization': 'Bearer ' + token } });
                const examData = await resExams.json();
                if(Array.isArray(examData)) {
                    document.getElementById('dashActiveExams').innerText = examData.length;
                    if(examData.length > 0) {
                        const tokenEl = document.getElementById('dashTokenBadge');
                        if (tokenEl) tokenEl.innerText = (examData[0].isTokenActive && examData[0].token) ? examData[0].token : (examData[0].token || 'OFF');
                    }
                }

                // Homework stats
                const resHw = await fetch('/api/homeworks', { headers: { 'Authorization': 'Bearer ' + token } });
                const hwData = await resHw.json();
                if(Array.isArray(hwData)) {
                    document.getElementById('dashTotalHomeworks').innerText = hwData.length;
                }
            } catch(e) {
                console.error('Error loading dashboard stats:', e);
            }
        }

        // ==================== MODUL 5: BROADCAST PENGUMUMAN MULTI-KANAL ====================
        let cachedBroadcasts = [];
        let currentBroadcastFilter = 'ALL';
        let availableClasses = [];

        function openBroadcastModal() {
            const modal = document.getElementById('modalAnnouncement');
            if (modal) {
                modal.classList.remove('hidden');
                loadClassOptions();
                onTargetLevelChange();
            }
        }

        function closeBroadcastModal() {
            const modal = document.getElementById('modalAnnouncement');
            if (modal) modal.classList.add('hidden');
        }

        async function loadClassOptions() {
            const selectEl = document.getElementById('annTargetKelas');
            if (!selectEl || availableClasses.length > 0) return;

            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const d = await res.json();
                const list = d.classes || d || [];
                availableClasses = list;
                selectEl.innerHTML = '<option value="">-- Pilih Rombel Kelas --</option>';
                list.forEach(k => {
                    const name = k.name || k.nama || k;
                    if (name) selectEl.innerHTML += `<option value="${name}">Kelas ${name}</option>`;
                });
            } catch (e) {
                console.warn('Gagal memuat kelas untuk broadcast:', e);
            }
        }

        function onTargetLevelChange() {
            const level = document.getElementById('annTargetLevel')?.value || 'STUDENT_ONLY';
            const subWrapper = document.getElementById('subTargetWrapper');
            const tingkatWrapper = document.getElementById('tingkatWrapper');
            const kelasWrapper = document.getElementById('kelasWrapper');
            const roleWrapper = document.getElementById('roleWrapper');

            if (!subWrapper) return;

            if (level === 'STUDENT_ONLY' || level === 'STUDENT_PARENT' || level === 'PARENT_ONLY' || level === 'SEKOLAH') {
                subWrapper.classList.add('hidden');
            } else {
                subWrapper.classList.remove('hidden');
                tingkatWrapper?.classList.toggle('hidden', level !== 'TINGKAT');
                kelasWrapper?.classList.toggle('hidden', level !== 'KELAS');
                roleWrapper?.classList.toggle('hidden', level !== 'ROLE');
            }
            previewBroadcastAudience();
        }

        async function previewBroadcastAudience() {
            const targetLevel = document.getElementById('annTargetLevel')?.value || 'STUDENT_ONLY';
            let targetId = null;
            let targetRole = null;

            if (targetLevel === 'STUDENT_ONLY') {
                targetRole = 'STUDENT';
                targetId = 'STUDENT';
            } else if (targetLevel === 'PARENT_ONLY') {
                targetRole = 'PARENT';
                targetId = 'PARENT';
            } else if (targetLevel === 'STUDENT_PARENT') {
                targetRole = 'STUDENT_PARENT';
                targetId = 'STUDENT_PARENT';
            } else if (targetLevel === 'TINGKAT') {
                targetId = document.getElementById('annTargetTingkat')?.value;
            } else if (targetLevel === 'KELAS') {
                targetId = document.getElementById('annTargetKelas')?.value;
            } else if (targetLevel === 'ROLE') {
                targetRole = document.getElementById('annTargetRole')?.value;
                targetId = targetRole;
            }

            const previewTextEl = document.getElementById('annAudiencePreviewText');
            if (previewTextEl) previewTextEl.innerText = 'Menghitung estimasi penerima broadcast...';

            try {
                const res = await fetch('/api/broadcast/preview-audience', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ targetLevel, targetId, targetRole })
                });
                const d = await res.json();
                if (d.success && d.preview && previewTextEl) {
                    previewTextEl.innerHTML = `<strong>${d.preview.summaryMessage}</strong>`;
                }
            } catch (e) {
                if (previewTextEl) previewTextEl.innerText = 'Siaran akan dikirimkan ke target yang dipilih.';
            }
        }

        document.getElementById('announcementForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitBroadcast');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span> Menyiarkan...';
            }

            const targetLevel = document.getElementById('annTargetLevel')?.value || 'STUDENT_ONLY';
            let targetId = null;
            let targetRole = null;
            if (targetLevel === 'STUDENT_ONLY') {
                targetId = 'STUDENT';
                targetRole = 'STUDENT';
            } else if (targetLevel === 'PARENT_ONLY') {
                targetId = 'PARENT';
                targetRole = 'PARENT';
            } else if (targetLevel === 'STUDENT_PARENT') {
                targetId = 'STUDENT_PARENT';
                targetRole = 'STUDENT_PARENT';
            } else if (targetLevel === 'TINGKAT') {
                targetId = document.getElementById('annTargetTingkat')?.value;
            } else if (targetLevel === 'KELAS') {
                targetId = document.getElementById('annTargetKelas')?.value;
            } else if (targetLevel === 'ROLE') {
                targetRole = document.getElementById('annTargetRole')?.value;
                targetId = targetRole;
            }

            const payload = {
                judul: document.getElementById('annTitle')?.value,
                isi: document.getElementById('annContent')?.value,
                prioritas: document.getElementById('annPrioritas')?.value || 'BIASA',
                targetLevel: targetLevel,
                targetId: targetId,
                targetRole: targetRole,
                lampiranUrl: document.getElementById('annLampiranUrl')?.value || null
            };

            try {
                const res = await fetch('/api/broadcast/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    closeBroadcastModal();
                    document.getElementById('announcementForm')?.reset();
                    loadAnnouncements();
                    alert('✅ Pengumuman broadcast berhasil disiarkan ke seluruh target penerima!');
                } else {
                    alert('Gagal menyiarkan: ' + (data.message || 'Terjadi kesalahan sistem'));
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan jaringan.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>🚀</span> <span>Siarkan Sekarang</span>';
                }
            }
        });

        async function loadAnnouncements() {
            const container = document.getElementById('announcementList');
            if (!container) return;

            try {
                // Prioritaskan endpoint broadcast baru (Modul 5)
                const res = await fetch('/api/broadcast/list', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.ok) {
                    const d = await res.json();
                    cachedBroadcasts = d.data || [];
                    renderBroadcastList();
                    return;
                }
            } catch (e) {
                console.warn('Fallback ke /api/announcements:', e);
            }

            // Fallback ke endpoint legacy jika endpoint broadcast terkendala
            try {
                const resLegacy = await fetch('/api/announcements', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const dataLegacy = await resLegacy.json();
                cachedBroadcasts = (Array.isArray(dataLegacy) ? dataLegacy : []).map(a => ({
                    id: a.id,
                    judul: a.title || a.judul,
                    isi: a.content || a.isi,
                    prioritas: a.prioritas || (a.category === 'PENTING' ? 'PENTING' : 'BIASA'),
                    targetLevel: a.targetLevel || 'SEKOLAH',
                    targetId: a.targetId || null,
                    dibuatOlehId: a.author || a.dibuatOlehId || 'Admin',
                    createdAt: a.createdAt,
                    stats: a.stats || { readCount: 0, yesCount: 0, noCount: 0 }
                }));
                renderBroadcastList();
            } catch (e2) {
                container.innerHTML = '<p class="text-center text-slate-400 py-10 text-xs">Gagal memuat siaran pengumuman.</p>';
            }
        }

        function filterBroadcastPriority(prio) {
            currentBroadcastFilter = prio;
            ['ALL', 'MENDESAK', 'PENTING', 'BIASA'].forEach(p => {
                const b = document.getElementById('filterBtn-' + p);
                if (b) {
                    if (p === prio) {
                        b.className = 'px-3 py-1 rounded-lg font-bold bg-slate-900 text-white text-[11px] transition-all cursor-pointer shadow-xs';
                    } else {
                        b.className = 'px-3 py-1 rounded-lg font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 text-[11px] transition-all cursor-pointer';
                    }
                }
            });
            renderBroadcastList();
        }

        function renderBroadcastList() {
            const container = document.getElementById('announcementList');
            if (!container) return;
            container.innerHTML = '';

            const filtered = cachedBroadcasts.filter(item => {
                if (currentBroadcastFilter === 'ALL') return true;
                return (item.prioritas || 'BIASA') === currentBroadcastFilter;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <span class="text-3xl block mb-2">📭</span>
                        <p class="text-xs font-semibold">Tidak ada siaran pengumuman dalam kategori ini.</p>
                        <p class="text-[11px] text-slate-400 mt-1">Gunakan tombol "Buat Siaran Pengumuman" di atas untuk menyiarkan pesan baru.</p>
                    </div>
                `;
                return;
            }

            filtered.forEach(a => {
                const prio = a.prioritas || 'BIASA';
                let cardStyle = 'border-slate-200/80 bg-white hover:border-slate-300';
                let prioBadge = '<span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-blue-50 text-blue-700 border border-blue-200">📢 BIASA</span>';

                if (prio === 'MENDESAK') {
                    cardStyle = 'border-rose-400/80 bg-rose-50/20 hover:border-rose-500 ring-1 ring-rose-300/40';
                    prioBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-rose-600 text-white shadow-xs animate-pulse">🚨 MENDESAK</span>';
                } else if (prio === 'PENTING') {
                    cardStyle = 'border-amber-300/80 bg-amber-50/20 hover:border-amber-400';
                    prioBadge = '<span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-900 border border-amber-300">⚠️ PENTING</span>';
                }

                // Target Audiens Badge
                let targetBadge = '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">🏛️ Seluruh Sekolah</span>';
                if (a.targetLevel === 'TINGKAT') {
                    targetBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">🎓 Tingkat ${a.targetId || ''}</span>`;
                } else if (a.targetLevel === 'KELAS') {
                    targetBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">🏢 Kelas ${a.targetId || ''}</span>`;
                } else if (a.targetLevel === 'ROLE') {
                    const rText = a.targetId === 'STUDENT' ? 'Siswa' : (a.targetId === 'PARENT' ? 'Orang Tua' : (a.targetId === 'TEACHER' ? 'Guru' : a.targetId));
                    targetBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200">👤 Khusus ${rText}</span>`;
                }

                const stats = a.stats || { readCount: 0, yesCount: 0, noCount: 0 };
                const dateStr = new Date(a.createdAt).toLocaleString('id-ID', {
                    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
                }) + ' WIB';

                const lampiranBtn = a.lampiranUrl 
                    ? `<a href="${a.lampiranUrl}" target="_blank" class="inline-flex items-center gap-1 text-[11px] font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 px-2 py-1 rounded-md border border-indigo-200">📎 Lihat Berkas Lampiran ↗</a>` 
                    : '';

                container.innerHTML += `
                    <div class="p-4 rounded-2xl border ${cardStyle} transition-all shadow-xs space-y-2.5">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 pb-1 border-b border-slate-100">
                            <div class="flex flex-wrap items-center gap-1.5">
                                ${prioBadge}
                                ${targetBadge}
                                <h3 class="font-black text-slate-900 text-xs sm:text-sm tracking-tight">${a.judul}</h3>
                            </div>
                            <button onclick="deleteBroadcast('${a.id}')" class="text-[11px] text-rose-500 hover:text-rose-700 font-bold hover:underline self-end sm:self-auto cursor-pointer transition-colors" title="Hapus Siaran Ini">Hapus</button>
                        </div>
                        
                        <p class="text-xs text-slate-700 leading-relaxed whitespace-pre-line">${a.isi}</p>
                        
                        ${lampiranBtn ? `<div class="pt-1">${lampiranBtn}</div>` : ''}

                        <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-[10.5px] text-slate-500">
                            <div class="flex items-center gap-3">
                                <span class="font-semibold">Oleh: <strong class="text-slate-700">${a.dibuatOlehId || 'Admin'}</strong></span>
                                <span>📅 ${dateStr}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center gap-1 font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full" title="Jumlah user yang telah membuka pengumuman">
                                    👁️ ${stats.readCount || 0} Dibaca
                                </span>
                                ${(stats.yesCount > 0 || stats.noCount > 0) ? `
                                    <span class="inline-flex items-center gap-1 font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                                        ✅ ${stats.yesCount || 0} Ya
                                    </span>
                                    <span class="inline-flex items-center gap-1 font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200">
                                        ❌ ${stats.noCount || 0} Tidak
                                    </span>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        async function deleteBroadcast(id) {
            if (!confirm('Yakin ingin menghapus siaran pengumuman ini? Siaran akan ditarik dari seluruh perangkat pengguna.')) return;

            try {
                const res = await fetch('/api/broadcast/' + id, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.ok) {
                    loadAnnouncements();
                } else {
                    // Fallback delete legacy
                    await fetch('/api/announcements/' + id, {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    loadAnnouncements();
                }
            } catch (err) {
                console.error(err);
                alert('Gagal menghapus pengumuman');
            }
        }

        async function loadServerLiveStats(isManual = false) {
            const icon = document.getElementById('refreshServerIcon');
            if (isManual && icon) icon.classList.add('animate-spin');

            try {
                const res = await fetch('/api/server/live-stats');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        // RAM
                        const ram = data.ram;
                        const elRamText = document.getElementById('valRamText');
                        const elRamBadge = document.getElementById('valRamBadge');
                        const elRamFree = document.getElementById('valRamFree');
                        const elRamHeap = document.getElementById('valRamHeap');
                        const barRam = document.getElementById('barRamProgress');

                        if (elRamText) elRamText.innerText = `${ram.usedFormatted} / ${ram.totalFormatted}`;
                        if (elRamBadge) elRamBadge.innerText = `${ram.usedPercent}%`;
                        if (elRamFree) elRamFree.innerText = ram.freeFormatted;
                        if (elRamHeap) elRamHeap.innerText = `${ram.heapUsedMb} MB`;

                        if (barRam) {
                            barRam.style.width = `${Math.min(100, Math.max(3, ram.usedPercent))}%`;
                            if (ram.usedPercent > 85) {
                                barRam.className = 'bg-gradient-to-r from-rose-500 to-red-600 h-2.5 rounded-full transition-all duration-500';
                                if (elRamBadge) elRamBadge.className = 'text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30';
                            } else if (ram.usedPercent > 70) {
                                barRam.className = 'bg-gradient-to-r from-amber-500 to-yellow-400 h-2.5 rounded-full transition-all duration-500';
                                if (elRamBadge) elRamBadge.className = 'text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30';
                            } else {
                                barRam.className = 'bg-gradient-to-r from-emerald-500 to-teal-400 h-2.5 rounded-full transition-all duration-500';
                                if (elRamBadge) elRamBadge.className = 'text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                            }
                        }

                        // Bandwidth RX/TX
                        const bw = data.bandwidth;
                        const elRxSpeed = document.getElementById('valRxSpeed');
                        const elTxSpeed = document.getElementById('valTxSpeed');
                        const elTotalRx = document.getElementById('valTotalRx');
                        const elTotalTx = document.getElementById('valTotalTx');

                        if (elRxSpeed) elRxSpeed.innerText = bw.rxFormatted;
                        if (elTxSpeed) elTxSpeed.innerText = bw.txFormatted;
                        if (elTotalRx) elTotalRx.innerText = bw.totalRxFormatted;
                        if (elTotalTx) elTotalTx.innerText = bw.totalTxFormatted;

                        // CPU, Hardware Model, Uptime & Server Clock
                        const elCpuLoad = document.getElementById('valCpuLoad');
                        const elCpuCores = document.getElementById('valCpuCores');
                        const elCpuModel = document.getElementById('valCpuModel');
                        const elCpuSpeedBadge = document.getElementById('valCpuSpeedBadge');
                        const elCpuStatusBadge = document.getElementById('valCpuStatusBadge');
                        const barCpuProgress = document.getElementById('barCpuProgress');
                        const elServerUptime = document.getElementById('valServerUptime');
                        const elClock = document.getElementById('serverLiveClock');

                        if (elCpuLoad && data.cpu) elCpuLoad.innerText = `${data.cpu.usagePercent}%`;
                        if (elCpuCores && data.cpu) elCpuCores.innerText = `${data.cpu.cores} Core`;
                        if (elCpuModel && data.cpu && data.cpu.model) {
                            elCpuModel.innerText = data.cpu.model;
                            elCpuModel.title = data.cpu.model;
                        }
                        if (elCpuSpeedBadge && data.cpu && data.cpu.speedGhz) {
                            elCpuSpeedBadge.innerText = data.cpu.speedGhz;
                        }
                        if (elCpuStatusBadge && data.cpu) {
                            elCpuStatusBadge.innerText = data.cpu.status || 'NORMAL';
                            if (data.cpu.usagePercent >= 85) {
                                elCpuStatusBadge.className = 'text-[9px] font-extrabold px-1.5 py-0.2 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30';
                            } else if (data.cpu.usagePercent >= 70) {
                                elCpuStatusBadge.className = 'text-[9px] font-extrabold px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30';
                            } else {
                                elCpuStatusBadge.className = 'text-[9px] font-extrabold px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
                            }
                        }
                        if (barCpuProgress && data.cpu) {
                            const cpuPercent = Math.min(100, Math.max(3, data.cpu.usagePercent));
                            barCpuProgress.style.width = `${cpuPercent}%`;
                            if (data.cpu.usagePercent >= 85) {
                                barCpuProgress.className = 'bg-gradient-to-r from-rose-500 to-red-600 h-2.5 rounded-full transition-all duration-500';
                            } else if (data.cpu.usagePercent >= 70) {
                                barCpuProgress.className = 'bg-gradient-to-r from-amber-500 to-yellow-400 h-2.5 rounded-full transition-all duration-500';
                            } else {
                                barCpuProgress.className = 'bg-gradient-to-r from-emerald-500 to-teal-400 h-2.5 rounded-full transition-all duration-500';
                            }
                        }
                        if (elServerUptime && data.uptime) elServerUptime.innerText = data.uptime.nodeFormatted || data.uptime.osFormatted;
                        if (elClock && data.serverTime) elClock.innerText = data.serverTime;
                    }
                }
            } catch (e) {
                console.warn('Gagal memuat telemetri server:', e);
            } finally {
                if (isManual && icon) {
                    setTimeout(() => icon.classList.remove('animate-spin'), 600);
                }
            }
        }

        // ==================== MODAL REKAP SHOLAT (PDF) ====================
        async function openDownloadPrayerPdfModal() {
            const modal = document.getElementById('modalDownloadPrayerPdf');
            if (!modal) return;

            const modalClassSel = document.getElementById('modalPdfClassSelect');
            if (modalClassSel) {
                modalClassSel.innerHTML = '<option value="ALL">📋 Seluruh Kelas (Rekap Lengkap)</option>';
                try {
                    const res = await fetch('/api/kelas', {
                        headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('token') || '') }
                    });
                    const data = await res.json();
                    const kList = data.classes || data || [];
                    if (Array.isArray(kList)) {
                        kList.forEach(k => {
                            const name = k.name || k.nama || k;
                            if (name) modalClassSel.innerHTML += `<option value="${name}">Kelas ${name}</option>`;
                        });
                    }
                } catch (e) {
                    console.warn('Error loading classes for prayer modal:', e);
                }
            }

            const dtInput = document.getElementById('modalPdfDateInput');
            if (dtInput) {
                dtInput.value = new Date().toISOString().substring(0, 10);
            }

            const typeSel = document.getElementById('modalPdfPrayerType');
            if (typeSel) {
                const day = new Date().getDay();
                const hr = new Date().getHours();
                typeSel.value = hr < 10 ? 'DHUHA' : (day === 5 ? 'JUMAT' : 'DHUHUR');
            }

            modal.classList.remove('hidden');
        }

        function closeDownloadPrayerPdfModal() {
            document.getElementById('modalDownloadPrayerPdf')?.classList.add('hidden');
        }

        function executePrayerPdfAction(action) {
            const cls = document.getElementById('modalPdfClassSelect')?.value || 'ALL';
            const dt = document.getElementById('modalPdfDateInput')?.value || new Date().toISOString().substring(0, 10);
            const pt = document.getElementById('modalPdfPrayerType')?.value || 'DHUHUR';
            const period = document.getElementById('modalPdfPeriodSelect')?.value || 'DAILY';

            let url = `/api/prayer/export-pdf?className=${encodeURIComponent(cls)}&date=${encodeURIComponent(dt)}&prayerType=${encodeURIComponent(pt)}&period=${encodeURIComponent(period)}`;
            if (action === 'print') {
                url += '&autoprint=1';
                window.open(url, '_blank');
            } else {
                url += '&download=1';
                const a = document.createElement('a');
                a.href = url;
                a.download = `Rekap_Sholat_${pt}_${cls}_${dt}.html`;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => a.remove(), 1000);
            }
            closeDownloadPrayerPdfModal();
        }
    </script>

    <!-- MODAL UNDUH REKAP SHOLAT (PDF) -->
    <div id="modalDownloadPrayerPdf" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-slate-200 animate-fade-in">
            <div class="px-6 py-5 bg-gradient-to-r from-purple-700 to-indigo-800 text-white flex justify-between items-center">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📥</span>
                    <div>
                        <h3 class="font-black text-base leading-tight">Unduh Rekap Presensi Sholat (PDF)</h3>
                        <p class="text-[11px] text-purple-200">Cetak dokumen resmi rekapitulasi sholat berjamaah & keputrian</p>
                    </div>
                </div>
                <button type="button" onclick="closeDownloadPrayerPdfModal()" class="text-white/80 hover:text-white font-bold text-2xl px-2 cursor-pointer">&times;</button>
            </div>

            <div class="p-6 space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1.5">🏫 Rombel Kelas</label>
                    <select id="modalPdfClassSelect" class="w-full border-2 border-slate-200 rounded-xl px-3.5 py-2.5 font-bold text-slate-800 bg-slate-50 focus:border-purple-600 focus:bg-white focus:outline-none">
                        <option value="ALL">📋 Seluruh Kelas (Rekap Lengkap)</option>
                    </select>
                    <p class="text-[11px] text-slate-400 mt-1">Pilih "Seluruh Kelas" untuk rekapitulasi eksekutif semua rombel, atau pilih rombel tertentu.</p>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1.5">📅 Tanggal / Pekan</label>
                        <input type="date" id="modalPdfDateInput" class="w-full border-2 border-slate-200 rounded-xl px-3 py-2 font-bold text-slate-800 bg-slate-50 focus:border-purple-600 focus:bg-white focus:outline-none">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1.5">🕌 Jenis Sholat</label>
                        <select id="modalPdfPrayerType" class="w-full border-2 border-slate-200 rounded-xl px-3 py-2 font-bold text-slate-800 bg-slate-50 focus:border-purple-600 focus:bg-white focus:outline-none">
                            <option value="DHUHA">🌅 Dhuha (Pagi)</option>
                            <option value="DHUHUR">☀️ Dhuhur (Siang)</option>
                            <option value="JUMAT">🕌 Jumat &amp; Keputrian</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1.5">📊 Periode Rekap</label>
                        <select id="modalPdfPeriodSelect" class="w-full border-2 border-slate-200 rounded-xl px-3 py-2 font-bold text-purple-700 bg-purple-50 border-purple-200 focus:border-purple-600 focus:bg-white focus:outline-none">
                            <option value="DAILY">Harian (Per Hari)</option>
                            <option value="WEEKLY">1 Minggu Penuh (Senin-Jumat)</option>
                        </select>
                    </div>
                </div>

                <div class="bg-purple-50/70 border border-purple-200 rounded-2xl p-3.5 flex items-start gap-2.5 text-purple-900">
                    <span class="text-base flex-shrink-0">ℹ️</span>
                    <div class="text-[11px] leading-relaxed">
                        Format PDF resmi standar A4 dinas pendidikan lengkap dengan <b>Kop Surat Resmi Sekolah</b>, rekapitulasi persentase kehadiran, dan tanda tangan <b>Kepala Sekolah & Guru PAI</b>.
                    </div>
                </div>
            </div>

            <div class="p-4 bg-slate-50 border-t flex flex-wrap justify-end gap-2.5">
                <button type="button" onclick="closeDownloadPrayerPdfModal()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer">
                    Batal
                </button>
                <button type="button" onclick="executePrayerPdfAction('download')" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>💾</span> <span>Unduh Berkas Langsung</span>
                </button>
                <button type="button" onclick="executePrayerPdfAction('print')" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-purple-600 hover:bg-purple-700 text-white shadow-md flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>🖨️</span> <span>Buka & Cetak PDF</span>
                </button>
            </div>
        </div>
    </div>
</body>
</html>
