        async function loadDevices(showLoading = false) {
            try {
                if (!token) token = await getFreshToken();

                // Load stats (lightweight, cached on server)
                const statsRes = await fetch('/api/admin/remote-devices/stats', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (statsRes.ok) {
                    const stats = await statsRes.json();
                    if (stats.success) {
                        if (document.getElementById('statTotalDevices')) document.getElementById('statTotalDevices').innerText = stats.totalCount;
                        if (document.getElementById('statOnlineDevices')) document.getElementById('statOnlineDevices').innerText = stats.onlineCount;
                        if (document.getElementById('visibleTotalCount')) document.getElementById('visibleTotalCount').innerText = stats.totalCount;
                        if (document.getElementById('visibleDeviceCount')) document.getElementById('visibleDeviceCount').innerText = stats.onlineCount;
                        // Update class list from DB
                        if (stats.classList && stats.classList.length > 0) {
                            classListData = stats.classList;
                            refreshClassFilterDropdown(stats.classList);
                        }
                    }
                }

                // Load first page of devices
                devicePage = 1;
                allDevicesLoaded = false;
                allDevices = [];
                await loadDevicePage(1, true);
            } catch (e) {
                console.error('Failed to load devices:', e);
            }
        }

        async function loadDevicePage(page, replace = false) {
            if (isLoadingDevices || (allDevicesLoaded && !replace)) return;
            isLoadingDevices = true;

            const loader = document.getElementById('deviceListLoader');
            const endMsg = document.getElementById('deviceListEnd');
            if (loader) loader.classList.remove('hidden');
            if (endMsg) endMsg.classList.add('hidden');

            try {
                const classFilter = document.getElementById('filterClassRombel') ? document.getElementById('filterClassRombel').value : 'ALL';
                const statusFilter = document.getElementById('filterDeviceStatus') ? document.getElementById('filterDeviceStatus').value : 'ALL';
                const sortBy = document.getElementById('sortDeviceBy') ? document.getElementById('sortDeviceBy').value : 'lastSeen';
                const search = document.getElementById('searchDevice') ? document.getElementById('searchDevice').value.trim() : '';

                const params = new URLSearchParams({
                    page: String(page),
                    limit: String(DEVICE_PAGE_SIZE),
                    sortBy: sortBy
                });
                if (classFilter !== 'ALL') params.set('class', classFilter);
                if (statusFilter === 'ONLINE_ONLY') params.set('status', 'ONLINE');
                else if (statusFilter === 'ACTIVE_OR_STANDBY') params.set('status', 'ACTIVE_OR_STANDBY');
                else if (statusFilter === 'STANDBY') params.set('status', 'STANDBY');
                else if (statusFilter === 'WITH_FILES') params.set('status', 'WITH_FILES');
                else if (statusFilter === 'LOW_BATTERY') params.set('status', 'LOW_BATTERY');
                else if (statusFilter === 'OUTDATED_APP') params.set('status', 'OUTDATED_APP');
                else if (statusFilter === 'LATEST_APP') params.set('status', 'LATEST_APP');
                if (search) params.set('search', search);

                if (!token) token = await getFreshToken();
                let res = await fetch('/api/admin/remote-devices/list?' + params.toString(), {
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                    credentials: 'same-origin'
                });

                if (res.status === 401 || res.status === 403) {
                    token = await getFreshToken();
                    res = await fetch('/api/admin/remote-devices/list?' + params.toString(), {
                        headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                        credentials: 'same-origin'
                    });
                }

                const data = await res.json();
                if (data.success) {
                    deviceTotalCount = data.totalCount;
                    deviceTotalPages = data.totalPages;

                    if (replace) {
                        allDevices = data.devices || [];
                    } else {
                        const existingIds = new Set(allDevices.map(d => String(d.id)));
                        (data.devices || []).forEach(d => {
                            if (!existingIds.has(String(d.id))) {
                                allDevices.push(d);
                                existingIds.add(String(d.id));
                            }
                        });
                    }

                    if (page >= deviceTotalPages || allDevices.length >= deviceTotalCount) {
                        allDevicesLoaded = true;
                    } else {
                        allDevicesLoaded = false;
                    }

                    devicePage = page;

                    // Update file count stats
                    let totalFilesAcrossAll = 0;
                    allDevices.forEach(d => {
                        totalFilesAcrossAll += (d.fileCount || 0);
                    });
                    document.getElementById('statTotalFiles').innerText = totalFilesAcrossAll;

                    // Re-render device list
                    filterDevices();

                    // Jika belum ada perangkat yang dipilih di panel utama, pilih otomatis
                    if (!currentDeviceId && allDevices.length > 0) {
                        const targetDev = allDevices.find(d => d.fileCount > 0) || allDevices[0];
                        selectDevice(targetDev.id);
                    }
                }
            } catch (e) {
                console.error('Failed to load device page:', e);
            } finally {
                isLoadingDevices = false;
                if (loader) loader.classList.add('hidden');
                if (allDevicesLoaded && endMsg) endMsg.classList.remove('hidden');
                else if (endMsg) endMsg.classList.add('hidden');
            }
        }

