                        'Content-Type': 'application/json',
                        ...(token ? { 'Authorization': 'Bearer ' + token } : {})
                    },
                    body: JSON.stringify({ enabled: targetState })
                });

                const data = await res.json();
                if (data.success) {
                    isAdminControlActive = data.enabled;
                    if (btn) {
                        btn.className = `relative inline-flex items-center h-6 rounded-full w-12 transition-colors focus:outline-none cursor-pointer ${isAdminControlActive ? 'bg-amber-600' : 'bg-slate-400'}`;
                    }
                    if (dot) {
                        dot.className = `inline-block w-4 h-4 transform bg-white rounded-full transition-transform ${isAdminControlActive ? 'translate-x-7' : 'translate-x-1'}`;
                    }
                    if (badge) {
                        badge.className = `font-extrabold text-[11px] px-2 py-0.5 rounded-md ${isAdminControlActive ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700'}`;
                        badge.textContent = isAdminControlActive ? 'ON' : 'OFF (Dikecualikan)';
                    }

                    if (typeof showDownloadToast === 'function') {
                        showDownloadToast(isAdminControlActive ? '⚠️ Kontrol/Scan HP Admin & Staf DIAKTIFKAN (ON)' : '🛡️ HP Admin & Staf DIKECUALIKAN dari Pemindaian/Salin (OFF)');
                    }
                } else {
                    if (typeof showDownloadToast === 'function') {
                        showDownloadToast('❌ Gagal: ' + (data.message || 'Error server'));
                    }
                }
            } catch (err) {
                if (typeof showDownloadToast === 'function') {
                    showDownloadToast('❌ Terjadi kesalahan jaringan saat mengubah status kontrol admin.');
                }
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        function closePreviewModal() {
            const player = document.getElementById('modalVideoPlayer');
            if (player) {
                player.pause();
                player.removeAttribute('src');
                player.load();
            }
            document.getElementById('previewModal').classList.add('hidden');
        }

        async function requestCopyFile(fileId, fileName, filePath) {
            return downloadDirectFile(fileId, fileName, filePath);
        }

        async function loadCopyRequests(showLoading = false) {
            try {
                if (!token) token = await getFreshToken();
                let res = await fetch('/api/admin/remote-devices/copy-requests', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.status === 401 || res.status === 403) {
                    token = await getFreshToken();
                    res = await fetch('/api/admin/remote-devices/copy-requests', {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                }

                const data = await res.json();
                if (data.success) {
                    const requests = data.requests || [];
                    document.getElementById('statPendingRequests').innerText = requests.length;
                    renderCopyRequests(requests);
                }
            } catch (e) {
                console.error('Failed to load copy requests:', e);
            }
        }

        function renderCopyRequests(requests) {
            const container = document.getElementById('copyRequestList');
            if (requests.length === 0) {
                container.innerHTML = '<div class="p-6 text-center text-gray-400 text-sm">Belum ada riwayat salin berkas</div>';
                return;
            }

            container.innerHTML = requests.map(r => {
                let statusBadge = '<span class="bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded-full text-[10px] font-bold">⏳ PENDING</span>';
                let rowClass = 'copy-request-pending';
                if (r.status === 'COMPLETED') {
                    statusBadge = '<span class="bg-green-100 text-green-800 px-2 py-0.5 rounded-full text-[10px] font-bold">✅ SELESAI</span>';
                    rowClass = 'copy-request-completed';
                } else if (r.status === 'FAILED') {
                    statusBadge = '<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded-full text-[10px] font-bold">❌ GAGAL</span>';
                    rowClass = 'copy-request-failed';
                } else if (r.status === 'UPLOADED') {
                    statusBadge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full text-[10px] font-bold">📤 UPLOADED</span>';
                    rowClass = 'copy-request-completed';
                }

                const time = new Date(r.requestedAt).toLocaleString('id-ID', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
                const size = r.fileSize ? (r.fileSize > 1048576 ? (r.fileSize / 1048576).toFixed(1) + ' MB' : (r.fileSize / 1024).toFixed(0) + ' KB') : '-';

                const actions = (r.status === 'COMPLETED' || r.status === 'UPLOADED')
                    ? `<button onclick="downloadFile('${r.id}', '${(r.fileName || '').replace(/'/g, "\\'")}')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1 rounded-lg text-xs font-bold shadow-sm transition-all flex items-center gap-1">⬇️ <span>Unduh</span></button>`
                    : `<button onclick="downloadDirectFile('${r.id}', '${(r.fileName || '').replace(/'/g, "\\'")}', '${(r.filePath || '').replace(/'/g, "\\'")}')" class="bg-blue-600 hover:bg-blue-700 text-white px-2.5 py-1 rounded text-[10px] font-bold shadow-sm transition-all flex items-center gap-1">⏳ <span>Tarik Ulang</span></button>`;

                return `
                    <div class="${rowClass} p-3 flex items-center justify-between text-xs">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-gray-800 truncate">📄 ${r.fileName}</p>
                            <p class="text-[10px] text-gray-400">${r.device?.deviceName || r.deviceId} • ${size} • ${time}</p>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            ${statusBadge}
                            ${actions}
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function downloadDirectFile(fileId, fileName, filePath) {
            if (!currentDeviceId && allDevices.length > 0) currentDeviceId = allDevices[0].id;
            if (!currentDeviceId) {
                alert('Pilih perangkat siswa terlebih dahulu dari daftar sebelah kiri.');
                return;
            }

            showDownloadToast('⏳ Mengirim permintaan salin berkas ' + (fileName || '') + ' ke HP...');

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/copy-file`, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ fileId, fileName, filePath })
                });
                const data = await res.json();
                if (!data.success && !data.requestId) {
                    showDownloadToast('❌ ' + (data.message || 'Gagal meminta salin file.'));
                    return;
                }

                const targetRequestId = data.requestId;

                if (data.status === 'COMPLETED') {
                    showDownloadToast('✅ Berkas asli siap di server PC! Mengunduh...');
                    downloadFile(targetRequestId, fileName);
                    loadCopyRequests(false);
                    return;
                }

                showDownloadToast('⏳ Menunggu HP siswa mentransfer ' + fileName + ' (0s)...');
                let elapsed = 0;
                const maxWait = 90;
                const pollTimer = setInterval(async () => {
                    elapsed += 2;
                    try {
                        const checkRes = await fetch(`/api/admin/remote-devices/copy-requests?deviceId=${currentDeviceId}`, {
                            headers: { 'Authorization': 'Bearer ' + token }
                        });
                        const checkData = await checkRes.json();
                        if (checkData.success && checkData.requests) {
                            const reqItem = checkData.requests.find(r => r.id === targetRequestId);
                            if (reqItem) {
                                if (reqItem.status === 'COMPLETED') {
                                    clearInterval(pollTimer);
                                    showDownloadToast('✅ Berkas asli berhasil ditransfer dari HP! Mengunduh...');
                                    downloadFile(targetRequestId, fileName);
                                    loadCopyRequests(false);
                                    return;
                                } else if (reqItem.status === 'FAILED') {
                                    clearInterval(pollTimer);
                                    showDownloadToast('❌ HP gagal mentransfer: ' + (reqItem.errorMessage || 'Izin file ditolak'));
                                    loadCopyRequests(false);
                                    return;
                                }
                            }
                        }
                    } catch (pollErr) {}

                    if (elapsed >= maxWait) {
                        clearInterval(pollTimer);
                        showDownloadToast('⚠️ Transfer berkas masih berlangsung di latar belakang. Pantau dari Riwayat Salin.');
                        loadCopyRequests(false);
                    } else {
                        showDownloadToast(`⏳ Menunggu HP mentransfer ${fileName} (${elapsed}s/90s)...`);
                    }
                }, 2000);

            } catch (e) {
                console.error(e);
                showDownloadToast('❌ Terjadi kesalahan jaringan saat meminta berkas.');
            }
        }

        function downloadFile(requestId, fileName) {
            const tok = token || localStorage.getItem('token') || '';
            const downloadUrl = `/api/admin/remote-devices/download/${requestId}?token=${encodeURIComponent(tok)}`;
            
            showDownloadActionToast('✅ Mengunduh Berkas...', fileName, downloadUrl);

            // 1. Unduh via Invisible iframe (kebal terhadap popup blocker & timeout user gesture)
            let iframe = document.getElementById('hiddenDownloadFrame');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'hiddenDownloadFrame';
                iframe.style.display = 'none';
                document.body.appendChild(iframe);
            }
            iframe.src = downloadUrl;

            // 2. Direct anchor click
            const a = document.createElement('a');
            a.href = downloadUrl;
            if (fileName) a.download = fileName;
            document.body.appendChild(a);
            try { a.click(); } catch(e) {}
            setTimeout(() => {
                if (a.parentNode) a.parentNode.removeChild(a);
            }, 1000);
        }

        function showDownloadActionToast(title, fileName, downloadUrl) {
            let toast = document.getElementById('remoteDownloadActionToast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'remoteDownloadActionToast';
                toast.className = 'fixed bottom-6 left-6 z-50 bg-emerald-700 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-emerald-500 flex items-center gap-3 font-semibold text-xs transition-all duration-300';
                document.body.appendChild(toast);
            }
            toast.innerHTML = `
                <span class="text-lg">⬇️</span>
                <div class="flex flex-col">
                    <span class="font-bold text-white">${title}</span>
                    <span class="text-[11px] text-emerald-100">${fileName}</span>
                </div>
                <a href="${downloadUrl}" download="${fileName}" class="ml-2 bg-white hover:bg-emerald-50 text-emerald-800 px-3 py-1.5 rounded-xl font-black text-xs shadow-md transition-all flex items-center gap-1">
                    <span>Simpan</span>
                </a>
            `;
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
            clearTimeout(window.__actionToastTimer);
            window.__actionToastTimer = setTimeout(() => {
                if (toast) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(10px)';
                }
            }, 10000);
        }

        function showDownloadToast(msg) {
            let toast = document.getElementById('remoteDownloadToast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'remoteDownloadToast';
                toast.className = 'fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3 font-semibold text-xs transition-all duration-300';
                document.body.appendChild(toast);
            }
            toast.innerText = msg;
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
            clearTimeout(window.__toastTimer);
            window.__toastTimer = setTimeout(() => {
                if (toast) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(10px)';
                }
            }, 4000);
        }

        async function blockDevice() {
            if (!currentDeviceId) return;
            if (!confirm('Ubah status blokir perangkat ini?')) return;
            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/block`, {
                    method: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert(data.message || 'Status diperbarui');
                selectDevice(currentDeviceId);
                loadDevices();
            } catch(e) {
                alert('Gagal mengubah status');
            }
        }

        async function deleteDevice() {
            if (!currentDeviceId) return;
            if (!confirm('Hapus perangkat ini dari sistem?')) return;
            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert(data.message || 'Perangkat dihapus');
                document.getElementById('deviceDetailPanel').classList.add('hidden');
                currentDeviceId = null;
                loadDevices();
            } catch(e) {
                alert('Gagal menghapus perangkat');
            }
        }
    </script>

    <!-- Modal Folder ZIP Progress -->
    <div id="modalFolderZip" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-2xl w-full max-w-md shadow-2xl border text-center space-y-4">
            <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-full flex items-center justify-center text-3xl mx-auto shadow-sm">
                📦
            </div>
            <div>
                <h3 class="text-base font-black text-gray-800" id="zipModalTitle">Unduh 1 Folder Penuh (.ZIP)</h3>
                <p class="text-xs text-gray-500 mt-1 font-semibold" id="zipModalFolder">Folder: WA Images (Receive)</p>
            </div>
            
            <div class="bg-slate-50 p-4 rounded-xl border text-left space-y-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-gray-500 font-semibold">Total Berkas di Folder:</span>
                    <b id="zipStatTotal" class="text-gray-800">0</b>
                </div>
                <div class="flex justify-between">
                    <span class="text-emerald-600 font-semibold">Sudah Siap di PC Server:</span>
                    <b id="zipStatReady" class="text-emerald-700">0</b>
                </div>
                <div class="flex justify-between">
                    <span class="text-amber-600 font-semibold">Sedang Ditransfer dari HP:</span>
                    <b id="zipStatPending" class="text-amber-700">0</b>
                </div>
                <div class="flex justify-between" id="rowZipFailed">
                    <span class="text-rose-600 font-semibold">Gagal / Dibatasi OS HP:</span>
                    <b id="zipStatFailed" class="text-rose-700">0</b>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 mt-2 overflow-hidden">
                    <div id="zipProgressBar" class="bg-indigo-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
            </div>

            <div id="zipStatusMessage" class="text-xs font-semibold text-indigo-700 animate-pulse">
                Meminta HP mentransfer berkas...
            </div>

            <div class="flex gap-2 pt-2">
                <button onclick="closeZipModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2.5 rounded-xl text-xs font-bold transition-all">
                    Tutup / Latar Belakang
                </button>
                <button id="btnTriggerZipDownload" onclick="triggerActualZipDownload()" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl text-xs font-black shadow-md transition-all">
                    Unduh Sekarang (.ZIP)
                </button>
            </div>
        </div>
    </div>
</body>
