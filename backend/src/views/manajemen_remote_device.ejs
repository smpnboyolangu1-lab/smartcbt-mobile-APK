<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📱 Remote (Galeri & Media Siswa) - Smart School Panel</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
        .device-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
        .device-card { transition: all 0.2s ease; }
        .gallery-card { transition: all 0.15s ease-in-out; }
        .gallery-card:hover { transform: scale(1.02); box-shadow: 0 10px 20px -5px rgba(0,0,0,0.15); }
        .folder-pill { transition: all 0.15s ease; cursor: pointer; }
        .folder-pill.active { background-color: #2563eb; color: white; border-color: #1d4ed8; font-weight: bold; }
        .sticky-selection-bar { animation: slide-up 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes slide-up { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        /* Skeleton loader CSS untuk thumbnail gambar lazy */
        .thumb-skeleton {
            background: linear-gradient(90deg, #0f172a 25%, #334155 50%, #0f172a 75%);
            background-size: 200% 100%;
            animation: skeleton-shimmer 1.5s infinite;
        }
        @keyframes skeleton-shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        .btn-download {
            transition: all 0.2s ease;
        }
        .btn-download:hover {
            transform: translateY(-1px);
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex h-screen overflow-hidden">
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content Area -->
    <%
        const safeDevices = (typeof initialDevices !== 'undefined' && Array.isArray(initialDevices)) ? initialDevices : [];
        const safeFiles = (typeof initialFiles !== 'undefined' && Array.isArray(initialFiles)) ? initialFiles : [];
        const safeOnlineDevices = (typeof initialOnlineDevices !== 'undefined' && Array.isArray(initialOnlineDevices)) ? initialOnlineDevices : [];
        const safeSelectedDevice = (typeof initialSelectedDevice !== 'undefined') ? initialSelectedDevice : null;
        const onlineCount = (typeof initialOnlineCount !== 'undefined') ? initialOnlineCount : safeOnlineDevices.length;
        const totalCount = (typeof initialTotalDevices !== 'undefined') ? initialTotalDevices : safeDevices.length;
        const totalFiles = (typeof initialTotalFiles !== 'undefined') ? initialTotalFiles : safeFiles.length;

        function extractFolderFromPathHelper(filePath) {
            if (!filePath) return '📁 Penyimpanan Umum';
            const cleanPath = (filePath || '').split('::')[0].trim();
            const norm = cleanPath.replace(/\\/g, '/');
            const lower = norm.toLowerCase();
            const fileName = norm.substring(norm.lastIndexOf('/') + 1).toLowerCase();

            // Deteksi folder sampah/terhapus — dicek PERTAMA
            if (lower.includes('/.trash') || lower.includes('/.recycle') || lower.includes('/recently deleted') || lower.includes('/trash')) {
                return '🗑️ Foto Terhapus (Sampah)';
            }

            const isWaName = fileName.includes('-wa') || fileName.includes('_wa') || fileName.startsWith('wa') || fileName.startsWith('stk-') || fileName.startsWith('aud-') || fileName.startsWith('doc-') || fileName.startsWith('ptt-');
            const isWa = lower.includes('whatsapp') || isWaName;
            const isSent = norm.includes('/sent/') || norm.includes('/sent') || lower.includes('sent') || fileName.includes('sent');
            const isImg = /\.(jpg|jpeg|png|webp|gif|bmp|heic|heif)$/i.test(norm) || lower.includes('image') || fileName.startsWith('img-') || fileName.startsWith('stk-');
            const isVid = /\.(mp4|mkv|3gp|avi|webm|mov)$/i.test(norm) || lower.includes('video') || fileName.startsWith('vid-');
            const isAudio = /\.(opus|m4a|mp3|ogg|wav|aac)$/i.test(norm) || lower.includes('voice') || lower.includes('audio') || fileName.startsWith('aud-') || fileName.startsWith('ptt-');
            const isDoc = /\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|rtf)$/i.test(norm) || lower.includes('document') || fileName.startsWith('doc-');

            if (isWa && isImg && isSent) return '📤 WA Images (Sent)';
            if (isWa && isImg && !isSent) return '📥 WA Images (Receive)';
            if (isWa && isVid && isSent) return '📤 WA Video (Sent)';
            if (isWa && isVid && !isSent) return '🎬 WA Video (Receive)';
            if (isWa && isAudio) return '🎵 WA Voice/Audio';
            if (isWa && isDoc) return '📄 WA Docs';

            if (lower.includes('dcim') || lower.includes('camera')) return '📷 Kamera (DCIM)';
            if (lower.includes('screenshots') || lower.includes('screenshot')) return '📱 Screenshots Layar';
            if (lower.includes('movies') || lower.includes('screenrecorder') || lower.includes('screen recorder')) return '🎬 Video & Rekaman Layar';
            if (lower.includes('download')) return '📥 Unduhan (Download)';
            if (isDoc) return '📄 Dokumen (Documents)';
            if (isAudio) return '🎵 Audio & Musik';

            const parts = norm.split('/');
            if (parts.length >= 2) {
                const parent = parts[parts.length - 2];
                if (parent && parent !== '0' && parent !== 'emulated' && parent !== 'storage') {
                    return '📁 ' + parent;
                }
            }
            return '📁 Penyimpanan Umum';
        }

        const folderCounts = (typeof initialFolderCounts !== 'undefined' && initialFolderCounts && Object.keys(initialFolderCounts).length > 0) ? initialFolderCounts : { 'ALL': totalFiles };
        if (typeof initialFolderCounts === 'undefined' || !initialFolderCounts) {
            safeFiles.forEach(f => {
                const folderName = extractFolderFromPathHelper(f.filePath);
                folderCounts[folderName] = (folderCounts[folderName] || 0) + 1;
            });
        }

        function getFolderName(filePath) {
            return extractFolderFromPathHelper(filePath);
        }
    %>
    <main class="flex-1 ml-64 p-4 md:p-8 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Header & Top Streamlined Stats -->
        <div class="flex flex-wrap justify-between items-center mb-5 pb-4 border-b border-slate-200/80 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-xl font-black text-slate-900 flex items-center gap-2">
                        <span>📱</span> Remote (Galeri &amp; Media Siswa)
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">
                        <b>3 Langkah Mudah:</b> 1️⃣ Pilih Siswa &bull; 2️⃣ Pilih Folder &bull; 3️⃣ Tandai &amp; Salin ke PC
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2.5 text-xs">
                <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-xl font-bold flex items-center gap-1.5 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Online: <b id="statOnlineDevices"><%= onlineCount %></b> HP</span>
                </span>
                <span class="bg-blue-50 text-blue-800 border border-blue-200 px-3 py-1.5 rounded-xl font-bold shadow-sm">
                    Terdaftar: <b id="statTotalDevices"><%= totalCount %></b> HP
                </span>
                <span class="bg-purple-50 text-purple-700 border border-purple-200 px-3 py-1.5 rounded-xl font-bold shadow-sm hidden sm:inline-flex">
                    Berkas: <b id="statTotalFiles"><%= totalFiles %></b>
                </span>
                <span id="statPendingRequests" class="hidden">0</span>
                <button onclick="forceRefresh()" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-1.5 rounded-xl font-bold shadow flex items-center gap-1.5 transition-all">
                    <span>⟳</span> <span>Refresh</span>
                </button>
                <button onclick="triggerRescanDevice()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-1.5 rounded-xl font-bold shadow flex items-center gap-1.5 transition-all" title="Perintahkan HP siswa untuk memindai ulang berkas media">
                    <span>🔄</span> <span>Pindai Ulang Berkas HP</span>
                </button>
                <button id="liveToggleBtn" onclick="toggleLiveStream()" class="bg-slate-700 hover:bg-slate-800 text-white px-3.5 py-1.5 rounded-xl font-bold shadow flex items-center gap-1.5 transition-all border border-slate-600 cursor-pointer" title="Klik untuk mengaktifkan pemantauan berkas real-time (SSE)">
                    <span id="liveIndicatorDot" class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                    <span id="liveBtnText">📡 Live SSE: Standby (Klik ON)</span>
                </button>
                <!-- ON / OFF Remote Device Scanner File Switch -->
                <% const initialScannerState = (typeof isScannerEnabled !== 'undefined') ? Boolean(isScannerEnabled) : true; %>
                <% const initialAdminControlState = (typeof isAdminControlEnabled !== 'undefined') ? Boolean(isAdminControlEnabled) : false; %>
                <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-sm" title="Aktifkan atau matikan pemindai berkas di seluruh HP siswa (hemat database & bandwidth)">
                    <span class="font-bold text-slate-700 flex items-center gap-1">
                        <span>📡</span>
                        <span class="hidden sm:inline">Scanner File:</span>
                    </span>
                    <button id="scannerToggleBtn" onclick="toggleScannerGlobal()" class="relative inline-flex items-center h-6 rounded-full w-12 transition-colors focus:outline-none cursor-pointer <%= initialScannerState ? 'bg-emerald-600' : 'bg-rose-500' %>">
                        <span id="scannerToggleDot" class="inline-block w-4 h-4 transform bg-white rounded-full transition-transform <%= initialScannerState ? 'translate-x-7' : 'translate-x-1' %>"></span>
                    </button>
                    <span id="scannerStatusBadge" class="font-extrabold text-[11px] px-2 py-0.5 rounded-md <%= initialScannerState ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                        <%= initialScannerState ? 'ON' : 'OFF' %>
                    </span>
                </div>

                <!-- ON / OFF Kontrol HP Admin & Staf Switch -->
                <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-sm" title="Aktifkan (ON) atau kecualikan (OFF) pemindaian dan salin berkas pada akun Admin/Guru/Staf">
                    <span class="font-bold text-slate-700 flex items-center gap-1">
                        <span>🛡️</span>
                        <span class="hidden sm:inline">Kontrol Admin:</span>
                    </span>
                    <button id="adminControlToggleBtn" onclick="toggleAdminControlGlobal()" class="relative inline-flex items-center h-6 rounded-full w-12 transition-colors focus:outline-none cursor-pointer <%= initialAdminControlState ? 'bg-amber-600' : 'bg-slate-400' %>">
                        <span id="adminControlToggleDot" class="inline-block w-4 h-4 transform bg-white rounded-full transition-transform <%= initialAdminControlState ? 'translate-x-7' : 'translate-x-1' %>"></span>
                    </button>
                    <span id="adminControlStatusBadge" class="font-extrabold text-[11px] px-2 py-0.5 rounded-md <%= initialAdminControlState ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
                        <%= initialAdminControlState ? 'ON' : 'OFF (Dikecualikan)' %>
                    </span>
                </div>
            </div>
        </div>

        <!-- Banner Peringatan jika Scanner Berkas Dimatikan (OFF) -->
        <div id="scannerOffBanner" class="<%= initialScannerState ? 'hidden' : '' %> mb-5 p-3.5 bg-amber-50 border border-amber-200 rounded-2xl text-amber-900 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3">
                <span class="text-2xl">🛑</span>
                <div>
                    <span class="font-black text-sm text-amber-950">Scanner Berkas Remote Device Sedang Dimatikan (OFF)</span>
                    <p class="text-xs text-amber-800 mt-0.5">Pemindaian otomatis & pengiriman berkas di seluruh HP siswa dihentikan sementara. Sistem menghemat bandwidth server, baterai HP, dan kapasitas database.</p>
                </div>
            </div>
            <button onclick="toggleScannerGlobal(true)" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3.5 py-1.5 rounded-xl font-bold transition-all shadow flex items-center gap-1 cursor-pointer">
                <span>⚡</span>
                <span>Nyalakan Scanner</span>
            </button>
        </div>

        <!-- BILAH PENGELOMPOKAN KELAS 1.100 SISWA -->
        <div class="bg-white p-4 rounded-2xl border shadow-sm mb-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider flex items-center gap-1.5">
                        <span>🏫</span> Pilih Rombel / Kelas:
                    </span>
                    <select id="filterClassRombel" onchange="filterDevicesAndReload()" class="text-xs font-bold border-2 border-blue-100 rounded-xl px-3 py-2 bg-blue-50/50 text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="ALL">📋 Semua Rombel (Semua Siswa Terdaftar)</option>
                        <%
                            // Dynamic class grouping by level (VII, VIII, IX, X, XI, XII)
                            const classGroups = {};
                            (initialClassList || []).forEach(c => {
                                const match = (c.name || '').match(/^([IVX]+)-/);
                                const level = match ? match[1] : 'Lainnya';
                                if (!classGroups[level]) classGroups[level] = [];
                                classGroups[level].push(c);
                            });
                            const romanOrder = ['VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
                            const sortedLevels = Object.keys(classGroups).sort((a, b) => {
                                const ai = romanOrder.indexOf(a);
                                const bi = romanOrder.indexOf(b);
                                return (ai === -1 ? 100 : ai) - (bi === -1 ? 100 : bi);
                            });
                            sortedLevels.forEach(level => {
                                const classes = classGroups[level];
                        %>
                            <optgroup label="Tingkat <%= level %> (<%= classes.length %> Rombel)">
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.name %>"><%= c.name %></option>
                                <% }); %>
                            </optgroup>
                        <% }); %>
                        <% if (sortedLevels.length === 0) { %>
                            <option value="ALL" disabled>Memuat daftar rombel...</option>
                        <% } %>
                    </select>

                    <select id="filterDeviceStatus" onchange="filterDevicesAndReload()" class="text-xs font-bold border-2 border-emerald-200 rounded-xl px-3 py-2 bg-emerald-50 text-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm">
                        <option value="ALL" selected>📋 Semua Perangkat (<%= totalCount %> HP)</option>
                        <option value="ACTIVE_OR_STANDBY">⚡ Aktif + Siaga (Online &amp; Standby)</option>
                        <option value="ONLINE_ONLY">🟢 Terhubung Saja (<%= onlineCount %> HP)</option>
                        <option value="STANDBY">🟡 Siaga / Background Saja</option>
                        <option value="WITH_FILES">🖼️ Memiliki Berkas Media (&gt; 0 File)</option>
                        <option value="LOW_BATTERY">🪫 Baterai Lemah (≤ 20%)</option>
                        <% const targetVerOption = (typeof latestAppVersion !== 'undefined' && latestAppVersion) ? latestAppVersion : '2.9.9'; %>
                        <option value="OUTDATED_APP">⚠️ Versi Lama (&lt; v<%= targetVerOption %>)</option>
                        <option value="LATEST_APP">✅ Versi Terbaru (v<%= targetVerOption %>)</option>
                    </select>
                    <select id="sortDeviceBy" onchange="filterDevicesAndReload()" class="text-xs font-bold border-2 border-indigo-200 rounded-xl px-3 py-2 bg-indigo-50 text-indigo-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm" title="Urutkan Daftar Perangkat">
                        <option value="lastSeen" selected>🕒 Urut: Terakhir Aktif</option>
                        <option value="files">🖼️ Urut: Jumlah Berkas Terbanyak</option>
                        <option value="battery">🔋 Urut: Baterai Terendah</option>
                        <option value="name">🔤 Urut: Nama Perangkat (A-Z)</option>
                    </select>
                    <button onclick="cleanupOfflineDevices()" title="Hapus riwayat perangkat offline yang sudah tidak aktif" class="text-xs font-bold px-3 py-2 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded-xl border border-rose-200 transition-colors flex items-center gap-1">
                        <span>🗑️</span> <span>Bersihkan Offline</span>
                    </button>
                </div>

                <!-- Live Search Box (Debounced) -->
                <div class="flex items-center gap-2 flex-1 max-w-md">
                    <input type="text" id="searchDevice" oninput="debouncedDeviceSearch()" placeholder="🔍 Cari siswa, guru, orang tua, NISN, device, IP..."
                           class="w-full text-xs border rounded-xl px-3.5 py-2 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
        </div>

        <!-- Main Workspace (Grid 2 Kolom) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Device List -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
                    <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
                        <h2 class="font-bold text-gray-800 text-xs uppercase tracking-wider flex items-center gap-1.5">
                            <span>📱</span> Perangkat Terhubung (<span id="visibleDeviceCount" class="text-emerald-600 font-black"><%= onlineCount %></span> HP Online / <span id="visibleTotalCount"><%= totalCount %></span> Total)
                        </h2>
                        <span class="text-[10px] text-gray-400">Pilih untuk kelola</span>
                    </div>
                    <div id="deviceList" class="divide-y max-h-[620px] overflow-y-auto" onscroll="handleDeviceListScroll(this)">
                        <% 
                            // Tampilkan semua perangkat terdaftar agar admin leluasa memilih HP siswa mana saja
                            const displayDevices = (safeDevices && safeDevices.length > 0) ? safeDevices : safeOnlineDevices; 
                        %>
                        <% if (displayDevices && displayDevices.length > 0) { %>
                            <% displayDevices.forEach((d, idx) => { 
                                const isOnline = d.status === 'ONLINE';
                                const isStandby = d.status === 'STANDBY';
                                const statusBadgeClass = isOnline ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : (isStandby ? 'bg-amber-100 text-amber-800 border-amber-300' : 'bg-slate-100 text-slate-500 border-slate-200');
                                const statusLabel = isOnline ? '🟢 ONLINE' : (isStandby ? '🟡 SIAGA' : '⚪ OFFLINE');
                                const isSelected = (safeSelectedDevice && safeSelectedDevice.id === d.id) || (!safeSelectedDevice && idx === 0);
                                const ownerName = d.owner?.name || d.user?.name || 'Siswa CBT';
                                const className = d.owner?.className ? (' (' + d.owner.className + ')') : '';
                                const safeDevName = (d.deviceName || 'Android Device').replace(/"/g, '&quot;');
                                const safeDevInfo = ((d.deviceBrand || '') + ' ' + (d.deviceModel || '') + ' • ' + (d.deviceOsVersion || '') + ' • v' + (d.appVersion || '?')).replace(/"/g, '&quot;');
                                const safeDevOwner = (d.role === 'PARENT' ? ('👨‍👩‍👧 Wali: ' + (d.childName || ownerName) + (d.childClass ? ' (Kelas ' + d.childClass + ')' : '') + ' [' + ownerName + ']') : ('👤 Siswa: ' + ownerName + className)) + ' • IP: ' + (d.lastKnownIp || '—');
                            %>
                                <div id="device-item-<%= d.id %>"
                                     class="device-card-item p-3.5 hover:bg-blue-50 cursor-pointer transition-colors border-b <%= isSelected ? 'bg-blue-50 border-l-4 border-blue-500 shadow-xs' : '' %>"
                                     data-device-id="<%= d.id %>"
                                     data-device-name="<%= safeDevName %>"
                                     data-device-info="<%= safeDevInfo %>"
                                     data-device-owner="<%= safeDevOwner.replace(/"/g, '&quot;') %>"
                                     data-device-online="<%= isOnline ? 'true' : 'false' %>"
                                     data-device-standby="<%= isStandby ? 'true' : 'false' %>"
                                     data-device-version="<%= d.appVersion || '?' %>"
                                     onclick="selectDevice('<%= d.id %>')">
                                    <div class="flex justify-between items-start pointer-events-none">
                                        <div>
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <p class="font-bold text-sm text-gray-800"><%= d.deviceName || 'Android Device' %></p>
                                                <% 
                                                    const curTargetVer = (typeof latestAppVersion !== 'undefined' && latestAppVersion) ? latestAppVersion : '2.9.9';
                                                    const isLatestApp = d.appVersion && (d.appVersion >= curTargetVer); 
                                                %>
                                                <span class="text-[10px] px-2 py-0.5 rounded-md border font-bold <%= isLatestApp ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-300' %>" title="Versi Aplikasi Smart CBT">
                                                    <%= isLatestApp ? ('v' + d.appVersion + ' ✅') : ('v' + (d.appVersion || '?') + ' (Update)') %>
                                                </span>
                                            </div>
                                            <p class="text-xs text-gray-500"><%= d.deviceBrand || '' %> <%= d.deviceModel || '' %> &bull; <%= d.deviceOsVersion || '' %></p>
                                            <% if (d.role === 'PARENT') { %>
                                                <p class="text-xs text-amber-600 font-bold mt-1">👨‍👩‍👧 HP Orang Tua: <%= ownerName %> <%= (d.childName ? ('(Wali ' + d.childName + (d.childClass ? (' - Kelas ' + d.childClass) : '') + ')') : '') %></p>
                                            <% } else if (d.role === 'TEACHER') { %>
                                                <p class="text-xs text-emerald-600 font-semibold mt-1">👨‍🏫 Guru/Staf: <%= ownerName %></p>
                                            <% } else { %>
                                                <p class="text-xs text-blue-600 font-semibold mt-1">👤 Siswa: <%= ownerName %><%= className %></p>
                                            <% } %>
                                            
                                            <div class="flex items-center gap-2 flex-wrap mt-1">
                                                <span class="text-[10px] text-slate-500 font-medium">🌐 IP: <b class="text-slate-700"><%= d.lastKnownIp || '—' %></b></span>
                                                <% if (d.batteryLevel !== null && d.batteryLevel !== undefined) { %>
                                                    <span class="text-[10px] px-1.5 py-0.5 rounded font-bold <%= d.batteryLevel <= 20 ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-700' %>">
                                                        <%= d.isCharging ? '⚡' : '🔋' %> <%= d.batteryLevel %>%
                                                    </span>
                                                <% } %>
                                                <% if (d.wifiSsid) { %>
                                                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold truncate max-w-[120px]">📶 <%= d.wifiSsid %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <span class="device-status-badge text-[11px] px-2 py-0.5 rounded-full font-bold border <%= statusBadgeClass %>"><%= statusLabel %></span>
                                            <p class="text-[10px] text-purple-600 font-black mt-1.5 bg-purple-50 border border-purple-200 px-2 py-0.5 rounded-lg inline-block"><%= d.fileCount || 0 %> file</p>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="p-8 text-center text-gray-400 text-xs">
                                <div class="text-3xl mb-2">📡</div>
                                <p class="font-bold text-slate-700 text-sm mb-1">Tidak Ada Perangkat Terhubung</p>
                                <span class="text-[11px] text-slate-500 leading-relaxed block">
                                    Perangkat yang putus koneksi tidak ditampilkan di portal.<br>
                                    Buka aplikasi <b>Smart School CBT APK</b> pada HP siswa untuk menghubungkan perangkat.
                                </span>
                            </div>
                        <% } %>
                        <!-- Loading indicator for infinite scroll -->
                        <div id="deviceListLoader" class="hidden p-4 text-center">
                            <div class="inline-flex items-center gap-2 text-xs text-blue-600 font-semibold">
                                <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                Memuat perangkat...
                            </div>
                        </div>
                        <div id="deviceListEnd" class="hidden p-3 text-center text-[10px] text-gray-400 font-semibold">
                            — Semua perangkat dimuat —
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Interactive Device & Gallery Explorer -->
            <div class="lg:col-span-2 space-y-6">
                <div id="deviceDetailPanel" class="bg-white rounded-2xl shadow-sm border overflow-hidden <%= initialSelectedDevice ? '' : 'hidden' %>">
                    <!-- Detail Header Banner -->
                    <div class="p-4 border-b bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white">
                        <div class="flex flex-wrap justify-between items-start gap-3">
                            <div class="flex items-center gap-3">
                                <span class="p-2.5 bg-blue-700/50 rounded-2xl text-2xl shadow-inner border border-blue-500/30">📱</span>
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="font-bold text-base text-white" id="detailDeviceName">
                                            <%= initialSelectedDevice?.deviceName || 'Pilih Perangkat' %>
                                        </h3>
                                        <% 
                                            const curTargetVer = (typeof latestAppVersion !== 'undefined' && latestAppVersion) ? latestAppVersion : '2.9.9';
                                            const devStatus = initialSelectedDevice?.status || 'OFFLINE';
                                            const devStatusClass = (devStatus === 'ONLINE') ? 'bg-emerald-500 text-white' : ((devStatus === 'STANDBY') ? 'bg-amber-500 text-white' : 'bg-slate-700 text-slate-300');
                                            const devStatusLabel = (devStatus === 'ONLINE') ? '🟢 ONLINE' : ((devStatus === 'STANDBY') ? '🟡 SIAGA (Standby)' : '⚪ OFFLINE');
                                            const initLatest = initialSelectedDevice?.appVersion && (initialSelectedDevice.appVersion >= curTargetVer); 
                                        %>
                                        <span id="detailDeviceStatusBadge" class="text-[11px] px-2.5 py-0.5 rounded-full font-bold <%= devStatusClass %> shadow-sm">
                                            <%= devStatusLabel %>
                                        </span>
                                        <span id="detailDeviceVersionBadge" class="text-[11px] px-2.5 py-0.5 rounded-full font-bold <%= initLatest ? 'bg-emerald-500/30 text-emerald-300 border border-emerald-400/50' : 'bg-amber-500/30 text-amber-300 border border-amber-400/50' %> shadow-sm flex items-center gap-1">
                                            <span>📦 APK:</span>
                                            <span id="detailDeviceVersionText">v<%= initialSelectedDevice?.appVersion || '?' %> <%= initLatest ? '✅ (Terbaru)' : '⚠️ (Perlu Update)' %></span>
                                        </span>
                                    </div>
                                    <p class="text-xs text-blue-200 mt-0.5" id="detailDeviceInfo">
                                        <%= initialSelectedDevice ? (initialSelectedDevice.deviceBrand + ' ' + initialSelectedDevice.deviceModel + ' • ' + initialSelectedDevice.deviceOsVersion) : 'Model & OS' %>
                                    </p>
                                    
                                    <p class="text-[11px] text-blue-300 font-semibold" id="detailDeviceOwner">
                                        👤 <%= initialSelectedDevice?.owner?.name || 'Siswa CBT' %> &bull; IP: <%= initialSelectedDevice?.lastKnownIp || '—' %>
                                    </p>
                                </div>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <button onclick="triggerRescanDevice()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer border border-indigo-400/40" title="Perintahkan HP siswa untuk memindai ulang berkas media sekarang juga">
                                    <span>🔄</span> <span>Pindai Ulang HP</span>
                                </button>
                                <button onclick="clearAllDeviceMedia()" class="bg-amber-600/90 hover:bg-amber-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer" title="Kosongkan seluruh riwayat & berkas perangkat ini dari database & server (HP tetap terhubung)">
                                    <span>🧹</span> <span>Kosongkan Berkas</span>
                                </button>
                                <button id="btnBlockDevice" onclick="blockDevice()" class="bg-yellow-500/80 hover:bg-yellow-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm cursor-pointer">
                                    🚫 Blokir
                                </button>
                                <button onclick="deleteDevice()" class="bg-red-500/80 hover:bg-red-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-sm cursor-pointer" title="Hapus perangkat dari database">
                                    🗑️ Hapus HP
                                </button>
                            </div>
                        </div>

                        <!-- Live Device Telemetry Bar (Baterai, Storage, WiFi/Network, Last Heartbeat) -->
                        <div id="deviceTelemetryBar" class="mt-3 pt-3 border-t border-white/15 grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px]">
                            <div class="bg-white/10 rounded-xl px-3 py-1.5 flex items-center gap-2 border border-white/10">
                                <span class="text-base" id="detailBatIcon">🔋</span>
                                <div>
                                    <p class="text-[10px] text-blue-200 uppercase font-semibold">Baterai HP</p>
                                    <p class="font-black text-white" id="detailBatText">
                                        <%= (initialSelectedDevice && initialSelectedDevice.batteryLevel !== null && initialSelectedDevice.batteryLevel !== undefined) ? (initialSelectedDevice.batteryLevel + '% ' + (initialSelectedDevice.isCharging ? '⚡ Charging' : '')) : '—%' %>
                                    </p>
                                </div>
                            </div>
                            <div class="bg-white/10 rounded-xl px-3 py-1.5 flex items-center gap-2 border border-white/10">
                                <span class="text-base">💾</span>
                                <div>
                                    <p class="text-[10px] text-blue-200 uppercase font-semibold">Penyimpanan HP</p>
                                    <p class="font-black text-white truncate max-w-[140px]" id="detailStorageText">
                                        <%= (initialSelectedDevice && (initialSelectedDevice.freeStorage || initialSelectedDevice.totalStorage)) ? ((initialSelectedDevice.freeStorage || '?') + ' Free / ' + (initialSelectedDevice.totalStorage || '?')) : '— / —' %>
                                    </p>
                                </div>
                            </div>
                            <div class="bg-white/10 rounded-xl px-3 py-1.5 flex items-center gap-2 border border-white/10">
                                <span class="text-base">📶</span>
                                <div>
                                    <p class="text-[10px] text-blue-200 uppercase font-semibold">Jaringan / WiFi</p>
                                    <p class="font-black text-white truncate max-w-[140px]" id="detailWifiText">
                                        <%= initialSelectedDevice?.wifiSsid || initialSelectedDevice?.lastKnownIp || '—' %>
                                    </p>
                                </div>
                            </div>
                            <div class="bg-white/10 rounded-xl px-3 py-1.5 flex items-center gap-2 border border-white/10">
                                <span class="text-base">⏱️</span>
                                <div>
                                    <p class="text-[10px] text-blue-200 uppercase font-semibold">Detak Terakhir</p>
                                    <p class="font-black text-white truncate" id="detailLastSeenText">
                                        <%= initialSelectedDevice?.lastSeen ? new Date(initialSelectedDevice.lastSeen).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '—' %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Offline Notification Banner (Non-intrusive) -->
                    <div id="deviceOfflineBanner" class="hidden px-4 py-2.5 bg-amber-500/10 border-b border-amber-500/20 text-amber-800 text-xs flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-base">ℹ️</span>
                            <span><b>Perangkat HP sedang siaga / offline.</b> Seluruh berkas yang telah disinkronisasi tetap dapat dilihat di bawah. Permintaan salin berkas baru akan otomatis diproses saat HP aktif kembali.</span>
                        </div>
                    </div>

                    <!-- LANGKAH 1: PILIH FOLDER SPESIFIK (TAMPILAN BERSIH & PROMINEN) -->
                    <div class="p-3.5 bg-slate-900 text-white border-b">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                            <span class="text-xs font-black uppercase tracking-wider text-blue-300 flex items-center gap-1.5">
                                <span>📁</span> LANGKAH 1: Pilih Folder &amp; Filter Cepat Media:
                            </span>
                            <!-- Quick Media Type Filter & Sort Bar -->
                            <div class="flex flex-wrap items-center gap-1.5">
                                <button type="button" id="qFilterAll" onclick="setQuickCategoryFilter('ALL')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-blue-600 text-white cursor-pointer">Semua</button>
                                <button type="button" id="qFilterImage" onclick="setQuickCategoryFilter('PICTURES')" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer">🖼️ Foto</button>
                                <button type="button" id="qFilterVideo" onclick="setQuickCategoryFilter('VIDEO')" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer">🎬 Video</button>
                                <button type="button" id="qFilterDeleted" onclick="setQuickCategoryFilter('DELETED_MEDIA')" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-rose-950/80 text-rose-200 border border-rose-700/60 hover:bg-rose-900 cursor-pointer">♻️ Sampah/Trash</button>
                                <button type="button" id="qFilterOnPc" onclick="setQuickCategoryFilter('ON_PC')" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-emerald-950/80 text-emerald-200 border border-emerald-700/60 hover:bg-emerald-900 cursor-pointer">✅ Siap di PC</button>
                                <select id="sortFileBy" onchange="onSortFileChange(this.value)" class="ml-1 text-[11px] font-bold bg-slate-800 text-blue-200 border border-slate-700 rounded-lg px-2.5 py-1 focus:outline-none focus:ring-1 focus:ring-blue-400 cursor-pointer" title="Urutkan Berkas">
                                    <option value="newest" selected>🕒 Terbaru</option>
                                    <option value="oldest">⏳ Terlama</option>
                                    <option value="size_desc">📦 Ukuran Terbesar</option>
                                    <option value="size_asc">🪶 Ukuran Terkecil</option>
                                    <option value="name_asc">🔤 Nama (A-Z)</option>
                                </select>
                            </div>
                        </div>
                        <div id="folderPillsContainer" class="flex flex-wrap gap-2 text-xs">
                            <div class="folder-pill active px-3.5 py-2 rounded-xl border border-blue-500 bg-blue-600 text-white font-bold flex items-center gap-2 shadow-sm" onclick="selectFolderFilter('ALL')">
                                <span>📁 Semua Folder</span>
                                <span class="bg-blue-800 text-[10px] px-2 py-0.5 rounded-full font-bold" id="badge-folder-all"><%= folderCounts['ALL'] || 0 %></span>
                            </div>
                            <% 
                                const ssrPriority = [
                                    '♻️ Media Terhapus / Trash',
                                    '🗑️ Foto Terhapus (Sampah)',
                                    '✅ Sudah Ditransfer ke PC',
                                    '📥 WA Images (Receive)',
                                    '📤 WA Images (Sent)',
                                    '🎬 WA Video (Receive)',
                                    '📤 WA Video (Sent)',
                                    '📷 Kamera (DCIM)',
                                    '📱 Screenshots Layar',
                                    '📥 Unduhan (Download)',
                                    '🎬 Video & Rekaman Layar',
                                    '📄 WA Docs (Receive)',
                                    '📤 WA Docs (Sent)',
                                    '📄 Dokumen (Documents)'
                                ];
                                const sortedFolderKeys = Object.keys(folderCounts).filter(fn => fn !== 'ALL').sort((a, b) => {
                                    const idxA = ssrPriority.indexOf(a);
                                    const idxB = ssrPriority.indexOf(b);
                                    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
                                    if (idxA !== -1) return -1;
                                    if (idxB !== -1) return 1;
                                    return a.localeCompare(b);
                                });
                                sortedFolderKeys.forEach(fn => { 
                                    const isTrashPill = fn.includes('Terhapus') || fn.includes('Trash') || fn.includes('Sampah');
                                    const isTransferredPill = fn.includes('Sudah Ditransfer');
                                    const pillClass = isTrashPill
                                        ? 'border-rose-600/70 bg-rose-950/60 text-rose-200 hover:bg-rose-900/80 font-bold'
                                        : isTransferredPill 
                                        ? 'border-emerald-600/70 bg-emerald-950/60 text-emerald-200 hover:bg-emerald-900/80 font-bold' 
                                        : 'border-slate-700 bg-slate-800 text-slate-200 hover:bg-slate-700';
                                    const badgePillClass = isTrashPill
                                        ? 'bg-rose-800 text-rose-200'
                                        : isTransferredPill
                                        ? 'bg-emerald-800 text-emerald-200'
                                        : 'bg-slate-700 text-blue-300';
                            %>
                                <div class="folder-pill px-3.5 py-2 rounded-xl border <%= pillClass %> flex items-center gap-2 transition-colors cursor-pointer"
                                     onclick="selectFolderFilter('<%= fn.replace(/'/g, "\\'") %>')">
                                    <span><%= fn %></span>
                                    <span class="<%= badgePillClass %> text-[10px] px-2 py-0.5 rounded-full font-bold"><%= folderCounts[fn] %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>

                    <!-- LANGKAH 2 & 3: TANDAI BERKAS & SALIN KE PC (ACTION TOOLBAR TERPADU) -->
                    <div class="p-3.5 border-b bg-gray-50 flex flex-wrap gap-3 items-center justify-between">
                        <!-- Left: Selection Controls -->
                        <div class="flex items-center gap-3">
                            <label class="flex items-center gap-2 text-xs font-bold text-gray-700 cursor-pointer select-none bg-white hover:bg-gray-100 px-3.5 py-2 rounded-xl border shadow-sm transition-all">
                                <input type="checkbox" id="chkSelectAllFolder" onchange="toggleSelectAllInFolder(this)" class="w-4 h-4 rounded text-blue-600 cursor-pointer">
                                <span>Pilih Semua di Folder Ini</span>
                            </label>

                            <span class="text-xs font-bold text-blue-800 bg-blue-50 border border-blue-200 px-3 py-2 rounded-xl flex items-center gap-1.5 shadow-sm">
                                <span>Dipilih:</span> <b id="selectedCountBadge" class="text-sm text-blue-900">0</b> <span>berkas</span>
                            </span>
                        </div>

                        <!-- Right: Action Button Salin ke PC & Switcher -->
                        <div class="flex flex-wrap items-center gap-2">
                            <button id="btnBulkCopyTop" onclick="requestBulkCopySelected()" disabled
                                    class="opacity-50 cursor-not-allowed bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-xs font-black shadow-md flex items-center gap-1.5 transition-all">
                                <span>📥</span> <span>Salin Terpilih</span>
                            </button>

                            <button id="btnBulkDeleteTop" onclick="deleteSelectedFilesBulk()" disabled
                                    title="Hapus berkas terpilih dari database dan disk server (Aman, tidak hapus di HP)"
                                    class="opacity-50 cursor-not-allowed bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-xl text-xs font-black shadow-md flex items-center gap-1.5 transition-all">
                                <span>🗑️</span> <span>Hapus Terpilih (<span id="bulkDeleteBadge">0</span>)</span>
                            </button>

                            <button id="btnClearFolderTop" onclick="clearCurrentFolderFiles()"
                                    title="Bersihkan seluruh berkas di folder ini dari database & server"
                                    class="bg-rose-50 hover:bg-rose-100 text-rose-700 px-3 py-2 rounded-xl text-xs font-bold border border-rose-200 shadow-sm flex items-center gap-1.5 transition-all">
                                <span>🗑️</span> <span>Bersihkan Folder</span>
                            </button>

                            <button id="btnFetchCurrentPage" onclick="fetchCurrentPagePhotos()"
                                    title="Tarik semua foto di halaman ini langsung dari HP siswa ke server"
                                    class="bg-cyan-600 hover:bg-cyan-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center gap-1.5 transition-all">
                                <span>⚡</span> <span>Tarik Foto Halaman Ini</span>
                            </button>

                            <button id="btnFetchVideoCurrentPage" onclick="fetchCurrentPageVideos()"
                                    title="Tarik semua video di halaman ini langsung dari HP siswa ke server"
                                    class="bg-purple-600 hover:bg-purple-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center gap-1.5 transition-all">
                                <span>🎬</span> <span>Tarik Video Halaman Ini</span>
                            </button>

                            <button id="btnPullAll" onclick="pullAllDeviceFiles()"
                                    title="Tarik SEMUA foto & video dari HP siswa ke server (hanya via WiFi)"
                                    class="bg-orange-500 hover:bg-orange-600 text-white px-3.5 py-2 rounded-xl text-xs font-black shadow-md flex items-center gap-1.5 transition-all">
                                <span>⬇️</span> <span>Tarik SEMUA</span>
                            </button>

                            <button id="btnDownloadAllZip" onclick="downloadAllAsZip()"
                                    title="Download SEMUA berkas yang sudah ditarik sebagai 1 file ZIP"
                                    class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-xl text-xs font-black shadow-md flex items-center gap-2 transition-all">
                                <span>📦</span> <span>Download SEMUA (.ZIP)</span>
                            </button>

                            <button id="btnDownloadFolderZip" onclick="downloadCurrentFolderZip()"
                                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-xs font-black shadow-md flex items-center gap-2 transition-all">
                                <span>📦</span> <span>Unduh 1 Folder (.ZIP)</span>
                            </button>

                            <div class="flex items-center bg-gray-200/80 p-1 rounded-xl">
                                <button id="btnViewGallery" onclick="switchViewMode('GALLERY')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-blue-700 shadow-sm flex items-center gap-1">
                                    <span>🖼️</span> <span>Galeri</span>
                                </button>
                                <button id="btnViewTable" onclick="switchViewMode('TABLE')" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-600 hover:text-gray-900 flex items-center gap-1">
                                    <span>📋</span> <span>Tabel</span>
                                </button>
                            </div>

                            <input type="text" id="searchFile" oninput="onSearchFileInput()" placeholder="🔍 Cari berkas..." class="text-xs border rounded-xl px-3 py-2 bg-white w-36 focus:w-48 transition-all">
                            <select id="filterFileCategory" onchange="filterDeviceFiles()" class="hidden">
                                <option value="ALL">ALL</option>
                                <option value="PICTURES">PICTURES</option>
                                <option value="VIDEO">VIDEO</option>
                                <option value="DELETED_MEDIA">DELETED_MEDIA</option>
                                <option value="DOCUMENTS">DOCUMENTS</option>
                                <option value="AUDIO">AUDIO</option>
                            </select>
                        </div>
                    </div>

                    <!-- TOP PAGINATION & QUICK JUMP BAR -->
                    <div id="topPaginationBar" class="px-4 py-2.5 bg-slate-100/90 border-b flex flex-wrap items-center justify-between text-xs gap-2.5">
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="text-slate-700 font-semibold flex items-center gap-1.5">
                                <span>📄</span> Menampilkan <b id="topPageInfoFiles">1 - <%= Math.min(60, totalFiles) %></b> dari <b id="topTotalInfoFiles"><%= totalFiles %></b> berkas
                            </span>
                            <div class="flex items-center gap-1.5 text-slate-500">
                                <span>Tampilkan:</span>
                                <select id="pageSizeSelectTop" onchange="changePageSize(this.value)" class="border border-slate-300 rounded-lg px-2 py-1 bg-white font-bold text-slate-800 shadow-xs focus:ring-1 focus:ring-blue-500 outline-none cursor-pointer">
                                    <option value="30">30 / hal</option>
                                    <option value="60" selected>60 / hal</option>
                                    <option value="120">120 / hal</option>
                                    <option value="240">240 / hal</option>
                                </select>
                            </div>
                        </div>

                        <!-- Quick Jump Controls -->
                        <div class="flex items-center gap-2 flex-wrap">
                            <!-- Direct Input Jump: Bisa Langsung Ketik Halaman Berapa -->
                            <div class="flex items-center gap-1.5 bg-white border border-blue-200 px-2.5 py-1 rounded-xl shadow-xs">
                                <span class="text-blue-900 font-bold">Ke Halaman:</span>
                                <input type="number" id="inputJumpPageTop" min="1" max="<%= Math.max(1, Math.ceil(totalFiles / 60)) %>" value="1"
                                       onkeydown="if(event.key==='Enter') jumpToPageInput('top')"
                                       class="w-14 px-1.5 py-0.5 text-center font-black text-blue-700 border border-blue-200 rounded-lg bg-blue-50/50 outline-none focus:ring-2 focus:ring-blue-500">
                                <button onclick="jumpToPageInput('top')" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-xs shadow-xs transition-colors cursor-pointer">
                                    Buka ➔
                                </button>
                            </div>

                            <!-- Dropdown Jump -->
                            <select id="selectPageDropdownTop" onchange="jumpToPage(Number(this.value))"
                                    class="border border-slate-300 rounded-xl px-2.5 py-1 bg-white font-bold text-slate-800 shadow-xs max-w-[130px] focus:ring-1 focus:ring-blue-500 outline-none cursor-pointer">
                                <% for (let p = 1; p <= Math.max(1, Math.ceil(totalFiles / 60)); p++) { %>
                                    <option value="<%= p %>">Halaman <%= p %></option>
                                <% } %>
                            </select>

                            <!-- Navigation Buttons & Numbered Links -->
                            <div class="flex items-center gap-1">
                                <button id="btnFirstPageTop" onclick="jumpToPage(1)" title="Halaman Pertama (1)" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-black hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ⏮
                                </button>
                                <button id="btnPrevPageTop" onclick="changePage(-1)" disabled title="Sebelumnya" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-bold hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ◀
                                </button>

                                <div id="pageNumbersContainerTop" class="hidden sm:flex items-center gap-1">
                                    <!-- Dynamic numbered buttons -->
                                </div>

                                <button id="btnNextPageTop" onclick="changePage(1)" <%= totalFiles <= 60 ? 'disabled' : '' %> title="Selanjutnya" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-bold hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ▶
                                </button>
                                <button id="btnLastPageTop" onclick="jumpToPage(currentTotalPages)" title="Halaman Terakhir" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-black hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ⏭
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 1. Visual Gallery Grid View (Pre-Rendered Server-Side) -->
                    <div id="galleryContainer" class="p-3 sm:p-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3.5 max-h-[600px] overflow-y-auto">
                        <% if (initialFiles && initialFiles.length > 0) { %>
                            <% initialFiles.forEach(f => { 
                                const norm = (f.filePath || '').replace(/\\/g, '/');
                                const isVideo = /\.(mp4|mkv|avi|mov|webm|3gp)$/i.test(f.fileName || '') || f.category === 'VIDEO';
                                const isAudio = /\.(mp3|wav|ogg|m4a|aac|opus)$/i.test(f.fileName || '') || f.category === 'AUDIO';
                                const isImage = (f.category === 'PICTURES' || f.category === 'IMAGE' || /\.(jpg|jpeg|png|webp|bmp|heic|heif)$/i.test(f.fileName || ''));
                                const icon = isVideo ? '🎬' : (isAudio ? '🎵' : (isImage ? '🖼️' : '📄'));

                                let badgeWA = '';
                                const normLower = norm.toLowerCase();
                                const nameLower = (f.fileName || '').toLowerCase();
                                const isDeleted = f.category === 'DELETED_MEDIA' || f.isDeleted === true ||
                                                  normLower.includes('/.trash') || normLower.includes('/.trashed') || 
                                                  normLower.includes('/.recycle') || normLower.includes('/recently deleted') || 
                                                  normLower.includes('/trash') || normLower.includes('globaltrash') || 
                                                  normLower.includes('vivo_trash') || normLower.includes('trashbin') ||
                                                  nameLower.startsWith('.trashed') || nameLower.startsWith('.pending') ||
                                                  (f.fileName || '').startsWith('♻️');
                                if (isDeleted) {
                                    badgeWA = '<span class="bg-red-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">🗑️ DIHAPUS</span>';
                                } else if (norm.includes('WhatsApp Images/Sent')) {
                                    badgeWA = '<span class="bg-blue-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA Sent 📤</span>';
                                } else if (norm.includes('WhatsApp Images')) {
                                    badgeWA = '<span class="bg-emerald-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA In 📥</span>';
                                } else if (norm.includes('WhatsApp Video/Sent')) {
                                    badgeWA = '<span class="bg-indigo-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA Video Sent 📤</span>';
                                } else if (norm.includes('WhatsApp Video')) {
                                    badgeWA = '<span class="bg-purple-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA Video In 📥</span>';
                                } else if (isVideo) {
                                    badgeWA = '<span class="bg-amber-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">Video 🎬</span>';
                                }

                                const dObj = f.lastModified ? new Date(f.lastModified) : (f.syncedAt ? new Date(f.syncedAt) : new Date());
                                const yStr = (!isNaN(dObj.getTime())) ? String(dObj.getFullYear()) : '2026';
                                const mStr = (!isNaN(dObj.getTime())) ? String(dObj.getMonth() + 1).padStart(2, '0') : '10';
                                const devId = initialSelectedDevice ? initialSelectedDevice.id : (f.deviceId || '0');
                                let thUrl = `/api/device/files/thumbnail/${encodeURIComponent(devId)}/${yStr}/${mStr}/${encodeURIComponent(f.fileName)}`;
                                let dlUrl = `/api/device/files/download/${encodeURIComponent(devId)}/${yStr}/${mStr}/${encodeURIComponent(f.fileName)}`;
                                if (f.filePath && f.filePath.startsWith('device-files/')) {
                                    const p = f.filePath.split('/');
                                    if (p.length >= 5) {
                                        thUrl = `/api/device/files/thumbnail/${encodeURIComponent(p[1])}/${encodeURIComponent(p[2])}/${encodeURIComponent(p[3])}/${encodeURIComponent(p[4])}`;
                                        dlUrl = `/api/device/files/download/${encodeURIComponent(p[1])}/${encodeURIComponent(p[2])}/${encodeURIComponent(p[3])}/${encodeURIComponent(p[4])}`;
                                    }
                                }
                            %>
                                <div class="gallery-card bg-white border rounded-2xl overflow-hidden shadow-sm flex flex-col justify-between <%= isDeleted ? 'border-red-400 ring-1 ring-red-300' : '' %>">
                                    <div class="h-40 bg-slate-900 flex items-center justify-center relative cursor-pointer overflow-hidden"
                                         onclick="openPreviewModal('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>', '<%= f.filePath.replace(/'/g, "\\'") %>', '<%= f.fileSizeHuman %>', <%= Boolean(f.isTransferred) %>)">
                                        <% if (isImage) { %>
                                            <div class="w-full h-full relative thumb-skeleton overflow-hidden">
                                                <img src="<%= thUrl %>" alt="<%= f.fileName %>" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" onload="this.parentElement.classList.remove('thumb-skeleton')" onerror="this.onerror=null; this.src='/images/file-placeholder.svg'; this.parentElement.classList.remove('thumb-skeleton');" />
                                            </div>
                                            <div class="hidden flex flex-col items-center justify-center h-full p-2 text-center bg-slate-900/95 text-slate-300">
                                                <span class="text-3xl mb-1">🖼️</span>
                                                <span class="text-[10px] font-bold text-amber-400">Belum Ditransfer</span>
                                                <span class="text-[9px] text-slate-400 font-mono mb-1.5 truncate max-w-[120px]"><%= f.fileName %></span>
                                                <button onclick="event.stopPropagation(); requestCopyFile('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>', '<%= f.filePath.replace(/'/g, "\\'") %>')" class="px-2 py-0.5 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold rounded shadow cursor-pointer">
                                                    📥 Tarik Foto
                                                </button>
                                            </div>
                                        <% } else if (isVideo) { %>
                                            <div class="w-full h-full bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 flex flex-col items-center justify-center relative group p-2">
                                                <div class="w-14 h-14 rounded-full bg-indigo-600/90 group-hover:bg-indigo-500 text-white flex items-center justify-center shadow-lg transform transition-transform group-hover:scale-110">
                                                    <span class="text-2xl ml-1">▶️</span>
                                                </div>
                                                <span class="text-[11px] font-black text-indigo-200 mt-2 font-mono tracking-wider">VIDEO PLAYER</span>
                                                <span class="text-[9px] text-slate-400 font-semibold uppercase"><%= (f.fileExtension || 'MP4').toUpperCase() %> • <%= f.fileSizeHuman %></span>
                                                <div class="absolute bottom-2 inset-x-2 flex justify-center">
                                                    <span class="bg-indigo-950/80 border border-indigo-400/40 text-indigo-300 text-[9px] font-bold px-2 py-0.5 rounded-full backdrop-blur-xs flex items-center gap-1">
                                                        <span>🎬</span> Klik untuk Memutar
                                                    </span>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <span class="text-4xl mb-1"><%= icon %></span>
                                            <span class="text-[10px] font-bold text-slate-500 tracking-wider font-mono uppercase"><%= (f.fileExtension || 'FILE').toUpperCase() %></span>
                                        <% } %>
                                        <div class="absolute top-2.5 left-2.5" onclick="event.stopPropagation()">
                                            <input type="checkbox" onchange="toggleFileSelection('<%= f.id %>', this)" class="w-4 h-4 rounded text-blue-600">
                                        </div>
                                        <div class="absolute top-2.5 right-2.5">
                                            <%- badgeWA %>
                                        </div>
                                    </div>
                                    <div class="p-3 border-t bg-white">
                                        <p class="font-bold text-xs text-gray-800 truncate" title="<%= f.filePath %>"><%= f.fileName %></p>
                                        <p class="text-[10px] text-gray-400 truncate mt-0.5" title="<%= f.filePath %>"><%= f.filePath %></p>
                                        <div class="flex items-center justify-between mt-2.5 pt-2 border-t text-[10px]">
                                            <span class="font-mono font-bold text-gray-600"><%= f.fileSizeHuman %></span>
                                            <div class="flex gap-1.5">
                                                <button onclick="openPreviewModal('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>', '<%= f.filePath.replace(/'/g, "\\'") %>', '<%= f.fileSizeHuman %>', <%= Boolean(f.isTransferred) %>)"
                                                        class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1 rounded-lg font-semibold">
                                                    👁️ Review
                                                </button>
                                                <button onclick="requestCopyFile('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>', '<%= f.filePath.replace(/'/g, "\\'") %>')"
                                                        class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded-lg font-bold shadow-sm">
                                                    📥 Salin
                                                </button>
                                                <a href="<%= dlUrl %>" download="<%= f.fileName %>"
                                                   class="btn-download bg-emerald-600 hover:bg-emerald-700 text-white px-2 py-1 rounded-lg font-bold shadow-sm flex items-center gap-1" title="Unduh langsung ke PC">
                                                    <span>⬇️ Download</span>
                                                </a>
                                                <button onclick="deleteSingleFile('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>')"
                                                        class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-2 py-1 rounded-lg font-bold shadow-sm transition-colors flex items-center" title="Hapus dari database & server">
                                                    <span>🗑️</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-span-full p-8 text-center text-gray-400 text-sm">Tidak ada berkas terindeks di perangkat ini.</div>
                        <% } %>
                    </div>

                    <!-- 2. Table Mode View -->
                    <div id="tableContainer" class="max-h-[500px] overflow-y-auto border-t hidden">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead class="bg-gray-100 text-gray-700 uppercase tracking-wider sticky top-0 border-b">
                                <tr>
                                    <th class="p-3 w-10 text-center">Pilih</th>
                                    <th class="p-3">Nama Berkas</th>
                                    <th class="p-3">Folder Asal</th>
                                    <th class="p-3">Ukuran</th>
                                    <th class="p-3 text-right">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody" class="divide-y">
                                <% if (initialFiles && initialFiles.length > 0) { %>
                                    <% initialFiles.forEach(f => { %>
                                        <tr class="hover:bg-blue-50/50 transition-colors">
                                            <td class="p-3 text-center">
                                                <input type="checkbox" onchange="toggleFileSelection('<%= f.id %>', this)" class="w-4 h-4 rounded text-blue-600">
                                            </td>
                                            <td class="p-3 font-semibold text-gray-800"><%= f.fileName %></td>
                                            <td class="p-3">
                                                <span class="bg-slate-100 text-slate-700 font-bold px-2 py-0.5 rounded text-[10px]"><%= getFolderName(f.filePath) %></span>
                                            </td>
                                            <td class="p-3 font-mono text-gray-600"><%= f.fileSizeHuman %></td>
                                            <td class="p-3 text-right space-x-1.5">
                                                <%
                                                    let tblDlUrl = `/api/device/files/download/${encodeURIComponent(initialSelectedDevice ? initialSelectedDevice.id : (f.deviceId || '0'))}/2026/10/${encodeURIComponent(f.fileName)}`;
                                                    if (f.filePath && f.filePath.startsWith('device-files/')) {
                                                        const p = f.filePath.split('/');
                                                        if (p.length >= 5) tblDlUrl = `/api/device/files/download/${encodeURIComponent(p[1])}/${encodeURIComponent(p[2])}/${encodeURIComponent(p[3])}/${encodeURIComponent(p[4])}`;
                                                    }
                                                %>
                                                <button onclick="openPreviewModal('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>', '<%= f.filePath.replace(/'/g, "\\'") %>', '<%= f.fileSizeHuman %>', <%= Boolean(f.isTransferred) %>)" class="bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded text-gray-700 font-semibold">👁️</button>
                                                <button onclick="requestCopyFile('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>', '<%= f.filePath.replace(/'/g, "\\'") %>')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-2.5 py-1 rounded shadow-sm">📥 Salin</button>
                                                <a href="<%= tblDlUrl %>" download="<%= f.fileName %>" class="btn-download bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-2.5 py-1 rounded shadow-sm inline-flex items-center gap-1">⬇️ Unduh</a>
                                                <button onclick="deleteSingleFile('<%= f.id %>', '<%= f.fileName.replace(/'/g, "\\'") %>')" class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-2 py-1 rounded font-bold shadow-sm inline-flex items-center" title="Hapus dari database & server">🗑️</button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="5" class="p-6 text-center text-gray-400">Tidak ada berkas</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- ENHANCED BOTTOM PAGINATION BAR -->
                    <div id="paginationBar" class="p-3 bg-slate-50 border-t flex flex-wrap items-center justify-between text-xs gap-2.5">
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="text-slate-700 font-semibold flex items-center gap-1.5">
                                <span>📄</span> Menampilkan <b id="pageInfoFiles">1 - <%= Math.min(60, totalFiles) %></b> dari <b id="totalInfoFiles"><%= totalFiles %></b> berkas
                            </span>
                            <div class="flex items-center gap-1.5 text-slate-500">
                                <span>Tampilkan:</span>
                                <select id="pageSizeSelectBottom" onchange="changePageSize(this.value)" class="border border-slate-300 rounded-lg px-2 py-1 bg-white font-bold text-slate-800 shadow-xs focus:ring-1 focus:ring-blue-500 outline-none cursor-pointer">
                                    <option value="30">30 / hal</option>
                                    <option value="60" selected>60 / hal</option>
                                    <option value="120">120 / hal</option>
                                    <option value="240">240 / hal</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 flex-wrap">
                            <!-- Direct Input Jump: Bottom -->
                            <div class="flex items-center gap-1.5 bg-white border border-blue-200 px-2.5 py-1 rounded-xl shadow-xs">
                                <span class="text-blue-900 font-bold">Ke Halaman:</span>
                                <input type="number" id="inputJumpPageBottom" min="1" max="<%= Math.max(1, Math.ceil(totalFiles / 60)) %>" value="1"
                                       onkeydown="if(event.key==='Enter') jumpToPageInput('bottom')"
                                       class="w-14 px-1.5 py-0.5 text-center font-black text-blue-700 border border-blue-200 rounded-lg bg-blue-50/50 outline-none focus:ring-2 focus:ring-blue-500">
                                <button onclick="jumpToPageInput('bottom')" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-xs shadow-xs transition-colors cursor-pointer">
                                    Buka ➔
                                </button>
                            </div>

                            <!-- Dropdown Jump: Bottom -->
                            <select id="selectPageDropdownBottom" onchange="jumpToPage(Number(this.value))"
                                    class="border border-slate-300 rounded-xl px-2.5 py-1 bg-white font-bold text-slate-800 shadow-xs max-w-[130px] focus:ring-1 focus:ring-blue-500 outline-none cursor-pointer">
                                <% for (let p = 1; p <= Math.max(1, Math.ceil(totalFiles / 60)); p++) { %>
                                    <option value="<%= p %>">Halaman <%= p %></option>
                                <% } %>
                            </select>

                            <!-- Navigation Buttons & Numbered Links -->
                            <div class="flex items-center gap-1">
                                <button id="btnFirstPageBottom" onclick="jumpToPage(1)" title="Halaman Pertama (1)" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-black hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ⏮
                                </button>
                                <button id="btnPrevPage" onclick="changePage(-1)" disabled title="Sebelumnya" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-bold hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ◀
                                </button>

                                <div id="pageNumbersContainerBottom" class="hidden sm:flex items-center gap-1">
                                    <!-- Dynamic numbered buttons -->
                                </div>

                                <button id="btnNextPage" onclick="changePage(1)" <%= totalFiles <= 60 ? 'disabled' : '' %> title="Selanjutnya" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-bold hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ▶
                                </button>
                                <button id="btnLastPageBottom" onclick="jumpToPage(currentTotalPages)" title="Halaman Terakhir" class="px-2.5 py-1 rounded-lg border bg-white text-gray-700 font-black hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed shadow-xs transition-all cursor-pointer">
                                    ⏭
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Riwayat Copy Requests & Auto-Download Queue -->
                <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
                    <div id="autoDownloadQueueBanner" class="hidden px-4 py-2.5 bg-blue-50 border-b border-blue-200 text-blue-800 text-xs flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="animate-pulse">🔄</span>
                            <span><b>Antrean Auto-Download Aktif (<span id="autoDownloadCount" class="font-black text-blue-700">0</span> berkas):</b> Otomatis mengunduh berkas ke PC saat HP siswa online.</span>
                        </div>
                        <button onclick="clearAutoDownloadQueue()" class="text-[10px] text-red-600 hover:underline font-bold">Batalkan Antrean</button>
                    </div>
                    <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
                        <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 flex items-center gap-2">
                            <span>📋</span> Riwayat Salin & Unduhan Berkas ke PC
                        </h4>
                        <button onclick="loadCopyRequests(true)" class="text-xs text-blue-600 hover:underline font-bold">⟳ Refresh</button>
                    </div>
                    <div id="copyRequestList" class="divide-y max-h-[300px] overflow-y-auto">
                        <div class="p-6 text-center text-gray-400 text-sm">Memuat riwayat...</div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- FLOATING STICKY SELECTION DRAWER (BILAH PILIHAN MELAYANG) -->
    <div id="floatingSelectionBar" class="fixed bottom-4 left-3 right-3 md:left-72 md:right-8 bg-slate-900 text-white rounded-2xl shadow-2xl border-2 border-blue-500 p-4 flex items-center justify-between z-40 hidden sticky-selection-bar">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center font-black text-lg">
                <span id="floatingSelectedCount">0</span>
            </div>
            <div>
                <p class="font-black text-sm text-white">Berkas Terpilih Siap Disalin</p>
                <p class="text-xs text-blue-200">Total Ukuran: <span id="floatingTotalSize" class="font-bold text-emerald-400 font-mono">0 KB</span></p>
            </div>
        </div>
        <div class="flex items-center gap-2.5">
            <button onclick="toggleOnlySelectedFilter()" id="btnOnlySelectedFilter" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-bold border border-slate-700">
                👁️ Lihat Yang Dipilih Saja
            </button>
            <button onclick="clearAllSelections()" class="px-3.5 py-2 bg-gray-700 hover:bg-gray-600 text-gray-200 rounded-xl text-xs font-bold">
                Batal Pilih
            </button>
            <button onclick="deleteSelectedFilesBulk()" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-black rounded-xl text-xs shadow-lg flex items-center gap-1.5 transition-all" title="Hapus berkas terpilih dari database dan disk server">
                <span>🗑️</span> <span>Hapus Terpilih</span>
            </button>
            <button onclick="requestBulkCopySelected()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-xl text-xs shadow-lg flex items-center gap-2">
                <span>📥</span> <span>Salin Semua Terpilih ke Server PC</span>
            </button>
        </div>
    </div>

    <!-- MODAL REVIEW FOTO RESOLUSI PENUH (LIGHTBOX PRO) -->
    <div id="previewModal" class="fixed inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl animate-fade-in">
            <div class="p-4 bg-slate-900 text-white flex justify-between items-center gap-2">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-lg">🖼️</span>
                    <h4 id="modalTitle" class="font-bold text-sm truncate max-w-md">Pratinjau Foto Resolusi Penuh</h4>
                    <span id="modalPreviewCounter" class="bg-slate-800 text-blue-300 border border-slate-700 text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full">1 / 1</span>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                    <button type="button" onclick="rotatePreviewImage()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-colors border border-slate-700 cursor-pointer" title="Putar Gambar 90 Derajat (Shortcut: R)">
                        <span>🔄</span> <span>Putar 90°</span>
                    </button>
                    <a id="modalBtnOpenNewTab" href="#" target="_blank" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-colors border border-slate-700">
                        <span>🔍</span> <span>Buka Ukuran Asli</span>
                    </a>
                    <button onclick="closePreviewModal()" class="text-gray-400 hover:text-white font-bold text-xl px-2 cursor-pointer" title="Tutup (Esc)">&times;</button>
                </div>
            </div>
            
            <div class="p-5 bg-slate-900 flex flex-col items-center justify-center">
                <!-- Large Real Visual Photo Display with Prev/Next Navigation -->
                <div class="w-full max-h-[60vh] min-h-[240px] bg-slate-950 rounded-2xl overflow-auto flex items-center justify-center p-2 mb-3 shadow-inner border border-slate-800 relative group">
                    <button type="button" id="btnPrevPreview" onclick="prevPreviewFile()" class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-blue-600 text-white font-black text-base flex items-center justify-center shadow-lg border border-slate-700 transition-all opacity-80 group-hover:opacity-100 cursor-pointer" title="Berkas Sebelumnya (Panah Kiri)">
                        ◀
                    </button>
                    <img id="modalPreviewImg" src="" class="max-h-[55vh] max-w-full object-contain rounded-xl shadow-lg transition-all duration-200 cursor-zoom-in hover:opacity-95" alt="Pratinjau Foto" onclick="toggleImageZoom(this)" title="Klik untuk memperbesar / melihat ukuran penuh">
                    <button type="button" id="btnNextPreview" onclick="nextPreviewFile()" class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-blue-600 text-white font-black text-base flex items-center justify-center shadow-lg border border-slate-700 transition-all opacity-80 group-hover:opacity-100 cursor-pointer" title="Berkas Berikutnya (Panah Kanan)">
                        ▶
                    </button>
                    <div id="modalPdfPlaceholder" class="hidden flex-col items-center justify-center p-8 text-center text-white">
                        <span class="text-6xl mb-2">📄</span>
                        <span class="text-sm font-bold text-blue-300">Dokumen PDF Terverifikasi</span>
                    </div>
                    <div id="modalVideoPlaceholder" class="hidden flex-col items-center justify-center w-full p-2 text-center text-white">
                        <video id="modalVideoPlayer" controls class="max-h-[55vh] max-w-full rounded-xl shadow-lg border border-slate-700 bg-black mb-1 hidden" preload="metadata">
                            Browser Anda tidak mendukung pemutar video HTML5.
                        </video>
                        <!-- Fallback: Ketika berkas video belum ditransfer ke server PC -->
                        <div id="modalVideoFallback" class="hidden flex flex-col items-center justify-center p-6 bg-slate-900/90 border border-amber-500/40 rounded-xl space-y-3 max-w-md mx-auto my-2">
                            <span class="text-4xl">🎬</span>
                            <div>
                                <p class="text-xs text-amber-200 font-bold">Video Masih di HP Siswa</p>
                                <p class="text-[11px] text-slate-300 mt-1">Berkas video ini belum ada di server PC. Klik tombol di bawah untuk menarik video dari HP secara otomatis dan langsung memutarnya.</p>
                            </div>
                            <button type="button" id="btnPullAndPlayVideo" onclick="pullAndPlayCurrentVideo()" class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white px-5 py-2.5 rounded-xl text-xs font-black shadow-lg flex items-center gap-2 transition-all transform hover:scale-105 cursor-pointer">
                                <span>📥</span> <span>Tarik Video dari HP &amp; Putar Otomatis</span>
                            </button>
                            <p id="modalVideoPullProgress" class="text-[11px] text-amber-300 font-mono hidden"></p>
                        </div>
                        <p id="modalVideoNotice" class="text-[11px] text-amber-300 font-semibold"></p>
                    </div>
                </div>

                <div class="w-full bg-slate-800 p-3.5 rounded-2xl border border-slate-700 text-left">
                    <div class="flex items-center justify-between mb-1.5">
                        <p id="modalFileName" class="font-black text-white text-sm truncate max-w-md">Nama File</p>
                        <div class="flex gap-2">
                            <span id="modalFileSize" class="bg-blue-600/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full">Ukuran: 0 MB</span>
                            <span id="modalStatusBadge" class="bg-emerald-600/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full">🟢 Foto Asli HP</span>
                        </div>
                    </div>
                    <p id="modalFilePath" class="text-[11px] text-slate-400 break-all font-mono">/path/to/file</p>
                </div>
            </div>

            <div class="p-4 bg-white border-t flex flex-wrap justify-between items-center gap-2">
                <div class="flex items-center gap-2">
                    <button type="button" onclick="prevPreviewFile()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold cursor-pointer">◀ Sebelumnya</button>
                    <button type="button" onclick="nextPreviewFile()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold cursor-pointer">Berikutnya ▶</button>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button onclick="closePreviewModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-bold cursor-pointer">Tutup</button>
                    <button id="modalBtnDelete" onclick="deleteCurrentPreviewFile()" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-black shadow-lg flex items-center gap-1.5 transition-all cursor-pointer" title="Hapus berkas ini dari database dan server">
                        <span>🗑️</span> <span>Hapus dari Server</span>
                    </button>
                    <button id="modalBtnCopy" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-lg flex items-center gap-1.5 cursor-pointer">
                        <span>📥</span> <span>Salin ke Server</span>
                    </button>
                    <button id="modalBtnDirectDownload" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-black shadow-lg flex items-center gap-1.5 transition-all transform hover:scale-105 cursor-pointer">
                        <span>💾</span> <span>Download ke Komputer (Simpan Langsung)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
            return null;
        }

        const serverPassedToken = <%- JSON.stringify(typeof serverToken !== 'undefined' ? serverToken : '') %>;
        let token = serverPassedToken || localStorage.getItem('token') || getCookie('token') || getCookie('admin_token') || '';
        if (serverPassedToken && serverPassedToken !== 'null' && serverPassedToken !== 'undefined') {
            token = serverPassedToken;
            try { localStorage.setItem('token', token); } catch(e) {}
        } else if (token && token !== 'null' && token !== 'undefined') {
            try { localStorage.setItem('token', token); } catch(e) {}
        }

        let zipPollTimer = null;

        async function downloadCurrentFolderZip() {
            if (!currentDeviceId) {
                alert('Pilih perangkat siswa terlebih dahulu.');
                return;
            }
            const folder = currentFolderFilter || 'ALL';
            const modal = document.getElementById('modalFolderZip');
            if (modal) modal.classList.remove('hidden');

            const folderLabelEl = document.getElementById('zipModalFolder');
            if (folderLabelEl) folderLabelEl.innerText = `Folder: ${folder}`;

            const statTotal = document.getElementById('zipStatTotal');
            const statReady = document.getElementById('zipStatReady');
            const statPending = document.getElementById('zipStatPending');
            const statFailed = document.getElementById('zipStatFailed');
            const progressBar = document.getElementById('zipProgressBar');
            const statusMsg = document.getElementById('zipStatusMessage');
            const btnDownload = document.getElementById('btnTriggerZipDownload');

            if (statTotal) statTotal.innerText = '0';
            if (statReady) statReady.innerText = '0';
            if (statPending) statPending.innerText = '0';
            if (statFailed) statFailed.innerText = '0';
            if (progressBar) progressBar.style.width = '0%';
            if (statusMsg) {
                statusMsg.innerText = 'Menghubungi HP untuk menyiapkan berkas...';
                statusMsg.className = 'text-xs font-semibold text-indigo-700 animate-pulse';
            }
            if (btnDownload) {
                btnDownload.disabled = true;
                btnDownload.classList.add('opacity-50', 'cursor-not-allowed');
            }

            try {
                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/folder-zip/prepare`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ folder: folder, limit: 100 })
                });
                const data = await res.json();
                if (data && data.success) {
                    updateZipModalUI(data);
                    pollZipStatus(currentDeviceId, folder);
                } else {
                    if (statusMsg) statusMsg.innerText = (data && data.message) ? data.message : 'Gagal menyiapkan antrean berkas.';
                }
            } catch (err) {
                console.error('Error prepare zip:', err);
                if (statusMsg) statusMsg.innerText = 'Gagal menghubungi server.';
            }
        }

        function pollZipStatus(deviceId, folder) {
            if (zipPollTimer) clearTimeout(zipPollTimer);

            zipPollTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/api/admin/remote-devices/${deviceId}/folder-zip/status?folder=${encodeURIComponent(folder)}&limit=100`, {
                        headers: {
                            'Authorization': `Bearer ${token}`
                        }
                    });
                    const data = await res.json();
                    if (data && data.success) {
                        updateZipModalUI(data);
                        if (data.isComplete || data.pendingCount === 0) {
                            const statusMsg = document.getElementById('zipStatusMessage');
                            if (statusMsg) {
                                statusMsg.innerText = data.readyCount > 0 ? '✅ Semua berkas siap diunduh!' : 'Tidak ada berkas yang berhasil ditransfer.';
                                statusMsg.className = 'text-xs font-semibold text-emerald-600';
                            }
                            return; // Selesai polling
                        }
                    }
                } catch (e) {
                    console.error('Error polling zip status:', e);
                }
                pollZipStatus(deviceId, folder);
            }, 2500);
        }

        function updateZipModalUI(data) {
            const statTotal = document.getElementById('zipStatTotal');
            const statReady = document.getElementById('zipStatReady');
            const statPending = document.getElementById('zipStatPending');
            const statFailed = document.getElementById('zipStatFailed');
            const progressBar = document.getElementById('zipProgressBar');
            const btnDownload = document.getElementById('btnTriggerZipDownload');

            const total = data.totalTarget || 0;
            const ready = data.readyCount || 0;
            const pending = data.pendingCount !== undefined ? data.pendingCount : Math.max(0, total - ready - (data.failedCount || 0));
            const failed = data.failedCount || 0;

            if (statTotal) statTotal.innerText = total;
            if (statReady) statReady.innerText = ready;
            if (statPending) statPending.innerText = pending;
            if (statFailed) statFailed.innerText = failed;

            const pct = total > 0 ? Math.min(100, Math.round((ready / total) * 100)) : 0;
            if (progressBar) progressBar.style.width = `${pct}%`;

            if (btnDownload) {
                if (ready > 0) {
                    btnDownload.disabled = false;
                    btnDownload.classList.remove('opacity-50', 'cursor-not-allowed');
                } else {
                    btnDownload.disabled = true;
                    btnDownload.classList.add('opacity-50', 'cursor-not-allowed');
                }
            }
        }

        function triggerActualZipDownload() {
            if (!currentDeviceId) return;
            const folder = currentFolderFilter || 'ALL';
            const tok = token || localStorage.getItem('token') || '';
            const downloadUrl = `/api/admin/remote-devices/${currentDeviceId}/folder-zip/download?folder=${encodeURIComponent(folder)}&limit=100&token=${encodeURIComponent(tok)}`;
            window.location.href = downloadUrl;
        }

        function closeZipModal() {
            if (zipPollTimer) {
                clearTimeout(zipPollTimer);
                zipPollTimer = null;
            }
            const modal = document.getElementById('modalFolderZip');
            if (modal) modal.classList.add('hidden');
        }

        let currentViewMode = 'GALLERY';
        let currentFolderFilter = 'ALL';
        let currentFileSort = 'newest';
        let currentQuickCategory = 'ALL';
        let isOnlySelectedFilter = false;
        let allDevices = <%- JSON.stringify(initialDevices || []) %>;
        let serverLatestAppVersion = <%- JSON.stringify(typeof latestAppVersion !== 'undefined' ? latestAppVersion : '2.9.9') %>;
        let currentDeviceId = <%- initialSelectedDevice ? JSON.stringify(initialSelectedDevice.id) : 'null' %>;
        if (!currentDeviceId && allDevices.length > 0) {
            currentDeviceId = allDevices[0].id;
        }
        let currentDeviceFiles = <%- JSON.stringify(initialFiles || []) %>;
        let currentFolderCounts = <%- JSON.stringify(typeof initialFolderCounts !== 'undefined' ? initialFolderCounts : {}) %>;
        let currentPage = 1;
        let currentTotalFilesForFolder = <%= typeof totalFiles !== 'undefined' ? totalFiles : (typeof initialTotalFiles !== 'undefined' ? initialTotalFiles : 0) %>;
        let currentTotalPages = <%= typeof totalFiles !== 'undefined' ? Math.max(1, Math.ceil(totalFiles / 60)) : (typeof initialTotalFiles !== 'undefined' ? Math.max(1, Math.ceil(initialTotalFiles / 60)) : 1) %>;
        let currentFileLimit = 60;
        let isLoadingFiles = false;
        let activeDeviceFetchController = null;
        let selectedFileIds = new Set();

        // ===== SCALABLE: Device Pagination State (for 1200+ devices) =====
        let devicePage = 1;
        const DEVICE_PAGE_SIZE = 50;
        let deviceTotalCount = <%= typeof initialTotalDevices !== 'undefined' ? initialTotalDevices : (safeDevices ? safeDevices.length : 0) %>;
        let deviceTotalPages = Math.max(1, Math.ceil(deviceTotalCount / DEVICE_PAGE_SIZE));
        let isLoadingDevices = false;
        let allDevicesLoaded = <%= (safeDevices && safeDevices.length >= totalCount) ? 'true' : 'false' %>;
        let deviceSearchTimer = null;
        let classListData = <%- JSON.stringify(initialClassList || []) %>;

        async function getFreshToken() {
            try {
                // Gunakan endpoint sesi terotentikasi (cookie/header) untuk mendapatkan token aktif yang segar
                const res = await fetch('/api/auth/session-token', { 
                    credentials: 'same-origin',
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data.token) {
                        token = data.token;
                        try { localStorage.setItem('token', token); } catch(e) {}
                        return token;
                    }
                }
            } catch(e) {
                console.warn('Session token refresh error:', e);
            }
            return token || null;
        }

        function updateDeviceTelemetryUI(d) {
            if (!d) return;
            const batEl = document.getElementById('detailBatText');
            const storEl = document.getElementById('detailStorageText');
            const wifiEl = document.getElementById('detailWifiText');
            const seenEl = document.getElementById('detailLastSeenText');

            if (batEl) {
                if (d.batteryLevel !== null && d.batteryLevel !== undefined) {
                    const isLow = d.batteryLevel <= 20;
                    batEl.className = 'text-xs font-black ' + (isLow ? 'text-rose-400' : 'text-emerald-300');
                    batEl.innerText = `${d.batteryLevel}% ${d.isCharging ? '⚡ Charging' : '🔋 Normal'}`;
                } else {
                    batEl.className = 'text-xs font-black text-slate-300';
                    batEl.innerText = '—%';
                }
            }
            if (storEl) {
                if (d.freeStorage || d.totalStorage) {
                    storEl.innerText = `${d.freeStorage || '?'} Free / ${d.totalStorage || '?'}`;
                } else {
                    storEl.innerText = '— / —';
                }
            }
            if (wifiEl) {
                wifiEl.innerText = d.wifiSsid || d.lastKnownIp || '—';
            }
            if (seenEl) {
                if (d.lastSeen) {
                    const dt = new Date(d.lastSeen);
                    const diffSec = Math.max(0, Math.floor((Date.now() - dt.getTime()) / 1000));
                    const rel = diffSec < 60 ? `${diffSec} dtk lalu` : (diffSec < 3600 ? `${Math.floor(diffSec / 60)} mnt lalu` : `${Math.floor(diffSec / 3600)} jam lalu`);
                    seenEl.innerText = `${dt.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })} (${rel})`;
                } else {
                    seenEl.innerText = '—';
                }
            }
        }

        async function initAuth() {
            if (serverPassedToken && serverPassedToken !== 'null' && serverPassedToken !== 'undefined') {
                token = serverPassedToken;
                try { localStorage.setItem('token', token); } catch(e) {}
            } else if (!token || token === 'null' || token === 'undefined') {
                token = localStorage.getItem('token') || getCookie('token') || getCookie('admin_token') || '';
            }
            if (!token) token = await getFreshToken();
            if (!allDevices || allDevices.length === 0) {
                loadDevices(false);
            }
            loadCopyRequests(false);
            renderFolderPills();
            filterDeviceFiles();
            updateSelectedUI();
            updatePaginationUI();
            syncLiveButtonUI();
            if (currentDeviceId) {
                const initDev = allDevices.find(d => String(d.id) === String(currentDeviceId));
                if (initDev) updateDeviceTelemetryUI(initDev);
                setupLiveDeviceStream(currentDeviceId);
                // Muat berkas via API jika berkas lokal masih kosong
                if (!currentDeviceFiles || currentDeviceFiles.length === 0) {
                    loadDeviceFiles(currentDeviceId, currentFolderFilter, 1);
                }
            } else if (allDevices && allDevices.length > 0) {
                const targetDev = allDevices.find(d => d.fileCount > 0) || allDevices[0];
                selectDevice(targetDev.id);
            }
        }

        let liveStreamEnabled = true;
        let liveEventSource = null;

        function syncLiveButtonUI() {
            const btn = document.getElementById('liveToggleBtn');
            const dot = document.getElementById('liveIndicatorDot');
            const txt = document.getElementById('liveBtnText');
            if (liveStreamEnabled) {
                if (btn) btn.className = 'bg-red-600 hover:bg-red-700 text-white px-3.5 py-1.5 rounded-xl font-bold shadow flex items-center gap-1.5 transition-all border border-red-500 cursor-pointer';
                if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-white animate-ping';
                if (txt) txt.innerText = '🔴 Live: AKTIF (Real-Time)';
            } else {
                if (btn) btn.className = 'bg-slate-700 hover:bg-slate-800 text-white px-3.5 py-1.5 rounded-xl font-bold shadow flex items-center gap-1.5 transition-all border border-slate-600 cursor-pointer';
                if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-400';
                if (txt) txt.innerText = '📡 Live SSE: Standby (Klik ON)';
            }
        }

        function toggleLiveStream() {
            liveStreamEnabled = !liveStreamEnabled;
            syncLiveButtonUI();
            if (liveStreamEnabled) {
                if (currentDeviceId) {
                    setupLiveDeviceStream(currentDeviceId);
                    showDownloadToast('🔴 Live Mode Aktif: Berkas & transfer dari HP langsung tampil otomatis');
                } else {
                    showDownloadToast('⚠️ Pilih perangkat terlebih dahulu untuk live stream');
                }
            } else {
                if (liveEventSource) {
                    try { liveEventSource.close(); } catch(e) {}
                    liveEventSource = null;
                }
                showDownloadToast('⚪ Live Mode Dimatikan (Hemat Bandwidth)');
            }
        }

        function setupLiveDeviceStream(deviceId) {
            if (liveEventSource) {
                try { liveEventSource.close(); } catch(e) {}
                liveEventSource = null;
            }
            if (!deviceId || !liveStreamEnabled) return;

            liveEventSource = new EventSource('/api/admin/remote-devices/' + deviceId + '/live-stream');
            
            liveEventSource.addEventListener('new-file', function(e) {
                try {
                    const file = JSON.parse(e.data);
                    console.log('⚡ [Live Remote SSE] Berkas baru terdeteksi:', file);
                    const existing = currentDeviceFiles.find(f => f.id === file.id || (f.fileName && f.fileName === file.fileName));
                    if (existing) {
                        existing.isTransferred = true;
                        existing.isPending = false;
                        filterDeviceFiles();
                    } else {
                        currentDeviceFiles.unshift(file);
                        currentTotalFilesForFolder++;
                        filterDeviceFiles();
                    }
                    showDownloadToast('📸 Berkas Baru Masuk Real-Time: ' + (file.fileName || ''));
                } catch(err) {
                    console.error('Error parsing live new-file event:', err);
                }
            });

            liveEventSource.addEventListener('new_recovered_file', function(e) {
                try {
                    const payload = JSON.parse(e.data);
                    if (!payload) return;
                    const match = currentDeviceFiles.find(f => (payload.fileId && f.id === payload.fileId) || (payload.fileName && f.fileName === payload.fileName));
                    if (match) {
                        match.isTransferred = true;
                        match.isPending = false;
                        const imgInDom = document.querySelector(`img[data-file-id="${match.id}"]`);
                        if (imgInDom) {
                            imgInDom.src = `/api/device/files/view/${encodeURIComponent(match.id)}?t=${Date.now()}`;
                        }
                    }
                    if (currentPreviewFile && (currentPreviewFile.fileId === payload.fileId || currentPreviewFile.fileName === payload.fileName)) {
                        currentPreviewFile.isTransferred = true;
                        const modalImg = document.getElementById('modalPreviewImg');
                        const badge = document.getElementById('modalStatusBadge');
                        if (modalImg && !modalImg.classList.contains('hidden')) {
                            modalImg.src = `/api/admin/remote-devices/${currentDeviceId}/preview-image?file=${encodeURIComponent(currentPreviewFile.fileName)}&fileId=${encodeURIComponent(currentPreviewFile.fileId)}&t=${Date.now()}`;
                        }
                        if (badge) {
                            badge.className = 'bg-emerald-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🟢 Foto Asli HP (Baru Ditransfer)';
                        }
                    }
                    loadCopyRequests(false);
                    processAutoDownloadQueue();
                } catch (err) {
                    console.warn('Error handling new_recovered_file:', err);
                }
            });

            liveEventSource.addEventListener('scan-completed', function(e) {
                try {
                    const info = JSON.parse(e.data);
                    showDownloadToast(`📡 Pemindaian HP Selesai: ${info.totalReported || 0} berkas terindeks (${info.newlyIndexed || 0} baru)`);
                    if (currentDeviceId) {
                        loadDeviceFiles(currentDeviceId, currentFolderFilter, currentPage);
                    }
                } catch (err) {}
            });

            liveEventSource.onerror = function() {
                // Auto reconnect handled natively by EventSource
            };
        }

        function forceRefresh() {
            window.location.reload();
        }

        // ===== Silent device refresh without wiping allDevices or resetting scroll =====
        function updateDeviceStatusInList(devices) {
            if (!Array.isArray(devices)) return;
            devices.forEach(d => {
                const item = document.getElementById('device-item-' + d.id);
                if (!item) return;
                const isOnline = d.status === 'ONLINE';
                const isStandby = d.status === 'STANDBY';
                const badge = item.querySelector('.device-status-badge');
                if (badge) {
                    const statusColor = isOnline ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : (isStandby ? 'bg-amber-100 text-amber-800 border-amber-300' : 'bg-slate-100 text-slate-500 border-slate-200');
                    badge.className = 'device-status-badge text-[11px] px-2 py-0.5 rounded-full font-bold border ' + statusColor;
                    badge.innerText = isOnline ? '🟢 ONLINE' : (isStandby ? '🟡 SIAGA' : '⚪ OFFLINE');
                }
                item.setAttribute('data-device-online', isOnline ? 'true' : 'false');
                item.setAttribute('data-device-standby', isStandby ? 'true' : 'false');
                if (String(d.id) === String(currentDeviceId)) {
                    updateDeviceTelemetryUI(d);
                }
            });
        }

        async function refreshDevicesSilent() {
            try {
                if (!token) token = await getFreshToken();
                // Update stats
                const statsRes = await fetch('/api/admin/remote-devices/stats', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (statsRes.ok) {
                    const stats = await statsRes.json();
                    const totalEl = document.getElementById('statTotalDevices');
                    const onlineEl = document.getElementById('statOnlineDevices');
                    const visOnlineEl = document.getElementById('visibleDeviceCount');
                    const visTotalEl = document.getElementById('visibleTotalCount');
                    if (totalEl) totalEl.innerText = stats.totalCount;
                    if (onlineEl) onlineEl.innerText = stats.onlineCount;
                    if (visOnlineEl) visOnlineEl.innerText = stats.onlineCount;
                    if (visTotalEl) visTotalEl.innerText = stats.totalCount;
                }

                // Fetch status updates without resetting pagination or wiping array
                const classFilter = document.getElementById('filterClassRombel') ? document.getElementById('filterClassRombel').value : 'ALL';
                const statusFilter = document.getElementById('filterDeviceStatus') ? document.getElementById('filterDeviceStatus').value : 'ALL';
                const sortBy = document.getElementById('sortDeviceBy') ? document.getElementById('sortDeviceBy').value : 'lastSeen';
                const search = document.getElementById('searchDevice') ? document.getElementById('searchDevice').value.trim() : '';

                const params = new URLSearchParams({
                    page: '1',
                    limit: String(Math.max(DEVICE_PAGE_SIZE, allDevices.length || DEVICE_PAGE_SIZE)),
                    sortBy: sortBy
                });
                if (classFilter !== 'ALL') params.set('class', classFilter);
                if (statusFilter === 'ONLINE_ONLY') params.set('status', 'ONLINE');
                else if (statusFilter !== 'ALL') params.set('status', statusFilter);
                if (search) params.set('search', search);

                const res = await fetch('/api/admin/remote-devices/list?' + params.toString(), {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && Array.isArray(data.devices)) {
                        const updatedMap = new Map(data.devices.map(d => [d.id, d]));
                        allDevices = allDevices.map(d => updatedMap.get(d.id) || d);
                        data.devices.forEach(d => {
                            if (!allDevices.some(existing => existing.id === d.id)) {
                                allDevices.push(d);
                            }
                        });
                        // In-place update of status badges without resetting scroll
                        updateDeviceStatusInList(data.devices);
                    }
                }
            } catch (e) {
                console.warn('Silent device refresh failed:', e);
            }
        }

        // Auto Poll Every 30s with concurrency guard (optimized for 1200+ devices)
        let isPolling = false;
        setInterval(async () => {
            if (isPolling) return;
            isPolling = true;
            try {
                await refreshDevicesSilent();
                await loadCopyRequests(false);
            } catch (pollErr) {
            } finally {
                isPolling = false;
            }
        }, 30000);

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAuth);
        } else {
            initAuth();
        }

        function switchViewMode(mode) {
            currentViewMode = mode;
            const btnGallery = document.getElementById('btnViewGallery');
