        function extractFolderFromPath(filePath) {
            if (!filePath) return '📁 Penyimpanan Umum';
            const cleanPath = (filePath || '').split('::')[0].trim();
            const norm = cleanPath.replace(/\\/g, '/');
            const lower = norm.toLowerCase();
            const fileName = norm.substring(norm.lastIndexOf('/') + 1).toLowerCase();

            if (lower.includes('/.trash') || lower.includes('/.trashed') || lower.includes('globaltrash') || 
                lower.includes('vivo_trash') || lower.includes('trashbin') || lower.includes('/trash') || 
                lower.includes('/recycle') || fileName.startsWith('.trashed') || fileName.startsWith('♻️')) {
                return '♻️ Media Terhapus / Trash';
            }

            const isWaName = fileName.includes('-wa') || fileName.includes('_wa') || fileName.startsWith('wa') || fileName.startsWith('stk-') || fileName.startsWith('aud-') || fileName.startsWith('doc-') || fileName.startsWith('ptt-');
            const isWa = lower.includes('whatsapp') || isWaName;
            const isSent = norm.includes('/sent/') || norm.includes('/sent') || lower.includes('sent') || fileName.includes('sent');
            const isImg = /\.(jpg|jpeg|png|webp|bmp|heic|heif)$/i.test(norm) || lower.includes('image') || fileName.startsWith('img-') || fileName.startsWith('stk-');
            const isVid = /\.(mp4|mkv|3gp|avi|webm|mov)$/i.test(norm) || lower.includes('video') || fileName.startsWith('vid-');
            const isAudio = /\.(opus|m4a|mp3|ogg|wav|aac)$/i.test(norm) || lower.includes('voice') || lower.includes('audio') || fileName.startsWith('aud-') || fileName.startsWith('ptt-');
            const isDoc = /\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|rtf)$/i.test(norm) || lower.includes('document') || fileName.startsWith('doc-');

            if (isWa && isImg && isSent) return '📤 WA Images (Sent)';
            if (isWa && isImg && !isSent) return '📥 WA Images (Receive)';
            if (isWa && isVid && isSent) return '📤 WA Video (Sent)';
            if (isWa && isVid && !isSent) return '🎬 WA Video (Receive)';
            if (isWa && isAudio) return '🎵 WA Voice/Audio';
            if (isWa && isDoc) return '📄 WA Docs';

            if (lower.includes('dcim') || lower.includes('camera')) return '📷 Kamera (DCIM)';
            if (lower.includes('screenshots') || lower.includes('screenshot')) return '📱 Screenshots Layar';
            if (lower.includes('movies') || lower.includes('screenrecorder') || lower.includes('screen recorder')) return '🎬 Video & Rekaman Layar';
            if (lower.includes('download')) return '📥 Unduhan (Download)';
            if (isDoc) return '📄 Dokumen (Documents)';
            if (isAudio) return '🎵 Audio & Musik';

            const parts = norm.split('/');
            if (parts.length >= 2) {
                const parent = parts[parts.length - 2];
                if (parent && parent !== '0' && parent !== 'emulated' && parent !== 'storage') {
                    return '📁 ' + parent;
                }
            }
            return '📁 Penyimpanan Umum';
        }

        function renderFolderPills() {
            const container = document.getElementById('folderPillsContainer');
            if (!container) return;
            const folderCounts = (currentFolderCounts && Object.keys(currentFolderCounts).length > 0) ? currentFolderCounts : { 'ALL': currentTotalFilesForFolder || currentDeviceFiles.length };

            const priorityOrder = [
                '♻️ Media Terhapus / Trash',
                '✅ Sudah Ditransfer ke PC',
                '📥 WA Images (Receive)',
                '📤 WA Images (Sent)',
                '🎬 WA Video (Receive)',
                '📤 WA Video (Sent)',
                '📄 WA Docs (Receive)',
                '📤 WA Docs (Sent)',
                '🎵 WA Voice/Audio',
                '📷 Kamera (DCIM)',
                '📱 Screenshots Layar',
                '📥 Unduhan (Download)',
                '🎬 Video & Rekaman Layar',
                '📄 Dokumen (Documents)'
            ];

            const pillEntries = Object.keys(folderCounts).filter(k => k !== 'ALL').sort((a, b) => {
                const idxA = priorityOrder.indexOf(a);
                const idxB = priorityOrder.indexOf(b);
                if (idxA !== -1 && idxB !== -1) return idxA - idxB;
                if (idxA !== -1) return -1;
                if (idxB !== -1) return 1;
                return a.localeCompare(b);
            });

            container.innerHTML = `
                <div class="folder-pill ${currentFolderFilter === 'ALL' ? 'active' : ''} px-3.5 py-2 rounded-xl border border-blue-500 bg-blue-600 text-white font-bold flex items-center gap-2 shadow-sm cursor-pointer"
                     onclick="selectFolderFilter('ALL')">
                    <span>📁 Semua Folder</span>
                    <span class="bg-blue-800 text-[10px] text-white px-2 py-0.5 rounded-full font-bold">${folderCounts['ALL'] || 0}</span>
                </div>
            ` + pillEntries.map(fName => {
                const isActive = currentFolderFilter === fName;
                const isTransferred = fName.includes('Sudah Ditransfer');
                const isTrash = fName.includes('Terhapus') || fName.includes('Trash') || fName.includes('Sampah');
                let activeClass = 'border-slate-700 bg-slate-800 text-slate-200 hover:bg-slate-700';
                let badgeClass = 'bg-slate-700 text-blue-300';
                if (isActive) {
                    if (isTrash) {
                        activeClass = 'border-rose-500 bg-rose-600 text-white font-bold shadow-md';
                        badgeClass = 'bg-rose-800 text-white';
                    } else if (isTransferred) {
                        activeClass = 'border-emerald-500 bg-emerald-600 text-white font-bold shadow-md';
                        badgeClass = 'bg-emerald-800 text-white';
                    } else {
                        activeClass = 'border-blue-500 bg-blue-600 text-white font-bold shadow-md';
                        badgeClass = 'bg-blue-800 text-white';
                    }
                } else if (isTrash) {
                    activeClass = 'border-rose-600/70 bg-rose-950/60 text-rose-200 hover:bg-rose-900/80 font-bold';
                    badgeClass = 'bg-rose-800 text-rose-200';
                } else if (isTransferred) {
                    activeClass = 'border-emerald-600/70 bg-emerald-950/60 text-emerald-200 hover:bg-emerald-900/80 font-bold';
                    badgeClass = 'bg-emerald-800 text-emerald-200';
                }
                return `
                    <div class="folder-pill ${isActive ? 'active' : ''} px-3.5 py-2 rounded-xl border ${activeClass} flex items-center gap-2 transition-all cursor-pointer"
                         onclick="selectFolderFilter('${fName.replace(/'/g, "\\'")}')">
                        <span>${fName}</span>
                        <span class="${badgeClass} text-[10px] px-2 py-0.5 rounded-full font-bold">${folderCounts[fName] || 0}</span>
                    </div>
                `;
            }).join('');
        }

