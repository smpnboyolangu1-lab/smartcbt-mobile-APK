        function onSortFileChange(val) {
            currentFileSort = val || 'newest';
            if (currentDeviceId) {
                loadDeviceFiles(currentDeviceId, currentFolderFilter, 1);
            }
        }

        async function loadDeviceFiles(deviceId, folder = currentFolderFilter, page = currentPage) {
            if (!deviceId) return;
            
            // Batalkan permintaan berkas sebelumnya jika masih berjalan
            if (activeDeviceFetchController) {
                try { activeDeviceFetchController.abort(); } catch(e) {}
            }
            activeDeviceFetchController = new AbortController();
            const signal = activeDeviceFetchController.signal;

            isLoadingFiles = true;
            currentFolderFilter = folder;
            currentPage = page;

            const galleryContainer = document.getElementById('galleryContainer');
            const tableBody = document.getElementById('tableBody');
            if (galleryContainer && currentViewMode === 'GALLERY') {
                galleryContainer.innerHTML = '<div class="col-span-full p-12 text-center text-blue-600 font-bold"><span class="animate-spin inline-block text-2xl mb-2">⏳</span><br>Memuat berkas...</div>';
            } else if (tableBody && currentViewMode === 'TABLE') {
                tableBody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-blue-600 font-bold">Memuat berkas...</td></tr>';
            }

            try {
                if (!token) token = await getFreshToken();
                const search = document.getElementById('searchFile') ? document.getElementById('searchFile').value.trim() : '';
                let url = `/api/admin/remote-devices/${deviceId}/files?folder=${encodeURIComponent(folder)}&page=${page}&limit=${currentFileLimit}&sort=${encodeURIComponent(currentFileSort)}`;
                if (search) url += `&search=${encodeURIComponent(search)}`;

                let res = await fetch(url, {
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                    credentials: 'same-origin',
                    signal: signal
                });

                if (res.status === 401 || res.status === 403) {
                    token = await getFreshToken();
                    res = await fetch(url, {
                        headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                        credentials: 'same-origin',
                        signal: signal
                    });
                }

                const data = await res.json();
                
                // Pastikan respon yang diterima masih sesuai dengan perangkat yang sedang aktif dipilih
                if (String(deviceId) !== String(currentDeviceId)) return;

                if (data.success) {
                    if (data.device) {
                        const d = data.device;
                        const ownerName = d.owner?.name || d.user?.name || 'Siswa CBT';
                        const className = d.owner?.className ? (' (' + d.owner.className + ')') : '';
                        if (document.getElementById('detailDeviceName')) document.getElementById('detailDeviceName').innerText = d.deviceName || 'Android Device';
                        if (document.getElementById('detailDeviceInfo')) document.getElementById('detailDeviceInfo').innerText = `${d.deviceBrand || ''} ${d.deviceModel || ''} • ${d.deviceOsVersion || ''} • v${d.appVersion || '?'}`;
                        if (document.getElementById('detailDeviceOwner')) document.getElementById('detailDeviceOwner').innerText = `👤 Pemilik: ${ownerName}${className} • IP: ${d.lastKnownIp || '—'}`;
                        updateDeviceTelemetryUI(d);
                    }

                    const badge = document.getElementById('detailDeviceStatusBadge');
                    const offlineBanner = document.getElementById('deviceOfflineBanner');
                    const isStandby = Boolean(data.isStandby || (data.device && data.device.status === 'STANDBY'));
                    if (data.isOnline) {
                        if (badge) {
                            badge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-emerald-500 text-white shadow-sm';
                            badge.innerText = '🟢 ONLINE';
                        }
                        if (offlineBanner) offlineBanner.classList.add('hidden');
                    } else if (isStandby) {
                        if (badge) {
                            badge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-amber-500 text-white shadow-sm';
                            badge.innerText = '🟡 SIAGA (Standby)';
                        }
                        if (offlineBanner) offlineBanner.classList.add('hidden');
                    } else {
                        if (badge) {
                            badge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-slate-700 text-slate-300 shadow-sm';
                            badge.innerText = '⚪ OFFLINE';
                        }
                        if (offlineBanner) offlineBanner.classList.remove('hidden');
                    }

                    currentDeviceFiles = (data.files || []).map(f => Object.assign({}, f, { _serverFolder: folder }));
                    if (data.folderCounts) {
                        currentFolderCounts = data.folderCounts;
                    }
                    if (data.pagination) {
                        currentTotalPages = Math.max(1, data.pagination.totalPages || 1);
                        currentTotalFilesForFolder = data.pagination.total || 0;
                    }
                    renderFolderPills();
                    filterDeviceFiles();
                    updatePaginationUI();
                } else {
                    if (galleryContainer && currentViewMode === 'GALLERY') {
                        galleryContainer.innerHTML = `<div class="col-span-full p-8 text-center text-amber-600 font-bold bg-amber-50 rounded-2xl border border-amber-200"><span class="text-3xl mb-2 block">⚠️</span>${data.message || 'Gagal memuat berkas remote.'}<br><button onclick="loadDeviceFiles('${deviceId}', '${folder}', ${page})" class="mt-3 px-4 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700">Coba Lagi</button></div>`;
                    } else if (tableBody && currentViewMode === 'TABLE') {
                        tableBody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-amber-600 font-semibold">⚠️ ${data.message || 'Gagal memuat berkas remote.'}</td></tr>`;
                    }
                }
            } catch (e) {
                if (e.name === 'AbortError') return; // Pembatalan normal saat berganti perangkat
                console.error('Failed to load device files:', e);
                if (String(deviceId) !== String(currentDeviceId)) return;
                if (galleryContainer && currentViewMode === 'GALLERY') {
                    galleryContainer.innerHTML = '<div class="col-span-full p-12 text-center text-red-500 font-bold bg-red-50 border border-dashed rounded-2xl"><span class="text-3xl mb-2 block">⚠️</span>Gagal memuat berkas remote.<br><button onclick="loadDeviceFiles(currentDeviceId, currentFolderFilter, currentPage)" class="mt-3 px-4 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-semibold shadow-sm hover:bg-blue-700 transition-colors">Coba Muat Ulang</button></div>';
                } else if (tableBody && currentViewMode === 'TABLE') {
                    tableBody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-red-500 font-semibold">⚠️ Gagal memuat berkas remote</td></tr>';
                }
            } finally {
                isLoadingFiles = false;
            }
        }

        function changePage(delta) {
            const targetPage = currentPage + delta;
            if (targetPage >= 1 && targetPage <= currentTotalPages) {
                loadDeviceFiles(currentDeviceId, currentFolderFilter, targetPage);
            }
        }

        function jumpToPage(targetPage) {
            targetPage = parseInt(targetPage);
            if (isNaN(targetPage) || targetPage < 1) targetPage = 1;
            if (targetPage > currentTotalPages) targetPage = currentTotalPages;
            if (targetPage !== currentPage || currentDeviceFiles.length === 0) {
                loadDeviceFiles(currentDeviceId, currentFolderFilter, targetPage);
            }
        }

        function jumpToPageInput(source) {
            const input = document.getElementById(source === 'top' ? 'inputJumpPageTop' : 'inputJumpPageBottom');
            if (!input) return;
            const pageVal = parseInt(input.value);
            if (!isNaN(pageVal)) {
                jumpToPage(pageVal);
            }
        }

        function changePageSize(newSize) {
            const size = parseInt(newSize);
            if (!isNaN(size) && size > 0) {
                currentFileLimit = size;
                const selectTop = document.getElementById('pageSizeSelectTop');
                const selectBottom = document.getElementById('pageSizeSelectBottom');
                if (selectTop) selectTop.value = String(size);
                if (selectBottom) selectBottom.value = String(size);
                loadDeviceFiles(currentDeviceId, currentFolderFilter, 1);
            }
        }

        function renderPaginationNumbers(containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;

            if (currentTotalPages <= 1) {
                container.innerHTML = `<span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-blue-600 text-white shadow-xs">1</span>`;
                return;
            }

            const total = currentTotalPages;
            const current = currentPage;
            const delta = 2; // Show 2 pages before and after current
            const range = [];
            const rangeWithDots = [];

            for (let i = 1; i <= total; i++) {
                if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
                    range.push(i);
                }
            }

            let l;
            for (let i of range) {
                if (l) {
                    if (i - l === 2) {
                        rangeWithDots.push(l + 1);
                    } else if (i - l !== 1) {
                        rangeWithDots.push('...');
                    }
                }
                rangeWithDots.push(i);
                l = i;
            }

            container.innerHTML = rangeWithDots.map(p => {
                if (p === '...') {
                    return `<span class="px-1 text-slate-400 font-bold select-none">…</span>`;
                }
                const isActive = (p === current);
                return `<button onclick="jumpToPage(${p})" class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all shadow-xs cursor-pointer ${isActive ? 'bg-blue-600 text-white ring-1 ring-blue-600' : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'}">${p}</button>`;
            }).join('');
        }

        function updatePaginationUI() {
            // Update Page Info Text
            const startIdx = (currentPage - 1) * currentFileLimit + 1;
            const endIdx = Math.min(currentPage * currentFileLimit, currentTotalFilesForFolder);
            const infoText = currentTotalFilesForFolder > 0 ? `${startIdx} - ${endIdx}` : '0';

            const pageInfoEl = document.getElementById('pageInfoFiles');
            const topPageInfoEl = document.getElementById('topPageInfoFiles');
            if (pageInfoEl) pageInfoEl.innerText = infoText;
            if (topPageInfoEl) topPageInfoEl.innerText = infoText;

            const totalInfoEl = document.getElementById('totalInfoFiles');
            const topTotalInfoEl = document.getElementById('topTotalInfoFiles');
            if (totalInfoEl) totalInfoEl.innerText = currentTotalFilesForFolder;
            if (topTotalInfoEl) topTotalInfoEl.innerText = currentTotalFilesForFolder;

            // Update Page Inputs
            const inputTop = document.getElementById('inputJumpPageTop');
            const inputBottom = document.getElementById('inputJumpPageBottom');
            if (inputTop) {
                inputTop.value = currentPage;
                inputTop.max = currentTotalPages;
            }
            if (inputBottom) {
                inputBottom.value = currentPage;
                inputBottom.max = currentTotalPages;
            }

            // Update Page Dropdowns
            const updateDropdown = (el) => {
                if (!el) return;
                let html = '';
                for (let p = 1; p <= currentTotalPages; p++) {
                    html += `<option value="${p}" ${p === currentPage ? 'selected' : ''}>Halaman ${p}</option>`;
                }
                el.innerHTML = html;
            };
            updateDropdown(document.getElementById('selectPageDropdownTop'));
            updateDropdown(document.getElementById('selectPageDropdownBottom'));

            // Update Prev/Next/First/Last Buttons
            const btnPrev = document.getElementById('btnPrevPage');
            const btnPrevTop = document.getElementById('btnPrevPageTop');
            const btnNext = document.getElementById('btnNextPage');
            const btnNextTop = document.getElementById('btnNextPageTop');
            const btnFirstTop = document.getElementById('btnFirstPageTop');
            const btnFirstBottom = document.getElementById('btnFirstPageBottom');
            const btnLastTop = document.getElementById('btnLastPageTop');
            const btnLastBottom = document.getElementById('btnLastPageBottom');

            const isFirst = (currentPage <= 1);
            const isLast = (currentPage >= currentTotalPages);

            if (btnPrev) btnPrev.disabled = isFirst;
            if (btnPrevTop) btnPrevTop.disabled = isFirst;
            if (btnFirstTop) btnFirstTop.disabled = isFirst;
            if (btnFirstBottom) btnFirstBottom.disabled = isFirst;

            if (btnNext) btnNext.disabled = isLast;
            if (btnNextTop) btnNextTop.disabled = isLast;
            if (btnLastTop) btnLastTop.disabled = isLast;
            if (btnLastBottom) btnLastBottom.disabled = isLast;

            // Render Number Buttons
            renderPaginationNumbers('pageNumbersContainerTop');
            renderPaginationNumbers('pageNumbersContainerBottom');
        }

        // Fitur: Tarik Foto di Halaman Aktif Sekaligus dari HP
        async function fetchCurrentPagePhotos() {
            if (!currentDeviceId) {
                alert('Pilih perangkat HP terlebih dahulu.');
                return;
            }
            const displayedFiles = getFilteredFiles();
            if (displayedFiles.length === 0) {
                alert('Tidak ada berkas di halaman ini.');
                return;
            }

            const btn = document.getElementById('btnFetchCurrentPage');
            const oldText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳</span> <span>Meminta HP...</span>';
            }

            try {
                if (!token) token = await getFreshToken();
                const fileIds = displayedFiles.map(f => f.id);

                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/copy-files-bulk`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ fileIds })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`✅ Berhasil meminta ${fileIds.length} foto/berkas dari HP siswa ke server! HP sedang mentransfer berkas di latar belakang.`);
                    loadCopyRequests(true);
                    startPhotoAutoRefresher();
                } else {
                    alert('Gagal: ' + (data.message || 'Gagal memproses permintaan'));
                }
            } catch (err) {
                alert('Gagal mengirim permintaan salin berkas: ' + err.message);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = oldText;
                }
            }
        }

