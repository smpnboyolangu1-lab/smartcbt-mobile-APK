        async function selectDevice(deviceId) {
            if (!deviceId) return;
            currentDeviceId = String(deviceId);
            currentPage = 1;
            currentFolderFilter = 'ALL';
            selectedFileIds.clear();
            updateSelectedUI();

            const panel = document.getElementById('deviceDetailPanel');
            if (panel) panel.classList.remove('hidden');

            // 1. Seketika perbarui highlight visual pada item yang diklik tanpa merusak scroll
            document.querySelectorAll('.device-card-item').forEach(el => {
                if (el.getAttribute('data-device-id') === currentDeviceId) {
                    el.className = 'device-card-item p-3.5 hover:bg-blue-50 cursor-pointer transition-colors border-b bg-blue-50 border-l-4 border-blue-500 shadow-xs';
                } else {
                    el.className = 'device-card-item p-3.5 hover:bg-blue-50 cursor-pointer transition-colors border-b';
                }
            });

            // 2. Seketika perbarui panel detail perangkat dari memory atau dataset DOM
            const dev = allDevices.find(d => String(d.id) === currentDeviceId);
            const cardEl = document.getElementById('device-item-' + currentDeviceId);

            if (dev) updateDeviceTelemetryUI(dev);

            let devName = dev?.deviceName;
            let devInfo = dev ? `${dev.deviceBrand || ''} ${dev.deviceModel || ''} • ${dev.deviceOsVersion || ''} • v${dev.appVersion || '?'}` : null;
            let devOwner = dev ? `👤 Pemilik: ${dev.owner?.name || dev.user?.name || 'Siswa CBT'}${dev.owner?.className ? (' (' + dev.owner.className + ')') : ''} • IP: ${dev.lastKnownIp || '10.0.2.2'}` : null;
            let isOnline = dev ? (dev.status === 'ONLINE') : false;
            let isStandby = dev ? (dev.status === 'STANDBY') : false;

            if (!devName && cardEl) {
                devName = cardEl.getAttribute('data-device-name');
                devInfo = cardEl.getAttribute('data-device-info');
                devOwner = cardEl.getAttribute('data-device-owner');
                isOnline = cardEl.getAttribute('data-device-online') === 'true';
                isStandby = cardEl.getAttribute('data-device-standby') === 'true';
            }

            if (devName && document.getElementById('detailDeviceName')) document.getElementById('detailDeviceName').innerText = devName;
            if (devInfo && document.getElementById('detailDeviceInfo')) document.getElementById('detailDeviceInfo').innerText = devInfo;
            if (devOwner && document.getElementById('detailDeviceOwner')) document.getElementById('detailDeviceOwner').innerText = devOwner;

            const badge = document.getElementById('detailDeviceStatusBadge');
            const offlineBanner = document.getElementById('deviceOfflineBanner');
            if (badge) {
                badge.className = isOnline 
                    ? 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-emerald-500 text-white shadow-sm' 
                    : (isStandby ? 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-amber-500 text-white shadow-sm' : 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-slate-700 text-slate-300 shadow-sm');
                badge.innerText = isOnline ? '🟢 ONLINE' : (isStandby ? '🟡 SIAGA (Standby)' : '⚪ OFFLINE');
