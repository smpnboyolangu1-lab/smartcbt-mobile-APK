                if (isOnline || isStandby) offlineBanner.classList.add('hidden');
                else offlineBanner.classList.remove('hidden');
            }

            const appVer = dev ? dev.appVersion : (cardEl ? cardEl.getAttribute('data-device-version') : null);
            const versionBadge = document.getElementById('detailDeviceVersionBadge');
            const versionText = document.getElementById('detailDeviceVersionText');
            if (versionBadge && versionText) {
                const isLatest = appVer && appVer >= serverLatestAppVersion;
                versionBadge.className = isLatest 
                    ? 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-emerald-500/30 text-emerald-300 border border-emerald-400/50 shadow-sm flex items-center gap-1'
                    : 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-amber-500/30 text-amber-300 border border-amber-400/50 shadow-sm flex items-center gap-1';
                versionText.innerText = `v${appVer || '?'} ${isLatest ? '✅ (Terbaru)' : '⚠️ (Perlu Update)'}`;
            }

            // 3. Hubungkan SSE live stream untuk perangkat yang dipilih
            setupLiveDeviceStream(currentDeviceId);

            // 4. Muat berkas perangkat ini
            loadDeviceFiles(currentDeviceId, 'ALL', 1);
        }

        let currentPreviewFile = null;
        let currentPreviewRotation = 0;

        function openPreviewModal(fileId, fileName, filePath, fileSize, isTransferredParam) {
            currentPreviewRotation = 0;
            const isVideo = /\.(mp4|mkv|avi|mov|webm|3gp)$/i.test(fileName);
            const isPdf = fileName.toLowerCase().endsWith('.pdf');

            const filteredList = getFilteredFiles();
            const currentIdx = filteredList.findIndex(x => x.id === fileId);
            const counterEl = document.getElementById('modalPreviewCounter');
            if (counterEl) {
                counterEl.innerText = currentIdx >= 0 ? `${currentIdx + 1} / ${filteredList.length}` : `1 / ${filteredList.length || 1}`;
            }

            const fObj = currentDeviceFiles.find(x => x.id === fileId);
            const isTransferred = (typeof isTransferredParam !== 'undefined') ? Boolean(isTransferredParam) : Boolean(fObj && fObj.isTransferred);
            currentPreviewFile = { fileId, fileName, filePath, fileSize, isTransferred };

            document.getElementById('modalTitle').innerText = (isVideo ? 'Pratinjau Video: ' : (isPdf ? 'Pratinjau Dokumen: ' : 'Pratinjau Foto: ')) + fileName;
            document.getElementById('modalFileName').innerText = fileName;
            document.getElementById('modalFilePath').innerText = filePath;
            document.getElementById('modalFileSize').innerText = 'Ukuran: ' + fileSize;

            const imgEl = document.getElementById('modalPreviewImg');
            if (imgEl) imgEl.style.transform = 'rotate(0deg)';
            const pdfEl = document.getElementById('modalPdfPlaceholder');
            const videoEl = document.getElementById('modalVideoPlaceholder');
            const videoFallback = document.getElementById('modalVideoFallback');
            const videoPullProgress = document.getElementById('modalVideoPullProgress');
            const pullBtn = document.getElementById('btnPullAndPlayVideo');
            if (pullBtn) pullBtn.disabled = false;
            if (videoPullProgress) {
                videoPullProgress.classList.add('hidden');
                videoPullProgress.innerText = '';
            }

            imgEl.classList.add('hidden');
            pdfEl.classList.add('hidden');
            pdfEl.classList.remove('flex');
            if (videoEl) {
                videoEl.classList.add('hidden');
                videoEl.classList.remove('flex');
            }

            if (isPdf) {
                pdfEl.classList.remove('hidden');
                pdfEl.classList.add('flex');
            } else if (isVideo) {
                if (videoEl) {
                    videoEl.classList.remove('hidden');
                    videoEl.classList.add('flex');
                }
                const badge = document.getElementById('modalStatusBadge');
                const player = document.getElementById('modalVideoPlayer');
                const notice = document.getElementById('modalVideoNotice');

                if (player) {
                    player.pause();
                    player.removeAttribute('src');
                }

                if (!isTransferred) {
                    // Video belum ada di server PC -> tampilkan tombol tarik & putar
                    if (player) player.classList.add('hidden');
                    if (videoFallback) videoFallback.classList.remove('hidden');
                    if (notice) notice.innerText = '⚠️ Video belum ditarik ke server PC. Klik tombol [Tarik Video dari HP & Putar Otomatis] untuk mulai streaming.';
                    if (badge) {
                        badge.className = 'bg-amber-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                        badge.innerText = '🎬 Video (Perlu Ditarik)';
                    }
                } else {
                    // Video sudah ada di server PC -> langsung stream HTTP 206
                    if (videoFallback) videoFallback.classList.add('hidden');
                    if (player) {
                        player.classList.remove('hidden');
                        const tok = token || localStorage.getItem('token') || '';
                        const streamUrl = '/api/admin/remote-devices/' + (currentDeviceId || '0') + '/stream/' + encodeURIComponent(fileId) + '?token=' + encodeURIComponent(tok);
                        player.src = streamUrl;
                        player.load();
                        player.play().catch(() => {});
                    }
                    if (badge) {
                        badge.className = 'bg-emerald-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                        badge.innerText = '🎬 Video (Siap Diputar)';
                    }
                }

                if (player) {
                    player.onerror = function() {
                        if (videoFallback) videoFallback.classList.remove('hidden');
                        if (player) player.classList.add('hidden');
                        if (notice) notice.innerText = '⚠️ Berkas video belum ada di server PC. Silakan tarik video dari HP terlebih dahulu.';
                        if (badge) {
                            badge.className = 'bg-amber-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🎬 Video (Perlu Ditarik)';
                        }
                    };
                    player.oncanplay = function() {
                        if (videoFallback) videoFallback.classList.add('hidden');
                        if (player) player.classList.remove('hidden');
                        if (notice) notice.innerText = '✅ Siap diputar langsung dari server (HTTP 206 Streaming).';
                        if (badge) {
                            badge.className = 'bg-emerald-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🎬 Video (Streaming Aktif)';
                        }
                    };
                }
            } else {
                imgEl.classList.remove('hidden');
                const badge = document.getElementById('modalStatusBadge');
                if (badge) {
                    badge.className = 'bg-blue-600/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                    badge.innerText = '⏳ Memuat...';
                }
                const previewSrc = '/api/admin/remote-devices/' + (currentDeviceId || '0') + '/preview-image?file=' + encodeURIComponent(fileName) + '&fileId=' + encodeURIComponent(fileId) + '&t=' + Date.now();
                imgEl.onload = function() {
                    if (badge) {
                        // Cek apakah output adalah SVG placeholder atau foto asli
                        const isSvg = (!isTransferred && (!fObj || !(fObj.filePath && fObj.filePath.startsWith('device-files/')))) || (imgEl.naturalWidth === 400 && imgEl.naturalHeight === 300) || (imgEl.naturalWidth === 600 && imgEl.naturalHeight === 380);
                        if (isSvg) {
                            badge.className = 'bg-amber-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '📱 Di HP Siswa (Perlu Ditarik)';
                        } else {
                            badge.className = 'bg-emerald-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🟢 Foto Asli HP';
                        }
                    }
                };
                imgEl.onerror = function() {
                    if (badge) {
                        badge.className = 'bg-red-500/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                        badge.innerText = '❌ Gagal Memuat';
                    }
                };
                imgEl.src = previewSrc;

                const openNewTabBtn = document.getElementById('modalBtnOpenNewTab');
                if (openNewTabBtn) {
                    openNewTabBtn.href = previewSrc;
                    openNewTabBtn.classList.remove('hidden');
                }
            }

            document.getElementById('modalBtnCopy').onclick = function() {
                requestCopyFile(fileId, fileName, filePath);
                closePreviewModal();
            };

            const directBtn = document.getElementById('modalBtnDirectDownload');
            if (directBtn) {
                directBtn.onclick = function() {
                    downloadDirectFile(fileId, fileName, filePath);
                };
            }

            document.getElementById('previewModal').classList.remove('hidden');
        }

        function prevPreviewFile() {
            if (!currentPreviewFile) return;
            const list = getFilteredFiles();
            if (!list.length) return;
            const idx = list.findIndex(x => x.id === currentPreviewFile.fileId);
            const targetIdx = idx > 0 ? idx - 1 : list.length - 1;
            const f = list[targetIdx];
            if (f) openPreviewModal(f.id, f.fileName, f.filePath || '', f.fileSizeHuman || '', Boolean(f.isTransferred));
        }

        function nextPreviewFile() {
            if (!currentPreviewFile) return;
            const list = getFilteredFiles();
            if (!list.length) return;
            const idx = list.findIndex(x => x.id === currentPreviewFile.fileId);
            const targetIdx = (idx >= 0 && idx < list.length - 1) ? idx + 1 : 0;
            const f = list[targetIdx];
            if (f) openPreviewModal(f.id, f.fileName, f.filePath || '', f.fileSizeHuman || '', Boolean(f.isTransferred));
        }

        function rotatePreviewImage() {
            const imgEl = document.getElementById('modalPreviewImg');
            if (!imgEl || imgEl.classList.contains('hidden')) return;
            currentPreviewRotation = (currentPreviewRotation + 90) % 360;
            imgEl.style.transform = `rotate(${currentPreviewRotation}deg)`;
        }

        document.addEventListener('keydown', (e) => {
            const modal = document.getElementById('previewModal');
            if (!modal || modal.classList.contains('hidden')) return;
            if (e.key === 'ArrowLeft') { e.preventDefault(); prevPreviewFile(); }
            else if (e.key === 'ArrowRight') { e.preventDefault(); nextPreviewFile(); }
            else if (e.key === 'Escape') { e.preventDefault(); closePreviewModal(); }
        });

        function toggleImageZoom(img) {
            if (!img) return;
            if (img.classList.contains('max-h-[55vh]')) {
                img.classList.remove('max-h-[55vh]');
                img.classList.remove('object-contain');
                img.classList.remove('cursor-zoom-in');
                img.classList.add('cursor-zoom-out');
            } else {
                img.classList.add('max-h-[55vh]');
                img.classList.add('object-contain');
                img.classList.add('cursor-zoom-in');
                img.classList.remove('cursor-zoom-out');
            }
        }

        // ===== AUTO-DOWNLOAD QUEUE HELPER =====
        let autoDownloadQueue = [];
        try {
            const savedQ = localStorage.getItem('smartcbt_autodownload_queue');
            if (savedQ) autoDownloadQueue = JSON.parse(savedQ);
        } catch(e) {}

        function enqueueAutoDownload(requestId, fileName, filePath, deviceId, deviceName) {
            if (!requestId) return;
            if (!autoDownloadQueue.some(q => q.requestId === requestId)) {
                autoDownloadQueue.push({
                    requestId,
                    fileName: fileName || 'file',
                    filePath: filePath || '',
                    deviceId: deviceId || currentDeviceId,
                    deviceName: deviceName || '',
                    addedAt: Date.now()
                });
                try {
                    localStorage.setItem('smartcbt_autodownload_queue', JSON.stringify(autoDownloadQueue.slice(-50)));
                } catch(e) {}
            }
            const banner = document.getElementById('autoDownloadQueueBanner');
            const txt = document.getElementById('autoDownloadQueueText');
            if (banner && autoDownloadQueue.length > 0) {
                banner.classList.remove('hidden');
                if (txt) txt.innerText = `Menunggu HP siswa mentransfer ${autoDownloadQueue.length} berkas (${fileName || 'media'})...`;
            }
        }

        async function processAutoDownloadQueue() {
            if (!autoDownloadQueue || autoDownloadQueue.length === 0) return;
            try {
                if (!token) token = await getFreshToken();
                const res = await fetch('/api/admin/remote-devices/copy-requests', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success || !data.requests) return;
                let changed = false;
                const remaining = [];
                for (const item of autoDownloadQueue) {
                    const req = data.requests.find(r => r.id === item.requestId);
                    if (req && (req.status === 'COMPLETED' || req.status === 'UPLOADED')) {
                        downloadFile(item.requestId, item.fileName);
                        changed = true;
                    } else if (req && req.status === 'FAILED') {
                        changed = true;
                    } else if (Date.now() - (item.addedAt || 0) < 3600000) {
                        remaining.push(item);
                    } else {
                        changed = true;
                    }
                }
                if (changed) {
                    autoDownloadQueue = remaining;
                    try { localStorage.setItem('smartcbt_autodownload_queue', JSON.stringify(autoDownloadQueue)); } catch(e) {}
                    const banner = document.getElementById('autoDownloadQueueBanner');
                    const txt = document.getElementById('autoDownloadQueueText');
                    if (autoDownloadQueue.length === 0) {
                        if (banner) banner.classList.add('hidden');
                    } else if (txt) {
                        txt.innerText = `Menunggu HP siswa mentransfer ${autoDownloadQueue.length} berkas...`;
                    }
                    if (currentDeviceId) loadDeviceFiles(currentDeviceId, currentFolderFilter || 'ALL', currentPage);
                    loadCopyRequests(false);
                }
            } catch(e) {}
        }

        function clearAutoDownloadQueue() {
            autoDownloadQueue = [];
            try { localStorage.removeItem('smartcbt_autodownload_queue'); } catch(e) {}
            const banner = document.getElementById('autoDownloadQueueBanner');
            if (banner) banner.classList.add('hidden');
            showDownloadToast('ℹ️ Antrean unduh otomatis dibersihkan.');
        }

        setInterval(processAutoDownloadQueue, 5000);

        async function pullFile(fileId, fileName, filePath, onProgress, onComplete, onError) {
            const devId = currentDeviceId || (safeSelectedDevice && safeSelectedDevice.id) || (allDevices[0] && allDevices[0].id);
            if (!devId) {
                if (onError) onError('Pilih perangkat siswa terlebih dahulu.');
                return;
            }

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/remote-devices/${devId}/copy-file`, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ fileId, fileName, filePath })
                });
                const data = await res.json();
                if (!data.success && !data.requestId) {
                    if (onError) onError(data.message || 'Gagal meminta salin berkas dari HP');
                    return;
                }

                const targetRequestId = data.requestId;
                enqueueAutoDownload(targetRequestId, fileName, filePath, currentDeviceId, document.getElementById('detailDeviceName')?.innerText);

                if (data.status === 'COMPLETED') {
                    if (onComplete) onComplete(targetRequestId);
                    return;
                }

                let elapsed = 0;
                const maxWait = 90;
                const pollInterval = setInterval(async () => {
                    elapsed += 2;
                    if (onProgress) onProgress(elapsed, maxWait);

                    try {
                        const checkRes = await fetch(`/api/admin/remote-devices/copy-requests?deviceId=${devId}`, {
                            headers: { 'Authorization': 'Bearer ' + token }
                        });
                        const checkData = await checkRes.json();
                        if (checkData.success && checkData.requests) {
                            const reqItem = checkData.requests.find(r => r.id === targetRequestId);
                            if (reqItem) {
                                if (reqItem.status === 'COMPLETED') {
                                    clearInterval(pollInterval);
                                    if (onComplete) onComplete(targetRequestId);
                                    return;
                                } else if (reqItem.status === 'FAILED') {
                                    clearInterval(pollInterval);
                                    if (onError) onError(reqItem.errorMessage || 'HP gagal mentransfer berkas');
                                    return;
                                }
                            }
                        }
                    } catch (e) {}

                    if (elapsed >= maxWait) {
                        clearInterval(pollInterval);
                        if (onError) onError('Waktu tunggu transfer video habis (90 detik).');
                    }
                }, 2000);
            } catch (err) {
                if (onError) onError('Terjadi kesalahan jaringan.');
            }
        }

        async function pullAndPlayCurrentVideo() {
            if (!currentPreviewFile) return;
            const { fileId, fileName, filePath } = currentPreviewFile;

            const pullBtn = document.getElementById('btnPullAndPlayVideo');
            const pullProgress = document.getElementById('modalVideoPullProgress');
            const notice = document.getElementById('modalVideoNotice');
            const badge = document.getElementById('modalStatusBadge');
            const player = document.getElementById('modalVideoPlayer');
            const fallbackBox = document.getElementById('modalVideoFallback');

            if (pullBtn) pullBtn.disabled = true;
            if (pullProgress) {
                pullProgress.classList.remove('hidden');
                pullProgress.innerText = '⏳ Mengirim instruksi penarikan video ke HP siswa...';
            }
            if (badge) {
                badge.className = 'bg-amber-500 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full animate-pulse';
                badge.innerText = '⏳ Mentransfer dari HP...';
            }

            pullFile(
                fileId,
                fileName,
                filePath,
                (elapsed, maxWait) => {
                    if (pullProgress) pullProgress.innerText = `⏳ Mentransfer video dari HP (${elapsed}s/${maxWait}s)...`;
                },
                (requestId) => {
                    if (pullProgress) {
                        pullProgress.innerText = '✅ Berkas video berhasil ditransfer! Memulai pemutaran HTTP 206...';
                    }
                    const fObj = currentDeviceFiles.find(x => x.id === fileId);
                    if (fObj) fObj.isTransferred = true;
                    if (currentPreviewFile) currentPreviewFile.isTransferred = true;

                    setTimeout(() => {
                        if (fallbackBox) fallbackBox.classList.add('hidden');
                        if (player) {
                            player.classList.remove('hidden');
                            const tok = token || localStorage.getItem('token') || '';
                            const streamUrl = `/api/admin/remote-devices/${currentDeviceId || '0'}/stream/${encodeURIComponent(fileId)}?token=${encodeURIComponent(tok)}&t=${Date.now()}`;
                            player.src = streamUrl;
                            player.load();
                            player.play().catch(() => {});
                        }
                    }, 600);

                    loadCopyRequests(false);
                },
                (errMsg) => {
                    if (pullBtn) pullBtn.disabled = false;
                    if (pullProgress) pullProgress.innerText = '❌ ' + errMsg;
                    if (notice) notice.innerText = '❌ ' + errMsg;
                    if (badge) {
                        badge.className = 'bg-red-600 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                        badge.innerText = '❌ Gagal Transfer';
                    }
                }
            );
        }

        async function triggerRescanDevice() {
            const devId = currentDeviceId || (safeSelectedDevice && safeSelectedDevice.id) || (allDevices[0] && allDevices[0].id);
            if (!devId) {
                showDownloadToast('⚠️ Pilih perangkat HP siswa terlebih dahulu.');
                return;
            }

            const targetDev = (allDevices || []).find(d => d.id === devId) || safeSelectedDevice;
            const isTargetOnline = targetDev && targetDev.status === 'ONLINE';

            showDownloadToast('⏳ Mengirim sinyal pemindaian berkas media ke HP...');
            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/remote-devices/${devId}/scan-trigger`, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    }
                });
                const data = await res.json();
                if (data.success) {
                    if (!isTargetOnline) {
                        showDownloadToast('ℹ️ HP sedang SIAGA/OFFLINE. Perintah pindai disimpan di server dan akan dieksekusi saat aplikasi CBT dibuka di HP.');
                    } else {
                        showDownloadToast('📡 Sinyal diterima! Menunggu siklus heartbeat HP siswa (10–25 detik)...');
                        let pollAttempts = 0;
                        const pollTimer = setInterval(() => {
                            pollAttempts++;
                            if (currentDeviceId) {
                                loadDeviceFiles(currentDeviceId, currentFolderFilter || 'ALL', currentPage);
                            }
                            if (pollAttempts >= 5) {
                                clearInterval(pollTimer);
                                showDownloadToast('✅ Siklus sinkronisasi selesai diperbarui.');
                            }
                        }, 5000);
                    }
                } else {
                    showDownloadToast('❌ ' + (data.message || 'Gagal memicu pemindaian'));
                }
            } catch (err) {
                showDownloadToast('❌ Terjadi kesalahan jaringan saat memicu pemindaian');
            }
        }

        let isScannerActive = <%= initialScannerState %>;

        async function toggleScannerGlobal(forceTargetState) {
            const targetState = (typeof forceTargetState === 'boolean') ? forceTargetState : !isScannerActive;
            const btn = document.getElementById('scannerToggleBtn');
            const dot = document.getElementById('scannerToggleDot');
            const badge = document.getElementById('scannerStatusBadge');
            const banner = document.getElementById('scannerOffBanner');

            try {
                if (btn) btn.disabled = true;
                if (!token) token = await getFreshToken();

                const res = await fetch('/api/device/scanner-toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(token ? { 'Authorization': 'Bearer ' + token } : {})
                    },
                    body: JSON.stringify({ enabled: targetState })
                });

                const data = await res.json();
                if (data.success) {
                    isScannerActive = data.enabled;
                    if (btn) {
                        btn.className = `relative inline-flex items-center h-6 rounded-full w-12 transition-colors focus:outline-none cursor-pointer ${isScannerActive ? 'bg-emerald-600' : 'bg-rose-500'}`;
                    }
                    if (dot) {
                        dot.className = `inline-block w-4 h-4 transform bg-white rounded-full transition-transform ${isScannerActive ? 'translate-x-7' : 'translate-x-1'}`;
                    }
                    if (badge) {
                        badge.className = `font-extrabold text-[11px] px-2 py-0.5 rounded-md ${isScannerActive ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}`;
                        badge.textContent = isScannerActive ? 'ON' : 'OFF';
                    }
                    if (banner) {
                        if (isScannerActive) banner.classList.add('hidden');
                        else banner.classList.remove('hidden');
                    }

                    if (typeof showDownloadToast === 'function') {
                        showDownloadToast(isScannerActive ? '🟢 Scanner Berkas HP Siswa DIAKTIFKAN (ON)' : '🔴 Scanner Berkas HP Siswa DINONAKTIFKAN (OFF)');
                    }
                } else {
                    if (typeof showDownloadToast === 'function') {
                        showDownloadToast('❌ Gagal: ' + (data.message || 'Error server'));
                    }
                }
            } catch (err) {
                if (typeof showDownloadToast === 'function') {
                    showDownloadToast('❌ Terjadi kesalahan jaringan saat mengubah status scanner.');
                }
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        let isAdminControlActive = <%= initialAdminControlState %>;

