                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ fileIds })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`✅ Berhasil meminta ${fileIds.length} video dari HP siswa! HP sedang mentransfer via WiFi di latar belakang.`);
                    loadCopyRequests(true);
                    startPhotoAutoRefresher();
                } else {
                    alert('Gagal: ' + (data.message || 'Gagal memproses permintaan'));
                }
            } catch (err) {
                alert('Gagal mengirim permintaan tarik video: ' + err.message);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = oldText;
                }
            }
        }

        // Fitur: Tarik SEMUA (Foto + Video) dari HP siswa → Server (Folder A, WiFi Only)
        async function pullAllDeviceFiles() {
            if (!currentDeviceId) {
                alert('Pilih perangkat HP terlebih dahulu.');
                return;
            }

            if (!confirm('⚠️ Tarik SEMUA foto & video dari HP siswa ini ke server?\n\nUpload hanya terjadi saat HP terhubung WiFi.\nJika WiFi terputus, transfer akan dilanjutkan otomatis saat WiFi kembali.')) {
                return;
            }

            const btn = document.getElementById('btnPullAll');
            const oldText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳</span> <span>Mengirim perintah...</span>';
            }

            try {
                if (!token) token = await getFreshToken();

                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/pull-all`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ category: 'ALL' })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`✅ ${data.message}\n\n📊 Total: ${data.totalTarget} berkas\n✅ Sudah di server: ${data.readyCount}\n⏳ Antrean transfer: ${data.queuedCount}\n\n💡 Upload hanya via WiFi. Jika HP terputus WiFi, transfer akan dilanjutkan otomatis saat tersambung kembali.`);
                    loadCopyRequests(true);
                    startPhotoAutoRefresher();
                } else {
                    alert('Gagal: ' + (data.message || 'Gagal memproses permintaan'));
                }
            } catch (err) {
                alert('Gagal mengirim perintah tarik semua: ' + err.message);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = oldText;
                }
            }
        }

        // Fitur: Download SEMUA berkas yang sudah ditarik ke server sebagai 1 file ZIP
        function downloadAllAsZip() {
            if (!currentDeviceId) {
                alert('Pilih perangkat HP terlebih dahulu.');
                return;
            }
            if (!confirm('📦 Download SEMUA berkas yang sudah ditarik ke server sebagai 1 file ZIP?\n\nNama file: A_[NamaSiswa]_[Tanggal].zip')) {
                return;
            }
            window.open(`/api/admin/remote-devices/${currentDeviceId}/pull-all/download`, '_blank');
        }

        let photoRefreshTimer = null;
        let photoRefreshTries = 0;
        function startPhotoAutoRefresher() {
            if (photoRefreshTimer) clearInterval(photoRefreshTimer);
            photoRefreshTries = 0;
            photoRefreshTimer = setInterval(async () => {
                photoRefreshTries++;
                if (photoRefreshTries > 12) {
                    clearInterval(photoRefreshTimer);
                    photoRefreshTimer = null;
                    return;
                }
                await loadCopyRequests(false);
                // Refresh gambar di galeri dengan cache-buster
                const imgs = document.querySelectorAll('#galleryContainer img');
                imgs.forEach(img => {
                    const currentSrc = img.src;
                    if (currentSrc && currentSrc.includes('/preview-image')) {
                        try {
                            const url = new URL(currentSrc, window.location.origin);
                            url.searchParams.set('t', Date.now());
                            img.src = url.toString();
                        } catch (e) {}
                    }
                });
            }, 5000);
        }

        let searchDebounceTimeout = null;
        function onSearchFileInput() {
            clearTimeout(searchDebounceTimeout);
            searchDebounceTimeout = setTimeout(() => {
                loadDeviceFiles(currentDeviceId, currentFolderFilter, 1);
            }, 350);
        }

        function toggleSelectAllInFolder(chk) {
            const filesInFolder = getFilteredFiles();
            if (chk.checked) {
                filesInFolder.forEach(f => selectedFileIds.add(f.id));
            } else {
                filesInFolder.forEach(f => selectedFileIds.delete(f.id));
            }
            updateSelectedUI();
            filterDeviceFiles();
        }

        function selectAllInCurrentFolder() {
            const chk = document.getElementById('chkSelectAllFolder');
            if (chk) {
                chk.checked = true;
                toggleSelectAllInFolder(chk);
            }
        }

        function getFilteredFiles() {
            const catEl = document.getElementById('filterFileCategory');
            const cat = catEl ? catEl.value : 'ALL';
            const searchEl = document.getElementById('searchFile');
            const search = searchEl ? searchEl.value.toLowerCase().trim() : '';

            return currentDeviceFiles.filter(f => {
                let matchFolder = true;
                if (currentFolderFilter !== 'ALL') {
                    if (currentFolderFilter === '✅ Sudah Ditransfer ke PC' || currentFolderFilter.includes('Sudah Ditransfer')) {
                        matchFolder = Boolean(f.isTransferred || (f.filePath && f.filePath.startsWith('device-files/')));
                    } else if (f._serverFolder) {
                        // Jika berkas sudah ditarik secara spesifik oleh server untuk folder ini, jangan dibuang
                        matchFolder = (f._serverFolder === currentFolderFilter);
                    } else {
                        const folderName = extractFolderFromPath(f.filePath);
                        matchFolder = (folderName === currentFolderFilter);
                    }
                }
                const matchCat = cat === 'ALL' || f.category === cat;
                const matchSearch = !search ||
                    (f.fileName || '').toLowerCase().includes(search) ||
                    (f.filePath || '').toLowerCase().includes(search);
                const matchOnlySelected = !isOnlySelectedFilter || selectedFileIds.has(f.id);

                return matchFolder && matchCat && matchSearch && matchOnlySelected;
            });
        }

        function filterDeviceFiles() {
            const filtered = getFilteredFiles();
            if (currentViewMode === 'GALLERY') {
                renderVisualGallery(filtered);
            } else {
                renderTableBody(filtered);
            }
        }

        function toggleCardSelect(fileId) {
            if (selectedFileIds.has(fileId)) {
                selectedFileIds.delete(fileId);
            } else {
                selectedFileIds.add(fileId);
            }
            updateSelectedUI();
            filterDeviceFiles();
        }

        function buildDeviceFileUrls(f, devId) {
            if (f && f.id) {
                return {
                    thumbnailUrl: `/api/device/files/view/${encodeURIComponent(f.id)}`,
                    downloadUrl: `/api/device/files/view/${encodeURIComponent(f.id)}?download=1`
                };
            }
            const targetDevId = devId || currentDeviceId || f.deviceId || '0';
            let yStr = '2026';
            let mStr = '10';
            const dObj = f.lastModified ? new Date(f.lastModified) : (f.syncedAt ? new Date(f.syncedAt) : new Date());
            if (!isNaN(dObj.getTime())) {
                yStr = String(dObj.getFullYear());
                mStr = String(dObj.getMonth() + 1).padStart(2, '0');
            }
            if (f.filePath && f.filePath.startsWith('device-files/')) {
                const p = f.filePath.split('/');
                if (p.length >= 5) {
                    return {
                        thumbnailUrl: `/api/device/files/thumbnail/${encodeURIComponent(p[1])}/${encodeURIComponent(p[2])}/${encodeURIComponent(p[3])}/${encodeURIComponent(p[4])}`,
                        downloadUrl: `/api/device/files/download/${encodeURIComponent(p[1])}/${encodeURIComponent(p[2])}/${encodeURIComponent(p[3])}/${encodeURIComponent(p[4])}`
                    };
                }
            }
            return {
                thumbnailUrl: `/api/device/files/thumbnail/${encodeURIComponent(targetDevId)}/${yStr}/${mStr}/${encodeURIComponent(f.fileName)}`,
                downloadUrl: `/api/device/files/download/${encodeURIComponent(targetDevId)}/${yStr}/${mStr}/${encodeURIComponent(f.fileName)}`
            };
        }

        function renderVisualGallery(files) {
            const container = document.getElementById('galleryContainer');
            if (files.length === 0) {
                container.innerHTML = '<div class="col-span-full p-8 text-center text-gray-400 text-sm">Tidak ada berkas yang sesuai dengan folder/filter yang dipilih</div>';
                return;
            }

            container.innerHTML = files.map(f => {
                const isSelected = selectedFileIds.has(f.id);
                const norm = (f.filePath || '').replace(/\\/g, '/');
                const isVideo = /\.(mp4|mkv|avi|mov|webm|3gp)$/i.test(f.fileName || '') || f.category === 'VIDEO';
                const isAudio = /\.(mp3|wav|ogg|m4a|aac|opus)$/i.test(f.fileName || '') || f.category === 'AUDIO';
                const isImage = (f.category === 'PICTURES' || f.category === 'IMAGE' || /\.(jpg|jpeg|png|webp|bmp|heic|heif)$/i.test(f.fileName || ''));
                const ext = (f.fileExtension || '').toUpperCase();
                const icon = isVideo ? '🎬' : (isAudio ? '🎵' : (isImage ? '🖼️' : '📄'));

                const normLower = norm.toLowerCase();
                const nameLower = (f.fileName || '').toLowerCase();
                const isDeleted = f.category === 'DELETED_MEDIA' || f.isDeleted === true ||
                                  normLower.includes('/.trash') || normLower.includes('/.trashed') || 
                                  normLower.includes('/.recycle') || normLower.includes('/recently deleted') || 
                                  normLower.includes('/trash') || normLower.includes('globaltrash') || 
                                  normLower.includes('vivo_trash') || normLower.includes('trashbin') ||
                                  nameLower.startsWith('.trashed') || nameLower.startsWith('.pending') ||
                                  (f.fileName || '').startsWith('♻️');
                let badge = '';
                if (isDeleted) {
                    badge = '<span class="bg-gradient-to-r from-rose-600 to-red-600 text-white font-extrabold px-1.5 py-0.5 rounded text-[9px] shadow-sm animate-pulse tracking-wide">🔥 TERHAPUS (RECOVERED)</span>';
                } else if (norm.match(/WhatsApp.*Images\/Sent/i) || norm.match(/Sent.*Images/i)) {
                    badge = '<span class="bg-blue-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA Sent 📤</span>';
                } else if (norm.match(/WhatsApp.*Images/i)) {
                    badge = '<span class="bg-emerald-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA In 📥</span>';
                } else if (norm.match(/WhatsApp.*Video\/Sent/i) || norm.match(/Sent.*Video/i)) {
                    badge = '<span class="bg-indigo-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA Video Sent 📤</span>';
                } else if (norm.match(/WhatsApp.*Video/i)) {
                    badge = '<span class="bg-purple-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">WA Video In 📥</span>';
                } else if (isVideo) {
                    badge = '<span class="bg-amber-600 text-white font-bold px-1.5 py-0.5 rounded text-[9px] shadow-sm">Video 🎬</span>';
                }

                const fileUrls = buildDeviceFileUrls(f, currentDeviceId);
                const transferBadge = f.isTransferred
                    ? '<span class="bg-emerald-600/95 text-white text-[9px] font-bold px-1.5 py-0.5 rounded shadow-sm flex items-center gap-0.5" title="Berkas sudah tersimpan di server PC">✅ Di PC</span>'
                    : (f.isPending
                        ? '<span class="bg-amber-500/95 text-white text-[9px] font-bold px-1.5 py-0.5 rounded shadow-sm flex items-center gap-0.5 animate-pulse" title="Sedang mengantre ditarik dari HP">⏳ Antrean</span>'
                        : '<span class="bg-slate-800/85 text-slate-300 text-[9px] font-semibold px-1.5 py-0.5 rounded shadow-sm" title="Metadata tercatat, klik Salin/Unduh untuk tarik dari HP">📱 Di HP</span>');
                const visualContent = (isImage || isVideo) ? `
                    <div class="w-full h-full relative thumb-skeleton overflow-hidden">
                        <img data-file-id="${f.id}" src="${fileUrls.thumbnailUrl}" alt="${f.fileName}" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" onload="this.parentElement.classList.remove('thumb-skeleton')" onerror="this.onerror=null; this.src='/images/file-placeholder.svg'; this.parentElement.classList.remove('thumb-skeleton');" />
                    </div>
                    <div class="hidden flex flex-col items-center justify-center h-full p-2 text-center bg-slate-900/95 text-slate-300">
                        <span class="text-3xl mb-1">${icon}</span>
                        <span class="text-[10px] font-bold text-amber-400">Belum Ditransfer</span>
                        <span class="text-[9px] text-slate-400 font-mono mb-1.5 truncate max-w-[120px]">${f.fileName}</span>
                        <button onclick="event.stopPropagation(); requestCopyFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${(f.filePath || '').replace(/'/g, "\\'")}')" class="px-2 py-0.5 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold rounded shadow cursor-pointer">
                            📥 Tarik Foto
                        </button>
                    </div>
                    ${isVideo ? `
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                            <div class="w-10 h-10 rounded-full bg-black/60 backdrop-blur-sm flex items-center justify-center text-white text-sm shadow-lg border border-white/20">
                                ▶
                            </div>
                        </div>
                        <span class="absolute bottom-1.5 right-1.5 bg-black/80 text-amber-300 text-[9px] px-1.5 py-0.5 rounded font-bold font-mono">VIDEO</span>
                    ` : ''}
                ` : `
                    <span class="text-4xl mb-1">${icon}</span>
                    <span class="text-[10px] font-bold text-slate-500 tracking-wider font-mono uppercase">${ext || 'FILE'}</span>
                `;

                return `
                    <div class="gallery-card bg-white border rounded-2xl overflow-hidden shadow-sm flex flex-col justify-between transition-all cursor-pointer ${isSelected ? 'ring-2 ring-blue-500 bg-blue-50/40 border-blue-500' : 'hover:border-blue-300'}"
                         onclick="toggleCardSelect('${f.id}')">
                        <div class="h-40 bg-slate-900 flex items-center justify-center relative overflow-hidden">
                            ${visualContent}
                            
                            <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5" onclick="event.stopPropagation()">
                                <input type="checkbox" onchange="toggleFileSelection('${f.id}', this)" ${isSelected ? 'checked' : ''} class="w-4 h-4 rounded text-blue-600 cursor-pointer shadow-md">
                                ${transferBadge}
                            </div>

                            <div class="absolute top-2.5 right-2.5">
                                ${badge}
                            </div>
                        </div>

                        <div class="p-3 border-t bg-white" onclick="event.stopPropagation()">
                            <p class="font-bold text-xs text-gray-800 truncate" title="${f.filePath}">${f.fileName}</p>
                            <p class="text-[10px] text-gray-400 truncate mt-0.5" title="${f.filePath}">${f.filePath}</p>
                            
                            <div class="flex items-center justify-between mt-2.5 pt-2 border-t text-[10px]">
                                <span class="font-mono font-bold text-gray-600">${f.fileSizeHuman}</span>
                                <div class="flex gap-1.5">
                                    <button onclick="openPreviewModal('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${(f.filePath || '').replace(/'/g, "\\'")}', '${f.fileSizeHuman}', ${Boolean(f.isTransferred)})"
                                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1 rounded-lg font-semibold transition-colors">
                                        👁️ Review
                                    </button>
                                    <button onclick="requestCopyFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${(f.filePath || '').replace(/'/g, "\\'")}')"
                                            class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded-lg font-bold shadow-sm transition-colors">
                                        📥 Salin
                                    </button>
                                    <a href="${fileUrls.downloadUrl}" download="${f.fileName}"
                                       class="btn-download bg-emerald-600 hover:bg-emerald-700 text-white px-2 py-1 rounded-lg font-bold shadow-sm transition-colors flex items-center gap-1" title="Unduh langsung ke PC">
                                        <span>⬇️ Download</span>
                                    </a>
                                    <button onclick="event.stopPropagation(); deleteSingleFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}')"
                                            class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-2 py-1 rounded-lg font-bold shadow-sm transition-colors flex items-center" title="Hapus dari database & server">
                                        <span>🗑️</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderTableBody(files) {
            const container = document.getElementById('tableBody');
            if (files.length === 0) {
                container.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-gray-400">Tidak ada berkas yang sesuai filter</td></tr>';
                return;
            }

            container.innerHTML = files.map(f => {
                const isSelected = selectedFileIds.has(f.id);
                const folderName = extractFolderFromPath(f.filePath);
                const normPath = (f.filePath || '').toLowerCase();
                const tblNameLower = (f.fileName || '').toLowerCase();
                const isDeletedMedia = f.category === 'DELETED_MEDIA' || f.isDeleted === true ||
                                       normPath.includes('/.trash') || normPath.includes('/.trashed') || 
                                       normPath.includes('/.recycle') || normPath.includes('/recently deleted') || 
                                       normPath.includes('/trash') || normPath.includes('globaltrash') || 
                                       normPath.includes('vivo_trash') || normPath.includes('trashbin') ||
                                       tblNameLower.startsWith('.trashed') || tblNameLower.startsWith('.pending') ||
                                       (f.fileName || '').startsWith('♻️');
                const deletedBadge = isDeletedMedia ? `<span class="bg-gradient-to-r from-rose-600 to-red-600 text-white font-extrabold px-2 py-0.5 rounded text-[9px] shadow-sm tracking-wide mr-1.5 animate-pulse inline-flex items-center gap-1">🔥 TERHAPUS (RECOVERED)</span>` : '';
                return `
                    <tr class="hover:bg-blue-50/50 transition-colors ${isSelected ? 'bg-blue-50/60 font-semibold' : ''} ${isDeletedMedia ? 'bg-rose-50/30' : ''}">
                        <td class="p-3 text-center">
                            <input type="checkbox" onchange="toggleFileSelection('${f.id}', this)" ${isSelected ? 'checked' : ''} class="w-4 h-4 rounded text-blue-600">
                        </td>
                        <td class="p-3 font-semibold text-gray-800">
                            ${deletedBadge}${f.fileName}
                        </td>
                        <td class="p-3">
                            <span class="${isDeletedMedia ? 'bg-rose-100 text-rose-800 font-extrabold border border-rose-300' : 'bg-slate-100 text-slate-700 font-bold'} px-2 py-0.5 rounded text-[10px]">${folderName}</span>
                        </td>
                        <td class="p-3 font-mono text-gray-600">${f.fileSizeHuman}</td>
                        <td class="p-3 text-right space-x-1.5">
                            <button onclick="openPreviewModal('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${(f.filePath || '').replace(/'/g, "\\'")}', '${f.fileSizeHuman}', ${Boolean(f.isTransferred)})" class="bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded text-gray-700 font-semibold">👁️</button>
                            <button onclick="requestCopyFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${(f.filePath || '').replace(/'/g, "\\'")}')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-2.5 py-1 rounded shadow-sm">📥 Salin</button>
                            <a href="${buildDeviceFileUrls(f, currentDeviceId).downloadUrl}" download="${f.fileName}" class="btn-download bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-2.5 py-1 rounded shadow-sm inline-flex items-center gap-1">⬇️ Unduh</a>
                            <button onclick="deleteSingleFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}')" class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-2 py-1 rounded font-bold shadow-sm inline-flex items-center" title="Hapus dari database & server">🗑️</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function toggleFileSelection(fileId, checkbox) {
            if (checkbox.checked) {
                selectedFileIds.add(fileId);
            } else {
                selectedFileIds.delete(fileId);
            }
            updateSelectedUI();
        }

        function clearAllSelections() {
            selectedFileIds.clear();
            isOnlySelectedFilter = false;
            const btn = document.getElementById('btnOnlySelectedFilter');
            if (btn) btn.innerText = '👁️ Lihat Yang Dipilih Saja';
            updateSelectedUI();
            filterDeviceFiles();
        }

        function toggleOnlySelectedFilter() {
            isOnlySelectedFilter = !isOnlySelectedFilter;
            const btn = document.getElementById('btnOnlySelectedFilter');
            if (btn) btn.innerText = isOnlySelectedFilter ? '📋 Tampilkan Semua Kembali' : '👁️ Lihat Yang Dipilih Saja';
            filterDeviceFiles();
        }

        function updateSelectedUI() {
            const count = selectedFileIds.size;
            const bar = document.getElementById('floatingSelectionBar');

            let totalBytes = 0;
            currentDeviceFiles.forEach(f => {
                if (selectedFileIds.has(f.id)) totalBytes += (f.fileSize || 0);
            });
            let humanSize = totalBytes > 1048576 ? (totalBytes / 1048576).toFixed(1) + ' MB' : (totalBytes / 1024).toFixed(0) + ' KB';

            // Top action bar badge & button
            const topBadge = document.getElementById('selectedCountBadge');
            if (topBadge) topBadge.innerText = count;

            const topBtn = document.getElementById('btnBulkCopyTop');
            if (topBtn) {
                if (count > 0) {
                    topBtn.disabled = false;
                    topBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    topBtn.innerHTML = `<span>📥</span> <span>Salin ${count} Berkas ke PC (${humanSize})</span>`;
                } else {
                    topBtn.disabled = true;
                    topBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    topBtn.innerHTML = `<span>📥</span> <span>Salin Terpilih</span>`;
                }
            }

            const topDelBtn = document.getElementById('btnBulkDeleteTop');
            const delBadge = document.getElementById('bulkDeleteBadge');
            if (delBadge) delBadge.innerText = count;
            if (topDelBtn) {
                if (count > 0) {
                    topDelBtn.disabled = false;
                    topDelBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                } else {
                    topDelBtn.disabled = true;
                    topDelBtn.classList.add('opacity-50', 'cursor-not-allowed');
                }
            }

            // Sync top checkbox state
            const chkAll = document.getElementById('chkSelectAllFolder');
            if (chkAll) {
                const currentFiles = getFilteredFiles();
                chkAll.checked = currentFiles.length > 0 && currentFiles.every(f => selectedFileIds.has(f.id));
            }

            // Floating drawer
            if (count > 0) {
                if (bar) bar.classList.remove('hidden');
                const cntEl = document.getElementById('floatingSelectedCount');
                if (cntEl) cntEl.innerText = count;
                const sizeEl = document.getElementById('floatingTotalSize');
                if (sizeEl) sizeEl.innerText = humanSize;
            } else {
                if (bar) bar.classList.add('hidden');
            }
        }

        async function requestBulkCopySelected() {
            if (!currentDeviceId) return;
            if (selectedFileIds.size === 0) {
                alert('⚠️ Silakan centang/pilih minimal 1 foto terlebih dahulu.');
                return;
            }

            if (!confirm(`Salin ${selectedFileIds.size} berkas terpilih dari HP ke PC server?`)) return;

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/copy-files-bulk`, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ fileIds: Array.from(selectedFileIds) })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ ' + (data.message || 'Permintaan salin massal berhasil dikirim!'));
                    clearAllSelections();
                    loadCopyRequests();
                } else {
