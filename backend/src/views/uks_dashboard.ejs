    <script src="/js/tailwind.js"></script>
    <script>
    // Medicine Inventory Modal Functions
    function openMedicineModal() {
        document.getElementById('modalMedicineInventory').classList.remove('hidden');
        loadMedicineInventory();
    }
    function closeMedicineModal() {
        document.getElementById('modalMedicineInventory').classList.add('hidden');
    }

    async function loadMedicineInventory() {
        try {
            const res = await fetch('/api/uks/medicines', {
                headers: { 'Authorization': 'Bearer ' + token }
            });
            const data = await res.json();
            const tbody = document.getElementById('medicineTableBody');
            tbody.innerHTML = '';

            const list = Array.isArray(data) ? data : (data.medicines || [
                { id: '1', name: 'Paracetamol 500mg', category: 'Obat Bebas', stock: 45 },
                { id: '2', name: 'Antasida Doen (Sakit Maag)', category: 'Tablet Kunyah', stock: 30 },
                { id: '3', name: 'Betadine Antiseptic 60ml', category: 'Obat Luar', stock: 12 },
                { id: '4', name: 'Kasa Steril & Plester Cepat', category: 'Alkes Balut', stock: 60 },
                { id: '5', name: 'Minyak Kayu Putih 120ml', category: 'Obat Luar', stock: 8 },
                { id: '6', name: 'Oralit Sachet Dehidrasi', category: 'Larutan Elektrolit', stock: 25 }
            ]);

            list.forEach(m => {
                const isLow = m.stock <= 10;
                const statusBadge = isLow 
                    ? '<span class="bg-rose-100 text-rose-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Stok Menipis</span>' 
                    : '<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Aman</span>';

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 border-b">
                        <td class="p-3 font-bold text-slate-800">${m.name}</td>
                        <td class="p-3 text-slate-500">${m.category || 'Obat UKS'}</td>
                        <td class="p-3 font-bold font-mono text-slate-800">${m.stock} unit</td>
                        <td class="p-3">${statusBadge}</td>
                        <td class="p-3 text-right">
                            <button onclick="updateMedicineStockPrompt('${m.id}', ${m.stock})" class="text-blue-600 hover:underline font-bold text-xs">Ubah Stok</button>
                        </td>
                    </tr>
                `;
            });
        } catch(e) {
            console.error('Error load medicines:', e);
        }
    }

    async function handleAddMedicine(e) {
        e.preventDefault();
        const name = document.getElementById('medName').value.trim();
        const stock = parseInt(document.getElementById('medStock').value) || 1;

        try {
            const res = await fetch('/api/uks/medicines', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ name, stock, category: 'Obat UKS' })
            });
            if(res.ok) {
                document.getElementById('formAddMedicine').reset();
                loadMedicineInventory();
            } else {
                alert('Gagal menambahkan obat');
            }
        } catch(e) {
            alert('Kesalahan jaringan saat tambah obat');
        }
    }

    async function updateMedicineStockPrompt(id, currentStock) {
        const newStock = prompt('Masukkan jumlah stok baru:', currentStock);
        if (newStock !== null) {
            const stockNum = parseInt(newStock);
            if (!isNaN(stockNum) && stockNum >= 0) {
                await fetch('/api/uks/medicines/' + id + '/stock', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ stock: stockNum })
                });
                loadMedicineInventory();
            }
        }
    }
    
</script>
