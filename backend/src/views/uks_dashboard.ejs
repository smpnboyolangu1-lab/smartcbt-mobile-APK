    <!-- Core Scripts -->

    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/';

        // ==================== PORTAL DARK / LIGHT THEME ====================
        function updateThemeUI(isDark) {
            const icon1 = document.getElementById('themeToggleIcon');
            const icon2 = document.getElementById('floatingThemeIcon');
            if (icon1) icon1.innerText = isDark ? '☀️' : '🌙';
            if (icon2) icon2.innerText = isDark ? '☀️' : '🌙';
        }

        function togglePortalTheme() {
            const isDark = document.body.classList.toggle('dark-mode');
            localStorage.setItem('portal_theme', isDark ? 'dark' : 'light');
            updateThemeUI(isDark);
        }

        // Auto-apply saved theme on page load
        (function applySavedTheme() {
            const savedTheme = localStorage.getItem('portal_theme');
            const isDark = savedTheme === 'dark';
            if (isDark) {
                document.body.classList.add('dark-mode');
            }
            updateThemeUI(isDark);
        })();

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const floatingTheme = document.getElementById('floatingThemeToggleBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                if (floatingTheme) floatingTheme.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                if (floatingTheme) floatingTheme.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const floatingTheme = document.getElementById('floatingThemeToggleBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                if (floatingTheme) floatingTheme.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name || 'Petugas UKS';
            if(payload.name) {
                const initials = payload.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                document.getElementById('profileInitial').innerText = initials;
            }
        } catch(e) {}

        let allStudentsList = [];
        let currentVisitsList = [];
        let restingPatientsList = [];

        // Inisialisasi
        loadAllStudents();
        loadUksDashboardData();

        async function loadAllStudents() {
            try {
                const res = await fetch('/api/admin/users?role=STUDENT', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                allStudentsList = await res.json();
                if(Array.isArray(allStudentsList)) {
                    populateClassDropdowns();
                    filterVisitStudents();
                    filterAntroStudents();
                    filterUksHhStudents();
                    filterHealthStudents();
                }
            } catch(e) {
                console.error('Error load students:', e);
            }
        }

        function populateClassDropdowns() {
            const classSet = new Set();
            (allStudentsList || []).forEach(s => {
                if (s.className) classSet.add(s.className);
            });
            const classes = Array.from(classSet).sort();

            const classSelectIds = ['filterVisitClass', 'filterAntroClass', 'filterUksHhClass', 'filterHealthClass'];
            classSelectIds.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.innerHTML = '<option value="ALL">Semua Kelas</option>';
                    classes.forEach(c => {
                        el.innerHTML += `<option value="${c}">Kelas ${c}</option>`;
                    });
                }
            });
        }

        function filterVisitStudents() {
            const classFilter = document.getElementById('filterVisitClass')?.value || 'ALL';
            const query = (document.getElementById('searchVisitStudent')?.value || '').toLowerCase().trim();
            const select = document.getElementById('visitStudentSelect');
            if (!select) return;

            select.innerHTML = '<option value="">-- Pilih Siswa --</option>';
            let count = 0;
            (allStudentsList || []).forEach(s => {
                const matchClass = classFilter === 'ALL' || s.className === classFilter;
                const matchQuery = !query || 
                    (s.name && s.name.toLowerCase().includes(query)) || 
                    (s.username && s.username.toLowerCase().includes(query)) ||
                    (s.nisn && s.nisn.toLowerCase().includes(query));

                if (matchClass && matchQuery) {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = `${s.name} (${s.className || '-'} - ${s.username})`;
                    select.appendChild(opt);
                    count++;
                }
            });
            const countEl = document.getElementById('visitStudentCount');
            if (countEl) countEl.innerText = (query || classFilter !== 'ALL') ? `Ditemukan ${count} siswa` : `Menampilkan ${count} siswa`;
        }

        function filterAntroStudents() {
            const classFilter = document.getElementById('filterAntroClass')?.value || 'ALL';
            const query = (document.getElementById('searchAntroStudent')?.value || '').toLowerCase().trim();
            const select = document.getElementById('antroStudentSelect');
            if (!select) return;

            select.innerHTML = '<option value="">-- Pilih Siswa --</option>';
            let count = 0;
            (allStudentsList || []).forEach(s => {
                const matchClass = classFilter === 'ALL' || s.className === classFilter;
                const matchQuery = !query || 
                    (s.name && s.name.toLowerCase().includes(query)) || 
                    (s.username && s.username.toLowerCase().includes(query)) ||
                    (s.nisn && s.nisn.toLowerCase().includes(query));

                if (matchClass && matchQuery) {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = `${s.name} (${s.className || '-'})`;
                    select.appendChild(opt);
                    count++;
                }
            });
            const countEl = document.getElementById('antroStudentCount');
            if (countEl) countEl.innerText = (query || classFilter !== 'ALL') ? `Ditemukan ${count} siswa` : `Menampilkan ${count} siswa`;
        }

        function filterUksHhStudents() {
            const classFilter = document.getElementById('filterUksHhClass')?.value || 'ALL';
            const query = (document.getElementById('searchUksHhStudent')?.value || '').toLowerCase().trim();
            const select = document.getElementById('uksHhStudentSelect');
            if (!select) return;

            select.innerHTML = '<option value="">-- Pilih Siswa --</option>';
            let count = 0;
            (allStudentsList || []).forEach(s => {
                const matchClass = classFilter === 'ALL' || s.className === classFilter;
                const matchQuery = !query || 
                    (s.name && s.name.toLowerCase().includes(query)) || 
                    (s.username && s.username.toLowerCase().includes(query)) ||
                    (s.nisn && s.nisn.toLowerCase().includes(query));

                if (matchClass && matchQuery) {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = `${s.name} (${s.className || '-'} - ${s.username})`;
                    select.appendChild(opt);
                    count++;
                }
            });
            const countEl = document.getElementById('uksHhStudentCount');
            if (countEl) countEl.innerText = (query || classFilter !== 'ALL') ? `Ditemukan ${count} siswa` : `Menampilkan ${count} siswa`;
        }

        function filterHealthStudents() {
            const classFilter = document.getElementById('filterHealthClass')?.value || 'ALL';
            const query = (document.getElementById('searchHealthStudent')?.value || '').toLowerCase().trim();
            const select = document.getElementById('healthStudentSelect');
            if (!select) return;

            select.innerHTML = '<option value="">-- Pilih Siswa --</option>';
            let count = 0;
            (allStudentsList || []).forEach(s => {
                const matchClass = classFilter === 'ALL' || s.className === classFilter;
                const matchQuery = !query || 
                    (s.name && s.name.toLowerCase().includes(query)) || 
                    (s.username && s.username.toLowerCase().includes(query)) ||
                    (s.nisn && s.nisn.toLowerCase().includes(query));

                if (matchClass && matchQuery) {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = `${s.name} (${s.className || '-'} - ${s.username})`;
                    select.appendChild(opt);
                    count++;
                }
            });
            const countEl = document.getElementById('healthStudentCount');
            if (countEl) countEl.innerText = (query || classFilter !== 'ALL') ? `Ditemukan ${count} siswa` : `Menampilkan ${count} siswa`;
        }

        async function loadUksDashboardData() {
            try {
                // Fetch stats and live bed status
                const res = await fetch('/api/uks/stats', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if(data.success) {
                    document.getElementById('statTotalToday').innerText = data.totalVisitsToday || 0;
                    document.getElementById('statResting').innerText = data.occupiedBeds || 0;
                    document.getElementById('statBedsAvailable').innerText = `${data.availableBeds} / ${data.totalBeds}`;
                    document.getElementById('statSentHome').innerText = data.sentHomeCount || 0;

                    restingPatientsList = data.restingPatients || [];
                    currentVisitsList = data.todayVisits || [];

                    renderBedCards(restingPatientsList);
                    renderVisitsTable(currentVisitsList);
                } else {
                    // Fallback to /api/uks/visits
                    loadFallbackVisits();
                }

                // Update Incident Radar
                try {
                    const queueRes = await fetch('/api/uks/queue', { headers: { 'Authorization': 'Bearer ' + token } });
                    const qData = await queueRes.json();
                    if (qData.success && qData.stats) {
                        const inTr = document.getElementById('radarInTreatment');
                        const wPic = document.getElementById('radarWaitingPickup');
                        const nFoll = document.getElementById('radarNeedFollowup');
                        const ref = document.getElementById('radarReferred');
                        if (inTr) inTr.innerText = qData.stats.inTreatmentCount || 0;
                        if (wPic) wPic.innerText = qData.stats.waitingPickupCount || 0;
                        if (nFoll) nFoll.innerText = qData.stats.waitingQueueCount || 0;
                        if (ref) ref.innerText = qData.stats.referredCount || 0;
                    }
                } catch(qErr) {
                    console.warn('Radar fetch err:', qErr);
                }
            } catch(e) {
                console.error('Error fetching UKS stats, fallbacking:', e);
                loadFallbackVisits();
            }
        }

        // ==================== FULL SCREEN NOTIFICATION HELPERS ====================
        function showFullScreenNotif(options) {
            const { title, badge, icon, studentName, className, time, message, headerTheme, actionText, onAction } = options;
            
            const header = document.getElementById('fsNotifHeader');
            if (header) {
                if (headerTheme === 'EMERGENCY' || headerTheme === 'RED') {
                    header.className = 'px-6 py-6 bg-gradient-to-r from-red-600 to-rose-700 text-white space-y-1';
                } else if (headerTheme === 'PMR') {
                    header.className = 'px-6 py-6 bg-gradient-to-r from-rose-800 to-red-900 text-white space-y-1';
                } else if (headerTheme === 'UKS') {
                    header.className = 'px-6 py-6 bg-gradient-to-r from-emerald-600 to-teal-700 text-white space-y-1';
                } else if (headerTheme === 'WARNING') {
                    header.className = 'px-6 py-6 bg-gradient-to-r from-amber-500 to-orange-600 text-white space-y-1';
                }
            }

            if (title) document.getElementById('fsNotifTitle').innerText = title;
            if (badge) document.getElementById('fsNotifBadge').innerText = badge;
            if (icon) document.getElementById('fsNotifIcon').innerText = icon;
            if (studentName) document.getElementById('fsNotifStudentName').innerText = studentName;
            if (className) document.getElementById('fsNotifStudentClass').innerText = 'Kelas ' + className;
            if (time) document.getElementById('fsNotifTime').innerText = 'Waktu: ' + time;
            if (message) document.getElementById('fsNotifMessage').innerText = message;
            if (actionText) document.getElementById('fsNotifActionBtn').innerText = actionText;

            window._fsNotifAction = onAction || null;
            document.getElementById('modalFullScreenNotification').classList.remove('hidden');
        }

        function closeFullScreenNotif() {
            document.getElementById('modalFullScreenNotification').classList.add('hidden');
        }

        function confirmFullScreenAction() {
            if (typeof window._fsNotifAction === 'function') {
                window._fsNotifAction();
            } else {
                alert('Tindakan berhasil dikonfirmasi.');
                closeFullScreenNotif();
            }
        }

        function triggerEmergencyPickupPreview() {
            showFullScreenNotif({
                title: 'SISWA MEMBUTUHKAN PENJEMPUTAN',
                badge: 'NOTIFIKASI PENTING UKS',
                icon: '🏥',
                studentName: 'Ahmad Pratama',
                className: 'VII-A',
                time: 'Pukul ' + new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB',
                message: 'Kondisi kesehatan ananda memerlukan istirahat intensif di rumah. Mohon orang tua/wali dapat segera menjemput ke ruang UKS SMPN 1 Boyolangu.',
                headerTheme: 'EMERGENCY',
                actionText: '[ KONFIRMASI PENJEMPUTAN ]',
                onAction: () => {
                    alert('Status penjemputan berhasil dikonfirmasi. Sistem mengirimkan pengingat ke orang tua.');
                    closeFullScreenNotif();
                }
            });
        }

        function openDutyScheduleModal() {
            document.getElementById('modalDutySchedule').classList.remove('hidden');
        }

        function openPmrMembersModal() {
            alert('Menampilkan daftar anggota PMR Madya & Kader UKS SMPN 1 Boyolangu. Pengaturan dapat diakses oleh Pembina PMR.');
        }

        async function loadFallbackVisits() {
            try {
                const res = await fetch('/api/uks/visits', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                currentVisitsList = await res.json();
                if(Array.isArray(currentVisitsList)) {
                    restingPatientsList = currentVisitsList.filter(v => !v.checkOutTime);
                    document.getElementById('statTotalToday').innerText = currentVisitsList.length;
                    document.getElementById('statResting').innerText = restingPatientsList.length;
                    document.getElementById('statBedsAvailable').innerText = `${Math.max(0, 4 - restingPatientsList.length)} / 4`;
                    
                    renderBedCards(restingPatientsList);
                    renderVisitsTable(currentVisitsList);
                }
            } catch(err) {
                console.error('Failed to load UKS visits:', err);
            }
        }

        function renderBedCards(resting) {
            const container = document.getElementById('bedCardsContainer');
            container.innerHTML = '';

            for(let i = 1; i <= 4; i++) {
                const patient = resting[i - 1]; // jika ada pasien pada kasur ke-i
                if(patient) {
                    const s = patient.user || {};
                    const checkInTime = new Date(patient.checkInTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                    container.innerHTML += `
                        <div class="border-2 border-rose-400 bg-rose-50/50 p-4 rounded-2xl shadow-sm space-y-3 relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-xs text-rose-900 bg-rose-200/80 px-2 py-0.5 rounded-lg">KASUR #${i}</span>
                                <span class="text-[10px] font-bold bg-rose-600 text-white px-2 py-0.5 rounded-full animate-pulse">Terisi</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm truncate">${s.name || 'Siswa'}</h4>
                                <p class="text-xs text-slate-500 font-semibold">${s.className || '-'} | Masuk: ${checkInTime}</p>
                            </div>
                            <div class="bg-white p-2.5 rounded-xl border border-rose-200 text-xs">
                                <p class="text-[11px] text-slate-400 font-bold">Keluhan:</p>
                                <p class="text-rose-700 font-medium truncate">${patient.complaint || '-'}</p>
                            </div>
                            <button onclick="openCheckoutModal('${patient.id}', '${escape(s.name || 'Siswa')}', '${escape(patient.complaint || '-')}', '${checkInTime}')" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-xl text-xs font-bold shadow flex items-center justify-center gap-1 transition-all">
                                <span>✅</span> Selesai / Checkout
                            </button>
                        </div>
                    `;
                } else {
                    container.innerHTML += `
                        <div class="border-2 border-dashed border-slate-200 bg-slate-50/50 p-4 rounded-2xl flex flex-col justify-between space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-xs text-slate-500 bg-slate-200/70 px-2 py-0.5 rounded-lg">KASUR #${i}</span>
                                <span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">Kosong</span>
                            </div>
                            <div class="text-center py-4">
                                <div class="text-3xl mb-1">🛏️</div>
                                <p class="text-xs font-bold text-slate-600">Siap Digunakan</p>
                                <p class="text-[10px] text-slate-400">Kasur bersih & steril</p>
                            </div>
                            <button onclick="openAddPatientModal()" class="w-full border border-slate-300 hover:bg-slate-100 text-slate-700 py-1.5 rounded-xl text-xs font-bold transition-all">
                                + Masukkan Pasien
                            </button>
                        </div>
                    `;
                }
            }
        }

        function renderVisitsTable(visits) {
            const tbody = document.getElementById('uksVisitsTableBody');
            tbody.innerHTML = '';

            if(!Array.isArray(visits) || visits.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400">Belum ada catatan kunjungan medis hari ini</td></tr>';
                return;
            }

            visits.forEach(v => {
                const s = v.user || {};
                const checkInDate = new Date(v.checkInTime).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' });
                const isResting = !v.checkOutTime;

                let statusBadge = isResting 
                    ? '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-bold text-[11px]">🛌 Sedang Dirawat</span>'
                    : '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold text-[11px]">✅ Selesai</span>';

                const blood = s.bloodType ? `<span class="bg-rose-100 text-rose-800 font-bold px-1.5 py-0.5 rounded text-[10px]">Gol: ${s.bloodType}</span>` : '<span class="text-slate-400 text-[10px]">Gol: -</span>';
                const allergy = s.allergies ? `<span class="bg-amber-100 text-amber-800 font-semibold px-1.5 py-0.5 rounded text-[10px]" title="${s.allergies}">⚠️ Alergi</span>` : '';

                let actionBtn = '-';
                if(isResting) {
                    actionBtn = `
                        <button onclick="openCheckoutModal('${v.id}', '${escape(s.name || 'Siswa')}', '${escape(v.complaint || '-')}', '${checkInDate}')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1 rounded-lg text-xs font-bold shadow transition-all">
                            Checkout
                        </button>
                    `;
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-rose-50/30 transition-colors">
                        <td class="p-3.5 font-mono text-slate-500 font-medium">${checkInDate}</td>
                        <td class="p-3.5">
                            <span class="font-bold text-slate-800">${s.name || '-'}</span>
                            <button type="button" onclick="openHealthHistoryModalUKS('${s.id}')" class="block text-indigo-600 hover:text-indigo-800 font-bold text-[10px] mt-0.5 underline">
                                📜 Rekam Medis
                            </button>
                        </td>
                        <td class="p-3.5"><span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-bold">${s.className || '-'}</span></td>

                        <td class="p-3.5 font-bold text-rose-700">${v.complaint}</td>
                        <td class="p-3.5 text-slate-600">${v.treatment || '-'} ${v.medicine ? '<span class="text-blue-700 font-semibold">(Obat: ' + v.medicine + ')</span>' : ''}</td>
                        <td class="p-3.5 space-x-1">${blood} ${allergy}</td>
                        <td class="p-3.5">${statusBadge}</td>
                        <td class="p-3.5 text-right">${actionBtn}</td>
                    </tr>
                `;
            });
        }

        function filterVisitsTable() {
            const q = document.getElementById('filterPatientSearch').value.toLowerCase();
            const disp = document.getElementById('filterDisposition').value;

            let filtered = currentVisitsList.filter(v => {
                const s = v.user || {};
                const matchQuery = (s.name && s.name.toLowerCase().includes(q)) || 
                                   (s.className && s.className.toLowerCase().includes(q)) ||
                                   (v.complaint && v.complaint.toLowerCase().includes(q));
                
                let matchDisp = true;
                if(disp === 'RESTING') matchDisp = !v.checkOutTime;
                if(disp === 'DONE') matchDisp = !!v.checkOutTime;

                return matchQuery && matchDisp;
            });

            renderVisitsTable(filtered);
        }

        // Modal handlers
        function openAddPatientModal() {
            const searchInput = document.getElementById('searchVisitStudent');
            if(searchInput) searchInput.value = '';
            const classFilter = document.getElementById('filterVisitClass');
            if(classFilter) classFilter.value = 'ALL';
            filterVisitStudents();
            document.getElementById('modalAddVisit').classList.remove('hidden');
        }
        function closeAddPatientModal() {
            document.getElementById('modalAddVisit').classList.add('hidden');
            document.getElementById('formAddVisit').reset();
            const div = document.getElementById('faintingDetailsDiv');
            if(div) div.classList.add('hidden');
        }

        function toggleFaintingFields() {
            const isFainting = document.getElementById('visitIsFainting').checked;
            const div = document.getElementById('faintingDetailsDiv');
            if(isFainting) div.classList.remove('hidden');
            else div.classList.add('hidden');
        }

        async function handleCreateVisit(e) {
            e.preventDefault();
            const isFainting = document.getElementById('visitIsFainting')?.checked || false;
            const payload = {
                studentId: document.getElementById('visitStudentSelect').value,
                complaint: document.getElementById('visitComplaint').value,
                treatment: document.getElementById('visitTreatment').value,
                medicine: document.getElementById('visitMedicine').value,
                disposition: document.getElementById('visitDisposition').value,
                isFainting: isFainting,
                faintingLocation: isFainting ? document.getElementById('visitFaintingLocation').value : null,
                bedNumber: parseInt(document.getElementById('visitBedNumber')?.value) || null
            };

            try {
                const res = await fetch('/api/uks/visits', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(res.ok) {
                    alert(data.message || 'Catatan pemeriksaan UKS berhasil disimpan');
                    closeAddPatientModal();
                    loadUksDashboardData();
                } else {
                    alert(data.message || 'Gagal menyimpan rekam medis UKS');
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        // --- ANTROPOMETRI (BB & TB) HANDLERS ---
        function openAntropometriModal() {
            const searchInput = document.getElementById('searchAntroStudent');
            if(searchInput) searchInput.value = '';
            const classFilter = document.getElementById('filterAntroClass');
            if(classFilter) classFilter.value = 'ALL';
            filterAntroStudents();
            document.getElementById('modalAntropometri').classList.remove('hidden');
        }

        function closeAntropometriModal() {
            document.getElementById('modalAntropometri').classList.add('hidden');
            document.getElementById('formAntropometri').reset();
            document.getElementById('previewBmiVal').innerText = '-';
            document.getElementById('previewBmiStatus').innerText = 'Belum dihitung';
            document.getElementById('previewBmiStatus').className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-teal-200 text-teal-900';
        }

        function calculateBmiPreview() {
            const h = parseFloat(document.getElementById('antroHeight').value);
            const w = parseFloat(document.getElementById('antroWeight').value);
            if(h > 0 && w > 0) {
                const heightM = h / 100;
                const bmi = +(w / (heightM * heightM)).toFixed(1);
                document.getElementById('previewBmiVal').innerText = bmi;
                let status = 'Normal';
                let colorClass = 'bg-emerald-100 text-emerald-800';
                if(bmi < 18.5) { status = 'Kurus / Kurang BB'; colorClass = 'bg-amber-100 text-amber-800'; }
                else if(bmi <= 25) { status = 'Ideal / Normal'; colorClass = 'bg-emerald-100 text-emerald-800'; }
                else if(bmi <= 29.9) { status = 'Kelebihan BB (Gemuk)'; colorClass = 'bg-orange-100 text-orange-800'; }
                else { status = 'Obesitas'; colorClass = 'bg-red-100 text-red-800 font-black'; }

                const badge = document.getElementById('previewBmiStatus');
                badge.innerText = status;
                badge.className = `text-xs font-bold px-2 py-0.5 rounded-full ${colorClass}`;
            }
        }

        async function handleAntropometriSubmit(e) {
            e.preventDefault();
            const studentId = document.getElementById('antroStudentSelect').value;
            const height = parseFloat(document.getElementById('antroHeight').value);
            const weight = parseFloat(document.getElementById('antroWeight').value);
            const semester = document.getElementById('antroSemester').value;
            const notes = document.getElementById('antroNotes').value;

            try {
                const res = await fetch('/api/uks/measurements', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ studentId, height, weight, semester, notes })
                });
                const data = await res.json();
                if(res.ok) {
                    alert('✅ ' + data.message);
                    closeAntropometriModal();
                    loadUksDashboardData();
                } else {
                    alert(data.message || 'Gagal menyimpan pengukuran');
                }
            } catch(e) { alert('Terjadi kesalahan jaringan'); }
        }

        function openCheckoutModal(id, studentName, complaint, checkInTime) {
            document.getElementById('checkoutVisitId').value = id;
            document.getElementById('checkoutStudentName').innerText = unescape(studentName);
            document.getElementById('checkoutComplaint').innerText = unescape(complaint);
            document.getElementById('checkoutCheckInTime').innerText = checkInTime;
            document.getElementById('modalCheckoutVisit').classList.remove('hidden');
        }
        function closeCheckoutModal() {
            document.getElementById('modalCheckoutVisit').classList.add('hidden');
            document.getElementById('formCheckoutVisit').reset();
        }

        async function handleCheckoutSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('checkoutVisitId').value;
            const payload = {
                disposition: document.getElementById('checkoutDisposition').value,
                note: document.getElementById('checkoutNote').value
            };

            try {
                const res = await fetch(`/api/uks/visits/${id}/checkout`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(res.ok) {
                    alert(data.message || 'Siswa telah berhasil checkout dari UKS');
                    closeCheckoutModal();
                    loadUksDashboardData();
                } else {
                    alert(data.message || 'Gagal memproses checkout UKS');
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        function openHealthProfileModal() {
            const searchInput = document.getElementById('searchHealthStudent');
            if(searchInput) searchInput.value = '';
            const classFilter = document.getElementById('filterHealthClass');
            if(classFilter) classFilter.value = 'ALL';
            filterHealthStudents();
            document.getElementById('modalHealthProfile').classList.remove('hidden');
        }
        function closeHealthProfileModal() {
            document.getElementById('modalHealthProfile').classList.add('hidden');
            document.getElementById('formHealthProfile').reset();
        }

        function onSelectHealthStudent() {
            const studentId = document.getElementById('healthStudentSelect').value;
            const student = allStudentsList.find(s => s.id === studentId);
            if(student) {
                document.getElementById('healthBloodType').value = student.bloodType || '';
                document.getElementById('healthParentPhone').value = student.parentPhone || '-';
                document.getElementById('healthAllergies').value = student.allergies || '';
            }
        }

        async function handleHealthProfileSubmit(e) {
            e.preventDefault();
            const studentId = document.getElementById('healthStudentSelect').value;
            if(!studentId) return;

            const payload = {
                bloodType: document.getElementById('healthBloodType').value,
                allergies: document.getElementById('healthAllergies').value
            };

            try {
                const res = await fetch(`/api/students/${studentId}/health`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(res.ok) {
                    alert('Data profil kesehatan & alergi siswa berhasil diperbarui');
                    closeHealthProfileModal();
                    loadAllStudents();
                    loadUksDashboardData();
                } else {
                    alert(data.message || 'Gagal memperbarui data kesehatan');
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        function openHealthHistoryModalUKS(studentId) {
            const modal = document.getElementById('modalStudentHealthHistoryUKS');
            if(modal) modal.classList.remove('hidden');

            const searchInput = document.getElementById('searchUksHhStudent');
            if(searchInput) searchInput.value = '';
            const classFilter = document.getElementById('filterUksHhClass');
            if(classFilter) classFilter.value = 'ALL';
            filterUksHhStudents();

            const sel = document.getElementById('uksHhStudentSelect');
            if(studentId) {
                if(sel) sel.value = studentId;
                loadStudentHealthHistoryDataUKS(studentId);
            }
        }

        function closeHealthHistoryModalUKS() {
            const modal = document.getElementById('modalStudentHealthHistoryUKS');
            if(modal) modal.classList.add('hidden');
        }

        function onSelectUksHhStudent() {
            const sel = document.getElementById('uksHhStudentSelect');
            if(sel && sel.value) {
                loadStudentHealthHistoryDataUKS(sel.value);
            }
        }

        async function loadStudentHealthHistoryDataUKS(studentId) {
            try {
                const res = await fetch(`/api/students/${studentId}/health-history`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if(data && data.success && data.student) {
                    const st = data.student;
                    document.getElementById('uksHhTitle').innerText = `Rekam Medis: ${st.name} (${st.className || '-'})`;
                    document.getElementById('uksHhBloodType').innerText = st.bloodType ? `Golongan ${st.bloodType}` : 'Belum Ada';
                    document.getElementById('uksHhTotalSick').innerText = `${st.totalSickDays || 0} Hari`;
                    document.getElementById('uksHhParentPhone').innerText = st.parentPhone || 'Belum Terdaftar';
                    document.getElementById('uksHhAllergies').innerText = st.allergies || 'Tidak ada catatan alergi khusus';
                    
                    const faintingElem = document.getElementById('uksHhFaintingCount');
                    if(faintingElem) faintingElem.innerText = `${st.faintingCount || 0} Kali`;

                    const antroElem = document.getElementById('uksHhAntroLatest');
                    if(antroElem) {
                        if(st.height && st.weight) {
                            antroElem.innerText = `${st.height}cm / ${st.weight}kg (${st.bmiStatus || 'Normal'})`;
                        } else {
                            antroElem.innerText = 'Belum Diukur';
                        }
                    }

                    const tbody = document.getElementById('uksHhVisitsTableBody');
                    tbody.innerHTML = '';
                    if(Array.isArray(data.visits) && data.visits.length > 0) {
                        data.visits.forEach(v => {
                            const inTime = new Date(v.checkInTime).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' });
                            const outTime = v.checkOutTime ? new Date(v.checkOutTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '<span class="text-amber-600 font-bold">Sedang Dirawat</span>';
                            tbody.innerHTML += `
                                <tr class="hover:bg-rose-50/40 border-b">
                                    <td class="p-2.5 font-mono text-slate-600">${inTime}</td>
                                    <td class="p-2.5 font-bold text-slate-800">${v.complaint}</td>
                                    <td class="p-2.5 text-slate-600">${v.treatment || '-'}${v.medicine ? '<br><b class="text-indigo-700">Obat: ' + v.medicine + '</b>' : ''}</td>
                                    <td class="p-2.5 font-mono">${outTime}</td>
                                </tr>
                            `;
                        });
                    } else {
                        tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-slate-400">Belum ada riwayat kunjungan UKS untuk siswa ini</td></tr>';
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

    </script>

    <!-- MODAL INVENTARIS OBAT & ALKES UKS -->
    <div id="modalMedicineInventory" class="hidden fixed inset-0 bg-slate-950/75 backdrop-blur-md flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl w-full max-w-3xl max-h-[92vh] shadow-2xl border border-slate-200 flex flex-col overflow-hidden animate-fade-in">
            <div class="px-6 py-4 bg-gradient-to-r from-emerald-800 to-teal-900 text-white flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">💊</span>
                    <div>
                        <h3 class="font-extrabold text-base">Inventaris Obat &amp; Alat Kesehatan UKS</h3>
                        <p class="text-xs text-emerald-200">Manajemen stok obat, tanggal kedaluwarsa, dan pencatatan pemakaian</p>
                    </div>
                </div>
                <button onclick="closeMedicineModal()" class="text-white/80 hover:text-white text-2xl font-bold">&times;</button>
            </div>

            <div class="p-6 overflow-y-auto space-y-4 text-xs">
                <!-- Add Medicine Form -->
                <form id="formAddMedicine" onsubmit="handleAddMedicine(event)" class="p-4 bg-emerald-50/60 rounded-2xl border border-emerald-200 grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
                    <div class="sm:col-span-2">
                        <label class="block font-bold text-emerald-950 mb-1">Nama Obat / Alkes *</label>
                        <input type="text" id="medName" placeholder="Cth: Paracetamol 500mg, Betadine" class="w-full border border-emerald-300 p-2 rounded-xl text-xs bg-white" required>
                    </div>
                    <div>
                        <label class="block font-bold text-emerald-950 mb-1">Jumlah Stok *</label>
                        <input type="number" id="medStock" placeholder="Cth: 50" min="1" class="w-full border border-emerald-300 p-2 rounded-xl text-xs bg-white" required>
                    </div>
                    <div>
                        <button type="submit" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow">
                            + Tambah Obat
                        </button>
                    </div>
                </form>

                <!-- Medicine Table -->
                <div class="border rounded-2xl overflow-hidden">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 font-bold border-b">
                                <th class="p-3">Nama Obat / Alkes</th>
                                <th class="p-3">Kategori</th>
                                <th class="p-3">Stok Tersedia</th>
                                <th class="p-3">Status</th>
                                <th class="p-3 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="medicineTableBody" class="divide-y">
                            <tr><td colspan="5" class="p-4 text-center text-slate-400">Memuat data obat...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="px-6 py-3 bg-slate-50 border-t flex justify-end">
                <button type="button" onclick="closeMedicineModal()" class="px-5 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-xs">Tutup</button>
            </div>
        </div>
    </div>
    
</body>
</html>
