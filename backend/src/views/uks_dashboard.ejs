                                <span>👨‍🎓</span> 1. Pilih Siswa Pasien
                            </span>
                            <span id="visitStudentCount" class="text-[10px] bg-blue-100 text-blue-800 font-bold px-2 py-0.5 rounded-full">0 Siswa</span>
                        </div>

                        <!-- Filter Kelas & Search -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Filter Kelas</label>
