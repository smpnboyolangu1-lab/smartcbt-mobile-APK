        function renderTahfizProgressMatrix(students, surahs, progressMap) {
            const headRow = document.getElementById('tahfizMatrixHeadRow');
            const tbody = document.getElementById('tahfizMatrixBody');
            if (!headRow || !tbody) return;

            // Render Head Row with 37 Surahs
            headRow.innerHTML = `
                <th class="p-3 sticky left-0 bg-slate-100 z-20 w-48 min-w-[190px] border-r">Nama Santri</th>
                <th class="p-3 text-center min-w-[80px]">Tuntas</th>
                ${surahs.map(s => `
                    <th class="p-2 text-center text-[10px] whitespace-nowrap min-w-[60px]" title="${s.number}. ${s.nameLatin} (${s.nameArabic}) - ${s.ayatCount} Ayat">
                        <span class="block font-mono text-[9px] text-gray-400">#${s.number}</span>
                        <span>${s.nameLatin}</span>
                    </th>
                `).join('')}
            `;

            if (students.length === 0) {
                tbody.innerHTML = '<tr><td colspan="40" class="p-8 text-center text-slate-400">Belum ada siswa pada kelas ini.</td></tr>';
                return;
            }

            tbody.innerHTML = students.map(st => {
                const studentRecords = progressMap[st.id] || {};
                let completedCount = 0;

                const cells = surahs.map(s => {
                    const rec = studentRecords[s.number];
                    let bg = 'bg-slate-100 text-slate-400';
                    let label = '⚪';
                    let title = `${s.nameLatin}: Belum Dimulai`;

                    if (rec) {
                        const status = (rec.status_hafalan || '').toUpperCase();
                        if (status === 'LULUS_SETORAN' || status === 'TUNTAS_TARGET') {
                            bg = 'bg-emerald-500 text-white font-bold';
                            label = `${rec.nilai_akhir || '✓'}`;
                            title = `${s.nameLatin}: Lulus Setoran (Skor: ${rec.nilai_akhir || '-'})`;
                            completedCount++;
                        } else if (status === 'SEDANG_DIHAFAL') {
                            bg = 'bg-blue-500 text-white font-bold';
                            label = '🔵';
                            title = `${s.nameLatin}: Sedang Menghafal`;
                        } else if (status === 'SIAP_DISETORKAN') {
                            bg = 'bg-amber-400 text-slate-900 font-bold';
                            label = '⏳';
                            title = `${s.nameLatin}: Menunggu Penilaian Guru`;
                        } else if (status === 'PERLU_MUROJAAH') {
                            bg = 'bg-purple-500 text-white font-bold';
                            label = '🔁';
                            title = `${s.nameLatin}: Perlu Murojaah Pengulangan`;
                        }
                    }

                    return `
                        <td class="p-1.5 text-center">
                            <button onclick="openTahfizPenilaianModal(null, '${st.id}', '${st.name.replace(/'/g, "\\'")}', ${s.number}, '${s.nameLatin.replace(/'/g, "\\'")}', 1, ${s.ayatCount})" class="w-8 h-8 rounded-lg ${bg} text-[10px] shadow-xs flex items-center justify-center mx-auto transition-transform hover:scale-110 cursor-pointer" title="${title}">
                                ${label}
                            </button>
                        </td>
                    `;
                }).join('');

                const pct = Math.round((completedCount / (surahs.length || 37)) * 100);

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-3 sticky left-0 bg-white z-10 border-r font-bold text-slate-800 truncate">${st.name}</td>
                        <td class="p-3 text-center">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-black ${pct >= 50 ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700'}">
                                ${completedCount}/37 (${pct}%)
                            </span>
                        </td>
                        ${cells}
                    </tr>
                `;
            }).join('');
        }

