        async function loadPaiClassMonitoring() {
            if (!document.getElementById('selectPaiClassFilter')?.children?.length) {
                populatePaiClassesDropdown();
            }
            const selectClass = document.getElementById('selectPaiClassFilter');
            const dateInput = document.getElementById('inputPaiDateFilter');
            const monTypeSelect = document.getElementById('selectPaiMonitoringPrayerType');
            const className = selectClass?.value || 'VII-A';
            const targetDate = dateInput?.value || new Date().toISOString().substring(0, 10);
            const prayerType = monTypeSelect?.value || currentPaiPrayerSchedule?.prayerType || 'DHUHUR';

            const tbody = document.getElementById('paiStudentsTableBody');
            if (tbody) {
                tbody.innerHTML = `<tr><td colspan="10" class="p-8 text-center text-slate-500 font-medium">⏳ Memuat presensi Sholat ${prayerType} Kelas ${className}...</td></tr>`;
            }

            try {
                const res = await authFetch(`/api/prayer/monitoring-by-class?className=${encodeURIComponent(className)}&date=${targetDate}&prayerType=${encodeURIComponent(prayerType)}`);
                const data = await res.json();
                if (data.success) {
                    currentPaiPrayerStudents = data.students || [];
                    const sum = data.summary || {};
                    const totalSt = sum.totalStudents || currentPaiPrayerStudents.length;
                    const sholatPct = sum.sholatPercent !== undefined ? sum.sholatPercent : (totalSt > 0 ? ((sum.sholatCount || 0) * 100 / totalSt).toFixed(1) : '0');
                    const keputrianPct = sum.keputrianPercent !== undefined ? sum.keputrianPercent : (totalSt > 0 ? ((sum.keputrianCount || 0) * 100 / totalSt).toFixed(1) : '0');
                    const haidPct = sum.haidPercent !== undefined ? sum.haidPercent : (totalSt > 0 ? ((sum.haidCount || 0) * 100 / totalSt).toFixed(1) : '0');
                    const belumPct = sum.belumPercent !== undefined ? sum.belumPercent : (totalSt > 0 ? ((sum.belumCount || 0) * 100 / totalSt).toFixed(1) : '0');

                    if (document.getElementById('paiStatTotal')) document.getElementById('paiStatTotal').innerText = totalSt;
                    if (document.getElementById('paiStatSholat')) document.getElementById('paiStatSholat').innerHTML = `${sum.sholatCount || 0} <span class="text-xs font-bold text-emerald-600 block sm:inline">(${sholatPct}%)</span>`;
                    if (document.getElementById('paiStatKeputrian')) document.getElementById('paiStatKeputrian').innerHTML = `${sum.keputrianCount || 0} <span class="text-xs font-bold text-pink-600 block sm:inline">(${keputrianPct}%)</span>`;
                    if (document.getElementById('paiStatHaid')) document.getElementById('paiStatHaid').innerHTML = `${sum.haidCount || 0} <span class="text-xs font-bold text-rose-600 block sm:inline">(${haidPct}%)</span>`;
                    if (document.getElementById('paiStatBelum')) document.getElementById('paiStatBelum').innerHTML = `${sum.belumCount || 0} <span class="text-xs font-bold text-amber-600 block sm:inline">(${belumPct}%)</span>`;

                    renderPaiStudentsTable(currentPaiPrayerStudents);
                } else {
                    if (tbody) {
                        tbody.innerHTML = `<tr><td colspan="10" class="p-8 text-center text-rose-500">Gagal: ${data.message || 'Terjadi kesalahan'}</td></tr>`;
                    }
                }
            } catch (err) {
                if (tbody) {
                    tbody.innerHTML = `<tr><td colspan="10" class="p-8 text-center text-rose-500">Koneksi terputus: ${err.message}</td></tr>`;
                }
            }
        }

        function renderPaiStudentsTable(students) {
            const tbody = document.getElementById('paiStudentsTableBody');
            if (!tbody) return;

            // Terapkan filter status pill & search
            const query = (document.getElementById('searchPaiStudentInput')?.value || '').toLowerCase().trim();
            const filtered = (students || []).filter(s => {
                const st = (s.prayerStatus || 'BELUM_PRESENSI').toUpperCase();
                let matchPill = true;
                if (activePaiFilterPill === 'SHOLAT') matchPill = (st === 'SHOLAT_BERJAMAAH');
                else if (activePaiFilterPill === 'HAID') matchPill = (st === 'BERHALANGAN_HAID');
                else if (activePaiFilterPill === 'BELUM') matchPill = (st === 'BELUM_PRESENSI');

                const matchQuery = !query || 
                    (s.name && s.name.toLowerCase().includes(query)) ||
                    (s.nisn && s.nisn.toLowerCase().includes(query));

                return matchPill && matchQuery;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-slate-400 font-medium">Tidak ada data siswa yang cocok dengan filter.</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map((s, idx) => {
                const isFemale = s.isFemale || (s.gender || '').toUpperCase().startsWith('P');
                const st = (s.prayerStatus || 'BELUM_PRESENSI').toUpperCase();

                let statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200">⚠️ Belum Sholat</span>';
                if (st === 'SHOLAT_BERJAMAAH') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">🕌 Sudah Sholat</span>';
                } else if (st === 'HADIR_KEPUTRIAN') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-pink-100 text-pink-800 border border-pink-200">🌸 Hadir Keputrian</span>';
                } else if (st === 'BERHALANGAN_HAID') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">🩸 Berhalangan (Haid)</span>';
                }

                let timeStr = '-';
                if (s.recordedAt) {
                    try {
                        timeStr = new Date(s.recordedAt).toTimeString().substring(0, 5) + ' WIB';
                    } catch(e) {}
                }

                const methodStr = s.method === 'BARCODE_KEPUTRIAN'
                    ? '<span class="text-pink-700 font-bold">🌸 Barcode Keputrian</span>'
                    : (s.method === 'STATIC_BARCODE' 
                        ? '<span class="text-emerald-700 font-bold">📲 Scan Mandiri</span>' 
                        : (s.method === 'MANUAL_PAI' ? '<span class="text-indigo-700 font-bold">✍️ Guru PAI</span>' : '<span class="text-slate-400">-</span>'));

                let geoCell = '<span class="text-slate-400 text-[11px]">-</span>';
                if (s.gps || (s.lat && s.lng)) {
                    const latVal = s.lat || (s.gps ? s.gps.split(',')[0].trim() : null);
                    const lngVal = s.lng || (s.gps ? s.gps.split(',')[1].trim() : null);
                    if (latVal && lngVal) {
                        geoCell = `
                            <div class="flex flex-col items-center gap-0.5">
                                <span class="font-mono text-[10px] text-blue-700 font-bold">${Number(latVal).toFixed(5)}, ${Number(lngVal).toFixed(5)}</span>
                                <a href="https://www.google.com/maps?q=${latVal},${lngVal}" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-blue-600 hover:text-blue-800 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200">
                                    📍 Maps ↗
                                </a>
                            </div>
                        `;
                    }
                }

                const femaleBtns = isFemale ? `
                    <button onclick="handlePaiMarkStudent('${s.id}', 'HADIR_KEPUTRIAN', 'Hadir Keputrian')" class="px-2 py-1 bg-pink-600 hover:bg-pink-700 text-white rounded-lg font-bold text-[10px] shadow transition-colors cursor-pointer" title="Tandai Hadir Kegiatan Keputrian">
                        🌸 Keputrian
                    </button>
                    <button onclick="handlePaiMarkStudent('${s.id}', 'BERHALANGAN_HAID', 'Keputrian Haid')" class="px-2 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-bold text-[10px] shadow transition-colors cursor-pointer" title="Izin Berhalangan Syar'i (Haid)">
                        🩸 Haid
                    </button>
                ` : '';

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-3.5 text-center font-bold text-slate-500">${idx + 1}</td>
                        <td class="p-3.5">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-full ${isFemale ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'} font-black flex items-center justify-center text-xs flex-shrink-0">
                                    ${(s.name || 'S').charAt(0)}
                                </div>
                                <span class="font-bold text-slate-900 text-xs">${s.name}</span>
                            </div>
                        </td>
                        <td class="p-3.5 font-mono text-slate-600 font-bold text-xs">${s.nisn || '-'}</td>
                        <td class="p-3.5 text-center font-semibold ${isFemale ? 'text-rose-600' : 'text-blue-600'}">${isFemale ? 'Perempuan' : 'Laki-laki'}</td>
                        <td class="p-3.5 text-center font-bold text-slate-700">${s.className || '-'}</td>
                        <td class="p-3.5 text-center">${statusBadge}</td>
                        <td class="p-3.5 text-center font-mono text-xs font-semibold text-slate-600">${timeStr}</td>
                        <td class="p-3.5 text-center text-xs">${methodStr}</td>
                        <td class="p-3.5 text-center">${geoCell}</td>
                        <td class="p-3.5 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <button onclick="handlePaiMarkStudent('${s.id}', 'SHOLAT_BERJAMAAH', 'Hadir Sholat')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-[10px] shadow transition-colors cursor-pointer" title="Tandai Sudah Sholat Berjamaah">
                                    ✅ Sholat
                                </button>
                                ${femaleBtns}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function setPaiStatusPill(pill) {
            activePaiFilterPill = pill;
            const pills = ['ALL', 'SHOLAT', 'HAID', 'BELUM'];
            pills.forEach(p => {
                const el = document.getElementById('pillPai' + p.charAt(0) + p.slice(1).toLowerCase());
