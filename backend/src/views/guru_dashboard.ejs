        async function handleCreateHomeworkTeacher(e) {
            e.preventDefault();
            const title = document.getElementById('chHwTitle').value.trim();
            const subjectName = document.getElementById('chHwSubject').value.trim();
            const className = document.getElementById('chHwClass').value;
            const description = document.getElementById('chHwDescription').value.trim();
            const deadlineVal = document.getElementById('chHwDeadline').value;
            const deadline = deadlineVal ? new Date(deadlineVal).toISOString() : new Date(Date.now() + 86400000 * 3).toISOString();

            if (currentHwMode === 'CBT_LIGHT') {
                if (cbtLightQuestions.length === 0) {
                    alert('Harap tambahkan minimal 1 butir soal untuk Mode Kuis CBT-Light!');
                    return;
                }
                for (let i = 0; i < cbtLightQuestions.length; i++) {
                    if (!cbtLightQuestions[i].question || !cbtLightQuestions[i].question.trim()) {
                        alert(`Soal #${i + 1} belum memiliki teks pertanyaan!`);
                        return;
                    }
                }
            }

            const btn = document.getElementById('btnSubmitCreateHw');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            try {
                const payload = {
                    title,
                    subjectName,
                    className,
                    description,
                    deadline,
                    category: 'TUGAS_HARIAN',
                    type: currentHwMode === 'CBT_LIGHT' ? 'CBT_LIGHT' : 'STANDARD',
                    questions: currentHwMode === 'CBT_LIGHT' ? cbtLightQuestions : null
                };

                const res = await fetch('/api/homeworks', {
                    method: 'POST',
