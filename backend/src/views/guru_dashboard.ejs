        function switchTab(tabId) {
            // Auto-close mobile sidebar when clicking a tab on small screens
            if (window.innerWidth < 768) {
                document.body.classList.remove('sidebar-mobile-open');
                const backdrop = document.getElementById('portalSidebarBackdrop');
                if (backdrop) backdrop.classList.add('hidden');
                const expandBtn = document.getElementById('sidebarExpandBtn');
                if (expandBtn) expandBtn.classList.remove('hidden');
            }

            const tabs = ['jadwal', 'soal', 'tugas', 'jurnal', 'broadcast', 'ulangan-harian', 'izin', 'izin-guru', 'walikelas', 'sholat', 'pengawas', 'tahfiz', 'tpp'];
            tabs.forEach(t => {
                const nav = document.getElementById('nav-' + t);
                const sec = document.getElementById('section-' + t);
                if (nav && sec) {
                    if (t === tabId) {
                        nav.classList.add('active');
                        sec.classList.remove('hidden');
                    } else {
                        nav.classList.remove('active');
                        sec.classList.add('hidden');
                    }
                }
            });

            const headerInfo = tabHeaders[tabId] || tabHeaders['jadwal'];
            document.getElementById('pageTitle').innerHTML = `<span>${headerInfo.icon}</span> ${headerInfo.title}`;
            document.getElementById('pageSubtitle').innerText = headerInfo.sub;

            if (tabId === 'tpp') {
                loadTeacherTppData();
            } else if (tabId === 'izin') {
                loadLeaveRequestsTeacher();
            } else if (tabId === 'izin-guru') {
                loadMyTeacherLeaves();
            } else if (tabId === 'walikelas') {
                loadHomeroomStudentsWeb();
            } else if (tabId === 'sholat') {
                loadPaiPrayerWeb();
            } else if (tabId === 'tahfiz') {
                loadTahfizWeb();
            } else if (tabId === 'pengawas') {
                loadProctorDashboardWeb();
                if (!proctorAutoPollInterval) {
                    proctorAutoPollInterval = setInterval(loadProctorClassStudentsWeb, 8000);
                }
            } else {
                if (proctorAutoPollInterval) {
                    clearInterval(proctorAutoPollInterval);
                    proctorAutoPollInterval = null;
                }
            }
        }

        async function loadProctorDashboardWeb() {
            try {
                const res = await authFetch('/api/cbt/proctor-tokens');
                const data = await res.json();
                if (data.success && data.exams && data.exams.length > 0) {
                    const supervisedClasses = data.supervisedClasses || [];
                    const activeExam = data.exams.find(e => e.isTokenActive) || data.exams[0];
                    if (activeExam) {
                        proctorActiveExam = activeExam;
                        proctorSupervisedClass = supervisedClasses.length > 0 ? supervisedClasses[0] : (activeExam.assignedClasses ? activeExam.assignedClasses.split(',')[0].trim() : 'Semua Kelas');
                        
                        document.getElementById('proctorExamTitle').innerText = activeExam.title;
                        document.getElementById('proctorExamSub').innerText = `Mapel: ${activeExam.subject} • Durasi: ${activeExam.durationMinutes} Menit • Rombel Sasaran: ${activeExam.assignedClasses || 'Semua'}`;
                        document.getElementById('proctorClassBadge').innerText = `Kelas ${proctorSupervisedClass}`;
                        
                        const displayToken = (activeExam.classTokens && activeExam.classTokens[proctorSupervisedClass]) ? activeExam.classTokens[proctorSupervisedClass] : activeExam.token;
                        document.getElementById('proctorTokenText').innerText = displayToken;
                        
                        const badgeActive = document.getElementById('badgeProctorActive');
                        if (badgeActive) {
                            badgeActive.classList.remove('hidden');
                        }

                        startProctorTimer(activeExam.remainingSeconds || 900);
                        loadProctorClassStudentsWeb();
                    }
                } else {
                    document.getElementById('proctorExamTitle').innerText = 'Tidak Ada Sesi Ujian Aktif';
                    document.getElementById('proctorExamSub').innerText = 'Saat ini belum ada jadwal pengawasan ruang ujian yang aktif.';
                    document.getElementById('proctorTokenText').innerText = 'OFF';
                }
            } catch (err) {
                console.error('Error loadProctorDashboardWeb:', err);
            }
        }

        function startProctorTimer(seconds) {
            proctorRemainingSec = seconds;
            if (proctorTimerInterval) clearInterval(proctorTimerInterval);
            updateProctorTimerUI();
            proctorTimerInterval = setInterval(() => {
                if (proctorRemainingSec > 0) {
                    proctorRemainingSec--;
                    updateProctorTimerUI();
                } else {
                    clearInterval(proctorTimerInterval);
                    loadProctorDashboardWeb();
                }
            }, 1000);
        }

        function updateProctorTimerUI() {
            const m = Math.floor(proctorRemainingSec / 60);
            const s = proctorRemainingSec % 60;
            const str = `⏳ %02d:%02d`.replace('%02d', String(m).padStart(2, '0')).replace('%02d', String(s).padStart(2, '0'));
            const elPill = document.getElementById('proctorCountdownPill');
            const elProj = document.getElementById('projectorCountdown');
            if (elPill) elPill.innerText = str;
            if (elProj) elProj.innerText = `⏳ Sisa Waktu Token: ${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        function copyProctorTokenWeb() {
            const token = document.getElementById('proctorTokenText')?.innerText;
            if (token && token !== '------' && token !== 'OFF') {
                navigator.clipboard.writeText(token);
                alert(`📋 Token ${token} berhasil disalin ke clipboard!`);
            }
        }

        async function regenerateProctorTokenWeb() {
            if (!proctorActiveExam || !proctorSupervisedClass) return;
            if (!confirm(`Acak token baru untuk ruang kelas ${proctorSupervisedClass}? Token lama tidak akan berlaku lagi.`)) return;
            try {
                const res = await authFetch('/api/cbt/reset-class-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: proctorActiveExam.id, className: proctorSupervisedClass })
                });
                const data = await res.json();
                if (data.success && data.token) {
                    document.getElementById('proctorTokenText').innerText = data.token;
                    startProctorTimer(900);
                    alert(`✅ Token baru ruang ${proctorSupervisedClass}: ${data.token}`);
                    if (projectorQrObj) {
                        openProctorProjectorModal();
                    }
                } else {
                    alert('Gagal merilis token: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Gagal merilis token: ' + e.message);
            }
        }

        async function loadProctorClassStudentsWeb() {
            if (!proctorActiveExam || !proctorSupervisedClass) return;
            try {
                const res = await authFetch(`/api/cbt/proctor-class-students?examId=${proctorActiveExam.id}&className=${encodeURIComponent(proctorSupervisedClass)}`);
                const data = await res.json();
                if (data.success && data.students) {
                    renderProctorStudentsTable(data.students);
                }
            } catch (e) {
                console.error('Error loadProctorClassStudentsWeb:', e);
            }
        }

        function renderProctorStudentsTable(students) {
            const tbody = document.getElementById('proctorStudentsTableBody');
            if (!tbody) return;

            let ongoing = 0, locked = 0, warning = 0, submitted = 0;
            tbody.innerHTML = '';

            if (students.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-slate-400">Belum ada siswa terdaftar di rombel kelas ${proctorSupervisedClass}.</td></tr>`;
                return;
            }

            students.forEach((st, idx) => {
                const status = (st.status || 'BELUM_MULAI').toUpperCase();
                let statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">⚪ Belum Mulai</span>';
                if (status === 'ONGOING' || status === 'MENGERJAKAN') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">🟢 Mengerjakan</span>';
                    ongoing++;
                } else if (status === 'LOCKED' || status === 'TERKUNCI') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 animate-pulse">🔒 Terkunci</span>';
                    locked++;
                } else if (status === 'SUBMITTED' || status === 'SELESAI') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">✅ Selesai</span>';
                    submitted++;
                }

                const strikes = st.strikeCount || 0;
                let strikeBadge = `<span class="font-bold ${strikes > 0 ? 'text-rose-600' : 'text-slate-400'}">${strikes}x</span>`;
                if (strikes > 0 && status !== 'LOCKED') {
                    warning++;
                }

                const startTime = st.startTime ? new Date(st.startTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB' : '-';

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition-colors';
                tr.innerHTML = `
                    <td class="p-3.5 text-center font-bold text-slate-400">${idx + 1}</td>
                    <td class="p-3.5">
                        <div class="font-bold text-slate-800 text-xs">${st.name}</div>
                        <div class="text-[10px] text-slate-400 font-mono">NISN: ${st.nisn || st.username || '-'}</div>
                    </td>
                    <td class="p-3.5 text-center">${statusBadge}</td>
                    <td class="p-3.5 text-center">${strikeBadge}</td>
                    <td class="p-3.5 text-center font-mono text-xs">${startTime}</td>
                    <td class="p-3.5 text-right">
                        <div class="flex items-center justify-end gap-1.5">
                            <button onclick="proctorResetStudentLockWeb('${st.id}', '${st.name}')" title="Buka Kunci atau Ganti HP" class="px-2.5 py-1.5 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-lg text-[10px] shadow transition-colors cursor-pointer flex items-center gap-1">
                                <span>🔄</span> <span>Buka Kunci / Ganti HP</span>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('proctorStatTotal').innerText = students.length;
            document.getElementById('proctorStatOngoing').innerText = ongoing;
            document.getElementById('proctorStatLocked').innerText = locked;
            document.getElementById('proctorStatWarning').innerText = warning;
            document.getElementById('proctorStatSubmitted').innerText = submitted;
        }

