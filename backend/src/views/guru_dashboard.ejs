            const form = document.getElementById('panelPrayerScheduleForm');
            if (!form) return;
            form.classList.toggle('hidden');
            if (!form.classList.contains('hidden')) {
                const dayToSelect = currentPaiPrayerSchedule ? currentPaiPrayerSchedule.dayOfWeek : (new Date().getDay() || 1);
