                    Batal
                </button>
                <button type="button" onclick="executePrayerPdfAction('download')" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>💾</span> <span>Unduh Berkas Langsung</span>
                </button>
                <button type="button" onclick="executePrayerPdfAction('print')" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-purple-600 hover:bg-purple-700 text-white shadow-md flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>🖨️</span> <span>Buka & Cetak PDF</span>
                </button>
            </div>
    </div>

    <!-- MODAL SCAN KARTU PELAJAR SISWA TANPA HP (GURU PAI) -->
    <div id="modalPaiScanCard" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-slate-200 animate-fade-in flex flex-col max-h-[92vh]">
            <div class="px-6 py-4 bg-gradient-to-r from-blue-700 via-indigo-700 to-slate-900 text-white flex justify-between items-center">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">🪪</span>
                    <div>
                        <h3 class="font-black text-base leading-tight">Scan Kartu Pelajar (Siswa Tanpa HP)</h3>
                        <p class="text-[11px] text-blue-200">Presensi Sholat Berjamaah &amp; Gate Masuk/Pulang Otomatis</p>
                    </div>
                </div>
                <button type="button" onclick="closePaiScanCardModal()" class="text-white/80 hover:text-white font-bold text-2xl px-2 cursor-pointer">&times;</button>
            </div>

            <div class="p-6 space-y-4 text-xs overflow-y-auto">
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-3.5 flex items-start gap-2.5 text-blue-900">
                    <span class="text-base flex-shrink-0">💡</span>
                    <div class="text-[11px] leading-relaxed">
                        Arahkan <b>Barcode Scanner USB</b> ke barcode kartu pelajar fisik siswa, atau ketik langsung <b>NISN / NIS</b> lalu tekan Enter. Presensi sholat akan langsung tercatat resmi atas nama Guru PAI.
                    </div>
                </div>

                <form id="formPaiScanCard" onsubmit="handlePaiScanCardSubmit(event)" class="space-y-3.5">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">🕌 Sesi Ibadah Sholat:</label>
                        <select id="modalScanPrayerType" class="w-full border-2 border-slate-200 rounded-xl px-3.5 py-2 font-bold text-slate-800 bg-slate-50 focus:border-blue-600 focus:bg-white focus:outline-none">
                            <option value="DHUHUR">☀️ Sholat Dhuhur Berjamaah</option>
                            <option value="DHUHA">🌅 Sholat Dhuha Berjamaah</option>
                            <option value="JUMAT">🕌 Sholat Jumat (Putra) / Keputrian</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">📷 Barcode / NISN / NIS Kartu Pelajar:</label>
                        <div class="flex gap-2">
                            <input type="text" id="inputScanCardBarcode" placeholder="Scan barcode kartu atau ketik NISN..." autofocus class="flex-1 border-2 border-blue-500 rounded-xl px-4 py-3 font-mono font-black text-base text-slate-900 bg-blue-50/30 focus:border-blue-700 focus:bg-white focus:outline-none tracking-wider">
                            <button type="submit" class="px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black text-xs shadow-md transition-all cursor-pointer flex items-center gap-1.5">
                                <span>⚡</span> <span>Scan</span>
                            </button>
                        </div>
                        <p class="text-[10.5px] text-slate-400 mt-1">Mendukung format: Kartu Pelajar Barcode, NISN (10 digit), NIS, atau Username.</p>
                    </div>
                </form>

                <!-- Status Hasil Scan Terakhir -->
                <div id="paiScanLastResult" class="hidden rounded-2xl border p-4 space-y-2">
                    <!-- Populated dynamically via JS -->
                </div>

                <!-- Riwayat Scan Sesi Ini -->
                <div>
                    <h4 class="font-extrabold text-slate-700 text-[11px] uppercase tracking-wide mb-2 flex items-center justify-between">
                        <span>Riwayat Scan Sesi Ini</span>
                        <span id="paiScanSessionCount" class="text-blue-700 font-bold">0 Siswa</span>
                    </h4>
                    <div id="paiScanRecentList" class="space-y-1.5 max-h-40 overflow-y-auto">
                        <p class="text-center text-slate-400 py-3 text-[11px]">Belum ada kartu siswa yang discan.</p>
                    </div>
                </div>
            </div>

            <div class="p-4 bg-slate-50 border-t flex justify-end">
                <button type="button" onclick="closePaiScanCardModal()" class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-200 hover:bg-slate-300 transition-colors cursor-pointer">
                    Selesai &amp; Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL PENGINGAT SHOLAT BESOK (H-1) & ALAT SHOLAT -->
    <div id="modalPaiH1Reminder" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-slate-200 animate-fade-in flex flex-col max-h-[92vh]">
            <div class="px-6 py-4 bg-gradient-to-r from-indigo-700 via-purple-700 to-slate-900 text-white flex justify-between items-center">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📢</span>
                    <div>
                        <h3 class="font-black text-base leading-tight">Kirim Pengingat Sholat Besok (H-1)</h3>
                        <p class="text-[11px] text-indigo-200">Kirim notifikasi ke Siswa &amp; Orang Tua agar membawa alat sholat</p>
                    </div>
                </div>
                <button type="button" onclick="closePaiH1ReminderModal()" class="text-white/80 hover:text-white font-bold text-2xl px-2 cursor-pointer">&times;</button>
            </div>

            <div class="p-6 space-y-4 text-xs overflow-y-auto">
                <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-4 space-y-2 text-indigo-950">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-[11px] text-indigo-700 uppercase tracking-wide">Target Hari Besok:</span>
                        <span id="h1ModalTomorrowDay" class="font-black text-xs px-2.5 py-0.5 rounded-full bg-indigo-200 text-indigo-900">Memuat...</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-[11px] text-indigo-700 uppercase tracking-wide">Rombel Terjadwal Besok:</span>
                        <span id="h1ModalTomorrowClasses" class="font-black text-xs text-indigo-900">Memuat...</span>
                    </div>
                    <p class="text-[11px] text-indigo-800 leading-relaxed pt-1 border-t border-indigo-200/60">
                        Notifikasi otomatis dikirimkan ke <b>Aplikasi Siswa (In-App + FCM Push)</b> dan <b>Aplikasi Orang Tua</b>, serta pesan WhatsApp Resmi jika nomor wali murid aktif.
                    </p>
                </div>

                <div class="space-y-2">
                    <label class="block font-bold text-slate-700">💬 Pesan Pengingat yang Dikirimkan:</label>
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3.5 space-y-2 text-[11px]">
                        <p class="font-bold text-slate-800">📱 Pesan ke Siswa:</p>
                        <p class="text-slate-600 bg-white p-2.5 rounded-xl border border-slate-200 italic" id="h1PreviewSiswa">
                            "Hai [Nama Siswa], besok kelas [Kelas] terjadwal Sholat Berjamaah. ⚠️ PENTING: Harap membawa perlengkapan &amp; alat sholat lengkap dari rumah (sarung/peci bagi putra, mukena bersih bagi putri, serta sajadah pribadi)..."
                        </p>
                        <p class="font-bold text-slate-800 pt-1">👨‍👩‍👧 Pesan ke Orang Tua:</p>
                        <p class="text-slate-600 bg-white p-2.5 rounded-xl border border-slate-200 italic" id="h1PreviewOrtu">
                            "Bapak/Ibu Orang Tua/Wali, besok ananda [Nama Siswa] memiliki jadwal Sholat Berjamaah di Mushola/Masjid sekolah. ⚠️ Mohon memastikan ananda membawa alat/perlengkapan sholat dari rumah..."
                        </p>
                    </div>
                </div>

                <div id="h1ResultAlert" class="hidden rounded-2xl p-3.5 border text-xs">
                    <!-- Populated dynamically upon dispatch -->
                </div>
            </div>

            <div class="p-4 bg-slate-50 border-t flex justify-end gap-2.5">
                <button type="button" onclick="closePaiH1ReminderModal()" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer">
                    Batal
                </button>
                <button type="button" id="btnConfirmSendH1" onclick="executePaiH1ReminderDispatch()" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>🚀</span> <span>Kirim Pengingat Sekarang</span>
                </button>
            </div>
        </div>
    </div>
</body>
</html>
