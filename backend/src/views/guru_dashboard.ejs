        async function handleSavePrayerScheduleWeb(e) {
            e.preventDefault();
            const id = document.getElementById('inputPaiScheduleId')?.value || undefined;
            const dayOfWeek = Number(document.getElementById('selectPaiDayOfWeek')?.value || 1);
            const prayerType = document.getElementById('selectPaiPrayerType')?.value || 'DHUHUR';
            const barcodeKey = document.getElementById('selectPaiBarcodeKey')?.value || 'BARCODE_SHOLAT_DHUHUR_MASJID';
            const classNames = document.getElementById('inputPaiClassNames')?.value?.trim();
            const wudhuTime = document.getElementById('inputPaiWudhuTime')?.value || (prayerType === 'DHUHA' ? '06:45' : '11:45');
            const scanStartTime = document.getElementById('inputPaiScanStartTime')?.value || (prayerType === 'DHUHA' ? '07:00' : '12:00');
            const scanEndTime = document.getElementById('inputPaiScanEndTime')?.value || (prayerType === 'DHUHA' ? '07:45' : '12:30');
            const notes = document.getElementById('inputPaiScheduleNotes')?.value?.trim();

            if (!classNames) {
                alert('Daftar rombel kelas wajib diisi!');
                return;
            }

            const dayNames = ['MINGGU', 'SENIN', 'SELASA', 'RABU', 'KAMIS', 'JUMAT', 'SABTU'];

            try {
                const res = await authFetch('/api/prayer/set-schedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id,
                        dayOfWeek,
                        dayName: dayNames[dayOfWeek] || 'HARI',
                        prayerType,
                        barcodeKey,
                        classNames,
                        wudhuTime,
                        scanStartTime,
                        scanEndTime,
                        notes
                    })
                });
                const result = await res.json();
                if (result.success) {
                    alert('✅ ' + result.message);
                    togglePrayerScheduleForm();
                    loadPaiPrayerWeb();
                } else {
                    alert('Gagal menyimpan: ' + (result.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Koneksi terputus: ' + err.message);
            }
        }

