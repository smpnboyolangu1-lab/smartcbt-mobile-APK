                    document.getElementById('badgeUhMode').innerText = `MODE ${uh.mode}`;
                    document.getElementById('txtUhTopik').innerText = `UH ${uh.mapel} — ${uh.topik} (Kelas ${uh.kelas})`;
                    document.getElementById('txtUhSub').innerText = `Durasi: ${uh.durasiMenit} Menit • Status: ${uh.status}`;

                    if (uh.mode === 'CBT_MINI' && uh.tokenAktif) {
                        document.getElementById('boxTokenCbt').classList.remove('hidden');
                        document.getElementById('txtTokenAktif').innerText = uh.tokenAktif;
                    } else {
                        document.getElementById('boxTokenCbt').classList.add('hidden');
                    }

                    document.getElementById('kpiTotalSiswa').innerText = stats.totalSiswa || 0;
                    document.getElementById('kpiMengerjakan').innerText = stats.sedangMengerjakan || 0;
                    document.getElementById('kpiSelesai').innerText = stats.selesai || 0;
                    document.getElementById('kpiRataRata').innerText = stats.rataRata || 0;
                    document.getElementById('kpiInsiden').innerText = stats.insidenCurang || 0;

                    document.getElementById('btnAkhiriUh').disabled = (uh.status === 'SELESAI');
