        function filterHomeroomStudentsTable() {
            const query = (document.getElementById('wkSearchInput')?.value || '').toLowerCase().trim();
            if (!query) {
                renderHomeroomStudentsTable(currentHomeroomStudents);
                return;
            }
            const filtered = currentHomeroomStudents.filter(s => 
                (s.name && s.name.toLowerCase().includes(query)) ||
                (s.nisn && s.nisn.toLowerCase().includes(query)) ||
                (s.nis && s.nis.toLowerCase().includes(query))
            );
            renderHomeroomStudentsTable(filtered);
        }

        function showHomeroomStudentDetail(studentId) {
            const student = currentHomeroomStudents.find(s => s.id === studentId);
            if (!student) return;

            currentSelectedStudentIdForPdf = studentId;

            document.getElementById('wkDetailName').innerText = student.name;
            document.getElementById('wkDetailSub').innerText = `NISN: ${student.nisn || '-'} • NIS: ${student.nis || '-'}`;
            document.getElementById('wkDetailGender').innerText = student.gender === 'P' ? 'Perempuan' : 'Laki-laki';
            document.getElementById('wkDetailBlood').innerText = student.bloodType || 'Belum diisi';
            document.getElementById('wkDetailAddress').innerText = student.address || 'Jalan Raya Boyolangu, Tulungagung';
            document.getElementById('wkDetailPoints').innerText = (student.points || 0) + ' Poin';
            document.getElementById('wkDetailFather').innerText = student.fatherName || '-';
            document.getElementById('wkDetailMother').innerText = student.motherName || '-';
            document.getElementById('wkDetailPhoneText').innerText = student.parentPhone || 'Belum terdaftar';

            const waBtn = document.getElementById('wkDetailWaBtn');
            if (student.parentPhone) {
                const cleanPhone = student.parentPhone.replace(/[^0-9]/g, '');
                waBtn.href = `https://wa.me/${cleanPhone}?text=Halo%20Bapak%2FIbu%20Wali%20Murid%20${encodeURIComponent(student.name)}`;
                waBtn.classList.remove('hidden');
            } else {
                waBtn.classList.add('hidden');
            }

            const st = (student.todayStatus || 'BELUM').toUpperCase();
            const attStatus = document.getElementById('wkDetailAttStatus');
            const attTime = document.getElementById('wkDetailAttTime');
            const attCard = document.getElementById('wkDetailAttCard');

            if (st === 'HADIR' || st === 'PRESENT') {
                attStatus.innerText = 'Hadir Tepat Waktu';
                attStatus.className = 'font-black text-sm text-emerald-700';
                attTime.innerText = `Masuk: ${student.todayInTime || '06:45 WIB'}`;
                attCard.className = 'p-3.5 rounded-2xl border border-emerald-200 bg-emerald-50/60 flex items-center justify-between';
            } else if (st === 'UNCONFIRMED_OUT' || st === '?') {
                attStatus.innerText = 'Hadir (Tidak Scan Pulang)';
                attStatus.className = 'font-black text-sm text-sky-700';
                attTime.innerText = `Masuk: ${student.todayInTime || '-'}`;
                attCard.className = 'p-3.5 rounded-2xl border border-sky-200 bg-sky-50/60 flex items-center justify-between';
            } else if (st === 'TERLAMBAT' || st === 'LATE') {
                attStatus.innerText = 'Terlambat Masuk';
                attStatus.className = 'font-black text-sm text-amber-700';
                attTime.innerText = `Masuk: ${student.todayInTime || '-'}`;
                attCard.className = 'p-3.5 rounded-2xl border border-amber-200 bg-amber-50/60 flex items-center justify-between';
            } else if (st === 'IZIN' || st === 'SAKIT') {
                attStatus.innerText = st === 'SAKIT' ? 'Izin Sakit' : 'Izin Resmi';
                attStatus.className = 'font-black text-sm text-blue-700';
                attTime.innerText = 'Surat Izin Disetujui';
                attCard.className = 'p-3.5 rounded-2xl border border-blue-200 bg-blue-50/60 flex items-center justify-between';
            } else {
                attStatus.innerText = 'Belum Melakukan Presensi';
                attStatus.className = 'font-black text-sm text-slate-600';
                attTime.innerText = 'Belum ada data scan';
                attCard.className = 'p-3.5 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-between';
            }

            document.getElementById('modalHomeroomStudentDetail').classList.remove('hidden');
        }

