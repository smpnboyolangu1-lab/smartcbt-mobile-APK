            const selectedOptionText = surahSelect.options[surahSelect.selectedIndex]?.text || '';
            const surahName = selectedOptionText.replace(/^\d+\.\s*/, '').split('(')[0].trim() || `Surat ${surahNumber}`;
            const ayatStart = Number(document.getElementById('inputTahfizTargetAyatStart').value);
            const ayatEnd = Number(document.getElementById('inputTahfizTargetAyatEnd').value);
            const semester = document.getElementById('inputTahfizTargetSemester').value;
