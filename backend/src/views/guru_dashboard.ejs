        function onTahfizRubrikSliderChange() {
            const k = Number(document.getElementById('sliderRubrikKelancaran').value);
            const a = Number(document.getElementById('sliderRubrikKetepatan').value);
            const t = Number(document.getElementById('sliderRubrikTajwid').value);
            const m = Number(document.getElementById('sliderRubrikMakhraj').value);
            const s = Number(document.getElementById('sliderRubrikKemandirian').value);

            document.getElementById('lblRubrikKelancaran').innerText = k;
            document.getElementById('lblRubrikKetepatan').innerText = a;
            document.getElementById('lblRubrikTajwid').innerText = t;
            document.getElementById('lblRubrikMakhraj').innerText = m;
            document.getElementById('lblRubrikKemandirian').innerText = s;

            // Hitung otomatis dengan bobot (25%, 25%, 20%, 20%, 10%)
            const finalScore = (k * 0.25) + (a * 0.25) + (t * 0.20) + (m * 0.20) + (s * 0.10);
            const rounded = Math.round(finalScore * 10) / 10;
            document.getElementById('previewTahfizNilaiAkhir').innerText = rounded;

            const sel = document.getElementById('selectTahfizStatusHafalan');
            if (sel) {
                if (rounded >= 75) {
                    sel.value = 'LULUS_SETORAN';
                } else {
                    sel.value = 'PERLU_MENGULANG';
                }
            }
        }

        async function submitTahfizPenilaian(e) {
            e.preventDefault();
            const setoranId = document.getElementById('tahfizPenilaianSetoranId').value;
            const studentId = document.getElementById('tahfizPenilaianStudentId').value;
            const surahNumber = Number(document.getElementById('tahfizPenilaianSurahNumber').value);
            const ayatStart = Number(document.getElementById('tahfizPenilaianAyatStart').value);
            const ayatEnd = Number(document.getElementById('tahfizPenilaianAyatEnd').value);

            const kelancaran = Number(document.getElementById('sliderRubrikKelancaran').value);
            const ketepatan = Number(document.getElementById('sliderRubrikKetepatan').value);
            const tajwid = Number(document.getElementById('sliderRubrikTajwid').value);
            const makhraj = Number(document.getElementById('sliderRubrikMakhraj').value);
            const kemandirian = Number(document.getElementById('sliderRubrikKemandirian').value);

            const statusHafalan = document.getElementById('selectTahfizStatusHafalan').value;
            const catatan = document.getElementById('inputTahfizCatatanGuru').value.trim();

            const btn = document.getElementById('btnSubmitTahfizPenilaian');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            try {
                const res = await authFetch('/api/tahfiz/penilaian', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        setoranId: setoranId || undefined,
                        studentId,
                        surahNumber,
                        ayatStart,
                        ayatEnd,
