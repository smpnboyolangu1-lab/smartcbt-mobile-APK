        async function loadLeaveRequestsTeacher() {
            const tbody = document.getElementById('tableLeaveRequestsTeacher');
            if(!tbody) return;
            tbody.innerHTML = '<tr><td colspan="8" class="p-6 text-center text-gray-400">Memuat permohonan izin siswa...</td></tr>';

            try {
                const res = await fetch('/api/teacher/leave-requests?className=ALL', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.status === 401 || res.status === 403) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="p-8 text-center text-amber-600 bg-amber-50 font-bold">
                                ⚠️ Sesi login telah berakhir atau Anda tidak memiliki akses. 
                                <button onclick="window.location.href='/'" class="ml-2 px-3 py-1 bg-amber-600 text-white rounded-lg text-xs font-bold shadow">
                                    Login Ulang
                                </button>
                            </td>
                        </tr>
                    `;
                    return;
                }

                const list = await res.json();
                if (!Array.isArray(list)) {
                    tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-rose-500 font-bold">Gagal memuat data: ${list.message || 'Respon server tidak sesuai'}</td></tr>`;
                    return;
                }

                allLeaveRequestsTeacher = list;

                // Hitung Statistik
                let pendingCount = 0;
                let approvedCount = 0;
                let rejectedCount = 0;
                allLeaveRequestsTeacher.forEach(r => {
                    const st = (r.status || '').toUpperCase();
                    if (st === 'PENDING') pendingCount++;
                    else if (st === 'APPROVED') approvedCount++;
                    else if (st === 'REJECTED') rejectedCount++;
                });

                const elPending = document.getElementById('statTeacherLeavePending');
                const elApproved = document.getElementById('statTeacherLeaveApproved');
                const elRejected = document.getElementById('statTeacherLeaveRejected');
                const elTotal = document.getElementById('statTeacherLeaveTotal');
                if (elPending) elPending.innerText = pendingCount;
                if (elApproved) elApproved.innerText = approvedCount;
                if (elRejected) elRejected.innerText = rejectedCount;
                if (elTotal) elTotal.innerText = allLeaveRequestsTeacher.length;

                const badge = document.getElementById('badgePendingLeave');
                if(badge) {
                    if(pendingCount > 0) {
                        badge.innerText = pendingCount;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }

                renderLeaveRequestsTeacher();
            } catch(e) {
                console.error('Error loadLeaveRequestsTeacher:', e);
                tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-rose-500 font-bold">Terjadi kesalahan koneksi server: ${e.message}</td></tr>`;
            }
        }

        function renderLeaveRequestsTeacher() {
            const tbody = document.getElementById('tableLeaveRequestsTeacher');
            if(!tbody) return;

            const statusFilter = document.getElementById('teacherLeaveFilterStatus')?.value || 'ALL';
            const classFilter = document.getElementById('teacherLeaveFilterClass')?.value || 'ALL';
            const searchVal = (document.getElementById('teacherLeaveSearch')?.value || '').toLowerCase().trim();

            const filtered = allLeaveRequestsTeacher.filter(req => {
                const reqStatus = (req.status || 'PENDING').toUpperCase();
                const reqClass = (req.className || '').toUpperCase();
                const reqName = (req.studentName || '').toLowerCase();
                const reqParent = (req.parentName || '').toLowerCase();
                const reqReason = (req.reason || '').toLowerCase();

                const matchStatus = (statusFilter === 'ALL' || reqStatus === statusFilter);
                const matchClass = (classFilter === 'ALL' || reqClass === classFilter.toUpperCase());
                const matchSearch = (!searchVal || reqName.includes(searchVal) || reqParent.includes(searchVal) || reqReason.includes(searchVal));

                return matchStatus && matchClass && matchSearch;
            });

            tbody.innerHTML = '';
            if(filtered.length > 0) {
                filtered.forEach(req => {
                    let dateStr = '-';
                    try {
                        dateStr = new Date(req.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    } catch(e) { dateStr = String(req.createdAt || '-'); }

                    let startStr = '-';
                    let endStr = '-';
                    try {
                        startStr = new Date(req.startDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
                        endStr = new Date(req.endDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
                    } catch(e) {}
                    const periodStr = (startStr === endStr) ? startStr : `${startStr} s/d ${endStr}`;

                    const catUpper = (req.category || '').toUpperCase();
                    let badgeCategory = '<span class="bg-purple-100 text-purple-800 font-bold px-2 py-0.5 rounded">Izin</span>';
                    if(catUpper === 'SAKIT' || catUpper === 'SICK') badgeCategory = '<span class="bg-blue-100 text-blue-800 font-bold px-2 py-0.5 rounded">Sakit</span>';
                    if(catUpper === 'DISPENSASI' || catUpper === 'DISPENSATION') badgeCategory = '<span class="bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded">Dispensasi</span>';

                    const stUpper = (req.status || 'PENDING').toUpperCase();
                    let statusBadge = '<span class="bg-amber-100 text-amber-800 font-bold px-2.5 py-0.5 rounded-full text-[11px]">⏳ Menunggu</span>';
                    if(stUpper === 'APPROVED') statusBadge = '<span class="bg-green-100 text-green-800 font-bold px-2.5 py-0.5 rounded-full text-[11px]">✅ Disetujui</span>';
                    if(stUpper === 'REJECTED') statusBadge = '<span class="bg-red-100 text-red-800 font-bold px-2.5 py-0.5 rounded-full text-[11px]">❌ Ditolak</span>';

                    let attachmentLink = '<span class="text-gray-400 italic text-[11px] block mt-1.5">Tanpa lampiran surat</span>';
                    if(req.attachmentUrl) {
                        attachmentLink = `
                            <div class="mt-2.5 p-2 bg-slate-50 rounded-xl border border-slate-200 flex items-center gap-2.5 max-w-[220px]">
                                <div class="relative group cursor-pointer flex-shrink-0" onclick="openTeacherLightbox('${req.attachmentUrl}', 'Surat Keterangan - ${req.studentName}')" title="Klik untuk memperbesar">
                                    <img src="${req.attachmentUrl}" alt="Foto Surat Izin" 
                                         class="w-14 h-14 object-cover rounded-lg border border-emerald-300 shadow-sm group-hover:opacity-90 transition-all bg-white"
                                         onerror="this.onerror=null; this.src='/uploads/sample_real.jpg';" />
                                    <div class="absolute inset-0 bg-black/30 rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                        <span class="text-white text-xs">🔍</span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-1.5 py-0.5 rounded block truncate">📷 Surat Dokter/Izin</span>
                                    <div class="mt-1 flex items-center gap-1.5">
                                        <button type="button" onclick="openTeacherLightbox('${req.attachmentUrl}', 'Surat Keterangan - ${req.studentName}')" class="text-emerald-700 hover:text-emerald-900 font-bold text-[11px] underline">
                                            Perbesar
                                        </button>
                                        <span class="text-gray-300">•</span>
                                        <a href="${req.attachmentUrl}" target="_blank" download class="text-gray-500 hover:text-gray-700 font-medium text-[10px]">
                                            Unduh
                                        </a>
                                    </div>
                                </div>
                            </div>
                        `;
                    }

                    let actions = '-';
                    if(stUpper === 'PENDING') {
                        actions = `
                            <div class="flex justify-end gap-1.5">
                                <button onclick="handleVerifyLeaveTeacher('${req.id}', 'APPROVED')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1 rounded-lg font-bold shadow text-xs">
                                    Setujui
                                </button>
                                <button onclick="handleVerifyLeaveTeacher('${req.id}', 'REJECTED')" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded-lg font-bold shadow text-xs">
                                    Tolak
                                </button>
                                <button onclick="handleDeleteLeaveTeacher('${req.id}', '${(req.studentName || 'Siswa').replace(/'/g, "\\'")}')" class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 px-2.5 py-1 rounded-lg font-bold text-xs" title="Hapus histori surat izin">
                                    🗑️ Hapus
                                </button>
                            </div>
