                    document.getElementById('paiStatHaid').innerText = haidCount;
                    document.getElementById('paiStatBelum').innerText = belumCount;

                    renderPaiStudentsTable(currentPaiPrayerStudents);
                } else {
                    alert(data.message || 'Gagal memperbarui status');
                }
            } catch (err) {
                alert('Koneksi terputus: ' + err.message);
            }
        }

