        function populatePaiClassesDropdown() {
            const select = document.getElementById('selectPaiClassFilter');
            if (!select) return;

            const allMasterClasses = [
                'VII-A', 'VII-B', 'VII-C', 'VII-D', 'VII-E', 'VII-F', 'VII-G', 'VII-H', 'VII-I', 'VII-J', 'VII-K',
                'VIII-A', 'VIII-B', 'VIII-C', 'VIII-D', 'VIII-E', 'VIII-F', 'VIII-G', 'VIII-H', 'VIII-I', 'VIII-J', 'VIII-K',
                'IX-A', 'IX-B', 'IX-C', 'IX-D', 'IX-E', 'IX-F', 'IX-G', 'IX-H', 'IX-I', 'IX-J', 'IX-K'
            ];

            const currentVal = select.value;
            select.innerHTML = '';

            // Ekstrak rombel jadwal sholat yang sedang aktif
            let targetClasses = [];
            if (currentPaiPrayerSchedule?.classNames && currentPaiPrayerSchedule.classNames !== 'ALL_MALE' && currentPaiPrayerSchedule.classNames !== 'ALL') {
                targetClasses = currentPaiPrayerSchedule.classNames.split(',').map(c => c.trim()).filter(Boolean);
            }

            if (!paiShowAllClasses && targetClasses.length > 0) {
                // HANYA rombel terjadwal sholat hari ini
                const optGroup = document.createElement('optgroup');
                optGroup.label = `🎯 Rombel Terjadwal Hari Ini (${targetClasses.length} Kelas)`;
                targetClasses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c;
                    opt.textContent = `Kelas ${c} (Jadwal Sholat)`;
                    optGroup.appendChild(opt);
                });
                select.appendChild(optGroup);
            } else {
                // Tampilkan semua kelas master dengan penanda rombel terjadwal
                const optGroupSched = document.createElement('optgroup');
                optGroupSched.label = `🎯 Terjadwal Hari Ini`;
                const optGroupOther = document.createElement('optgroup');
                optGroupOther.label = `🏫 Rombel Lainnya`;

                allMasterClasses.forEach(c => {
                    const isSched = targetClasses.includes(c);
                    const opt = document.createElement('option');
                    opt.value = c;
                    opt.textContent = isSched ? `Kelas ${c} ⭐ (Terjadwal)` : `Kelas ${c}`;
                    if (isSched) {
                        optGroupSched.appendChild(opt);
                    } else {
                        optGroupOther.appendChild(opt);
                    }
                });

                if (optGroupSched.children.length > 0) select.appendChild(optGroupSched);
                select.appendChild(optGroupOther);
            }

            // Restore selection jika masih valid, atau pilih rombel pertama terjadwal
            if (currentVal && Array.from(select.options).some(o => o.value === currentVal)) {
                select.value = currentVal;
            } else if (targetClasses.length > 0 && Array.from(select.options).some(o => o.value === targetClasses[0])) {
                select.value = targetClasses[0];
            } else if (select.options.length > 0) {
                select.selectedIndex = 0;
            }

            // Set tanggal hari ini pada input
            const dateInput = document.getElementById('inputPaiDateFilter');
            if (dateInput && !dateInput.value) {
                dateInput.value = new Date().toISOString().substring(0, 10);
            }
        }

        let weeklyPrayerSchedules = [];

        async function loadPaiPrayerWeb() {
            initPaiClassChips();
            try {
                // 1. Deteksi waktu sekarang (WIB): Pagi < jam 10 otomatis seleksi Dhuha, Siang >= jam 10 otomatis seleksi Dhuhur
                const nowWib = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jakarta' }));
                const currentHourWIB = nowWib.getHours();
                const isMorningDhuha = currentHourWIB < 10;
                const reqParam = isMorningDhuha ? '?prayerType=DHUHA' : '';

                // Ambil Jadwal Sholat Hari Ini
                const resSched = await authFetch(`/api/prayer/today-schedule${reqParam}`);
                const schedData = await resSched.json();
                if (schedData.success && schedData.schedule) {
                    currentPaiPrayerSchedule = schedData.schedule;
                    allTodayPrayerSchedulesList = schedData.availablePrayers || [];
                    todayScheduledClassesList = schedData.scheduledClasses || [];
                    renderPrayerScheduleInfo(schedData);
                }
                populatePaiClassesDropdown();

                // 2. Ambil Seluruh Jadwal Sepanjang Pekan (Senin - Sabtu)
                try {
                    const resAll = await authFetch('/api/prayer/all-schedules');
                    const allData = await resAll.json();
                    if (allData.success && Array.isArray(allData.schedules)) {
                        weeklyPrayerSchedules = allData.schedules;
                        renderWeeklyPrayerTable(weeklyPrayerSchedules);
                    }
                } catch(e) {
                    console.error('Error load all-schedules:', e);
                }

                // 3. Muat data siswa rombel terpilih
                await loadPaiClassMonitoring();
            } catch (err) {
                console.error('Error loadPaiPrayerWeb:', err);
            }
        }

        function renderWeeklyPrayerTable(schedules) {
            const tbody = document.getElementById('weeklyPrayerTableBody');
            if (!tbody) return;
            if (!schedules || schedules.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400">Belum ada jadwal tersimpan.</td></tr>`;
                return;
            }

            const dayNames = ['MINGGU', 'SENIN', 'SELASA', 'RABU', 'KAMIS', 'JUMAT', 'SABTU'];
            const todayDay = new Date().getDay();

            tbody.innerHTML = schedules.map(s => {
                const isToday = s.dayOfWeek === todayDay;
                const dName = s.dayName || dayNames[s.dayOfWeek] || `HARI ${s.dayOfWeek}`;
                const pTypeBadge = s.prayerType === 'JUMAT'
                    ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-700">Sholat Jumat (Putra)</span>'
                    : (s.prayerType === 'DHUHA'
                        ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Sholat Dhuha (Pagi)</span>'
                        : '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">Sholat Dhuhur</span>');
                
                const classBadges = (s.classNames === 'ALL_MALE')
                    ? '<span class="px-2.5 py-0.5 rounded-lg text-xs font-mono font-bold bg-amber-100 text-amber-800">🕌 ALL_MALE (Seluruh Siswa Putra)</span>'
                    : (s.classNames || '-').split(',').map(c => `<span class="inline-block px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-mono text-[11px] font-bold mr-1 mb-1">${c.trim()}</span>`).join('');

                const timeStr = `💧 ${s.wudhuTime || '11:45'} • 📷 ${s.scanStartTime || '12:00'}-${s.scanEndTime || '12:30'}`;

                return `
                    <tr class="hover:bg-slate-50 transition-colors ${isToday ? 'bg-emerald-50/50 font-semibold' : ''}">
                        <td class="p-3">
                            <div class="flex items-center gap-1.5">
                                <span class="font-bold text-slate-800">${dName}</span>
                                ${isToday ? '<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-emerald-600 text-white">HARI INI</span>' : ''}
                            </div>
                        </td>
                        <td class="p-3">${pTypeBadge}</td>
                        <td class="p-3">
                            <div class="flex flex-wrap items-center">${classBadges}</div>
                        </td>
                        <td class="p-3 text-[11px] font-medium text-slate-600 whitespace-nowrap">${timeStr}</td>
                        <td class="p-3 text-[11px] text-slate-500">${s.notes || '-'}</td>
                        <td class="p-3 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <button onclick="openPrayerScheduleFormForDay(${s.dayOfWeek}, '${s.prayerType}')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-900 text-white font-bold text-[11px] shadow-sm transition-all cursor-pointer">
                                    ✏️ Edit
                                </button>
                                <button onclick="handleDeletePrayerSchedule('${s.id}', ${s.dayOfWeek}, '${s.prayerType}')" class="px-2 py-1 rounded-lg bg-rose-800 hover:bg-rose-900 text-white font-bold text-[11px] shadow-sm transition-all cursor-pointer" title="Hapus Jadwal Sholat">
                                    🗑️
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function initPaiClassChips() {
