        async function quickHadirkanWali(studentId, encodedName) {
            const studentName = decodeURIComponent(encodedName || '');
            if (!confirm(`Tandai hadir sekarang untuk siswa "${studentName}" (alasan lupa/ketinggalan membawa HP)?`)) return;

            try {
                const res = await authFetch('/api/teacher/wali-kelas/manual-attendance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        studentId,
                        status: 'PRESENT',
                        note: 'Presensi manual via Wali Kelas (Lupa/ketinggalan membawa HP)'
                    })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Presensi kehadiran berhasil dicatat!');
                    loadHomeroomStudentsWeb();
                } else {
                    alert(data.message || 'Gagal mencatat presensi');
                }
            } catch(e) {
                alert('Terjadi kesalahan: ' + e.message);
            }
        }

