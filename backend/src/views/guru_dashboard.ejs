        function updateUhModePresets() {
            const mode = document.querySelector('input[name="uhMode"]:checked')?.value || 'KILAT';
            const durasiInput = document.getElementById('uhDurasiMenit');
            const soalInput = document.getElementById('uhTotalSoal');
            if (mode === 'KILAT') {
                if (durasiInput) durasiInput.value = '15';
                if (soalInput) soalInput.value = '5';
            } else if (mode === 'STANDAR') {
                if (durasiInput) durasiInput.value = '30';
                if (soalInput) soalInput.value = '15';
