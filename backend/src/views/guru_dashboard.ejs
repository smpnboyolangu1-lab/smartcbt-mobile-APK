        function downloadExcelUhTemplate() {
            const csv = "Pertanyaan\tPilihan A\tPilihan B\tPilihan C\tPilihan D\tKunci\tBobot\n" +
                "Berapakah hasil dari 5x + 3 jika x = 4?\t20\t23\t25\t28\tB\t10\n" +
                "Organ tubuh yang berfungsi memompa darah ke seluruh tubuh adalah...\tParu-paru\tHati\tJantung\tGinjal\tC\t10\n";
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Template_Soal_Ulangan_Harian.csv';
            a.click();
            URL.revokeObjectURL(url);
        }

        async function handleUploadExcelSoal() {
            const fileInput = document.getElementById('fileExcelUhInput');
            const pasteText = document.getElementById('txtPasteExcelUh')?.value?.trim();

            if (!fileInput?.files?.[0] && !pasteText) {
                alert('Pilih file Excel/CSV atau tempel teks butir soal!');
                return;
            }

            try {
                if (fileInput?.files?.[0]) {
                    const file = fileInput.files[0];
                    const reader = new FileReader();
                    reader.onload = async function(e) {
                        try {
                            const b64 = e.target.result.split(',')[1];
                            const res = await authFetch('/api/guru/uh/import-excel', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ fileBase64: b64, fileName: file.name })
                            });
                            const data = await res.json();
                            if (data.success) {
                                alert(`✅ Berhasil mengimpor ${data.count || 0} butir soal dari Excel!`);
                                closeImportExcelUhModal();
                                const durasiInput = document.getElementById('uhTotalSoal');
                                if (durasiInput && data.count) durasiInput.value = data.count;
                            } else {
                                alert('Gagal: ' + data.message);
                            }
                        } catch (err) {
                            alert('Gagal memproses file: ' + err.message);
                        }
                    };
                    reader.readAsDataURL(file);
                } else if (pasteText) {
                    const lines = pasteText.split('\n').filter(l => l.trim().length > 0);
                    alert(`✅ Berhasil memproses ${lines.length} baris teks butir soal!`);
                    closeImportExcelUhModal();
                }
            } catch (err) {
                alert('Terjadi kesalahan: ' + err.message);
            }
        }

