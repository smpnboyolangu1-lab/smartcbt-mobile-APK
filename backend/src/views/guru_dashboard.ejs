        async function triggerPaiH1ReminderWeb() {
            const modal = document.getElementById('modalPaiH1Reminder');
            if (!modal) return;

            // Hitung hari esok
            const dayNames = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            const today = new Date();
            const tomorrow = new Date(today.getTime() + 24 * 3600 * 1000);
            const tomorrowDay = tomorrow.getDay();
            const tomorrowDayName = dayNames[tomorrowDay];
            const tomorrowYmd = tomorrow.toISOString().substring(0, 10);

            document.getElementById('h1ModalTomorrowDay').innerText = `${tomorrowDayName}, ${tomorrowYmd}`;

            // Cari jadwal untuk besok dari weeklyPrayerSchedules
            const schedsTomorrow = weeklyPrayerSchedules.filter(s => s.dayOfWeek === tomorrowDay);
            let classListStr = 'Tidak ada jadwal sholat';
            if (schedsTomorrow.length > 0) {
                classListStr = schedsTomorrow.map(s => `${s.prayerType}: ${s.classNames}`).join(' | ');
            } else if (tomorrowDay === 1) {
                classListStr = 'DHUHUR: VII-F, VII-G, VIII-A, IX-A, IX-B';
            } else if (tomorrowDay === 2) {
                classListStr = 'DHUHUR: VII-B, VII-C, VIII-B, VIII-C, IX-C, IX-D';
            } else if (tomorrowDay === 3) {
                classListStr = 'DHUHUR: VII-D, VII-E, VII-H, IX-E, IX-H';
            } else if (tomorrowDay === 4) {
                classListStr = 'DHUHUR: VII-A, VIII-F, VIII-G, IX-I';
            } else if (tomorrowDay === 5) {
                classListStr = 'DHUHA: VII-I, VIII-H, VIII-I, IX-F, IX-J | JUMAT: Seluruh Putra (ALL_MALE)';
            } else if (tomorrowDay === 6) {
                classListStr = 'DHUHA: IX-K | DHUHUR: VII-J, VII-K, VIII-J, VIII-K, IX-G';
            }
            document.getElementById('h1ModalTomorrowClasses').innerText = classListStr;

            document.getElementById('h1ResultAlert').classList.add('hidden');
            const btn = document.getElementById('btnConfirmSendH1');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>🚀</span> <span>Kirim Pengingat Sekarang</span>';
            }

            modal.classList.remove('hidden');
        }

