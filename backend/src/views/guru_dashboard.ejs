        async function populateTeacherTeachingClasses() {
            let classesToUse = [];
            let teacherSubject = '';
            try {
                const res = await authFetch('/api/guru/my-classes');
                if (res.ok) {
                    const data = await res.json();
                    if (data.teacher) {
                        if (Array.isArray(data.teacher.assignedClasses) && data.teacher.assignedClasses.length > 0) {
                            classesToUse = data.teacher.assignedClasses;
                        }
                        if (data.teacher.subject && data.teacher.subject !== 'Semua Mata Pelajaran') {
                            teacherSubject = data.teacher.subject;
                        }
                    }
                    if (classesToUse.length === 0 && Array.isArray(data.allClasses)) {
                        classesToUse = data.allClasses.map(c => c.name);
                    }
                }
            } catch (e) {
                console.warn('Gagal memuat kelas ampu guru dari API:', e);
            }

            if (classesToUse.length === 0 && userPayload && userPayload.teachingClasses) {
                try {
                    classesToUse = userPayload.teachingClasses.startsWith('[')
                        ? JSON.parse(userPayload.teachingClasses)
                        : userPayload.teachingClasses.split(',').map(c => c.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
                } catch (e) {
                    classesToUse = userPayload.teachingClasses.split(',').map(c => c.trim()).filter(Boolean);
                }
            }

            if (classesToUse.length === 0 && userPayload && userPayload.className) {
                classesToUse = [userPayload.className];
            }

            if (!teacherSubject && userPayload && userPayload.teachingSubject) {
                teacherSubject = userPayload.teachingSubject;
            }

            // 1. Target Kelas Ulangan Harian (uhKelasId)
            const elUhKelas = document.getElementById('uhKelasId');
            if (elUhKelas && classesToUse.length > 0) {
                elUhKelas.innerHTML = classesToUse.map(cls => `<option value="${cls}">Kelas ${cls} (Kelas Ampuan)</option>`).join('');
            }

            // 2. Target Kelas Tugas & PR (chHwClass)
            const elHwClass = document.getElementById('chHwClass');
            if (elHwClass && classesToUse.length > 0) {
                elHwClass.innerHTML = classesToUse.map(cls => `<option value="${cls}">Kelas ${cls} (Kelas Ampuan)</option>`).join('');
            }

            // 3. Target Kelas Broadcast Pengumuman (broadcastClass)
            const elBcastClass = document.getElementById('broadcastClass');
            if (elBcastClass && classesToUse.length > 0) {
                elBcastClass.innerHTML = classesToUse.map(cls => `<option value="${cls}">Kelas ${cls} (Kelas Ampuan)</option>`).join('');
            }

            // 4. Auto-fill mata pelajaran jika tersedia
            if (teacherSubject) {
                const elUhMapel = document.getElementById('uhMapelId');
                if (elUhMapel) elUhMapel.value = teacherSubject;
                const elHwSubject = document.getElementById('chHwSubject');
                if (elHwSubject) elHwSubject.value = teacherSubject;
            }
        }
