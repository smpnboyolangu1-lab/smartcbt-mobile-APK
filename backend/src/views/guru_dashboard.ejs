        function syncPaiChipSelection() {
            const val = document.getElementById('inputPaiClassNames')?.value?.trim() || '';
            const currentList = val.split(',').map(s => s.trim().toUpperCase());
            document.querySelectorAll('.pai-class-chip').forEach(btn => {
                const c = btn.getAttribute('data-class');
                if (c && currentList.includes(c.toUpperCase())) {
                    btn.className = 'pai-class-chip px-2 py-1 rounded-lg text-[10.5px] font-mono font-bold bg-emerald-600 text-white border border-emerald-400 shadow-sm transition-all cursor-pointer';
                } else {
                    btn.className = 'pai-class-chip px-2 py-1 rounded-lg text-[10.5px] font-mono font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-all cursor-pointer';
                }
            });
        }

        function togglePaiClassChip(className) {
            const input = document.getElementById('inputPaiClassNames');
            if (!input) return;
            let current = input.value.trim();
            if (current === 'ALL_MALE') current = '';
            let list = current ? current.split(',').map(s => s.trim()).filter(Boolean) : [];

            const idx = list.indexOf(className);
            if (idx >= 0) {
                list.splice(idx, 1);
            } else {
                list.push(className);
            }
            input.value = list.join(',');
            syncPaiChipSelection();
        }

        function quickSelectPaiClasses(mode) {
            const input = document.getElementById('inputPaiClassNames');
            if (!input) return;
            const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K'];

            if (mode === 'CLEAR') {
                input.value = '';
            } else if (mode === 'ALL_MALE') {
                input.value = 'ALL_MALE';
                const typeSelect = document.getElementById('selectPaiPrayerType');
                if (typeSelect) typeSelect.value = 'JUMAT';
                const barcodeSelect = document.getElementById('selectPaiBarcodeKey');
                if (barcodeSelect) barcodeSelect.value = 'BARCODE_SHOLAT_JUMAT_MASJID';
            } else if (mode === '7') {
                const add7 = letters.map(l => `VII-${l}`);
                let list = input.value.trim() ? input.value.split(',').map(s=>s.trim()).filter(Boolean) : [];
                add7.forEach(c => { if (!list.includes(c)) list.push(c); });
                input.value = list.join(',');
            } else if (mode === '8') {
                const add8 = letters.map(l => `VIII-${l}`);
                let list = input.value.trim() ? input.value.split(',').map(s=>s.trim()).filter(Boolean) : [];
                add8.forEach(c => { if (!list.includes(c)) list.push(c); });
                input.value = list.join(',');
            } else if (mode === '9') {
                const add9 = letters.map(l => `IX-${l}`);
                let list = input.value.trim() ? input.value.split(',').map(s=>s.trim()).filter(Boolean) : [];
                add9.forEach(c => { if (!list.includes(c)) list.push(c); });
                input.value = list.join(',');
            }
            syncPaiChipSelection();
        }

        function onPrayerScheduleTypeOrDayChanged() {
            const dayOfWeek = Number(document.getElementById('selectPaiDayOfWeek')?.value || 1);
            const prayerType = document.getElementById('selectPaiPrayerType')?.value || 'DHUHUR';
            populatePrayerFormForDay(dayOfWeek, prayerType);
        }

        function populatePrayerFormForDay(dayOfWeek, prayerType = null) {
            const daySelect = document.getElementById('selectPaiDayOfWeek');
            if (daySelect) daySelect.value = String(dayOfWeek);

            const typeSelect = document.getElementById('selectPaiPrayerType');
            let targetType = prayerType;
            if (!targetType) {
                const daySchedules = weeklyPrayerSchedules.filter(s => s.dayOfWeek === dayOfWeek);
                targetType = daySchedules.length > 0 ? daySchedules[0].prayerType : (dayOfWeek === 5 ? 'JUMAT' : 'DHUHUR');
            }
            if (typeSelect) typeSelect.value = targetType;

            const sched = weeklyPrayerSchedules.find(s => s.dayOfWeek === dayOfWeek && s.prayerType === targetType) || null;

            const idInput = document.getElementById('inputPaiScheduleId');
            const barcodeSelect = document.getElementById('selectPaiBarcodeKey');
            const classInput = document.getElementById('inputPaiClassNames');
            const wudhuInput = document.getElementById('inputPaiWudhuTime');
            const startInput = document.getElementById('inputPaiScanStartTime');
            const endInput = document.getElementById('inputPaiScanEndTime');
            const notesInput = document.getElementById('inputPaiScheduleNotes');

            if (idInput) idInput.value = sched ? sched.id : '';

            const defaultBarcode = targetType === 'DHUHA'
                ? 'BARCODE_SHOLAT_DHUHA_MASJID'
                : (targetType === 'JUMAT' ? 'BARCODE_SHOLAT_JUMAT_MASJID' : 'BARCODE_SHOLAT_DHUHUR_MASJID');
            const defaultWudhu = targetType === 'DHUHA' ? '06:45' : (targetType === 'JUMAT' ? '11:30' : '11:45');
            const defaultStart = targetType === 'DHUHA' ? '07:00' : (targetType === 'JUMAT' ? '11:45' : '12:00');
            const defaultEnd = targetType === 'DHUHA' ? '07:45' : (targetType === 'JUMAT' ? '12:45' : '12:30');

            if (sched) {
                if (barcodeSelect) barcodeSelect.value = sched.barcodeKey || defaultBarcode;
                if (classInput) classInput.value = sched.classNames || (targetType === 'JUMAT' ? 'ALL_MALE' : '');
                if (wudhuInput) wudhuInput.value = sched.wudhuTime || defaultWudhu;
                if (startInput) startInput.value = sched.scanStartTime || defaultStart;
                if (endInput) endInput.value = sched.scanEndTime || defaultEnd;
                if (notesInput) notesInput.value = sched.notes || '';
            } else {
                if (barcodeSelect) barcodeSelect.value = defaultBarcode;
                if (classInput) classInput.value = targetType === 'JUMAT' ? 'ALL_MALE' : '';
                if (wudhuInput) wudhuInput.value = defaultWudhu;
                if (startInput) startInput.value = defaultStart;
                if (endInput) endInput.value = defaultEnd;
                if (notesInput) notesInput.value = '';
            }
            syncPaiChipSelection();
        }

        function openPrayerScheduleFormForDay(dayOfWeek, prayerType = null) {
            const form = document.getElementById('panelPrayerScheduleForm');
            if (!form) return;
            form.classList.remove('hidden');
            populatePrayerFormForDay(dayOfWeek, prayerType);
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function renderPrayerScheduleInfo(data) {
            const sched = data.schedule;
            const dayName = data.dayName || 'HARI INI';
            const dayBadge = document.getElementById('paiCurrentDayBadge');
            if (dayBadge) dayBadge.innerText = dayName;

            const availablePrayers = data.availablePrayers || [];
            const switcherPills = document.getElementById('paiPrayerSwitcherPills');
            if (switcherPills) {
                if (availablePrayers.length > 0) {
                    switcherPills.innerHTML = availablePrayers.map(ap => {
                        const isCur = ap.prayerType === sched?.prayerType;
                        const label = ap.prayerType === 'DHUHA' ? '🌅 Sesi Dhuha' : (ap.prayerType === 'JUMAT' ? '🕌 Sholat Jumat' : '☀️ Sesi Dhuhur');
                        const cls = isCur
                            ? 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-700 text-white shadow-sm'
                            : 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 hover:bg-emerald-200 cursor-pointer transition-colors';
                        return `<button type="button" onclick="switchTodayPrayerSession('${ap.prayerType}')" class="${cls}">${label}</button>`;
                    }).join('');
                } else {
                    switcherPills.innerHTML = '';
                }
            }

            const typeLabel = document.getElementById('paiPrayerTypeLabel');
            const schedClasses = document.getElementById('paiScheduledClasses');
            const timesEl = document.getElementById('paiPrayerTimes');
            const notesEl = document.getElementById('paiPrayerNotes');
            const barCodeEl = document.getElementById('paiActiveBarcodeCode');

            if (!sched) {
                if (typeLabel) typeLabel.innerText = 'TIDAK ADA JADWAL SESI INI';
                if (schedClasses) schedClasses.innerText = `Rombel Terjadwal: Tidak ada rombel terjadwal`;
                if (timesEl) {
                    const avSess = (data.availablePrayers || []).map(a => a.prayerType).join(' & ');
                    timesEl.innerText = `ℹ️ Catatan GPAI: Hari ${dayName} terjadwal untuk ${avSess || 'Sholat Dhuhur'}. Sholat Dhuha terjadwal pada hari Jumat & Sabtu pagi (07:00-07:45 WIB).`;
                }
                if (notesEl) notesEl.innerText = 'Silakan pilih sesi aktif di atas untuk memantau presensi rombel.';
                if (barCodeEl) barCodeEl.innerText = '-';
                return;
            }

            if (typeLabel) {
                typeLabel.innerText = sched.prayerType === 'JUMAT' 
                    ? 'SHOLAT JUMAT BERJAMAAH & KEPUTRIAN' 
                    : (sched.prayerType === 'DHUHA' ? 'SHOLAT DHUHA BERJAMAAH (PAGI)' : 'SHOLAT DHUHUR BERJAMAAH');
            }

            if (schedClasses) {
                schedClasses.innerText = `Rombel Terjadwal: ${sched.classNames || 'Seluruh Siswa'}`;
            }

            if (timesEl) {
                timesEl.innerText = `💧 Mulai Wudhu: ${sched.wudhuTime || (sched.prayerType === 'DHUHA' ? '06:45' : '11:45')} WIB • 📷 Scan Presensi: ${sched.scanStartTime || (sched.prayerType === 'DHUHA' ? '07:00' : '12:00')} - ${sched.scanEndTime || (sched.prayerType === 'DHUHA' ? '07:45' : '12:30')} WIB`;
            }

            if (notesEl) {
                notesEl.innerText = sched.notes || 'Siswa wajib hadir dan memindai barcode statik di masjid sekolah.';
            }

            if (barCodeEl) {
                barCodeEl.innerText = sched.barcodeKey || (sched.prayerType === 'DHUHA' ? 'BARCODE_SHOLAT_DHUHA_MASJID' : 'BARCODE_SHOLAT_DHUHUR_MASJID');
            }

            // Sync monitoring prayer type selector
            const monTypeSelect = document.getElementById('selectPaiMonitoringPrayerType');
            if (monTypeSelect) {
                monTypeSelect.value = sched.prayerType;
            }

            // Pilih otomatis kelas pertama dari jadwal jika belum diubah
            const selectClass = document.getElementById('selectPaiClassFilter');
            if (selectClass && sched?.classNames && sched.classNames !== 'ALL_MALE') {
                const firstClass = sched.classNames.split(',')[0].trim();
                if (firstClass && Array.from(selectClass.options).some(o => o.value === firstClass)) {
                    selectClass.value = firstClass;
                }
            }
        }

