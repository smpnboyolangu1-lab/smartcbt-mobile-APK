        async function loadMyTeacherLeaves() {
            // Ambil Rekap Kehadiran, Keterlambatan & Cuti 360° Guru
            try {
                const recapRes = await authFetch('/api/teacher/attendance/recap');
                const recapData = await recapRes.json();
                if (recapData.success && recapData.rekap) {
                    const r = recapData.rekap;
                    const elTepat = document.getElementById('kpiTeacherTepatWaktu');
                    const elTerlambat = document.getElementById('kpiTeacherTerlambat');
                    const elTerlambatMenit = document.getElementById('kpiTeacherTerlambatMenit');
                    const elAlfa = document.getElementById('kpiTeacherAlfa');
                    const elIzinSakit = document.getElementById('kpiTeacherIzinSakit');
                    const elIzinDetail = document.getElementById('kpiTeacherIzinDetail');
                    const elCuti = document.getElementById('kpiTeacherCuti');
                    const elCutiHari = document.getElementById('kpiTeacherCutiHari');

                    if (elTepat) elTepat.textContent = `${r.tepatWaktu || 0}x`;
                    if (elTerlambat) elTerlambat.textContent = `${r.terlambat || 0}x`;
                    if (elTerlambatMenit) elTerlambatMenit.textContent = `${r.terlambatMenitTotal || 0} Menit Akumulasi`;
                    if (elAlfa) elAlfa.textContent = `${r.alfa || 0}x`;
                    if (elIzinSakit) elIzinSakit.textContent = `${(r.izin || 0) + (r.sakit || 0)}x`;
                    if (elIzinDetail) elIzinDetail.textContent = `Izin: ${r.izin || 0} • Sakit: ${r.sakit || 0}`;
                    if (elCuti) elCuti.textContent = `${r.cutiCount || 0}x`;
                    if (elCutiHari) elCutiHari.textContent = `${r.cutiHariTotal || 0} Hari Disetujui Kurikulum`;
                }
            } catch (errRecap) {
                console.error('Error loadTeacherRecap in Portal:', errRecap);
            }

            const tbody = document.getElementById('tableMyLeavesBody');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-400">Memuat riwayat permohonan izin Anda...</td></tr>';
            try {
                const res = await authFetch('/api/teacher/leave-requests/my');
                const data = await res.json();
                if (!data.success || !data.leaves || data.leaves.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-400">Belum ada riwayat permohonan izin yang diajukan.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.leaves.map((item, idx) => {
                    const startStr = item.startDate ? new Date(item.startDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
                    const endStr = item.endDate ? new Date(item.endDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : startStr;
                    const dateDisplay = startStr === endStr ? startStr : `${startStr} - ${endStr}`;
                    
                    let badgeClass = 'bg-amber-100 text-amber-800 border-amber-300';
                    let badgeText = '⏳ Menunggu Kurikulum';
                    if (item.status === 'APPROVED') {
                        badgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                        badgeText = '✅ Disetujui (Disposisi ke Piket)';
                    } else if (item.status === 'REJECTED') {
                        badgeClass = 'bg-rose-100 text-rose-800 border-rose-300';
                        badgeText = '❌ Ditolak';
                    }

                    const attachmentBtn = item.attachmentUrl ? `<a href="${item.attachmentUrl}" target="_blank" class="text-blue-600 underline font-bold text-[11px] block mt-1">📎 Lihat Lampiran</a>` : '';

                    return `
                        <tr class="hover:bg-slate-50 transition-colors border-b">
                            <td class="p-3 text-center font-bold text-slate-400">${idx + 1}</td>
                            <td class="p-3 font-bold text-slate-800">
                                <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 text-[11px] font-black">${item.category || item.jenis || 'IZIN'}</span>
                                ${attachmentBtn}
                            </td>
                            <td class="p-3 font-semibold text-slate-700 whitespace-nowrap">${dateDisplay}</td>
                            <td class="p-3 text-slate-600 max-w-xs break-words">${item.reason || '-'}</td>
                            <td class="p-3 text-slate-600 max-w-xs break-words">${item.assignmentDetails || item.assignmentForStudents || '-'}</td>
                            <td class="p-3 text-center">
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold border ${badgeClass}">
                                    ${badgeText}
                                </span>
                            </td>
                            <td class="p-3 text-slate-500 text-[11px]">
                                ${item.approvalNotes || item.catatanKurikulum || (item.approvedBy ? `Oleh: ${item.approvedBy}` : '-')}
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                console.error('Error loadMyTeacherLeaves:', err);
                tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-rose-500">Gagal memuat data izin. Silakan coba lagi.</td></tr>';
            }
        }

        async function handleTeacherLeaveSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitTeacherLeave');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳</span> Mengirim Permohonan...';
            }

            try {
                const category = document.getElementById('tlCategory').value;
                const startDate = document.getElementById('tlStartDate').value;
                const endDate = document.getElementById('tlEndDate').value;
                const reason = document.getElementById('tlReason').value.trim();
                const assignment = document.getElementById('tlAssignment').value.trim();
                const fileInput = document.getElementById('tlAttachment');

                let attachmentBase64 = null;
                if (fileInput && fileInput.files && fileInput.files[0]) {
                    const file = fileInput.files[0];
                    if (file.size > 5 * 1024 * 1024) {
                        alert('Ukuran file maksimal 5MB.');
                        if (btn) { btn.disabled = false; btn.innerHTML = '<span>🚀</span> Kirim Permohonan ke Kurikulum'; }
                        return;
                    }
                    attachmentBase64 = await new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve(reader.result);
                        reader.onerror = reject;
                        reader.readAsDataURL(file);
                    });
                }

                const payload = {
                    category,
                    startDate,
                    endDate: endDate || startDate,
                    reason,
                    assignmentDetails: assignment,
                    assignmentForStudents: assignment,
                    attachmentBase64
                };

                const res = await authFetch('/api/teacher/leave-request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success) {
                    alert('Permohonan izin berhasil diajukan dan sedang menunggu persetujuan Tim Kurikulum.');
                    document.getElementById('formTeacherLeave').reset();
                    loadMyTeacherLeaves();
                } else {
                    alert(data.message || 'Gagal mengirim permohonan izin.');
                }
            } catch (err) {
                console.error('Error handleTeacherLeaveSubmit:', err);
                alert('Terjadi kesalahan koneksi saat mengirim permohonan.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>🚀</span> Kirim Permohonan ke Kurikulum';
                }
            }
        }

        // ==========================================
        // LAYANAN TPP GURU: TRIWULAN SELECTOR & LOCK HIJAU
        // ==========================================
        let currentTppData = null;
        let selectedTppTriwulan = 1;

        async function loadTeacherTppData() {
            const tahunSelect = document.getElementById('tppTahunSelect');
            const targetYear = tahunSelect ? tahunSelect.value : new Date().getFullYear();
            const container = document.getElementById('tppMonthsContainer');
            if (container) {
                container.innerHTML = `
                    <div class="col-span-3 text-center py-10 text-slate-400">
                        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-emerald-600 border-t-transparent mb-2"></div>
                        <p class="font-bold text-xs">Memuat data TPP Triwulan ${selectedTppTriwulan}...</p>
                    </div>
                `;
            }

            try {
                const res = await authFetch(`/api/tpp/my-tpp?tahun=${targetYear}`);
                const data = await res.json();
                if (data.success) {
                    currentTppData = data;
                    // Update stats
                    const totalCair = data.summary?.totalBulanCair || 0;
                    const totalBelum = data.summary?.totalBulanBelumCair || 0;
                    const statCairEl = document.getElementById('tppStatSudahCair');
                    if (statCairEl) statCairEl.innerText = `${totalCair} / 12 Bulan`;
                    const statBelumEl = document.getElementById('tppStatBelumCair');
                    if (statBelumEl) statBelumEl.innerText = `${totalBelum} Bulan`;

                    // Update TW badge status
                    if (data.triwulan) {
                        data.triwulan.forEach(tw => {
                            const badge = document.getElementById(`badgeTw${tw.triwulan}Status`);
                            if (badge) {
                                if (tw.status === 'SUDAH_CAIR') {
                                    badge.className = 'px-2 py-0.5 rounded text-[10px] font-black bg-emerald-600 text-white';
                                    badge.innerText = '🔒 SUDAH CAIR';
                                } else {
                                    badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-800 border border-amber-300';
                                    badge.innerText = 'BELUM CAIR';
                                }
                            }
                        });
                    }

                    renderTppMonths();
                } else {
                    if (container) {
                        container.innerHTML = `<div class="col-span-3 p-4 bg-red-50 text-red-700 text-xs font-bold rounded-2xl border border-red-200">Gagal memuat data TPP: ${data.message || 'Terjadi kesalahan'}</div>`;
                    }
                }
            } catch (err) {
                console.error('Error loadTeacherTppData:', err);
                if (container) {
                    container.innerHTML = `<div class="col-span-3 p-4 bg-red-50 text-red-700 text-xs font-bold rounded-2xl border border-red-200">Gagal menghubungi server TPP: ${err.message}</div>`;
                }
            }
        }

        function selectTppTriwulan(tw) {
            selectedTppTriwulan = tw;

            // Highlight active button
            for (let i = 1; i <= 4; i++) {
                const btn = document.getElementById(`btnTppTw${i}`);
                if (btn) {
                    if (i === tw) {
                        btn.className = 'tpp-tw-btn px-4 py-3.5 rounded-2xl border-2 font-black text-xs text-left transition-all cursor-pointer flex flex-col justify-between border-emerald-600 bg-emerald-50 text-emerald-900 shadow-sm';
                    } else {
                        btn.className = 'tpp-tw-btn px-4 py-3.5 rounded-2xl border border-slate-200 font-black text-xs text-left transition-all cursor-pointer flex flex-col justify-between hover:bg-slate-50 text-slate-700';
                    }
                }
            }

            const rangeNames = {
                1: 'Januari – Maret',
                2: 'April – Juni',
                3: 'Juli – September',
                4: 'Oktober – Desember'
            };

            const twBulan = rangeNames[tw] || '';
            const statTwEl = document.getElementById('tppStatTwAktif');
            if (statTwEl) statTwEl.innerText = `TW ${tw}`;
            const statTwBulanEl = document.getElementById('tppStatTwBulan');
            if (statTwBulanEl) statTwBulanEl.innerText = twBulan;
            const indicatorEl = document.getElementById('tppActiveTwIndicator');
            if (indicatorEl) indicatorEl.innerText = `Sedang Ditampilkan: Triwulan ${tw} (${twBulan})`;
            const titleEl = document.getElementById('tppMonthsTitle');
            if (titleEl) titleEl.innerText = `DAFTAR BULAN PADA TRIWULAN ${tw} (${twBulan.toUpperCase()})`;

            renderTppMonths();
        }

        function renderTppMonths() {
            const container = document.getElementById('tppMonthsContainer');
            if (!container) return;

            if (!currentTppData || !currentTppData.triwulan) {
                container.innerHTML = `<div class="col-span-3 text-center py-6 text-slate-400 text-xs font-semibold">Data TPP belum dimuat. Silakan klik Refresh.</div>`;
                return;
            }

            const twObj = currentTppData.triwulan.find(t => t.triwulan === selectedTppTriwulan);
            if (!twObj || !twObj.months || twObj.months.length === 0) {
                container.innerHTML = `<div class="col-span-3 text-center py-6 text-slate-400 text-xs font-semibold">Tidak ada bulan pada Triwulan ini.</div>`;
                return;
            }

            const todayStr = new Date().toISOString().split('T')[0];

            container.innerHTML = twObj.months.map(m => {
                const isCair = m.status === 'SUDAH_CAIR';

                if (isCair) {
                    // LOCK HIJAU: Emerald Green, 🔒 Padlock, Locked State
                    return `
                        <div class="border-2 border-emerald-500 bg-emerald-50/80 rounded-3xl p-5 shadow-md flex flex-col justify-between transition-all hover:shadow-lg">
                            <div class="space-y-3">
                                <div class="flex items-center justify-between pb-3 border-b border-emerald-200">
                                    <div>
                                        <span class="text-[10px] font-black uppercase text-emerald-800 tracking-wider">BULAN #${m.bulan} • TW ${twObj.triwulan}</span>
                                        <h4 class="text-lg font-black text-emerald-950">${m.namaBulan}</h4>
                                    </div>
                                    <span class="px-3 py-1 rounded-xl text-xs font-black bg-emerald-600 text-white flex items-center gap-1 shadow-sm">
                                        <span>🔒</span> SUDAH CAIR
                                    </span>
                                </div>

                                <div class="bg-white/80 rounded-2xl p-3.5 border border-emerald-200 space-y-2 text-xs">
                                    <div class="flex items-center justify-between">
                                        <span class="text-emerald-800 font-semibold">Tanggal Pencairan:</span>
                                        <span class="font-black font-mono text-emerald-950">${m.tanggalCairStr && m.tanggalCairStr !== '-' ? m.tanggalCairStr : 'Tercatat'}</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-emerald-800 font-semibold">No. Referensi:</span>
                                        <span class="font-mono text-[11px] text-emerald-900 font-bold">${m.noReferensi && m.noReferensi !== '-' ? m.noReferensi : 'TPP-KEMENKEU-SP2D'}</span>
                                    </div>
                                    <div class="flex items-center justify-between pt-1 border-t border-emerald-100">
                                        <span class="text-emerald-800 font-semibold">Status Kunci:</span>
                                        <span class="font-extrabold text-emerald-700 flex items-center gap-1">
                                            <span>🔒</span> Terkunci Permanen
                                        </span>
                                    </div>
                                </div>

                                <div class="p-2.5 bg-emerald-100/60 rounded-xl border border-emerald-300 text-[11px] text-emerald-900 leading-relaxed">
                                    <b>Catatan:</b> ${m.catatan || 'Laporan pencairan tervalidasi.'}
                                </div>
                            </div>

                            <div class="pt-4 mt-3 border-t border-emerald-200">
                                <button type="button" onclick="showTppLockedNotice('${m.namaBulan}', '${m.tanggalCairStr || '-'}')" class="w-full py-2.5 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-black text-xs flex items-center justify-center gap-2 shadow transition-all cursor-pointer">
                                    <span>🔒</span> Status Terkunci (Sudah Cair)
                                </button>
                            </div>
                        </div>
                    `;
                } else {
                    // BELUM CAIR: Slate/Neutral, Input Tanggal, Dapat Dilaporkan
                    return `
                        <div class="border border-slate-300 bg-white rounded-3xl p-5 shadow-sm flex flex-col justify-between transition-all hover:border-slate-400">
                            <div class="space-y-3">
                                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                                    <div>
                                        <span class="text-[10px] font-black uppercase text-slate-400 tracking-wider">BULAN #${m.bulan} • TW ${twObj.triwulan}</span>
                                        <h4 class="text-lg font-black text-slate-800">${m.namaBulan}</h4>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300 flex items-center gap-1">
                                        <span>⏳</span> Belum Cair
                                    </span>
                                </div>

                                <div class="space-y-2 text-xs">
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Tanggal Pencairan Rekening:</label>
                                        <input type="date" id="inputCairDate_${m.bulan}" value="${todayStr}" class="w-full px-3 py-2 border border-slate-300 rounded-xl font-bold text-slate-800 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Catatan Tambahan (Opsional):</label>
                                        <input type="text" id="inputCatatan_${m.bulan}" placeholder="Cth: Cair Bank Jatim..." class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                    </div>
                                </div>

                                <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-[11px] text-slate-500">
                                    Setelah dilaporkan, status langsung beralih ke <b>🔒 Lock Hijau</b> dan tidak bisa diubah kembali oleh guru.
                                </div>
                            </div>

                            <div class="pt-4 mt-3 border-t border-slate-100">
                                <button type="button" onclick="submitTeacherTpp('${m.id}', ${m.bulan}, '${m.namaBulan}')" class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs flex items-center justify-center gap-2 shadow transition-all cursor-pointer">
                                    <span>✅</span> Laporkan Sudah Cair
                                </button>
                            </div>
                        </div>
                    `;
                }
            }).join('');
        }

        async function submitTeacherTpp(recordId, monthNumber, monthName) {
            const inputDateEl = document.getElementById(`inputCairDate_${monthNumber}`);
            const inputDate = inputDateEl ? inputDateEl.value : new Date().toISOString().split('T')[0];
            const catatanEl = document.getElementById(`inputCatatan_${monthNumber}`);
            const catatan = catatanEl && catatanEl.value.trim() ? catatanEl.value.trim() : `Laporan mandiri guru: Sudah Cair ${monthName}`;

            if (!inputDate) {
                alert('Harap masukkan tanggal pencairan yang valid!');
                return;
            }

            if (!confirm(`Konfirmasi Laporan TPP Bulan ${monthName}:\n\nTanggal Pencairan: ${inputDate}\n\nPERINGATAN: Setelah status dilaporkan SUDAH CAIR, sistem akan LANGSUNG MENGUNCI STATUS (🔒 Lock Hijau) secara otomatis.\n\nApakah Anda yakin ingin menyimpan dan mengunci?`)) {
                return;
            }

            try {
                const res = await authFetch('/api/tpp/teacher/report', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        tppRecordId: recordId,
                        status: 'SUDAH_CAIR',
                        tanggalCairStr: inputDate,
                        catatan: catatan
                    })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`✅ BERHASIL DIKUNCI!\n\n${data.message || 'Laporan pencairan berhasil disimpan dan terkunci otomatis.'}`);
                    loadTeacherTppData();
                } else {
                    alert(`Gagal: ${data.message || 'Terjadi kesalahan'}`);
                }
            } catch (err) {
                console.error('Error submitTeacherTpp:', err);
                alert('Terjadi kesalahan koneksi ke server: ' + err.message);
            }
        }

        function showTppLockedNotice(monthName, tanggalCairStr) {
            alert(`🔒 STATUS TERKUNCI RESMI (LOCK HIJAU)\n\nTPP Bulan ${monthName} telah berstatus SUDAH CAIR (Tanggal: ${tanggalCairStr}).\n\nData yang telah berstatus cair terkunci secara otomatis demi integritas rekonsiliasi Kurikulum & Operator.\n\nJika terdapat kesalahan pencatatan atau perlu revisi tanggal, silakan hubungi Tim Kurikulum atau Operator.`);
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '/';
        }
    </script>

