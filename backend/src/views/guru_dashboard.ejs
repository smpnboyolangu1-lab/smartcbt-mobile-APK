                    loadTeacherHomeworks();
                } else {
                    alert('❌ Gagal membuat tugas: ' + (data.message || 'Error server'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Publikasikan Tugas';
            }
        }

