        function renderTahfizDashboardStats(data) {
            const kpi = data.kpi || data.summary || {};
            const total = kpi.totalStudents ?? kpi.studentsCount ?? data.totalStudents ?? 0;
            const tuntas = kpi.targetTuntas ?? 0;
            const pending = kpi.pendingSetoran ?? kpi.setoranMenunggu ?? 0;
            const murojaah = kpi.needMurojaah ?? kpi.murojaahPerlu ?? 0;

            if (document.getElementById('tahfizKpiTotalStudents')) {
                document.getElementById('tahfizKpiTotalStudents').innerText = total;
            }
            if (document.getElementById('tahfizKpiTargetTuntas')) {
                document.getElementById('tahfizKpiTargetTuntas').innerText = tuntas;
            }
            if (document.getElementById('tahfizKpiPendingSetoran')) {
                document.getElementById('tahfizKpiPendingSetoran').innerText = pending;
            }
            if (document.getElementById('tahfizKpiNeedMurojaah')) {
                document.getElementById('tahfizKpiNeedMurojaah').innerText = murojaah;
            }
            const badgePending = document.getElementById('badgeTahfizPendingTab');
            if (badgePending) {
                if (pending > 0) {
                    badgePending.innerText = pending;
                    badgePending.classList.remove('hidden');
                } else {
                    badgePending.classList.add('hidden');
                }
            }
        }

        function switchTahfizSubTab(subId) {
            const subTabs = ['peta', 'setoran', 'target', 'murojaah', 'prestasi'];
            subTabs.forEach(s => {
                const btn = document.getElementById('btnTahfizSub' + s.charAt(0).toUpperCase() + s.slice(1));
                const pane = document.getElementById('tahfizSubPane' + s.charAt(0).toUpperCase() + s.slice(1));
                if (btn && pane) {
                    if (s === subId) {
                        btn.className = 'tahfiz-sub-btn px-4 py-2 rounded-xl bg-emerald-600 text-white shadow-sm flex items-center gap-1.5 cursor-pointer';
                        pane.classList.remove('hidden');
                    } else {
                        btn.className = 'tahfiz-sub-btn px-4 py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center gap-1.5 cursor-pointer';
                        pane.classList.add('hidden');
                    }
                }
            });
            if (subId === 'peta') loadTahfizProgressMatrix();
            else if (subId === 'setoran') loadTahfizSetoranList();
            else if (subId === 'target') loadTahfizTargetList();
            else if (subId === 'murojaah') loadTahfizMurojaahList();
