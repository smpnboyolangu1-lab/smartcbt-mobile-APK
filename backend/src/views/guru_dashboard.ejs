                        el.className = 'px-3 py-1 rounded-lg font-bold bg-emerald-700 text-white';
                    } else {
                        el.className = 'px-3 py-1 rounded-lg font-bold text-slate-600 hover:bg-slate-100';
                    }
                }
            });
            renderPaiStudentsTable(currentPaiPrayerStudents);
