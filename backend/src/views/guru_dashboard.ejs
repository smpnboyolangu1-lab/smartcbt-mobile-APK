        function removeCbtLightQuestion(index) {
            cbtLightQuestions.splice(index, 1);
            renderCbtLightQuestions();
        }

        function updateCbtQuestionField(idx, field, val, optIdx = null) {
            if (optIdx !== null) {
                cbtLightQuestions[idx].options[optIdx] = val;
            } else {
                cbtLightQuestions[idx][field] = field === 'points' ? Number(val) : val;
            }
            updateCbtQuestionsSummary();
        }

        function updateCbtQuestionsSummary() {
            const summaryEl = document.getElementById('cbtLightQuestionsSummary');
            if (!summaryEl) return;
            const totalPoints = cbtLightQuestions.reduce((sum, q) => sum + (Number(q.points) || 0), 0);
            summaryEl.innerText = `${cbtLightQuestions.length} Soal • Total Bobot Skor: ${totalPoints}`;
        }

        function renderCbtLightQuestions() {
            const container = document.getElementById('cbtLightQuestionsContainer');
            if (!container) return;
            if (cbtLightQuestions.length === 0) {
                container.innerHTML = '<p class="text-xs text-gray-400 text-center py-2">Belum ada butir soal. Klik "+ Tambah Butir Soal" di atas.</p>';
                updateCbtQuestionsSummary();
                return;
            }

            container.innerHTML = cbtLightQuestions.map((q, idx) => `
                <div class="bg-white p-3.5 rounded-2xl border border-emerald-200 shadow-sm space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="font-extrabold text-emerald-900 text-xs">Soal #${idx + 1}</span>
                        <div class="flex items-center gap-2">
                            <label class="text-[11px] font-bold text-gray-500">Bobot Skor:</label>
                            <input type="number" min="1" max="100" value="${q.points || 10}" onchange="updateCbtQuestionField(${idx}, 'points', this.value)" class="w-16 border rounded-lg px-2 py-0.5 text-xs text-center font-bold">
                            <button type="button" onclick="removeCbtLightQuestion(${idx})" class="text-rose-500 hover:text-rose-700 text-xs font-bold px-1.5 py-0.5 cursor-pointer" title="Hapus Soal">&times; Hapus</button>
                        </div>
                    </div>
                    <div>
                        <textarea placeholder="Tuliskan teks pertanyaan soal #${idx + 1}..." oninput="updateCbtQuestionField(${idx}, 'question', this.value)" rows="2" class="w-full border rounded-xl p-2 text-xs focus:ring-1 focus:ring-emerald-500">${q.question || ''}</textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        ${['A', 'B', 'C', 'D'].map((letter, optIdx) => `
                            <div class="flex items-center gap-1.5">
                                <span class="w-5 h-5 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-[10px]">${letter}</span>
                                <input type="text" placeholder="Pilihan ${letter}" value="${(q.options && q.options[optIdx]) || ''}" oninput="updateCbtQuestionField(${idx}, 'options', this.value, ${optIdx})" class="w-full border rounded-lg p-1.5 text-xs">
                            </div>
                        `).join('')}
                    </div>
                    <div class="flex items-center gap-3 pt-1 border-t border-slate-100">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[11px] font-bold text-slate-600">Kunci:</span>
                            <select onchange="updateCbtQuestionField(${idx}, 'answerKey', this.value)" class="border rounded-lg px-2 py-1 text-xs font-bold bg-emerald-50 text-emerald-800">
                                <option value="A" ${q.answerKey === 'A' ? 'selected' : ''}>A</option>
                                <option value="B" ${q.answerKey === 'B' ? 'selected' : ''}>B</option>
                                <option value="C" ${q.answerKey === 'C' ? 'selected' : ''}>C</option>
                                <option value="D" ${q.answerKey === 'D' ? 'selected' : ''}>D</option>
                            </select>
                        </div>
                        <input type="text" placeholder="Pembahasan singkat (opsional)" value="${q.explanation || ''}" oninput="updateCbtQuestionField(${idx}, 'explanation', this.value)" class="flex-1 border rounded-lg p-1.5 text-xs text-slate-600">
                    </div>
                </div>
            `).join('');
            updateCbtQuestionsSummary();
        }

