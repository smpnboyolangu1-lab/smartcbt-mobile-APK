                if (data.success) {
                    alert(`✅ Kuncian siswa ${studentName} berhasil dibuka.`);
                    loadProctorClassStudentsWeb();
                } else {
                    alert('Gagal: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Gagal mereset kunci: ' + e.message);
            }
        }

