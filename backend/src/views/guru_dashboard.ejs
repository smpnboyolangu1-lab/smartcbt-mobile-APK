    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const queryToken = urlParams.get('token');
        if (queryToken) {
            localStorage.setItem('token', queryToken);
        }
        let token = localStorage.getItem('token') || queryToken;
        if(!token) window.location.href = '/';

        async function authFetch(url, options = {}) {
            options.headers = options.headers || {};
            let curToken = localStorage.getItem('token');
            if (curToken) options.headers['Authorization'] = 'Bearer ' + curToken;
            let res = await fetch(url, options);
            if (res.status === 401) {
                const rf = localStorage.getItem('refreshToken');
                if (rf) {
                    try {
                        const rRes = await fetch('/api/auth/refresh', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ refreshToken: rf })
                        });
                        const rData = await rRes.json();
                        if (rData.success && rData.token) {
                            localStorage.setItem('token', rData.token);
                            token = rData.token;
                            options.headers['Authorization'] = 'Bearer ' + token;
                            return await fetch(url, options);
                        }
                    } catch(e) {}
                }
            }
            return res;
        }

        let qrInterval = null;
        let qrCountdown = 10;
        let qrcodeObj = null;
        let activeQrClass = 'VII-A';
        let activeQrSubject = 'Matematika Terpadu';
        let allLeaveRequestsTeacher = [];
        let currentHomeroomStudents = [];
        let userPayload = null;

        // Initialize
        checkHomeroomStatus();
        loadTodaySchedule();
        loadTeacherExams();
        loadTeacherHomeworks();
        loadTeacherJournals();
        loadClassesForTeacherLeave();
        loadLeaveRequestsTeacher();

        // Decode User Profile & PAI Check (HANYA tampil untuk Guru PAI)
        try {
            const base64Url = token.split('.')[1];
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            userPayload = JSON.parse(jsonPayload);
            
            if (userPayload.name) {
                const elName = document.getElementById('teacherName');
                if (elName) elName.innerText = userPayload.name;
                const elAvatar = document.getElementById('teacherAvatar');
                if (elAvatar) elAvatar.innerText = userPayload.name.charAt(0).toUpperCase();
            }

            // PAI CHECK: Menu Sholat muncul untuk guru PAI / Agama / Tugas PAI / Admin / Operator
            const subj = String(userPayload.teachingSubject || '').toUpperCase();
            const tTambahan = String(userPayload.tugasTambahan || '').toUpperCase();
            const rolesTambahan = Array.isArray(userPayload.roles_tambahan) ? userPayload.roles_tambahan.map(r => String(r).toLowerCase()) : [];
            const roleUpper = String(userPayload.role || '').toUpperCase();

            const isPaiTeacher = subj.includes('PAI') || subj.includes('AGAMA') || subj.includes('ISLAM') || subj.includes('PENDIDIKAN AGAMA') ||
                                 tTambahan.includes('PAI') || rolesTambahan.includes('pai') || roleUpper === 'ADMIN' || roleUpper === 'OPERATOR';

            const navSholat = document.getElementById('nav-sholat');
            if (navSholat) {
                navSholat.classList.remove('hidden');
                const badge = navSholat.querySelector('span.bg-emerald-500');
                if (badge) {
                    badge.textContent = isPaiTeacher ? 'PAI' : 'REKAP';
                }
            }

            // PENGAWAS CBT & TOKEN CHECK: HANYA untuk Kurikulum dan Operator
            const isOperatorOrAdmin = roleUpper === 'OPERATOR' || roleUpper === 'ADMIN' || rolesTambahan.includes('operator');
            const isKurikulum = rolesTambahan.includes('kurikulum') || tTambahan.includes('KURIKULUM') || isOperatorOrAdmin;
            const isPengawasEligible = isKurikulum || isOperatorOrAdmin;

            const navPengawas = document.getElementById('nav-pengawas');
            if (navPengawas) {
                if (isPengawasEligible) {
                    navPengawas.classList.remove('hidden');
                } else {
                    navPengawas.classList.add('hidden');
                }
            }

            const secKur = document.getElementById('sectionKurikulumPortal');
            if (secKur && isKurikulum) {
                secKur.classList.remove('hidden');
            }
        } catch(e) {}

        if (window.location.pathname.includes('/kurikulum')) {
