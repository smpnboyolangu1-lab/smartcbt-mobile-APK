        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const isMobile = window.innerWidth < 768;
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const floatingTheme = document.getElementById('floatingThemeToggleBtn');
            const backdrop = document.getElementById('portalSidebarBackdrop');
            const sidebar = document.getElementById('portalSidebar');

            if (isMobile) {
                const isOpen = document.body.classList.toggle('sidebar-mobile-open');
                if (backdrop) backdrop.classList.toggle('hidden', !isOpen);
                if (expandBtn) expandBtn.classList.toggle('hidden', isOpen);
                if (floatingTheme) floatingTheme.classList.toggle('hidden', isOpen);
            } else {
                const isCollapsed = document.body.classList.toggle('sidebar-collapsed');
                if (expandBtn) expandBtn.classList.toggle('hidden', !isCollapsed);
                if (floatingTheme) floatingTheme.classList.toggle('hidden', !isCollapsed);
                localStorage.setItem('portal_sidebar_collapsed', isCollapsed ? 'true' : 'false');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isMobile = window.innerWidth < 768;
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const floatingTheme = document.getElementById('floatingThemeToggleBtn');
            const backdrop = document.getElementById('portalSidebarBackdrop');

            if (isMobile) {
                document.body.classList.remove('sidebar-mobile-open');
                if (backdrop) backdrop.classList.add('hidden');
                if (expandBtn) expandBtn.classList.remove('hidden');
                if (floatingTheme) floatingTheme.classList.remove('hidden');
            } else {
                const savedCollapsed = localStorage.getItem('portal_sidebar_collapsed');
                if (savedCollapsed === 'true') {
                    document.body.classList.add('sidebar-collapsed');
                    if (expandBtn) expandBtn.classList.remove('hidden');
                    if (floatingTheme) floatingTheme.classList.remove('hidden');
                } else {
                    document.body.classList.remove('sidebar-collapsed');
                    if (expandBtn) expandBtn.classList.add('hidden');
                    if (floatingTheme) floatingTheme.classList.add('hidden');
                }
            }
        })();

