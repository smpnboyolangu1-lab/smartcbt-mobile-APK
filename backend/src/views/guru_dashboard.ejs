        async function handleMulaiUhSubmit(e) {
            e.preventDefault();
            const kelasId = document.getElementById('uhKelasId').value;
            const mapelId = document.getElementById('uhMapelId').value;
            const topik = document.getElementById('uhTopik').value;
            const mode = document.querySelector('input[name="uhMode"]:checked')?.value || 'KILAT';
            const durasiMenit = Number(document.getElementById('uhDurasiMenit').value) || 15;
            const totalSoal = Number(document.getElementById('uhTotalSoal').value) || 10;
            const sumberSoal = document.getElementById('uhSumberSoal').value;

            const btn = document.getElementById('btnSubmitMulaiUh');
            btn.disabled = true;
            btn.innerHTML = '<span>⏳</span> <span>Memproses...</span>';

            try {
                const res = await authFetch('/api/guru/uh/mulai', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        kelasId,
                        mapelId,
                        topik,
                        mode,
                        durasiMenit,
                        totalSoal,
                        bobotNilai: 100,
                        sumberSoal
                    })
                });
                const json = await res.json();
                if (json.success && json.data) {
                    activeUhId = json.data.id;
                    alert(`✅ Ulangan Harian Mode ${mode} BERHASIL DIMULAI untuk kelas ${kelasId}!`);
                    loadUhMonitoring();
                    if (!uhPollInterval) {
                        uhPollInterval = setInterval(loadUhMonitoring, 5000);
                    }
                } else {
                    alert('Gagal memulai: ' + (json.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Terjadi kesalahan jaringan: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>🚀</span> <span>Mulai Ulangan di Kelas</span>';
            }
        }

