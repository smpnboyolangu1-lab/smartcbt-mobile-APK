        async function loadTeacherQuestions(examId) {
            const listContainer = document.getElementById('tqeQuestionList');
            const countEl = document.getElementById('tqeCount');
            if (!listContainer) return;
            listContainer.innerHTML = '<p class="text-slate-400 py-6 text-center text-xs">Memuat butir soal...</p>';
            try {
                const res = await fetch(`/api/guru/exams/${examId}/questions`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (Array.isArray(data)) {
                    teacherQuestionsList = data;
                    if (countEl) countEl.innerText = data.length;
                    if (data.length === 0) {
                        listContainer.innerHTML = '<p class="text-amber-600 font-semibold py-6 text-center text-xs">Belum ada butir soal. Klik "+ Tambah Butir Soal" di atas!</p>';
                    } else {
                        listContainer.innerHTML = data.map((q, idx) => {
                            let cleanContent = (q.content || '').replace(/<[^>]*>?/gm, '').substring(0, 50);
                            return `
                                <div onclick="selectTeacherQuestionForEdit('${q.id}')" class="p-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-blue-50 hover:border-blue-300 cursor-pointer transition-all flex items-start gap-2 text-xs">
                                    <span class="w-5 h-5 flex-shrink-0 flex items-center justify-center rounded-md bg-blue-600 text-white font-bold text-[10px]">${idx + 1}</span>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-bold text-slate-800 truncate">${cleanContent || '(Soal Tanpa Teks)'}</p>
                                        <div class="flex items-center gap-2 text-[10px] text-slate-500 mt-1">
                                            <span class="bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.2 rounded">Kunci: ${q.correctOption || 'A'}</span>
                                            <span class="text-slate-400">${q.type || 'PG'}</span>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }).join('');
                    }
                } else {
                    listContainer.innerHTML = '<p class="text-red-500 py-4 text-center text-xs">Gagal memuat soal</p>';
                }
            } catch (err) {
                listContainer.innerHTML = `<p class="text-red-500 py-4 text-center text-xs">Error: ${err.message}</p>`;
            }
        }

        function initNewTeacherQuestionForm() {
            const idField = document.getElementById('tqeQuestionId');
            if (idField) idField.value = '';
            const titleField = document.getElementById('tqeFormTitle');
            if (titleField) titleField.innerText = 'Butir Soal Baru';
            const contentField = document.getElementById('tqeContent');
            if (contentField) contentField.value = '';
            ['A', 'B', 'C', 'D', 'E'].forEach(opt => {
                const f = document.getElementById('tqeOpt' + opt);
                if (f) f.value = '';
            });
            const keyField = document.getElementById('tqeCorrectOption');
            if (keyField) keyField.value = 'A';
            const kdField = document.getElementById('tqeKdTag');
            if (kdField) kdField.value = '';
            const expField = document.getElementById('tqeExplanation');
            if (expField) expField.value = '';
            const delBtn = document.getElementById('btnDeleteTeacherQuestion');
            if (delBtn) delBtn.classList.add('hidden');
        }

        function selectTeacherQuestionForEdit(qId) {
            const q = teacherQuestionsList.find(x => x.id === qId);
            if (!q) return;
            document.getElementById('tqeQuestionId').value = q.id;
            document.getElementById('tqeFormTitle').innerText = `Sunting Soal (No: ${q.orderNum || '-'})`;
            document.getElementById('tqeContent').value = q.content || '';
            document.getElementById('tqeQuestionType').value = q.type || 'MULTIPLE_CHOICE';
            document.getElementById('tqeCorrectOption').value = q.correctOption || 'A';
            document.getElementById('tqeKdTag').value = q.kdTag || '';
            document.getElementById('tqeExplanation').value = q.explanation || '';
            document.getElementById('btnDeleteTeacherQuestion').classList.remove('hidden');

            let opts = {};
            try {
                opts = typeof q.options === 'string' ? JSON.parse(q.options) : (q.options || {});
            } catch(e) {}

            document.getElementById('tqeOptA').value = opts.A || opts['0'] || '';
            document.getElementById('tqeOptB').value = opts.B || opts['1'] || '';
            document.getElementById('tqeOptC').value = opts.C || opts['2'] || '';
            document.getElementById('tqeOptD').value = opts.D || opts['3'] || '';
            document.getElementById('tqeOptE').value = opts.E || opts['4'] || '';
        }

        async function handleSaveTeacherQuestion(e) {
            e.preventDefault();
            if (!activeExamIdForTeacherQuestions) {
                alert('Paket ujian tidak aktif!');
                return;
            }
            const qId = document.getElementById('tqeQuestionId').value;
            const content = document.getElementById('tqeContent').value.trim();
            const type = document.getElementById('tqeQuestionType').value;
            const correctOption = document.getElementById('tqeCorrectOption').value.trim().toUpperCase();
            const kdTag = document.getElementById('tqeKdTag').value.trim();
            const explanation = document.getElementById('tqeExplanation').value.trim();

            const options = {
                A: document.getElementById('tqeOptA').value.trim(),
                B: document.getElementById('tqeOptB').value.trim(),
                C: document.getElementById('tqeOptC').value.trim(),
                D: document.getElementById('tqeOptD').value.trim()
            };
            const optE = document.getElementById('tqeOptE').value.trim();
            if (optE) options.E = optE;

            const btn = document.getElementById('btnSubmitTeacherQuestion');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            const payload = {
                content,
                type,
                correctOption,
                options,
                kdTag,
                explanation
            };

            const url = qId 
                ? `/api/guru/exams/${activeExamIdForTeacherQuestions}/questions/${qId}`
                : `/api/guru/exams/${activeExamIdForTeacherQuestions}/questions`;
            const method = qId ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify(payload)
                });
                if (res.ok) {
                    alert('✅ Butir soal berhasil disimpan!');
                    initNewTeacherQuestionForm();
                    loadTeacherQuestions(activeExamIdForTeacherQuestions);
                } else {
                    const errData = await res.json();
                    alert('❌ Gagal menyimpan soal: ' + (errData.message || 'Error server'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = '💾 Simpan Soal';
            }
        }

