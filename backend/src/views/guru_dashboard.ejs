        async function handleSubmitGradeManual(e) {
            e.preventDefault();
            if (!activeUhId) return;
            const studentId = document.getElementById('gradeManualStudentId').value;
            const score = document.getElementById('inputGradeManualScore').value;
            const reason = document.getElementById('inputGradeManualReason').value.trim();

            if (!reason) {
                alert('Alasan perubahan nilai wajib diisi untuk catatan Audit Log!');
                return;
            }

            try {
                const res = await authFetch(`/api/guru/uh/${activeUhId}/grade-manual`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId, manualScore: Number(score), reason })
                });
