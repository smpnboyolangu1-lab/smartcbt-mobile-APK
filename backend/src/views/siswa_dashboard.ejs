                <div class="flex justify-end gap-2 pt-2 border-t">
                    <button type="button" onclick="closeModalReport()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-semibold cursor-pointer">Batal</button>
                    <button type="submit" id="btnSubmitBkReport" class="px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 font-bold shadow cursor-pointer">Kirim ke Guru BK</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/';
        }

        function applyUserProfile(user) {
            if (!user) return;
            document.getElementById('profileName').textContent = user.name || 'Siswa';
            document.getElementById('welcomeName').textContent = user.name || 'Siswa';
            document.getElementById('profDetailName').textContent = user.name || 'Siswa';
            document.getElementById('profileNis').textContent = user.username || user.nisn || '-';
            document.getElementById('profDetailNisn').textContent = user.nisn || user.username || '-';
            if (user.className) {
                const badge = document.getElementById('studentClassBadge');
                if (badge) badge.textContent = user.className;
            }

            const initial = (user.name || 'S').charAt(0).toUpperCase();
            const smallCont = document.getElementById('profilePicContainer');
            const bigCont = document.getElementById('profileBigContainer');

            if (user.profilePicUrl) {
                if (smallCont) smallCont.innerHTML = `<img src="${user.profilePicUrl}" class="w-full h-full object-cover rounded-full" alt="Foto">`;
                if (bigCont) bigCont.innerHTML = `<img src="${user.profilePicUrl}" class="w-full h-full object-cover rounded-full" alt="Foto">`;
            } else {
                if (smallCont) smallCont.innerHTML = `<span id="profileInitial">${initial}</span>`;
                if (bigCont) bigCont.innerHTML = `<span id="profileBigInitial">${initial}</span>`;
            }
        }

        const userStr = localStorage.getItem('user');
        if (userStr) {
            try {
                applyUserProfile(JSON.parse(userStr));
            } catch (e) {}
        }

        // Ambil data profil terbaru dari server (termasuk foto profil)
        async function fetchFreshStudentProfile() {
            try {
                const res = await fetch('/api/student/profile', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const json = await res.json();
                    const freshUser = json.user || json.data;
                    if (freshUser) {
                        const merged = { ...(userStr ? JSON.parse(userStr) : {}), ...freshUser };
                        localStorage.setItem('user', JSON.stringify(merged));
                        applyUserProfile(merged);
                    }
                }
            } catch (err) {
                console.warn('Gagal memuat profil server:', err);
            }
        }
        fetchFreshStudentProfile();

        // Ambil rekap presensi persentase & log detail siswa
        async function fetchStudentAttendanceSummary() {
            try {
                if (!token) return;
                const res = await fetch('/api/student/detailed-attendance', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && data.stats) {
                        const st = data.stats;
                        const rateStr = st.attendanceRate || st.percentage || '98.0%';
                        const effective = st.totalEffectiveDays || st.totalDays || 1;

                        // 1. Update Gauge & Badge
                        const rateEl = document.getElementById('statRatePercent');
                        if (rateEl) rateEl.innerText = rateStr;

                        const badgeEl = document.getElementById('statRateBadge');
                        const rateNum = parseFloat(rateStr) || 100;
                        if (badgeEl) {
                            if (rateNum >= 95) {
                                badgeEl.innerText = '🌟 Sangat Disiplin';
                                badgeEl.className = 'text-[11px] bg-emerald-500/30 text-white font-bold px-3 py-1 rounded-full border border-emerald-300/40';
                            } else if (rateNum >= 85) {
                                badgeEl.innerText = '👍 Cukup Disiplin';
                                badgeEl.className = 'text-[11px] bg-blue-500/30 text-white font-bold px-3 py-1 rounded-full border border-blue-300/40';
                            } else {
                                badgeEl.innerText = '⚠️ Perlu Perhatian';
                                badgeEl.className = 'text-[11px] bg-rose-500/30 text-white font-bold px-3 py-1 rounded-full border border-rose-300/40';
                            }
                        }

                        const effEl = document.getElementById('statTotalEffectiveDays');
                        if (effEl) effEl.innerText = `Total ${effective} Hari Efektif`;

                        // 2. Hadir Tepat Waktu
                        const hadirCount = st.hadir ?? st.present ?? 0;
                        const pHadir = st.percentHadir || `${(((hadirCount) / effective) * 100).toFixed(1)}%`;
                        const hadirCountEl = document.getElementById('statHadirCount');
                        if (hadirCountEl) hadirCountEl.innerText = hadirCount;
                        const pHadirEl = document.getElementById('statPercentHadir');
                        if (pHadirEl) pHadirEl.innerText = pHadir;

                        // 3. Terlambat
                        const lateCount = st.terlambat ?? st.late ?? 0;
                        const pLate = st.percentTerlambat || `${(((lateCount) / effective) * 100).toFixed(1)}%`;
                        const lateCountEl = document.getElementById('statLateCount');
                        if (lateCountEl) lateCountEl.innerText = lateCount;
                        const pLateEl = document.getElementById('statPercentLate');
                        if (pLateEl) pLateEl.innerText = pLate;

                        // 4. Sakit / Izin
                        const sickCount = (st.sakit ?? st.sick ?? 0) + (st.izin ?? 0);
                        const pSick = st.percentSakit ? `${(parseFloat(st.percentSakit) + parseFloat(st.percentIzin || '0')).toFixed(1)}%` : `${((sickCount / effective) * 100).toFixed(1)}%`;
                        const sickCountEl = document.getElementById('statSickPermitCount');
                        if (sickCountEl) sickCountEl.innerText = sickCount;
                        const pSickEl = document.getElementById('statPercentSickPermit');
                        if (pSickEl) pSickEl.innerText = pSick;

                        // 5. Alpa
                        const alpaCount = st.alpa ?? st.absent ?? 0;
                        const pAlpa = st.percentAlpa || `${(((alpaCount) / effective) * 100).toFixed(1)}%`;
                        const alpaCountEl = document.getElementById('statAlpaCount');
                        if (alpaCountEl) alpaCountEl.innerText = alpaCount;
                        const pAlpaEl = document.getElementById('statPercentAlpa');
                        if (pAlpaEl) pAlpaEl.innerText = pAlpa;

                        // 6. Distribution Bar widths
                        const barHadir = document.getElementById('barHadir');
                        if (barHadir) barHadir.style.width = pHadir;
                        const barLate = document.getElementById('barLate');
                        if (barLate) barLate.style.width = pLate;
                        const barSick = document.getElementById('barSick');
                        if (barSick) barSick.style.width = pSick;
                        const barAlpa = document.getElementById('barAlpa');
                        if (barAlpa) barAlpa.style.width = pAlpa;

                        // 7. Tab Absensi Top Summary
                        const topHadir = document.getElementById('tabAbsensiHadir');
                        if (topHadir) topHadir.innerText = `${hadirCount} (${pHadir})`;
                        const topLate = document.getElementById('tabAbsensiLate');
                        if (topLate) topLate.innerText = `${lateCount} (${pLate})`;
                        const topRate = document.getElementById('tabAbsensiRate');
                        if (topRate) topRate.innerText = rateStr;
                        const topTotal = document.getElementById('tabAbsensiTotal');
                        if (topTotal) topTotal.innerText = `${effective} Hari`;

                        // 8. Render Dynamic History Table
                        const tbody = document.getElementById('tableStudentAttendanceBody');
                        if (tbody && data.history && data.history.length > 0) {
                            tbody.innerHTML = data.history.map(row => {
                                let badgeColor = 'bg-emerald-100 text-emerald-800';
                                if (row.status === 'TERLAMBAT') badgeColor = 'bg-amber-100 text-amber-800';
                                else if (row.status === 'SAKIT') badgeColor = 'bg-sky-100 text-sky-800';
                                else if (row.status === 'IZIN') badgeColor = 'bg-indigo-100 text-indigo-800';
                                else if (row.status === 'ALPA') badgeColor = 'bg-rose-100 text-rose-800';
                                else if (row.isSunday) badgeColor = 'bg-slate-100 text-slate-700';

                                return `
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-3 font-semibold text-slate-800">${row.dayName}, ${row.date}</td>
                                        <td class="p-3"><span class="${badgeColor} px-2.5 py-1 rounded-lg font-bold text-[11px] shadow-xs">${row.status}</span></td>
                                        <td class="p-3 font-bold font-mono text-slate-700">${row.gateInTime || '-'}</td>
                                        <td class="p-3 font-bold font-mono text-slate-700">${row.gateOutTime || '-'}</td>
                                        <td class="p-3 text-slate-600">${row.gateLocation || 'Pintu Kelas'}</td>
                                        <td class="p-3 text-slate-500 font-medium">Scan Barcode QR / GPS Presisi</td>
                                    </tr>
                                `;
                            }).join('');
                        }

                        // 9. Render Grafik Tren Kehadiran Siswa
                        renderStudentAttendanceTrendChart(data.trend || st.trend, data.history);
                    }
                }
            } catch (e) {
                console.warn('Gagal memuat rekap presensi dinamis:', e);
            }
        }

        let studentAttendanceChartInstance = null;
        function renderStudentAttendanceTrendChart(trendData, history) {
            const canvas = document.getElementById('chartStudentAttendanceTrend');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (studentAttendanceChartInstance) {
                studentAttendanceChartInstance.destroy();
            }

            let labels = [];
            let scores = [];
            let pointColors = [];

            if (trendData && trendData.dailyTrend && trendData.dailyTrend.length > 0) {
                labels = trendData.dailyTrend.map(d => `${d.dayName?.substring(0,3) || ''} ${d.date?.substring(5) || ''}`);
                scores = trendData.dailyTrend.map(d => d.score);
                pointColors = trendData.dailyTrend.map(d => {
                    if (d.score >= 100) return '#10B981';
                    if (d.score >= 80) return '#F59E0B';
                    if (d.score >= 50) return '#3B82F6';
                    return '#EF4444';
                });
            } else if (history && history.length > 0) {
                const recent = [...history].filter(h => !h.isSunday).slice(0, 14).reverse();
                labels = recent.map(h => `${h.dayName?.substring(0,3) || ''} ${h.date?.substring(5) || ''}`);
                scores = recent.map(h => {
                    const st = (h.status || '').toUpperCase();
                    if (st.includes('TERLAMBAT')) return 80;
                    if (st.includes('SAKIT') || st.includes('IZIN')) return 50;
                    if (st.includes('ALPA')) return 0;
                    return 100;
                });
                pointColors = scores.map(s => s >= 100 ? '#10B981' : (s >= 80 ? '#F59E0B' : (s >= 50 ? '#3B82F6' : '#EF4444')));
            } else {
                labels = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum'];
                scores = [100, 100, 100, 80, 100, 100, 100, 100, 80, 100];
                pointColors = scores.map(s => s >= 100 ? '#10B981' : '#F59E0B');
            }

            studentAttendanceChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tingkat Kehadiran (%)',
                        data: scores,
                        borderColor: '#2563EB',
                        backgroundColor: 'rgba(37, 99, 235, 0.08)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: pointColors,
                        pointBorderColor: '#FFFFFF',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 0,
                            max: 105,
                            ticks: {
                                stepSize: 25,
                                callback: function(val) { return val + '%'; },
                                font: { size: 10, weight: 'bold' }
                            },
                            grid: { color: '#F1F5F9' }
                        },
                        x: {
                            ticks: { font: { size: 10, weight: '600' } },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const score = context.parsed.y;
                                    let statusText = 'Hadir Tepat (100%)';
                                    if (score === 80) statusText = 'Terlambat (80%)';
                                    else if (score === 50) statusText = 'Izin/Sakit (50%)';
                                    else if (score === 0) statusText = 'Alpa (0%)';
                                    return `Status: ${statusText}`;
                                }
                            }
                        }
                    }
                }
            });
        }
        fetchStudentAttendanceSummary();

        // Jam Real-time
        function updateLiveClock() {
            const el = document.getElementById('heroLiveClock');
            if (el) {
                const now = new Date();
                el.innerText = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';
            }
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();

        async function uploadStudentAvatar(event) {
            const file = event.target.files?.[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                alert('Ukuran foto maksimal 5 MB');
                return;
            }

            const reader = new FileReader();
            reader.onload = async function(e) {
                const base64Data = e.target.result;
                try {
                    const res = await fetch('/api/student/profile', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + token
                        },
                        body: JSON.stringify({ profilePicBase64: base64Data })
                    });
                    const data = await res.json();
                    if (res.ok) {
                        alert('✅ Foto profil berhasil diperbarui!');
                        if (data.user || data.data) {
                            const updatedUser = data.user || data.data;
                            const current = userStr ? JSON.parse(userStr) : {};
                            const merged = { ...current, ...updatedUser };
                            localStorage.setItem('user', JSON.stringify(merged));
                            applyUserProfile(merged);
                        } else {
                            fetchFreshStudentProfile();
                        }
                    } else {
                        alert('❌ Gagal mengunggah foto: ' + (data.message || 'Error server'));
                    }
                } catch (err) {
                    alert('Error unggah foto: ' + err.message);
                }
            };
            reader.readAsDataURL(file);
        }

        function switchSiswaTab(tab) {
            const tabs = ['home', 'absensi', 'analytics', 'efiles', 'bk', 'profile'];
            tabs.forEach(t => {
                const section = document.getElementById('section-' + t);
                const btn = document.getElementById('tabBtn-' + t);
                if (section) section.classList.toggle('hidden', t !== tab);
                if (btn) {
                    if (t === tab) {
                        btn.className = 'w-full text-left px-4 py-2.5 bg-blue-600/30 text-blue-300 rounded-xl font-bold border-l-4 border-blue-500 flex items-center gap-2.5';
                    } else {
                        btn.className = 'w-full text-left px-4 py-2.5 hover:bg-blue-600/20 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all';
                    }
                }
            });
            if (tab === 'bk') {
                fetchStudentBkConsultations();
            }
        }

        function openModalReport() {
            const m = document.getElementById('modalReportBk');
            if (m) {
                m.classList.remove('hidden');
                m.classList.add('flex');
            }
        }

        function closeModalReport() {
            const m = document.getElementById('modalReportBk');
            if (m) {
                m.classList.add('hidden');
                m.classList.remove('flex');
            }
        }

        async function submitStudentBkReport(e) {
            e.preventDefault();
            const category = document.getElementById('bkInputCategory').value;
            const subject = document.getElementById('bkInputSubject').value.trim();
            const message = document.getElementById('bkInputMessage').value.trim();
            const isAnonymous = document.getElementById('bkInputAnonymous').checked;

            if (!subject || !message) {
                alert('Harap isi judul dan detail pesan pengaduan.');
                return;
            }

            const btn = document.getElementById('btnSubmitBkReport');
            btn.disabled = true;
            btn.innerText = 'Mengirim...';

            try {
                const res = await fetch('/api/student/bk-report', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ category, subject, message, isAnonymous })
                });
                const data = await res.json();
                if (res.ok && (data.success !== false)) {
                    alert('✅ ' + (data.message || 'Pesan berhasil dikirim ke Guru BK!'));
                    document.getElementById('bkInputSubject').value = '';
                    document.getElementById('bkInputMessage').value = '';
                    document.getElementById('bkInputAnonymous').checked = false;
                    closeModalReport();
                    fetchStudentBkConsultations();
                } else {
                    alert('❌ Gagal mengirim: ' + (data.message || 'Terjadi kesalahan server'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Kirim ke Guru BK';
            }
        }

        async function fetchStudentBkConsultations() {
            const container = document.getElementById('bkConsultationList');
            if (!container) return;

            try {
                const res = await fetch('/api/student/bk-consultations', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) throw new Error('Gagal memuat riwayat konseling');
                const list = await res.json();

                if (!Array.isArray(list) || list.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-8 text-gray-400">
                            <p class="text-2xl mb-1">🕊️</p>
                            <p class="text-xs font-semibold">Belum ada riwayat konseling atau pengaduan.</p>
                            <p class="text-[11px] text-gray-400 mt-0.5">Klik tombol "Tulis Pesan ke Guru BK" di atas jika ada hal yang ingin diceritakan.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = list.map(c => {
                    const isReplied = c.replyMessage && c.replyMessage.trim().length > 0;
                    const dateStr = c.createdAt ? new Date(c.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';
                    const replyDateStr = c.replyDate ? new Date(c.replyDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
                    const counselorName = c.counselor?.name || 'Guru BK';

                    return `
                        <div class="border border-gray-100 rounded-xl p-4 space-y-2.5 bg-gray-50/50 hover:bg-gray-50 transition-all">
                            <div class="flex justify-between items-start gap-2">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="bg-teal-100 text-teal-800 text-[10px] font-bold px-2 py-0.5 rounded-full">${c.category || 'Konseling BK'}</span>
                                        ${c.isAnonymous ? '<span class="bg-gray-200 text-gray-700 text-[10px] font-semibold px-2 py-0.5 rounded-full">🕵️ Anonim</span>' : ''}
                                        <span class="text-[11px] text-gray-400">${dateStr}</span>
                                    </div>
                                    <h4 class="font-bold text-gray-800 text-xs mt-1">${c.subject || 'Tanpa Judul'}</h4>
                                </div>
                                <span class="${isReplied ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'} text-[10px] font-bold px-2.5 py-1 rounded-lg whitespace-nowrap">
                                    ${isReplied ? '✅ Sudah Dibalas' : '⏳ Menunggu Jawaban'}
                                </span>
                            </div>
                            <p class="text-xs text-gray-600 bg-white p-3 rounded-lg border border-gray-100 leading-relaxed">${c.message}</p>
                            ${isReplied ? `
                                <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-lg space-y-1">
                                    <div class="flex justify-between items-center text-[10px] text-emerald-700 font-bold">
                                        <span>💡 Tanggapan ${counselorName}:</span>
                                        <span class="text-emerald-600 font-normal">${replyDateStr}</span>
                                    </div>
                                    <p class="text-xs text-emerald-900 leading-relaxed">${c.replyMessage}</p>
                                </div>
                            ` : ''}
                        </div>
                    `;
                }).join('');
            } catch (err) {
                container.innerHTML = `<p class="text-xs text-red-500 text-center py-4">Error memuat data BK: ${err.message}</p>`;
            }
        }

        async function handlePortalChangePassword(e) {
            e.preventDefault();
            const oldP = document.getElementById('inputOldPassword').value;
            const newP = document.getElementById('inputNewPassword').value;
            const confP = document.getElementById('inputConfirmPassword').value;

            if (newP !== confP) {
                alert('Konfirmasi password baru tidak cocok!');
                return;
            }

            try {
                const res = await fetch('/api/student/profile', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ oldPassword: oldP, newPassword: newP })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Password berhasil diperbarui!'));
                    document.getElementById('inputOldPassword').value = '';
                    document.getElementById('inputNewPassword').value = '';
                    document.getElementById('inputConfirmPassword').value = '';
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Password lama salah'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        function logout() {
            localStorage.clear();
            window.location.href = '/';
        }
    </script>
</body>
</html>
