<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Siswa - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/chart.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-50 text-slate-800 flex h-screen overflow-hidden font-sans">
    
    <!-- Floating Expand Button (Visible when Sidebar is Collapsed) -->
    <button type="button" onclick="togglePortalSidebar()" id="sidebarExpandBtn" title="Tampilkan Sidebar (Shortcut: Ctrl+B)" class="fixed top-3 left-4 z-50 bg-slate-900/95 hover:bg-sky-600 text-white px-3.5 py-2 rounded-xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 hidden flex items-center gap-2.5 text-xs font-bold hover:scale-105 group cursor-pointer">
        <svg class="w-5 h-5 text-sky-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span class="font-extrabold tracking-wide">Menu Siswa</span>
        <span class="text-[10px] bg-white/15 px-1.5 py-0.5 rounded text-slate-300">Ctrl+B</span>
    </button>

    <!-- Sidebar Siswa (Refreshed Slate & Sky Theme) -->
    <aside id="portalSidebar" class="w-64 bg-slate-900 h-screen text-white flex flex-col fixed left-0 top-0 shadow-2xl z-40 border-r border-slate-800 transition-all duration-300 ease-in-out select-none">
        <!-- Brand Header with Logo and Collapse Toggle Button -->
        <div class="px-4 py-3.5 border-b border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900 to-sky-950/40 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 overflow-hidden">
                <div class="w-10 h-10 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-md border border-sky-400/30 flex-shrink-0">
                    <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-full h-full object-contain drop-shadow" onerror="this.src='/logo.png'">
                </div>
                <div class="truncate">
                    <h1 class="font-black text-sm tracking-wide text-white leading-tight">SMART SISWA</h1>
                    <p class="text-[11px] text-sky-400 font-semibold truncate">SMPN 1 Boyolangu</p>
                </div>
            </div>

            <!-- Toggle Button to Hide / Collapse Sidebar -->
            <button type="button" onclick="togglePortalSidebar()" id="sidebarCollapseBtn" title="Sembunyikan Sidebar (Ctrl+B)" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center justify-center group flex-shrink-0 cursor-pointer" aria-label="Sembunyikan Sidebar">
                <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5 text-slate-400 group-hover:text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
                </svg>
            </button>
        </div>

        <div class="p-3 bg-slate-950/50 border-b border-slate-800 flex items-center space-x-3">
            <div class="w-9 h-9 bg-sky-600/30 text-sky-300 rounded-xl flex items-center justify-center font-black text-sm border border-sky-500/30 flex-shrink-0 shadow-inner" id="profilePicContainer">
                <span id="profileInitial">S</span>
            </div>
            <div class="overflow-hidden">
                <p class="text-xs font-bold text-slate-100 truncate" id="profileName">Nama Siswa</p>
                <div class="flex items-center gap-1 mt-0.5">
                    <span class="text-[10px] text-sky-400 font-semibold truncate">NISN: <span id="profileNis">-</span></span>
                </div>
            </div>
        </div>

        <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto text-sm font-semibold">
            <button onclick="switchSiswaTab('home')" id="tabBtn-home" class="w-full text-left px-3.5 py-2.5 bg-sky-600/30 text-sky-200 rounded-xl font-bold border-l-4 border-sky-500 flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">🏠</span> <span>Beranda &amp; Ujian</span>
            </button>
            <button onclick="switchSiswaTab('absensi')" id="tabBtn-absensi" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">📊</span> <span>Rekap Absensi Detail</span>
            </button>
            <button onclick="switchSiswaTab('analytics')" id="tabBtn-analytics" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">📈</span> <span>Analisis Belajar</span>
            </button>
            <button onclick="switchSiswaTab('efiles')" id="tabBtn-efiles" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">📁</span> <span>E-File Dokumen</span>
            </button>
            <button onclick="switchSiswaTab('bk')" id="tabBtn-bk" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">🕊️</span> <span>Layanan BK &amp; Curhat</span>
            </button>
            <button onclick="switchSiswaTab('profile')" id="tabBtn-profile" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">👤</span> <span>Profil &amp; Password</span>
            </button>
        </nav>

        <div class="p-3 border-t border-slate-800 bg-slate-950/70">
            <button onclick="logout()" class="w-full bg-rose-600/90 hover:bg-rose-700 text-white font-bold py-2.5 rounded-xl shadow-md transition-colors text-xs flex items-center justify-center gap-2 cursor-pointer">
                <span>🚪</span> <span>Logout Siswa</span>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <header class="mb-6 border-b border-slate-200/80 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">Halo, <span id="welcomeName">Siswa</span>! 👋</h1>
                    <p class="text-slate-500 text-xs">Portal Terpadu Siswa: Akademik, Presensi Masuk/Pulang, Nilai, E-File &amp; Layanan BK</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/uploads/smartcbt-latest.apk" download="smartcbt-latest.apk" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow transition-all" title="Unduh APK Mobile Smart School CBT Versi Terbaru">
                    <span>📲</span> <span>Unduh APK v2.9.3</span>
                </a>
                <span class="text-xs bg-sky-100 text-sky-800 font-bold px-3 py-1.5 rounded-full border border-sky-200" id="studentClassBadge">Kelas VII-A</span>
            </div>
        </header>

        <!-- SECTION 1: HOME & QUICK ACCESS MENU -->
        <div id="section-home" class="space-y-6">
            <!-- Banner Pembaruan APK Smart School CBT Siswa -->
            <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-700 text-white p-4 rounded-2xl shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <span class="text-3xl p-2 bg-white/20 rounded-xl">📲</span>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-extrabold text-sm">Aplikasi Smart School CBT Siswa v2.9.3 (Build 173)</h3>
                            <span class="bg-emerald-400/30 text-emerald-100 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-300/40">Versi Terbaru</span>
                        </div>
                        <p class="text-xs text-emerald-100 mt-0.5">Grafik Tren Kehadiran siswa &amp; orang tua, filter GPS satelit presisi, fallback QR statis kelas, dan antrean presensi Room DB offline.</p>
                    </div>
                </div>
                <a href="/uploads/smartcbt-latest.apk" download="smartcbt-latest.apk" class="bg-white hover:bg-emerald-50 text-emerald-800 font-bold px-4 py-2 rounded-xl text-xs shadow-md transition-all whitespace-nowrap flex items-center gap-2">
                    <span>⬇️</span> <span>Unduh APK Resmi</span>
                </a>
            </div>

            <!-- Hero Card Info & Real-Time Presence Status -->
            <div class="bg-gradient-to-r from-slate-900 via-sky-950 to-blue-900 text-white p-6 rounded-3xl shadow-lg border border-sky-800/40">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="bg-sky-500/20 text-sky-300 text-xs font-bold px-3 py-1 rounded-full border border-sky-400/30">
                                🎓 Profil Siswa Aktif
                            </span>
                            <span class="text-xs text-slate-300 font-mono" id="heroLiveClock">--:-- WIB</span>
                        </div>
                        <h2 class="text-xl font-black text-white" id="heroStudentName">Nama Siswa</h2>
                        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-sky-200">
                            <p>👨‍🏫 <b>Wali Kelas:</b> <span id="homeWaliKelas">Bpk. Drs. Agus Santoso, M.Pd</span></p>
                            <p>🕊️ <b>Guru BK:</b> <span id="homeGuruBk">-</span></p>
                            <p>🩸 <b>Gol. Darah:</b> <span id="homeBlood">O+</span></p>
                            <p>⭐ <b>Poin Disiplin:</b> <span id="homePoints" class="text-emerald-400 font-bold">100</span></p>
                        </div>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20 text-xs min-w-[220px]">
                        <p class="font-bold text-slate-300 uppercase tracking-wider text-[10px]">Status Presensi Hari Ini</p>
                        <p class="text-emerald-300 font-black text-base mt-1" id="heroTodayStatus">🟢 HADIR</p>
                        <div class="flex justify-between items-center text-[11px] text-sky-100 mt-2 pt-2 border-t border-white/10">
                            <span>Datang: <b id="heroGateInTime">06:45 WIB</b></span>
                            <span>Pulang: <b id="heroGateOutTime">14:15 WIB</b></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 📊 KARTU REKAPITULASI PRESENSI PERSENTASE SISWA -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200/80">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-slate-100 pb-4 mb-5">
                    <div>
                        <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
                            <span>📊</span> Rekapitulasi Presensi &amp; Persentase Kehadiran
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Tingkat kehadiran siswa dihitung secara proporsional dari total hari efektif sekolah</p>
                    </div>
                    <button onclick="switchSiswaTab('absensi')" class="text-xs font-bold text-sky-600 hover:text-sky-800 bg-sky-50 hover:bg-sky-100 px-3.5 py-1.5 rounded-xl transition-colors flex items-center gap-1 cursor-pointer">
                        <span>Lihat Log Detail</span> <span>→</span>
                    </button>
                </div>

                <!-- Persentase Visual Ring & Breakdown Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-center">
                    <!-- Big Total Percentage Gauge Card -->
                    <div class="lg:col-span-1 bg-gradient-to-br from-blue-600 to-indigo-700 text-white p-5 rounded-2xl shadow-md text-center flex flex-col justify-center items-center">
                        <span class="text-xs uppercase font-bold tracking-wider text-blue-200">Persentase Kehadiran</span>
                        <div class="my-2 flex items-baseline justify-center">
                            <span class="text-4xl font-black tracking-tight" id="statRatePercent">98.0%</span>
                        </div>
                        <span class="text-[11px] bg-white/20 text-white font-bold px-3 py-1 rounded-full border border-white/30" id="statRateBadge">
                            🌟 Sangat Disiplin
                        </span>
                        <span class="text-[10px] text-blue-200 mt-2" id="statTotalEffectiveDays">Total 22 Hari Efektif</span>
                    </div>

                    <!-- 4 Metric Cards with Percentages -->
                    <div class="lg:col-span-3 grid grid-cols-2 sm:grid-cols-4 gap-3.5">
                        <!-- 1. Hadir Tepat Waktu -->
                        <div class="bg-emerald-50/70 border border-emerald-200/80 p-3.5 rounded-2xl flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-emerald-800">Hadir Tepat</span>
                                <span class="text-base">🟢</span>
                            </div>
                            <div class="mt-2">
                                <p class="text-2xl font-black text-emerald-700" id="statHadirCount">21</p>
                                <div class="flex items-center justify-between text-[11px] text-emerald-600 font-semibold mt-1">
                                    <span>Persentase:</span>
                                    <b id="statPercentHadir" class="font-bold text-emerald-800">95.5%</b>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Terlambat -->
                        <div class="bg-amber-50/70 border border-amber-200/80 p-3.5 rounded-2xl flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-amber-800">Terlambat</span>
                                <span class="text-base">🟡</span>
                            </div>
                            <div class="mt-2">
                                <p class="text-2xl font-black text-amber-700" id="statLateCount">1</p>
                                <div class="flex items-center justify-between text-[11px] text-amber-600 font-semibold mt-1">
                                    <span>Persentase:</span>
                                    <b id="statPercentLate" class="font-bold text-amber-800">4.5%</b>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Sakit / Izin -->
                        <div class="bg-sky-50/70 border border-sky-200/80 p-3.5 rounded-2xl flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-sky-800">Sakit / Izin</span>
                                <span class="text-base">🔵</span>
                            </div>
                            <div class="mt-2">
                                <p class="text-2xl font-black text-sky-700" id="statSickPermitCount">0</p>
                                <div class="flex items-center justify-between text-[11px] text-sky-600 font-semibold mt-1">
                                    <span>Persentase:</span>
                                    <b id="statPercentSickPermit" class="font-bold text-sky-800">0.0%</b>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Alpa -->
                        <div class="bg-rose-50/70 border border-rose-200/80 p-3.5 rounded-2xl flex flex-col justify-between">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-rose-800">Alpa / Tanpa Ket.</span>
                                <span class="text-base">🔴</span>
                            </div>
                            <div class="mt-2">
                                <p class="text-2xl font-black text-rose-700" id="statAlpaCount">0</p>
                                <div class="flex items-center justify-between text-[11px] text-rose-600 font-semibold mt-1">
                                    <span>Persentase:</span>
                                    <b id="statPercentAlpa" class="font-bold text-rose-800">0.0%</b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visual Stacked Distribution Bar -->
                <div class="mt-5">
                    <div class="w-full bg-slate-100 rounded-full h-3 flex overflow-hidden shadow-inner">
                        <div id="barHadir" style="width: 95.5%" class="bg-emerald-500 h-full transition-all duration-500" title="Hadir: 95.5%"></div>
                        <div id="barLate" style="width: 4.5%" class="bg-amber-400 h-full transition-all duration-500" title="Terlambat: 4.5%"></div>
                        <div id="barSick" style="width: 0%" class="bg-sky-400 h-full transition-all duration-500" title="Sakit/Izin: 0%"></div>
                        <div id="barAlpa" style="width: 0%" class="bg-rose-500 h-full transition-all duration-500" title="Alpa: 0%"></div>
                    </div>
                    <div class="flex flex-wrap justify-between items-center text-[10px] text-slate-500 mt-2 px-1">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Hadir Tepat Waktu</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span> Terlambat</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sky-400 inline-block"></span> Izin / Sakit Resmi</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block"></span> Alpa / Tanpa Keterangan</span>
                    </div>
                </div>

                <!-- 📈 GRAFIK TREN KEHADIRAN SISWA -->
                <div class="mt-6 pt-5 border-t border-slate-100">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-3">
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 bg-blue-100 text-blue-700 rounded-lg text-sm">📈</span>
                            <div>
                                <h3 class="text-xs font-black uppercase tracking-wider text-slate-800">
                                    Grafik Tren Kehadiran Siswa (% Tingkat Disiplin)
                                </h3>
                                <p class="text-[11px] text-slate-400">Tren kehadiran dan kepatuhan jam gerbang 14 hari terakhir</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] bg-emerald-50 text-emerald-700 font-bold px-2.5 py-1 rounded-full border border-emerald-200" id="badgeTrendStatus">
                                🟢 Tren Sangat Baik
                            </span>
                            <span class="text-[10px] text-slate-500 font-semibold" id="trendSubtitle">Target: ≥ 95%</span>
                        </div>
                    </div>
                    <div class="h-48 relative">
                        <canvas id="chartStudentAttendanceTrend"></canvas>
                    </div>
                </div>
            </div>

            <!-- 🧭 MENU UTAMA SISWA (TATA ULANG RAPI & TERSTRUKTUR) -->
            <div>
                <div class="flex items-center justify-between mb-3 px-1">
                    <h2 class="text-sm font-black uppercase tracking-wider text-slate-700 flex items-center gap-2">
                        <span>🧭</span> Akses Layanan &amp; Menu Siswa
                    </h2>
                    <span class="text-xs text-slate-400">Pilih menu untuk membuka fitur</span>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5">
                    <!-- 1. Ujian CBT -->
                    <button onclick="switchSiswaTab('home'); document.getElementById('cardActiveCbt').scrollIntoView({behavior:'smooth'})" class="bg-white hover:bg-sky-50/80 border border-slate-200/90 hover:border-sky-300 p-4 rounded-2xl shadow-sm text-left transition-all duration-200 hover:-translate-y-0.5 group cursor-pointer flex flex-col justify-between">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            📝
                        </div>
                        <div>
                            <p class="font-extrabold text-xs text-slate-900 group-hover:text-blue-700">Ujian CBT</p>
                            <p class="text-[10px] text-slate-500 mt-0.5 leading-tight">Ujian Online Kiosk</p>
                        </div>
                    </button>

                    <!-- 2. Rekap Absensi -->
                    <button onclick="switchSiswaTab('absensi')" class="bg-white hover:bg-emerald-50/80 border border-slate-200/90 hover:border-emerald-300 p-4 rounded-2xl shadow-sm text-left transition-all duration-200 hover:-translate-y-0.5 group cursor-pointer flex flex-col justify-between">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            📊
                        </div>
                        <div>
                            <p class="font-extrabold text-xs text-slate-900 group-hover:text-emerald-700">Presensi &amp; QR</p>
                            <p class="text-[10px] text-slate-500 mt-0.5 leading-tight">Histori Gate Masuk/Pulang</p>
                        </div>
                    </button>

                    <!-- 3. Analisis Belajar -->
                    <button onclick="switchSiswaTab('analytics')" class="bg-white hover:bg-indigo-50/80 border border-slate-200/90 hover:border-indigo-300 p-4 rounded-2xl shadow-sm text-left transition-all duration-200 hover:-translate-y-0.5 group cursor-pointer flex flex-col justify-between">
                        <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            📈
                        </div>
                        <div>
                            <p class="font-extrabold text-xs text-slate-900 group-hover:text-indigo-700">Analisis Nilai</p>
                            <p class="text-[10px] text-slate-500 mt-0.5 leading-tight">Capaian Akademik</p>
                        </div>
                    </button>

                    <!-- 4. E-Files Dokumen -->
                    <button onclick="switchSiswaTab('efiles')" class="bg-white hover:bg-amber-50/80 border border-slate-200/90 hover:border-amber-300 p-4 rounded-2xl shadow-sm text-left transition-all duration-200 hover:-translate-y-0.5 group cursor-pointer flex flex-col justify-between">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl mb-3 group-hover:scale-110 transition-transform">
                            📁
                        </div>
                        <div>
                            <p class="font-extrabold text-xs text-slate-900 group-hover:text-amber-700">E-File Rapor</p>
                            <p class="text-[10px] text-slate-500 mt-0.5 leading-tight">Kartu &amp; Sertifikat</p>
                        </div>
                    </button>

                    <!-- 5. Layanan BK -->
