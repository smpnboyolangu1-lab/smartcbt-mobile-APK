<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Rilis APK Sideload &amp; Keamanan - SmartSchool</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/design-system.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; color: #f8fafc; }
        .glass-card { background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(51, 65, 85, 0.7); backdrop-filter: blur(12px); border-radius: 18px; }
    </style>
</head>
<body class="flex min-h-screen">
    <%- (typeof isOperator !== 'undefined' && isOperator) ? include('partials/sidebar_operator') : include('partials/sidebar_admin') %>

    <main class="flex-1 p-4 md:p-8 ml-0 md:ml-64 transition-all">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-800 gap-4">
            <div>
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">🚀</span>
                    <h1 class="text-xl md:text-2xl font-black tracking-tight text-white">Rilis Update APK Sideload &amp; Integritas SHA-256</h1>
                </div>
                <p class="text-xs md:text-sm text-slate-400 mt-1">Distribusi APK di luar Google Play Store dengan verifikasi sidik jari, checksum, dan staged rollout.</p>
            </div>
            <div>
                <a href="/download-apk" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-lg transition-all flex items-center gap-2">
                    <span>⬇️ Unduh APK Terkini</span>
                </a>
            </div>
        </div>

        <!-- Keamanan Sideload Overview (Modul 13-C) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
            <div class="glass-card p-5 border-indigo-500/30">
                <div class="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-1">1. Keystore Signing Key</div>
                <p class="text-sm font-bold text-white">Konsisten &amp; Terlindungi</p>
                <p class="text-[11px] text-slate-400 mt-1">Mencegah update ditolak OS Android karena perbedaan signature key.</p>
            </div>

            <div class="glass-card p-5 border-emerald-500/30">
                <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-1">2. SHA-256 Integrity</div>
                <p class="text-sm font-bold text-white">Verifikasi Otomatis</p>
                <p class="text-[11px] text-slate-400 mt-1">File corrupt akibat jaringan putus-nyambung otomatis ditolak device.</p>
            </div>

            <div class="glass-card p-5 border-sky-500/30">
                <div class="text-xs font-bold text-sky-400 uppercase tracking-wider mb-1">3. Resume Download</div>
                <p class="text-sm font-bold text-white">HTTP Range Request</p>
                <p class="text-[11px] text-slate-400 mt-1">Download APK melanjutkan dari persentase terakhir tanpa mulai dari nol.</p>
            </div>
        </div>

        <!-- KHUSUS TRIAL / UJI COBA INTERNAL ADMIN & GURU -->
        <div id="trial-apk" class="glass-card p-6 mt-6 border-amber-500/40 bg-gradient-to-br from-amber-950/30 via-slate-900/90 to-indigo-950/30 shadow-2xl relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 w-44 h-44 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
            
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-2 mb-2">
                        <span class="px-2.5 py-1 bg-amber-500/20 border border-amber-400/40 text-amber-300 rounded-lg text-[11px] font-black uppercase tracking-wider flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                            🧪 Menu Khusus: Build APK Trial (Local Sideload)
                        </span>
                        <span class="px-2.5 py-1 bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 rounded-lg text-[11px] font-extrabold">
                            🛡️ Aman: Tidak Masuk Auto-Update Siswa
                        </span>
                    </div>

                    <h2 class="text-lg md:text-xl font-black text-white flex items-center gap-2">
                        <span>Smart CBT v2.9.15_trial</span>
                        <span class="text-xs bg-slate-800 text-slate-300 font-mono px-2 py-0.5 rounded border border-slate-700">Build 185</span>
                    </h2>

                    <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                        Berkas APK ini khusus untuk pengujian internal oleh Administrator &amp; Guru. <span class="text-amber-300 font-semibold">Tidak dipublikasikan ke server rilis publik 3.000 siswa</span> sehingga siswa tidak akan ter-update otomatis selama Anda melakukan verifikasi dan uji coba.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mt-4 text-[11px]">
                        <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800">
                            <span class="text-slate-400 block font-medium">Ukuran Berkas</span>
                            <span class="text-white font-bold text-xs">17.82 MB</span>
                        </div>
                        <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800">
                            <span class="text-slate-400 block font-medium">Versi &amp; Build</span>
                            <span class="text-white font-bold text-xs">2.9.16_trial (186)</span>
                        </div>
                        <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800">
                            <span class="text-slate-400 block font-medium">Status Distribusi</span>
                            <span class="text-amber-400 font-bold text-xs">Internal / Admin Manual</span>
                        </div>
                        <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800">
                            <span class="text-slate-400 block font-medium">Keystore Sign</span>
                            <span class="text-emerald-400 font-bold text-xs">Release Keystore (Signed)</span>
                        </div>
                    </div>

                    <!-- Highlight Fitur yang Diperbaiki -->
                    <div class="mt-4 p-3 bg-slate-950/40 rounded-xl border border-slate-800/80 text-[11px]">
                        <span class="font-bold text-amber-300 uppercase tracking-wider block mb-1.5">Fitur Baru &amp; Perbaikan Siap Diuji:</span>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-1.5 text-slate-300">
                            <li class="flex items-start gap-1.5">
                                <span class="text-emerald-400">✓</span>
                                <span><b>Smart Question Editor:</b> Tombol Prev &amp; Next lancar, auto-save soal, upload foto/audio dari memori HP.</span>
                            </li>
                            <li class="flex items-start gap-1.5">
                                <span class="text-emerald-400">✓</span>
                                <span><b>Mulai Ulangan Cepat:</b> Dialog full-mode header warna, multi-kelas checkbox, 4 mode sumber soal.</span>
                            </li>
                            <li class="flex items-start gap-1.5">
                                <span class="text-emerald-400">✓</span>
                                <span><b>Buat PR &amp; Tugas:</b> Target multi-kelas centang &amp; perbaikan tuntas bug tanggal "Gagal membuat tugas".</span>
                            </li>
                            <li class="flex items-start gap-1.5">
                                <span class="text-emerald-400">✓</span>
                                <span><b>Monitoring Guru &amp; Wali Kelas:</b> Live progress bar pengerjaan, LJS viewer, grading rubrik, kontrol sesi siswa.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-3 text-[10px] text-slate-400 font-mono break-all">
                        SHA-256: <span class="text-slate-300">62dfce41c82f96f8a33b3c1f3cc435cbc54ca16c7a5beda01ce0b1f5f2b98d53</span>
                    </div>
                </div>

                <!-- Right Action & Download Box -->
                <div class="flex flex-col items-center justify-center p-4 bg-slate-950/80 border border-amber-500/30 rounded-2xl min-w-[220px] text-center shadow-lg">
                    <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-2xl mb-2 shadow-inner">
                        📲
                    </div>
                    <span class="text-xs font-bold text-white mb-1">Unduh ke Perangkat</span>
                    <span class="text-[10px] text-slate-400 mb-3">Install langsung di HP Guru / Admin</span>
                    
                    <a href="/download-apk-trial" download="SmartCBT_v2.9.16_trial.apk" class="w-full py-2.5 px-4 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black rounded-xl text-xs shadow-lg transition-all flex items-center justify-center gap-2 transform hover:scale-[1.02]">
                        <span>⬇️ Download APK Trial</span>
                    </a>

                    <button type="button" onclick="copyTrialDownloadUrl()" class="w-full mt-2 py-1.5 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-lg text-[10px] transition-all flex items-center justify-center gap-1.5">
                        <span id="copyIcon">📋</span> <span id="copyText">Salin Tautan Download</span>
                    </button>

                    <div class="mt-3 pt-3 border-t border-slate-800/80 w-full text-center">
                        <span class="text-[10px] text-slate-400 block mb-1">Scan QR dari HP:</span>
                        <img id="trialQrCodeImg" alt="QR Code Download APK Trial" class="w-24 h-24 mx-auto rounded-lg bg-white p-1 shadow-md border border-slate-700">
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Publish Rilis Baru -->
        <div class="glass-card p-6 mt-6">
            <h3 class="text-sm font-extrabold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                <span>📦 Publikasikan Versi APK Baru</span>
            </h3>
            <form onsubmit="submitNewRelease(event)" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-300 mb-1">Nomor Versi (Version Name)</label>
                    <input type="text" id="inputVersionName" required placeholder="Contoh: 2.8.69"
                           class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-medium focus:border-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block font-bold text-slate-300 mb-1">Version Code (Integer Bertambah)</label>
                    <input type="number" id="inputVersionCode" required placeholder="Contoh: 79"
                           class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-medium focus:border-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block font-bold text-slate-300 mb-1">Staged Rollout (Persentase Perangkat)</label>
                    <select id="inputRollout" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-medium focus:border-indigo-500 focus:outline-none">
                        <option value="100">100% (Semua Perangkat)</option>
                        <option value="50">50% (Rilis Bertahap)</option>
                        <option value="25">25% (Rilis Awal)</option>
                        <option value="10">10% (Uji Coba Terbatas)</option>
                    </select>
                </div>

                <div class="flex items-center gap-3 pt-6">
                    <input type="checkbox" id="checkForceUpdate" class="w-4 h-4 rounded text-indigo-600 bg-slate-900 border-slate-700 focus:ring-0">
                    <label for="checkForceUpdate" class="font-bold text-slate-200">Force Update (Wajib update sebelum bisa dipakai)</label>
                </div>

                <div class="md:col-span-2">
                    <label class="block font-bold text-slate-300 mb-1">Changelog / Catatan Pembaruan</label>
                    <textarea id="inputChangelog" required rows="3" placeholder="Fitur baru dan perbaikan stabilitas..."
                              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-medium focus:border-indigo-500 focus:outline-none"></textarea>
                </div>

                <div class="md:col-span-2">
                    <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2">
                        <span>🚀 Simpan &amp; Aktifkan Versi Rilis</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const origin = window.location.origin;
            const trialUrl = origin + '/download-apk-trial';
            const qrImg = document.getElementById('trialQrCodeImg');
            if (qrImg) {
                qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=' + encodeURIComponent(trialUrl);
            }
        });

        function copyTrialDownloadUrl() {
            const trialUrl = window.location.origin + '/download-apk-trial';
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(trialUrl).then(() => {
                    const text = document.getElementById('copyText');
                    const icon = document.getElementById('copyIcon');
                    if (text && icon) {
                        text.innerText = 'Tersalin!';
                        icon.innerText = '✅';
                        setTimeout(() => {
                            text.innerText = 'Salin Tautan Download';
                            icon.innerText = '📋';
                        }, 2500);
                    }
                });
            } else {
                prompt('Salin tautan unduh APK trial berikut:', trialUrl);
            }
        }

        async function submitNewRelease(e) {
            e.preventDefault();
            const nomorVersi = document.getElementById('inputVersionName').value;
            const versionCode = document.getElementById('inputVersionCode').value;
            const persentaseRollout = document.getElementById('inputRollout').value;
            const isForceUpdate = document.getElementById('checkForceUpdate').checked;
            const changelog = document.getElementById('inputChangelog').value;

            try {
                const res = await fetch('/api/app-update/publish-release', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        nomorVersi,
                        versionCode,
                        persentaseRollout,
                        isForceUpdate,
                        changelog,
                        fileApkUrl: '/download-apk'
                    })
                });
                const d = await res.json();
                alert(d.message || 'Rilis versi berhasil dipublish');
                location.reload();
            } catch (err) {
                alert('Gagal mempublish: ' + err.message);
            }
        }
    </script>
</body>
</html>
