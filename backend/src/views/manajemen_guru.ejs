<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Guru & Staff - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    
    <!-- Sidebar Admin (Navy Blue) -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-0 md:ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex justify-between items-center mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">Manajemen Guru &amp; Staff</h1>
                    <p class="text-slate-500 text-xs">Pengelolaan akun pengajar, NIP, mata pelajaran, dan wali kelas</p>
                </div>
            </div>
            <div class="space-x-2">
                <button onclick="openSendEFileModal(null, null)" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg shadow font-semibold flex items-center gap-1.5 inline-flex">
                    <span>📤</span> <span>Kirim E-File Dokumen</span>
                </button>
                <button onclick="openAddModal()" class="bg-unbk-blue hover:bg-blue-800 text-white px-4 py-2 rounded-lg shadow font-semibold">
                    + Tambah Guru
                </button>
            </div>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-lg shadow overflow-hidden flex flex-col h-full">
            <div class="p-4 flex justify-between bg-gray-50 border-b">
                <input type="text" id="searchInput" placeholder="Cari Nama / NIP / Mapel / Kelas Ajar..." class="border p-2 rounded w-1/3" oninput="debounceSearch()">
                <div class="space-x-2">
                    <button onclick="syncToLocal()" id="btnSync" class="bg-green-100 text-green-700 px-4 py-2 rounded font-semibold text-sm hover:bg-green-200">⟳ Sinkron ke Lokal (CBT)</button>
                </div>
            </div>
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse whitespace-nowrap" id="teacherTable">
                    <thead>
                        <tr class="bg-gray-200 text-gray-700 text-sm">
                            <th class="p-4 border-b">NIP / Username</th>
                            <th class="p-4 border-b">Nama Guru</th>
                            <th class="p-4 border-b">Mata Pelajaran</th>
                            <th class="p-4 border-b">Kelas Ajar</th>
                            <th class="p-4 border-b">Wali Kelas</th>
                            <th class="p-4 border-b">No. HP</th>
                            <th class="p-4 border-b">Alamat</th>
                            <th class="p-4 border-b">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="teacherTableBody">
                        <tr><td colspan="8" class="p-4 text-center">Memuat data guru dari Supabase...</td></tr>
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination Controls -->
            <div class="p-4 bg-gray-50 border-t flex justify-between items-center text-sm text-gray-600">
                <span id="pageInfo">Menampilkan 0-0 dari 0 guru</span>
                <div class="space-x-2">
                    <button onclick="prevPage()" class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300 disabled:opacity-50" id="btnPrev">Sebelumnya</button>
                    <button onclick="nextPage()" class="px-3 py-1 bg-unbk-blue text-white rounded hover:bg-blue-800 disabled:opacity-50" id="btnNext">Selanjutnya</button>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal Tambah / Edit Guru -->
    <div id="modalTeacher" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-3xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl border">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">👨‍🏫</span>
                    <div>
                        <h2 class="text-base font-bold text-gray-800" id="modalTitle">Tambah Guru &amp; Tenaga Pendidik</h2>
                        <p class="text-[11px] text-gray-500">Kelola akun, NIP login, mata pelajaran, dan wali kelas</p>
                    </div>
                </div>
                <button type="button" onclick="closeTeacherModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>
            <form id="teacherForm" class="space-y-3">
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Nama Lengkap</label>
                    <input type="text" id="tNama" class="w-full border p-2.5 rounded-xl text-xs" required placeholder="Cth: Siti Nurhayati, S.Pd">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">NIP / Username Login</label>
                    <input type="text" id="tNip" class="w-full border p-2.5 rounded-xl text-xs" required placeholder="Cth: 198001012005011001 atau GURU-123456">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Mata Pelajaran</label>
                    <input type="text" id="tMapel" class="w-full border p-2.5 rounded-xl text-xs" placeholder="Cth: Matematika, IPA, PJOK">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Kelas Ajar (Pisahkan koma)</label>
                    <input type="text" id="tKelasAjar" class="w-full border p-2.5 rounded-xl text-xs" placeholder="Cth: VII-A, VII-B, VIII-A">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Tugaskan sbg Wali Kelas</label>
                    <select id="tClassId" class="w-full border p-2.5 rounded-xl text-xs">
                        <option value="">-- Bukan Wali Kelas --</option>
                    </select>
                </div>
                <div class="bg-teal-50 border border-teal-200 p-3 rounded-xl flex items-center gap-3">
                    <input type="checkbox" id="tIsBk" class="w-4 h-4 text-teal-600 rounded focus:ring-teal-500">
                    <label for="tIsBk" class="text-xs font-bold text-teal-900 cursor-pointer">
                        🕊️ Tag Peran: Guru Bimbingan Konseling (BK)
                    </label>
                </div>
                <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl flex items-center gap-3">
                    <input type="checkbox" id="tIsKurikulum" class="w-4 h-4 text-amber-600 rounded focus:ring-amber-500">
                    <label for="tIsKurikulum" class="text-xs font-bold text-amber-900 cursor-pointer">
                        🏛️ Tag Peran: Tim Kurikulum (Approval Izin Guru, Laporan & Akademik)
                    </label>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">No. HP / WhatsApp</label>
                    <input type="text" id="tNoHp" class="w-full border p-2.5 rounded-xl text-xs" placeholder="Cth: 08123456789">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Alamat Lengkap</label>
                    <textarea id="tAlamat" class="w-full border p-2.5 rounded-xl text-xs" rows="2" placeholder="Cth: Tulungagung"></textarea>
                </div>
                <div class="flex justify-end space-x-2 pt-4 border-t">
                    <button type="button" onclick="closeTeacherModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold px-4 py-2 rounded-xl text-xs">Batal</button>
                    <button type="submit" class="bg-unbk-blue hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs shadow">Simpan Data Guru</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Kirim E-File Otomatis by Name Guru -->
    <div id="modalSendEFile" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-3xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl border border-slate-200">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📁</span>
                    <div>
                        <h2 class="text-base font-bold text-gray-800">Kirim E-File Dokumen ke Guru</h2>
                        <p class="text-[11px] text-blue-600 font-semibold" id="sendEFileTargetLabel">Penerima: Bapak/Ibu Guru</p>
                    </div>
                </div>
                <button type="button" onclick="closeSendEFileModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>
            <form id="sendEFileForm" class="space-y-3">
                <input type="hidden" id="targetTeacherId">
                
                <div>
                    <label class="block text-xs font-bold mb-1 text-gray-700">Distribusi Penerima</label>
                    <select id="efileTargetType" class="w-full border p-2 rounded-xl text-xs bg-gray-50 font-semibold" onchange="toggleEfileTargetFields()">
                        <option value="SINGLE">👤 1 Guru Tertentu (Pilih Spesifik)</option>
                        <option value="ALL">👥 Seluruh Guru (Broadcast Semua Guru)</option>
                        <option value="CLASS">🏫 Guru Pengampu Tingkat / Kelas Tertentu</option>
                    </select>
                </div>

                <!-- Pilihan 1 Guru Spesifik (Dengan Input Cari Guru) -->
                <div id="wrapperTargetTeacherSingle" class="p-3 bg-blue-50/80 border border-blue-200 rounded-2xl space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold text-blue-950">Pilih 1 Guru Spesifik Penerima File:</label>
                        <span class="text-[10px] text-blue-700 font-semibold" id="teacherMatchCount"></span>
                    </div>
                    <div class="relative">
                        <input type="text" id="searchEfileTeacherInput" placeholder="🔍 Ketik nama / NIP guru untuk mencari..." class="w-full border border-blue-300 rounded-xl p-2.5 pl-8 text-xs bg-white focus:ring-2 focus:ring-blue-500 outline-none" oninput="filterEfileTeachers()">
                        <span class="absolute left-2.5 top-2.5 text-xs text-blue-400">🔍</span>
                    </div>
                    <select id="efileTargetTeacherSelect" class="w-full border border-blue-300 p-2.5 rounded-xl text-xs font-semibold bg-white text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none" onchange="onSelectSingleTeacher(this.value)"></select>
                    <p class="text-[10px] text-blue-600/90 font-medium">Berkas akan langsung dikirim ke aplikasi APK milik guru yang dipilih.</p>
                </div>

                <!-- Pilihan Tingkat / Rombel Sasaran -->
                <div id="wrapperTargetClass" class="hidden p-3 bg-indigo-50/80 border border-indigo-200 rounded-2xl space-y-2">
                    <label class="block text-xs font-bold text-indigo-950">Pilih Rombel / Tingkat Sasaran (VII, VIII, IX):</label>
                    <select id="efileTargetClass" class="w-full border border-indigo-300 p-2.5 rounded-xl text-xs font-semibold bg-white text-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none" onchange="onSelectTargetClass(this.value)">
                        <optgroup label="Tingkat Kelas (Seluruh Guru Pengampu Tingkat)">
                            <option value="TINGKAT_VII">🟢 Tingkat VII (Seluruh Guru Kelas 7: VII-A s.d VII-K)</option>
                            <option value="TINGKAT_VIII">🔵 Tingkat VIII (Seluruh Guru Kelas 8: VIII-A s.d VIII-K)</option>
                            <option value="TINGKAT_IX">🟣 Tingkat IX (Seluruh Guru Kelas 9: IX-A s.d IX-K)</option>
                        </optgroup>
                        <optgroup label="Rombel Spesifik Tertentu" id="optgroupSpecificRombel">
                        </optgroup>
                    </select>
                    <p class="text-[10px] text-indigo-700 font-medium">Berkas otomatis disebarkan ke seluruh guru pengampu di tingkat / rombel yang dipilih.</p>
                </div>

                <div>
                    <label class="block text-xs font-bold mb-1 text-gray-700">Judul Berkas / Surat</label>
                    <input type="text" id="efileTitle" class="w-full border p-2.5 rounded-xl text-xs" required placeholder="Cth: Surat Tugas Pengawas Ujian / Profil Guru">
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-sm font-semibold mb-1 text-gray-700">Kategori Dokumen</label>
                        <select id="efileCategory" class="w-full border p-2 rounded text-sm">
                            <option value="SURAT_TUGAS">Surat Tugas &amp; SK</option>
                            <option value="PROFIL">Profil Guru</option>
                            <option value="MODUL_AJAR">Modul Ajar &amp; Perangkat</option>
                            <option value="RPP_SILABUS">Silabus / RPP</option>
                            <option value="SOAL_LATIHAN">Bank Soal &amp; Kisi-Kisi</option>
                            <option value="PRIBADI">Berkas Administrasi Lainnya</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1 text-gray-700">Periode Kirim</label>
                        <input type="text" id="efilePeriod" class="w-full border p-2 rounded text-sm" placeholder="Insidental, Triwulan III, dsb." value="Insidental">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Sumber Dokumen</label>
                    <input type="text" id="efileSource" class="w-full border p-2 rounded text-sm" placeholder="Cth: Tata Usaha, Kepala Sekolah, Dapodik, MGMP" value="Tata Usaha">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Pilih Berkas Dokumen (PDF / Dokumen)</label>
                    <input type="file" id="efileFileInput" class="w-full border p-2 rounded text-sm" required accept=".pdf,.doc,.docx,.jpg,.png">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1 text-gray-700">Catatan Tambahan (Opsional)</label>
                    <textarea id="efileNotes" class="w-full border p-2 rounded text-sm" rows="2" placeholder="Catatan khusus dari operator sekolah..."></textarea>
                </div>

                <div class="flex justify-end space-x-2 pt-4 border-t">
                    <button type="button" onclick="closeSendEFileModal()" class="bg-gray-400 hover:bg-gray-500 text-white font-semibold px-4 py-2 rounded">Batal</button>
                    <button type="submit" id="btnSubmitEFile" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded shadow">🚀 Kirim ke APK Guru</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) { window.location.href = '/'; }

        let allTeachers = [];
        let filteredTeachers = [];
        let allClasses = [];
        let editId = null;

        // Pagination vars
        let currentPage = 1;
        const rowsPerPage = 50;

        // Caching Logic
        const cachedTeachers = sessionStorage.getItem('teachers_cache');
        if(cachedTeachers) {
            try {
                const parsed = JSON.parse(cachedTeachers);
                if(Array.isArray(parsed)) {
                    allTeachers = parsed;
                    filteredTeachers = [...allTeachers];
                    renderTable();
                }
            } catch(e) {}
        }

        async function loadClasses() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.status === 401 || res.status === 403) {
                    localStorage.removeItem('token');
                    window.location.href = '/';
                    return;
                }
                const data = await res.json();
                if(Array.isArray(data)) {
                    allClasses = data;
                    const sel = document.getElementById('tClassId');
                    sel.innerHTML = '<option value="">-- Bukan Wali Kelas --</option>';
                    allClasses.forEach(k => {
                        sel.innerHTML += `<option value="${k.id}">${k.nama} (Tingkat ${k.tingkat || '-'})</option>`;
                    });
                }
            } catch(e) {
                console.error('Error loading classes:', e);
            }
        }

        async function loadTeachers() {
            try {
                const res = await fetch('/api/admin/teachers', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.status === 401 || res.status === 403) {
                    localStorage.removeItem('token');
                    window.location.href = '/';
                    return;
                }
                const data = await res.json();
                if(Array.isArray(data)) {
                    allTeachers = data;
                    filteredTeachers = [...allTeachers];
                    sessionStorage.setItem('teachers_cache', JSON.stringify(allTeachers));
                    renderTable();
                } else {
                    document.getElementById('teacherTableBody').innerHTML = `<tr><td colspan="8" class="p-4 text-center text-red-500">${data.message || 'Gagal memuat data guru'}</td></tr>`;
                }
            } catch(e) {
                console.error(e);
                document.getElementById('teacherTableBody').innerHTML = `<tr><td colspan="8" class="p-4 text-center text-red-500">Terjadi kesalahan saat memuat data.</td></tr>`;
            }
        }

        function renderTable() {
            const tbody = document.getElementById('teacherTableBody');
            tbody.innerHTML = '';

            if(filteredTeachers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="p-4 text-center">Belum ada guru ditemukan</td></tr>';
                document.getElementById('pageInfo').innerText = '0 guru';
                document.getElementById('btnPrev').disabled = true;
                document.getElementById('btnNext').disabled = true;
                return;
            }

            const totalPages = Math.ceil(filteredTeachers.length / rowsPerPage);
            if(currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            const paginatedData = filteredTeachers.slice(start, end);

            let html = '';
            paginatedData.forEach(t => {
                let tagsHtml = '';
                const isBk = t.role === 'COUNSELOR' || (t.tags && t.tags.includes('BK')) || t.isBk || (t.tugasTambahan && t.tugasTambahan.includes('BK'));
                const isKurikulum = t.role === 'KURIKULUM' || (t.tags && t.tags.includes('KURIKULUM')) || t.isKurikulum || (t.tugasTambahan && t.tugasTambahan.includes('KURIKULUM')) || (t.rolesTambahan && t.rolesTambahan.includes('kurikulum'));

                if (isKurikulum) {
                    tagsHtml += '<span class="inline-flex items-center gap-1 bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 rounded-full text-[11px] font-bold mr-1">🏛️ Kurikulum</span>';
                }
                if (isBk) {
                    tagsHtml += '<span class="inline-flex items-center gap-1 bg-teal-50 text-teal-800 border border-teal-200 px-2 py-0.5 rounded-full text-[11px] font-bold mr-1">🕊️ Guru BK</span>';
                }
                if (t.wali_kelas) {
                    const waliName = t.wali_kelas.nama || t.wali_kelas.name || t.wali_kelas;
                    tagsHtml += `<span class="inline-flex items-center gap-1 bg-blue-50 text-blue-800 border border-blue-200 px-2 py-0.5 rounded-full text-[11px] font-bold mr-1">👨‍🏫 Wali ${waliName}</span>`;
                }
                if (!tagsHtml) {
                    tagsHtml = '<span class="text-slate-400 text-[11px] italic">Guru Mapel</span>';
                }

                const rawMapel = t.mata_pelajaran || t.teachingSubject || '';
                const mapel = (rawMapel && rawMapel !== '-') 
                    ? `<span class="bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-lg text-xs font-bold border border-indigo-200">${rawMapel}</span>` 
                    : '<span class="text-slate-400 text-xs italic">-</span>';

                const rawKelas = t.kelas_ajar || t.teachingClasses || '';
                const kelasAjar = (rawKelas && rawKelas !== '-')
                    ? `<span class="font-semibold text-slate-700">${rawKelas}</span>`
                    : '<span class="text-slate-400 text-xs italic">-</span>';

                const noHp = t.no_hp || t.parentPhone || '-';
                const alamat = t.alamat ? (t.alamat.length > 25 ? t.alamat.substring(0, 25) + '...' : t.alamat) : '-';

                html += `
                    <tr class="hover:bg-blue-50/60 border-b transition-colors">
                        <td class="p-4 font-mono text-xs font-bold text-slate-700">${t.nip || '-'}</td>
                        <td class="p-4 font-extrabold text-slate-800">${t.nama || '-'}</td>
                        <td class="p-4 text-xs font-semibold text-slate-700">${mapel}</td>
                        <td class="p-4 text-xs text-slate-600">${kelasAjar}</td>
                        <td class="p-4 whitespace-nowrap">${tagsHtml}</td>
                        <td class="p-4 font-mono text-xs text-slate-600">${noHp}</td>
                        <td class="p-4 text-xs text-slate-500 truncate max-w-[150px]" title="${t.alamat || ''}">${alamat}</td>
                        <td class="p-4 space-x-1.5 whitespace-nowrap text-center">
                            <button onclick="openSendEFileModal('${t.id}', '${t.nama ? t.nama.replace(/'/g, "\\'") : ''}')" class="text-blue-700 hover:text-white hover:bg-blue-600 text-xs font-bold bg-blue-50 px-2.5 py-1.5 rounded-lg border border-blue-200 transition-all shadow-sm">
                                📤 Kirim E-File
                            </button>
                            <button onclick="editTeacher('${t.id}')" class="text-emerald-700 hover:text-white hover:bg-emerald-600 text-xs font-bold bg-emerald-50 px-2.5 py-1.5 rounded-lg border border-emerald-200 transition-all">
                                Edit
                            </button>
                            <button onclick="deleteTeacher('${t.id}')" class="text-rose-700 hover:text-white hover:bg-rose-600 text-xs font-bold bg-rose-50 px-2.5 py-1.5 rounded-lg border border-rose-200 transition-all">
                                Hapus
                            </button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;

            document.getElementById('pageInfo').innerText = `Menampilkan ${start + 1}-${Math.min(end, filteredTeachers.length)} dari ${filteredTeachers.length} guru`;
            document.getElementById('btnPrev').disabled = currentPage === 1;
            document.getElementById('btnNext').disabled = currentPage === totalPages;
        }

        function prevPage() { if(currentPage > 1) { currentPage--; renderTable(); } }
        function nextPage() { if(currentPage * rowsPerPage < filteredTeachers.length) { currentPage++; renderTable(); } }

        let searchTimeout;
        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                const query = document.getElementById("searchInput").value.toLowerCase();
                filteredTeachers = allTeachers.filter(t => 
                    (t.nama && t.nama.toLowerCase().includes(query)) ||
                    (t.nip && t.nip.toLowerCase().includes(query)) ||
                    (t.mata_pelajaran && t.mata_pelajaran.toLowerCase().includes(query)) ||
                    (t.kelas_ajar && t.kelas_ajar.toLowerCase().includes(query)) ||
                    (t.alamat && t.alamat.toLowerCase().includes(query))
                );
                currentPage = 1;
                renderTable();
            }, 250);
        }

        function openAddModal() {
            editId = null;
            document.getElementById('modalTitle').innerText = 'Tambah Guru Baru';
            document.getElementById('teacherForm').reset();
            document.getElementById('tClassId').value = '';
            document.getElementById('tIsBk').checked = false;
            document.getElementById('tIsKurikulum').checked = false;
            document.getElementById('modalTeacher').classList.remove('hidden');
        }

        function editTeacher(id) {
            const t = allTeachers.find(x => x.id == id);
            if(!t) return;
            editId = id;
            document.getElementById('modalTitle').innerText = 'Edit Guru';
            document.getElementById('tNama').value = t.nama || '';
            document.getElementById('tNip').value = t.nip || '';
            document.getElementById('tMapel').value = t.mata_pelajaran || t.teachingSubject || '';
            document.getElementById('tKelasAjar').value = t.kelas_ajar || t.teachingClasses || '';
            document.getElementById('tNoHp').value = t.no_hp || t.parentPhone || '';
            document.getElementById('tAlamat').value = t.alamat || t.address || '';
            document.getElementById('tClassId').value = t.wali_kelas ? t.wali_kelas.id : '';
            document.getElementById('tIsBk').checked = Boolean(t.role === 'COUNSELOR' || t.isBk || (t.tugasTambahan && t.tugasTambahan.includes('BK')));
            document.getElementById('tIsKurikulum').checked = Boolean(t.role === 'KURIKULUM' || t.isKurikulum || (t.tugasTambahan && t.tugasTambahan.includes('KURIKULUM')) || (t.rolesTambahan && t.rolesTambahan.includes('kurikulum')));
            document.getElementById('modalTeacher').classList.remove('hidden');
        }

        function closeTeacherModal() {
            document.getElementById('modalTeacher').classList.add('hidden');
        }

        document.getElementById('teacherForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                nama: document.getElementById('tNama').value,
                nip: document.getElementById('tNip').value,
                mata_pelajaran: document.getElementById('tMapel').value,
                kelas_ajar: document.getElementById('tKelasAjar').value,
                no_hp: document.getElementById('tNoHp').value,
                alamat: document.getElementById('tAlamat').value,
                classId: document.getElementById('tClassId').value || null,
                isBk: document.getElementById('tIsBk').checked,
                isKurikulum: document.getElementById('tIsKurikulum').checked
            };

            const url = editId ? '/api/admin/teachers/' + editId : '/api/admin/teachers';
            const method = editId ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify(payload)
            });

            if(res.ok) {
                alert(editId ? 'Data guru berhasil diupdate' : 'Guru berhasil ditambahkan ke Supabase');
                closeTeacherModal();
                loadTeachers();
            } else {
                const errData = await res.json().catch(() => ({}));
                alert(errData.message || 'Gagal menyimpan guru');
            }
        });

        async function deleteTeacher(id) {
            const t = allTeachers.find(x => x.id == id);
            const teacherName = t ? (t.nama || t.name) : 'guru ini';
            const teacherNip = t ? (t.nip || t.username || '-') : '-';

            if (!confirm(`⚠️ PERINGATAN HAPUS GURU:\nApakah Anda yakin ingin menghapus data guru:\nNama: ${teacherName}\nNIP: ${teacherNip}\n\nTindakan ini PERMANEN dan akan menghapus akun guru dari portal database lokal CBT dan Supabase serta melepaskan jabatan wali kelas.`)) {
                return;
            }

            try {
                const res = await fetch('/api/admin/teachers/' + id, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': 'Bearer ' + token
                    }
                });
                const result = await res.json().catch(() => ({}));
                if (res.ok && (result.success || result.message)) {
                    alert(result.message || 'Guru berhasil dihapus.');
                    loadTeachers();
                } else {
                    alert('Gagal menghapus guru: ' + (result.message || 'Terjadi kesalahan sistem'));
                }
            } catch (err) {
                console.error('Error deleting teacher:', err);
                alert('Terjadi kesalahan jaringan saat menghapus guru.');
            }
        }

        function toggleEfileTargetFields() {
            const type = document.getElementById('efileTargetType').value;
            const wrapSingle = document.getElementById('wrapperTargetTeacherSingle');
            const wrapClass = document.getElementById('wrapperTargetClass');
            
            if (wrapSingle) wrapSingle.classList.toggle('hidden', type !== 'SINGLE');
            if (wrapClass) wrapClass.classList.toggle('hidden', type !== 'CLASS');

            if (type === 'ALL') {
                document.getElementById('sendEFileTargetLabel').innerText = 'Penerima: 📢 SELURUH GURU (Broadcast Berkas ke Semua APK Guru)';
            } else if (type === 'CLASS') {
                const classSelect = document.getElementById('efileTargetClass');
                const selectedText = classSelect.options[classSelect.selectedIndex]?.text || 'Kelas Tertentu';
                document.getElementById('sendEFileTargetLabel').innerText = 'Penerima: Guru Pengampu ' + selectedText;
            } else if (type === 'SINGLE') {
                const sel = document.getElementById('efileTargetTeacherSelect');
                const selName = sel.options[sel.selectedIndex]?.text || 'Guru Terpilih';
                document.getElementById('sendEFileTargetLabel').innerText = 'Penerima: ' + selName;
            }
        }

        function onSelectSingleTeacher(teacherId) {
            document.getElementById('targetTeacherId').value = teacherId;
            const sel = document.getElementById('efileTargetTeacherSelect');
            const selName = sel.options[sel.selectedIndex]?.text || '';
            document.getElementById('sendEFileTargetLabel').innerText = 'Penerima: ' + selName;
        }

        function filterEfileTeachers() {
            const query = (document.getElementById('searchEfileTeacherInput').value || '').toLowerCase().trim();
            const tSelect = document.getElementById('efileTargetTeacherSelect');
            const currentSelected = document.getElementById('targetTeacherId').value;
            if (!tSelect) return;

            tSelect.innerHTML = '';
            const filtered = (allTeachers || []).filter(t => {
                const name = (t.nama || '').toLowerCase();
                const nip = (t.nip || '').toLowerCase();
                const mapel = (t.mata_pelajaran || '').toLowerCase();
                return name.includes(query) || nip.includes(query) || mapel.includes(query);
            });

            const matchCountEl = document.getElementById('teacherMatchCount');
            if (matchCountEl) {
                matchCountEl.innerText = `${filtered.length} dari ${allTeachers.length} guru`;
            }

            if (filtered.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.innerText = '-- Tidak ada guru yang cocok --';
                tSelect.appendChild(opt);
                document.getElementById('targetTeacherId').value = '';
                return;
            }

            filtered.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                let tagDesc = '';
                if (t.role === 'COUNSELOR') tagDesc = ' [Guru BK]';
                else if (t.wali_kelas) tagDesc = ' [Wali ' + (t.wali_kelas.nama || t.wali_kelas) + ']';
                opt.innerText = (t.nama || 'Guru') + ' (' + (t.nip || 'NIP -') + ')' + tagDesc;
                if (currentSelected && t.id === currentSelected) opt.selected = true;
                tSelect.appendChild(opt);
            });

            if (!filtered.some(t => t.id === currentSelected) && filtered.length > 0) {
                tSelect.selectedIndex = 0;
                document.getElementById('targetTeacherId').value = filtered[0].id;
            }
            onSelectSingleTeacher(tSelect.value);
        }

        function onSelectTargetClass(classVal) {
            const classSelect = document.getElementById('efileTargetClass');
            const selectedText = classSelect.options[classSelect.selectedIndex]?.text || classVal;
            document.getElementById('sendEFileTargetLabel').innerText = 'Penerima: Guru Pengampu ' + selectedText;
        }

        function openSendEFileModal(teacherId, teacherName) {
            // Reset search input
            const searchInput = document.getElementById('searchEfileTeacherInput');
            if (searchInput) searchInput.value = '';

            const activeTargetId = teacherId || (allTeachers.length > 0 ? allTeachers[0].id : '');
            document.getElementById('targetTeacherId').value = activeTargetId;

            // Populate teacher select dropdown
            filterEfileTeachers();
            if (teacherId) {
                const tSelect = document.getElementById('efileTargetTeacherSelect');
                if (tSelect) tSelect.value = teacherId;
                onSelectSingleTeacher(teacherId);
            }

            document.getElementById('efileTargetType').value = teacherId ? 'SINGLE' : (allTeachers.length > 0 ? 'SINGLE' : 'ALL');
            
            // Populate classes in optgroupSpecificRombel without clearing optgroup Tingkat
            const optgroupRombel = document.getElementById('optgroupSpecificRombel');
            if (optgroupRombel) {
                optgroupRombel.innerHTML = '';
                allClasses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.className || c.name || c.id;
                    opt.innerText = 'Kelas ' + (c.className || c.name);
                    optgroupRombel.appendChild(opt);
                });
            }

            toggleEfileTargetFields();

            document.getElementById('efileTitle').value = '';
            document.getElementById('efilePeriod').value = 'Insidental';
            document.getElementById('efileSource').value = 'Tata Usaha / Kurikulum';
            document.getElementById('efileFileInput').value = '';
            document.getElementById('efileNotes').value = '';

            document.getElementById('modalSendEFile').classList.remove('hidden');
        }

        function closeSendEFileModal() {
            document.getElementById('modalSendEFile').classList.add('hidden');
        }

        document.getElementById('sendEFileForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const targetType = document.getElementById('efileTargetType').value;
            const targetId = document.getElementById('targetTeacherId').value;
            const targetClass = document.getElementById('efileTargetClass').value;
            const title = document.getElementById('efileTitle').value.trim();
            const category = document.getElementById('efileCategory').value;
            const period = document.getElementById('efilePeriod').value.trim();
            const source = document.getElementById('efileSource').value.trim();
            const fileInput = document.getElementById('efileFileInput');
            const notes = document.getElementById('efileNotes').value.trim();

            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Silakan pilih berkas dokumen yang akan dikirim.');
                return;
            }

            const file = fileInput.files[0];
            const btnSubmit = document.getElementById('btnSubmitEFile');
            const origText = btnSubmit.innerText;
            btnSubmit.innerText = 'Mengunggah & Mengirim...';
            btnSubmit.disabled = true;

            try {
                const reader = new FileReader();
                reader.onload = async () => {
                    const base64Data = reader.result;
                    const res = await fetch('/api/teacher/efiles', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + token
                        },
                        body: JSON.stringify({
                            title,
                            category,
                            period,
                            source,
                            fileBase64: base64Data,
                            fileName: file.name,
                            description: notes,
                            targetType,
                            targetTeacherId: targetType === 'SINGLE' ? targetId : null,
                            targetClass: targetType === 'CLASS' ? targetClass : null
                        })
                    });

                    const data = await res.json();
                    if (res.ok) {
                        alert('✅ Berkas E-File berhasil didistribusikan ke APK Guru secara instan!');
                        closeSendEFileModal();
                    } else {
                        alert('Gagal mengirim berkas: ' + (data.message || 'Terjadi kesalahan'));
                    }
                    btnSubmit.innerText = origText;
                    btnSubmit.disabled = false;
                };
                reader.readAsDataURL(file);
            } catch (err) {
                console.error(err);
                alert('Gagal membaca berkas dokumen.');
                btnSubmit.innerText = origText;
                btnSubmit.disabled = false;
            }
        });

        async function deleteTeacher(id) {
            if(confirm('Hapus permanen guru ini dari Supabase?')) {
                const res = await fetch('/api/admin/teachers/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    alert('Guru berhasil dihapus');
                    loadTeachers();
                } else {
                    alert('Gagal menghapus guru');
                }
            }
        }

        async function syncToLocal() {
            const btn = document.getElementById('btnSync');
            const originalText = btn.innerText;
            btn.innerText = 'Mensinkronkan...';
            btn.disabled = true;
            try {
                const res = await fetch('/api/admin/teachers/sync', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                alert(data.message || 'Sinkronisasi guru ke lokal selesai');
            } catch(e) {
                alert('Gagal sinkronisasi');
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        loadClasses();
        loadTeachers();
    </script>
</body>
</html>
