<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Operator - Smart School CBT</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex h-screen overflow-hidden antialiased">
    
    <!-- Unified Operator Sidebar -->
    <%- include('partials/sidebar_operator') %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-200/80 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-7 bg-sky-600 rounded-full"></div>
                        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Manajemen Ujian & Token CBT</h1>
                        <span class="bg-sky-50 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full border border-sky-200">Proktor Panel</span>
                    </div>
                    <p class="text-slate-500 text-xs mt-1 ml-5">Aktifkan ujian, perbarui token acak berkala, dan verifikasi status proctoring siswa.</p>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-2">
                <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border border-indigo-500/40 px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-semibold">🕒 Jam Server:</span>
                    <span class="server-clock-display font-mono text-emerald-400 font-extrabold text-xs tracking-wider">--:--:-- WIB</span>
                </div>
                <a href="/operator/pengumuman" class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all">
                    <span>📢</span> Siaran Pengumuman
                </a>
                <a href="/operator/cbt" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all">
                    <span>📝</span> Bank Soal &amp; Buat Soal AI
                </a>
                <a href="/operator/monitoring" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all">
                    <span>🖥️</span> Live Monitoring Ujian
                </a>
                <button onclick="loadExams()" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-100 shadow-sm flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>🔄</span> Refresh
                </button>
            </div>
        </header>

        <!-- Daftar Ujian / Bank Soal Cards -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/60">
                <h2 class="font-extrabold text-sm text-slate-800 flex items-center gap-2">
                    <span>📋</span> Sesi Ujian Berjalan & Terjadwal
                </h2>
                <span class="text-xs text-slate-500 font-semibold" id="examCountBadge">0 Sesi Ditemukan</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[650px]" id="examTable">
                    <thead>
                        <tr class="bg-slate-50/80 text-slate-500 text-[11px] font-extrabold uppercase tracking-wider border-b border-slate-200">
                            <th class="p-4">Judul Ujian</th>
                            <th class="p-4">Mata Pelajaran</th>
                            <th class="p-4">Durasi Waktu</th>
                            <th class="p-4 text-center">Token Ujian Siswa</th>
                            <th class="p-4">Status Sesi</th>
                            <th class="p-4 text-right">Aksi Proktor</th>
                        </tr>
                    </thead>
                    <tbody id="examTableBody" class="divide-y divide-slate-100 text-xs">
                        <tr><td colspan="6" class="p-8 text-center text-slate-400">Memuat data ujian proktor...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        const token = localStorage.getItem('token');
        if(!token) { window.location.href = '/'; }
        
        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            if (payload && payload.name) {
                document.getElementById('profileName').innerText = payload.name;
            }
        } catch(e) {}

        let exams = [];

        async function loadExams() {
            try {
                const res = await fetch('/api/guru/exams', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    exams = await res.json();
                    renderExams();
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderExams() {
            const tbody = document.getElementById('examTableBody');
            tbody.innerHTML = '';
            document.getElementById('examCountBadge').innerText = exams.length + ' Sesi Ditemukan';

            if(exams.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Belum ada paket ujian aktif yang dibuat oleh Guru.</td></tr>';
                return;
            }

            exams.forEach(e => {
                const statusBadge = e.isTokenActive 
                    ? '<span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full text-[11px] font-bold border border-emerald-200"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> LIVE / AKTIF</span>'
                    : '<span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-[11px] font-bold border border-slate-200">DITUTUP</span>';

                const toggleBtn = e.isTokenActive
                    ? `<button onclick="toggleExam('${e.id}', false)" class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 px-3.5 py-1.5 rounded-xl font-bold text-xs transition-colors shadow-sm">Hentikan Ujian</button>`
                    : `<button onclick="toggleExam('${e.id}', true)" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-1.5 rounded-xl font-bold text-xs transition-all shadow-md shadow-emerald-600/20">Mulai Ujian</button>`;

                tbody.innerHTML += `
                    <tr class="hover:bg-blue-50/40 transition-colors">
                        <td class="p-4 font-bold text-slate-800">${e.title}</td>
                        <td class="p-4 font-semibold text-blue-700">${e.subject ? e.subject.name : '-'}</td>
                        <td class="p-4 text-slate-600 font-medium">${e.durationMinutes} Menit</td>
                        <td class="p-4 text-center">
                            <span class="font-mono text-base font-black tracking-widest bg-blue-50 text-blue-800 px-3.5 py-1.5 rounded-xl border border-blue-200 select-all shadow-inner">${e.token || 'UNBK26'}</span>
                            <div class="mt-1.5">
                                <button onclick="resetToken('${e.id}')" class="text-[11px] font-bold text-blue-600 hover:text-blue-800 hover:underline">⟳ Acak Token Baru</button>
                            </div>
                        </td>
                        <td class="p-4">${statusBadge}</td>
                        <td class="p-4 text-right space-x-1.5 whitespace-nowrap">
                            <a href="/operator/monitoring" class="inline-flex items-center gap-1 bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-xl font-bold text-xs transition-colors shadow-sm">
                                <span>🖥️</span> Monitor
                            </a>
                            ${toggleBtn}
                        </td>
                    </tr>
                `;
            });
        }

        async function toggleExam(examId, isActive) {
            const res = await fetch('/api/cbt/toggle-token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ examId, isActive })
            });
            if(res.ok) {
                loadExams();
            } else {
                alert('Gagal mengubah status ujian');
            }
        }

        async function resetToken(examId) {
            const res = await fetch('/api/cbt/toggle-token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ examId, resetToken: true })
            });
            if(res.ok) {
                loadExams();
            } else {
                alert('Gagal mereset token');
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        initServerClock();
        loadExams();

        // Real-Time Server Clock (WIB 24 Jam)
        let serverClockOffset = 0;
        async function initServerClock() {
            try {
                const res = await fetch('/api/server-time');
                if (res.ok) {
                    const data = await res.json();
                    serverClockOffset = data.timestamp - Date.now();
                }
            } catch (e) {
                console.warn('Gagal sinkronisasi waktu server:', e);
            }
            updateServerClock();
            setInterval(updateServerClock, 1000);
        }

        function updateServerClock() {
            const clockEls = document.querySelectorAll('.server-clock-display');
            if (!clockEls.length) return;
            const now = new Date(Date.now() + serverClockOffset);
            const timeStr = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Jakarta',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            }).format(now) + ' WIB';
            
            clockEls.forEach(el => {
                el.innerText = timeStr;
            });
        }
    </script>
</body>
</html>
