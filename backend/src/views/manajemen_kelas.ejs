        // --- GPS Map Modal Functions ---
        const SMP_DEFAULT_LAT = -8.125506;
        const SMP_DEFAULT_LNG = 111.893526;
        let activeGpsIsLocked = false;

        function parseCoord(val, defaultVal) {
            const num = parseFloat(val);
            if (isNaN(num) || num === 0 || Math.abs(num) < 0.0001) return defaultVal;
            return num;
        }

        function updateModalLockState(isLocked) {
            activeGpsIsLocked = isLocked;
            const notice = document.getElementById('gpsLockNotice');
            const btnToggle = document.getElementById('btnModalGpsLockToggle');
            const icon = document.getElementById('btnModalGpsLockIcon');
            const text = document.getElementById('btnModalGpsLockText');
            const inputRadius = document.getElementById('inputRadius');
            const btnSave = document.getElementById('btnSaveGps');
            const btnAdmin = document.getElementById('btnAdminGps');
            const btnSmp = document.getElementById('btnSmpGps');

            if (isLocked) {
                if (notice) notice.classList.remove('hidden');
                if (btnToggle) {
                    btnToggle.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow bg-red-600 hover:bg-red-700 text-white border border-red-500';
                }
                if (icon) icon.innerText = '🔒';
                if (text) text.innerText = 'Terkunci (Buka)';
                if (inputRadius) inputRadius.disabled = true;
                if (btnSave) {
                    btnSave.disabled = true;
                    btnSave.classList.add('opacity-50', 'cursor-not-allowed');
                }
                if (btnAdmin) btnAdmin.disabled = true;
                if (btnSmp) btnSmp.disabled = true;
                if (mapMarker && mapMarker.dragging) mapMarker.dragging.disable();
            } else {
                if (notice) notice.classList.add('hidden');
                if (btnToggle) {
                    btnToggle.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow bg-slate-700 hover:bg-slate-600 text-white border border-slate-500';
                }
                if (icon) icon.innerText = '🔓';
                if (text) text.innerText = 'Kunci GPS';
                if (inputRadius) inputRadius.disabled = false;
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                if (btnAdmin) btnAdmin.disabled = false;
                if (btnSmp) btnSmp.disabled = false;
                if (mapMarker && mapMarker.dragging) mapMarker.dragging.enable();
            }
        }

        async function toggleGpsLockInModal() {
            if (!activeGpsKelasId) return;
            await toggleGpsLockClass(activeGpsKelasId, '', true);
        }

        async function toggleGpsLockClass(id, name, fromModal = false) {
            try {
                const res = await fetch(`/api/kelas/${id}/toggle-gps-lock`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    }
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    if (fromModal) {
                        updateModalLockState(Boolean(data.isGpsLocked));
                    }
                    await loadKelas();
                } else {
                    alert(data.message || 'Gagal mengubah kunci GPS');
                }
            } catch (err) {
                alert('Terjadi kesalahan: ' + err.message);
            }
        }

        function openGpsModal(id, nama, lat, lng, radius, isLocked = false) {
            activeGpsKelasId = id;
            const validLat = parseCoord(lat, SMP_DEFAULT_LAT);
            const validLng = parseCoord(lng, SMP_DEFAULT_LNG);
            const validRadius = parseInt(radius) || 10;

            document.getElementById('gpsModalClassName').innerText = `Kelas ${nama}`;
            document.getElementById('inputLat').value = validLat.toFixed(6);
            document.getElementById('inputLng').value = validLng.toFixed(6);
            document.getElementById('inputRadius').value = validRadius;
            document.getElementById('gpsStatusText').innerText = '';
            document.getElementById('modalGps').classList.remove('hidden');

            updateModalLockState(Boolean(isLocked));

            setTimeout(() => {
                if (!leafletMap) {
                    // Fix default Leaflet marker icon URLs
                    delete L.Icon.Default.prototype._getIconUrl;
                    L.Icon.Default.mergeOptions({
                        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
                        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
                        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
                    });

                    leafletMap = L.map('leafletMapContainer', {
                        center: [validLat, validLng],
                        zoom: 18,
                        maxZoom: 19
                    });

                    // Layer Google Streets (Jalan & Bangunan Jelas Indonesia, tanpa API Key)
                    const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
                        maxZoom: 20,
                        attribution: '© Google Maps'
                    }).addTo(leafletMap);

                    // Layer Google Satelit Hybrid (Foto Udara Atap Gedung & Ruang Kelas)
                    const googleSatellite = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
                        maxZoom: 20,
                        attribution: '© Google Satellite'
                    });

                    // Layer OpenStreetMap Standar
                    const osmTile = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        subdomains: 'abc',
                        attribution: '© OpenStreetMap contributors'
                    });

                    // Layer Esri Citra Satelit
                    const esriImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                        maxZoom: 19,
                        attribution: '© Esri, Maxar, Earthstar Geographics'
                    });

                    L.control.layers({
                        "🗺️ Google Streets (Jalan & Nama)": googleStreets,
                        "🛰️ Google Satelit (Atap Kelas)": googleSatellite,
                        "🌐 OpenStreetMap Standar": osmTile,
                        "📷 Esri Citra Satelit": esriImagery
                    }).addTo(leafletMap);

                    mapMarker = L.marker([validLat, validLng], { draggable: !activeGpsIsLocked }).addTo(leafletMap);
                    mapCircle = L.circle([validLat, validLng], {
                        color: '#2563eb',
                        fillColor: '#3b82f6',
                        fillOpacity: 0.25,
                        radius: validRadius
                    }).addTo(leafletMap);

                    mapMarker.on('dragend', function(e) {
                        if (activeGpsIsLocked) return;
                        const pos = e.target.getLatLng();
                        document.getElementById('inputLat').value = pos.lat.toFixed(6);
                        document.getElementById('inputLng').value = pos.lng.toFixed(6);
                        mapCircle.setLatLng(pos);
                    });

                    leafletMap.on('click', function(e) {
                        if (activeGpsIsLocked) return;
                        const pos = e.latlng;
                        document.getElementById('inputLat').value = pos.lat.toFixed(6);
                        document.getElementById('inputLng').value = pos.lng.toFixed(6);
                        mapMarker.setLatLng(pos);
                        mapCircle.setLatLng(pos);
                    });
                } else {
                    leafletMap.setView([validLat, validLng], 18);
                    mapMarker.setLatLng([validLat, validLng]);
                    mapCircle.setLatLng([validLat, validLng]);
                    mapCircle.setRadius(validRadius);
                    if (mapMarker.dragging) {
                        if (activeGpsIsLocked) mapMarker.dragging.disable();
                        else mapMarker.dragging.enable();
                    }
                }

                leafletMap.invalidateSize();
                setTimeout(() => { if (leafletMap) leafletMap.invalidateSize(); }, 150);
                setTimeout(() => { if (leafletMap) leafletMap.invalidateSize(); }, 350);
                setTimeout(() => { if (leafletMap) leafletMap.invalidateSize(); }, 700);
            }, 50);
        }

        function resetGpsToSmp() {
            if (activeGpsIsLocked) return;
            document.getElementById('inputLat').value = SMP_DEFAULT_LAT.toFixed(6);
            document.getElementById('inputLng').value = SMP_DEFAULT_LNG.toFixed(6);
            if (leafletMap && mapMarker && mapCircle) {
                leafletMap.setView([SMP_DEFAULT_LAT, SMP_DEFAULT_LNG], 18);
                mapMarker.setLatLng([SMP_DEFAULT_LAT, SMP_DEFAULT_LNG]);
                mapCircle.setLatLng([SMP_DEFAULT_LAT, SMP_DEFAULT_LNG]);
            }
            document.getElementById('gpsStatusText').innerText = '📍 Koordinat disetel ke SMP Negeri 1 Boyolangu';
        }

        function updateCircleRadiusLive(val) {
            if (activeGpsIsLocked) return;
            const r = parseInt(val) || 10;
            if (mapCircle) {
                mapCircle.setRadius(r);
            }
        }

        let adminGpsWatchId = null;

        function closeGpsModal() {
            if (adminGpsWatchId !== null) {
                navigator.geolocation.clearWatch(adminGpsWatchId);
                adminGpsWatchId = null;
            }
            const txtWatch = document.getElementById('txtGpsWatch');
            if (txtWatch) txtWatch.innerText = 'Kunci GPS Presisi (Live)';
            document.getElementById('modalGps').classList.add('hidden');
            activeGpsKelasId = null;
        }

        function handleGpsSuccess(position) {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;
            const acc = Math.round(position.coords.accuracy || 0);
            document.getElementById('inputLat').value = lat.toFixed(6);
            document.getElementById('inputLng').value = lng.toFixed(6);

            const statusEl = document.getElementById('gpsStatusText');
            if (statusEl) {
                if (acc <= 15) {
                    statusEl.innerHTML = `<span class="text-emerald-700 font-bold bg-emerald-100 px-2 py-0.5 rounded">🟢 Akurasi Terkunci: ±${acc}m (Presisi Tinggi &le; 15m)</span>`;
                } else {
                    statusEl.innerHTML = `<span class="text-amber-700 font-bold bg-amber-100 px-2 py-0.5 rounded">🟡 Akurasi: ±${acc}m (Sinyal satelit belum stabil, tunggu &le; 15m)</span>`;
                }
            }

            if (leafletMap && mapMarker && mapCircle) {
                leafletMap.setView([lat, lng], 18);
                mapMarker.setLatLng([lat, lng]);
                mapCircle.setLatLng([lat, lng]);
            }
        }

        function getCurrentAdminGps() {
            if (activeGpsIsLocked) return;
            const statusEl = document.getElementById('gpsStatusText');
            if (statusEl) statusEl.innerText = 'Mengambil sinyal GPS akurat...';
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        handleGpsSuccess(position);
                    },
                    (error) => {
                        console.warn('High accuracy GPS timed out / failed:', error.message, '- retrying standard accuracy...');
                        navigator.geolocation.getCurrentPosition(
                            (pos2) => {
                                handleGpsSuccess(pos2);
                            },
                            (err2) => {
                                if (statusEl) statusEl.innerHTML = `<span class="text-rose-600 font-bold">❌ Gagal mengambil GPS: ${err2.message}. Pastikan izin lokasi browser aktif.</span>`;
                            },
                            { enableHighAccuracy: false, timeout: 15000, maximumAge: 60000 }
                        );
                    },
                    { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
                );
            } else {
                if (statusEl) statusEl.innerText = 'Browser tidak mendukung GPS';
            }
        }

        function toggleAdminGpsWatch() {
            if (activeGpsIsLocked) return;
            const statusEl = document.getElementById('gpsStatusText');
            const txtWatch = document.getElementById('txtGpsWatch');
            if (adminGpsWatchId !== null) {
                navigator.geolocation.clearWatch(adminGpsWatchId);
                adminGpsWatchId = null;
                if (txtWatch) txtWatch.innerText = 'Kunci GPS Presisi (Live)';
                if (statusEl) statusEl.innerText = 'Pemantauan live GPS dihentikan.';
                return;
            }
            if ("geolocation" in navigator) {
                if (txtWatch) txtWatch.innerText = 'Stop Pantau Live';
                if (statusEl) statusEl.innerText = 'Melacak sinyal satelit GPS real-time...';
                adminGpsWatchId = navigator.geolocation.watchPosition(
                    (pos) => handleGpsSuccess(pos),
                    (err) => {
                        if (statusEl) statusEl.innerText = 'Gagal melacak GPS: ' + err.message;
                    },
                    { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
                );
            } else {
                if (statusEl) statusEl.innerText = 'Browser tidak mendukung GPS';
            }
        }

        async function saveGpsCoordinates() {
            if(!activeGpsKelasId) return;
            if(activeGpsIsLocked) {
                alert('🔒 Koordinat kelas ini sedang DIKUNCI. Silakan buka kunci terlebih dahulu.');
                return;
            }
            const lat = parseFloat(document.getElementById('inputLat').value);
            const lng = parseFloat(document.getElementById('inputLng').value);
            const radiusMeters = parseInt(document.getElementById('inputRadius').value) || 10;

            try {
                const res = await fetch(`/api/kelas/${activeGpsKelasId}/coordinates`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ lat, lng, radiusMeters })
                });

                const data = await res.json();
                if(res.ok) {
                    alert(data.message || 'Koordinat kelas berhasil disimpan!');
                    closeGpsModal();
                    loadKelas();
                } else {
                    alert(data.message || 'Gagal menyimpan koordinat');
                }
            } catch(e) {
                alert('Kesalahan jaringan: ' + e.message);
            }
        }


        let editKelasId = null;

        function filterWaliTeachers(preselectedId) {
            const query = (document.getElementById('searchWaliTeacherInput').value || '').toLowerCase().trim();
            const sel = document.getElementById('waliKelasId');
            const currentVal = preselectedId !== undefined ? preselectedId : sel.value;
            sel.innerHTML = '<option value="">-- Belum Atur Wali Kelas --</option>';

            const filtered = (allTeachers || []).filter(t => {
                const nama = (t.nama || '').toLowerCase();
                const nip = (t.nip || '').toLowerCase();
                return nama.includes(query) || nip.includes(query);
            });

            const matchEl = document.getElementById('waliMatchCount');
            if (matchEl) matchEl.innerText = `${filtered.length} dari ${allTeachers.length} guru`;

            filtered.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                opt.innerText = `${t.nama} (${t.nip || 'NIP -'})`;
                if (currentVal && t.id === currentVal) opt.selected = true;
                sel.appendChild(opt);
            });
        }

        function openAddModal() {
            editKelasId = null;
            document.getElementById('modalAddTitle').innerText = 'Tambah Kelas Baru';
            document.getElementById('addKelasForm').reset();
            document.getElementById('searchWaliTeacherInput').value = '';
            filterWaliTeachers('');
            document.getElementById('modalAdd').classList.remove('hidden');
        }

        function editKelas(id) {
            const k = allKelas.find(x => x.id === id);
            if(!k) return;
            editKelasId = id;
            document.getElementById('modalAddTitle').innerText = `Edit Kelas & Atur Wali: Kelas ${k.nama}`;
            document.getElementById('tingkat').value = k.tingkat || 'VII';
            document.getElementById('namaKelas').value = k.nama || '';
            document.getElementById('searchWaliTeacherInput').value = '';

            let selectedVal = k.wali_kelas_id || '';
            if (!selectedVal && k.wali_kelas_nama) {
                const matched = allTeachers.find(t => t.nama && t.nama.toLowerCase().trim() === k.wali_kelas_nama.toLowerCase().trim());
                if (matched) selectedVal = matched.id;
            }
            filterWaliTeachers(selectedVal);
            document.getElementById('modalAdd').classList.remove('hidden');
        }

        document.getElementById('addKelasForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                tingkat: document.getElementById('tingkat').value,
                nama: document.getElementById('namaKelas').value,
                wali_kelas_id: document.getElementById('waliKelasId').value || null
            };

            const url = editKelasId ? '/api/kelas/' + editKelasId : '/api/kelas';
            const method = editKelasId ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method: method,
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(payload)
            });

            if(res.ok) {
                alert(editKelasId ? 'Wali Kelas & Data Kelas berhasil diperbarui' : 'Kelas berhasil ditambahkan');
                document.getElementById('modalAdd').classList.add('hidden');
                document.getElementById('addKelasForm').reset();
                switchTab(payload.tingkat);
                loadKelas();
                loadTeachers();
            } else {
                alert('Gagal menyimpan kelas');
            }
        });

        // --- Class Officers Functions ---
        let currentOfficerClassId = null;
        let currentClassStudents = [];
        const officerSelectIds = ['officerKetua', 'officerWakil', 'officerSekretaris1', 'officerSekretaris2', 'officerBendahara1', 'officerBendahara2'];

        function refreshOfficerSelectOptions(initialOverrides) {
            // Ambil seluruh siswa yang saat ini terpilih di semua dropdown
            const currentSelections = {};
            officerSelectIds.forEach(id => {
                if (initialOverrides && initialOverrides[id] !== undefined) {
                    currentSelections[id] = initialOverrides[id] || '';
                } else {
                    const el = document.getElementById(id);
                    currentSelections[id] = el ? el.value : '';
                }
            });

            // Kumpulan ID siswa yang sudah dipilih (kecuali nilai kosong)
            const allSelectedIds = Object.values(currentSelections).filter(val => Boolean(val));

            officerSelectIds.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                const myVal = currentSelections[id];

                el.innerHTML = '<option value="">-- Belum Dipilih --</option>';
                currentClassStudents.forEach(s => {
                    // Siswa tampil jika: dipilih di dropdown INI, ATAU belum dipilih di jabatan APAPUN
                    const isSelectedInOther = allSelectedIds.includes(s.id) && s.id !== myVal;
                    if (!isSelectedInOther) {
                        const opt = document.createElement('option');
                        opt.value = s.id;
                        const roleTag = s.classRole ? ` [Saat ini: ${s.classRole}]` : '';
                        opt.innerText = `${s.name} (${s.nisn || s.username || 'NISN -'})${roleTag}`;
                        if (s.id === myVal) {
                            opt.selected = true;
                        }
                        el.appendChild(opt);
                    }
                });
            });
        }

        // Pasang listener 'change' ke seluruh dropdown agar otomatis filter dinamis
        officerSelectIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('change', () => refreshOfficerSelectOptions());
            }
        });

        async function openClassOfficersModal(classId, className) {
            currentOfficerClassId = classId;
            document.getElementById('officerClassId').value = classId;
            document.getElementById('officerModalClassName').innerText = className;
            document.getElementById('officerLoadingState').classList.remove('hidden');
            document.getElementById('officerForm').classList.add('hidden');
            document.getElementById('modalClassOfficers').classList.remove('hidden');

            try {
                const res = await fetch(`/api/kelas/${encodeURIComponent(classId)}/officers`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (!res.ok) {
                    alert(data.message || 'Gagal memuat data pengurus kelas');
                    closeClassOfficersModal();
                    return;
                }

                currentClassStudents = data.students || [];
                document.getElementById('officerStudentCount').innerText = `${currentClassStudents.length} Siswa Terdaftar`;

                const officers = data.officers || {};
                refreshOfficerSelectOptions({
                    officerKetua: officers.ketuaId,
                    officerWakil: officers.wakilId,
                    officerSekretaris1: officers.sekretaris1Id,
                    officerSekretaris2: officers.sekretaris2Id,
                    officerBendahara1: officers.bendahara1Id,
                    officerBendahara2: officers.bendahara2Id
                });

                document.getElementById('officerLoadingState').classList.add('hidden');
                document.getElementById('officerForm').classList.remove('hidden');
            } catch(err) {
                console.error(err);
                alert('Gagal menghubungi server untuk memuat siswa kelas: ' + err.message);
                closeClassOfficersModal();
            }
        }

        function closeClassOfficersModal() {
            document.getElementById('modalClassOfficers').classList.add('hidden');
            currentOfficerClassId = null;
        }

        document.getElementById('officerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!currentOfficerClassId) return;

            const payload = {
                ketuaId: document.getElementById('officerKetua').value || null,
                wakilId: document.getElementById('officerWakil').value || null,
                sekretaris1Id: document.getElementById('officerSekretaris1').value || null,
                sekretaris2Id: document.getElementById('officerSekretaris2').value || null,
                bendahara1Id: document.getElementById('officerBendahara1').value || null,
                bendahara2Id: document.getElementById('officerBendahara2').value || null,
            };

            const btn = document.getElementById('btnSaveOfficers');
            const origText = btn.innerText;
            btn.innerText = 'Menyimpan...';
            btn.disabled = true;

            try {
                const res = await fetch(`/api/kelas/${encodeURIComponent(currentOfficerClassId)}/officers`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message || 'Pengurus kelas berhasil disimpan!');
                    closeClassOfficersModal();
                    loadKelas();
                } else {
                    alert(data.message || 'Gagal menyimpan susunan pengurus');
                }
            } catch (err) {
                alert('Kesalahan jaringan: ' + err.message);
            } finally {
                btn.innerText = origText;
                btn.disabled = false;
            }
        });

        async function deleteKelas(id) {
            if(confirm('Hapus permanen kelas ini? (Awas: Siswa yang berada di kelas ini bisa error)')) {
                await fetch('/api/kelas/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
                loadKelas();
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        loadTeachers();
        loadKelas();
    </script>
</body>
</html>
