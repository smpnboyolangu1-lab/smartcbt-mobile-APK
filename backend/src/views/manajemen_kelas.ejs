<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIAKAD - Manajemen Kelas & Peta Barcode</title>
    <script src="/js/tailwind.js"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { 'unbk-blue': '#00509d', 'unbk-light': '#00a2e8' } } }
        }
    </script>
    <!-- Leaflet OpenStreetMap CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        .tab-btn.active {
            border-bottom: 2px solid #00509d;
            color: #00509d;
            font-weight: bold;
        }
        #leafletMapContainer {
            height: 380px;
            width: 100%;
            border-radius: 0.75rem;
            z-index: 1;
            background-color: #f1f5f9;
        }
        .leaflet-container {
            background-color: #f1f5f9 !important;
            font-family: inherit;
        }
        .leaflet-tile-pane {
            background-color: #f1f5f9;
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-gray-100 min-h-screen flex">
    
    <!-- Sidebar -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-0 md:ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>🏫</span> Manajemen Rombongan Belajar &amp; GPS Barcode
                    </h1>
                    <p class="text-slate-500 text-xs">Kelola wali kelas, koordinat GPS ruang kelas, dan cetak barcode presensi</p>
                </div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <a href="/admin/kelas/print-barcodes?filter=MUSHOLA" target="_blank" class="bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-2 rounded-xl shadow font-bold flex items-center gap-1.5 text-xs" title="Cetak poster barcode Sholat Berjamaah Mushola">
                    <span>🕌</span> Barcode Mushola
                </a>
                <a href="/admin/kelas/print-barcodes?filter=BK" target="_blank" class="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2 rounded-xl shadow font-bold flex items-center gap-1.5 text-xs" title="Cetak poster barcode Siswa Terlambat & Izin Pulang Ruang BK">
                    <span>🏢</span> Barcode BK Terlambat
                </a>
                <a href="/admin/kelas/print-barcodes" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-xl shadow font-bold flex items-center gap-1.5 text-xs">
                    <span>🖨️</span> Cetak Barcode Presensi (A4)
                </a>
                <button onclick="openAddModal()" class="bg-unbk-blue hover:bg-blue-800 text-white px-4 py-2 rounded-xl shadow font-bold text-xs">
                    + Tambah Kelas
                </button>
            </div>
        </div>

        <!-- Info Banner Geofence -->
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6 flex items-center justify-between text-xs text-blue-900 shadow-sm">
            <div class="flex items-center gap-3">
                <span class="text-2xl">📍</span>
                <div>
                    <span class="font-bold text-sm block text-blue-950">Geofence Barcode Pintu Terkunci Otomatis (Toleransi Sesuai Pengaturan Kelas / Default 10 Meter)</span>
                    <span>Siswa hanya dapat memindai barcode Gate-In dan Gate-Out jika GPS perangkat berada dalam jarak radius toleransi kelas (standar 10 meter). Fake GPS diblokir permanen.</span>
                </div>
            </div>
            <div class="font-mono bg-blue-100 border border-blue-300 px-3 py-1.5 rounded-lg font-bold text-blue-800 text-xs">
                Toleransi: Default 10m (Dapat Diatur)
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex border-b mb-4 bg-white px-4 pt-2 rounded-t-lg shadow-sm">
            <button onclick="switchTab('VII')" id="tab-VII" class="tab-btn px-6 py-2 text-gray-600 active">Kelas VII</button>
            <button onclick="switchTab('VIII')" id="tab-VIII" class="tab-btn px-6 py-2 text-gray-600">Kelas VIII</button>
            <button onclick="switchTab('IX')" id="tab-IX" class="tab-btn px-6 py-2 text-gray-600">Kelas IX</button>
            <button onclick="switchTab('SPECIAL')" id="tab-SPECIAL" class="tab-btn px-6 py-2 text-gray-600 flex items-center gap-1.5 font-bold text-teal-700">
                <span>🕌</span> <span>Mushola &amp; Titik Khusus</span>
            </button>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-b-lg shadow overflow-hidden border">
            <table class="w-full text-left border-collapse" id="kelasTable">
                <thead>
                    <tr class="bg-gray-100 text-gray-700 text-xs uppercase tracking-wider">
                        <th class="p-4 border-b">Nama Ruang Kelas</th>
                        <th class="p-4 border-b">Tingkat</th>
                        <th class="p-4 border-b">Wali Kelas</th>
                        <th class="p-4 border-b">📍 Koordinat GPS & Geofence</th>
                        <th class="p-4 border-b">Status Kunci GPS</th>
                        <th class="p-4 border-b">Aksi & Barcode</th>
                    </tr>
                </thead>
                <tbody id="kelasTableBody">
                    <tr><td colspan="6" class="p-4 text-center text-gray-500">Memuat data ruang kelas & koordinat GPS...</td></tr>
                </tbody>
            </table>
        </div>
    </main>

    <!-- Modal Atur Koordinat GPS Kelas (Interactive Leaflet Map) -->
    <div id="modalGps" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="bg-slate-900 text-white p-5 flex justify-between items-center">
                <div>
                    <h2 class="text-lg font-bold flex items-center gap-2">
                        <span>🗺️</span> Atur Titik GPS Ruang Kelas: <span id="gpsModalClassName" class="text-emerald-400"></span>
                    </h2>
                    <p class="text-xs text-slate-300 mt-0.5">Geser pin marker merah atau gunakan tombol GPS akurat</p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="btnModalGpsLockToggle" onclick="toggleGpsLockInModal()" class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow">
                        <span id="btnModalGpsLockIcon">🔒</span> <span id="btnModalGpsLockText">Kunci GPS</span>
                    </button>
                    <button onclick="closeGpsModal()" class="text-slate-400 hover:text-white text-2xl font-bold ml-2">&times;</button>
                </div>
            </div>

            <!-- Notice jika GPS Terkunci -->
            <div id="gpsLockNotice" class="hidden mx-5 mt-4 p-3 bg-red-50 border border-red-300 rounded-xl flex items-center justify-between text-xs text-red-800">
                <div class="flex items-center gap-2">
                    <span class="text-lg">🔒</span>
                    <div>
                        <strong class="font-bold">Koordinat GPS Kelas Ini Sedang DIKUNCI!</strong>
                        <p class="text-[11px] text-red-600">Marker tidak dapat digeser dan radius tidak dapat diubah tanpa membuka kunci.</p>
                    </div>
                </div>
                <button type="button" onclick="toggleGpsLockInModal()" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-lg font-bold shadow text-xs flex items-center gap-1">
                    🔓 Buka Kunci
                </button>
            </div>

            <div class="p-5 space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <button type="button" id="btnAdminGps" onclick="getCurrentAdminGps()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5">
                            <span>🎯</span> GPS HP / Laptop
                        </button>
                        <button type="button" id="btnAdminGpsWatch" onclick="toggleAdminGpsWatch()" class="bg-teal-600 hover:bg-teal-700 text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5">
                            <span>📡</span> <span id="txtGpsWatch">Kunci GPS Presisi (Live)</span>
                        </button>
                        <button type="button" id="btnSmpGps" onclick="resetGpsToSmp()" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5">
                            <span>🏫</span> Default Titik SMP
                        </button>
                    </div>
                    <span id="gpsStatusText" class="text-xs text-slate-500 italic"></span>
                </div>

                <!-- Leaflet Map Container -->
                <div id="leafletMapContainer" class="border-2 border-slate-300 shadow-inner"></div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Latitude</label>
                        <input type="number" step="any" id="inputLat" class="w-full border p-2 rounded-lg text-xs font-mono font-bold bg-gray-50" readonly>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Longitude</label>
                        <input type="number" step="any" id="inputLng" class="w-full border p-2 rounded-lg text-xs font-mono font-bold bg-gray-50" readonly>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Radius Geofence (Meter)</label>
                        <input type="number" id="inputRadius" value="10" min="5" max="500" step="1" oninput="updateCircleRadiusLive(this.value)" class="w-full border p-2 rounded-lg text-xs font-mono font-bold bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none" title="Batas toleransi radius geofence presensi siswa (standar: 10 meter)">
                    </div>
                </div>
            </div>
            <div class="p-4 bg-gray-50 border-t flex justify-end gap-2">
                <button type="button" onclick="closeGpsModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg text-xs font-bold hover:bg-gray-400">Batal</button>
                <button type="button" id="btnSaveGps" onclick="saveGpsCoordinates()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow">Simpan Titik GPS Kelas</button>
            </div>
        </div>
    </div>

    <!-- Modal Tambah / Edit Kelas -->
    <div id="modalAdd" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl overflow-hidden border border-slate-200">
            <!-- Modal Header -->
            <div class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white p-4 px-6 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">🏫</span>
                    <div>
                        <h2 id="modalAddTitle" class="text-base font-bold text-white">Tambah Kelas Baru</h2>
                        <p class="text-[11px] text-blue-200">Pengaturan rombel dan penetapan wali kelas</p>
                    </div>
                </div>
                <button onclick="document.getElementById('modalAdd').classList.add('hidden')" class="text-blue-200 hover:text-white text-2xl font-bold transition-colors">&times;</button>
            </div>
            
            <form id="addKelasForm" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tingkat Kelas</label>
                    <select id="tingkat" class="w-full border border-slate-300 p-2.5 rounded-xl bg-slate-50 text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none" required>
                        <option value="VII">Tingkat VII (Tujuh)</option>
                        <option value="VIII">Tingkat VIII (Delapan)</option>
                        <option value="IX">Tingkat IX (Sembilan)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nama Rombel / Kelas</label>
                    <input type="text" id="namaKelas" placeholder="Cth: VII-A" class="w-full border border-slate-300 p-2.5 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-bold text-slate-700">Wali Kelas</label>
                        <span id="waliMatchCount" class="text-[10px] text-blue-600 font-semibold"></span>
                    </div>
                    <!-- Search Input for Wali Kelas -->
                    <div class="relative mb-2">
                        <input type="text" id="searchWaliTeacherInput" placeholder="🔍 Cari nama guru / NIP..." class="w-full border border-blue-200 rounded-xl p-2 pl-8 text-xs bg-blue-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none" oninput="filterWaliTeachers()">
                        <span class="absolute left-2.5 top-2 text-xs text-blue-400">🔍</span>
                    </div>
                    <select id="waliKelasId" class="w-full border border-slate-300 p-2.5 rounded-xl bg-slate-50 text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="">-- Belum Atur Wali Kelas --</option>
                    </select>
                    <p class="text-[10px] text-slate-500 mt-1">Guru yang dipilih otomatis menjadi wali kelas di portal dan aplikasi APK Guru.</p>
                </div>
                <div class="flex justify-end space-x-2 pt-4 border-t border-slate-100">
                    <button type="button" onclick="document.getElementById('modalAdd').classList.add('hidden')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-xl text-xs font-bold transition-all">Batal</button>
                    <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white px-5 py-2 rounded-xl text-xs font-bold shadow-md transition-all">Simpan Data Kelas</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Pengurus Kelas (Plotting dari Siswa Kelas Tersebut) -->
    <div id="modalClassOfficers" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden border border-slate-200">
            <!-- Header Modal -->
            <div class="bg-gradient-to-r from-purple-900 to-indigo-900 text-white p-4 px-6 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">👥</span>
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            Plotting Pengurus Kelas: <span id="officerModalClassName" class="text-amber-300"></span>
                        </h2>
                        <p class="text-[11px] text-purple-200">Pilih siswa dari kelas ini untuk menjabat Ketua, Wakil, Sekretaris, dan Bendahara</p>
                    </div>
                </div>
                <button onclick="closeClassOfficersModal()" class="text-purple-200 hover:text-white text-2xl font-bold transition-colors">&times;</button>
            </div>

            <!-- Content -->
            <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
                <div class="bg-purple-50 border border-purple-200 rounded-xl p-3 flex items-center justify-between text-xs text-purple-900">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">🎖️</span>
                        <span>Siswa yang diplot otomatis memiliki badge jabatan di APK Siswa dan Data Profil.</span>
                    </div>
                    <span id="officerStudentCount" class="font-bold bg-purple-200/80 px-2 py-0.5 rounded text-[11px] text-purple-900">0 Siswa</span>
                </div>

                <div id="officerLoadingState" class="py-8 text-center text-slate-500 text-xs">
                    <div class="animate-spin inline-block w-6 h-6 border-2 border-purple-600 border-t-transparent rounded-full mb-2"></div>
                    <p>Memuat daftar siswa kelas...</p>
                </div>

                <form id="officerForm" class="hidden space-y-4">
                    <input type="hidden" id="officerClassId">

                    <!-- Ketua & Wakil Ketua -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                            <label class="block text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <span class="bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded text-[10px]">1</span> Ketua Kelas
                            </label>
                            <select id="officerKetua" class="w-full border border-slate-300 p-2 rounded-lg text-xs font-semibold bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                                <option value="">-- Belum Dipilih --</option>
                            </select>
                        </div>

                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                            <label class="block text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <span class="bg-slate-200 text-slate-800 px-1.5 py-0.5 rounded text-[10px]">2</span> Wakil Ketua Kelas
                            </label>
                            <select id="officerWakil" class="w-full border border-slate-300 p-2 rounded-lg text-xs font-semibold bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                                <option value="">-- Belum Dipilih --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Sekretaris 1 & 2 -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                            <label class="block text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <span class="bg-blue-100 text-blue-800 px-1.5 py-0.5 rounded text-[10px]">📝</span> Sekretaris 1
                            </label>
                            <select id="officerSekretaris1" class="w-full border border-slate-300 p-2 rounded-lg text-xs font-semibold bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                                <option value="">-- Belum Dipilih --</option>
                            </select>
                        </div>

                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                            <label class="block text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <span class="bg-blue-100 text-blue-800 px-1.5 py-0.5 rounded text-[10px]">📝</span> Sekretaris 2 (Opsional)
                            </label>
                            <select id="officerSekretaris2" class="w-full border border-slate-300 p-2 rounded-lg text-xs font-semibold bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                                <option value="">-- Belum Dipilih --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Bendahara 1 & 2 -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                            <label class="block text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <span class="bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded text-[10px]">💰</span> Bendahara 1
                            </label>
                            <select id="officerBendahara1" class="w-full border border-slate-300 p-2 rounded-lg text-xs font-semibold bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                                <option value="">-- Belum Dipilih --</option>
                            </select>
                        </div>

                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                            <label class="block text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <span class="bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded text-[10px]">💰</span> Bendahara 2 (Opsional)
                            </label>
                            <select id="officerBendahara2" class="w-full border border-slate-300 p-2 rounded-lg text-xs font-semibold bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                                <option value="">-- Belum Dipilih --</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex justify-end space-x-2 pt-4 border-t border-slate-100">
                        <button type="button" onclick="closeClassOfficersModal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-xl text-xs font-bold transition-all">Batal</button>
                        <button type="submit" id="btnSaveOfficers" class="bg-purple-700 hover:bg-purple-800 text-white px-5 py-2 rounded-xl text-xs font-bold shadow-md transition-all">💾 Simpan Susunan Pengurus</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) { window.location.href = '/'; }
        
        let allKelas = [];
        let allTeachers = [];
        let currentTab = 'VII';

        // Map variables
        let leafletMap = null;
        let mapMarker = null;
        let mapCircle = null;
        let activeGpsKelasId = null;

        async function loadTeachers() {
            try {
                const res = await fetch('/api/admin/teachers', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if(res.status === 401 || res.status === 403) {
                    localStorage.removeItem('token');
                    window.location.href = '/';
                    return;
                }
                const data = await res.json();
                if(Array.isArray(data)) {
                    allTeachers = data;
                    filterWaliTeachers();
                    renderTable();
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function loadKelas() {
            try {
                const res = await fetch('/api/kelas', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if(res.status === 401 || res.status === 403) {
                    localStorage.removeItem('token');
                    window.location.href = '/';
                    return;
                }
                const data = await res.json();
                if(Array.isArray(data)) {
                    allKelas = data;
                    renderTable();
                }
            } catch(e) {
                console.error(e);
            }
        }

        function switchTab(tingkat) {
            currentTab = tingkat;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tingkat).classList.add('active');
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('kelasTableBody');
            tbody.innerHTML = '';

            if (currentTab === 'SPECIAL') {
                tbody.innerHTML = `
                    <tr class="hover:bg-teal-50/50 border-b bg-teal-50/20">
                        <td class="p-4">
                            <span class="font-black text-teal-950 text-base flex items-center gap-2">
                                <span>🕌</span> Masjid / Mushola SMPN 1 Boyolangu
                            </span>
                            <span class="text-[11px] text-teal-700 font-semibold block mt-0.5">Titik Presensi Sholat Dhuha (Pagi), Dhuhur (Siang) &amp; Sholat Jumat Berjamaah</span>
                            <div class="mt-1 flex items-center gap-1.5 flex-wrap">
