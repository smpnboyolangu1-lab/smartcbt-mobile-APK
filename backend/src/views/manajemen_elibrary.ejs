    <script>
        const token = localStorage.getItem('token');
        if(!token) { window.location.href = '/'; }

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name || 'Petugas Pustaka';
            document.getElementById('profileRole').innerText = payload.role || 'Operator';
        } catch(e) {}

        let currentTab = 'catalog';
        let allBooks = [];
        let allCopies = [];
        let allStudents = [];

        async function init() {
            await Promise.all([
                loadLibraryData(),
                loadStudentsList()
            ]);
        }

        async function loadStudentsList() {
            try {
                const res = await fetch('/api/students', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    allStudents = await res.json();
                    const sel = document.getElementById('reassignSelectStudent');
                    sel.innerHTML = '<option value="">-- Pilih Siswa Penerima Buku --</option>';
                    allStudents.forEach(s => {
                        sel.innerHTML += `<option value="${s.id}">${s.name} (${s.className || 'Tanpa Kelas'} - NIS: ${s.nis || '-'})</option>`;
                    });
                }
            } catch(e) { console.error('Error load students', e); }
        }

        let allLibraryMembers = [];

        function switchTab(tab) {
            currentTab = tab;
            ['catalog', 'copies', 'circulation', 'members', 'yearEnd'].forEach(t => {
                const sec = document.getElementById('section' + t.charAt(0).toUpperCase() + t.slice(1));
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                if (sec) sec.classList.add('hidden');
                if (btn) btn.className = 'px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2';
            });

            const activeSec = document.getElementById('section' + tab.charAt(0).toUpperCase() + tab.slice(1));
            const activeBtn = document.getElementById('tabBtn' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activeSec) activeSec.classList.remove('hidden');
            if (activeBtn) activeBtn.className = 'px-6 py-3.5 text-sm active-tab flex items-center gap-2';

            if (tab === 'catalog') loadLibraryData();
            else if (tab === 'copies') loadAllCopies();
            else if (tab === 'members') loadAllMembersData();
            else if (tab === 'yearEnd') loadUnreturnedReport();
        }

        function refreshCurrentTab() {
            if(currentTab === 'catalog') loadLibraryData();
            else if(currentTab === 'copies') loadAllCopies();
            else if(currentTab === 'members') loadAllMembersData();
            else if(currentTab === 'yearEnd') loadUnreturnedReport();
        }

        // ==================== TAB 5: AKHIR TAHUN & KENAIKAN KELAS ====================
        async function executeBulkReturnClass() {
            const cls = document.getElementById('bulkReturnClassSelect').value;
            const year = document.getElementById('bulkReturnYearInput').value;

            if (!confirm(`Konfirmasi: Proses pengembalian kolektif seluruh buku paket untuk rombel ${cls} (Tahun ${year})?\n\nSemua eksemplar buku pinjaman rombel ini akan dikembalikan ke status TERSEDIA.`)) {
                return;
            }

            const btn = document.getElementById('btnBulkReturn');
            btn.disabled = true;
            btn.innerHTML = '<span>⏳</span> Memproses pengembalian...';

            try {
                const res = await fetch('/api/elibrary/bulk-return-class', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ className: cls, academicYear: year })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`✅ Sukses!\n${data.message}\nTotal Buku Diproses: ${data.summary.totalBooksProcessed}`);
                    loadUnreturnedReport();
                } else {
                    alert('❌ Gagal: ' + data.message);
                }
            } catch (e) {
                alert('Kesalahan jaringan saat memproses pengembalian massal: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>✅</span> Proses Pengembalian Kolektif 1 Rombel';
            }
        }

        async function executeRevertLostBook() {
            const barcode = document.getElementById('revertBarcodeCode').value.trim();
            const condition = document.getElementById('revertCondition').value;
            const note = document.getElementById('revertNote').value.trim();

            if (!barcode) {
                alert('Harap isi kode barcode buku yang ditemukan.');
                return;
            }

            try {
                const res = await fetch('/api/elibrary/revert-lost-status', {
