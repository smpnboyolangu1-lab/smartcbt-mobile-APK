        function closeChangeCoverModal() {
            document.getElementById('changeCoverModal').classList.add('hidden');
        }

        function previewSelectedCover(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const previewImg = document.getElementById('coverModalPreviewImg');
                    previewImg.src = e.target.result;
                    previewImg.classList.remove('hidden');
                    document.getElementById('coverModalPlaceholder').classList.add('hidden');
                };
                reader.readAsDataURL(file);
            }
