        function openChangeCoverModal(bookId, title, currentCover) {
            document.getElementById('coverModalBookId').value = bookId;
            document.getElementById('coverModalBookTitle').textContent = decodeURIComponent(title);
            document.getElementById('coverModalFileInput').value = '';
            document.getElementById('coverModalUrlInput').value = currentCover || '';

            const previewImg = document.getElementById('coverModalPreviewImg');
            const placeholder = document.getElementById('coverModalPlaceholder');
            if (currentCover) {
                previewImg.src = currentCover;
                previewImg.classList.remove('hidden');
                placeholder.classList.add('hidden');
            } else {
                previewImg.src = '';
                previewImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }
            document.getElementById('changeCoverModal').classList.remove('hidden');
