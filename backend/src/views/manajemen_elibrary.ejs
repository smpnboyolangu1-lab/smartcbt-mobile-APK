        function filterBooks() {
            const query = (document.getElementById('searchBookInput')?.value || '').toLowerCase().trim();
            const cat = document.getElementById('filterBookCategory')?.value || 'ALL';
            const filtered = allBooks.filter(b => {
                const matchQuery = !query || 
                    (b.title && b.title.toLowerCase().includes(query)) || 
                    (b.author && b.author.toLowerCase().includes(query)) || 
                    (b.isbn && b.isbn.toLowerCase().includes(query)) ||
                    (b.barcodeCode && b.barcodeCode.toLowerCase().includes(query)) ||
                    (b.subject && b.subject.toLowerCase().includes(query));

                const bCat = ((b.category || '') + ' ' + (b.subject || '') + ' ' + (b.title || '')).toUpperCase();
                let matchCat = true;
                if (cat === 'BUKU_PAKET') matchCat = b.isTextbook === true || bCat.includes('PAKET') || bCat.includes('PELAJARAN');
                else if (cat === 'REFERENSI') matchCat = bCat.includes('REFERENSI') || bCat.includes('ENSIKLOPEDIA') || bCat.includes('KAMUS');
                else if (cat === 'FIKSI') matchCat = bCat.includes('NOVEL') || bCat.includes('FIKSI') || bCat.includes('CERPEN');
                else if (cat === 'KOMIK') matchCat = bCat.includes('KOMIK') || bCat.includes('BERGAMBAR') || bCat.includes('MANGA');
                else if (cat === 'SAINS') matchCat = bCat.includes('IPA') || bCat.includes('SAINS') || bCat.includes('MATEMATIKA') || bCat.includes('FISIKA') || bCat.includes('BIOLOGI');
                else if (cat === 'BAHASA') matchCat = bCat.includes('BAHASA') || bCat.includes('INDONESIA') || bCat.includes('INGGRIS') || bCat.includes('JAWA');
                else if (cat === 'AGAMA') matchCat = bCat.includes('AGAMA') || bCat.includes('ISLAM') || bCat.includes('PAI');
                else if (cat === 'LAINNYA') matchCat = !b.isTextbook;

                return matchQuery && matchCat;
            });
            renderBooksTable(filtered);
        }

        function filterCopies() {
            const query = document.getElementById('searchCopyInput').value.toLowerCase();
            const filtered = allCopies.filter(c => 
                c.copyBarcode.toLowerCase().includes(query) || 
                (c.book?.title && c.book.title.toLowerCase().includes(query)) ||
                (c.borrower?.name && c.borrower.name.toLowerCase().includes(query)) ||
                (c.borrower?.className && c.borrower.className.toLowerCase().includes(query))
            );
            renderCopiesTable(filtered);
        }

