        async function handleAddBook(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveBook');
            btn.disabled = true;
            btn.innerText = 'Menyimpan & Mengunggah...';

            const title = document.getElementById('bookTitle').value;
            const author = document.getElementById('bookAuthor').value;
            const publisher = document.getElementById('bookPublisher').value;
            const barcodeCode = document.getElementById('bookBarcode').value;
            const isTextbook = document.getElementById('bookIsTextbook').value === 'true';
            const targetClass = document.getElementById('bookTargetClass').value;
            const generateCopiesCount = parseInt(document.getElementById('bookGenerateCount').value) || 0;

            const fileInput = document.getElementById('bookPdfFile');
            let fileBase64 = null;
            let fileName = null;

            if(fileInput.files && fileInput.files[0]) {
                const file = fileInput.files[0];
                fileName = file.name;
                fileBase64 = await new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result.split(',')[1]);
                    reader.readAsDataURL(file);
                });
            }

            try {
                const res = await fetch('/api/elibrary/books', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({
                        title, author, publisher, barcodeCode,
                        stock: generateCopiesCount || 10,
                        isTextbook, targetClass,
                        generateCopiesCount,
                        fileBase64, fileName
                    })
                });

                const data = await res.json();
                if(res.ok && data.success) {
                    alert('✅ ' + data.message);
                    closeAddBookModal();
                    loadLibraryData();
                } else {
                    alert(data.message || 'Gagal menambahkan buku');
                }
            } catch(err) {
                alert('Terjadi kesalahan jaringan');
            } finally {
                btn.disabled = false;
                btn.innerText = '💾 Simpan & Generate Barcode';
            }
        }

