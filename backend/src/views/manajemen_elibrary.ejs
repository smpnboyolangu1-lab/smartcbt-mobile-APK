<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📖 Perpustakaan Digital & Audit Barcode Buku Paket</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .active-tab {
            border-bottom: 3px solid #2563eb;
            color: #1d4ed8;
            font-weight: 700;
        }
        @media print {
            body * { visibility: hidden; }
            #printableBarcodeSection, #printableBarcodeSection * { visibility: visible; }
            #printableBarcodeSection { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-50 text-slate-800 flex h-screen overflow-hidden">
    <!-- Unified Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto h-screen bg-slate-50/70 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📖</span> Perpustakaan Digital &amp; Audit Barcode Buku
                    </h1>
                    <p class="text-slate-500 text-xs mt-0.5">Manajemen E-Book PDF, Pelacakan Barcode Eksemplar Buku Paket &amp; Peminjaman Siswa</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="openAddEbookModal()" class="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow flex items-center gap-2">
                    <span>📱</span> Unggah E-Book / Modul Digital
                </button>
                <button onclick="openAddBookModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow flex items-center gap-2">
                    <span>➕</span> Tambah Judul / Buku Paket
                </button>
                <button onclick="refreshCurrentTab()" class="bg-white border hover:bg-gray-50 text-gray-700 px-3.5 py-2 rounded-lg text-sm font-semibold shadow-sm">
                    🔄 Refresh
                </button>
            </div>
        </div>

        <!-- Summary Stats Cards -->
        <div class="grid grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Total Judul Buku</p>
                    <p class="text-2xl font-bold text-gray-800" id="statTotalTitles">0 Judul</p>
                    <p class="text-xs text-green-600 font-semibold mt-1">🟢 Katalog Terdaftar</p>
                </div>
                <div class="p-3 bg-blue-50 text-blue-700 rounded-xl text-2xl">📘</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Total Fisik & Copy</p>
                    <p class="text-2xl font-bold text-indigo-900" id="statTotalStock">0 Eks</p>
                    <p class="text-xs text-gray-400 mt-1">Eksemplar Tercetak</p>
                </div>
                <div class="p-3 bg-indigo-50 text-indigo-700 rounded-xl text-2xl">📦</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Sedang Dipinjam</p>
                    <p class="text-2xl font-bold text-amber-800" id="statActiveLoans">0 Siswa</p>
                    <p class="text-xs text-amber-600 font-semibold mt-1">⏳ Sirkulasi Siswa</p>
                </div>
                <div class="p-3 bg-amber-50 text-amber-700 rounded-xl text-2xl">🔖</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">E-Book PDF Resmi</p>
                    <p class="text-2xl font-bold text-teal-800" id="statEbooks">0 File</p>
                    <p class="text-xs text-teal-600 font-semibold mt-1">📱 Pembacaan di APK Siswa</p>
                </div>
                <div class="p-3 bg-teal-50 text-teal-700 rounded-xl text-2xl">📲</div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex border-b border-gray-200 mb-6 bg-white px-4 rounded-t-xl shadow-sm">
            <button onclick="switchTab('catalog')" id="tabBtnCatalog" class="px-6 py-3.5 text-sm active-tab flex items-center gap-2">
                <span>📚</span> Katalog Buku & E-Book PDF
            </button>
            <button onclick="switchTab('copies')" id="tabBtnCopies" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>🏷️</span> Audit Barcode Eksemplar & Buku Tertukar
            </button>
            <button onclick="switchTab('circulation')" id="tabBtnCirculation" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>⚡</span> Sirkulasi Cepat (Scan Barcode & QR)
            </button>
            <button onclick="switchTab('members')" id="tabBtnMembers" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>🪪</span> Kartu Anggota Digital Siswa
            </button>
            <button onclick="switchTab('yearEnd')" id="tabBtnYearEnd" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>📋</span> Kenaikan Kelas & Tanggungan Akhir Tahun
            </button>
        </div>

        <!-- TAB 1: Katalog Buku & PDF -->
        <div id="sectionCatalog" class="bg-white rounded-2xl shadow-sm border overflow-hidden">
            <div class="p-5 border-b flex flex-wrap justify-between items-center gap-4 bg-gray-50">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-bold text-gray-700">📖 Katalog Buku &amp; E-Book Terdaftar</span>
                </div>
                <div class="flex items-center gap-2">
                    <select id="filterBookCategory" onchange="filterBooks()" class="border text-xs rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500 font-semibold text-slate-700">
                        <option value="ALL">Semua Kategori</option>
                        <option value="BUKU_PAKET">Buku Paket Pelajaran</option>
                        <option value="REFERENSI">Referensi &amp; Ensiklopedia</option>
                        <option value="FIKSI">Fiksi &amp; Novel</option>
                        <option value="KOMIK">Komik &amp; Bergambar</option>
                        <option value="SAINS">Sains &amp; Matematika</option>
                        <option value="BAHASA">Bahasa &amp; Sastra</option>
                        <option value="AGAMA">Pendidikan Agama</option>
                        <option value="LAINNYA">Koleksi Umum Lainnya</option>
                    </select>
                    <input type="text" id="searchBookInput" onkeyup="filterBooks()" placeholder="Cari judul / pengarang / ISBN..." class="border text-xs rounded-lg px-3.5 py-2 w-72 focus:ring-2 focus:ring-blue-500 bg-white">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 uppercase text-[11px] font-bold border-b">
                            <th class="py-3.5 px-4">Judul Buku / E-Book</th>
                            <th class="py-3.5 px-4">Penulis & Penerbit</th>
                            <th class="py-3.5 px-4">Kategori & Kelas</th>
                            <th class="py-3.5 px-4">Stok / Eksemplar</th>
                            <th class="py-3.5 px-4">E-Book PDF</th>
                            <th class="py-3.5 px-4 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="booksTableBody" class="text-xs divide-y">
                        <tr><td colspan="6" class="text-center py-8 text-gray-400">Memuat katalog buku...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 2: Audit Barcode Eksemplar & Mutasi Buku Tertukar -->
        <div id="sectionCopies" class="hidden bg-white rounded-2xl shadow-sm border overflow-hidden">
            <div class="p-5 border-b flex flex-wrap justify-between items-center gap-4 bg-gray-50">
                <div>
                    <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2">
                        <span>🏷️</span> Audit Barcode Eksemplar Fisik Buku Paket
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">Lacak pemilik buku berdasarkan stiker barcode statis yang tertempel di buku siswa.</p>
                </div>
                <div class="flex gap-2">
                    <input type="text" id="searchCopyInput" onkeyup="filterCopies()" placeholder="Cari Barcode (Cth: BKP-MAT7-001) / Siswa..." class="border text-xs rounded-lg px-3.5 py-2 w-80 bg-white focus:ring-2 focus:ring-blue-500">
                    <button onclick="printSelectedStickers()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3.5 py-2 rounded-lg font-bold shadow flex items-center gap-1.5">
                        <span>🖨️</span> Cetak Stiker Barcode
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 uppercase text-[11px] font-bold border-b">
                            <th class="py-3.5 px-4">Kode Barcode Eksemplar</th>
                            <th class="py-3.5 px-4">Judul Buku Paket</th>
                            <th class="py-3.5 px-4">Status Buku</th>
                            <th class="py-3.5 px-4">Peminjam Resmi Saat Ini</th>
                            <th class="py-3.5 px-4">Tanggal Pinjam</th>
                            <th class="py-3.5 px-4 text-center">Aksi Audit & Mutasi</th>
                        </tr>
                    </thead>
                    <tbody id="copiesTableBody" class="text-xs divide-y">
                        <tr><td colspan="6" class="text-center py-8 text-gray-400">Memuat data eksemplar...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: Sirkulasi Cepat Barcode & QR (Deteksi Buku Tertukar) -->
        <div id="sectionCirculation" class="hidden space-y-6">
            <div class="grid grid-cols-2 gap-6">
                <!-- Peminjaman Cepat -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border">
                    <div class="flex items-center gap-3 border-b pb-4 mb-4">
                        <span class="p-3 bg-blue-50 text-blue-700 rounded-xl text-xl">📤</span>
                        <div>
                            <h3 class="font-bold text-gray-800 text-base">Peminjaman Cepat Buku</h3>
                            <p class="text-xs text-gray-500">Scan Barcode Kartu Siswa + Barcode Buku</p>
                        </div>
                    </div>
                    <form onsubmit="handleQuickCirculation(event, 'BORROW')" class="space-y-4 text-xs">
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan QR Kartu Anggota / Masukkan NISN Siswa</label>
                            <input type="text" id="circBorrowStudentInput" required placeholder="Arahkan scanner ke QR Card atau ketik NISN..." class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan Barcode Eksemplar Buku Fisik</label>
                            <input type="text" id="circBorrowBarcode" required placeholder="Cth: BKP-MAT7-001" class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono focus:ring-2 focus:ring-blue-500 uppercase">
                        </div>
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Durasi Peminjaman (Hari)</label>
                            <input type="number" id="circBorrowDays" value="14" min="1" max="365" class="w-32 border rounded-lg p-2 bg-gray-50 text-sm">
                        </div>
                        <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow text-sm flex items-center justify-center gap-2">
                            <span>📤</span> Proses Peminjaman Cepat
                        </button>
                    </form>
                </div>

                <!-- Pengembalian Cepat & Deteksi Buku Tertukar -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border">
                    <div class="flex items-center gap-3 border-b pb-4 mb-4">
                        <span class="p-3 bg-emerald-50 text-emerald-700 rounded-xl text-xl">📥</span>
                        <div>
                            <h3 class="font-bold text-gray-800 text-base">Pengembalian Cepat (Deteksi Tertukar)</h3>
                            <p class="text-xs text-gray-500">Scan Barcode Buku untuk verifikasi pemilik sah</p>
                        </div>
                    </div>
                    <form onsubmit="handleQuickCirculation(event, 'RETURN')" class="space-y-4 text-xs">
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan Barcode Eksemplar Buku Fisik</label>
                            <input type="text" id="circReturnBarcode" required placeholder="Arahkan scanner ke stiker buku (Cth: BKP-MAT7-001)..." class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono focus:ring-2 focus:ring-emerald-500 uppercase">
                        </div>
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan QR Kartu Siswa yang Mengembalikan (Opsional Verifikasi)</label>
                            <input type="text" id="circReturnStudentInput" placeholder="Ketik/scan jika ingin cek apakah buku ini benar milik siswa tersebut" class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono">
                        </div>
                        <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-amber-900 text-[11px] flex items-center gap-2">
                            <span>⚠️</span>
                            <span>Sistem otomatis mendeteksi jika buku tertukar dengan milik siswa lain dan memberi peringatan.</span>
                        </div>
                        <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold shadow text-sm flex items-center justify-center gap-2">
                            <span>📥</span> Proses Pengembalian Buku
                        </button>
                    </form>
                </div>
            </div>

            <!-- Alert Hasil Scan Sirkulasi -->
            <div id="circResultAlert" class="hidden p-4 rounded-xl border"></div>
        </div>

        <!-- TAB 4: Kartu Anggota Digital Siswa (Batch Print Grid A4) -->
        <div id="sectionMembers" class="hidden bg-white rounded-2xl shadow-sm border p-6">
            <div class="flex justify-between items-center mb-6 pb-4 border-b">
                <div>
                    <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                        <span>🪪</span> Kartu Anggota Digital Siswa Terintegrasi QR Code
                    </h3>
                    <p class="text-xs text-gray-500 mt-1">Kartu Anggota Digital dapat dilihat langsung oleh siswa di Aplikasi APK Android atau dicetak fisik.</p>
                </div>
                <div class="flex gap-3">
                    <input type="text" id="searchMemberInput" onkeyup="filterMembers()" placeholder="Cari Nama / NISN / Kelas..." class="border text-xs rounded-lg px-3.5 py-2 w-64 bg-white">
                    <button onclick="printAllMemberCards()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-4 py-2 rounded-lg font-bold shadow flex items-center gap-1.5">
                        <span>🖨️</span> Cetak Kartu Anggota Siswa (A4 Grid)
                    </button>
                </div>
            </div>

            <div id="membersCardsGrid" class="grid grid-cols-3 gap-4">
                <p class="text-gray-400 text-xs col-span-3 text-center py-8">Memuat daftar anggota perpustakaan...</p>
            </div>
        </div>

        <!-- TAB 5: Kenaikan Kelas & Tanggungan Akhir Tahun -->
        <div id="sectionYearEnd" class="hidden space-y-6">
            <!-- Kebijakan Humanis Banner -->
            <div class="bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 p-5 rounded-2xl flex items-start gap-4 shadow-sm">
                <span class="text-3xl">🕊️</span>
                <div>
                    <h3 class="font-bold text-emerald-900 text-sm">Kebijakan Bebas Biaya Denda & Bebas Penahanan Dokumen (SMPN 1 Boyolangu)</h3>
                    <p class="text-xs text-emerald-800 mt-1 leading-relaxed">
                        1. <strong>Nol Denda Uang:</strong> Tidak ada pungutan denda finansial atas keterlambatan pengembalian buku.<br>
                        2. <strong>Bebas Penahanan Ijazah / Rapor:</strong> Urusan perpustakaan murni tertib inventaris aset buku fisik sekolah dan <strong>tidak boleh menghambat atau menahan penerbitan Ijazah, SKL, Rapor, maupun Surat Pindah</strong>.<br>
                        3. <strong>Penagihan Tertib Fisik:</strong> Penagihan dilakukan secara persuasif dan ramah langsung kepada orang tua siswa.
                    </p>
                </div>
            </div>

            <!-- Panel 1: Pengembalian Massal per Rombel -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">
                <div class="flex justify-between items-center mb-4 pb-3 border-b">
                    <div>
                        <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                            <span>📦</span> Pengembalian Kolektif Buku Paket per Rombongan Belajar (Rombel)
                        </h3>
                        <p class="text-xs text-gray-500 mt-1">Gunakan fitur ini saat akhir tahun ajaran / kenaikan kelas untuk menyelesaikan peminjaman 1 rombel sekaligus.</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Pilih Kelas / Rombel</label>
                        <select id="bulkReturnClassSelect" class="border rounded-lg px-3 py-2 text-xs bg-white font-bold text-slate-800">
                            <option value="VII-A">Kelas VII-A</option>
                            <option value="VII-B">Kelas VII-B</option>
                            <option value="VII-C">Kelas VII-C</option>
                            <option value="VII-D">Kelas VII-D</option>
                            <option value="VII-E">Kelas VII-E</option>
                            <option value="VIII-A">Kelas VIII-A</option>
                            <option value="VIII-B">Kelas VIII-B</option>
                            <option value="VIII-C">Kelas VIII-C</option>
                            <option value="VIII-D">Kelas VIII-D</option>
                            <option value="VIII-E">Kelas VIII-E</option>
                            <option value="IX-A">Kelas IX-A</option>
                            <option value="IX-B">Kelas IX-B</option>
                            <option value="IX-C">Kelas IX-C</option>
                            <option value="IX-D">Kelas IX-D</option>
                            <option value="IX-E">Kelas IX-E</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Tahun Ajaran</label>
                        <input type="text" id="bulkReturnYearInput" value="2026/2027" class="border rounded-lg px-3 py-2 text-xs bg-white font-bold w-28 text-slate-800">
                    </div>

                    <div class="pt-5">
                        <button onclick="executeBulkReturnClass()" id="btnBulkReturn" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow flex items-center gap-2">
                            <span>✅</span> Proses Pengembalian Kolektif 1 Rombel
                        </button>
                    </div>
                </div>
            </div>

            <!-- Panel 2: Pemulihan Status Buku Hilang (Lost-to-Found) -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">
                <div class="flex justify-between items-center mb-4 pb-3 border-b">
                    <div>
                        <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                            <span>🔄</span> Pemulihan Status Buku Hilang (Ditemukan Kembali / Lost-to-Found)
                        </h3>
                        <p class="text-xs text-gray-500 mt-1">Eksemplar buku yang sebelumnya dilaporkan hilang dan ditemukan kembali dapat langsung dipulihkan ke status TERSEDIA.</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs font-bold text-slate-700 mb-1">Barcode Eksemplar Buku yang Ditemukan</label>
                        <input type="text" id="revertBarcodeCode" placeholder="Cth: BKP-MAT7-001" class="border rounded-lg px-3 py-2 text-xs bg-white font-mono font-bold w-full text-slate-800">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Kondisi Fisik Buku</label>
                        <select id="revertCondition" class="border rounded-lg px-3 py-2 text-xs bg-white font-bold text-slate-800">
                            <option value="BAIK">Kondisi Baik</option>
                            <option value="RUSAK_RINGAN">Rusak Ringan (Cover/Halaman Lecet)</option>
                            <option value="RUSAK_BERAT">Rusak Berat</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Catatan Penemuan</label>
                        <input type="text" id="revertNote" placeholder="Ditemukan di ruang kelas / loker" class="border rounded-lg px-3 py-2 text-xs bg-white w-64 text-slate-800">
                    </div>

                    <div class="pt-5">
                        <button onclick="executeRevertLostBook()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow flex items-center gap-2">
                            <span>⚡</span> Pulihkan ke Status TERSEDIA
                        </button>
                    </div>
                </div>
            </div>

            <!-- Panel 3: Laporan Sisa Tanggungan Buku (Termasuk Alumni / Nonaktif) -->
            <div class="bg-white rounded-2xl shadow-sm border p-6">
                <div class="flex justify-between items-center mb-4 pb-3 border-b">
                    <div>
                        <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                            <span>📊</span> Laporan Sisa Buku Belum Kembali (Inventaris Aktif &amp; Siswa Lulus/Alumni)
                        </h3>
                        <p class="text-xs text-gray-500 mt-1">Daftar siswa yang masih tercatat memegang buku fisik sekolah untuk tindak lanjut pengingat ramah.</p>
                    </div>

                    <div class="flex items-center gap-2">
                        <select id="filterReportClass" onchange="loadUnreturnedReport()" class="border rounded-lg px-3 py-1.5 text-xs bg-white font-bold text-slate-800">
