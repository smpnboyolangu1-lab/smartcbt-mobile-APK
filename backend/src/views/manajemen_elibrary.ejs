        function previewUrlCover(url) {
            if (url && (url.startsWith('http') || url.startsWith('/'))) {
                const previewImg = document.getElementById('coverModalPreviewImg');
                previewImg.src = url;
                previewImg.classList.remove('hidden');
                document.getElementById('coverModalPlaceholder').classList.add('hidden');
            }
        }

        async function submitChangeCover() {
            const bookId = document.getElementById('coverModalBookId').value;
            const fileInput = document.getElementById('coverModalFileInput');
            const urlInput = document.getElementById('coverModalUrlInput');
            const btn = document.getElementById('btnSaveCover');

            if (!bookId) return;

            let coverUrl = urlInput.value.trim();
            btn.disabled = true;
            btn.textContent = 'Menyimpan...';

            try {
                if (fileInput.files.length > 0) {
                    const fd = new FormData();
                    fd.append('file', fileInput.files[0]);
                    const upRes = await fetch('/api/elibrary/upload-cover', {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Authorization': 'Bearer ' + token },
                        body: fd
                    });
                    if (upRes.ok) {
                        const upData = await upRes.json();
                        coverUrl = upData.url || upData.filePath;
                    }
                }

                if (!coverUrl) {
                    alert('Pilih berkas gambar atau masukkan URL gambar sampul.');
                    btn.disabled = false;
                    btn.textContent = 'Simpan Sampul';
                    return;
                }

                const res = await fetch(`/api/elibrary/books/${bookId}/cover`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ coverUrl })
                });

                if (res.ok) {
                    alert('✅ Sampul buku berhasil diperbarui!');
                    closeChangeCoverModal();
                    loadBooks();
                } else {
                    const err = await res.json();
                    alert(err.message || 'Gagal memperbarui sampul buku');
                }
            } catch (e) {
                alert('Terjadi kesalahan: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Simpan Sampul';
            }
        }

        async function adjustBookCopies(bookId, delta) {
            const actionText = delta > 0 ? `tambah ${delta}` : `kurangi ${Math.abs(delta)}`;
            if (!confirm(`Apakah Anda yakin ingin ${actionText} eksemplar buku ini?`)) return;

            try {
                const res = await fetch(`/api/elibrary/books/${bookId}/adjust-copies`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ delta })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✅ ' + data.message);
                    loadBooks();
                    loadAllCopies();
                } else {
                    alert(data.message || 'Gagal mengubah stok eksemplar.');
                }
            } catch (e) {
                alert('Terjadi kesalahan: ' + e.message);
            }
        }

        async function promptCustomStock(bookId, title) {
            const input = prompt(`Masukkan jumlah penambahan (+) atau pengurangan (-) eksemplar untuk "${decodeURIComponent(title)}":\nContoh: 10 untuk tambah 10, atau -5 untuk kurangi 5:`, "5");
            if (!input) return;
            const delta = parseInt(input, 10);
            if (isNaN(delta) || delta === 0) {
                alert('Nilai angka tidak valid.');
                return;
            }
            adjustBookCopies(bookId, delta);
        }

        async function handleQuickCirculation(e, action) {
            e.preventDefault();
            const alertBox = document.getElementById('circResultAlert');
            alertBox.className = 'p-4 rounded-xl border';

            let body = { action };
            if(action === 'BORROW') {
                body.barcode = document.getElementById('circBorrowBarcode').value.trim();
                body.studentIdOrNisn = document.getElementById('circBorrowStudentInput').value.trim();
                body.loanDays = parseInt(document.getElementById('circBorrowDays').value) || 14;
            } else {
                body.barcode = document.getElementById('circReturnBarcode').value.trim();
                body.studentIdOrNisn = document.getElementById('circReturnStudentInput').value.trim();
            }

            try {
                const res = await fetch('/api/elibrary/quick-circulation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(body)
                });
                const data = await res.json();

                alertBox.classList.remove('hidden');
                if(res.ok && data.success) {
                    if(data.isSwapped) {
                        alertBox.className = 'p-4 rounded-xl border bg-red-50 border-red-300 text-red-900';
                        alertBox.innerHTML = `
                            <div class="flex items-start gap-3">
                                <span class="text-2xl">🚨</span>
                                <div>
                                    <h4 class="font-bold text-sm">PERINGATAN: BUKU TERTUKAR TERDETEKSI!</h4>
                                    <p class="text-xs mt-1">${data.warning}</p>
                                    <p class="text-xs font-semibold mt-1">Buku ini telah berhasil dikembalikan ke sistem perpustakaan.</p>
                                </div>
                            </div>
                        `;
                    } else {
                        alertBox.className = 'p-4 rounded-xl border bg-emerald-50 border-emerald-300 text-emerald-900';
                        alertBox.innerHTML = `
                            <div class="flex items-start gap-3">
                                <span class="text-2xl">✅</span>
                                <div>
                                    <h4 class="font-bold text-sm">Transaksi Berhasil!</h4>
                                    <p class="text-xs mt-1">${data.message}</p>
                                </div>
                            </div>
                        `;
                    }

                    if(action === 'BORROW') {
                        document.getElementById('circBorrowBarcode').value = '';
                    } else {
                        document.getElementById('circReturnBarcode').value = '';
                        document.getElementById('circReturnStudentInput').value = '';
                    }
                    loadLibraryData();
                } else {
                    alertBox.className = 'p-4 rounded-xl border bg-red-50 border-red-300 text-red-900';
                    alertBox.innerHTML = `<p class="text-xs font-bold">❌ ${data.message || 'Gagal memproses sirkulasi'}</p>`;
                }
            } catch(err) {
                alertBox.classList.remove('hidden');
                alertBox.className = 'p-4 rounded-xl border bg-red-50 border-red-300 text-red-900';
                alertBox.innerHTML = `<p class="text-xs font-bold">❌ Gagal terhubung ke server: ${err.message}</p>`;
            }
        }

        async function loadAllMembersData() {
            try {
                const res = await fetch('/api/elibrary/all-members', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(data.success) {
                    allLibraryMembers = data.members || [];
                    renderMembersCards(allLibraryMembers);
                }
            } catch(e) { console.error('Error load library members', e); }
        }

        function filterMembers() {
            const q = (document.getElementById('searchMemberInput').value || '').toLowerCase();
            const filtered = allLibraryMembers.filter(m => 
                (m.name && m.name.toLowerCase().includes(q)) ||
                (m.nisn && m.nisn.toLowerCase().includes(q)) ||
                (m.className && m.className.toLowerCase().includes(q))
            );
            renderMembersCards(filtered);
        }

        function renderMembersCards(members) {
            const grid = document.getElementById('membersCardsGrid');
            if(members.length === 0) {
                grid.innerHTML = '<p class="text-gray-400 text-xs col-span-3 text-center py-8">Tidak ada anggota siswa ditemukan.</p>';
                return;
            }

            grid.innerHTML = members.map(m => `
                <div class="border-2 border-slate-700 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-4 shadow-md flex flex-col justify-between relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3 border-b border-slate-700 pb-2">
                        <div>
                            <p class="text-[10px] uppercase font-bold tracking-wider text-blue-300">KARTU ANGGOTA PERPUSTAKAAN</p>
                            <h4 class="font-bold text-sm text-white">${m.name}</h4>
                            <p class="text-[11px] text-gray-300">Kelas: ${m.className || '-'} | NISN: ${m.nisn || m.username}</p>
                        </div>
                        <span class="text-xl">📚</span>
                    </div>

                    <div class="flex items-center justify-between mt-2">
                        <div class="bg-white p-2 rounded-xl text-black inline-block shadow">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=${encodeURIComponent(m.qrPayload)}" alt="QR Code" class="w-20 h-20">
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] text-gray-400">ID ANGGOTA</p>
                            <p class="font-mono font-bold text-xs text-amber-300">${m.memberId}</p>
                            <span class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-400/30">
                                Anggota Aktif
                            </span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function printAllMemberCards() {
            const container = document.getElementById('barcodeCardsContainer');
            container.innerHTML = '';
            
            const list = allLibraryMembers.slice(0, 30);
            if(list.length === 0) {
                alert('Tidak ada kartu anggota untuk dicetak');
                return;
            }

            list.forEach(m => {
                container.innerHTML += `
                    <div class="border-2 border-black p-4 rounded-xl text-center bg-white">
                        <p class="font-bold text-xs uppercase tracking-wider">KARTU ANGGOTA PERPUSTAKAAN</p>
                        <h4 class="font-bold text-sm mt-1">${m.name}</h4>
                        <p class="text-xs text-gray-600">Kelas: ${m.className || '-'} | NISN: ${m.nisn || m.username}</p>
                        <div class="my-3 flex justify-center">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(m.qrPayload)}" alt="QR Code" style="width:100px;height:100px;">
                        </div>
                        <p class="font-mono font-bold text-xs">${m.memberId}</p>
                    </div>
                `;
            });

            window.print();
        }

        function openPdfReader(title, url) {
            document.getElementById('pdfReaderTitle').innerText = '📄 Pembaca E-Book: ' + title;
            document.getElementById('pdfFrame').src = url;
            document.getElementById('pdfReaderModal').classList.remove('hidden');
        }

        function closePdfReader() {
            document.getElementById('pdfReaderModal').classList.add('hidden');
            document.getElementById('pdfFrame').src = '';
        }

        function printSelectedStickers() {
            const container = document.getElementById('barcodeCardsContainer');
            container.innerHTML = '';
            
            const list = allCopies.slice(0, 60); // print up to 60 visible copies
            if(list.length === 0) {
                alert('Tidak ada eksemplar untuk dicetak');
                return;
            }

            list.forEach(c => {
                container.innerHTML += `
                    <div class="border-2 border-black p-3 rounded text-center">
                        <p class="font-bold text-xs uppercase tracking-wider">PERPUSTAKAAN SEKOLAH</p>
                        <p class="font-semibold text-[11px] truncate mt-1">${c.book?.title || 'BUKU PAKET'}</p>
                        <div class="my-2 bg-gray-100 p-2 font-mono font-bold text-base border border-dashed border-gray-400">
                            *${c.copyBarcode}*
                        </div>
                        <p class="text-[10px] text-gray-600">Scan Barcode untuk Audit Peminjaman</p>
                    </div>
                `;
            });

            window.print();
        }

        function openAddEbookModal() {
            document.getElementById('addEbookModal').classList.remove('hidden');
        }

        function closeAddEbookModal() {
            document.getElementById('addEbookModal').classList.add('hidden');
        }

        function previewEbookCover(event) {
            const file = event.target.files && event.target.files[0];
            if (file) {
                const preview = document.getElementById('ebookCoverPreview');
                preview.src = URL.createObjectURL(file);
            }
        }

        async function handleSaveEbook(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveEbook');
            btn.disabled = true;
            btn.innerHTML = '<span>⏳</span> Mengunggah E-Book...';

            const formData = new FormData();
            formData.append('judul', document.getElementById('ebookTitle').value.trim());
            formData.append('pengarang', document.getElementById('ebookAuthor').value.trim());
            formData.append('mataPelajaran', document.getElementById('ebookSubject').value.trim());
            formData.append('targetKelas', document.getElementById('ebookTargetGrade').value);
            formData.append('isPublished', document.getElementById('ebookIsPublished').checked ? 'true' : 'false');

            const coverFile = document.getElementById('ebookCoverFile').files[0];
            if (coverFile) {
                formData.append('cover', coverFile);
            }

            const pdfFile = document.getElementById('ebookPdfFileInput').files[0];
            if (pdfFile) {
                formData.append('pdf', pdfFile);
            } else {
                alert('Berkas PDF e-book wajib diunggah!');
                btn.disabled = false;
                btn.innerHTML = '<span>📤</span> Terbitkan E-Book';
                return;
            }

            try {
                const res = await fetch('/api/v1/operator/ebooks', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token
                    },
                    body: formData
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✅ ' + (data.message || 'E-Book berhasil diterbitkan!'));
                    closeAddEbookModal();
                    loadLibraryData();
                } else {
                    alert('❌ ' + (data.message || 'Gagal menerbitkan e-book'));
                }
            } catch (err) {
                alert('❌ Terjadi kesalahan jaringan: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>📤</span> Terbitkan E-Book';
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
