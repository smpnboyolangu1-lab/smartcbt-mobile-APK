<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
    <style>
        .login-glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            box-shadow: 0 25px 50px -12px rgba(30, 64, 175, 0.18), 0 0 0 1px rgba(59, 130, 246, 0.05);
        }
        .bg-portal-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #172554 100%);
        }
        .bg-mesh-pattern {
            background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="bg-portal-gradient bg-mesh-pattern min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden font-sans">
    
    <!-- Ambient glowing backdrop blobs -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="login-glass p-8 sm:p-10 rounded-3xl w-full max-w-md relative z-10 animate-fade-in transition-all">
        
        <!-- Brand Header -->
        <div class="text-center mb-6">
            <div class="inline-flex p-2 rounded-2xl bg-white shadow-lg border border-slate-200 mb-3">
                <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-16 h-16 object-contain drop-shadow" onerror="this.src='/logo.png'">
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Smart School CBT</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">SMPN 1 Boyolangu • Portal Multi-User Terpadu</p>
        </div>
        
        <div id="msg" class="hidden text-center text-sm font-semibold p-3 rounded-xl mb-5 transition-all"></div>

        <form id="loginForm" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="username">Username / NIP / NISN</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 text-sm">👤</span>
                    <input class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none transition-all" id="username" type="text" placeholder="Masukkan ID Pengguna" required>
                </div>
            </div>
            
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="password">Password</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 text-sm">🔒</span>
                    <input class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none transition-all" id="password" type="password" placeholder="••••••••" required>
                </div>
                <p class="text-[11px] text-slate-400 mt-1.5">💡 Masuk menggunakan NIP / NISN / ID Pengguna dan Kata Sandi terdaftar Anda.</p>
            </div>

            <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/30 text-sm flex items-center justify-center gap-2 transition-all transform active:scale-[0.99]" id="loginBtn">
                <span>Masuk ke Portal</span>
                <span>➔</span>
            </button>
        </form>

        <!-- Fast Mobile App Download -->
        <div class="mt-6 pt-5 border-t border-slate-100 text-center">
            <p class="text-[11px] text-slate-500 font-medium mb-3">📱 Unduh Aplikasi Mobile Siswa, Guru & Pengawas:</p>
            <a id="apkDownloadLink" href="/uploads/smartcbt-latest.apk" download="smartcbt-latest.apk" class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/80 rounded-xl font-bold text-xs transition-all shadow-sm">
                <span>📲</span>
                <span id="apkVersionLabel">Unduh APK Smart School v2.9.3 (Build 173)</span>
            </a>
        </div>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const btn = document.getElementById('loginBtn');
            const msgDiv = document.getElementById('msg');
            
            btn.innerHTML = '<span class="animate-spin">🔄</span> <span>Memproses...</span>';
            btn.disabled = true;

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    localStorage.setItem('token', data.token);
                    document.cookie = "token=" + encodeURIComponent(data.token) + "; path=/; max-age=86400";
                    document.cookie = "admin_token=" + encodeURIComponent(data.token) + "; path=/; max-age=86400";
                    if(data.user) {
                        localStorage.setItem('user', JSON.stringify(data.user));
                    }
                    
                    const payload = JSON.parse(atob(data.token.split('.')[1]));
                    const role = String(payload.role || '').toUpperCase().trim();
                    const isCounselor = Boolean(payload.isCounselor);

                    msgDiv.className = "text-center text-xs font-bold p-3 rounded-xl mb-4 bg-emerald-50 text-emerald-800 border border-emerald-200 block";
                    msgDiv.innerHTML = "✅ Login Berhasil! Mengalihkan ke panel " + role + "...";

                    setTimeout(() => {
                        const uLower = username.toLowerCase().trim();
                        const tokenParam = "?token=" + encodeURIComponent(data.token);
                        switch(role) {
                            case 'ADMIN':
                            case 'ADMINISTRATOR':
                            case 'SUPERADMIN':
                                window.location.href = '/admin' + tokenParam; break;
                            case 'OPERATOR':
                                if (uLower === 'piket') {
                                    window.location.href = '/operator/piket' + tokenParam;
                                } else {
                                    window.location.href = '/operator' + tokenParam;
                                }
                                break;
                            case 'COUNSELOR':
                            case 'BK':
                            case 'GURU_BK':
                            case 'GURU BK':
                                window.location.href = '/bk' + tokenParam; break;
                            case 'KURIKULUM':
                                // User Kurikulum diarahkan ke portal kurikulum khusus agar tidak membocorkan data operator non-akademik
                                window.location.href = '/kurikulum' + tokenParam; break;
                            case 'TEACHER':
                            case 'GURU':
                                const userTugas = String(data.user?.tugasTambahan || '').toUpperCase();
                                if (isCounselor || uLower === 'bk' || uLower.includes('bk')) {
                                    window.location.href = '/bk' + tokenParam;
                                } else if (userTugas.includes('KURIKULUM') || uLower.includes('kurikulum')) {
                                    window.location.href = '/kurikulum' + tokenParam;
                                } else {
                                    window.location.href = '/guru' + tokenParam;
                                }
                                break;
                            case 'MEDICAL':
                            case 'UKS':
                                window.location.href = '/uks' + tokenParam; break;
                            case 'LIBRARIAN':
                            case 'PERPUSTAKAAN':
                                window.location.href = '/perpustakaan' + tokenParam; break;
                            case 'SECURITY':
                            case 'SATPAM':
                                window.location.href = '/satpam/gatepass' + tokenParam; break;
                            case 'STUDENT':
                                window.location.href = '/siswa'; break;
                            case 'PARENT':
                                window.location.href = '/orangtua'; break;
                            default:
                                if (isCounselor || uLower === 'bk') {
                                    window.location.href = '/bk' + tokenParam;
                                } else {
                                    window.location.href = '/siswa';
                                }
                        }
                    }, 600);
                } else {
                    msgDiv.className = "text-center text-xs font-bold p-3 rounded-xl mb-4 bg-rose-50 text-rose-800 border border-rose-200 block";
                    msgDiv.innerText = "❌ " + (data.message || "Login gagal, periksa user & password");
                    btn.innerHTML = '<span>Masuk ke Portal</span> <span>➔</span>';
                    btn.disabled = false;
                }
            } catch (err) {
                msgDiv.className = "text-center text-xs font-bold p-3 rounded-xl mb-4 bg-rose-50 text-rose-800 border border-rose-200 block";
                msgDiv.innerText = "❌ Terjadi kendala sambungan ke server.";
                btn.innerHTML = '<span>Masuk ke Portal</span> <span>➔</span>';
                btn.disabled = false;
            }
        });

        // Dynamic sync latest APK version from server API
        fetch('/api/app/version-check')
            .then(r => r.json())
            .then(d => {
                if (d && d.update && d.update.versionName) {
                    const lbl = document.getElementById('apkVersionLabel');
                    if (lbl) lbl.textContent = `Unduh APK Smart School v${d.update.versionName} (Build ${d.update.versionCode})`;
                    const lnk = document.getElementById('apkDownloadLink');
                    if (lnk && d.update.downloadUrl) lnk.href = d.update.downloadUrl;
                }
            })
            .catch(() => {});
    </script>
</body>
</html>
