            if (sel.options.length <= 1) {
                sel.innerHTML = '';
                PRAYER_ALL_CLASSES.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c;
                    opt.text = 'Kelas ' + c;
                    sel.appendChild(opt);
