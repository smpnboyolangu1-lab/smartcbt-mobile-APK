        async function loadBkPrayerMonitoring() {
            initBkPrayerClassSelect();
            try {
                // 1. Ambil Jadwal Sholat Hari Ini
                const resSched = await authFetch('/api/prayer/today-schedule');
                if (resSched.ok) {
                    const schedData = await resSched.json();
                    if (schedData.success && schedData.schedule) {
                        currentBkPrayerSchedule = schedData.schedule;
                        renderBkPrayerHeader(schedData);
                    }
                }
            } catch(e) {
                console.warn('Error load today prayer schedule:', e);
            }

            // 2. Ambil Seluruh Jadwal Sepekan (Senin - Jumat)
            await loadPrayerWeekSchedules();

            // 3. Muat Data Siswa Rombel yang Dipilih
            await loadBkPrayerStudentList();
        }

        function renderBkPrayerHeader(data) {
            const sched = data.schedule;
            const dayName = data.dayName || 'HARI INI';
            const dayLabel = document.getElementById('bkPrayerDayLabel');
            if (dayLabel) dayLabel.innerText = `Hari Ini: ${dayName}`;

            const badge = document.getElementById('bkPrayerTypeBadge');
            if (badge) {
                badge.innerText = sched.prayerType === 'JUMAT' ? '🕌 SHOLAT JUMAT & KEPUTRIAN' : '🕌 SHOLAT DHUHUR BERJAMAAH';
            }

            const title = document.getElementById('bkPrayerTitle');
            if (title) {
                title.innerText = `Presensi Sholat ${sched.prayerType === 'JUMAT' ? 'Jumat' : 'Dhuhur'} Berjamaah Terpadu`;
            }

            const notes = document.getElementById('bkPrayerNotes');
            if (notes) {
                notes.innerText = `💧 Mulai Wudhu: ${sched.wudhuTime || '11:45'} WIB • 📷 Scan Presensi: ${sched.scanStartTime || '12:00'} - ${sched.scanEndTime || '12:30'} WIB • Rombel Terjadwal: ${sched.classNames || 'Seluruh Siswa'} • Barcode: ${sched.barcodeKey || 'BARCODE_SHOLAT_DHUHUR_MASJID'}`;
            }

            // Auto-select first class from schedule if current selection not in schedule
            const classSel = document.getElementById('bkPrayerClassSelect');
            if (classSel && sched.classNames && sched.classNames !== 'ALL_MALE') {
                const first = sched.classNames.split(',')[0].trim();
                if (first && Array.from(classSel.options).some(o => o.value === first)) {
                    if (!classSel.value || classSel.value === 'VII-A') {
                        classSel.value = first;
                    }
                }
            }
        }

        async function loadPrayerWeekSchedules() {
            const grid = document.getElementById('bkPrayerWeekGrid');
            if (!grid) return;
            try {
                const res = await authFetch('/api/prayer/all-schedules');
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success || !Array.isArray(data.schedules)) return;

                currentBkAllSchedules = data.schedules;
                const dayNames = ['', 'SENIN', 'SELASA', 'RABU', 'KAMIS', 'JUMAT', 'SABTU'];
                const todayDay = new Date().getDay();

                let html = '';
                for (let d = 1; d <= 6; d++) {
                    const sched = currentBkAllSchedules.find(s => Number(s.dayOfWeek) === d) || {
                        dayOfWeek: d,
                        dayName: dayNames[d],
                        prayerType: d === 5 ? 'JUMAT' : 'DHUHUR',
                        classNames: d === 5 ? 'ALL_MALE' : (d === 6 ? 'ALL' : 'Belum diatur'),
                        wudhuTime: '11:45',
                        scanStartTime: '12:00',
                        scanEndTime: '12:30'
                    };

                    const isToday = (todayDay === d);
                    const isJumat = (d === 5 || sched.prayerType === 'JUMAT');
                    const borderClass = isToday ? 'border-2 border-teal-500 bg-teal-50/40 shadow-md ring-2 ring-teal-300' : 'border border-slate-200 bg-slate-50 hover:bg-white transition-all shadow-xs';
                    const badgeBg = isToday ? 'bg-teal-700 text-white' : (isJumat ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-slate-200 text-slate-800');

                    let classListDisplay = '';
                    if (sched.classNames === 'ALL_MALE') {
                        classListDisplay = '<span class="inline-block bg-amber-100 text-amber-900 border border-amber-300 text-[10px] font-black px-2 py-0.5 rounded-md">🕌 ALL_MALE (Putra Sholat Jumat)</span>';
                    } else if (sched.classNames) {
                        const splitClasses = sched.classNames.split(',').map(c => c.trim()).filter(Boolean);
                        if (splitClasses.length <= 4) {
                            classListDisplay = splitClasses.map(c => `<span class="inline-block bg-white text-slate-700 border border-slate-300 text-[10px] font-bold px-1.5 py-0.5 rounded">${c}</span>`).join(' ');
                        } else {
                            const firstFew = splitClasses.slice(0, 3).map(c => `<span class="inline-block bg-white text-slate-700 border border-slate-300 text-[10px] font-bold px-1.5 py-0.5 rounded">${c}</span>`).join(' ');
                            classListDisplay = `${firstFew} <span class="inline-block bg-teal-100 text-teal-800 text-[10px] font-bold px-1.5 py-0.5 rounded">+${splitClasses.length - 3} Kelas</span>`;
                        }
                    } else {
                        classListDisplay = '<span class="text-slate-400 text-[10px] italic">Belum ditentukan</span>';
                    }

                    html += `
                        <div class="rounded-2xl p-3.5 flex flex-col justify-between space-y-2.5 ${borderClass}">
                            <div class="flex items-center justify-between border-b pb-2">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs font-black text-slate-800">${sched.dayName || dayNames[d]}</span>
                                    ${isToday ? '<span class="px-1.5 py-0.2 rounded text-[9px] font-black bg-emerald-600 text-white animate-pulse">HARI INI</span>' : ''}
                                </div>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold ${badgeBg}">
                                    ${isJumat ? 'JUMAT' : 'DHUHUR'}
                                </span>
                            </div>

                            <div class="space-y-1">
                                <p class="text-[11px] text-slate-500 font-semibold">
                                    💧 Wudhu: <b class="text-slate-700 font-mono">${sched.wudhuTime || '11:45'}</b> • Scan: <b class="text-slate-700 font-mono">${sched.scanStartTime || '12:00'}</b>
                                </p>
                                <div class="pt-1">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Rombel Terjadwal:</p>
                                    <div class="flex flex-wrap gap-1 mt-1">
                                        ${classListDisplay}
                                    </div>
                                </div>
                            </div>

                            <div class="pt-1 border-t flex justify-end">
                                <button type="button" onclick="openPrayerScheduleModal(${d})" class="px-2.5 py-1 rounded-lg text-[10px] font-bold text-teal-800 hover:text-white hover:bg-teal-700 bg-teal-50 border border-teal-200 transition-all flex items-center gap-1 cursor-pointer">
                                    <span>✏️</span> Edit Jadwal
                                </button>
                            </div>
                        </div>
                    `;
                }
                grid.innerHTML = html;
            } catch(e) {
                console.error('Error loadPrayerWeekSchedules:', e);
            }
        }

        async function loadBkPrayerStudentList() {
            const classSelect = document.getElementById('bkPrayerClassSelect');
            const dateInput = document.getElementById('bkPrayerDate');
            const tbody = document.getElementById('bkPrayerTableBody');
            if (!classSelect || !tbody) return;

            const className = classSelect.value || 'VII-A';
            const date = dateInput ? dateInput.value : new Date().toISOString().split('T')[0];

            tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-slate-400">⏳ Memuat presensi sholat Kelas ${className} (${date})...</td></tr>`;

            try {
                const res = await authFetch(`/api/prayer/monitoring-by-class?className=${encodeURIComponent(className)}&date=${encodeURIComponent(date)}`);
                if (!res.ok) {
                    tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-red-500">Gagal memuat data presensi sholat (${res.status}).</td></tr>`;
                    return;
                }
                const data = await res.json();
                if (data.success && Array.isArray(data.students)) {
                    currentBkPrayerStudents = data.students;
                    const sum = data.summary || {};
                    const statTotal = document.getElementById('bkPrayerStatTotal');
                    const statPresent = document.getElementById('bkPrayerStatPresent');
                    const statHaid = document.getElementById('bkPrayerStatHaid');
                    const statPending = document.getElementById('bkPrayerStatPending');

                    if (statTotal) statTotal.innerText = sum.totalStudents || currentBkPrayerStudents.length;
                    if (statPresent) statPresent.innerText = sum.sholatCount || 0;
                    if (statHaid) statHaid.innerText = sum.haidCount || 0;
                    if (statPending) statPending.innerText = sum.pendingCount || 0;

                    filterBkPrayerTable();
                } else {
                    tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-slate-400">${data.message || 'Tidak ada data siswa untuk kelas ini.'}</td></tr>`;
                }
            } catch(e) {
                console.error('Error loadBkPrayerStudentList:', e);
                tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-rose-500">Terjadi kesalahan jaringan saat memuat siswa.</td></tr>`;
            }
        }

        function filterBkPrayerByStatus(pill) {
            activeBkPrayerFilterPill = pill;
            const pills = ['ALL', 'SHOLAT', 'HAID', 'BELUM'];
            pills.forEach(p => {
                const btn = document.getElementById('btnPrayerFilter' + (p === 'ALL' ? 'All' : (p === 'SHOLAT' ? 'Sholat' : (p === 'HAID' ? 'Haid' : 'Belum'))));
                if (btn) {
                    if (p === pill) {
                        btn.className = 'px-3 py-1.5 rounded-xl font-bold bg-teal-600 text-white shadow-sm transition-all text-xs';
                    } else {
                        btn.className = 'px-3 py-1.5 rounded-xl font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all text-xs';
                    }
                }
            });
            filterBkPrayerTable();
        }

        function filterBkPrayerTable() {
            const query = (document.getElementById('bkPrayerSearch')?.value || '').toLowerCase().trim();
            const tbody = document.getElementById('bkPrayerTableBody');
            if (!tbody) return;

            filteredBkPrayerStudents = currentBkPrayerStudents.filter(s => {
                const matchQuery = !query ||
                    (s.name || '').toLowerCase().includes(query) ||
                    (s.username || '').toLowerCase().includes(query) ||
                    (s.nisn || '').toLowerCase().includes(query);

                let matchStatus = true;
                const st = s.prayerStatus || 'PENDING';
                if (activeBkPrayerFilterPill === 'SHOLAT') matchStatus = (st === 'SHOLAT_BERJAMAAH');
                else if (activeBkPrayerFilterPill === 'HAID') matchStatus = (st === 'HAID');
                else if (activeBkPrayerFilterPill === 'BELUM') matchStatus = (!st || st === 'PENDING');

                return matchQuery && matchStatus;
            });

            if (filteredBkPrayerStudents.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-slate-400">Tidak ada data siswa yang cocok dengan filter.</td></tr>`;
                return;
            }

            let html = '';
            filteredBkPrayerStudents.forEach((s, idx) => {
                const st = s.prayerStatus || 'PENDING';
                let statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-50 text-rose-800 border border-rose-200">⏳ Belum Sholat</span>';
                if (st === 'SHOLAT_BERJAMAAH') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">🕌 Sudah Sholat</span>';
                } else if (st === 'HAID') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200">🌸 Berhalangan (Haid)</span>';
                }

                const gender = s.gender === 'P' || s.gender === 'FEMALE' ? 'P' : 'L';
                const timeStr = formatBkTimeWib(s.scanTime);
                const methodStr = s.method || (st === 'SHOLAT_BERJAMAAH' ? 'SCAN' : '-');

                let actionBtns = `
                    <button onclick="handleBkMarkStudentPrayer('${s.id}', 'SHOLAT_BERJAMAAH', 'Hadir Sholat Berjamaah')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-[10px] shadow transition-colors cursor-pointer" title="Tandai Sudah Sholat">
                        ✅ Sholat
                    </button>
                `;
                if (gender === 'P') {
                    actionBtns += `
                        <button onclick="handleBkMarkStudentPrayer('${s.id}', 'HAID', 'Berhalangan Haid')" class="px-2 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-bold text-[10px] shadow transition-colors cursor-pointer" title="Tandai Berhalangan Haid">
                            🌸 Haid
                        </button>
                    `;
                }

                html += `
                    <tr class="hover:bg-teal-50/40 border-b transition-colors">
                        <td class="p-3 text-center text-slate-400 font-mono">${idx + 1}</td>
                        <td class="p-3 font-mono font-bold text-slate-700">${s.nisn || s.username || '-'}</td>
                        <td class="p-3 font-bold text-slate-800">${s.name || '-'}</td>
                        <td class="p-3 text-center">
                            <span class="px-2 py-0.5 rounded font-black text-[10px] ${gender === 'L' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800'}">${gender}</span>
                        </td>
                        <td class="p-3 text-center text-slate-600 font-semibold">${s.religion || 'Islam'}</td>
                        <td class="p-3 text-center">${statusBadge}</td>
                        <td class="p-3 text-center font-mono text-[11px] text-slate-600">${timeStr} <span class="text-[9px] text-slate-400">(${methodStr})</span></td>
                        <td class="p-3 text-[11px] text-slate-600 truncate max-w-[150px]" title="${s.prayerNote || ''}">${s.prayerNote || '-'}</td>
                        <td class="p-3 text-center space-x-1 whitespace-nowrap">
                            ${actionBtns}
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        async function handleBkMarkStudentPrayer(studentId, status, note) {
            const classSelect = document.getElementById('bkPrayerClassSelect');
            const dateInput = document.getElementById('bkPrayerDate');
            const date = dateInput ? dateInput.value : new Date().toISOString().split('T')[0];

            try {
                const res = await authFetch('/api/prayer/pai-mark', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        studentId,
                        prayerType: currentBkPrayerSchedule?.prayerType || 'DHUHUR',
                        status,
                        note,
                        date
                    })
                });
                const data = await res.json();
                if (data.success) {
                    await loadBkPrayerStudentList();
                } else {
                    alert('Gagal menandai presensi: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch(e) {
                alert('Kesalahan jaringan: ' + e.message);
            }
        }

        // ==================== MODAL JADWAL ROMBEL SHOLAT ====================
        let selectedPrayerClassSet = new Set();

        function populateModalClassCheckboxes() {
            const grid = document.getElementById('modalPrayerClassGrid');
            if (!grid) return;
            grid.innerHTML = '';

            PRAYER_ALL_CLASSES.forEach(c => {
                const isChecked = selectedPrayerClassSet.has(c);
                const div = document.createElement('label');
                div.className = `flex items-center gap-1.5 p-1.5 rounded-lg border text-xs cursor-pointer select-none transition-colors ${isChecked ? 'bg-teal-50 border-teal-400 text-teal-900 font-bold' : 'bg-slate-50 border-slate-200 text-slate-700'}`;
                div.innerHTML = `
                    <input type="checkbox" value="${c}" ${isChecked ? 'checked' : ''} onchange="onPrayerClassCheckboxChange(this)" class="rounded text-teal-600 focus:ring-teal-500">
                    <span>${c}</span>
                `;
                grid.appendChild(div);
            });

            updateModalClassCountLabel();
        }

        function onPrayerClassCheckboxChange(chk) {
            if (chk.checked) {
                selectedPrayerClassSet.add(chk.value);
            } else {
                selectedPrayerClassSet.delete(chk.value);
            }
            syncSelectedPrayerClassesToInput();
            populateModalClassCheckboxes();
        }

        function quickSelectPrayerClasses(mode) {
            if (mode === 'CLEAR') {
                selectedPrayerClassSet.clear();
                document.getElementById('modalPaiClassNamesInput').value = '';
            } else if (mode === 'ALL_MALE') {
                selectedPrayerClassSet.clear();
                document.getElementById('modalPaiClassNamesInput').value = 'ALL_MALE';
                updateModalClassCountLabel();
                populateModalClassCheckboxes();
                return;
            } else if (mode === 'VII') {
                PRAYER_ALL_CLASSES.filter(c => c.startsWith('VII-')).forEach(c => selectedPrayerClassSet.add(c));
            } else if (mode === 'VIII') {
                PRAYER_ALL_CLASSES.filter(c => c.startsWith('VIII-')).forEach(c => selectedPrayerClassSet.add(c));
            } else if (mode === 'IX') {
                PRAYER_ALL_CLASSES.filter(c => c.startsWith('IX-')).forEach(c => selectedPrayerClassSet.add(c));
            }
            syncSelectedPrayerClassesToInput();
            populateModalClassCheckboxes();
        }

        function syncSelectedPrayerClassesToInput() {
            const arr = Array.from(selectedPrayerClassSet).sort();
            document.getElementById('modalPaiClassNamesInput').value = arr.join(',');
            updateModalClassCountLabel();
        }

        function updateModalClassCountLabel() {
            const val = document.getElementById('modalPaiClassNamesInput')?.value || '';
            const lbl = document.getElementById('modalSelectedClassCount');
            if (!lbl) return;
            if (val === 'ALL_MALE') {
                lbl.innerText = '🕌 Seluruh Siswa Putra (ALL_MALE)';
                lbl.className = 'text-[11px] font-bold text-amber-700';
            } else {
                lbl.innerText = `${selectedPrayerClassSet.size} Kelas Dipilih`;
                lbl.className = 'text-[11px] font-bold text-teal-700';
            }
        }

        function openPrayerScheduleModal(dayOfWeek) {
            const modal = document.getElementById('modalPrayerSchedule');
            if (!modal) return;

            const targetDay = dayOfWeek !== undefined ? Number(dayOfWeek) : (new Date().getDay() || 1);
            const cleanDay = (targetDay >= 1 && targetDay <= 6) ? targetDay : 1;

            const daySelect = document.getElementById('modalPaiDayOfWeek');
            if (daySelect) daySelect.value = String(cleanDay);

            loadScheduleDataIntoModal(cleanDay);
            modal.classList.remove('hidden');
        }

        function onModalPrayerDayChange() {
            const day = Number(document.getElementById('modalPaiDayOfWeek').value);
            loadScheduleDataIntoModal(day);
        }

        function onModalPrayerTypeChange() {
            const type = document.getElementById('modalPaiPrayerType').value;
            const barcodeSelect = document.getElementById('modalPaiBarcodeKey');
            if (barcodeSelect) {
                barcodeSelect.value = type === 'JUMAT' ? 'BARCODE_SHOLAT_JUMAT_MASJID' : 'BARCODE_SHOLAT_DHUHUR_MASJID';
            }
        }

        function loadScheduleDataIntoModal(dayOfWeek) {
            const sched = currentBkAllSchedules.find(s => Number(s.dayOfWeek) === dayOfWeek);
            const pType = document.getElementById('modalPaiPrayerType');
            const wudhu = document.getElementById('modalPaiWudhuTime');
            const start = document.getElementById('modalPaiScanStartTime');
            const end = document.getElementById('modalPaiScanEndTime');
            const bKey = document.getElementById('modalPaiBarcodeKey');
            const notes = document.getElementById('modalPaiNotes');
            const inputClasses = document.getElementById('modalPaiClassNamesInput');

            selectedPrayerClassSet.clear();

            if (sched) {
                if (pType) pType.value = sched.prayerType || (dayOfWeek === 5 ? 'JUMAT' : 'DHUHUR');
                if (wudhu) wudhu.value = sched.wudhuTime || '11:45';
                if (start) start.value = sched.scanStartTime || '12:00';
                if (end) end.value = sched.scanEndTime || '12:30';
                if (bKey) bKey.value = sched.barcodeKey || (sched.prayerType === 'JUMAT' ? 'BARCODE_SHOLAT_JUMAT_MASJID' : 'BARCODE_SHOLAT_DHUHUR_MASJID');
                if (notes) notes.value = sched.notes || '';
                if (inputClasses) inputClasses.value = sched.classNames || '';

                if (sched.classNames && sched.classNames !== 'ALL_MALE') {
                    sched.classNames.split(',').map(c => c.trim()).filter(Boolean).forEach(c => selectedPrayerClassSet.add(c));
                }
            } else {
                if (pType) pType.value = dayOfWeek === 5 ? 'JUMAT' : 'DHUHUR';
                if (wudhu) wudhu.value = '11:45';
                if (start) start.value = '12:00';
                if (end) end.value = '12:30';
                if (bKey) bKey.value = dayOfWeek === 5 ? 'BARCODE_SHOLAT_JUMAT_MASJID' : 'BARCODE_SHOLAT_DHUHUR_MASJID';
                if (notes) notes.value = `Jadwal Sholat ${dayOfWeek === 5 ? 'Jumat' : 'Dhuhur'} di Masjid Sekolah`;
                
                if (dayOfWeek === 5) {
                    if (inputClasses) inputClasses.value = 'ALL_MALE';
                } else if (dayOfWeek === 6) {
                    if (inputClasses) inputClasses.value = 'ALL';
                } else {
                    if (inputClasses) inputClasses.value = 'VII-A,VII-B,VII-C,VII-D,VII-E';
                    ['VII-A', 'VII-B', 'VII-C', 'VII-D', 'VII-E'].forEach(c => selectedPrayerClassSet.add(c));
                }
            }

            populateModalClassCheckboxes();
        }

        function closePrayerScheduleModal() {
            const modal = document.getElementById('modalPrayerSchedule');
            if (modal) modal.classList.add('hidden');
        }

        async function handleSavePrayerScheduleModal(e) {
            e.preventDefault();
            const dayOfWeek = Number(document.getElementById('modalPaiDayOfWeek').value);
            const dayNames = ['', 'SENIN', 'SELASA', 'RABU', 'KAMIS', 'JUMAT', 'SABTU'];
            const prayerType = document.getElementById('modalPaiPrayerType').value;
            const wudhuTime = document.getElementById('modalPaiWudhuTime').value;
            const scanStartTime = document.getElementById('modalPaiScanStartTime').value;
            const scanEndTime = document.getElementById('modalPaiScanEndTime').value;
            const barcodeKey = document.getElementById('modalPaiBarcodeKey').value;
            const classNames = document.getElementById('modalPaiClassNamesInput').value.trim();
            const notes = document.getElementById('modalPaiNotes').value.trim();

            if (!classNames) {
                alert('Tentukan rombel kelas yang akan dijadwalkan (atau pilih ALL_MALE).');
                return;
            }

            const payload = {
                dayOfWeek,
                dayName: dayNames[dayOfWeek] || 'HARI',
                prayerType,
                wudhuTime,
                scanStartTime,
                scanEndTime,
                barcodeKey,
                classNames,
                notes
            };

            try {
                const res = await authFetch('/api/prayer/set-schedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ Jadwal rombel sholat berhasil disimpan dan disinkronkan ke seluruh sistem & APK Siswa!');
                    closePrayerScheduleModal();
                    await loadBkPrayerMonitoring();
                } else {
                    alert('Gagal menyimpan jadwal: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch(err) {
                alert('Kesalahan jaringan: ' + err.message);
            }
        }

        // ==================== UNDUH REKAP SHOLAT PDF ====================
        function openDownloadPrayerPdfModal() {
            const modal = document.getElementById('modalDownloadPrayerPdf');
            if (!modal) return;
            initBkPrayerClassSelect();
            modal.classList.remove('hidden');
        }

        function triggerDownloadPrayerPdf() {
            const date = document.getElementById('pdfPrayerDate')?.value || new Date().toISOString().split('T')[0];
            const className = document.getElementById('pdfPrayerClass')?.value || 'ALL';
