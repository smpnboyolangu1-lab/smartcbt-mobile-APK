        // ==================== MONITORING PRESENSI SHOLAT (PAI & BK) ====================
        let currentBkPrayerStudents = [];
        let currentBkPrayerStatusFilter = 'ALL';

        async function loadBkPrayerMonitoring() {
            const dateInput = document.getElementById('bkPrayerDate');
            if (dateInput && !dateInput.value) {
                dateInput.value = new Date().toISOString().substring(0, 10);
            }
            const targetDate = dateInput ? dateInput.value : new Date().toISOString().substring(0, 10);

            const classSelect = document.getElementById('bkPrayerClassSelect');
            let className = classSelect ? classSelect.value : '';

            // 1. Ambil Jadwal Rombel Hari Ini jika belum ada info
            try {
                const resSched = await authFetch('/api/prayer/today-schedule');
                if (resSched.ok) {
                    const schedData = await resSched.json();
                    const sched = schedData.schedule;
                    if (sched) {
                        const typeBadge = document.getElementById('bkPrayerTypeBadge');
                        if (typeBadge) {
                            typeBadge.innerText = sched.prayerType === 'JUMAT' 
                                ? '🕌 SHOLAT JUMAT BERJAMAAH' 
                                : '🕌 SHOLAT DHUHUR BERJAMAAH';
                        }
                        const dayLabel = document.getElementById('bkPrayerDayLabel');
                        if (dayLabel) {
                            dayLabel.innerText = `Hari: ${schedData.dayName || 'HARI INI'}`;
                        }
                        const titleEl = document.getElementById('bkPrayerTitle');
                        if (titleEl) {
                            titleEl.innerText = `Monitoring Presensi Sholat ${sched.prayerType === 'JUMAT' ? 'Jumat' : 'Dhuhur'} Siswa`;
                        }
                        const notesEl = document.getElementById('bkPrayerNotes');
                        if (notesEl && sched.notes) {
                            notesEl.innerText = `${sched.notes} • Jadwal Rombel: ${sched.classNames || 'Semua Rombel'}`;
                        }
                        if (!className && sched.classNames) {
                            const firstClass = sched.classNames.split(',')[0].trim();
                            if (firstClass && classSelect) {
                                classSelect.value = firstClass;
                                className = firstClass;
                            }
                        }
                    }
                }
            } catch (err) {
                console.warn('Error load prayer schedule:', err);
            }

            if (!className && classSelect && classSelect.options.length > 0) {
                className = classSelect.options[0].value;
                classSelect.value = className;
            }

            if (!className) return;

            const tbody = document.getElementById('bkPrayerTableBody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="9" class="p-8 text-center text-slate-400">Memuat data presensi sholat kelas ' + className + '...</td></tr>';
            }

            try {
                const res = await authFetch(`/api/prayer/monitoring-by-class?className=${encodeURIComponent(className)}&date=${targetDate}`);
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-rose-500 font-bold">Gagal memuat: ${err.message || res.statusText}</td></tr>`;
                    return;
                }

                const data = await res.json();
                currentBkPrayerStudents = data.students || [];

                const sum = data.summary || {};
                document.getElementById('bkPrayerStatTotal').innerText = sum.totalStudents || currentBkPrayerStudents.length;
                document.getElementById('bkPrayerStatPresent').innerText = sum.sholatCount || 0;
                document.getElementById('bkPrayerStatHaid').innerText = sum.haidCount || 0;
                document.getElementById('bkPrayerStatPending').innerText = sum.belumCount || 0;

                renderBkPrayerTable(currentBkPrayerStudents);
            } catch (err) {
                console.error('Error loadBkPrayerMonitoring:', err);
                if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="p-8 text-center text-rose-500 font-bold">Terjadi kesalahan koneksi saat memuat data presensi sholat.</td></tr>`;
            }
        }

        function renderBkPrayerTable(students) {
            const tbody = document.getElementById('bkPrayerTableBody');
            if (!tbody) return;

            const searchQ = (document.getElementById('bkPrayerSearch')?.value || '').toLowerCase().trim();

            const filtered = students.filter(s => {
                const st = (s.prayerStatus || 'BELUM_PRESENSI').toUpperCase();
                let matchStatus = true;
                if (currentBkPrayerStatusFilter === 'SHOLAT') matchStatus = (st === 'SHOLAT_BERJAMAAH');
                else if (currentBkPrayerStatusFilter === 'HAID') matchStatus = (st === 'BERHALANGAN_HAID');
                else if (currentBkPrayerStatusFilter === 'BELUM') matchStatus = (st === 'BELUM_PRESENSI');

                const nameMatch = !searchQ || (s.name || '').toLowerCase().includes(searchQ) || (s.nisn || '').toLowerCase().includes(searchQ);
                return matchStatus && nameMatch;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="p-8 text-center text-slate-400">Tidak ada siswa yang sesuai filter presensi sholat.</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map((s, idx) => {
                const st = (s.prayerStatus || 'BELUM_PRESENSI').toUpperCase();
                let statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-slate-100 text-slate-600 border border-slate-200">⚪ Belum Presensi</span>';
                if (st === 'SHOLAT_BERJAMAAH') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300">✅ Sudah Sholat</span>';
                } else if (st === 'BERHALANGAN_HAID') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-purple-100 text-purple-800 border border-purple-300">🌸 Berhalangan (Haid)</span>';
                } else if (st === 'UZUR_SAKIT') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-blue-100 text-blue-800 border border-blue-300">🏥 Uzur Sakit</span>';
                } else if (st === 'NON_MUSLIM') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-800 border border-amber-300">✝️ Non Muslim</span>';
                }

                const genderBadge = s.isFemale 
                    ? '<span class="text-purple-600 font-bold">P</span>' 
                    : '<span class="text-blue-600 font-bold">L</span>';

                const timeMethod = s.recordedAt 
                    ? `<div class="font-mono text-[10px] text-slate-700">${formatBkTimeWib(s.recordedAt)}</div><div class="text-[9px] text-slate-400 font-bold uppercase">${s.method || 'Scan'}</div>`
                    : '<span class="text-slate-400">-</span>';

                const haidBtn = s.isFemale ? `
                    <button onclick="bkMarkStudentPrayer('${s.id}', 'BERHALANGAN_HAID')" title="Tandai siswi berhalangan haid / keputrian" class="p-1.5 rounded-lg text-purple-700 hover:bg-purple-100 font-bold transition-all text-xs">
                        🌸
                    </button>
                ` : '';

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-3.5 text-center text-slate-400 font-mono">${idx + 1}</td>
                        <td class="p-3.5 font-mono text-slate-600 font-bold">${s.nisn || '-'}</td>
                        <td class="p-3.5 font-bold text-slate-800">${s.name}</td>
                        <td class="p-3.5 text-center">${genderBadge}</td>
                        <td class="p-3.5 text-center text-slate-600">${s.religion || 'Islam'}</td>
                        <td class="p-3.5 text-center">${statusBadge}</td>
                        <td class="p-3.5 text-center">${timeMethod}</td>
                        <td class="p-3.5 text-slate-500 text-[11px]">${s.notes || '-'}</td>
                        <td class="p-3.5 text-center">
                            <div class="flex items-center justify-center gap-1">
                                <button onclick="bkMarkStudentPrayer('${s.id}', 'SHOLAT_BERJAMAAH')" title="Tandai sudah sholat" class="p-1.5 rounded-lg text-emerald-700 hover:bg-emerald-100 font-bold transition-all text-xs">
                                    ✅
                                </button>
                                ${haidBtn}
                                <button onclick="bkMarkStudentPrayer('${s.id}', 'BELUM_PRESENSI')" title="Reset / Belum presensi" class="p-1.5 rounded-lg text-rose-700 hover:bg-rose-100 font-bold transition-all text-xs">
                                    ❌
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

