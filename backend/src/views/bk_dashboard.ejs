        function renderTopViolators(topStudents) {
            const container = document.getElementById('topViolatorsContainer');
            container.innerHTML = '';

            if(!topStudents || topStudents.length === 0) {
                container.innerHTML = '<div class="col-span-full p-4 text-center text-gray-400">Tidak ada catatan pelanggaran siswa</div>';
                return;
            }

            topStudents.slice(0, 8).forEach(s => {
                let badgeSP = '<span class="bg-yellow-100 text-yellow-800 text-[10px] font-black px-2 py-0.5 rounded">Peringatan</span>';
                if(s.points >= 50) badgeSP = '<span class="bg-orange-100 text-orange-800 text-[10px] font-black px-2 py-0.5 rounded">SP 1</span>';
                if(s.points >= 75) badgeSP = '<span class="bg-red-100 text-red-800 text-[10px] font-black px-2 py-0.5 rounded">SP 2</span>';
                if(s.points >= 100) badgeSP = '<span class="bg-red-600 text-white text-[10px] font-black px-2 py-0.5 rounded animate-pulse">SP 3 / Skorsing</span>';

                let cancelSpBtn = '';
                if (s.points >= 30) {
                    cancelSpBtn = `
                        <div class="mt-2.5 pt-2 border-t border-red-200/60 flex justify-end">
                            <button onclick="cancelStudentSPPrompt('${s.id}', '${(s.name || '').replace(/'/g, "\\'")}')" class="text-[11px] font-bold px-2.5 py-1 bg-red-100 hover:bg-red-200 text-red-700 hover:text-red-800 rounded-lg flex items-center gap-1 border border-red-300 shadow-sm transition cursor-pointer" title="Batalkan dan hapus seluruh SP siswa ini">
                                <span>🗑️</span> Batalkan / Hapus SP
                            </button>
                        </div>
                    `;
                }

                container.innerHTML += `
                    <div class="border border-red-200 bg-red-50/40 p-3.5 rounded-2xl flex flex-col justify-between shadow-sm">
                        <div class="flex items-center justify-between">
                            <div class="overflow-hidden pr-2">
                                <p class="font-bold text-gray-900 text-xs truncate">${s.name}</p>
                                <p class="text-[11px] text-gray-500 font-semibold">${s.className || '-'} | Telp: ${s.parentPhone || '-'}</p>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <span class="text-base font-black text-red-600">${s.points} Poin</span>
                                <div class="mt-0.5">${badgeSP}</div>
                            </div>
                        </div>
                        ${cancelSpBtn}
                    </div>
                `;
            });
        }

        function renderDisciplineTable(records) {
            const tbody = document.getElementById('disciplineTableBody');
            tbody.innerHTML = '';

            if(!records || records.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-gray-400">Belum ada riwayat poin siswa</td></tr>';
                return;
            }

            records.forEach((r, idx) => {
                const s = r.user || {};
                const dateStr = new Date(r.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
                
                let typeBadge = '<span class="bg-red-100 text-red-800 font-bold px-2 py-0.5 rounded">🔴 Pelanggaran</span>';
                let pointClass = 'text-red-600 font-bold font-mono';
                let catBadge = '';
                if(r.category) {
                    let catColor = 'bg-slate-100 text-slate-700';
                    if(r.category === 'RINGAN') catColor = 'bg-blue-100 text-blue-800';
                    if(r.category === 'SEDANG') catColor = 'bg-amber-100 text-amber-800';
                    if(r.category === 'BERAT') catColor = 'bg-orange-100 text-orange-900';
                    if(r.category === 'SANGAT_BERAT') catColor = 'bg-red-200 text-red-900';
                    catBadge = `<span class="${catColor} text-[10px] font-bold px-1.5 py-0.5 rounded uppercase mt-0.5 inline-block">${r.category}</span>`;
                }

                if(r.type === 'PRESTASI') {
                    typeBadge = '<span class="bg-green-100 text-green-800 font-bold px-2 py-0.5 rounded">🟢 Prestasi</span>';
                    pointClass = 'text-green-600 font-bold font-mono';
                    catBadge = '<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-1.5 py-0.5 rounded uppercase mt-0.5 inline-block">Piagam</span>';
                }

                let spBadge = '-';
                if(r.sanctionLevel) {
                    let spColor = 'bg-slate-100 text-slate-700';
                    if(r.sanctionLevel === 'SP_1') spColor = 'bg-amber-100 text-amber-900 font-bold';
                    if(r.sanctionLevel === 'SP_2') spColor = 'bg-orange-100 text-orange-900 font-bold';
                    if(r.sanctionLevel === 'SP_3') spColor = 'bg-red-600 text-white font-bold animate-pulse';
                    if(r.sanctionLevel === 'DIPROSES_BK') spColor = 'bg-blue-100 text-blue-900 font-bold';
                    if(r.sanctionLevel === 'RESOLVED') spColor = 'bg-emerald-100 text-emerald-900 font-bold';
                    spBadge = `<span class="${spColor} text-[10px] px-2 py-0.5 rounded">${r.sanctionLevel.replace('_', ' ')}</span>`;
                }

                const sanctionDisplay = r.sanction ? `<p class="text-rose-700 text-[11px] font-semibold mt-0.5">Sanksi: ${r.sanction}</p>` : '';
                const chronologyDisplay = r.chronology ? `<p class="text-gray-500 text-[11px] italic line-clamp-1 mt-0.5">${r.chronology}</p>` : '';

                const bapBtn = r.type === 'PELANGGARAN' 
                    ? `<button onclick="openBapModal(${idx})" class="bg-indigo-700 hover:bg-indigo-800 text-white px-2.5 py-1 rounded-lg text-xs font-bold shadow flex items-center gap-1 cursor-pointer"><span>📄</span> BAP</button>`
                    : '';

                const delRecordBtn = `<button onclick="deleteDisciplineRecordBK('${r.id}', '${(r.description || '').replace(/'/g, "\\'")}')" class="bg-red-50 hover:bg-red-100 text-red-600 hover:text-red-700 border border-red-200 px-2 py-1 rounded-lg text-xs font-bold transition flex items-center gap-1 cursor-pointer" title="Hapus catatan pelanggaran & batalkan SP"><span>🗑️</span> Hapus</button>`;

                tbody.innerHTML += `
                    <tr class="hover:bg-teal-50/50 border-b">
                        <td class="p-3 font-mono text-gray-500 whitespace-nowrap">${dateStr}</td>
                        <td class="p-3">
                            <p class="font-bold text-gray-800">${s.name || '-'}</p>
                            <span class="bg-slate-100 text-slate-700 font-bold px-1.5 py-0.5 rounded text-[10px]">${s.className || '-'}</span>
                        </td>
                        <td class="p-3">
                            <div>${typeBadge}</div>
                            ${catBadge}
                        </td>
                        <td class="p-3 ${pointClass} whitespace-nowrap">${r.points > 0 ? '+' : ''}${r.points}</td>
                        <td class="p-3 text-gray-700">
                            <p class="font-semibold text-gray-900">${r.description || '-'}</p>
                            ${chronologyDisplay}
                        </td>
                        <td class="p-3">
                            <div>${spBadge}</div>
                            ${sanctionDisplay}
                        </td>
                        <td class="p-3 text-center whitespace-nowrap">
                            <div class="flex items-center justify-center gap-1.5">
                                ${bapBtn}
                                ${delRecordBtn}
                            </div>
                        </td>
                    </tr>
                `;
            });
        }

