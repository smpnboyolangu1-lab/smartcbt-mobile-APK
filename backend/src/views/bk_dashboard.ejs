                    <div>
                        <h3 class="font-black text-base tracking-wide text-white">DYNAMIC ROTATING QR RUANG BK</h3>
                        <p class="text-xs text-emerald-200 font-medium">Token Anti-Fraud Berotasi Otomatis (HMAC SHA-256)</p>
                    </div>
                </div>
                <button onclick="closeBkDynamicQrModal()" class="text-white/80 hover:text-white p-2 rounded-xl hover:bg-white/10 transition text-lg font-bold">✕</button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 text-center">
                <div class="inline-block relative p-4 bg-white rounded-2xl shadow-inner border-2 border-emerald-500/30">
                    <div id="canvasBkDynamicQr" class="w-64 h-64 mx-auto rounded-xl shadow flex items-center justify-center hidden"></div>
                    <img id="imgBkDynamicQr" src="" alt="Dynamic Rotating QR" class="w-64 h-64 mx-auto rounded-xl shadow" onerror="this.src='https://quickchart.io/qr?size=300&text=' + encodeURIComponent('SMARTCBT-BK-DYN-FALLBACK');">
                    <div id="qrLoadingOverlay" class="absolute inset-0 bg-white/90 rounded-2xl flex flex-col items-center justify-center hidden">
                        <span class="text-2xl animate-spin">⟳</span>
                        <p class="text-xs text-slate-500 font-bold mt-2">Memperbarui Token...</p>
                    </div>
                </div>

                <!-- Timer Bar & Text -->
                <div class="mt-4 max-w-xs mx-auto">
                    <div class="flex items-center justify-between text-xs font-bold mb-1">
                        <span class="text-slate-500">Berotasi Otomatis Setiap 45s:</span>
                        <span id="txtBkQrCountdown" class="text-emerald-700">45 detik</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden border border-slate-200">
                        <div id="barBkQrCountdown" class="bg-emerald-600 h-2.5 rounded-full transition-all duration-1000" style="width: 100%"></div>
                    </div>
                </div>

                <!-- Token Hash Info -->
                <div class="mt-3 bg-slate-50 rounded-xl p-3 border border-slate-200 text-left max-w-sm mx-auto">
                    <div class="flex items-center justify-between text-[11px] font-semibold text-slate-600">
                        <span>Ruang Konseling:</span>
                        <span class="text-slate-900 font-bold">Ruang BK Utama</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] font-semibold text-slate-600 mt-1">
                        <span>Token Hash:</span>
                        <code id="txtBkTokenHash" class="text-emerald-700 font-mono text-[10px] bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">-</code>
                    </div>
                </div>

                <!-- Instruction -->
                <p class="text-xs text-slate-500 mt-4 leading-relaxed font-medium">
                    Arahkan siswa untuk berdiri di depan meja Anda, buka kamera scanner di APK Siswa, dan arahkan ke layar ini. Status siswa akan otomatis berubah menjadi <b class="text-emerald-700">Disetujui Sah</b>.
                </p>
            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                <button onclick="fetchAndRenderBkDynamicQr(true)" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition">
                    <span>⟳</span> Rotasi Manual Sekarang
                </button>
                <button onclick="closeBkDynamicQrModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2 rounded-xl text-xs font-bold transition shadow">
                    Tutup Layar QR
                </button>
            </div>
        </div>
    </div>
</body>
</html>
