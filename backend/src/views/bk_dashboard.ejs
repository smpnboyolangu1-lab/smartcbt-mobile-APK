        async function bkMarkStudentPrayer(studentId, status) {
            const dateInput = document.getElementById('bkPrayerDate');
            const targetDate = dateInput ? dateInput.value : new Date().toISOString().substring(0, 10);
            const prayerType = new Date().getDay() === 5 ? 'JUMAT' : 'DHUHUR';

            try {
                const res = await authFetch('/api/prayer/pai-mark', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        studentId,
                        prayerType,
                        status,
                        notes: status === 'BERHALANGAN_HAID' ? 'Izin berhalangan haid (Diverifikasi Guru BK)' : 'Diverifikasi Guru BK'
                    })
                });
                const data = await res.json();
                if (data.success) {
                    const student = currentBkPrayerStudents.find(s => s.id === studentId);
                    if (student) {
                        student.prayerStatus = status;
                        student.notes = data.record?.notes || null;
                        student.recordedAt = new Date().toISOString();
                        student.method = 'MANUAL_BK';
                    }
                    const sholatCount = currentBkPrayerStudents.filter(e => e.prayerStatus === 'SHOLAT_BERJAMAAH').length;
                    const haidCount = currentBkPrayerStudents.filter(e => e.prayerStatus === 'BERHALANGAN_HAID').length;
                    const belumCount = currentBkPrayerStudents.filter(e => !e.prayerStatus || e.prayerStatus === 'BELUM_PRESENSI').length;
                    document.getElementById('bkPrayerStatPresent').innerText = sholatCount;
                    document.getElementById('bkPrayerStatHaid').innerText = haidCount;
                    document.getElementById('bkPrayerStatPending').innerText = belumCount;

                    renderBkPrayerTable(currentBkPrayerStudents);
                } else {
                    alert('Gagal memperbarui status: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                console.error('Error bkMarkStudentPrayer:', err);
                alert('Gagal menghubungkan ke server');
            }
        }
        function openDownloadPrayerPdfModal() {
            const modal = document.getElementById('modalDownloadPrayerPdf');
            if (!modal) return;

            const modalClassSel = document.getElementById('modalPdfClassSelect');
            const bkClassSel = document.getElementById('bkPrayerClassSelect');
            if (modalClassSel) {
                modalClassSel.innerHTML = '<option value="ALL">📋 Seluruh Kelas (Rekap Lengkap)</option>';
                if (bkClassSel && bkClassSel.options.length > 0) {
                    for (let i = 0; i < bkClassSel.options.length; i++) {
                        const opt = bkClassSel.options[i];
                        if (opt.value && opt.value !== 'ALL') {
                            modalClassSel.innerHTML += `<option value="${opt.value}">Kelas ${opt.value}</option>`;
                        }
                    }
                    if (bkClassSel.value && bkClassSel.value !== 'ALL') {
                        modalClassSel.value = bkClassSel.value;
                    }
                }
            }

            const dtInput = document.getElementById('modalPdfDateInput');
            const bkDt = document.getElementById('bkPrayerDate');
            if (dtInput) {
                dtInput.value = (bkDt && bkDt.value) ? bkDt.value : new Date().toISOString().substring(0, 10);
            }

            const typeSel = document.getElementById('modalPdfPrayerType');
            if (typeSel) {
                const day = new Date().getDay();
                typeSel.value = (day === 5) ? 'JUMAT' : 'DHUHUR';
            }

            modal.classList.remove('hidden');
        }

        function closeDownloadPrayerPdfModal() {
            document.getElementById('modalDownloadPrayerPdf')?.classList.add('hidden');
        }

        function executePrayerPdfAction(action) {
            const cls = document.getElementById('modalPdfClassSelect')?.value || 'ALL';
            const dt = document.getElementById('modalPdfDateInput')?.value || new Date().toISOString().substring(0, 10);
            const pt = document.getElementById('modalPdfPrayerType')?.value || 'DHUHUR';

            let url = `/api/prayer/export-pdf?className=${encodeURIComponent(cls)}&date=${encodeURIComponent(dt)}&prayerType=${encodeURIComponent(pt)}`;
            if (action === 'print') {
                url += '&autoprint=1';
                window.open(url, '_blank');
            } else {
                url += '&download=1';
                const a = document.createElement('a');
                a.href = url;
                a.download = `Rekap_Sholat_${cls}_${dt}.html`;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => a.remove(), 1000);
            }
            closeDownloadPrayerPdfModal();
        }

