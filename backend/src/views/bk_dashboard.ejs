        function openWarningLetterModal(letterIdx) {
            const l = allWarningLetters[letterIdx];
            if (!l) return;
            const s = l.user || {};
            const dateObj = new Date(l.issuedAt || Date.now());
            const options = { day: 'numeric', month: 'long', year: 'numeric' };
            const dayDateStr = dateObj.toLocaleDateString('id-ID', options);

            const spDisplay = (l.spLevel || 'SP1').toUpperCase();
            let spText = 'I (Pertama)';
            if (spDisplay.includes('2')) spText = 'II (Kedua)';
            if (spDisplay.includes('3')) spText = 'III (Ketiga / Terakhir)';

            document.getElementById('spLetterNo').innerText = l.letterNo || '-';
            document.getElementById('spLetterDate').innerText = 'Boyolangu, ' + dayDateStr;
            document.getElementById('spSubjectHeader').innerText = `SURAT PERINGATAN (${spDisplay}) & PANGGILAN ORANG TUA`;
            document.getElementById('spStudentNameHeader').innerText = `${s.name || '-'} (${s.className || '-'})`;
            document.getElementById('spTitleBold').innerText = `SURAT PERINGATAN ${spDisplay} (${spText})`;

            document.getElementById('spDocStudentName').innerText = s.name || '-';
            document.getElementById('spDocStudentNisn').innerText = s.nisn || s.username || '-';
            document.getElementById('spDocStudentClass').innerText = s.className || '-';
            document.getElementById('spDocLevelBadge').innerText = spDisplay;
            document.getElementById('spDocTotalPoints').innerText = (l.totalPoints || s.points || 0) + ' Poin';

            const counselorName = document.getElementById('profileName')?.innerText || 'Guru BK';
            document.getElementById('spSignCounselorName').innerText = '(' + counselorName + ')';
            document.getElementById('spSignCounselorNip').innerText = 'NIP. -';

            // Muat data dinamis Kepala Sekolah & Koordinator BK dari Pengaturan Sistem (/api/school-info)
            fetch('/api/school-info')
                .then(res => res.json())
                .then(data => {
                    if (data.headmasterName) {
                        document.getElementById('spSignHeadmasterName').innerText = '(' + data.headmasterName + ')';
                    }
                    if (data.headmasterNip) {
                        document.getElementById('spSignHeadmasterNip').innerText = 'NIP. ' + data.headmasterNip;
                    }
                    if (data.schoolName) {
                        document.getElementById('spSignHeadmasterTitle').innerText = 'Kepala ' + data.schoolName + ',';
                        document.getElementById('spDocSchoolName').innerText = data.schoolName.toUpperCase();
                        document.getElementById('spSchoolNameBody').innerText = data.schoolName;
                    }
                    if (data.schoolAddress) {
                        document.getElementById('spDocSchoolAddress').innerText = data.schoolAddress;
                    }
                    if (data.bkCoordinatorName && (counselorName === 'Guru BK' || counselorName.includes('SMPN 1'))) {
                        document.getElementById('spSignCounselorName').innerText = '(' + data.bkCoordinatorName + ')';
                    }
                    if (data.bkCoordinatorNip) {
                        document.getElementById('spSignCounselorNip').innerText = 'NIP. ' + data.bkCoordinatorNip;
                    }
                })
                .catch(e => console.warn('Gagal memuat info sekolah untuk SP:', e));

            document.getElementById('modalWarningLetter').classList.remove('hidden');
        }

