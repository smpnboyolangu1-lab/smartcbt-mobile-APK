        function filterWarningLettersTable() {
            const query = (document.getElementById('searchWarningLetter')?.value || '').toLowerCase().trim();
            const spLevel = document.getElementById('filterSpLevel')?.value || 'ALL';

            let filtered = allWarningLetters;

            if (spLevel !== 'ALL') {
                filtered = filtered.filter(l => l.spLevel === spLevel || l.spLevel === spLevel.replace('SP', 'SP_'));
            }

            if (query) {
                filtered = filtered.filter(l => {
                    const name = (l.user?.name || '').toLowerCase();
                    const cls = (l.user?.className || '').toLowerCase();
                    const no = (l.letterNo || '').toLowerCase();
                    return name.includes(query) || cls.includes(query) || no.includes(query);
                });
            }

            renderWarningLettersTable(filtered);
        }

        async function deleteWarningLetterBK(letterId, letterNo, studentName) {
            if (!confirm(`⚠️ Konfirmasi Hapus SP:\n\nApakah Anda yakin ingin MENGHAPUS Surat Peringatan (${letterNo}) untuk siswa "${studentName}"?\n\nStatus sanksi pada catatan kedisiplinan siswa akan dinormalkan kembali (RESOLVED).`)) {
                return;
            }

            try {
                const res = await fetch(`/api/bk/warning-letters/${letterId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message || '✅ Surat Peringatan berhasil dihapus!');
                    loadWarningLettersBK();
                    loadDisciplineRecordsBK();
                } else {
                    alert('❌ Gagal menghapus Surat Peringatan: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                console.error('Error deleteWarningLetterBK:', err);
                alert('❌ Terjadi kesalahan jaringan saat menghapus Surat Peringatan');
            }
        }

