            if (pdfSel && pdfSel.options.length <= 1) {
                pdfSel.innerHTML = '<option value="ALL">Semua Kelas Terdaftar</option>';
                PRAYER_ALL_CLASSES.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c;
                    opt.text = 'Kelas ' + c;
                    pdfSel.appendChild(opt);
                });
            }

            const dateInput = document.getElementById('bkPrayerDate');
            if (dateInput && !dateInput.value) {
