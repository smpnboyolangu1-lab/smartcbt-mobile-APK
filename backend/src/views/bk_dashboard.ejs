                replyMessage: document.getElementById('replyStudentMessageInput').value,
                status: status,
                scheduleDate: isSchedule ? (document.getElementById('scheduleDateInput')?.value || null) : null,
                scheduleTime: isSchedule ? (document.getElementById('scheduleTimeInput')?.value || null) : null,
                scheduleLocation: isSchedule ? (document.getElementById('scheduleLocationInput')?.value || null) : null,
                scheduleNotes: isSchedule ? (document.getElementById('scheduleNotesInput')?.value || null) : null
            };

            try {
                const res = await authFetch(`/api/bk/consultations/${id}/reply`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(res.ok) {
