        document.getElementById('manualAttForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const studentId = document.getElementById('manualStudentSelect').value;
            const status = document.getElementById('manualStatus').value;
            const note = document.getElementById('manualNote').value.trim();

            if (!studentId) {
                alert('Pilih siswa terlebih dahulu');
                return;
            }

            try {
                let res;
                if (status === 'SICK' || status === 'PERMISSION_KELUARGA') {
                    res = await fetch('/api/bk/quick-leave', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({
                            studentId: studentId,
                            leaveType: status === 'SICK' ? 'SAKIT' : 'KEPERLUAN_KELUARGA',
                            reason: note || (status === 'SICK' ? 'Izin Sakit Siswa' : 'Izin Keperluan Keluarga')
                        })
                    });
                } else {
                    const finalNote = status === 'HP_ERROR' 
                        ? `[Kendala Teknis HP Siswa (Rusak/Error/Baterai)] ${note}` 
                        : note;
                    const finalStatus = status === 'HP_ERROR' ? 'PRESENT' : status;

                    res = await fetch('/api/attendance/manual', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({
                            userId: studentId,
                            status: finalStatus,
                            note: finalNote
                        })
                    });
                }

                const json = await res.json();
                if (res.ok && json.success !== false) {
                    alert(json.message || 'Presensi / izin siswa berhasil disimpan dan disinkronkan ke rekap orang tua!');
                    document.getElementById('modalManualAtt').classList.add('hidden');
                    loadAttendanceData();
                } else {
                    alert(json.message || 'Gagal menyimpan presensi manual.');
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan jaringan atau server');
            }
        });

