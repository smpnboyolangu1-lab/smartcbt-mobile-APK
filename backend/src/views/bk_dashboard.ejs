        function renderTagTeacherList() {
            const container = document.getElementById('tagTeacherListContainer');
            const badge = document.getElementById('tagTeacherCountBadge');
            if (!container) return;

            const query = (document.getElementById('searchTagTeacherInput')?.value || '').toLowerCase().trim();
            const filtered = allAvailableTeachers.filter(t => {
                const nameMatch = (t.name || '').toLowerCase().includes(query);
                const nipMatch = (t.nip || t.username || '').toLowerCase().includes(query);
                const subjMatch = (t.teachingSubjects || '').toLowerCase().includes(query);
                return nameMatch || nipMatch || subjMatch;
            });

            if (badge) badge.innerText = `${filtered.length} Guru`;

            if (filtered.length === 0) {
                container.innerHTML = `<div class="py-8 text-center text-slate-400 text-xs">Tidak ada data guru yang cocok dengan "${query}".</div>`;
                return;
            }

            container.innerHTML = filtered.map(t => {
                const isCounselor = t.isCounselor || t.role === 'COUNSELOR';
                const initial = t.name ? t.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'GU';
                return `
                    <div class="p-3 bg-white rounded-xl border ${isCounselor ? 'border-teal-300 bg-teal-50/40' : 'border-slate-200'} flex items-center justify-between gap-3 hover:shadow-sm transition-all">
                        <div class="flex items-center gap-3 overflow-hidden">
