        // ==================== DIGITAL SCHOOL GATEPASS & EMERGENCY LEAVE SYSTEM ====================
        let allGatepassesBK = [];
        let bkQrCountdownInterval = null;
        let bkQrCurrentTtl = 45;

        async function loadGatepassMonitoringBK() {
            const tbody = document.getElementById('tableGatepassBK');
            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400 font-medium">Memuat data tiket gatepass real-time...</td></tr>';

            try {
                const res = await authFetch('/api/v1/bk/gatepasses?status=ALL');
                if (!res.ok) throw new Error('Gagal memuat gatepass: ' + res.statusText);
                const json = await res.json();
                allGatepassesBK = json.data || [];
                updateGatepassCountersBK(allGatepassesBK);
                renderGatepassesTableBK();
            } catch (err) {
                console.error('Error loadGatepassMonitoringBK:', err);
                tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-rose-500 font-semibold">Gagal memuat tiket gatepass: ${err.message}</td></tr>`;
            }
        }

        function updateGatepassCountersBK(list) {
            const pending = list.filter(g => g.status === 'PENDING').length;
            const waiting = list.filter(g => g.status === 'WAITING_BK_SCAN').length;
            const active = list.filter(g => g.status === 'ACTIVE_APPROVED').length;
            const completed = list.filter(g => g.status === 'COMPLETED').length;

            if (document.getElementById('statGatepassPending')) document.getElementById('statGatepassPending').innerText = pending;
            if (document.getElementById('statGatepassWaitingScan')) document.getElementById('statGatepassWaitingScan').innerText = waiting;
            if (document.getElementById('statGatepassActive')) document.getElementById('statGatepassActive').innerText = active;
            if (document.getElementById('statGatepassCompleted')) document.getElementById('statGatepassCompleted').innerText = completed;
        }

        function filterGatepassByStatus(status) {
            const filterEl = document.getElementById('gatepassStatusFilter');
            if (filterEl) {
                filterEl.value = status;
                renderGatepassesTableBK();
            }
        }

        function renderGatepassesTableBK() {
            const tbody = document.getElementById('tableGatepassBK');
            if (!tbody) return;

            const search = (document.getElementById('gatepassSearchBK')?.value || '').toLowerCase().trim();
            const statusFilter = document.getElementById('gatepassStatusFilter')?.value || 'ALL';
            const categoryFilter = document.getElementById('gatepassCategoryFilter')?.value || 'ALL';

            const filtered = allGatepassesBK.filter(g => {
                const studentName = (g.student?.name || '').toLowerCase();
                const studentNisn = (g.student?.nisn || '').toLowerCase();
                const studentClass = (g.student?.className || '').toLowerCase();
                const matchSearch = !search || studentName.includes(search) || studentNisn.includes(search) || studentClass.includes(search);
                const matchStatus = statusFilter === 'ALL' || g.status === statusFilter;
                const matchCat = categoryFilter === 'ALL' || g.leaveCategory === categoryFilter;
                return matchSearch && matchStatus && matchCat;
            });

            if (document.getElementById('gatepassCounterHint')) {
                document.getElementById('gatepassCounterHint').innerText = `Menampilkan ${filtered.length} dari ${allGatepassesBK.length} tiket gatepass`;
            }

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400 font-medium">Tidak ada data tiket gatepass yang sesuai dengan filter.</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map(g => {
                const timeStr = formatBkTimeWib(g.createdAt);
                const dateStr = new Date(g.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
                const catBadge = g.leaveCategory === 'sick'
                    ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700">🏥 Sakit</span>'
                    : (g.leaveCategory === 'dispensation'
                        ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">🏆 Dispensasi</span>'
                        : '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">👨‍👩‍👦 Mendesak</span>');

                let statusBadge = '';
                if (g.status === 'PENDING') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-amber-100 text-amber-800 animate-pulse">⏳ Menunggu ACC BK</span>';
                } else if (g.status === 'WAITING_BK_SCAN') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-sky-100 text-sky-800">📷 Siap Scan QR BK</span>';
                } else if (g.status === 'ACTIVE_APPROVED') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-800">🟢 Tiket Sah (Aktif)</span>';
                } else if (g.status === 'COMPLETED') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-indigo-100 text-indigo-800">🏁 Sudah Checkout</span>';
                } else if (g.status === 'REJECTED') {
                    statusBadge = '<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-rose-100 text-rose-800">❌ Ditolak</span>';
                } else {
                    statusBadge = `<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-slate-100 text-slate-700">${g.status}</span>`;
                }

                const avatar = g.student?.profilePicUrl || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(g.student?.name || 'S') + '&background=0D9488&color=fff';

                let actionBtns = '';
                if (g.status === 'PENDING') {
                    actionBtns = `
                        <div class="flex items-center justify-end gap-1.5">
                            <button onclick="updateGatepassActionBK('${g.id}', 'WAITING_BK_SCAN')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1.5 rounded-lg font-bold text-[11px] shadow transition flex items-center gap-1" title="ACC dan instruksikan siswa scan Dynamic QR Meja BK">
                                <span>✓</span> ACC Panggil Scan
                            </button>
                            <button onclick="promptRejectGatepassBK('${g.id}')" class="bg-rose-100 hover:bg-rose-200 text-rose-700 px-2.5 py-1.5 rounded-lg font-bold text-[11px] transition" title="Tolak Permohonan">
                                <span>✕</span>
                            </button>
                        </div>
                    `;
                } else if (g.status === 'WAITING_BK_SCAN') {
                    actionBtns = `
                        <div class="flex items-center justify-end gap-1.5">
                            <button onclick="openBkDynamicQrModal()" class="bg-sky-600 hover:bg-sky-700 text-white px-2.5 py-1.5 rounded-lg font-bold text-[11px] shadow transition flex items-center gap-1" title="Tampilkan QR di monitor agar siswa bisa scan">
                                <span>⚡</span> Tampilkan QR
                            </button>
                            <button onclick="promptRejectGatepassBK('${g.id}')" class="bg-slate-100 hover:bg-rose-100 text-rose-600 px-2 py-1.5 rounded-lg font-bold text-[11px] transition">
                                Tolak
                            </button>
                        </div>
                    `;
                } else if (g.status === 'ACTIVE_APPROVED') {
                    actionBtns = `
                        <span class="text-[11px] text-emerald-700 font-bold bg-emerald-50 px-2 py-1 rounded-lg border border-emerald-200 flex items-center gap-1 justify-end">
                            <span>⏱</span> Menuju Gerbang
                        </span>
                    `;
                } else {
                    actionBtns = `<span class="text-xs text-slate-400 font-medium">-</span>`;
                }

                return `
                    <tr class="hover:bg-slate-50 transition border-b border-slate-100">
                        <td class="p-3">
                            <div class="font-bold text-slate-800">${timeStr}</div>
                            <div class="text-[10px] text-slate-400">${dateStr}</div>
                        </td>
                        <td class="p-3">
                            <div class="flex items-center gap-2.5">
                                <img src="${avatar}" alt="" class="w-8 h-8 rounded-full object-cover border border-slate-200">
                                <div>
                                    <div class="font-bold text-slate-800 text-[12px]">${g.student?.name || '-'}</div>
                                    <div class="text-[10px] text-slate-500">Kelas ${g.student?.className || '-'} • NISN: ${g.student?.nisn || '-'}</div>
                                </div>
                            </div>
                        </td>
                        <td class="p-3">${catBadge}</td>
                        <td class="p-3">
                            <div class="text-slate-800 font-medium max-w-xs truncate" title="${g.reason || '-'}">${g.reason || '-'}</div>
                        </td>
                        <td class="p-3">
                            <div class="text-slate-700 font-semibold">${g.pickupBy || 'Mandiri'}</div>
                        </td>
                        <td class="p-3">${statusBadge}</td>
                        <td class="p-3">
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                                Sisa Mapel: Pulang Cepat
                            </span>
                        </td>
                        <td class="p-3 text-right">${actionBtns}</td>
                    </tr>
                `;
            }).join('');
        }

        async function updateGatepassActionBK(gatepassId, action, reason) {
            try {
                const res = await authFetch(`/api/v1/bk/gatepass/${gatepassId}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        status: action,
                        rejectionReason: reason || null,
                        counselorNotes: action === 'WAITING_BK_SCAN' ? 'Silakan scan Dynamic QR di layar Guru BK.' : (reason || null)
                    })
                });
                const json = await res.json();
                if (json.success) {
                    if (action === 'WAITING_BK_SCAN') {
                        openBkDynamicQrModal();
                    }
                    loadGatepassMonitoringBK();
                } else {
                    alert('Gagal memperbarui status: ' + (json.message || 'Error'));
                }
            } catch (e) {
                alert('Terjadi kesalahan jaringan: ' + e.message);
            }
        }

        function promptRejectGatepassBK(gatepassId) {
            const reason = prompt('Masukkan alasan penolakan tiket gatepass siswa:');
            if (reason && reason.trim().length > 0) {
                updateGatepassActionBK(gatepassId, 'REJECTED', reason.trim());
            }
        }

        // ==================== DYNAMIC ROTATING QR MONITOR ====================
        function openBkDynamicQrModal() {
            const modal = document.getElementById('modalBkDynamicQr');
            if (!modal) return;
            modal.classList.remove('hidden');
            fetchAndRenderBkDynamicQr();
        }

        function closeBkDynamicQrModal() {
            const modal = document.getElementById('modalBkDynamicQr');
            if (modal) modal.classList.add('hidden');
            if (bkQrCountdownInterval) clearInterval(bkQrCountdownInterval);
        }

        async function fetchAndRenderBkDynamicQr(manual = false) {
            const img = document.getElementById('imgBkDynamicQr');
            const canvasContainer = document.getElementById('canvasBkDynamicQr');
            const overlay = document.getElementById('qrLoadingOverlay');
            if (overlay) overlay.classList.remove('hidden');

            try {
                const res = await authFetch('/api/v1/bk/dynamic-qr');
                const json = await res.json();
                if (json.success && json.data) {
                    const tokenPayload = json.data.tokenPayload;
                    const tokenHash = json.data.currentTokenHash || '-';
                    const ttl = json.data.ttlSeconds || 45;

                    if (document.getElementById('txtBkTokenHash')) {
                        document.getElementById('txtBkTokenHash').innerText = '*' + tokenHash.substring(0, 16) + '...*';
                    }

                    // Render with local QRCode if available, fallback to img
                    if (canvasContainer && typeof QRCode !== 'undefined') {
                        canvasContainer.innerHTML = '';
                        new QRCode(canvasContainer, {
                            text: tokenPayload,
                            width: 256,
                            height: 256,
                            correctLevel: QRCode.CorrectLevel.M
                        });
                        canvasContainer.classList.remove('hidden');
                        if (img) img.classList.add('hidden');
                    } else if (img) {
                        img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(tokenPayload);
                        img.classList.remove('hidden');
                        if (canvasContainer) canvasContainer.classList.add('hidden');
                    }

                    startBkQrCountdown(ttl);
                }
            } catch (e) {
                console.error('Error fetchAndRenderBkDynamicQr:', e);
            } finally {
                if (overlay) overlay.classList.add('hidden');
            }
        }

        function startBkQrCountdown(seconds) {
            if (bkQrCountdownInterval) clearInterval(bkQrCountdownInterval);
            bkQrCurrentTtl = seconds;

            const txt = document.getElementById('txtBkQrCountdown');
            const bar = document.getElementById('barBkQrCountdown');

            function updateDisplay() {
                if (txt) txt.innerText = `${bkQrCurrentTtl} detik`;
                if (bar) {
                    const pct = Math.max(0, (bkQrCurrentTtl / 45) * 100);
                    bar.style.width = `${pct}%`;
                    if (bkQrCurrentTtl <= 10) {
                        bar.className = 'bg-rose-500 h-2.5 rounded-full transition-all duration-1000';
                    } else {
                        bar.className = 'bg-emerald-600 h-2.5 rounded-full transition-all duration-1000';
                    }
                }
            }

            updateDisplay();
            bkQrCountdownInterval = setInterval(() => {
                bkQrCurrentTtl--;
                if (bkQrCurrentTtl <= 0) {
                    clearInterval(bkQrCountdownInterval);
                    fetchAndRenderBkDynamicQr(); // Auto-rotate token!
                } else {
                    updateDisplay();
                }
            }, 1000);
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }
    </script>

