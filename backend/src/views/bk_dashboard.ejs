        function openBapModal(recordIdx) {
            const r = allDisciplineRecords[recordIdx];
            if(!r) return;
            const s = r.user || {};
            const dateObj = new Date(r.createdAt || Date.now());
            const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
            const dayDateStr = dateObj.toLocaleDateString('id-ID', options);

            document.getElementById('bapDocNumber').innerHTML = 'Nomor : &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
            document.getElementById('bapDocDayDate').innerText = dayDateStr;
            document.getElementById('bapDocStudentName').innerText = s.name || '-';
            document.getElementById('bapDocStudentNisn').innerText = s.nisn || s.username || '-';
            document.getElementById('bapDocStudentClass').innerText = s.className || '-';
            document.getElementById('bapDocCategory').innerText = (r.category || 'SEDANG').replace('_', ' ');
            document.getElementById('bapDocPoints').innerText = (r.points || 0);
            document.getElementById('bapDocDescription').innerText = r.description || '-';
            document.getElementById('bapDocChronology').innerText = r.chronology || r.description || 'Siswa melakukan pelanggaran terhadap tata tertib sekolah yang berlaku.';
            document.getElementById('bapDocSanction').innerText = r.sanction || 'Teguran lisan, pencatatan poin pelanggaran, serta penugasan pembinaan oleh Guru BK.';
            document.getElementById('bapDocSanctionLevel').innerText = (r.sanctionLevel || 'DIPROSES_BK').replace('_', ' ');

            document.getElementById('bapSignStudentName').innerText = '(' + (s.name || 'Peserta Didik').toUpperCase() + ')';
            document.getElementById('bapSignStudentNisn').innerText = 'NISN. ' + (s.nisn || s.username || '-');
            const counselorName = document.getElementById('profileName')?.innerText || 'Guru BK';
            document.getElementById('bapSignCounselorName').innerText = '(' + counselorName + ')';
            document.getElementById('bapSignHomeroomName').innerText = '(Wali Kelas ' + (s.className || '') + ')';

            // Muat data dinamis tanda tangan Kepala Sekolah & Koordinator BK dari Pengaturan Sistem
            fetch('/api/school-info')
                .then(res => res.json())
                .then(data => {
                    if (data.headmasterName) {
                        document.getElementById('bapSignHeadmasterName').innerText = '(' + data.headmasterName + ')';
                    }
                    if (data.headmasterNip) {
                        document.getElementById('bapSignHeadmasterNip').innerText = 'NIP. ' + data.headmasterNip;
                    }
                    if (data.schoolName) {
                        document.getElementById('bapSignHeadmasterTitle').innerText = 'Kepala ' + data.schoolName;
                    }
                    if (data.bkCoordinatorName && (counselorName === 'Guru BK' || counselorName.includes('SMPN 1'))) {
                        document.getElementById('bapSignCounselorName').innerText = '(' + data.bkCoordinatorName + ')';
                    }
                    if (data.bkCoordinatorNip) {
                        document.getElementById('bapSignCounselorNip').innerText = 'NIP. ' + data.bkCoordinatorNip;
                    }
                })
                .catch(e => console.warn('Gagal memuat info sekolah:', e));

            document.getElementById('modalBAP').classList.remove('hidden');
        }

