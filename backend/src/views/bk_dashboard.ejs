                const res = await fetch('/api/admin/users?role=STUDENT', { headers: { 'Authorization': 'Bearer ' + token } });
                allStudents = await res.json();
                if(Array.isArray(allStudents)) {
                    const uksSel = document.getElementById('uksStudentSelect');
