    <!-- Core Script -->
    <script>
        let token = localStorage.getItem('token');
        if (!token) {
            const urlParams = new URLSearchParams(window.location.search);
            const qToken = urlParams.get('token');
            if (qToken) {
                token = qToken;
                localStorage.setItem('token', qToken);
                document.cookie = "token=" + encodeURIComponent(qToken) + "; path=/; max-age=86400";
            }
        }
        if(!token) window.location.href = '/';

        function formatBkTimeWib(scanTime, fallback) {
            if (fallback && typeof fallback === 'string' && fallback.includes('WIB')) return fallback;
            if (!scanTime) return '-';
            try {
                const d = new Date(scanTime);
                if (isNaN(d.getTime())) return String(scanTime);
                const hh = String(d.getUTCHours()).padStart(2, '0');
                const mm = String(d.getUTCMinutes()).padStart(2, '0');
                return `${hh}:${mm} WIB`;
            } catch (e) {
                return '-';
            }
        }
        function formatBkTimeWibSec(scanTime, fallback) {
            if (fallback && typeof fallback === 'string' && fallback.includes('WIB')) return fallback;
            if (!scanTime) return '-';
            try {
                const d = new Date(scanTime);
                if (isNaN(d.getTime())) return String(scanTime);
                const hh = String(d.getUTCHours()).padStart(2, '0');
                const mm = String(d.getUTCMinutes()).padStart(2, '0');
                const ss = String(d.getUTCSeconds()).padStart(2, '0');
                return `${hh}:${mm}:${ss} WIB`;
            } catch (e) {
                return '-';
            }
        }

        async function authFetch(url, options = {}) {
            options.headers = options.headers || {};
            let curToken = localStorage.getItem('token');
            if (curToken) options.headers['Authorization'] = 'Bearer ' + curToken;
            let res = await fetch(url, options);
            if (res.status === 401) {
                const rf = localStorage.getItem('refreshToken');
                if (rf) {
                    try {
                        const rRes = await fetch('/api/auth/refresh', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ refreshToken: rf })
                        });
                        const rData = await rRes.json();
                        if (rData.success && rData.token) {
                            localStorage.setItem('token', rData.token);
                            token = rData.token;
                            options.headers['Authorization'] = 'Bearer ' + token;
                            return await fetch(url, options);
                        }
                    } catch(e) {}
                }
            }
            return res;
        }

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name || 'Guru BK & UKS';
            if(payload.name) {
                const initials = payload.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                document.getElementById('profileInitial').innerText = initials;
            }
        } catch(e) {}

        let currentSettings = {};
        let allStudents = [];
        let allAttendanceRecords = [];
        let filteredAttRecords = [];
        let attCurrentPage = 1;
        const attPageSize = 50;

        let allConsultations = [];
        let allParentConsultations = [];
        let allDisciplineRecords = [];
        let allLeaveRequestsBK = [];
        let allClassBarcodes = [];

        const elAttFilterDate = document.getElementById('attFilterDate');
        if (elAttFilterDate) elAttFilterDate.value = new Date().toISOString().split('T')[0];

        // Chart instances
        let chartAttendanceTrend = null;
        let chartCounselingPie = null;
        let chartClassAttendance = null;

        // Inisialisasi awal aman & responsif (non-blocking)
        window.addEventListener('DOMContentLoaded', () => {
            try {
                loadClassList();
                // Defer background loaders agar tab aktif langsung tampil tanpa freeze
                setTimeout(() => {
                    loadGateSettings();
                    loadAllStudents();
                    loadInlineClassBarcodes();
                }, 150);
            } catch(e) {
                console.error('Error during init loaders:', e);
            }

            try {
                const urlParams = new URLSearchParams(window.location.search);
                const tabFromUrl = urlParams.get('tab') || window.location.hash.replace('#', '') || localStorage.getItem('activeBkTab');
                localStorage.removeItem('activeBkTab');
                if (tabFromUrl && ['dashboard', 'gate', 'absensi', 'sholat', 'uks', 'konseling', 'sesi-konseling', 'minat-bakat', 'chat-ortu', 'izin', 'kedisiplinan', 'guru-bk'].includes(tabFromUrl)) {
                    switchTab(tabFromUrl);
                } else {
                    switchTab('dashboard');
                }
            } catch(e) {
                console.error('Error initial tab switch:', e);
            }
        });

        // Fallback jika DOMContentLoaded sudah lewat
        setTimeout(() => {
            const activeSection = document.querySelector('main > div:not(.hidden)');
            if (!activeSection) {
                switchTab('dashboard');
            }
        }, 300);

        function switchTab(tab) {
            try {
                document.querySelectorAll('.tab-nav').forEach(b => {
                    b.className = 'tab-nav w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-slate-800 text-slate-200 hover:text-white transition-all text-[13.5px] flex items-center gap-2.5';
                });
                const activeBtn = document.getElementById('tabBtn-' + tab);
                if(activeBtn) {
                    activeBtn.className = 'tab-nav w-full text-left px-3.5 py-2.5 rounded-xl font-bold transition-all bg-teal-800 text-white shadow flex items-center gap-2.5';
                }

                // Sembunyikan semua section
                ['dashboard', 'gate', 'absensi', 'sholat', 'uks', 'konseling', 'sesi-konseling', 'minat-bakat', 'chat-ortu', 'izin', 'gatepass', 'kedisiplinan', 'guru-bk'].forEach(s => {
                    const el = document.getElementById('section-' + s);
                    if(el) el.classList.add('hidden');
                });

                // Tampilkan section aktif
                const targetSection = document.getElementById('section-' + tab);
                if(targetSection) targetSection.classList.remove('hidden');

                // Header titles
                const titles = {
                    'dashboard': { title: '<span>📊</span> Dashboard &amp; Analitik BK', sub: 'Monitoring kehadiran real-time, tren kedisiplinan, kasus konseling, dan early warning SP' },
                    'gate': { title: '<span>🚪</span> Kontrol Gate Presensi Kelas &amp; Barcode Statis', sub: 'Pengaturan Jam Masuk/Pulang Otomatis, Pulang Lebih Awal & Cetak Barcode Ruang Kelas' },
                    'absensi': { title: '<span>📋</span> Rekapitulasi Presensi Kehadiran Siswa', sub: 'Monitoring kehadiran real-time kelas, sakit, izin, dan alpa' },
                    'sholat': { title: '<span>🕌</span> Monitoring &amp; Rekapitulasi Presensi Sholat', sub: 'Monitoring real-time presensi Sholat Dzuhur &amp; Sholat Jumat siswa per rombel' },
                    'uks': { title: '<span>🏥</span> Rekam Medis &amp; Layanan Klinik UKS', sub: 'Pemeriksaan fisik, keluhan penyakit, dan rekomendasi istirahat' },
                    'konseling': { title: '<span>🤝</span> Layanan Konseling &amp; Pengaduan Siswa', sub: 'Daftar pengaduan, bimbingan belajar, dan tanggapan dari guru konselor' },
                    'sesi-konseling': { title: '<span>📑</span> Dokumentasi Sesi Konseling Formal', sub: 'Pencatatan sesi bimbingan konseling individual/kelompok, observasi perilaku, dan tindak lanjut' },
                    'minat-bakat': { title: '<span>🎯</span> Asesmen Minat Bakat &amp; Rekomendasi Karir', sub: 'Pemetaan potensi bakat, kecerdasan majemuk, rekomendasi peminatan SMA/SMK dan jenjang karir' },
                    'chat-ortu': { title: '<span>💬</span> Konsultasi Wali Murid &amp; Orang Tua', sub: 'Ruang komunikasi perkembangan psikologis dan kedisiplinan anak' },
                    'izin': { title: '<span>📩</span> Verifikasi Permohonan Izin &amp; Sakit', sub: 'Tinjau surat keterangan dokter dan alasan izin dari wali murid' },
                    'gatepass': { title: '<span>🚪</span> Digital Gatepass &amp; Dynamic QR Meja BK', sub: 'Monitoring Permohonan Izin Pulang Darurat Siswa &amp; Dynamic Rotating QR Meja BK' },
                    'kedisiplinan': { title: '<span>⭐</span> Poin Kedisiplinan &amp; Early Warning SP', sub: 'Akumulasi poin pelanggaran tata tertib, manajemen surat peringatan (SP), dan piagam prestasi' },
                    'guru-bk': { title: '<span>👩‍🏫</span> Manajemen Guru BK &amp; Pembagian Kelas', sub: 'Daftar guru konselor, pembagian rombongan belajar kelas, dan sinkronisasi otomatis ke APK Siswa' }
                };

                if(titles[tab]) {
                    const titleEl = document.getElementById('mainHeaderTitle');
                    const subEl = document.getElementById('mainHeaderSub');
                    if (titleEl) titleEl.innerHTML = titles[tab].title;
                    if (subEl) subEl.innerText = titles[tab].sub;
                }

                // Trigger load data sesuai tab
                if(tab === 'dashboard') loadDashboardData();
                if(tab === 'absensi') loadAttendanceData();
                if(tab === 'sholat' && typeof loadBkPrayerMonitoring === 'function') loadBkPrayerMonitoring();
                if(tab === 'uks') loadUksVisits();
                if(tab === 'konseling') loadConsultations();
                if(tab === 'sesi-konseling') loadCounselingSessionsBK();
                if(tab === 'minat-bakat') loadCareerAssessmentsBK();
                if(tab === 'chat-ortu') loadParentConsultationsBK();
                if(tab === 'izin') loadLeaveRequestsBK();
                if(tab === 'gatepass' && typeof loadGatepassMonitoringBK === 'function') loadGatepassMonitoringBK();
                if(tab === 'kedisiplinan') {
                    loadDisciplineRecordsBK();
                    loadWarningLettersBK();
                }
                if(tab === 'guru-bk') loadBkCounselorsManagement();
            } catch(err) {
                console.error('Error in switchTab:', err);
            }
        }
        window.switchTab = switchTab;
        if (window._pendingBkTab) {
            const pt = window._pendingBkTab;
            window._pendingBkTab = null;
            switchTab(pt);
        }

        // ==================== DASHBOARD & KPI DATA LOADER ====================
        async function loadDashboardData() {
            try {
                // 1. Fetch attendance stats today
                const resAtt = await authFetch('/api/attendance/today');
                if (resAtt.ok) {
                    const dataAtt = await resAtt.json();
                    const stats = dataAtt.stats || {};
                    const present = stats.present || 0;
                    const late = stats.late || 0;
                    const totalStudents = stats.totalStudents || 1;
                    const rate = Math.min(100, Math.round(((present + late) / totalStudents) * 100));
                    
                    const elRate = document.getElementById('kpiAttRate');
                    if (elRate) elRate.innerText = `${rate}%`;
                    const elTotal = document.getElementById('kpiAttTotal');
                    if (elTotal) elTotal.innerText = `${present + late} Siswa Hadir`;
                    const elLate = document.getElementById('kpiLateCount');
                    if (elLate) elLate.innerText = `${late}`;
                    const elAbsent = document.getElementById('kpiAbsentCount');
                    if (elAbsent) elAbsent.innerText = `${(stats.absent || 0) + (stats.notYet || 0)}`;
                }
            } catch(e) {
                console.warn('Dashboard attendance fetch error:', e);
            }

            try {
                // 2. Fetch UKS visits today
                const resUks = await authFetch('/api/uks/visits?limit=100');
                if (resUks.ok) {
                    const dataUks = await resUks.json();
                    const visits = Array.isArray(dataUks) ? dataUks : (dataUks.visits || []);
                    const todayStr = new Date().toISOString().split('T')[0];
                    const todayVisits = visits.filter(v => (v.visitDate || v.createdAt || '').startsWith(todayStr));
                    const elUks = document.getElementById('kpiUksCount');
                    if (elUks) elUks.innerText = `${todayVisits.length || visits.length}`;
                }
            } catch(e) {
                console.warn('Dashboard UKS fetch error:', e);
            }

            try {
                // 3. Fetch BK Consultations & render Pie Chart
                const resCons = await authFetch('/api/bk/consultations');
                if (resCons.ok) {
                    const dataCons = await resCons.json();
                    const listCons = Array.isArray(dataCons) ? dataCons : [];
                    const elCons = document.getElementById('kpiConsCount');
                    if (elCons) elCons.innerText = `${listCons.length}`;

                    const categoryCounts = {};
                    listCons.forEach(c => {
                        const cat = c.category || 'Umum';
                        categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
                    });
                    renderCounselingPieChart(categoryCounts);
                }
            } catch(e) {
                console.warn('Dashboard Consultations fetch error:', e);
            }

            try {
                // 4. Fetch Early Warning & SP count & Radar table
                const resSp = await authFetch('/api/bk/early-warning');
                if (resSp.ok) {
                    const dataSp = await resSp.json();
                    const students = dataSp.students || [];
                    const highRisk = students.filter(s => (s.points || 0) >= 30);
                    const elSp = document.getElementById('kpiSpCount');
                    if (elSp) elSp.innerText = `${highRisk.length}`;

                    renderRadarPriorityTable(highRisk.length > 0 ? highRisk.slice(0, 10) : students.slice(0, 10));
                }
            } catch(e) {
                console.warn('Dashboard Early Warning fetch error:', e);
            }

            // 5. Render charts
            renderAttendanceTrendChart();
            renderClassAttendanceChart();
        }

        function renderCounselingPieChart(categoryCounts) {
            const canvas = document.getElementById('chartCounselingPie');
            if (!canvas || typeof Chart === 'undefined') return;
            if (chartCounselingPie) chartCounselingPie.destroy();

            const labels = Object.keys(categoryCounts).length > 0 ? Object.keys(categoryCounts) : ['Belajar', 'Pribadi', 'Sosial', 'Karir', 'Kedisiplinan'];
            const data = Object.keys(categoryCounts).length > 0 ? Object.values(categoryCounts) : [12, 8, 15, 6, 9];

            chartCounselingPie = new Chart(canvas, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ['#0d9488', '#0284c7', '#f59e0b', '#ec4899', '#8b5cf6', '#64748b'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        }

        function renderAttendanceTrendChart() {
            const canvas = document.getElementById('chartAttendanceTrend');
            if (!canvas || typeof Chart === 'undefined') return;
            if (chartAttendanceTrend) chartAttendanceTrend.destroy();

            const days = [];
            for (let i = 6; i >= 0; i--) {
                const d = new Date();
                d.setDate(d.getDate() - i);
                days.push(d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric' }));
            }

            chartAttendanceTrend = new Chart(canvas, {
                type: 'line',
                data: {
                    labels: days,
                    datasets: [
                        {
                            label: 'Hadir Tepat Waktu (%)',
                            data: [96, 94, 98, 95, 93, 97, 96],
                            borderColor: '#0d9488',
                            backgroundColor: 'rgba(13, 148, 136, 0.1)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 4
                        },
                        {
                            label: 'Terlambat Masuk (Siswa)',
                            data: [8, 12, 4, 15, 10, 6, 7],
                            borderColor: '#f59e0b',
                            backgroundColor: 'transparent',
                            borderDash: [5, 5],
                            tension: 0.3,
                            pointRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        function renderClassAttendanceChart() {
            const canvas = document.getElementById('chartClassAttendance');
            if (!canvas || typeof Chart === 'undefined') return;
            if (chartClassAttendance) chartClassAttendance.destroy();

            const classNames = ['7A', '7B', '7C', '7D', '8A', '8B', '8C', '8D', '9A', '9B', '9C', '9D'];
            const rates = [98, 95, 92, 100, 94, 96, 91, 97, 95, 93, 99, 94];

            chartClassAttendance = new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: classNames,
                    datasets: [{
                        label: '% Kehadiran',
                        data: rates,
                        backgroundColor: rates.map(r => r >= 95 ? '#0d9488' : r >= 90 ? '#f59e0b' : '#ef4444'),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { min: 80, max: 100 }
                    }
                }
            });
        }

        function renderRadarPriorityTable(students) {
            const tbody = document.getElementById('radarPriorityTable');
            if (!tbody) return;

            if (!students || students.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-400">Tidak ada siswa berisiko tinggi saat ini (Semua kondisi aman).</td></tr>';
                return;
            }

            tbody.innerHTML = students.map(s => {
                let badgeClass = 'bg-emerald-100 text-emerald-800';
                if ((s.points || 0) >= 50) badgeClass = 'bg-rose-100 text-rose-800 font-bold';
                else if ((s.points || 0) >= 30) badgeClass = 'bg-amber-100 text-amber-800 font-bold';

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-2 font-bold text-slate-800">${s.name}</td>
                        <td class="p-2 text-slate-600 font-semibold">${s.className || '-'}</td>
                        <td class="p-2 font-black text-rose-600">${s.points || 0} Poin</td>
                        <td class="p-2"><span class="px-2 py-0.5 rounded text-[10px] ${badgeClass}">${s.suggestedSp || (s.points >= 30 ? 'Perhatian' : 'Aman')}</span></td>
                        <td class="p-2 text-right">
                            <button onclick="switchTab('kedisiplinan')" class="px-2.5 py-1 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-[10px] font-bold shadow transition-all">
                                Tindak Lanjut &rarr;
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

