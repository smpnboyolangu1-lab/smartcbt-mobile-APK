                                ${initial}
                            </div>
                            <div class="truncate">
                                <div class="flex items-center gap-2">
                                    <h5 class="font-bold text-slate-800 text-xs truncate">${t.name}</h5>
                                    ${isCounselor ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-teal-100 text-teal-800 border border-teal-200">Guru BK Aktif</span>' : ''}
                                </div>
                                <p class="text-[11px] text-slate-400 font-mono">NIP/ID: ${t.nip || t.username || '-'} ${t.teachingSubjects ? '• ' + t.teachingSubjects : ''}</p>
                            </div>
                        </div>
                        <div class="shrink-0">
                            ${isCounselor ? `
                                <button onclick="toggleTagTeacherBK('${t.id}', false, '${escape(t.name)}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl font-bold text-xs transition-all flex items-center gap-1">
                                    <span>❌</span> Lepas Status BK
                                </button>
                            ` : `
                                <button onclick="toggleTagTeacherBK('${t.id}', true, '${escape(t.name)}')" class="px-3.5 py-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl font-bold text-xs shadow transition-all flex items-center gap-1">
                                    <span>➕</span> Jadikan Guru BK
                                </button>
                            `}
                        </div>
                    </div>
                `;
            }).join('');
