<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>👥 Manajemen User & Tugas Tambahan Guru - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
        .tab-btn.active {
            border-bottom: 2px solid #1565C0;
            color: #1565C0;
            font-weight: bold;
        }
        .sidebar-section-title { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; padding: 12px 16px 4px 16px; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <!-- Sidebar Terstruktur & Terkategori (Admin & Operator) -->
    <%- (typeof isOperator !== 'undefined' && isOperator) ? include('partials/sidebar_operator') : include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex justify-between items-center mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>👥</span> Manajemen User &amp; Tugas Tambahan Guru
                    </h1>
                    <p class="text-slate-500 text-xs">Kelola peran ganda guru, wali kelas, operator CBT, BK, ubah password, dan hapus akun</p>
                </div>
            </div>
            <div class="flex gap-2">
                <button onclick="openAddUserModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl shadow-md font-bold flex items-center gap-2 text-sm transition-all">
                    <span>+</span> Tambah Pengguna & Tugas Tambahan
                </button>
            </div>
        </div>

        <!-- Role Filter Tabs -->
        <div class="bg-white rounded-2xl shadow-sm border mb-6 px-4 pt-3 flex space-x-6 overflow-x-auto text-sm">
            <button onclick="switchRoleFilter('ALL')" class="tab-btn active pb-3 px-2 text-gray-500" id="tab-ALL">Semua Staf (<span id="count-ALL">0</span>)</button>
            <button onclick="switchRoleFilter('TEACHER')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-TEACHER">Guru & Pengajar (<span id="count-TEACHER">0</span>)</button>
            <button onclick="switchRoleFilter('KURIKULUM')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-KURIKULUM">🏛️ Tim Kurikulum (<span id="count-KURIKULUM">0</span>)</button>
            <button onclick="switchRoleFilter('WALI_KELAS')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-WALI_KELAS">Wali Kelas (<span id="count-WALI_KELAS">0</span>)</button>
            <button onclick="switchRoleFilter('OPERATOR')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-OPERATOR">Operator CBT / Proktor (<span id="count-OPERATOR">0</span>)</button>
            <button onclick="switchRoleFilter('ADMIN')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-ADMIN">Administrator (<span id="count-ADMIN">0</span>)</button>
            <button onclick="switchRoleFilter('COUNSELOR')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-COUNSELOR">BK / Konselor (<span id="count-COUNSELOR">0</span>)</button>
            <button onclick="switchRoleFilter('SECURITY')" class="tab-btn pb-3 px-2 text-gray-500" id="tab-SECURITY">🛡️ Satpam / Keamanan (<span id="count-SECURITY">0</span>)</button>
        </div>

        <!-- Search Bar & Bulk Actions -->
        <div class="bg-white rounded-2xl shadow-sm p-4 mb-6 border flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3 flex-1 min-w-[280px]">
                <input type="text" id="searchInput" placeholder="🔍 Cari Nama / Username / NIP / Kelas..." class="border p-2.5 rounded-xl w-full max-w-sm text-sm focus:ring-2 focus:ring-blue-500 outline-none" oninput="filterLocal()">
                <button type="button" id="btnBulkDelete" onclick="handleBulkDeleteUsers()" disabled class="bg-rose-600 hover:bg-rose-700 disabled:opacity-40 disabled:cursor-not-allowed text-white px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-1.5 shadow transition-all cursor-pointer whitespace-nowrap">
                    <span>🗑️</span> <span>Hapus Masal (<span id="selectedCountText">0</span>)</span>
                </button>
            </div>
            <span class="text-xs text-blue-700 font-semibold bg-blue-50 px-3 py-1.5 rounded-lg">💡 Guru dapat memiliki tugas ganda (misal: Guru MTK + Wali Kelas + Operator CBT)</span>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden border flex flex-col">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse whitespace-nowrap text-xs">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 uppercase tracking-wider border-b">
                            <th class="p-4 w-10 text-center">
                                <input type="checkbox" id="selectAllUsers" onchange="toggleSelectAllUsers(this)" class="w-4 h-4 rounded text-blue-600 cursor-pointer" title="Pilih Semua di Halaman Ini">
                            </th>
                            <th class="p-4">Nama Pengguna</th>
                            <th class="p-4">Username Login</th>
                            <th class="p-4">Role Utama</th>
                            <th class="p-4">Tugas Tambahan (Peran Ganda)</th>
                            <th class="p-4">Status Akun</th>
                            <th class="p-4 text-right">Aksi Kelola</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody" class="divide-y">
                        <tr><td colspan="7" class="p-6 text-center text-gray-500">Memuat data pengguna...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="p-4 bg-gray-50 border-t flex justify-between items-center text-xs text-gray-600">
                <span id="pageInfo">Menampilkan 0 dari 0 pengguna</span>
                <div class="space-x-2">
                    <button onclick="prevPage()" class="px-3 py-1.5 bg-gray-200 rounded-lg hover:bg-gray-300 font-medium" id="btnPrev">Sebelumnya</button>
                    <button onclick="nextPage()" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium" id="btnNext">Selanjutnya</button>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal Tambah / Ubah User & Tugas Tambahan -->
    <div id="userModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl">
            <div class="p-5 bg-gradient-to-r from-blue-900 to-indigo-900 text-white flex justify-between items-center">
                <h3 class="font-bold text-base" id="modalTitle">Tambah Pengguna & Tugas Tambahan</h3>
                <button onclick="closeUserModal()" class="text-gray-300 hover:text-white font-bold text-xl">&times;</button>
            </div>
            
            <form id="userForm" onsubmit="handleUserSubmit(event)" class="p-6 space-y-4 text-xs">
                <input type="hidden" id="userId">
                
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Nama Lengkap & Gelar</label>
                    <input type="text" id="userName" required placeholder="Contoh: Bpk. Drs. Agus Santoso, M.Pd" class="w-full border rounded-xl p-2.5">
                </div>

                <div>
                    <label class="block font-bold text-gray-700 mb-1">Username / NIP Login</label>
                    <input type="text" id="userUsername" required placeholder="Contoh: 198005122005011002 atau agus_mtk" class="w-full border rounded-xl p-2.5">
                </div>

                <div id="passwordFieldContainer">
                    <label class="block font-bold text-gray-700 mb-1" id="userPasswordLabel">Password</label>
                    <input type="password" id="userPassword" placeholder="Default: password123" class="w-full border rounded-xl p-2.5">
                </div>

                <div>
                    <label class="block font-bold text-gray-700 mb-1">Role Utama</label>
                    <select id="userRole" class="w-full border rounded-xl p-2.5 font-bold bg-white text-gray-800">
                        <option value="TEACHER">👨‍🏫 Guru / Tenaga Pendidik</option>
                        <option value="KURIKULUM">🏛️ Tim Kurikulum</option>
                        <option value="OPERATOR">💻 Operator CBT / Proktor</option>
                        <option value="ADMIN">🛡️ Administrator Sistem</option>
                        <option value="COUNSELOR">🕊️ Guru BK / Konselor</option>
                        <option value="SECURITY">🛡️ Petugas Keamanan / Satpam Pos Gerbang</option>
                        <option value="MEDICAL">🏥 Petugas Medis UKS</option>
                        <option value="LIBRARIAN">📚 Pengelola Perpustakaan</option>
                    </select>
                </div>

                <!-- TUGAS TAMBAHAN (MULTI-ROLE CHECKBOXES) -->
                <div class="p-4 bg-blue-50/70 border border-blue-200 rounded-2xl space-y-3">
                    <label class="block font-bold text-blue-950 uppercase tracking-wider text-[11px] flex items-center gap-1.5">
                        <span>⭐</span> Tugas Tambahan Guru (Multi-Role):
                    </label>

                    <!-- Checkbox 0: Tim Kurikulum -->
                    <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-800">
                        <input type="checkbox" id="chkIsKurikulum" class="w-4 h-4 rounded text-amber-600">
                        <span>🏛️ Tim Kurikulum (Approval Izin Guru, Modul Kurikulum & Akademik)</span>
                    </label>
                    
                    <!-- Checkbox 1: Wali Kelas -->
                    <div class="space-y-2">
                        <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-800">
                            <input type="checkbox" id="chkIsWaliKelas" onchange="toggleWaliKelasSelect(this)" class="w-4 h-4 rounded text-blue-600">
                            <span>Wali Kelas</span>
                        </label>
                        <div id="waliKelasDropdownContainer" class="pl-6 hidden">
                            <select id="userWaliKelas" class="w-full border rounded-lg p-2 bg-white text-xs font-semibold">
                                <option value="">-- Pilih Kelas --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Checkbox 2: Operator CBT -->
                    <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-800">
                        <input type="checkbox" id="chkIsOperatorCbt" class="w-4 h-4 rounded text-blue-600">
                        <span>Operator CBT / Proktor Ujian (Buka Token & Reset Login)</span>
                    </label>

                    <!-- Checkbox 3: Guru BK -->
                    <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-800">
                        <input type="checkbox" id="chkIsCounselor" class="w-4 h-4 rounded text-blue-600">
                        <span>Staff Pendamping BK / Konselor Siswa</span>
                    </label>

                    <!-- Checkbox 4: Petugas Keamanan / Satpam -->
                    <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-800">
                        <input type="checkbox" id="chkIsSecurity" class="w-4 h-4 rounded text-emerald-600">
                        <span>🛡️ Petugas Keamanan / Satpam Pos Gerbang (Scanner Gatepass)</span>
                    </label>
                </div>

                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeUserModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-xl font-bold">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold shadow-md">Simpan Peran</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Khusus Ubah Password Pengguna -->
    <div id="modalChangePassword" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-slate-200">
            <div class="p-5 bg-gradient-to-r from-amber-600 to-amber-700 text-white flex justify-between items-center">
                <div class="flex items-center gap-2.5">
                    <span class="text-xl">🔑</span>
                    <div>
                        <h3 class="font-bold text-base leading-tight">Ubah Password Pengguna</h3>
                        <p class="text-amber-100 text-[11px]">Setel password baru untuk akun staf / guru</p>
                    </div>
                </div>
                <button type="button" onclick="closeChangePasswordModal()" class="text-amber-200 hover:text-white font-bold text-2xl leading-none cursor-pointer">&times;</button>
            </div>
            
            <form id="changePasswordForm" onsubmit="handleChangePasswordSubmit(event)" class="p-6 space-y-4 text-xs">
                <input type="hidden" id="changePwdUserId">
                
                <!-- Info Pengguna yang akan diubah passwordnya -->
                <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-2xl flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 font-black text-sm flex items-center justify-center flex-shrink-0">
                        👤
                    </div>
                    <div class="overflow-hidden">
                        <h4 class="font-bold text-slate-800 text-sm truncate" id="changePwdUserName">-</h4>
                        <p class="text-slate-500 font-mono text-[11px] mt-0.5">Username: <span id="changePwdUserUsername" class="font-bold text-slate-700">-</span> | Role: <span id="changePwdUserRole" class="font-bold text-amber-700">-</span></p>
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-gray-700 mb-1">Password Baru</label>
                    <div class="relative">
                        <input type="password" id="inputNewPassword" required minlength="4" placeholder="Ketik password baru minimal 4 karakter..." class="w-full border border-slate-300 rounded-xl p-2.5 pr-10 text-xs focus:ring-2 focus:ring-amber-500 outline-none">
                        <button type="button" onclick="togglePasswordVisibility('inputNewPassword', 'eyeIconNewPwd')" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 cursor-pointer text-sm" title="Lihat / Sembunyikan Password">
                            <span id="eyeIconNewPwd">👁️</span>
                        </button>
                    </div>
                </div>

                <!-- Pilihan Cepat / Preset -->
                <div>
                    <label class="block font-bold text-slate-600 mb-1.5 text-[11px]">Preset Password Cepat:</label>
                    <div class="flex flex-wrap gap-1.5">
                        <button type="button" onclick="setPresetPassword('password123')" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[11px] font-semibold border border-slate-200 transition-all cursor-pointer">
                            Default: password123
                        </button>
                        <button type="button" onclick="setPresetPasswordFromUsername()" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[11px] font-semibold border border-slate-200 transition-all cursor-pointer">
                            Samakan Username/NIP
                        </button>
                        <button type="button" onclick="generateRandomPassword()" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[11px] font-semibold border border-slate-200 transition-all cursor-pointer">
                            🎲 Acak 8 Karakter
                        </button>
                    </div>
                </div>

                <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-[11px] text-amber-800 space-y-1">
                    <p class="font-semibold flex items-center gap-1">
                        <span>💡</span> Catatan Keamanan:
                    </p>
                    <p>Mengubah password akan otomatis membebaskan ikatan HP/perangkat lama sehingga pengguna dapat langsung login di perangkat baru.</p>
                </div>

                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeChangePasswordModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-bold transition-all cursor-pointer">Batal</button>
                    <button type="submit" id="btnSubmitChangePassword" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
                        <span>💾</span> <span>Simpan Password Baru</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let allUsers = [];
        let filteredUsers = [];
        let currentRoleFilter = 'ALL';
        let currentPage = 1;
        const pageSize = 15;

        async function fetchUsers() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/admin/users', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const rawUsers = await res.json();
                    // Sembunyikan akun Super Admin Utama dari list agar tidak terlihat atau diubah orang lain
                    allUsers = Array.isArray(rawUsers) ? rawUsers.filter(u => u.username !== 'admin' && u.username !== 'superadmin' && u.role !== 'SUPERADMIN') : [];
                    updateRoleCounts();
                    filterLocal();
                }
            } catch(e) {
                console.error(e);
            }
        }

        function updateRoleCounts() {
            document.getElementById('count-ALL').innerText = allUsers.length;
            document.getElementById('count-TEACHER').innerText = allUsers.filter(u => u.role === 'TEACHER').length;
            const kurikulumUsers = allUsers.filter(u => u.role === 'KURIKULUM' || (u.tugasTambahan && u.tugasTambahan.toUpperCase().includes('KURIKULUM')) || (u.rolesTambahan && u.rolesTambahan.includes('kurikulum')));
            const elK = document.getElementById('count-KURIKULUM');
            if (elK) elK.innerText = kurikulumUsers.length;
            document.getElementById('count-WALI_KELAS').innerText = allUsers.filter(u => u.className && u.className.startsWith('Wali') || u.className).length;
            document.getElementById('count-OPERATOR').innerText = allUsers.filter(u => u.role === 'OPERATOR').length;
            document.getElementById('count-ADMIN').innerText = allUsers.filter(u => u.role === 'ADMIN').length;
            document.getElementById('count-COUNSELOR').innerText = allUsers.filter(u => u.role === 'COUNSELOR' || u.isBk).length;
            const secEl = document.getElementById('count-SECURITY');
            if (secEl) secEl.innerText = allUsers.filter(u => u.role === 'SECURITY' || u.role === 'SATPAM' || u.isSecurity).length;
        }

        function switchRoleFilter(role) {
            currentRoleFilter = role;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + role)?.classList.add('active');
            currentPage = 1;
            filterLocal();
        }

        function filterLocal() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            filteredUsers = allUsers.filter(u => {
                let matchRole = true;
                if (currentRoleFilter === 'KURIKULUM') {
                    matchRole = u.role === 'KURIKULUM' || (u.tugasTambahan && u.tugasTambahan.toUpperCase().includes('KURIKULUM')) || (u.rolesTambahan && u.rolesTambahan.includes('kurikulum'));
                } else if (currentRoleFilter === 'WALI_KELAS') {
                    matchRole = u.className && u.className.length > 0;
                } else if (currentRoleFilter === 'SECURITY') {
                    matchRole = u.role === 'SECURITY' || u.role === 'SATPAM' || Boolean(u.isSecurity);
                } else if (currentRoleFilter === 'COUNSELOR') {
                    matchRole = u.role === 'COUNSELOR' || Boolean(u.isBk);
                } else if (currentRoleFilter !== 'ALL') {
                    matchRole = u.role === currentRoleFilter;
                }

                const matchQ = (u.name || '').toLowerCase().includes(q) ||
                               (u.username || '').toLowerCase().includes(q) ||
                               (u.className || '').toLowerCase().includes(q);
                return matchRole && matchQ;
            });

            renderUsers();
        }

        let selectedUserIds = new Set();

        function toggleSelectAllUsers(masterCheckbox) {
            const start = (currentPage - 1) * pageSize;
            const pageUsers = filteredUsers.slice(start, start + pageSize);
            pageUsers.forEach(u => {
                if (masterCheckbox.checked) {
                    selectedUserIds.add(u.id);
                } else {
                    selectedUserIds.delete(u.id);
                }
            });
            document.querySelectorAll('.user-row-cb').forEach(cb => {
                cb.checked = masterCheckbox.checked;
            });
            updateSelectedUsersCount();
        }

        function toggleUserSelection(id, isChecked) {
            if (isChecked) {
                selectedUserIds.add(id);
            } else {
                selectedUserIds.delete(id);
            }
            updateSelectedUsersCount();
        }

        function updateSelectedUsersCount() {
            const count = selectedUserIds.size;
            const countEl = document.getElementById('selectedCountText');
            if (countEl) countEl.innerText = count;
            const btn = document.getElementById('btnBulkDelete');
            if (btn) btn.disabled = count === 0;

            const masterCb = document.getElementById('selectAllUsers');
            const start = (currentPage - 1) * pageSize;
            const pageUsers = filteredUsers.slice(start, start + pageSize);
            if (masterCb && pageUsers.length > 0) {
                masterCb.checked = pageUsers.every(u => selectedUserIds.has(u.id));
            }
        }

        function renderUsers() {
            const tbody = document.getElementById('userTableBody');
            if (filteredUsers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-gray-400">Tidak ada data pengguna yang sesuai filter</td></tr>';
                document.getElementById('pageInfo').innerText = 'Menampilkan 0 pengguna';
                return;
            }

            const start = (currentPage - 1) * pageSize;
            const pageUsers = filteredUsers.slice(start, start + pageSize);

            tbody.innerHTML = pageUsers.map(u => {
                let roleBadge = '<span class="bg-blue-100 text-blue-800 px-2.5 py-1 rounded-full font-bold">👨‍🏫 GURU</span>';
                if (u.role === 'KURIKULUM') roleBadge = '<span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full font-bold">🏛️ KURIKULUM</span>';
                if (u.role === 'OPERATOR') roleBadge = '<span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full font-bold">💻 OPERATOR</span>';
                if (u.role === 'ADMIN') roleBadge = '<span class="bg-purple-100 text-purple-800 px-2.5 py-1 rounded-full font-bold">🛡️ ADMIN</span>';
                if (u.role === 'COUNSELOR') roleBadge = '<span class="bg-teal-100 text-teal-800 px-2.5 py-1 rounded-full font-bold">🕊️ BK</span>';
                if (u.role === 'SECURITY' || u.role === 'SATPAM') roleBadge = '<span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold">🛡️ SATPAM</span>';
                if (u.role === 'MEDICAL' || u.role === 'UKS') roleBadge = '<span class="bg-rose-100 text-rose-800 px-2.5 py-1 rounded-full font-bold">🏥 UKS</span>';
                if (u.role === 'LIBRARIAN' || u.role === 'PERPUSTAKAAN') roleBadge = '<span class="bg-indigo-100 text-indigo-800 px-2.5 py-1 rounded-full font-bold">📚 PERPUS</span>';

                let dutyBadges = '';
                if (u.role !== 'KURIKULUM' && ((u.tugasTambahan && u.tugasTambahan.toUpperCase().includes('KURIKULUM')) || (u.rolesTambahan && u.rolesTambahan.includes('kurikulum')))) {
                    dutyBadges += `<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-bold mr-1">🏛️ Kurikulum</span>`;
                }
                if (u.className) {
                    dutyBadges += `<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md font-bold mr-1">🏫 Wali ${u.className}</span>`;
                }
                if (u.role === 'TEACHER' && u.teachingClasses?.includes('OPERATOR')) {
                    dutyBadges += `<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-bold mr-1">💻 Operator CBT</span>`;
                }
                if (u.isBk && u.role !== 'COUNSELOR') {
                    dutyBadges += `<span class="bg-teal-100 text-teal-800 px-2 py-0.5 rounded-md font-bold mr-1">🕊️ Guru BK</span>`;
                }
                if (u.isSecurity && u.role !== 'SECURITY' && u.role !== 'SATPAM') {
                    dutyBadges += `<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md font-bold mr-1">🛡️ Pos Satpam</span>`;
                }
                if (!dutyBadges) dutyBadges = '<span class="text-gray-400">-</span>';

                const isChecked = selectedUserIds.has(u.id);

                return `
                    <tr class="hover:bg-slate-50 transition-colors ${isChecked ? 'bg-blue-50/40' : ''}">
                        <td class="p-4 text-center">
                            <input type="checkbox" class="user-row-cb w-4 h-4 rounded text-blue-600 cursor-pointer" value="${u.id}" ${isChecked ? 'checked' : ''} onchange="toggleUserSelection('${u.id}', this.checked)">
                        </td>
                        <td class="p-4 font-bold text-gray-800 flex items-center gap-2">
                            <span>👤</span> <span>${u.name}</span>
                        </td>
                        <td class="p-4 font-mono text-gray-600">${u.username}</td>
                        <td class="p-4">${roleBadge}</td>
                        <td class="p-4">${dutyBadges}</td>
                        <td class="p-4">
                            <span class="bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded text-[10px]">🟢 AKTIF</span>
                        </td>
                        <td class="p-4 text-right whitespace-nowrap">
                            <div class="inline-flex items-center gap-1.5 justify-end">
                                <button onclick="openEditUserModal('${u.id}')" class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 px-3 py-1.5 rounded-xl font-bold text-xs transition-all flex items-center gap-1 cursor-pointer" title="Ubah Nama, Role, dan Tugas Tambahan">
                                    <span>✏️</span> <span>Ubah Role</span>
                                </button>
                                <button onclick="openChangePasswordModal('${u.id}')" class="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 px-3 py-1.5 rounded-xl font-bold text-xs transition-all flex items-center gap-1 cursor-pointer" title="Ubah atau Setel Password Baru">
                                    <span>🔑</span> <span>Ubah Password</span>
                                </button>
                                <button onclick="forceLogoutUserPrompt('${u.id}', '${(u.name || '').replace(/'/g, "\\'")}')" class="bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 px-3 py-1.5 rounded-xl font-bold text-xs transition-all flex items-center gap-1 cursor-pointer" title="Putus Sesi Login APK Pengguna Ini">
                                    <span>🚪</span> <span>Logout APK</span>
                                </button>
                                <button onclick="confirmDeleteUser('${u.id}', '${(u.name || '').replace(/'/g, "\\'")}', '${(u.username || '').replace(/'/g, "\\'")}')" class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 px-3 py-1.5 rounded-xl font-bold text-xs transition-all flex items-center gap-1 cursor-pointer" title="Hapus pengguna ini dari sistem">
                                    <span>🗑️</span> <span>Hapus</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('pageInfo').innerText = `Menampilkan ${start + 1}-${Math.min(start + pageSize, filteredUsers.length)} dari ${filteredUsers.length} pengguna`;
            updateSelectedUsersCount();
        }

        function toggleWaliKelasSelect(checkbox) {
            document.getElementById('waliKelasDropdownContainer').classList.toggle('hidden', !checkbox.checked);
        }

        function openAddUserModal() {
            document.getElementById('modalTitle').innerText = 'Tambah Pengguna & Tugas Tambahan';
            document.getElementById('userId').value = '';
            document.getElementById('userName').value = '';
            document.getElementById('userUsername').value = '';
            document.getElementById('userPasswordLabel').innerText = 'Password Awal';
            document.getElementById('userPassword').placeholder = 'Default: password123 (atau satpam123 untuk Satpam)';
            document.getElementById('userPassword').value = 'password123';
            document.getElementById('passwordFieldContainer').classList.remove('hidden');
            document.getElementById('userRole').value = 'TEACHER';
            document.getElementById('chkIsWaliKelas').checked = false;
            document.getElementById('userWaliKelas').value = '';
            document.getElementById('chkIsOperatorCbt').checked = false;
            document.getElementById('chkIsCounselor').checked = false;
            const chkSec = document.getElementById('chkIsSecurity');
            if (chkSec) chkSec.checked = false;
            document.getElementById('waliKelasDropdownContainer').classList.add('hidden');
            document.getElementById('userModal').classList.remove('hidden');
        }

        function openEditUserModal(id) {
            const u = allUsers.find(x => x.id === id);
            if (!u) return;

            document.getElementById('modalTitle').innerText = 'Ubah Peran & Tugas Tambahan: ' + u.name;
            document.getElementById('userId').value = u.id;
            document.getElementById('userName').value = u.name;
            document.getElementById('userUsername').value = u.username;
            document.getElementById('userPasswordLabel').innerText = 'Password Baru (Kosongkan jika tidak ingin mengubah)';
            document.getElementById('userPassword').placeholder = 'Kosongkan jika tidak diubah';
            document.getElementById('userPassword').value = '';
            document.getElementById('passwordFieldContainer').classList.remove('hidden');
            document.getElementById('userRole').value = (u.role === 'SATPAM') ? 'SECURITY' : u.role;
            
            const isWali = Boolean(u.className);
            document.getElementById('chkIsWaliKelas').checked = isWali;
            document.getElementById('userWaliKelas').value = u.className || '';
            document.getElementById('waliKelasDropdownContainer').classList.toggle('hidden', !isWali);
            const isKurikulum = Boolean(u.role === 'KURIKULUM' || u.tugasTambahan?.includes('KURIKULUM') || u.rolesTambahan?.includes('kurikulum'));
            document.getElementById('chkIsKurikulum').checked = isKurikulum;
            document.getElementById('chkIsOperatorCbt').checked = Boolean(u.teachingClasses?.includes('OPERATOR'));
            document.getElementById('chkIsCounselor').checked = Boolean(u.role === 'COUNSELOR' || u.isBk);
            const chkSec = document.getElementById('chkIsSecurity');
            if (chkSec) chkSec.checked = Boolean(u.role === 'SECURITY' || u.role === 'SATPAM' || u.isSecurity);

            document.getElementById('userModal').classList.remove('hidden');
        }

        function closeUserModal() {
            document.getElementById('userModal').classList.add('hidden');
        }

        async function handleUserSubmit(e) {
            e.preventDefault();
            const token = localStorage.getItem('token');
            const id = document.getElementById('userId').value;
            const name = document.getElementById('userName').value;
            const username = document.getElementById('userUsername').value;
            const role = document.getElementById('userRole').value;
            const isKurikulum = document.getElementById('chkIsKurikulum').checked || role === 'KURIKULUM';
            const isWali = document.getElementById('chkIsWaliKelas').checked;
            const waliClass = isWali ? document.getElementById('userWaliKelas').value : null;
            const isOperatorCbt = document.getElementById('chkIsOperatorCbt').checked;
            const isCounselor = document.getElementById('chkIsCounselor').checked;
            const chkSec = document.getElementById('chkIsSecurity');
            const isSecurity = chkSec ? chkSec.checked : false;
            const pwdVal = document.getElementById('userPassword').value.trim();

            const finalRole = (isCounselor && role === 'TEACHER') ? 'COUNSELOR' : role;

            const tugasArr = [];
            if (isKurikulum) tugasArr.push('KURIKULUM');
            if (isWali) tugasArr.push('WALI_KELAS');
            if (isOperatorCbt) tugasArr.push('OPERATOR');
            if (isCounselor || finalRole === 'COUNSELOR') tugasArr.push('BK');
            if (isSecurity || finalRole === 'SECURITY') tugasArr.push('SATPAM');

            const payload = {
                name,
                username,
                role: finalRole,
                className: waliClass,
                isBk: Boolean(isCounselor || finalRole === 'COUNSELOR'),
                isSecurity: Boolean(isSecurity || finalRole === 'SECURITY'),
                isKurikulum: Boolean(isKurikulum),
                tugasTambahan: tugasArr.length > 0 ? tugasArr.join(',') : null
            };

            if (isOperatorCbt) {
                payload.teachingClasses = 'OPERATOR';
            }
            if (pwdVal) {
                payload.password = pwdVal;
            }

            try {
                if (id) {
                    const res = await fetch('/api/admin/users/' + id, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok) {
                        alert(data.message || '✅ Peran dan tugas tambahan pengguna berhasil diperbarui!');
                        closeUserModal();
                        fetchUsers();
                    } else {
                        alert('❌ ' + (data.message || 'Gagal memperbarui pengguna'));
                    }
                } else {
                    payload.password = pwdVal || 'password123';
                    const res = await fetch('/api/admin/users', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok) {
                        alert(data.message || '✅ Pengguna baru berhasil ditambahkan!');
                        closeUserModal();
                        fetchUsers();
                    } else {
                        alert('❌ ' + (data.message || 'Gagal menambahkan pengguna'));
                    }
                }
            } catch(err) {
                alert('Gagal menyimpan pengguna karena kesalahan koneksi/server');
            }
        }

        // ==================== FITUR UBAH / RESET PASSWORD ====================
        let activeChangePwdUser = null;

        function openChangePasswordModal(userId) {
            const u = allUsers.find(x => x.id === userId);
            if (!u) return;

            activeChangePwdUser = u;
            document.getElementById('changePwdUserId').value = u.id;
            document.getElementById('changePwdUserName').innerText = u.name;
            document.getElementById('changePwdUserUsername').innerText = u.username;
            document.getElementById('changePwdUserRole').innerText = u.role;
            document.getElementById('inputNewPassword').value = '';
            document.getElementById('inputNewPassword').type = 'password';
            document.getElementById('eyeIconNewPwd').innerText = '👁️';

            document.getElementById('modalChangePassword').classList.remove('hidden');
            setTimeout(() => document.getElementById('inputNewPassword').focus(), 100);
        }

        function closeChangePasswordModal() {
            document.getElementById('modalChangePassword').classList.add('hidden');
            activeChangePwdUser = null;
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) icon.innerText = '🙈';
            } else {
                input.type = 'password';
                if (icon) icon.innerText = '👁️';
            }
        }

        function setPresetPassword(val) {
            const input = document.getElementById('inputNewPassword');
            if (input) {
                input.value = val;
                input.focus();
            }
        }

        function setPresetPasswordFromUsername() {
            if (activeChangePwdUser && activeChangePwdUser.username) {
                setPresetPassword(activeChangePwdUser.username);
            }
        }

        function generateRandomPassword() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#';
            let pwd = '';
            for (let i = 0; i < 8; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            setPresetPassword(pwd);
        }

        async function handleChangePasswordSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('changePwdUserId').value;
            const newPassword = document.getElementById('inputNewPassword').value.trim();
            const btn = document.getElementById('btnSubmitChangePassword');

            if (!id || !newPassword) {
                alert('Silakan masukkan password baru minimal 4 karakter');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<span>⏳</span> <span>Menyimpan...</span>`;
            const token = localStorage.getItem('token');

            try {
                const res = await fetch('/api/admin/users/' + id + '/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ newPassword })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Password berhasil diperbarui!'));
                    closeChangePasswordModal();
                } else {
                    alert('❌ ' + (data.message || 'Gagal mengubah password'));
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan koneksi saat menyimpan password baru');
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<span>💾</span> <span>Simpan Password Baru</span>`;
            }
        }

        // ==================== FITUR HAPUS PENGGUNA ====================
        async function confirmDeleteUser(id, name, username) {
            if (!confirm(`⚠️ PERINGATAN: Apakah Anda yakin ingin MENGHAPUS pengguna berikut?\n\n• Nama: ${name}\n• Username: ${username}\n\nAkun ini dan seluruh hak aksesnya akan dihapus permanen dari sistem.`)) {
                return;
            }

            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/admin/users/' + id, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok && data.success !== false) {
                    alert(data.message || `✅ Pengguna ${name} berhasil dihapus!`);
                    await fetchUsers();
                } else {
                    alert('❌ ' + (data.message || 'Gagal menghapus pengguna'));
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan koneksi saat menghapus pengguna.');
            }
        }

        // ==================== FITUR HAPUS MASAL PENGGUNA ====================
        async function handleBulkDeleteUsers() {
            const ids = Array.from(selectedUserIds);
            if (ids.length === 0) return;

            if (!confirm(`⚠️ PERINGATAN HAPUS MASAL!\n\nApakah Anda yakin ingin MENGHAPUS PERMANEN ${ids.length} pengguna terpilih?\n\nSeluruh data presensi, rekam ujian CBT, tugas, UKS, dan peminjaman buku terkait pengguna tersebut akan dibersihkan secara permanen dari sistem.`)) {
                return;
            }

            const btn = document.getElementById('btnBulkDelete');
            const origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span>⏳</span> <span>Menghapus ${ids.length}...</span>`;

            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/admin/users/bulk-delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ userIds: ids })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message || `✅ Berhasil menghapus ${data.deletedCount} pengguna!`);
                    selectedUserIds.clear();
                    updateSelectedUsersCount();
                    await fetchUsers();
                } else {
                    alert('❌ ' + (data.message || 'Gagal melakukan hapus masal'));
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan koneksi saat menghapus masal pengguna.');
            } finally {
                btn.disabled = selectedUserIds.size === 0;
                btn.innerHTML = origHtml;
            }
        }

        // ==================== LOAD KELAS UNTUK WALI KELAS ====================
        let allClassesList = [];

        async function fetchClassList() {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch('/api/kelas', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    allClassesList = await res.json();
                    const sel = document.getElementById('userWaliKelas');
                    if (sel && Array.isArray(allClassesList)) {
                        const curVal = sel.value;
                        sel.innerHTML = '<option value="">-- Pilih Kelas --</option>' +
                            allClassesList.map(c => `<option value="${c.nama || c.name}">Kelas ${c.nama || c.name}</option>`).join('');
                        if (curVal) sel.value = curVal;
                    }
                }
            } catch(e) {
                console.warn('Failed to load class list for wali select:', e);
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderUsers();
            }
        }

        function nextPage() {
            if (currentPage * pageSize < filteredUsers.length) {
                currentPage++;
                renderUsers();
            }
        }

        async function forceLogoutUserPrompt(userId, userName) {
            if (!confirm(`Konfirmasi Logout Paksa APK / Portal:\n\nApakah Anda yakin ingin mengeluarkan paksa akun "${userName}" dari aplikasi APK Android & sistem?\n\nSesi pengguna ini akan langsung berakhir seketika dan perangkat akan diarahkan kembali ke menu login.`)) return;
            try {
                const token = localStorage.getItem('token');
                const res = await fetch(`/api/admin/users/${userId}/force-logout`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    }
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ ' + (data.message || 'Sesi pengguna berhasil diputus paksa.'));
                    await fetchUsers();
                } else {
                    alert('❌ ' + (data.message || 'Gagal memutus sesi pengguna.'));
                }
            } catch (e) {
                console.error(e);
                alert('❌ Gagal menghubungi server.');
            }
        }

        function logout() {
            localStorage.removeItem('token');
            window.location.href = '/';
        }

        fetchUsers();
        fetchClassList();
    </script>
</body>
</html>
