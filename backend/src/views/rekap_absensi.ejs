<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekap Absensi Siswa - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/chart.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <%- (typeof isOperator !== 'undefined' && isOperator) ? include('partials/sidebar_operator') : include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📋</span> Rekapitulasi Presensi Kehadiran Siswa
                    </h1>
                    <p class="text-slate-500 text-xs">Dashboard &amp; Visualisasi Terpadu: 10 Status Kehadiran Detail &amp; Grafik Tren</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/bk" class="bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-2 rounded-lg shadow font-semibold flex items-center gap-1.5 text-xs">
                    <span>🚪</span> Kontrol Gate &amp; Barcode
                </a>
                <a href="/bk?tab=izin" class="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2 rounded-lg shadow font-bold flex items-center gap-1.5 text-xs">
                    <span>📩</span> Verifikasi Izin &amp; Sakit BK
                </a>
                <button onclick="openHolidayModal()" class="bg-teal-600 hover:bg-teal-700 text-white px-3.5 py-2 rounded-lg shadow font-bold flex items-center gap-1.5 text-xs" title="Kelola Hari Libur Sekolah / Situasi Khusus">
                    <span>🌴</span> Kelola Hari Libur
                </button>
                <button onclick="openManualModal()" class="bg-green-600 hover:bg-green-700 text-white px-3.5 py-2 rounded-lg shadow font-semibold flex items-center gap-1.5 text-xs">
                    <span>+</span> Input Manual
                </button>
            </div>
        </div>

        <!-- BANNER HARI LIBUR JIKA TANGGAL TERPILIH ADALAH HARI LIBUR / MINGGU -->
        <div id="holidayBanner" class="hidden mb-6 p-4 bg-gradient-to-r from-teal-700 via-emerald-700 to-teal-900 text-white rounded-2xl shadow-md flex flex-wrap items-center justify-between gap-3 border border-teal-500/40">
            <div class="flex items-center gap-3">
                <span class="text-3xl">🌴</span>
                <div>
                    <h4 class="font-extrabold text-sm uppercase tracking-wider flex items-center gap-2">
                        <span id="holidayBannerTitle">Hari Libur Sekolah</span>
                        <span class="bg-white/20 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Libur Resmi</span>
                    </h4>
                    <p class="text-xs text-teal-100 mt-0.5" id="holidayBannerDesc">Siswa yang tidak scan barcode tercatat sebagai [LBR] Libur (bukan Alfa/Bolos).</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="openHolidayModal()" class="bg-white text-teal-900 hover:bg-teal-50 text-xs font-bold px-3 py-1.5 rounded-lg shadow">
                    ⚙️ Atur Hari Libur
                </button>
            </div>
        </div>

        <!-- 11 STATUS RINGKASAN KARTU PRESENSI LENGKAP -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 lg:grid-cols-12 gap-2.5 mb-6">
            <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-200 text-center">
                <p class="text-[10px] text-gray-400 font-bold uppercase">Total</p>
                <p class="text-xl font-black text-gray-800" id="statTotal">0</p>
            </div>
            <!-- H: Hadir (#10B981) -->
            <div class="bg-emerald-50 p-3 rounded-xl shadow-sm border border-emerald-200 text-center">
                <p class="text-[10px] text-emerald-700 font-black uppercase">[H] Hadir</p>
                <p class="text-xl font-black text-emerald-700" id="statH">0</p>
            </div>
            <!-- ? : Hadir Tidak Scan Pulang (#0284C7) -->
            <div class="bg-sky-50 p-3 rounded-xl shadow-sm border border-sky-200 text-center">
                <p class="text-[10px] text-sky-700 font-black uppercase">[?] Tdk Scan</p>
                <p class="text-xl font-black text-sky-700" id="statUnconfirmedOut">0</p>
            </div>
            <!-- T: Terlambat (#F59E0B) -->
            <div class="bg-amber-50 p-3 rounded-xl shadow-sm border border-amber-200 text-center">
                <p class="text-[10px] text-amber-700 font-black uppercase">[T] Terlambat</p>
                <p class="text-xl font-black text-amber-700" id="statT">0</p>
            </div>
            <!-- S: Sakit (#8B5CF6) -->
            <div class="bg-purple-50 p-3 rounded-xl shadow-sm border border-purple-200 text-center">
                <p class="text-[10px] text-purple-700 font-black uppercase">[S] Sakit</p>
                <p class="text-xl font-black text-purple-700" id="statS">0</p>
            </div>
            <!-- I: Izin (#3B82F6) -->
            <div class="bg-blue-50 p-3 rounded-xl shadow-sm border border-blue-200 text-center">
                <p class="text-[10px] text-blue-700 font-black uppercase">[I] Izin</p>
                <p class="text-xl font-black text-blue-700" id="statI">0</p>
            </div>
            <!-- A: Alfa (#EF4444) -->
            <div class="bg-red-50 p-3 rounded-xl shadow-sm border border-red-200 text-center">
                <p class="text-[10px] text-red-700 font-black uppercase">[A] Alfa</p>
                <p class="text-xl font-black text-red-700" id="statA">0</p>
            </div>
            <!-- D: Dispensasi (#F97316) -->
            <div class="bg-orange-50 p-3 rounded-xl shadow-sm border border-orange-200 text-center">
                <p class="text-[10px] text-orange-700 font-black uppercase">[D] Dispen</p>
                <p class="text-xl font-black text-orange-700" id="statD">0</p>
            </div>
            <!-- U: UKS (#06B6D4) -->
            <div class="bg-cyan-50 p-3 rounded-xl shadow-sm border border-cyan-200 text-center">
                <p class="text-[10px] text-cyan-700 font-black uppercase">[U] UKS</p>
                <p class="text-xl font-black text-cyan-700" id="statU">0</p>
            </div>
            <!-- P: Pulang (#64748B) -->
            <div class="bg-slate-100 p-3 rounded-xl shadow-sm border border-slate-300 text-center">
                <p class="text-[10px] text-slate-700 font-black uppercase">[P] Pulang</p>
                <p class="text-xl font-black text-slate-700" id="statP">0</p>
            </div>
            <!-- L: Tugas Luar (#D97706) -->
            <div class="bg-yellow-50 p-3 rounded-xl shadow-sm border border-yellow-300 text-center">
                <p class="text-[10px] text-yellow-800 font-black uppercase">[L] Luar</p>
                <p class="text-xl font-black text-yellow-800" id="statL">0</p>
            </div>
            <!-- B: Bolos (#991B1B) -->
            <div class="bg-rose-100 p-3 rounded-xl shadow-sm border border-rose-300 text-center">
                <p class="text-[10px] text-rose-800 font-black uppercase">[B] Bolos</p>
                <p class="text-xl font-black text-rose-800" id="statB">0</p>
            </div>
            <!-- LBR: Libur (#0D9488) -->
            <div class="bg-teal-50 p-3 rounded-xl shadow-sm border border-teal-300 text-center">
                <p class="text-[10px] text-teal-800 font-black uppercase">[LBR] Libur</p>
                <p class="text-xl font-black text-teal-700" id="statLBR">0</p>
            </div>
        </div>

        <!-- 2 GRAFIK VISUALISASI: GRAFIK BATANG BULANAN & GRAFIK LINGKARAN KOMPOSISI -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <!-- Grafik Batang per Bulan (Col-span 2) -->
            <div class="lg:col-span-2 bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-xs font-bold text-gray-700 uppercase flex items-center gap-1.5">
                        <span>📊</span> Grafik Batang Tren Tingkat Kehadiran Siswa per Bulan (%)
                    </h3>
                    <span class="text-[10px] text-gray-400 font-semibold">Tahun Ajaran 2025/2026</span>
                </div>
                <div class="h-56 relative">
                    <canvas id="chartMonthlyAttendance"></canvas>
                </div>
            </div>

            <!-- Grafik Lingkaran / Donut Komposisi Status -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-xs font-bold text-gray-700 uppercase flex items-center gap-1.5">
                        <span>🍩</span> Grafik Lingkaran Komposisi Status
                    </h3>
                    <span class="text-[10px] text-emerald-600 font-bold" id="todayDateLabel">Hari Ini</span>
                </div>
                <div class="h-56 relative flex items-center justify-center">
                    <canvas id="chartStatusComposition"></canvas>
                </div>
            </div>
        </div>

        <!-- MODE TABS PERIODE: HARIAN / MINGGUAN / 1 BULAN PENUH -->
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
            <div class="inline-flex p-1 bg-slate-200/80 rounded-2xl shadow-inner border border-slate-300/60" id="rekapModeTabs">
                <button type="button" onclick="setRekapMode('DAILY')" id="btnTabDaily" class="px-5 py-2 rounded-xl text-xs font-black transition-all shadow-xs bg-white text-indigo-700 cursor-pointer">
                    📅 Rekap Harian
                </button>
                <button type="button" onclick="setRekapMode('WEEKLY')" id="btnTabWeekly" class="px-5 py-2 rounded-xl text-xs font-black transition-all text-slate-600 hover:text-indigo-700 cursor-pointer">
                    🗓️ Rekap Mingguan (7 Hari)
                </button>
                <button type="button" onclick="setRekapMode('MONTHLY')" id="btnTabMonthly" class="px-5 py-2 rounded-xl text-xs font-black transition-all text-slate-600 hover:text-indigo-700 cursor-pointer">
                    📆 Rekap 1 Bulan Penuh
                </button>
            </div>

            <!-- Periode Active Indicator -->
            <div class="flex items-center gap-2 bg-indigo-50 border border-indigo-200/80 px-3.5 py-1.5 rounded-xl shadow-xs">
                <span class="w-2 h-2 rounded-full bg-indigo-600 animate-ping"></span>
                <span class="text-xs font-bold text-indigo-900" id="activePeriodeLabel">Periode: Hari Ini</span>
            </div>
        </div>

        <!-- KPI SUMMARY KINERJA PERIODE (Khusus Mingguan & Bulanan) -->
        <div id="periodeKpiBanner" class="hidden mb-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-3.5 rounded-2xl shadow-sm border border-indigo-800 text-center">
                <p class="text-[10px] font-bold uppercase text-indigo-200">🗓️ Hari Efektif KBM</p>
                <p class="text-2xl font-black mt-1" id="kpiHariEfektif">0 Hari</p>
                <span class="text-[10px] text-indigo-300">Bukan libur/Minggu</span>
            </div>
            <div class="bg-emerald-50 border border-emerald-200 p-3.5 rounded-2xl shadow-sm text-center">
                <p class="text-[10px] font-black uppercase text-emerald-700">📈 % Kehadiran Total</p>
                <p class="text-2xl font-black text-emerald-700 mt-1" id="kpiKehadiranPct">0%</p>
                <span class="text-[10px] text-emerald-600 font-semibold" id="kpiKehadiranSub">Hadir + Terlambat</span>
            </div>
            <div class="bg-amber-50 border border-amber-200 p-3.5 rounded-2xl shadow-sm text-center">
                <p class="text-[10px] font-black uppercase text-amber-700">⏰ Kasus Terlambat</p>
                <p class="text-2xl font-black text-amber-700 mt-1" id="kpiTerlambatKasus">0x</p>
                <span class="text-[10px] text-amber-600 font-semibold" id="kpiLateMinutesTotal">Total: 0 menit</span>
            </div>
            <div class="bg-red-50 border border-red-200 p-3.5 rounded-2xl shadow-sm text-center">
                <p class="text-[10px] font-black uppercase text-red-700">❌ Total Alfa (Alpa)</p>
                <p class="text-2xl font-black text-red-700 mt-1" id="kpiAlfaTotal">0</p>
                <span class="text-[10px] text-red-600 font-semibold" id="kpiAlfaPct">0% dari slot KBM</span>
            </div>
            <div class="bg-purple-50 border border-purple-200 p-3.5 rounded-2xl shadow-sm text-center">
                <p class="text-[10px] font-black uppercase text-purple-700">🟣 Sakit (Surat/UKS)</p>
                <p class="text-2xl font-black text-purple-700 mt-1" id="kpiSakitTotal">0</p>
                <span class="text-[10px] text-purple-600 font-semibold" id="kpiSakitPct">0%</span>
            </div>
            <div class="bg-blue-50 border border-blue-200 p-3.5 rounded-2xl shadow-sm text-center">
                <p class="text-[10px] font-black uppercase text-blue-700">🔵 Izin & Dispen</p>
                <p class="text-2xl font-black text-blue-700 mt-1" id="kpiIzinTotal">0</p>
                <span class="text-[10px] text-blue-600 font-semibold" id="kpiIzinPct">0%</span>
            </div>
        </div>

        <!-- Filter Controls & Export Toolbar -->
        <div class="bg-white rounded-2xl shadow-sm p-4 mb-6 border border-slate-200 flex flex-wrap justify-between items-center gap-4">
            <div class="flex flex-wrap items-center gap-3">
                <!-- Date Picker (DAILY & WEEKLY) -->
                <div id="containerDateInput">
                    <label class="block text-xs font-bold text-gray-600 mb-1" id="labelDateInput">📅 Tanggal Presensi</label>
                    <input type="date" id="filterDate" class="border p-2 rounded-xl text-xs font-semibold bg-white" onchange="loadRekap()">
                </div>

                <!-- Month & Year Pickers (MONTHLY) -->
                <div id="containerMonthInput" class="hidden flex items-center gap-2">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">📆 Pilih Bulan</label>
                        <select id="filterMonth" class="border p-2 rounded-xl text-xs font-bold bg-white" onchange="loadRekap()">
                            <option value="1">Januari</option>
                            <option value="2">Februari</option>
                            <option value="3">Maret</option>
                            <option value="4">April</option>
                            <option value="5">Mei</option>
                            <option value="6">Juni</option>
                            <option value="7">Juli</option>
                            <option value="8">Agustus</option>
                            <option value="9">September</option>
                            <option value="10">Oktober</option>
                            <option value="11">November</option>
                            <option value="12">Desember</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Tahun</label>
                        <select id="filterYear" class="border p-2 rounded-xl text-xs font-bold bg-white" onchange="loadRekap()">
                            <option value="2025">2025</option>
                            <option value="2026" selected>2026</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                </div>

                <!-- Direct Class Selector (Selalu Muncul) -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">🏫 Pilih Kelas / Rombel</label>
                    <select id="filterClass" class="border border-indigo-300 p-2 rounded-xl text-xs font-bold bg-white text-indigo-900 shadow-sm" onchange="onClassFilterChange()">
                        <option value="ALL">🌐 Semua Kelas (Seluruh Siswa)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">🎯 Jenjang / Tingkat</label>
                    <select id="filterScope" class="border p-2 rounded-xl text-xs font-bold bg-slate-50 text-slate-800" onchange="onScopeChange()">
                        <option value="ALL" selected>Semua Jenjang</option>
                        <option value="GRADE">Pilih Per Jenjang</option>
                    </select>
                </div>
                <div id="containerGradeSelect" class="hidden">
                    <label class="block text-xs font-bold text-gray-600 mb-1">Tingkat</label>
                    <select id="filterGrade" class="border p-2 rounded-xl text-xs font-semibold" onchange="loadRekap()">
                        <option value="VII">Tingkat VII (Kelas 7)</option>
                        <option value="VIII">Tingkat VIII (Kelas 8)</option>
                        <option value="IX">Tingkat IX (Kelas 9)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">🔍 Cari Nama / NISN / Kelas</label>
                    <input type="text" id="searchInput" placeholder="Nama, NISN, atau kelas (mis: VII B)..." class="border p-2 rounded-xl text-xs w-56 font-medium" oninput="filterLocal()">
                </div>
            </div>

            <!-- Export Buttons -->
            <div class="flex flex-wrap items-center gap-2">
                <button onclick="downloadExcelRekap('xls')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer" title="Unduh File Excel Format Asli .xls">
                    <span>📊</span> Unduh Excel (.xls)
                </button>
                <button onclick="downloadExcelRekap('csv')" class="bg-teal-700 hover:bg-teal-800 text-white px-3 py-2 rounded-xl text-xs font-bold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer" title="Unduh CSV UTF-8">
                    <span>📑</span> Unduh CSV
                </button>
                <button onclick="downloadPdfRekap()" class="bg-slate-800 hover:bg-black text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer">
                    <span>📄</span> Cetak PDF Resmi (KOP)
                </button>
                <button onclick="triggerNotifyUnscannedAdmin()" class="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer" title="Kirim peringatan ke orang tua dan tetapkan ALPA bagi siswa yang belum scan">
                    <span>🔔</span> Tetapkan Alpa &amp; Notif
                </button>
                <button onclick="loadRekap()" class="bg-indigo-50 text-indigo-700 hover:bg-indigo-100 px-3.5 py-2 rounded-xl text-xs font-bold border border-indigo-200 cursor-pointer">
                    ⟳ Refresh
                </button>
            </div>
        </div>

        <!-- Quick Class Selection Pills (Interactive Chips) -->
        <div class="bg-indigo-50/70 border border-indigo-200/80 rounded-2xl p-3 mb-6 flex flex-col gap-2 shadow-xs">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-black text-indigo-950 uppercase tracking-wider flex items-center gap-1.5">
                        <span>🏷️</span> Filter Cepat Kelas:
                    </span>
                    <span class="bg-indigo-600 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-xs" id="activeClassLabelBadge">Semua Kelas</span>
                </div>
                <span class="text-[11px] text-slate-500 font-medium">Klik tombol kelas di bawah untuk memfilter rekapitulasi kelas tertentu secara instan</span>
            </div>
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs" id="quickClassPills">
                <button type="button" onclick="selectClass('ALL')" class="pill-class-btn px-3 py-1.5 rounded-xl font-bold bg-indigo-600 text-white shadow-xs transition cursor-pointer" data-class="ALL">
                    🌐 Semua Kelas
                </button>
            </div>
        </div>

        <!-- Attendance Table -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-slate-200 flex flex-col">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 text-xs uppercase tracking-wider font-extrabold border-b" id="tableHeaderRow">
                            <th class="p-4 border-b">No</th>
                            <th class="p-4 border-b">Nama Siswa</th>
                            <th class="p-4 border-b">NISN / NIS</th>
                            <th class="p-4 border-b">Kelas</th>
                            <th class="p-4 border-b">Jam Masuk</th>
                            <th class="p-4 border-b">Jam Pulang</th>
                            <th class="p-4 border-b">Metode</th>
                            <th class="p-4 border-b">Status</th>
                            <th class="p-4 border-b">📍 Koordinat GPS</th>
                            <th class="p-4 border-b">Keterangan</th>
                            <th class="p-4 border-b text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="rekapTableBody">
                        <tr><td colspan="11" class="p-4 text-center text-gray-500">Memuat data absensi...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-wrap justify-between items-center gap-3 text-sm text-gray-600">
                <span id="pageInfo" class="font-medium text-xs">Menampilkan 0-0 dari 0 siswa</span>
                <div class="flex items-center gap-1">
                    <button onclick="prevPage()" class="px-2.5 py-1.5 bg-gray-200 rounded-lg hover:bg-gray-300 disabled:opacity-40 font-medium text-xs transition" id="btnPrev">◀ Sebelumnya</button>
                    <div id="pageNumberButtons" class="flex items-center gap-1"></div>
                    <button onclick="nextPage()" class="px-2.5 py-1.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:opacity-40 font-medium text-xs transition shadow-sm" id="btnNext">Selanjutnya ▶</button>
                </div>
            </div>
        </div>
    </main>
    </main>

    <!-- Modal Input Manual -->
    <div id="modalManual" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-2xl">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <h2 class="text-lg font-bold text-gray-800">Input Presensi Manual</h2>
                <button onclick="document.getElementById('modalManual').classList.add('hidden')" class="text-gray-400 text-2xl font-bold">&times;</button>
            </div>
            <form id="manualAttendanceForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Cari & Pilih Siswa *</label>
                    <div class="grid grid-cols-2 gap-2 mb-2">
