    <script>
        const token = localStorage.getItem('token') || '';
        if(!token) window.location.href = '/';

        let rekapRecords = [];
        let filteredRecords = [];
        let currentPage = 1;
        const rowsPerPage = 50;

        let currentRekapMode = 'DAILY'; // 'DAILY' | 'WEEKLY' | 'MONTHLY'
        let currentPeriodeData = null;

        // Helper Standar Pengurutan Jenjang & Rombel Kelas (VII -> VIII -> IX)
        function getClassRank(className) {
            const raw = (className || '').trim();
            if (!raw) return { grade: 999, suffix: '' };
            const upper = raw.toUpperCase();
            if (upper.startsWith('VIII') || upper.startsWith('8') || /\bVIII\b/.test(upper)) {
                return { grade: 8, suffix: upper.replace(/^.*?VIII[-_ ]?/, '').replace(/^.*?8[-_ ]?/, '').trim() };
            }
            if (upper.startsWith('VII') || upper.startsWith('7') || /\bVII\b/.test(upper)) {
                return { grade: 7, suffix: upper.replace(/^.*?VII[-_ ]?/, '').replace(/^.*?7[-_ ]?/, '').trim() };
            }
            if (upper.startsWith('IX') || upper.startsWith('9') || /\bIX\b/.test(upper)) {
                return { grade: 9, suffix: upper.replace(/^.*?IX[-_ ]?/, '').replace(/^.*?9[-_ ]?/, '').trim() };
            }
            if (upper.startsWith('X') || upper.startsWith('10') || /\bX\b/.test(upper)) {
                return { grade: 10, suffix: upper.replace(/^.*?X[-_ ]?/, '').replace(/^.*?10[-_ ]?/, '').trim() };
            }
            if (upper.startsWith('XI') || upper.startsWith('11') || /\bXI\b/.test(upper)) {
                return { grade: 11, suffix: upper.replace(/^.*?XI[-_ ]?/, '').replace(/^.*?11[-_ ]?/, '').trim() };
            }
            if (upper.startsWith('XII') || upper.startsWith('12') || /\bXII\b/.test(upper)) {
                return { grade: 12, suffix: upper.replace(/^.*?XII[-_ ]?/, '').replace(/^.*?12[-_ ]?/, '').trim() };
            }
            return { grade: 99, suffix: upper };
        }

        function compareClassNames(classA, classB) {
            const a = (classA || '').trim();
            const b = (classB || '').trim();
            if (!a && !b) return 0;
            if (!a) return 1;
            if (!b) return -1;
            const rankA = getClassRank(a);
            const rankB = getClassRank(b);
            if (rankA.grade !== rankB.grade) return rankA.grade - rankB.grade;
            return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
        }

        // Set default date & month
        const todayDateObj = new Date();
        document.getElementById('filterDate').value = todayDateObj.toISOString().split('T')[0];
        if (document.getElementById('filterMonth')) {
            document.getElementById('filterMonth').value = todayDateObj.getMonth() + 1;
        }
        if (document.getElementById('filterYear')) {
            document.getElementById('filterYear').value = todayDateObj.getFullYear();
        }

        function setRekapMode(mode) {
            currentRekapMode = mode;
            const btnDaily = document.getElementById('btnTabDaily');
            const btnWeekly = document.getElementById('btnTabWeekly');
            const btnMonthly = document.getElementById('btnTabMonthly');

            const containerDate = document.getElementById('containerDateInput');
            const containerMonth = document.getElementById('containerMonthInput');
            const labelDate = document.getElementById('labelDateInput');

            // Reset buttons
            [btnDaily, btnWeekly, btnMonthly].forEach(b => {
                b.className = 'px-5 py-2 rounded-xl text-xs font-black transition-all text-slate-600 hover:text-indigo-700 cursor-pointer';
            });

            if (mode === 'DAILY') {
                btnDaily.className = 'px-5 py-2 rounded-xl text-xs font-black transition-all shadow-xs bg-white text-indigo-700 cursor-pointer';
                containerDate.classList.remove('hidden');
                containerMonth.classList.add('hidden');
                labelDate.innerText = '📅 Tanggal Presensi';
            } else if (mode === 'WEEKLY') {
                btnWeekly.className = 'px-5 py-2 rounded-xl text-xs font-black transition-all shadow-xs bg-white text-indigo-700 cursor-pointer';
                containerDate.classList.remove('hidden');
                containerMonth.classList.add('hidden');
                labelDate.innerText = '🗓️ Tanggal Acuan (Minggu ini)';
            } else if (mode === 'MONTHLY') {
                btnMonthly.className = 'px-5 py-2 rounded-xl text-xs font-black transition-all shadow-xs bg-white text-indigo-700 cursor-pointer';
                containerDate.classList.add('hidden');
                containerMonth.classList.remove('hidden');
            }

            loadRekap();
        }

        function onScopeChange() {
            const scope = document.getElementById('filterScope').value;
            const containerGrade = document.getElementById('containerGradeSelect');

            if (scope === 'GRADE') {
                containerGrade.classList.remove('hidden');
                document.getElementById('filterClass').value = 'ALL';
                updatePillsActive('ALL');
            } else {
                containerGrade.classList.add('hidden');
            }
            loadRekap();
        }

        function selectClass(className) {
            const sel = document.getElementById('filterClass');
            if (sel) sel.value = className;

            const badge = document.getElementById('activeClassLabelBadge');
            if (badge) {
                badge.innerText = className === 'ALL' ? 'Semua Kelas' : 'Kelas ' + className;
            }

            if (className !== 'ALL') {
                const scopeEl = document.getElementById('filterScope');
                if (scopeEl) scopeEl.value = 'ALL';
                document.getElementById('containerGradeSelect')?.classList.add('hidden');
            }

            updatePillsActive(className);
            loadRekap();
        }

        function onClassFilterChange() {
            const val = document.getElementById('filterClass').value;
            selectClass(val);
        }

        function updatePillsActive(selectedClass) {
            const pills = document.querySelectorAll('.pill-class-btn');
            pills.forEach(p => {
                const c = p.getAttribute('data-class');
                if (c === selectedClass) {
                    p.className = 'pill-class-btn px-3 py-1.5 rounded-xl font-bold bg-indigo-600 text-white shadow-xs transition cursor-pointer';
                } else {
                    p.className = 'pill-class-btn px-3 py-1.5 rounded-xl font-bold bg-white text-slate-700 hover:bg-indigo-100 hover:text-indigo-800 border border-slate-200 transition cursor-pointer whitespace-nowrap';
                }
            });
        }

        let globalClassList = [];
        async function loadClasses() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(Array.isArray(data)) {
                    globalClassList = data;
                    const sel = document.getElementById('filterClass');
                    sel.innerHTML = '<option value="ALL">🌐 Semua Kelas (Seluruh Siswa)</option>';

                    const pillsContainer = document.getElementById('quickClassPills');
                    if (pillsContainer) {
                        pillsContainer.innerHTML = `
                            <button type="button" onclick="selectClass('ALL')" class="pill-class-btn px-3 py-1.5 rounded-xl font-bold bg-indigo-600 text-white shadow-xs transition cursor-pointer" data-class="ALL">
                                🌐 Semua Kelas
                            </button>
                        `;
                    }

                    // Selalu urutkan kelas diawali dari jenjang VII, VIII, lalu IX
                    const sorted = [...data].sort((a, b) => compareClassNames(a.nama || a.name, b.nama || b.name));

                    sorted.forEach(k => {
                        const cName = k.nama || k.name;
                        sel.innerHTML += '<option value="' + cName + '">Kelas ' + cName + '</option>';
                        if (pillsContainer) {
                            pillsContainer.innerHTML += `
                                <button type="button" onclick="selectClass('${cName}')" class="pill-class-btn px-3 py-1.5 rounded-xl font-bold bg-white text-slate-700 hover:bg-indigo-100 hover:text-indigo-800 border border-slate-200 transition cursor-pointer whitespace-nowrap" data-class="${cName}">
                                    ${cName}
                                </button>
                            `;
                        }
                    });

                    sel.value = 'ALL';
                }
            } catch(e) {}
        }

        async function loadRekap() {
            const selectedClass = document.getElementById('filterClass')?.value || 'ALL';
            const scope = document.getElementById('filterScope')?.value || 'ALL';
            let grade = '';

            let queryUrl = '';
            let queryParams = [];

            if (currentRekapMode === 'DAILY') {
                const date = document.getElementById('filterDate').value;
                queryUrl = '/api/attendance/rekap';
                queryParams.push('date=' + encodeURIComponent(date));
            } else if (currentRekapMode === 'WEEKLY') {
                const date = document.getElementById('filterDate').value;
                queryUrl = '/api/attendance/rekap-periode';
                queryParams.push('mode=WEEKLY');
                queryParams.push('date=' + encodeURIComponent(date));
            } else {
                // MONTHLY
                const m = document.getElementById('filterMonth').value;
                const y = document.getElementById('filterYear').value;
                queryUrl = '/api/attendance/rekap-periode';
                queryParams.push('mode=MONTHLY');
                queryParams.push('month=' + encodeURIComponent(m));
                queryParams.push('year=' + encodeURIComponent(y));
            }

            if (selectedClass !== 'ALL') {
                queryParams.push('scope=CLASS');
                queryParams.push('className=' + encodeURIComponent(selectedClass));
            } else if (scope === 'GRADE') {
                grade = document.getElementById('filterGrade').value;
                queryParams.push('scope=GRADE');
                queryParams.push('grade=' + encodeURIComponent(grade));
            } else {
                queryParams.push('scope=ALL');
            }

            const finalUrl = queryUrl + '?' + queryParams.join('&');

            try {
                const res = await fetch(finalUrl, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if(data && (data.records || Array.isArray(data))) {
                    rekapRecords = (data.records || []).sort((a, b) => compareClassNames(a.className, b.className) || (a.name || '').localeCompare(b.name || ''));
                    filteredRecords = [...rekapRecords];
                    currentPeriodeData = data;

                    // Update label active periode
                    const labelBadge = document.getElementById('activePeriodeLabel');
                    if (labelBadge) {
                        if (currentRekapMode === 'DAILY') {
                            const dVal = document.getElementById('filterDate').value;
                            labelBadge.innerText = `Periode Harian: ${dVal}`;
                        } else {
                            labelBadge.innerText = `Periode: ${data.periodeLabel || 'Aktif'}`;
                        }
                    }

                    // Tampilkan / Sembunyikan KPI Banner periode
                    const kpiBanner = document.getElementById('periodeKpiBanner');
                    if (kpiBanner) {
                        if (currentRekapMode === 'DAILY') {
                            kpiBanner.classList.add('hidden');
                        } else {
                            kpiBanner.classList.remove('hidden');
                            const counts = data.counts || {};
                            document.getElementById('kpiHariEfektif').innerText = `${data.hariEfektif || counts.hariEfektif || 0} Hari`;
                            document.getElementById('kpiKehadiranPct').innerText = `${counts.kehadiranPct || 0}%`;
                            document.getElementById('kpiTerlambatKasus').innerText = `${counts.totalTerlambatKasus || counts.T || 0}x`;
                            document.getElementById('kpiLateMinutesTotal').innerText = `Total: ${counts.totalLateMinutes || 0} menit`;
                            document.getElementById('kpiAlfaTotal').innerText = `${counts.A || 0}x`;
                            document.getElementById('kpiAlfaPct').innerText = `${counts.alfaPct || 0}% dari slot KBM`;
                            document.getElementById('kpiSakitTotal').innerText = `${counts.S || 0}x`;
                            document.getElementById('kpiSakitPct').innerText = `${counts.sakitPct || 0}%`;
                            document.getElementById('kpiIzinTotal').innerText = `${(counts.I || 0) + (counts.D || 0)}x`;
                            document.getElementById('kpiIzinPct').innerText = `${counts.izinPct || 0}%`;
                        }
                    }

                    // Check Holiday Banner (Hanya di mode DAILY)
                    const holidayBanner = document.getElementById('holidayBanner');
                    if (holidayBanner) {
                        if (currentRekapMode === 'DAILY' && data.isHoliday && data.holiday) {
                            holidayBanner.classList.remove('hidden');
                            document.getElementById('holidayBannerTitle').innerText = data.holiday.name || 'Hari Libur Sekolah';
                            document.getElementById('holidayBannerDesc').innerText = (data.holiday.description || 'Hari libur resmi sekolah') + '. Seluruh siswa yang tidak scan barcode tercatat sebagai [LBR] Libur.';
                        } else {
                            holidayBanner.classList.add('hidden');
                        }
                    }

                    // Update 11 status cards + total
                    const c = data.counts || {};
                    if(document.getElementById('statTotal')) document.getElementById('statTotal').innerText = c.totalStudents || c.total || 0;
                    if(document.getElementById('statH')) document.getElementById('statH').innerText = c.H ?? (c.present || 0);
                    if(document.getElementById('statUnconfirmedOut')) document.getElementById('statUnconfirmedOut').innerText = c.unconfirmedOut ?? c.NO_OUT ?? 0;
                    if(document.getElementById('statT')) document.getElementById('statT').innerText = c.T ?? (c.late || 0);
                    if(document.getElementById('statS')) document.getElementById('statS').innerText = c.S ?? (c.sick || 0);
                    if(document.getElementById('statI')) document.getElementById('statI').innerText = c.I ?? (c.permission || 0);
                    if(document.getElementById('statA')) document.getElementById('statA').innerText = c.A ?? (c.absent || 0);
                    if(document.getElementById('statD')) document.getElementById('statD').innerText = c.D || 0;
                    if(document.getElementById('statU')) document.getElementById('statU').innerText = c.U || 0;
                    if(document.getElementById('statP')) document.getElementById('statP').innerText = c.P || 0;
                    if(document.getElementById('statL')) document.getElementById('statL').innerText = c.L || 0;
                    if(document.getElementById('statB')) document.getElementById('statB').innerText = c.B || 0;
                    if(document.getElementById('statLBR')) document.getElementById('statLBR').innerText = c.LBR || 0;

                    // Render Visualizations Real
                    renderCharts(c, data);

                    // Populate manual user dropdown & filter classes
                    const classSelect = document.getElementById('filterManualRekapClass');
                    const classSet = new Set();
                    rekapRecords.forEach(s => {
                        if(s.className) classSet.add(s.className);
                    });

                    if(classSelect && classSelect.children.length <= 1) {
                        classSelect.innerHTML = '<option value="ALL">Semua Kelas</option>';
                        Array.from(classSet).sort(compareClassNames).forEach(c => {
                            classSelect.innerHTML += '<option value="' + c + '">Kelas ' + c + '</option>';
                        });
                    }

                    filterManualRekapUsers();
                    currentPage = 1;
                    if (document.getElementById('searchInput')?.value.trim()) {
                        filterLocal();
                    } else {
                        renderTable();
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        let chartMonthly = null;
        let chartDonut = null;

        function renderCharts(counts, rawData) {
            if (typeof Chart === 'undefined') return;

            // 1. Grafik Batang Tren Real (Harian / Komparasi Kelas / Bulanan)
            const canvasMonthly = document.getElementById('chartMonthlyAttendance');
            if (canvasMonthly) {
                const ctxMonthly = canvasMonthly.getContext('2d');
                if (chartMonthly) chartMonthly.destroy();

                let labels = [];
                let dataValues = [];
                let chartTitle = 'Tingkat Kehadiran (%)';

                if (currentRekapMode === 'MONTHLY' && Array.isArray(rawData.classComparison) && rawData.classComparison.length > 0) {
                    labels = rawData.classComparison.map(c => c.className);
                    dataValues = rawData.classComparison.map(c => c.presenceRate);
                    chartTitle = 'Komparasi % Kehadiran per Rombel Kelas';
                } else if (currentRekapMode === 'WEEKLY' && Array.isArray(rawData.dailyTrends) && rawData.dailyTrends.length > 0) {
                    labels = rawData.dailyTrends.map(d => d.label);
                    dataValues = rawData.dailyTrends.map(d => d.rate);
                    chartTitle = 'Tren Kehadiran Harian Minggu Ini (%)';
                } else if (Array.isArray(rawData.monthlyStats) && rawData.monthlyStats.length > 0) {
                    labels = rawData.monthlyStats.map(m => m.month);
                    dataValues = rawData.monthlyStats.map(m => (m.rate !== undefined ? m.rate : (m.hadirRate !== undefined ? m.hadirRate : 0)));
                } else {
                    labels = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
                    dataValues = [95, 96, 94, 98, 92, 95];
                }

                chartMonthly = new Chart(ctxMonthly, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: chartTitle,
                            data: dataValues,
                            backgroundColor: '#4F46E5', // Indigo-600
                            borderRadius: 8,
                            maxBarThickness: 36
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                ticks: {
                                    callback: function(value) { return value + '%'; }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // 2. Status Composition Donut Chart
            const canvasDonut = document.getElementById('chartStatusComposition');
            if (canvasDonut) {
                const ctxDonut = canvasDonut.getContext('2d');
                if (chartDonut) chartDonut.destroy();

                const statusLabels = [
                    'Hadir [H]', 'Terlambat [T]', 'Sakit [S]', 'Izin [I]', 'Alfa [A]',
                    'Dispensasi [D]', 'UKS [U]', 'Pulang [P]', 'Tugas Luar [L]', 'Bolos [B]', 'Libur [LBR]'
                ];
                const statusData = [
                    counts?.H || 0,
                    counts?.T || 0,
                    counts?.S || 0,
                    counts?.I || 0,
                    counts?.A || 0,
                    counts?.D || 0,
                    counts?.U || 0,
                    counts?.P || 0,
                    counts?.L || 0,
                    counts?.B || 0,
                    counts?.LBR || 0
                ];
                const statusColors = [
                    '#10B981', // H Hadir
                    '#F59E0B', // T Terlambat
                    '#8B5CF6', // S Sakit
                    '#3B82F6', // I Izin
                    '#EF4444', // A Alfa
                    '#F97316', // D Dispensasi
                    '#06B6D4', // U UKS
                    '#64748B', // P Pulang
                    '#D97706', // L Luar
                    '#991B1B', // B Bolos
                    '#0D9488'  // LBR Libur
                ];

                const isAllZero = statusData.every(v => !v || v === 0);
                const finalData = isAllZero ? [1] : statusData;
                const finalColors = isAllZero ? ['#E2E8F0'] : statusColors;
                const finalLabels = isAllZero ? ['Belum ada aktivitas'] : statusLabels;

                chartDonut = new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: {
                        labels: finalLabels,
                        datasets: [{
                            data: finalData,
                            backgroundColor: finalColors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 9,
                                    font: { size: 9 }
                                }
                            }
                        }
                    }
                });
            }
        }

        function filterManualRekapUsers() {
            const classFilter = document.getElementById('filterManualRekapClass')?.value || 'ALL';
            const searchQuery = (document.getElementById('searchManualRekapUser')?.value || '').toLowerCase().trim();
            const selUser = document.getElementById('manualUserId');
            if(!selUser || !Array.isArray(rekapRecords)) return;

            const filtered = rekapRecords.filter(s => {
                const matchesClass = (classFilter === 'ALL' || (s.className && s.className.toUpperCase() === classFilter.toUpperCase()));
                const nameStr = (s.name || '').toLowerCase();
                const nisnStr = (s.nisn || '').toLowerCase();
                return matchesClass && (!searchQuery || nameStr.includes(searchQuery) || nisnStr.includes(searchQuery));
            });

            selUser.innerHTML = '<option value="">Pilih Siswa (' + filtered.length + ' Ditemukan)</option>';
            filtered.forEach(s => {
                selUser.innerHTML += '<option value="' + (s.userId || s.id) + '">' + s.name + ' (' + s.className + ') - ' + s.nisn + '</option>';
            });

            const countEl = document.getElementById('manualRekapCount');
            if(countEl) {
                countEl.innerText = filtered.length + ' siswa ditemukan';
            }
        }

        function normalizeKey(str) {
            return (str || '').toString().toLowerCase().replace(/kelas/g, '').replace(/tingkat/g, '').replace(/[\s\-_]/g, '');
        }

        function filterLocal() {
            const rawQ = (document.getElementById('searchInput').value || '').trim();
            if (!rawQ) {
                filteredRecords = [...rekapRecords];
                currentPage = 1;
                renderTable();
                return;
            }

            const qLower = rawQ.toLowerCase();
            const qNorm = normalizeKey(rawQ);

            filteredRecords = rekapRecords.filter(r => {
                const nameLower = (r.name || '').toLowerCase();
                const nisnLower = (r.nisn || '').toLowerCase();
                const classLower = (r.className || '').toLowerCase();
                const classNorm = normalizeKey(r.className);

                return nameLower.includes(qLower) || 
                       nisnLower.includes(qLower) || 
                       classLower.includes(qLower) || 
                       (qNorm && classNorm.includes(qNorm));
            });
            currentPage = 1;
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('rekapTableBody');
            const theadRow = document.getElementById('tableHeaderRow');
            tbody.innerHTML = '';

            const isMultiPeriod = currentRekapMode === 'WEEKLY' || currentRekapMode === 'MONTHLY';

            // Update Header Tabel Sesuai Mode
            if (isMultiPeriod) {
                theadRow.innerHTML = `
                    <th class="p-3.5 border-b">No</th>
                    <th class="p-3.5 border-b">Nama Siswa</th>
                    <th class="p-3.5 border-b">NISN</th>
                    <th class="p-3.5 border-b">Kelas</th>
                    <th class="p-3.5 border-b text-center text-emerald-700">[H] Hadir</th>
                    <th class="p-3.5 border-b text-center text-amber-700">[T] Terlambat</th>
                    <th class="p-3.5 border-b text-center text-purple-700">[S] Sakit</th>
                    <th class="p-3.5 border-b text-center text-blue-700">[I] Izin</th>
                    <th class="p-3.5 border-b text-center text-red-700">[A] Alfa</th>
                    <th class="p-3.5 border-b text-center text-amber-800">Menit Telat</th>
                    <th class="p-3.5 border-b text-center">% Kehadiran</th>
                    <th class="p-3.5 border-b text-center">Aksi / Rincian</th>
                `;
            } else {
                theadRow.innerHTML = `
                    <th class="p-4 border-b">No</th>
                    <th class="p-4 border-b">Nama Siswa</th>
                    <th class="p-4 border-b">NISN / NIS</th>
                    <th class="p-4 border-b">Kelas</th>
                    <th class="p-4 border-b">Jam Masuk</th>
                    <th class="p-4 border-b">Jam Pulang</th>
                    <th class="p-4 border-b">Metode</th>
                    <th class="p-4 border-b">Status</th>
                    <th class="p-4 border-b">📍 Koordinat GPS</th>
                    <th class="p-4 border-b">Keterangan</th>
                    <th class="p-4 border-b text-center">Aksi</th>
                `;
            }

            if(filteredRecords.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${isMultiPeriod ? 12 : 11}" class="p-6 text-center text-gray-500 font-semibold">Tidak ada data presensi ditemukan untuk kriteria ini</td></tr>`;
                document.getElementById('pageInfo').innerText = '0 siswa';
                document.getElementById('btnPrev').disabled = true;
                document.getElementById('btnNext').disabled = true;
                return;
            }

            const totalPages = Math.max(1, Math.ceil(filteredRecords.length / rowsPerPage));
            if(currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            const paginatedData = filteredRecords.slice(start, end);

            paginatedData.forEach((r, idx) => {
                if (isMultiPeriod) {
                    // Tampilan Baris Rekap Multi-Periode (Mingguan / Bulanan)
                    const pRate = r.presenceRate !== undefined ? r.presenceRate : 0;
                    let rateBadgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                    if (pRate < 75) rateBadgeClass = 'bg-red-100 text-red-800 border-red-300';
                    else if (pRate < 85) rateBadgeClass = 'bg-amber-100 text-amber-800 border-amber-300';

                    tbody.innerHTML += `
                        <tr class="hover:bg-indigo-50/50 border-b text-xs transition-colors">
                            <td class="p-3 text-gray-500 font-semibold">${start + idx + 1}</td>
                            <td class="p-3 font-bold text-gray-900">${r.name || '-'}</td>
                            <td class="p-3 font-mono text-gray-600">${r.nisn || '-'}</td>
                            <td class="p-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded font-bold border border-indigo-200">${r.className || '-'}</span></td>
                            <td class="p-3 text-center font-bold text-emerald-700 bg-emerald-50/50">${r.H || 0}</td>
                            <td class="p-3 text-center font-bold text-amber-700 bg-amber-50/50">${r.T || 0}</td>
                            <td class="p-3 text-center font-bold text-purple-700 bg-purple-50/50">${r.S || 0}</td>
                            <td class="p-3 text-center font-bold text-blue-700 bg-blue-50/50">${r.I || 0}</td>
                            <td class="p-3 text-center font-bold text-red-700 bg-red-50/50">${r.A || 0}</td>
                            <td class="p-3 text-center font-mono font-bold text-amber-800">${r.lateMinutes ? r.lateMinutes + 'm' : '-'}</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full font-black border text-[11px] ${rateBadgeClass}">${pRate}%</span>
                            </td>
                            <td class="p-3 text-center">
                                <button onclick="openDetailSiswaModal('${r.userId || r.id}', '${escape(r.name || '')}', '${r.className || ''}', '${r.nisn || ''}')" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg shadow-xs transition cursor-pointer flex items-center gap-1 mx-auto">
                                    <span>📋</span> Rincian
                                </button>
                            </td>
                        </tr>
                    `;
                } else {
                    // Tampilan Baris Rekap Harian (Detail Gate-In & Gate-Out)
                    let badge = '<span class="bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full text-xs font-semibold">Belum Presensi</span>';
                    const code = r.statusCode || '';
                    if(code === 'H' || r.status === 'PRESENT') {
                        badge = '<span class="bg-emerald-100 text-emerald-800 border border-emerald-300 px-2.5 py-1 rounded-full text-xs font-bold">[H] Hadir</span>';
                    } else if(code === 'T' || r.status === 'LATE') {
                        badge = '<span class="bg-amber-100 text-amber-800 border border-amber-300 px-2.5 py-1 rounded-full text-xs font-bold">[T] Terlambat</span>';
                    } else if(code === 'S' || r.status === 'SICK') {
                        badge = '<span class="bg-purple-100 text-purple-800 border border-purple-300 px-2.5 py-1 rounded-full text-xs font-bold">[S] Sakit</span>';
                    } else if(code === 'I' || r.status === 'PERMISSION') {
                        badge = '<span class="bg-blue-100 text-blue-800 border border-blue-300 px-2.5 py-1 rounded-full text-xs font-bold">[I] Izin</span>';
                    } else if(code === 'A' || r.status === 'ABSENT') {
                        badge = '<span class="bg-red-100 text-red-800 border border-red-300 px-2.5 py-1 rounded-full text-xs font-bold">[A] Alfa</span>';
                    } else if(code === 'D' || r.status === 'DISPENSATION') {
                        badge = '<span class="bg-orange-100 text-orange-800 border border-orange-300 px-2.5 py-1 rounded-full text-xs font-bold">[D] Dispensasi</span>';
                    } else if(code === 'U' || r.status === 'UKS') {
                        badge = '<span class="bg-cyan-100 text-cyan-800 border border-cyan-300 px-2.5 py-1 rounded-full text-xs font-bold">[U] UKS</span>';
                    } else if(code === 'P' || r.status === 'EARLY_LEAVE') {
                        badge = '<span class="bg-slate-200 text-slate-800 border border-slate-300 px-2.5 py-1 rounded-full text-xs font-bold">[P] Pulang</span>';
                    } else if(code === 'L' || r.status === 'OUTDOOR_ASSIGNMENT') {
                        badge = '<span class="bg-yellow-100 text-yellow-900 border border-yellow-300 px-2.5 py-1 rounded-full text-xs font-bold">[L] Tugas Luar</span>';
                    } else if(code === 'B' || r.status === 'TRUANT') {
                        badge = '<span class="bg-rose-200 text-rose-950 border border-rose-400 px-2.5 py-1 rounded-full text-xs font-bold">[B] Bolos</span>';
                    } else if(code === '?' || r.status === 'UNCONFIRMED_OUT') {
                        badge = '<span class="bg-sky-100 text-sky-800 border border-sky-300 px-2.5 py-1 rounded-full text-xs font-bold">[?] Tdk Scan Pulang</span>';
                    } else if(code === 'LBR' || r.status === 'HOLIDAY') {
                        badge = '<span class="bg-teal-100 text-teal-900 border border-teal-400 px-2.5 py-1 rounded-full text-xs font-bold">🌴 [LBR] Libur</span>';
                    }

                    const formatScanTimeWib = (st, fb) => {
                        if (fb && typeof fb === 'string' && fb.includes('WIB')) return fb;
                        if (!st) return '-';
                        try {
                            const d = new Date(st);
                            if (isNaN(d.getTime())) return String(st);
                            return d.toLocaleTimeString('id-ID', {
                                timeZone: 'Asia/Jakarta',
                                hour: '2-digit',
                                minute: '2-digit',
                                second: '2-digit'
                            }).replace(/\./g, ':') + ' WIB';
                        } catch (e) {
                            return '-';
                        }
                    };
                    const scanTimeFormatted = formatScanTimeWib(r.scanTime, r.gateInTime);
                    const gateOutFormatted = r.gateOutTime || '-';

                    let geoCell = '<span class="text-gray-400 text-xs">-</span>';
                    if (r.lat && r.lng) {
                        const mockBadge = r.isFakeGps 
                            ? '<span class="bg-red-100 text-red-700 text-[10px] font-extrabold px-1.5 py-0.5 rounded ml-1 border border-red-300">🚨 MOCK</span>' 
                            : '<span class="bg-emerald-100 text-emerald-700 text-[10px] font-bold px-1.5 py-0.5 rounded ml-1 border border-emerald-300">✓ VALID</span>';
                        geoCell = '<div class="flex flex-col gap-1">' +
                                    '<span class="font-mono text-xs text-blue-800 font-semibold">' + Number(r.lat).toFixed(5) + ', ' + Number(r.lng).toFixed(5) + '</span>' +
                                    '<div class="flex items-center gap-1">' +
                                        '<a href="https://www.google.com/maps?q=' + r.lat + ',' + r.lng + '" target="_blank" class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">📍 Maps ↗</a>' +
                                        mockBadge +
                                    '</div>' +
                                  '</div>';
                    }

                    tbody.innerHTML += '<tr class="hover:bg-blue-50 border-b text-sm">' +
                        '<td class="p-4 text-gray-500">' + (start + idx + 1) + '</td>' +
                        '<td class="p-4 font-bold text-gray-800">' + (r.name || '-') + '</td>' +
                        '<td class="p-4 font-mono text-xs text-gray-600">' + (r.nisn || '-') + '</td>' +
                        '<td class="p-4"><span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded text-xs font-semibold border border-blue-200">' + (r.className || '-') + '</span></td>' +
                        '<td class="p-4 font-mono text-xs font-semibold text-emerald-700">' + scanTimeFormatted + '</td>' +
                        '<td class="p-4 font-mono text-xs font-semibold text-blue-700">' + gateOutFormatted + '</td>' +
                        '<td class="p-4 text-xs font-medium text-gray-600">' + (r.method || '-') + '</td>' +
                        '<td class="p-4">' + badge + '</td>' +
                        '<td class="p-4">' + geoCell + '</td>' +
                        '<td class="p-4 text-xs text-gray-500 max-w-[200px] truncate">' + (r.note || '-') + '</td>' +
                        '<td class="p-4 text-center">' +
                            '<div class="flex items-center justify-center gap-1">' +
                                '<button onclick="openDetailSiswaModal(\'' + (r.userId || r.id) + '\', \'' + escape(r.name || '') + '\', \'' + (r.className || '') + '\', \'' + (r.nisn || '') + '\')" class="text-indigo-600 hover:underline font-bold text-xs bg-indigo-50 px-2 py-1 rounded border border-indigo-200 cursor-pointer">Rincian</button>' +
                                '<button onclick="quickEdit(\'' + (r.userId || r.id) + '\', \'' + r.status + '\')" class="text-blue-600 hover:underline font-bold text-xs bg-blue-50 px-2 py-1 rounded border border-blue-200 cursor-pointer">Ubah</button>' +
                            '</div>' +
                        '</td>' +
                    '</tr>';
                }
            });

            document.getElementById('pageInfo').innerText = 'Menampilkan ' + (start + 1) + '-' + Math.min(end, filteredRecords.length) + ' dari ' + filteredRecords.length + ' siswa';
            document.getElementById('btnPrev').disabled = currentPage === 1;
            document.getElementById('btnNext').disabled = currentPage === totalPages;
            renderPageNumbers(totalPages);
        }

        // ==================== MODAL RINCIAN PRESENSI 1 BULAN SISWA ====================
        async function openDetailSiswaModal(userId, encName, className, nisn) {
            const studentName = unescape(encName);
            const modal = document.getElementById('modalDetailSiswa');
            modal.classList.remove('hidden');

            document.getElementById('modalStudentName').innerText = studentName;
            document.getElementById('modalStudentClass').innerText = className || 'Kelas -';
            document.getElementById('modalStudentNisn').innerText = nisn || '-';

            const m = document.getElementById('filterMonth') ? document.getElementById('filterMonth').value : (todayDateObj.getMonth() + 1);
            const y = document.getElementById('filterYear') ? document.getElementById('filterYear').value : todayDateObj.getFullYear();
            
            const monthNamesId = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            document.getElementById('modalStudentPeriode').innerText = `${monthNamesId[m - 1]} ${y}`;

            const tbody = document.getElementById('modalCalendarTableBody');
            tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-400">Mengambil data log harian 1 bulan...</td></tr>';

            try {
                const res = await fetch(`/api/attendance/rekap-siswa/${userId}?month=${m}&year=${y}`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if (data && data.success) {
                    const sm = data.summary || {};
                    document.getElementById('modalStatEfektif').innerText = `${sm.hariEfektif || 0} Hari`;
                    document.getElementById('modalStatH').innerText = `${sm.H || 0}`;
                    document.getElementById('modalStatT').innerText = `${sm.T || 0}`;
                    document.getElementById('modalStatS').innerText = `${sm.S || 0}`;
                    document.getElementById('modalStatI').innerText = `${sm.I || 0}`;
                    document.getElementById('modalStatA').innerText = `${sm.A || 0}`;
                    document.getElementById('modalStatRate').innerText = `${sm.presenceRate || 0}%`;
                    document.getElementById('modalStatLateMinutes').innerText = `${sm.totalLateMinutes || 0} Menit`;

                    const calendar = data.dailyCalendar || [];
                    document.getElementById('modalCalendarSubtitle').innerText = `${calendar.length} Hari dalam ${data.periodeLabel}`;

                    if (calendar.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-400">Tidak ada log presensi untuk bulan ini.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = calendar.map(row => {
                        let stBadge = '<span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[10px] font-bold">Belum</span>';
                        if (row.statusCode === 'H') stBadge = '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-[10px] font-bold border border-emerald-300">[H] Hadir</span>';
                        else if (row.statusCode === 'T') stBadge = '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded text-[10px] font-bold border border-amber-300">[T] Telat</span>';
                        else if (row.statusCode === 'S') stBadge = '<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded text-[10px] font-bold border border-purple-300">[S] Sakit</span>';
                        else if (row.statusCode === 'I') stBadge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-[10px] font-bold border border-blue-300">[I] Izin</span>';
                        else if (row.statusCode === 'A') stBadge = '<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded text-[10px] font-bold border border-red-300">[A] Alfa</span>';
                        else if (row.statusCode === '?' || row.statusCode === 'UNCONFIRMED_OUT') stBadge = '<span class="bg-sky-100 text-sky-800 px-2 py-0.5 rounded text-[10px] font-bold border border-sky-300">[?] Tdk Scan</span>';
                        else if (row.statusCode === 'LBR') stBadge = '<span class="bg-teal-100 text-teal-800 px-2 py-0.5 rounded text-[10px] font-bold border border-teal-300">🌴 Libur</span>';

                        const [yy, mm, dd] = row.date.split('-');
                        const lateStr = row.lateMinutes > 0 ? `<span class="font-bold text-amber-700 font-mono">${row.lateMinutes}m</span>` : '<span class="text-slate-400">-</span>';

                        const isHolBg = row.isHoliday ? 'bg-teal-50/40 text-teal-900' : (row.statusCode === 'A' ? 'bg-red-50/30' : '');

                        return `
                            <tr class="border-b text-xs hover:bg-slate-50 transition ${isHolBg}">
                                <td class="p-2.5 font-bold font-mono text-slate-700">${dd}/${mm}</td>
                                <td class="p-2.5 font-semibold text-slate-600">${row.dayName}</td>
                                <td class="p-2.5 text-center">${stBadge}</td>
                                <td class="p-2.5 font-mono text-emerald-700 font-bold">${row.gateInTime || '-'}</td>
                                <td class="p-2.5 font-mono text-blue-700 font-bold">${row.gateOutTime || '-'}</td>
                                <td class="p-2.5 text-center">${lateStr}</td>
                                <td class="p-2.5 text-slate-500 max-w-[240px] truncate">${row.note || '-'}</td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-red-500">${data.message || 'Gagal memuat rekap detail siswa'}</td></tr>`;
                }
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-red-500">Terjadi kesalahan: ${err.message}</td></tr>`;
            }
        }

        function closeModalDetailSiswa() {
            document.getElementById('modalDetailSiswa').classList.add('hidden');
        }

        function renderPageNumbers(totalPages) {
            const container = document.getElementById('pageNumberButtons');
            if (!container) return;
            container.innerHTML = '';
            if (totalPages <= 1) return;

            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage + 1 < maxVisible) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            if (startPage > 1) {
                const btn1 = document.createElement('button');
                btn1.className = 'px-2.5 py-1 text-xs rounded border border-gray-300 hover:bg-gray-100 font-semibold text-gray-700';
                btn1.innerText = '1';
                btn1.onclick = () => goToPage(1);
                container.appendChild(btn1);

                if (startPage > 2) {
                    const dots = document.createElement('span');
                    dots.className = 'px-1 text-gray-400 text-xs font-bold';
                    dots.innerText = '...';
                    container.appendChild(dots);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                const btn = document.createElement('button');
                btn.className = `px-2.5 py-1 text-xs rounded font-bold transition ${i === currentPage ? 'bg-blue-600 text-white shadow-sm' : 'border border-gray-300 hover:bg-gray-100 text-gray-700'}`;
                btn.innerText = i;
                btn.onclick = () => goToPage(i);
                container.appendChild(btn);
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const dots = document.createElement('span');
                    dots.className = 'px-1 text-gray-400 text-xs font-bold';
                    dots.innerText = '...';
                    container.appendChild(dots);
                }
                const btnLast = document.createElement('button');
                btnLast.className = 'px-2.5 py-1 text-xs rounded border border-gray-300 hover:bg-gray-100 font-semibold text-gray-700';
                btnLast.innerText = totalPages;
                btnLast.onclick = () => goToPage(totalPages);
                container.appendChild(btnLast);
            }
        }

        function goToPage(p) {
            currentPage = p;
            renderTable();
        }

        function prevPage() { if(currentPage > 1) { currentPage--; renderTable(); } }
        function nextPage() { if(currentPage * rowsPerPage < filteredRecords.length) { currentPage++; renderTable(); } }

        function filterManualRekapUsers() {
            const classFilter = document.getElementById('filterManualRekapClass')?.value || 'ALL';
            const searchQuery = (document.getElementById('searchManualRekapUser')?.value || '').toLowerCase().trim();
            const select = document.getElementById('manualUserId');
            if (!select) return;

            select.innerHTML = '<option value="">-- Pilih Siswa --</option>';
            let count = 0;

            const list = Array.isArray(rekapRecords) ? rekapRecords : [];
            list.forEach(s => {
                const matchesClass = (classFilter === 'ALL' || s.className === classFilter);
                const nameMatches = (s.name || '').toLowerCase().includes(searchQuery);
                const nisnMatches = (s.nisn || '').toLowerCase().includes(searchQuery);
                const matchesSearch = searchQuery === '' || nameMatches || nisnMatches;

                if (matchesClass && matchesSearch) {
                    const opt = document.createElement('option');
                    opt.value = s.userId;
                    opt.textContent = `${s.name} (${s.className || '-'} - NISN: ${s.nisn || '-'})`;
                    select.appendChild(opt);
                    count++;
                }
            });

            const countEl = document.getElementById('manualRekapCount');
            if (countEl) {
                countEl.innerText = (searchQuery || classFilter !== 'ALL') 
                    ? `Ditemukan ${count} siswa (dari total ${list.length})` 
                    : `Menampilkan seluruh ${count} siswa`;
            }
        }

        function openManualModal() {
            document.getElementById('modalManual').classList.remove('hidden');
            const searchInput = document.getElementById('searchManualRekapUser');
            if(searchInput) searchInput.value = '';
            filterManualRekapUsers();
        }

        function quickEdit(userId, currentStatus) {
            document.getElementById('manualUserId').value = userId;
            document.getElementById('manualStatus').value = currentStatus !== 'NOT_YET' ? currentStatus : 'PRESENT';
            document.getElementById('modalManual').classList.remove('hidden');
        }

        document.getElementById('manualAttendanceForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                userId: document.getElementById('manualUserId').value,
                status: document.getElementById('manualStatus').value,
                note: document.getElementById('manualNote').value,
                scanDate: document.getElementById('filterDate').value
            };

            const res = await fetch('/api/attendance/manual', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(payload)
            });

            if(res.ok) {
                alert('Presensi berhasil diperbarui');
                document.getElementById('modalManual').classList.add('hidden');
                document.getElementById('manualNote').value = '';
                loadRekap();
            } else {
                alert('Gagal memperbarui presensi');
            }
        });

        function getExportParams() {
            const date = document.getElementById('filterDate').value;
            const selectedClass = document.getElementById('filterClass')?.value || 'ALL';
            let query = 'date=' + encodeURIComponent(date) + '&token=' + encodeURIComponent(token);

            if (selectedClass && selectedClass !== 'ALL') {
                query += '&scope=CLASS&className=' + encodeURIComponent(selectedClass);
            } else {
                const scope = document.getElementById('filterScope') ? document.getElementById('filterScope').value : 'ALL';
                query += '&scope=' + encodeURIComponent(scope);
                if (scope === 'GRADE') {
                    const grade = document.getElementById('filterGrade').value;
                    query += '&grade=' + encodeURIComponent(grade);
                }
            }
            return query;
        }

        function downloadExcelRekap(format = 'xls') {
            const params = getExportParams();
            window.open('/api/attendance/export-excel?' + params + '&format=' + encodeURIComponent(format), '_blank');
        }

        function downloadPdfRekap() {
            const params = getExportParams();
            window.open('/api/attendance/export-pdf?' + params, '_blank');
        }

        async function triggerNotifyUnscannedAdmin() {
            if (!confirm('Kirim notifikasi peringatan ke orang tua dan tetapkan status ALPA otomatis (+10 poin disiplin) bagi siswa yang belum scan barcode masuk hari ini?')) {
                return;
            }
            try {
                const res = await fetch('/api/attendance/check-unscanned', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                alert(data.message || 'Pemeriksaan presensi selesai.');
                loadRekap();
            } catch (e) {
                alert('Gagal: ' + e.message);
            }
        }

        async function openHolidayModal() {
            document.getElementById('modalHoliday').classList.remove('hidden');
            document.getElementById('holidayDate').value = document.getElementById('filterDate').value || new Date().toISOString().split('T')[0];
            await loadSchoolHolidaysList();
        }

        function closeHolidayModal() {
            document.getElementById('modalHoliday').classList.add('hidden');
        }

        async function loadSchoolHolidaysList() {
            const container = document.getElementById('holidayListContainer');
            try {
                const res = await fetch('/api/calendar/school-holidays', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                const list = data.holidays || [];
                if (list.length === 0) {
                    container.innerHTML = '<p class="text-xs text-slate-400 py-4 text-center">Belum ada hari libur sekolah khusus yang didaftarkan.</p>';
                    return;
                }
                container.innerHTML = list.map(h => `
                    <div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl shadow-sm hover:border-teal-300">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="bg-teal-100 text-teal-800 text-[10px] font-bold px-2 py-0.5 rounded font-mono">${h.date}</span>
                                <strong class="text-xs text-slate-800 font-bold">${h.name}</strong>
                            </div>
                            ${h.description ? `<p class="text-[11px] text-slate-500 mt-0.5">${h.description}</p>` : ''}
                        </div>
                        <button onclick="deleteSchoolHoliday('${h.date}')" class="text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded-lg text-xs font-bold transition">
                            Hapus 🗑️
                        </button>
                    </div>
                `).join('');
            } catch (err) {
                container.innerHTML = '<p class="text-xs text-red-500 py-2">Gagal memuat data libur.</p>';
            }
        }

        async function saveHoliday(e) {
            e.preventDefault();
            const date = document.getElementById('holidayDate').value;
            const name = document.getElementById('holidayName').value;
            const description = document.getElementById('holidayDesc').value;

            try {
                const res = await fetch('/api/calendar/school-holidays', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date, name, description })
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message || 'Hari libur berhasil disimpan!');
                    document.getElementById('holidayName').value = '';
                    document.getElementById('holidayDesc').value = '';
                    await loadSchoolHolidaysList();
                    loadRekap();
                } else {
                    alert(data.message || 'Gagal menyimpan hari libur');
                }
            } catch (err) {
                alert('Terjadi kesalahan: ' + err.message);
            }
        }

        async function deleteSchoolHoliday(date) {
            if (!confirm(`Hapus status libur untuk tanggal ${date}? Siswa pada tanggal tersebut akan kembali dihitung presensi normal.`)) return;
            try {
                const res = await fetch('/api/calendar/school-holidays/' + date, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert(data.message || 'Hari libur berhasil dihapus');
                await loadSchoolHolidaysList();
                loadRekap();
            } catch (err) {
                alert('Gagal menghapus: ' + err.message);
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        // Jalankan saat load berurutan agar filter VII-A aktif
        (async () => {
            await loadClasses();
            await loadRekap();
        })();
    </script>
</body>
</html>
