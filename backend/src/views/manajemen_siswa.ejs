    <script>
        const serverToken = "<%= typeof currentAuthToken !== 'undefined' ? currentAuthToken : '' %>";
        let token = serverToken || localStorage.getItem('token') || localStorage.getItem('admin_token') || '';
        if (serverToken && !localStorage.getItem('token')) {
            try { localStorage.setItem('token', serverToken); } catch (e) {}
        }
        let allStudents = <%- JSON.stringify(initialStudents || []) %>;
        let filteredStudents = [];
        let currentTingkatTab = 'ALL';
        let currentPhoneFilter = 'ALL';
        let currentPage = 1;
        const rowsPerPage = 50;
        let searchTimeout = null;

        function getStudentPhoneStatus(s) {
            if (!s) return 'NOT_CONNECTED';
            if (s.hasNoSmartphone === true || s.phoneStatus === 'NO_PHONE') return 'NO_PHONE';
            if (s.phoneStatus === 'CONNECTED') return 'CONNECTED';
            if ((s.devices && s.devices.length > 0) || s.deviceBindingId) return 'CONNECTED';
            return 'NOT_CONNECTED';
        }

        async function loadStudents() {
            if (!token) {
                token = serverToken || localStorage.getItem('token') || localStorage.getItem('admin_token') || '';
            }
            try {
                const reqHeaders = { 'Content-Type': 'application/json' };
                if (token && token !== 'null' && token !== 'undefined') {
                    reqHeaders['Authorization'] = 'Bearer ' + token;
                }
                let res = await fetch('/api/admin/students', {
                    headers: reqHeaders,
                    credentials: 'same-origin'
                });
                if (!res.ok) {
                    res = await fetch('/api/students', {
                        headers: reqHeaders,
                        credentials: 'same-origin'
                    });
                }
                if (res.ok) {
                    const data = await res.json();
                    const list = Array.isArray(data) ? data : (data.students || []);
                    if (list.length > 0) {
                        allStudents = list;
                    }
                }
            } catch(e) {
                console.warn('Background sync students notice:', e);
            } finally {
                updateStats();
                populateRombelDropdown();
                applyFilters();
            }
        }

        function updateStats() {
            const countVII = allStudents.filter(s => (s.className || '').startsWith('VII-')).length;
            const countVIII = allStudents.filter(s => (s.className || '').startsWith('VIII-')).length;
            const countIX = allStudents.filter(s => (s.className || '').startsWith('IX-')).length;

            const countConnected = allStudents.filter(s => getStudentPhoneStatus(s) === 'CONNECTED').length;
            const countNotConnected = allStudents.filter(s => getStudentPhoneStatus(s) === 'NOT_CONNECTED').length;
            const countNoPhone = allStudents.filter(s => getStudentPhoneStatus(s) === 'NO_PHONE').length;

            const statAll = document.getElementById('statAllCount');
            if (statAll) statAll.innerText = allStudents.length.toLocaleString('id-ID');
            const tabAll = document.getElementById('tabBadgeAll');
            if (tabAll) tabAll.innerText = allStudents.length.toLocaleString('id-ID');

            const statVIIEl = document.getElementById('statVII');
            if (statVIIEl) statVIIEl.innerText = countVII;
            const tabVIIEl = document.getElementById('tabBadgeVII');
            if (tabVIIEl) tabVIIEl.innerText = countVII;

            const statVIIIEl = document.getElementById('statVIII');
            if (statVIIIEl) statVIIIEl.innerText = countVIII;
            const tabVIIIEl = document.getElementById('tabBadgeVIII');
            if (tabVIIIEl) tabVIIIEl.innerText = countVIII;

            const statIXEl = document.getElementById('statIX');
            if (statIXEl) statIXEl.innerText = countIX;
            const tabIXEl = document.getElementById('tabBadgeIX');
            if (tabIXEl) tabIXEl.innerText = countIX;

            // Update Phone Stat Cards & Pills
            const statConn = document.getElementById('statPhoneConnected');
            if (statConn) statConn.innerText = countConnected;
            const pillConn = document.getElementById('pillCountConnected');
            if (pillConn) pillConn.innerText = countConnected;

            const statNotConn = document.getElementById('statPhoneNotConnected');
            if (statNotConn) statNotConn.innerText = countNotConnected;
            const pillNotConn = document.getElementById('pillCountNotConnected');
            if (pillNotConn) pillNotConn.innerText = countNotConnected;

            const statNoPh = document.getElementById('statPhoneNoPhone');
            if (statNoPh) statNoPh.innerText = countNoPhone;
            const pillNoPh = document.getElementById('pillCountNoPhone');
            if (pillNoPh) pillNoPh.innerText = countNoPhone;

            const pillAll = document.getElementById('pillCountAll');
            if (pillAll) pillAll.innerText = allStudents.length;
        }

        function selectPhoneFilter(status) {
            currentPhoneFilter = status;

            const filterBtnIds = ['filterPhoneAll', 'filterPhoneConnected', 'filterPhoneNotConnected', 'filterPhoneNoPhone'];
            filterBtnIds.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.remove('active');
            });

            const activeBtnMap = {
                'ALL': 'filterPhoneAll',
                'CONNECTED': 'filterPhoneConnected',
                'NOT_CONNECTED': 'filterPhoneNotConnected',
                'NO_PHONE': 'filterPhoneNoPhone'
            };
            const activeBtn = document.getElementById(activeBtnMap[status]);
            if (activeBtn) activeBtn.classList.add('active');

            // Highlight kartu stat di bagian atas
            const cardMap = {
                'CONNECTED': 'cardPhoneConnected',
                'NOT_CONNECTED': 'cardPhoneNotConnected',
                'NO_PHONE': 'cardPhoneNoPhone'
            };
            ['cardPhoneConnected', 'cardPhoneNotConnected', 'cardPhoneNoPhone'].forEach(cId => {
                const cEl = document.getElementById(cId);
                if (cEl) {
                    if (cardMap[status] === cId) {
                        cEl.classList.add('ring-2', 'ring-blue-600', 'bg-blue-50/20');
                    } else {
                        cEl.classList.remove('ring-2', 'ring-blue-600', 'bg-blue-50/20');
                    }
                }
            });

            applyFilters();
        }

        function selectTingkatTab(tingkat) {
            currentTingkatTab = tingkat;

            const tabs = ['tabAll', 'tabVII', 'tabVIII', 'tabIX'];
            tabs.forEach(tId => {
                const el = document.getElementById(tId);
                el.className = 'tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5';
            });

            const activeMap = {
                'ALL': 'tabAll',
                'VII': 'tabVII',
                'VIII': 'tabVIII',
                'IX': 'tabIX'
            };
            const activeEl = document.getElementById(activeMap[tingkat]);
            if (activeEl) {
                activeEl.className = 'tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5';
            }

            populateRombelDropdown();
            applyFilters();
        }

        function populateRombelDropdown() {
            const select = document.getElementById('filterRombelSelect');
            let rombels = [];

            if (currentTingkatTab === 'VII') {
                rombels = ['VII-A','VII-B','VII-C','VII-D','VII-E','VII-F','VII-G','VII-H','VII-I','VII-J','VII-K'];
                select.innerHTML = '<option value="ALL">📋 Semua Kelas VII (11 Rombel)</option>' +
                    rombels.map(r => `<option value="${r}">Kelas ${r}</option>`).join('');
            } else if (currentTingkatTab === 'VIII') {
                rombels = ['VIII-A','VIII-B','VIII-C','VIII-D','VIII-E','VIII-F','VIII-G','VIII-H','VIII-I','VIII-J','VIII-K'];
                select.innerHTML = '<option value="ALL">📋 Semua Kelas VIII (11 Rombel)</option>' +
                    rombels.map(r => `<option value="${r}">Kelas ${r}</option>`).join('');
            } else if (currentTingkatTab === 'IX') {
                rombels = ['IX-A','IX-B','IX-C','IX-D','IX-E','IX-F','IX-G','IX-H','IX-I','IX-J','IX-K'];
                select.innerHTML = '<option value="ALL">📋 Semua Kelas IX (11 Rombel)</option>' +
