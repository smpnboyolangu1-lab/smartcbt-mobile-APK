        async function executeGradePromotion() {
            let payload = {};
            let confirmMsg = '';

            if (currentPromoteMode === 'VII_TO_VIII') {
                payload = { mode: 'MASS_LEVEL', sourceLevel: 'VII', targetLevel: 'VIII' };
                confirmMsg = 'Apakah Anda yakin ingin menaikkan SELURUH siswa Tingkat VII ke Tingkat VIII (VII-A s.d VII-K menjadi VIII-A s.d VIII-K)? Tindakan ini akan langsung memperbarui kelas siswa di portal dan APK Android.';
            } else if (currentPromoteMode === 'VIII_TO_IX') {
                payload = { mode: 'MASS_LEVEL', sourceLevel: 'VIII', targetLevel: 'IX' };
                confirmMsg = 'Apakah Anda yakin ingin menaikkan SELURUH siswa Tingkat VIII ke Tingkat IX (VIII-A s.d VIII-K menjadi IX-A s.d IX-K)? Tindakan ini akan langsung memperbarui kelas siswa di portal dan APK Android.';
            } else {
                const src = document.getElementById('promoteSourceClass').value;
                const dst = document.getElementById('promoteTargetClass').value;
                if (src === dst) {
                    alert('Kelas asal dan kelas tujuan tidak boleh sama.');
                    return;
                }
                payload = { mode: 'SINGLE_CLASS', sourceClass: src, targetClass: dst };
                confirmMsg = `Apakah Anda yakin ingin menaikkan seluruh siswa dari kelas ${src} ke kelas ${dst}?`;
            }

            if (!confirm(confirmMsg)) return;

            const btn = document.getElementById('btnSubmitPromote');
            btn.disabled = true;
            btn.innerText = 'Memproses Kenaikan Kelas...';

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch('/api/admin/students/promote-grade', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message);
                    closePromoteModal();
                    loadStudents();
                } else {
                    alert('❌ Gagal memproses kenaikan kelas: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (e) {
                console.error(e);
                alert('Terjadi kesalahan jaringan saat memproses kenaikan kelas.');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Proses Kenaikan Kelas';
            }
        }

        // Render instan dari data SSR
        updateStats();
        populateRombelDropdown();
        applyFilters();

        // Background update jika ada perubahan realtime
        loadStudents();
    </script>
</body>
</html>
