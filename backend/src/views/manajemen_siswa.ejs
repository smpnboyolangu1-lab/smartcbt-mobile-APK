        async function toggleStudentNoPhone(studentId, studentName, targetState) {
            const s = allStudents.find(x => String(x.id) === String(studentId));
            const name = s ? s.name : (studentName || 'Siswa');
            const actionLabel = targetState ? 'Tandai bahwa siswa TIDAK MEMILIKI SMARTPHONE (akan difasilitasi Lab CBT)' : 'Batalkan status tanpa HP (siswa memiliki smartphone reguler)';
            
            if (!confirm(`Konfirmasi Status HP Siswa:\n\n${actionLabel} untuk ${name}?`)) {
                return;
            }

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/students/${studentId}/toggle-no-phone`, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ isNoPhone: targetState })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    if (s) {
                        s.hasNoSmartphone = data.isNoSmartphone;
                        s.phoneStatus = data.isNoSmartphone ? 'NO_PHONE' : (s.deviceBindingId || (s.devices && s.devices.length > 0) ? 'CONNECTED' : 'NOT_CONNECTED');
                    }
                    updateStats();
                    applyFilters();
                    if (!document.getElementById('modalProfile').classList.contains('hidden')) {
                        viewProfile(studentId);
                    }
                    if (!document.getElementById('modalPhoneReport').classList.contains('hidden')) {
                        renderModalReportTable();
                    }
                    alert('✅ ' + data.message);
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan jaringan saat memperbarui status HP siswa.');
            }
        }

