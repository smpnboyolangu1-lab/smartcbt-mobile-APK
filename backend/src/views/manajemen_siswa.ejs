                                    <span>🔲</span> <span>QR</span>
                                </button>
                                <button onclick="openStudentActionMenu(event, '${s.id}')" class="btn-student-action bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-300 text-slate-700 font-bold px-2.5 py-1.5 rounded-lg text-xs border border-slate-300 shadow-sm flex items-center gap-1 transition-all cursor-pointer" title="Menu Aksi Terpadu">
                                    <span>⚙️</span> <span>Aksi</span> <span class="text-[9px] text-slate-400">▼</span>
                                </button>
                            </div>
