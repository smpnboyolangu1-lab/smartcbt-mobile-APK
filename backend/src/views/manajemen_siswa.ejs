        function populateReportClassFilter() {
            const sel = document.getElementById('modalReportClassFilter');
            if (!sel) return;
            const uniqueClasses = Array.from(new Set(allStudents.map(s => s.className).filter(Boolean))).sort();
            sel.innerHTML = '<option value="ALL">📋 Semua Rombel (Seluruh Siswa)</option>' +
                uniqueClasses.map(c => `<option value="${c}">Kelas ${c}</option>`).join('');
        }

        function renderModalReportTable() {
            const classFilter = document.getElementById('modalReportClassFilter')?.value || 'ALL';
            const statusFilter = document.getElementById('modalReportStatusFilter')?.value || 'ALL';
            const tbody = document.getElementById('modalReportTableBody');
            if (!tbody) return;

            const list = allStudents.filter(s => {
                const matchClass = (classFilter === 'ALL') || (s.className === classFilter);
                const pStatus = getStudentPhoneStatus(s);
                const matchStatus = (statusFilter === 'ALL') || (pStatus === statusFilter);
                return matchClass && matchStatus;
            });

            // Update stats in modal header
            const totalConn = allStudents.filter(s => getStudentPhoneStatus(s) === 'CONNECTED').length;
            const totalNotConn = allStudents.filter(s => getStudentPhoneStatus(s) === 'NOT_CONNECTED').length;
            const totalNoPh = allStudents.filter(s => getStudentPhoneStatus(s) === 'NO_PHONE').length;

            const statC = document.getElementById('reportStatConnected');
            if (statC) statC.innerText = totalConn;
            const statNC = document.getElementById('reportStatNotConnected');
            if (statNC) statNC.innerText = totalNotConn;
            const statNP = document.getElementById('reportStatNoPhone');
            if (statNP) statNP.innerText = totalNoPh;

            const badge = document.getElementById('modalReportTotalBadge');
            if (badge) badge.innerText = `Menampilkan: ${list.length} Siswa`;

            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-400 font-semibold">Tidak ada data siswa yang cocok dengan filter yang dipilih.</td></tr>';
                return;
            }

            tbody.innerHTML = list.map((s, i) => {
                const pStatus = getStudentPhoneStatus(s);
                let statusBadge = '';
                let deviceDesc = '-';
                let note = '';

                if (pStatus === 'CONNECTED') {
                    const dev = s.activeDevice || (s.devices && s.devices.length > 0 ? s.devices[0] : null);
                    const devName = dev ? (dev.deviceModel || dev.deviceName || 'Android') : 'Android Device';
                    const bindId = s.deviceBindingId || (dev ? dev.deviceAndroidId : '');
                    statusBadge = '<span class="font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded text-[11px]">🟢 Terhubung HP</span>';
                    deviceDesc = `<b>${devName}</b>${bindId ? `<br><span class="font-mono text-[10px] text-slate-500">ID: ${bindId}</span>` : ''}`;
                    note = 'Mandiri (Ujian di HP Pribadi)';
                } else if (pStatus === 'NO_PHONE') {
                    statusBadge = '<span class="font-black text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded text-[11px]">⚪ Tidak Punya HP</span>';
                    deviceDesc = '<span class="text-rose-600 italic">Tanpa Perangkat</span>';
                    note = '<b class="text-rose-700">Wajib Fasilitasi Lab Komputer CBT</b>';
                } else {
                    statusBadge = '<span class="font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded text-[11px]">🟡 Belum Terhubung</span>';
                    deviceDesc = '<span class="text-slate-400 italic">Belum Login APK</span>';
                    note = 'Perlu Edukasi Login APK / Konfirmasi HP';
                }

                return `
                    <tr class="hover:bg-slate-50">
                        <td class="p-2 border text-center font-bold text-slate-500">${i + 1}</td>
                        <td class="p-2 border font-mono font-bold text-slate-700">${s.nisn || s.username || '-'}</td>
                        <td class="p-2 border font-bold text-slate-900">${s.name}</td>
                        <td class="p-2 border text-center font-bold text-indigo-700">${s.className || '-'}</td>
                        <td class="p-2 border text-center">${statusBadge}</td>
                        <td class="p-2 border text-xs">${deviceDesc}</td>
                        <td class="p-2 border text-xs text-slate-700">${note}</td>
                    </tr>
                `;
            }).join('');
        }

