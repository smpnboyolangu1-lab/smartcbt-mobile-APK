                            <span class="bg-amber-100 text-amber-900 border border-amber-300 font-bold text-[10px] px-2 py-0.5 rounded-md inline-flex items-center gap-1 w-fit">
                                <span>🟡</span> Belum Terhubung
                            </span>
                            <span class="text-[10px] text-amber-800">Belum login APK di HP</span>
