                    </tr>
                `;
            }).join('');

            document.getElementById('pageInfo').innerText = `Menampilkan ${startIdx + 1}-${endIdx} dari ${total.toLocaleString('id-ID')} siswa`;
            document.getElementById('btnPrev').disabled = currentPage === 1;
            document.getElementById('btnNext').disabled = endIdx >= total;
        }

        let activeStudentActionId = null;

        function openStudentActionMenu(event, studentId) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            const dropdown = document.getElementById('globalStudentActionDropdown');
            if (!dropdown) return;

            if (activeStudentActionId === studentId && !dropdown.classList.contains('hidden')) {
                closeStudentActionDropdown();
                return;
            }

            activeStudentActionId = studentId;
            const s = allStudents.find(x => String(x.id) === String(studentId));
            if (!s) {
                console.warn('Student data not found for id:', studentId);
                return;
            }

            document.getElementById('dropdownStudentName').innerText = s.name || s.nama || 'Siswa';
            document.getElementById('dropdownStudentNisn').innerText = 'NISN: ' + (s.nisn || s.username || '-');

            const isNoPhone = (s.hasNoSmartphone || s.phoneStatus === 'NO_PHONE');
            const toggleTitle = document.getElementById('dropdownNoPhoneTitle');
            const toggleSub = document.getElementById('dropdownNoPhoneSubtitle');
            if (toggleTitle) toggleTitle.innerText = isNoPhone ? 'Batalkan (Siswa Punya HP)' : 'Tandai Tidak Punya HP';
            if (toggleSub) toggleSub.innerText = isNoPhone ? 'Ubah menjadi siswa dengan HP regular' : 'Fasilitas Lab Komputer CBT Sekolah';

            dropdown.classList.remove('hidden');

            const btn = event.currentTarget || (event.target ? event.target.closest('button') : null);
            if (btn) {
                const rect = btn.getBoundingClientRect();
                const dropdownWidth = 230;
                const dropdownHeight = 310;

                let left = rect.right - dropdownWidth;
                if (left < 10) left = 10;
                if (left + dropdownWidth > window.innerWidth - 10) {
                    left = window.innerWidth - dropdownWidth - 10;
                }

                let top = rect.bottom + 6;
                if (top + dropdownHeight > window.innerHeight - 10) {
                    top = rect.top - dropdownHeight - 6;
                }
                if (top < 10) top = 10;

                dropdown.style.left = `${Math.round(left)}px`;
                dropdown.style.top = `${Math.round(top)}px`;
            }
        }

        function closeStudentActionDropdown() {
            const dropdown = document.getElementById('globalStudentActionDropdown');
            if (dropdown) dropdown.classList.add('hidden');
            activeStudentActionId = null;
        }

        function handleDropdownAction(actionType) {
            if (!activeStudentActionId) return;
            const studentId = activeStudentActionId;
            closeStudentActionDropdown();

            const s = allStudents.find(x => String(x.id) === String(studentId));
            const sName = s ? (s.name || s.nama || '') : '';
            const sNisn = s ? (s.nisn || s.username || '') : '';

            if (actionType === 'RESET_PASSWORD') {
                openResetPasswordModal(studentId, sName, sNisn);
            } else if (actionType === 'RESET_DEVICE') {
                unbindStudentDevice(studentId, sName);
            } else if (actionType === 'TOGGLE_NO_PHONE') {
                const isCurrentlyNoPhone = (s && (s.hasNoSmartphone || s.phoneStatus === 'NO_PHONE'));
                toggleStudentNoPhone(studentId, sName, !isCurrentlyNoPhone);
            } else if (actionType === 'FORCE_LOGOUT') {
                forceLogoutStudent(studentId, sName);
            } else if (actionType === 'VIEW_PROFILE') {
                viewProfile(studentId);
            } else if (actionType === 'VIEW_QR') {
                openStudentQrModal(studentId);
            } else if (actionType === 'DELETE') {
                deleteStudentAction(studentId, sName, sNisn);
            }
        }

        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('globalStudentActionDropdown');
            if (!dropdown || dropdown.classList.contains('hidden')) return;
            if (!dropdown.contains(e.target) && !e.target.closest('.btn-student-action')) {
                closeStudentActionDropdown();
            }
        });
        window.addEventListener('resize', closeStudentActionDropdown);

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderTable();
            }
        }

        function nextPage() {
            if ((currentPage * rowsPerPage) < filteredStudents.length) {
                currentPage++;
                renderTable();
            }
        }

        function viewProfile(studentId) {
            const s = allStudents.find(item => item.id === studentId);
            if (!s) return;

            const cName = s.className || '-';
            let tingkatName = 'Tingkat VII (Kelas 7)';
