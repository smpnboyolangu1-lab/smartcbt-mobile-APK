            } else if (pStatus === 'NO_PHONE') {
                phoneBadgeHtml = '<span class="bg-rose-100 text-rose-800 border border-rose-300 font-black px-3 py-1 rounded-full text-xs">⚪ Siswa Tanpa HP (Lab CBT)</span>';
            } else {
                phoneBadgeHtml = '<span class="bg-amber-100 text-amber-900 border border-amber-300 font-black px-3 py-1 rounded-full text-xs">🟡 Belum Terhubung HP</span>';
            }

            let html = `
                <div class="bg-white p-6 rounded-2xl border shadow-sm flex flex-col md:flex-row items-center gap-6 mb-6">
                    <div class="relative group">
                        ${avatarBig}
                        <label for="adminAvatarUpload_${s.id}" class="absolute -bottom-2 -right-2 bg-blue-600 hover:bg-blue-700 text-white p-1.5 rounded-full shadow cursor-pointer text-xs" title="Ganti Foto Profil Siswa">
                            📷
                        </label>
                        <input type="file" id="adminAvatarUpload_${s.id}" accept="image/*" class="hidden" onchange="handleAdminUploadAvatar('${s.id}', this)">
                    </div>
                    <div class="flex-1 text-center md:text-left">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-1">
                            <h3 class="text-xl font-black text-gray-800">${s.name}</h3>
                            <span class="${badgeStyle} text-xs px-2.5 py-0.5 rounded-full font-bold">${cName}</span>
