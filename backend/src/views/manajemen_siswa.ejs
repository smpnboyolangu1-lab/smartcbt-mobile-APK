                            <button onclick="toggleStudentNoPhone('${s.id}', '${safeName}', false)" class="text-[10px] text-emerald-700 hover:text-emerald-900 font-bold underline text-left cursor-pointer" title="Kembalikan status jika siswa sudah membawa HP">
