        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(applyFilters, 250);
        }

        function applyFilters() {
            const rombelVal = document.getElementById('filterRombelSelect').value;
            const searchVal = document.getElementById('searchInput').value.toLowerCase();

            filteredStudents = allStudents.filter(s => {
                const cName = s.className || '';
                
                // Tingkat Tab Filter
                let matchTingkat = true;
                if (currentTingkatTab === 'VII') matchTingkat = cName.startsWith('VII-');
                else if (currentTingkatTab === 'VIII') matchTingkat = cName.startsWith('VIII-');
                else if (currentTingkatTab === 'IX') matchTingkat = cName.startsWith('IX-');

                // Rombel Dropdown Filter
                const matchRombel = (rombelVal === 'ALL') || (cName === rombelVal);

                // Phone Status Filter
                const pStatus = getStudentPhoneStatus(s);
                let matchPhone = true;
                if (currentPhoneFilter !== 'ALL') {
                    matchPhone = (pStatus === currentPhoneFilter);
                }

                // Search Box
                const matchSearch = (s.name || '').toLowerCase().includes(searchVal) ||
                                    (s.username || '').toLowerCase().includes(searchVal) ||
                                    (s.nisn || '').toLowerCase().includes(searchVal) ||
                                    cName.toLowerCase().includes(searchVal);

                return matchTingkat && matchRombel && matchPhone && matchSearch;
            });

            currentPage = 1;
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('studentTableBody');
            const total = filteredStudents.length;

            if (total === 0) {
                let emptyMsg = 'Tidak ada data siswa yang sesuai filter.';
                if (currentPhoneFilter === 'NO_PHONE') {
                    emptyMsg = 'ℹ️ Belum ada siswa yang ditandai "Tidak Punya HP" di filter ini.';
                } else if (currentPhoneFilter === 'CONNECTED') {
                    emptyMsg = 'ℹ️ Tidak ada siswa terhubung HP yang sesuai pencarian.';
                } else if (currentTingkatTab === 'VIII') {
                    emptyMsg = 'ℹ️ Data Siswa Kelas VIII belum diinput/diimpor ke sistem.';
                } else if (currentTingkatTab === 'IX') {
                    emptyMsg = 'ℹ️ Data Siswa Kelas IX belum diinput/diimpor ke sistem.';
                }
                tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-gray-400 font-medium">' + emptyMsg + '</td></tr>';

                document.getElementById('pageInfo').innerText = 'Menampilkan 0 dari 0 siswa';
                document.getElementById('btnPrev').disabled = true;
                document.getElementById('btnNext').disabled = true;
                return;
