                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> 🟢 Terhubung HP
                            </span>
                            <span class="text-[11px] font-bold text-slate-800 truncate max-w-[170px]" title="${devName}">
                                📱 ${devName}
                            </span>
                            ${bindId ? `
