                        badge = '<span class="bg-red-500/20 text-red-400 border border-red-500/40 px-2 py-0.5 rounded-lg text-[10px] font-bold">🔒 Terkunci (Strike)</span>';
                        cardBg = 'bg-red-950/40 border-red-800';
                        progColor = 'bg-red-500';
                    } else if (isWarning) {
                        badge = '<span class="bg-amber-500/20 text-amber-400 border border-amber-500/40 px-2 py-0.5 rounded-lg text-[10px] font-bold">🟡 Peringatan (1/3)</span>';
