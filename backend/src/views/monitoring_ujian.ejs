    <script>
        function getCookie(name) {
            const v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
            return v ? v[2] : null;
        }
        const serverToken = '<%= typeof token !== "undefined" && token ? token : "" %>';
        const token = serverToken || localStorage.getItem('token') || localStorage.getItem('jwt_token') || getCookie('token') || getCookie('admin_token') || '';
        const serverClasses = <%- JSON.stringify(typeof classes !== 'undefined' ? classes : []) %>;
        let chartPieInstance = null;
        let chartBarInstance = null;
        let currentViewMode = localStorage.getItem('cbt_view_mode') || 'CCTV'; // Default CCTV Matrix for proctor
        let cachedStudents = [];

        // Init view mode button states on load
        (function initViewSwitcher() {
            setMonitoringViewMode(currentViewMode, false);
        })();

        // Init charts & student monitoring grid
        initServerClock();
        initLiveCharts();
        setupSseLiveStream();

        // Real-Time Server Clock (WIB 24 Jam)
        let serverClockOffset = 0;
        async function initServerClock() {
            try {
                const res = await fetch('/api/server-time');
                if (res.ok) {
                    const data = await res.json();
                    serverClockOffset = data.timestamp - Date.now();
                }
            } catch (e) {
                console.warn('Gagal sinkronisasi waktu server:', e);
            }
            updateServerClock();
            setInterval(updateServerClock, 1000);
        }

        function updateServerClock() {
            const clockEls = document.querySelectorAll('.server-clock-display');
            if (!clockEls.length) return;
            const now = new Date(Date.now() + serverClockOffset);
            const timeStr = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Jakarta',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            }).format(now) + ' WIB';
            
            clockEls.forEach(el => {
                el.innerText = timeStr;
            });
        }

        function setMonitoringViewMode(mode, triggerRender = true) {
            currentViewMode = mode;
            localStorage.setItem('cbt_view_mode', mode);

            const btnStd = document.getElementById('btnViewStandard');
            const btnCctv = document.getElementById('btnViewCCTV');
            const container = document.getElementById('studentMonitorGrid');
            if (!container) return;

            if (mode === 'CCTV') {
                if (btnCctv) btnCctv.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-blue-600 text-white shadow flex items-center gap-1.5";
                if (btnStd) btnStd.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white flex items-center gap-1.5";
                container.className = "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2.5";
            } else {
                if (btnStd) btnStd.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-blue-600 text-white shadow flex items-center gap-1.5";
                if (btnCctv) btnCctv.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white flex items-center gap-1.5";
                container.className = "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4";
            }

            if (triggerRender && cachedStudents.length > 0) {
                renderStudentCards(cachedStudents);
            }
        }

        function getBatteryBadge(batteryStr) {
            const val = parseInt(batteryStr || '85');
            let colorClass = 'text-emerald-400 bg-emerald-950/80 border-emerald-600';
            let icon = '🔋';
            let extraAnim = '';

            if (val <= 20) {
                colorClass = 'text-red-300 bg-red-950 border-red-500 shadow-sm';
                icon = '🪫';
                extraAnim = 'animate-pulse ring-1 ring-red-500';
            } else if (val <= 50) {
                colorClass = 'text-amber-300 bg-amber-950/90 border-amber-600';
                icon = '🔋';
            }

            return `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-mono font-bold border ${colorClass} ${extraAnim}" title="Telemetri Baterai: ${val}%">
                <span>${icon}</span><span>${val}%</span>
            </span>`;
        }

        function setupSseLiveStream() {
            if (window.EventSource) {
                const sse = new EventSource('/api/cbt/monitoring-stream');
                sse.onmessage = function(event) {
                    try {
                        const data = JSON.parse(event.data);
                        updateDashboardWithData(data);
                    } catch(err) {
                        console.error('SSE Parse Error:', err);
                    }
                };
                sse.onerror = function() {
                    const badge = document.getElementById('sseStatusBadge');
                    if(badge) badge.innerText = '🟡 Reconnecting Stream...';
                };
            } else {
                loadLiveStudents();
                setInterval(loadLiveStudents, 5000);
            }
        }

        let tokenRemainingSeconds = 900;
        let tokenCountdownTimer = null;

        function startTokenCountdown(sec) {
            if (typeof sec === 'number' && sec >= 0) {
                tokenRemainingSeconds = sec;
            }
            if (tokenCountdownTimer) clearInterval(tokenCountdownTimer);

            function updateDisplay() {
                const badge = document.getElementById('tokenCountdownBadge');
                if (!badge) return;
                if (tokenRemainingSeconds <= 0) {
                    badge.innerText = '⏳ Memperbarui...';
                    badge.className = 'bg-rose-950/80 border border-rose-600/80 text-rose-300 px-2 py-0.5 rounded-lg font-mono text-xs font-bold animate-pulse';
                    return;
                }
                const m = Math.floor(tokenRemainingSeconds / 60);
                const s = tokenRemainingSeconds % 60;
                badge.innerText = `⏳ ${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                if (tokenRemainingSeconds <= 60) {
                    badge.className = 'bg-rose-950/80 border border-rose-600/80 text-rose-300 px-2 py-0.5 rounded-lg font-mono text-xs font-bold animate-pulse';
                } else if (tokenRemainingSeconds <= 180) {
                    badge.className = 'bg-amber-950/80 border border-amber-600/80 text-amber-300 px-2 py-0.5 rounded-lg font-mono text-xs font-bold';
                } else {
                    badge.className = 'bg-emerald-950/80 border border-emerald-600/80 text-emerald-300 px-2 py-0.5 rounded-lg font-mono text-xs font-bold';
                }
            }

            updateDisplay();
            tokenCountdownTimer = setInterval(() => {
                if (tokenRemainingSeconds > 0) {
                    tokenRemainingSeconds--;
                    updateDisplay();
                } else {
                    clearInterval(tokenCountdownTimer);
                    updateDisplay();
                    loadLiveStudents();
                }
            }, 1000);
        }

        function updateDashboardWithData(data) {
            const badge = document.getElementById('sseStatusBadge');
            if(badge) badge.innerText = '⚡ SSE STREAM AKTIF (Hemat 70% Bandwidth)';

            // Realtime token update via SSE
            if (data.type === 'TOKEN_UPDATED') {
                const tokenEl = document.getElementById('activeExamToken');
                if (tokenEl && data.token) {
                    tokenEl.innerText = data.token;
                    tokenEl.classList.add('animate-bounce');
                    setTimeout(() => tokenEl.classList.remove('animate-bounce'), 1000);
                }
                const repToken = document.getElementById('repTokenUsed');
                if (repToken && data.token) repToken.innerText = data.token;
                if (data.remainingSeconds !== undefined) {
                    startTokenCountdown(data.remainingSeconds);
                }
            } else if (data.type === 'TOKEN_DEACTIVATED') {
                const tokenEl = document.getElementById('activeExamToken');
                if (tokenEl) tokenEl.innerText = 'OFF';
                const repToken = document.getElementById('repTokenUsed');
                if (repToken) repToken.innerText = 'OFF';
                const badgeCountdown = document.getElementById('tokenCountdownBadge');
                if (badgeCountdown) badgeCountdown.innerText = 'OFF';
            }

            if (data.exam) {
                activeExamId = data.exam.id;
                const titleEl = document.getElementById('activeExamTitle');
                if (titleEl) titleEl.innerText = data.exam.title;
                const subEl = document.getElementById('activeExamSubtitle');
                if (subEl) subEl.innerText = `${data.exam.sessionName || 'Sesi 1'} • Durasi: ${data.exam.durationMinutes || data.exam.duration || 90} Menit`;
                const tokenEl = document.getElementById('activeExamToken');
                if (tokenEl && data.exam.token) {
                    tokenEl.innerText = (data.exam.isLive || data.exam.isTokenActive) ? data.exam.token : 'OFF';
                }
                if (data.exam.remainingSeconds !== undefined && (data.exam.isLive || data.exam.isTokenActive)) {
                    if (Math.abs(tokenRemainingSeconds - data.exam.remainingSeconds) > 5) {
                        startTokenCountdown(data.exam.remainingSeconds);
                    }
                }
            } else if (data.exam === null) {
                activeExamId = null;
                const titleEl = document.getElementById('activeExamTitle');
                if (titleEl) titleEl.innerText = 'Tidak Ada Ujian Aktif';
                const subEl = document.getElementById('activeExamSubtitle');
                if (subEl) subEl.innerText = 'Aktifkan token ujian di Bank Soal / Menu CBT untuk memulai monitoring';
                const tokenEl = document.getElementById('activeExamToken');
                if (tokenEl) tokenEl.innerText = 'OFF';
                const repToken = document.getElementById('repTokenUsed');
                if (repToken) repToken.innerText = 'OFF';
                const badgeCountdown = document.getElementById('tokenCountdownBadge');
                if (badgeCountdown) badgeCountdown.innerText = 'OFF';
            }

            if (data.counts) {
                const total = data.counts.total || 0;
                const ongoing = data.counts.ongoing || 0;
                const submitted = data.counts.submitted || 0;
                const warning = data.counts.warning || 0;
                const locked = data.counts.strike || 0;

                const donutSub = document.getElementById('liveDonutSubtitle');
                if (donutSub) donutSub.innerText = `Distribusi realtime ${total} peserta`;

                const elM = document.getElementById('statMengerjakan');
                if (elM) elM.innerText = `🟢 Mengerjakan: ${ongoing}`;
                const elS = document.getElementById('statSubmit');
                if (elS) elS.innerText = `🔵 Submit: ${submitted}`;
                const elW = document.getElementById('statWarning');
                if (elW) elW.innerText = `🟡 Peringatan: ${warning}`;
                const elL = document.getElementById('statTerkunci');
                if (elL) elL.innerText = `🔴 Terkunci: ${locked}`;

                if (chartPieInstance) {
                    chartPieInstance.data.datasets[0].data = [ongoing, submitted, warning, locked];
                    chartPieInstance.update('none');
                }
            }

            if (data.students) {
                cachedStudents = data.students;
                renderStudentCards(data.students);
            }

            if (data.recentActivities && data.recentActivities.length > 0) {
                const tickerEl = document.getElementById('tickerText');
                if (tickerEl) tickerEl.innerText = data.recentActivities.join(' • ');
            } else if (data.exam === null) {
                const tickerEl = document.getElementById('tickerText');
                if (tickerEl) tickerEl.innerText = 'Tidak ada ujian aktif. Aktifkan token ujian pada Bank Soal CBT untuk memulai monitoring.';
            }

            if (chartBarInstance && data.roomDensity) {
                if (data.roomDensity.length > 0) {
                    chartBarInstance.data.labels = data.roomDensity.map(r => r.room);
                    chartBarInstance.data.datasets[0].data = data.roomDensity.map(r => r.count);
                } else {
                    chartBarInstance.data.labels = [];
                    chartBarInstance.data.datasets[0].data = [];
                }
                chartBarInstance.update('none');
            }
        }

        function initLiveCharts() {
            // 1. Pie Status
            const ctxPie = document.getElementById('chartLiveStatusPie').getContext('2d');
            chartPieInstance = new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Mengerjakan', 'Submit', 'Belum Login', 'Disconnect'],
                    datasets: [{
                        data: [0, 0, 0, 0],
                        backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#1E293B'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    cutout: '65%'
                }
            });

            // 2. Bar Room Density
            const ctxBar = document.getElementById('chartRoomDensityBar').getContext('2d');
            chartBarInstance = new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: [],
                    datasets: [{
                        data: [],
                        backgroundColor: '#3B82F6',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { min: 0, max: 35, ticks: { font: { size: 9 }, color: '#94A3B8' }, grid: { color: '#334155' } },
                        x: { ticks: { font: { size: 9 }, color: '#CBD5E1' }, grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        function renderStudentCards(students) {
            const container = document.getElementById('studentMonitorGrid');
            if (!container) return;

            const badgeCount = document.getElementById('totalStudentsCountBadge');
            if (badgeCount) badgeCount.innerText = (students?.length || 0) + ' Siswa';
            const cctvBadge = document.getElementById('cctvCountBadge');
            if (cctvBadge) cctvBadge.innerText = (students?.length || 0) + ' Siswa';

            if (!students || students.length === 0) {
                container.className = "w-full";
                container.innerHTML = `
                    <div class="col-span-full py-20 text-center text-slate-500 bg-slate-900/50 rounded-3xl border border-slate-800">
                        <p class="text-4xl mb-3">📭</p>
                        <p class="text-sm font-bold text-slate-300">Tidak Ada Siswa yang Sedang Mengerjakan Ujian</p>
                        <p class="text-xs text-slate-500 mt-1">Saat token ujian aktif dan siswa mulai login, kartu telemetri realtime akan muncul di sini.</p>
                    </div>
                `;
                return;
            }

            if (currentViewMode === 'CCTV') {
                // ================= CCTV MATRIX MODE (30 SISWA / 1 VIEWPORT) =================
                container.className = "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2.5";
                container.innerHTML = students.map((s, idx) => {
                    const isLocked = s.status === 'LOCKED' || s.status === 'STRIKE';
                    const isSubmitted = s.status === 'SUBMITTED';
                    const isWarning = s.status === 'WARNING';

                    let cardBg = 'bg-slate-900 border-slate-700 hover:border-blue-400';
                    let statusDot = '<span class="w-2 h-2 rounded-full bg-emerald-400" title="Status: Mengerjakan"></span>';
                    let progColor = 'bg-emerald-500';

                    if (isLocked) {
                        cardBg = 'bg-red-950/40 border-red-700/80 hover:border-red-400 ring-1 ring-red-700/50';
                        statusDot = '<span class="w-2 h-2 rounded-full bg-red-400 animate-ping" title="Status: Terkunci / Pelanggaran"></span>';
                        progColor = 'bg-red-500';
                    } else if (isWarning) {
                        cardBg = 'bg-amber-950/30 border-amber-700/80 hover:border-amber-400';
                        statusDot = '<span class="w-2 h-2 rounded-full bg-amber-400" title="Status: Peringatan Strike"></span>';
                        progColor = 'bg-amber-500';
                    } else if (isSubmitted) {
                        cardBg = 'bg-blue-950/30 border-blue-800 hover:border-blue-400';
                        statusDot = '<span class="w-2 h-2 rounded-full bg-blue-400" title="Status: Selesai Submit"></span>';
                        progColor = 'bg-blue-500';
                    }

                    const progressPct = Math.min(100, Math.round(((s.currentQ || 0) / (s.totalQ || 1)) * 100));
                    const deskNo = String(idx + 1).padStart(2, '0');
                    const jsonStr = encodeURIComponent(JSON.stringify(s));

                    return `
                        <div class="p-2.5 rounded-2xl border ${cardBg} cursor-pointer transition-all shadow-md hover:scale-[1.02] flex flex-col justify-between select-none"
