<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Monitoring & Command Center Ujian CBT (UNBK Standar) - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/chart.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
        .ticker-feed {
            animation: pulse-border 2s infinite;
        }
        @keyframes pulse-border {
            0% { border-color: rgba(16, 185, 129, 0.4); }
            50% { border-color: rgba(16, 185, 129, 0.9); }
            100% { border-color: rgba(16, 185, 129, 0.4); }
        }
        @media print {
            body * { visibility: hidden !important; }
            #printableOfficialReport, #printableOfficialReport *,
            #printableStudentCardsArea, #printableStudentCardsArea *,
            #printableAttendanceArea, #printableAttendanceArea * { visibility: visible !important; }
            #printableOfficialReport, #printableStudentCardsArea, #printableAttendanceArea {
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                background: white !important;
                color: black !important;
                padding: 15px !important;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-900 text-slate-100 flex min-h-screen">
    <!-- Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content (Dark High-Tech Command Center Theme) -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen transition-all duration-300 ease-in-out">
        <!-- Header -->
        <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b border-slate-800 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-800 bg-slate-900/90 hover:bg-slate-800 text-slate-300 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div class="flex items-center gap-3">
                    <span class="p-2.5 bg-blue-600/20 border border-blue-500/40 rounded-2xl text-2xl">🖥️</span>
                    <div>
                        <h1 class="text-2xl font-black text-white tracking-wide flex items-center gap-2">
                            PROCTOR COMMAND CENTER
                        </h1>
                        <p class="text-xs text-slate-400">Monitoring Realtime Pelaksanaan Ujian CBT, Deteksi Kecurangan &amp; Berita Acara Proktor</p>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
                <div class="bg-slate-950 text-white border border-indigo-500/40 px-3.5 py-2 rounded-2xl text-xs font-bold shadow-md flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-semibold">🕒 Jam Server:</span>
                    <span class="server-clock-display font-mono text-emerald-400 font-extrabold text-xs tracking-wider">--:--:-- WIB</span>
                </div>
                <span class="bg-emerald-950 text-emerald-400 border border-emerald-600/60 px-3.5 py-2 rounded-2xl text-xs font-bold flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>LIVE SSE (3s REFRESH)</span>
                </span>
                <button onclick="openCetakKartuModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-4 py-2.5 rounded-2xl font-bold text-xs shadow flex items-center gap-1.5 transition-all">
                    <span>🪪</span> <span>Cetak Kartu Peserta</span>
                </button>
                <button onclick="openCetakAbsenModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-4 py-2.5 rounded-2xl font-bold text-xs shadow flex items-center gap-1.5 transition-all">
                    <span>📋</span> <span>Cetak Daftar Hadir</span>
                </button>
                <button onclick="openOfficialReportModal()" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-4 py-2.5 rounded-2xl font-bold text-xs shadow-lg flex items-center gap-1.5 transition-all">
                    <span>📑</span> <span>Berita Acara (BAP)</span>
                </button>
            </div>
        </div>

        <!-- 1. ACTIVE EXAM BAR & TOKEN 6-DIGIT DINAMIS -->
        <div class="bg-slate-800/90 rounded-3xl border border-slate-700 p-5 mb-6 flex flex-wrap justify-between items-center gap-4 shadow-xl">
            <div class="flex items-center gap-4">
                <div class="p-3.5 bg-blue-600/30 text-blue-400 border border-blue-500/40 rounded-2xl text-3xl font-bold">
                    🔑
                </div>
                <div>
                    <p class="text-[11px] text-slate-400 uppercase font-bold tracking-wider">Paket Asesmen / Ujian Aktif</p>
                    <h2 class="text-lg font-black text-white" id="activeExamTitle">Tidak Ada Ujian Aktif</h2>
                    <p class="text-xs text-slate-400 font-semibold mt-0.5" id="activeExamSubtitle">Aktifkan token ujian di Bank Soal / Menu CBT untuk memulai monitoring</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <div class="bg-slate-900 border border-slate-700 px-5 py-2.5 rounded-2xl text-center shadow-inner">
                    <p class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">Token Akses Ujian (6 Digit)</p>
                    <div class="flex items-center justify-center gap-2 mt-0.5">
                        <p class="text-2xl font-black font-mono text-emerald-400 tracking-widest" id="activeExamToken">OFF</p>
                        <span id="tokenCountdownBadge" class="bg-slate-800 border border-slate-700 text-slate-400 px-2 py-0.5 rounded-lg font-mono text-xs font-bold" title="Auto-refresh setiap 15 menit">OFF</span>
                    </div>
                </div>
                <button onclick="resetExamToken()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-4 py-3 rounded-2xl text-xs font-bold border border-slate-600 flex items-center gap-1.5 transition-colors shadow">
                    <span>🔄</span> <span>Acak Ulang Token</span>
                </button>
                <button onclick="deactivateExamToken()" class="bg-rose-950/70 hover:bg-rose-900 text-rose-300 px-4 py-3 rounded-2xl text-xs font-bold border border-rose-700/60 flex items-center gap-1.5 transition-colors shadow" title="Nonaktifkan token sehingga ujian ditutup sementara">
                    <span>🛑</span> <span>Hapus / Matikan Token</span>
                </button>
            </div>
        </div>

        <!-- 2. LIVE CHARTS REALTIME: STATUS PESERTA (PIE) & KEPADATAN RUANG (BAR) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <!-- Donut Status Peserta -->
            <div class="bg-slate-800/90 p-5 rounded-3xl border border-slate-700 flex flex-col justify-between shadow-lg">
                <div>
                    <h3 class="font-bold text-xs uppercase tracking-wider text-slate-300 mb-1 flex items-center gap-2">
                        <span>🥧</span> Status Peserta Ujian (Live Donut)
                    </h3>
                    <p class="text-[11px] text-slate-400 mb-3" id="liveDonutSubtitle">Distribusi realtime 0 peserta aktif</p>
                    <div class="h-48 relative flex items-center justify-center">
                        <canvas id="chartLiveStatusPie"></canvas>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 mt-3 text-[11px]">
                    <span class="p-2 bg-emerald-950/80 border border-emerald-800 text-emerald-300 rounded-xl font-bold" id="statMengerjakan">🟢 Mengerjakan: 0</span>
                    <span class="p-2 bg-blue-950/80 border border-blue-800 text-blue-300 rounded-xl font-bold" id="statSubmit">🔵 Submit: 0</span>
                    <span class="p-2 bg-amber-950/80 border border-amber-800 text-amber-300 rounded-xl font-bold" id="statWarning">🟡 Peringatan: 0</span>
                    <span class="p-2 bg-red-950/80 border border-red-800 text-red-300 rounded-xl font-bold" id="statTerkunci">🔴 Terkunci: 0</span>
                </div>
            </div>

            <!-- Bar Chart Kepadatan Ruang -->
            <div class="bg-slate-800/90 p-5 rounded-3xl border border-slate-700 flex flex-col justify-between shadow-lg">
                <div>
                    <h3 class="font-bold text-xs uppercase tracking-wider text-slate-300 mb-1 flex items-center gap-2">
                        <span>📊</span> Kepadatan Peserta per Ruang Ujian
                    </h3>
                    <p class="text-[11px] text-slate-400 mb-3">Monitoring konektivitas tiap ruang</p>
                    <div class="h-48 relative">
                        <canvas id="chartRoomDensityBar"></canvas>
                    </div>
                </div>
                <div class="p-2.5 bg-slate-900 border border-slate-700 rounded-xl text-center text-[11px] text-emerald-400 font-bold">
                    ✅ Seluruh Ruang Ujian Stabil (Rata-rata Ping: 12ms)
                </div>
            </div>

            <!-- Emergency Controls Panel -->
            <div class="bg-slate-800/90 p-5 rounded-3xl border border-slate-700 flex flex-col justify-between shadow-lg">
                <div>
                    <h3 class="font-bold text-xs uppercase tracking-wider text-slate-300 mb-1 flex items-center gap-2">
                        <span>🚨</span> Tombol Tindakan Darurat Proktor
                    </h3>
                    <p class="text-[11px] text-slate-400 mb-4">Intervensi langsung sesi ujian siswa</p>
                    
                    <div class="space-y-2.5">
                        <button onclick="emergencyBulkAddMinutes(15)" class="w-full bg-blue-600/80 hover:bg-blue-600 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between border border-blue-500/40">
                            <span>⏱️ Tambah Waktu Semua Peserta</span>
                            <span class="bg-blue-800 px-2 py-0.5 rounded-lg text-[10px] font-mono">+15 Menit</span>
                        </button>
                        <button onclick="emergencyForceSubmitAll()" class="w-full bg-amber-600/80 hover:bg-amber-600 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between border border-amber-500/40">
                            <span>💾 Force Submit Jawaban Ruang</span>
                            <span class="bg-amber-800 px-2 py-0.5 rounded-lg text-[10px]">Simpan Paksa</span>
                        </button>
                        <button onclick="emergencyUnlockAll()" class="w-full bg-emerald-600/80 hover:bg-emerald-600 text-white font-bold p-3 rounded-2xl text-xs flex items-center justify-between border border-emerald-500/40">
                            <span>🔓 Reset / Unlock Seluruh Sesi Siswa</span>
                            <span class="bg-emerald-800 px-2 py-0.5 rounded-lg text-[10px]">Buka Kunci</span>
                        </button>
                    </div>
                </div>
                <div class="p-2.5 bg-slate-900 border border-slate-700 rounded-xl text-[10px] text-slate-400 text-center">
                    🔒 Dilindungi Enkripsi Sesi Server
                </div>
            </div>
        </div>

        <!-- 3. LIVE TICKER RUNNING ACTIVITY FEED -->
        <div class="bg-slate-800/90 rounded-3xl border border-slate-700 p-4 mb-6 shadow-xl">
            <div class="flex items-center gap-3">
                <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 px-3 py-1 rounded-xl text-[11px] font-black tracking-wider flex-shrink-0 animate-pulse">
                    ⚡ LIVE FEED
                </span>
                <div class="overflow-hidden flex-1">
                    <p class="text-xs text-slate-300 font-mono truncate" id="tickerText">
                        Menghubungkan telemetri live ujian...
                    </p>
                </div>
            </div>
        </div>

        <!-- 4. GRID LIVE MONITORING PESERTA -->
        <div class="bg-slate-800/90 rounded-3xl border border-slate-700 p-6 shadow-xl">
            <div class="flex flex-wrap justify-between items-center mb-4 pb-3 border-b border-slate-700 gap-3">
                <div class="flex items-center gap-3">
                    <h3 class="font-bold text-sm text-white flex items-center gap-2">
                        <span>👥</span> Grid Status Peserta Ujian (<span id="totalStudentsCountBadge">0 Siswa</span>)
                    </h3>
                    <span class="text-xs text-slate-400">Pembaruan otomatis tiap 3 detik</span>
                </div>

                <!-- VIEW MODE SWITCHER & QUICK FILTERS -->
                <div class="flex items-center gap-3">
                    <div class="bg-slate-900 p-1 rounded-2xl border border-slate-700 flex items-center gap-1">
                        <button id="btnViewStandard" onclick="setMonitoringViewMode('STANDARD')" 
                                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white flex items-center gap-1.5">
                            <span>🔲</span> <span>Grid Standar</span>
                        </button>
                        <button id="btnViewCCTV" onclick="setMonitoringViewMode('CCTV')" 
                                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-blue-600 text-white shadow flex items-center gap-1.5">
                            <span>🎛️</span> <span>CCTV Matrix (<span id="cctvCountBadge">0 Siswa</span>)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Student Cards Container (Dynamic Grid based on Mode) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2.5" id="studentMonitorGrid">
                <!-- Injected via JS -->
            </div>
        </div>
    </main>

    <!-- MODAL QUICK ACTION PESERTA UJIAN (POPUP SAAT KLIK KARTU CCTV ATAU STANDAR) -->
    <div id="modalStudentAction" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md flex justify-center items-center z-50 p-4">
        <div class="bg-slate-900 text-white rounded-3xl w-full max-w-md overflow-hidden shadow-2xl border border-slate-700 animate-fade-in">
            <div class="p-5 border-b border-slate-800 flex justify-between items-center bg-slate-950">
                <div class="flex items-center gap-3">
                    <span class="p-2.5 bg-blue-600/30 text-blue-400 rounded-2xl text-2xl">📱</span>
                    <div>
                        <h3 class="text-sm font-bold text-white" id="modalStudentName">Nama Siswa</h3>
                        <p class="text-[11px] text-slate-400 font-mono" id="modalStudentNisn">NISN: - • Kelas: -</p>
                    </div>
                </div>
                <button onclick="closeStudentActionModal()" class="text-slate-400 hover:text-white text-2xl font-bold">&times;</button>
            </div>
            
            <div class="p-5 space-y-4">
                <!-- Telemetri HP Siswa -->
                <div class="grid grid-cols-2 gap-2.5 text-xs">
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
                        <p class="text-[10px] text-slate-400 font-bold uppercase">Baterai HP</p>
                        <p class="text-base font-black mt-1" id="modalStudentBattery">🔋 85%</p>
                    </div>
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
                        <p class="text-[10px] text-slate-400 font-bold uppercase">Status Sesi</p>
                        <p class="text-xs font-bold mt-1.5" id="modalStudentStatus">🟢 Normal</p>
                    </div>
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
                        <p class="text-[10px] text-slate-400 font-bold uppercase">Progres Soal</p>
                        <p class="text-base font-black text-blue-400 mt-1" id="modalStudentProgress">24 / 30</p>
                    </div>
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700">
                        <p class="text-[10px] text-slate-400 font-bold uppercase">Pelanggaran Strike</p>
                        <p class="text-base font-black text-amber-400 mt-1" id="modalStudentStrikes">0 / 3</p>
                    </div>
                </div>

                <div class="p-3 bg-slate-800/50 rounded-2xl border border-slate-700/60 text-[11px] text-slate-300 flex justify-between items-center">
                    <span>Perangkat: <b id="modalStudentDevice" class="text-white">Android</b></span>
                    <span>IP: <b id="modalStudentIp" class="text-white font-mono">192.168.1.1</b></span>
                </div>

                <!-- Action Buttons Intervensi Proktor -->
                <div class="space-y-2 pt-1">
                    <div class="grid grid-cols-2 gap-2 text-xs font-bold">
                        <button id="modalBtnReset" class="bg-slate-700 hover:bg-slate-600 text-white p-2.5 rounded-xl flex items-center justify-center gap-1.5 transition-colors">
                            <span>🔓</span> <span>Reset Kunci Sesi</span>
                        </button>
                        <button id="modalBtnResetDevice" class="bg-emerald-700 hover:bg-emerald-600 text-white p-2.5 rounded-xl flex items-center justify-center gap-1.5 transition-colors" title="Lepas binding perangkat agar siswa bisa langsung login di HP baru/komputer lain jika HP hang/rusak">
                            <span>🔄</span> <span>Ganti HP / Station</span>
                        </button>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs font-bold">
                        <button id="modalBtnAddTime" class="bg-amber-600/90 hover:bg-amber-600 text-white p-2.5 rounded-xl flex items-center justify-center gap-1.5 transition-colors">
                            <span>⏱️</span> <span>Tambah +15m</span>
                        </button>
                        <button id="modalBtnForceSubmit" class="bg-rose-700 hover:bg-rose-600 text-white p-2.5 rounded-xl flex items-center justify-center gap-1.5 transition-colors">
                            <span>⚡</span> <span>Force Submit</span>
                        </button>
                    </div>
                    <div>
                        <a id="modalBtnFileManager" href="/admin/files" target="_blank" class="w-full bg-blue-600 hover:bg-blue-700 text-white p-2.5 rounded-xl flex items-center justify-center gap-1.5 transition-colors shadow text-xs font-bold">
                            <span>📁</span> <span>Buka File Manager Remote HP Siswa</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL BERITA ACARA & LAPORAN RESMI UJIAN PROKTOR -->
    <div id="modalOfficialReport" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md flex justify-center items-center z-50 p-4">
        <div class="bg-white text-gray-900 rounded-3xl w-full max-w-3xl max-h-[92vh] overflow-y-auto shadow-2xl border">
            <div class="p-5 border-b flex justify-between items-center bg-slate-900 text-white rounded-t-3xl">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📑</span>
                    <h3 class="text-base font-bold">Berita Acara Pelaksanaan Asesmen / Ujian Sekolah</h3>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 px-4 py-1.5 rounded-xl text-xs font-bold shadow">🖨️ Cetak Dokumen</button>
                    <button onclick="closeOfficialReportModal()" class="text-white hover:text-gray-400 text-2xl font-bold ml-2">&times;</button>
                </div>
            </div>

            <!-- Print Document Format Standar UNBK / Kemendikbud -->
            <div class="p-8 bg-white" id="printableOfficialReport">
                <div class="flex items-center justify-between border-b-2 border-black pb-4 mb-6">
                    <div class="flex items-center gap-4">
                        <img src="/logo-tulungagung.png" alt="Logo Tulungagung" class="w-20 h-20 object-contain drop-shadow" onerror="this.src='/images/logo-tulungagung.png'">
                        <div>
                            <h3 class="font-bold text-sm uppercase tracking-wider text-slate-800">PEMERINTAH KABUPATEN TULUNGAGUNG</h3>
                            <h3 class="font-bold text-sm uppercase tracking-wider text-slate-800">DINAS PENDIDIKAN</h3>
                            <h1 class="font-black text-2xl uppercase text-slate-950 mt-0.5">SMP NEGERI 1 BOYOLANGU</h1>
                            <p class="text-xs text-gray-700 mt-0.5 font-medium">Jalan Raya Boyolangu, Kecamatan Boyolangu, Tulungagung | Telp. 0355324146 | Email: info@smpn1boyolangu.sch.id</p>
                        </div>
                    </div>
                </div>

                <div class="text-center mb-6">
                    <h4 class="font-black text-sm uppercase underline">BERITA ACARA PELAKSANAAN ASESMEN SUMATIF / CBT</h4>
                    <p class="text-xs text-gray-600 mt-1 font-mono">Nomor: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>
                </div>

                <p class="text-xs text-gray-800 leading-relaxed mb-4">
                    Pada hari ini, <b id="repDayDate">Jumat, 28 Agustus 2026</b>, di SMP Negeri 1 Boyolangu telah diselenggarakan Asesmen CBT dengan rincian sebagai berikut:
                </p>

                <table class="w-full text-xs mb-6 border-collapse">
                    <tr><td class="w-48 py-1 font-bold">Mata Pelajaran</td><td>: <span id="repSubject">Matematika Terpadu</span></td></tr>
                    <tr><td class="py-1 font-bold">Nama Asesmen / Ujian</td><td>: <span id="repExamTitle">Penilaian Akhir Semester (PAS) Ganjil</span></td></tr>
                    <tr><td class="py-1 font-bold">Tingkat / Kelas</td><td>: <span id="repClass">Semua Kelas</span></td></tr>
                    <tr><td class="py-1 font-bold">Sesi / Ruang Ujian</td><td>: <span id="repSession">Sesi 1 • Ruang CBT</span></td></tr>
                    <tr><td class="py-1 font-bold">Jumlah Peserta Terdaftar</td><td>: <span class="font-bold" id="repRegisteredCount">0 Siswa</span></td></tr>
                    <tr><td class="py-1 font-bold">Jumlah Peserta Hadir</td><td>: <span class="font-bold text-emerald-700" id="repPresentCount">0 Siswa</span></td></tr>
                    <tr><td class="py-1 font-bold">Jumlah Peserta Tidak Hadir</td><td>: <span class="font-bold text-red-600" id="repAbsentCount">0 Siswa</span></td></tr>
                    <tr><td class="py-1 font-bold">Token Akses Ujian Digunakan</td><td>: <span class="font-mono font-bold bg-gray-100 px-2 py-0.5 rounded" id="repTokenUsed">---</span></td></tr>
                </table>

                <div class="mb-6">
                    <p class="text-xs font-bold mb-1">Catatan Kejadian Khusus Selama Ujian:</p>
                    <div class="p-3 border border-gray-300 rounded-lg text-xs text-gray-700 bg-gray-50 leading-relaxed" id="repIncidentNotes">
                        Pelaksanaan asesmen berbasis CBT berjalan dengan aman, tertib, dan lancar. Sistem Exambrow Lockdown Browser berjalan optimal di seluruh perangkat siswa tanpa kendala teknis yang berarti.
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-4 text-center text-xs pt-6 mt-6 border-t">
                    <div>
                        <p class="text-gray-500">Pengawas Ruang,</p>
                        <div class="h-16"></div>
                        <p class="font-bold underline" id="bapPengawasName">Ibu Rahmawati, S.Pd</p>
                        <p class="text-[10px] text-gray-500 font-mono">NIP. 19820514 200801 2 009</p>
                    </div>
                    <div>
                        <p class="text-gray-500">Proktor Pelaksana,</p>
