                    } else if (isSubmitted) {
                        badge = '<span class="bg-blue-500/20 text-blue-400 border border-blue-500/40 px-2 py-0.5 rounded-lg text-[10px] font-bold">🔵 Selesai</span>';
                        progColor = 'bg-blue-500';
                    }

                    const progressPct = Math.min(100, Math.round(((s.currentQ || 0) / (s.totalQ || 1)) * 100));
                    const deskNo = String(idx + 1).padStart(2, '0');

                    return `
                        <div class="p-4 rounded-2xl border ${cardBg} flex flex-col justify-between shadow transition-all">
                            <div>
                                <div class="flex justify-between items-start mb-1.5">
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-[10px] font-mono font-bold text-blue-400 bg-blue-950 px-1.5 py-0.5 rounded border border-blue-800">#${deskNo}</span>
                                            <p class="font-bold text-xs text-white truncate max-w-[130px]" title="${s.name}">${s.name}</p>
                                        </div>
                                        <p class="text-[10px] text-slate-400 font-mono mt-0.5">NISN: ${s.nisn || s.username || '-'} &bull; ${s.class || '-'}</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        ${badge}
                                        ${getBatteryBadge(s.battery)}
                                    </div>
                                </div>
                                <div class="flex items-center justify-between text-[11px] mt-2 pt-2 border-t border-slate-800">
                                    <span class="text-slate-300">Soal: <b>${s.currentQ !== undefined ? s.currentQ : 0}/${s.totalQ || 0}</b></span>
                                    <span class="text-amber-400 font-mono">Sisa: ${s.timeLeft || '00:00'}</span>
                                </div>
                                <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden mt-1.5">
                                    <div class="${progColor} h-1.5 rounded-full" style="width: ${progressPct}%"></div>
