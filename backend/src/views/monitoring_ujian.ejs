        function populateClassesToFilter(selectId) {
            const sel = document.getElementById(selectId);
            if (!sel) return;
            let classesList = [];
            if (Array.isArray(serverClasses) && serverClasses.length > 0) {
                classesList = serverClasses;
            } else if (cachedStudents && cachedStudents.length > 0) {
                classesList = Array.from(new Set(cachedStudents.map(s => s.class).filter(Boolean)));
            }
            if (classesList.length > 0) {
                sel.innerHTML = '<option value="ALL">Semua Kelas Peserta</option>' +
                    classesList.map(c => `<option value="${c}">Kelas ${c}</option>`).join('');
            }
        }

        function filterAndRenderCards() {
            const filterClass = document.getElementById('selectCardClassFilter')?.value || 'ALL';
            const container = document.getElementById('studentCardsContainer');
            if (!container) return;

            const filtered = (filterClass === 'ALL')
                ? cachedStudents
                : cachedStudents.filter(s => s.class === filterClass);

            if (filtered.length === 0) {
                container.innerHTML = '<p class="col-span-2 text-center text-gray-500 py-10">Tidak ada peserta ujian di kelas ini.</p>';
                return;
            }

            container.innerHTML = filtered.map((s, idx) => {
                const photoUrl = s.avatar || '/images/default_avatar.png';
                const nisnVal = s.nisn || s.username || '0012345678';
                const pwdVal = s.password || (s.nisn ? s.nisn.substring(s.nisn.length - 6) : 'SMP01#');

                return `
                    <div class="bg-white p-4 rounded-xl border-2 border-black shadow-sm text-black flex flex-col justify-between" style="page-break-inside: avoid; min-height: 220px;">
                        <div>
                            <!-- Card Header Kop Beesmart -->
                            <div class="flex items-center gap-3 border-b-2 border-black pb-2 mb-2.5">
                                <img src="/logo-tulungagung.png" class="w-10 h-10 object-contain" onerror="this.src='/images/logo-tulungagung.png'">
                                <div class="flex-1 text-center">
                                    <h4 class="font-extrabold text-[11px] uppercase tracking-wide">KARTU PESERTA ASESMEN SUMATIF / USBK</h4>
                                    <h3 class="font-black text-xs uppercase tracking-wider">SMP NEGERI 1 BOYOLANGU</h3>
                                    <p class="text-[9px] text-gray-600">Tahun Pelajaran 2025/2026 • Boyolangu, Tulungagung</p>
                                </div>
                            </div>

                            <!-- Card Body Data Siswa -->
                            <div class="flex gap-3 text-[11px] leading-relaxed">
                                <div class="w-20 flex flex-col items-center justify-between">
                                    <img src="${photoUrl}" class="w-16 h-20 object-cover border border-gray-400 rounded shadow-sm bg-gray-100" onerror="this.src='/images/default_avatar.png'">
                                    <span class="font-mono text-[8px] font-black text-center mt-1 tracking-tighter">|||||||||||||||||</span>
                                </div>
                                <div class="flex-1 space-y-0.5">
                                    <div class="flex"><span class="w-24 font-bold text-gray-700">Nama Peserta</span><span>: <b class="uppercase">${s.name}</b></span></div>
                                    <div class="flex"><span class="w-24 font-bold text-gray-700">NISN / No. Ujian</span><span>: <b class="font-mono text-blue-900">${nisnVal}</b></span></div>
                                    <div class="flex"><span class="w-24 font-bold text-gray-700">Kelas / Rombel</span><span>: <b>${s.class || 'VII-A'}</b></span></div>
                                    <div class="flex"><span class="w-24 font-bold text-gray-700">Sesi / Ruang</span><span>: <b>Sesi 1 • Ruang ${s.class || '7A'}</b></span></div>
                                    <div class="flex"><span class="w-24 font-bold text-gray-700">Username CBT</span><span>: <b class="font-mono">${s.username || nisnVal}</b></span></div>
                                    <div class="flex"><span class="w-24 font-bold text-gray-700">Password CBT</span><span>: <b class="font-mono font-bold text-emerald-800">${pwdVal}</b></span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer TTD -->
                        <div class="flex justify-between items-end text-[9px] pt-2 mt-2 border-t border-gray-300">
                            <span class="text-gray-500 italic">*Wajib dibawa saat asesmen</span>
                            <div class="text-center">
                                <p>Panitia Asesmen,</p>
                                <div class="h-6"></div>
                                <p class="font-bold underline">Proktor Pelaksana</p>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function filterAndRenderAbsen() {
            const filterClass = document.getElementById('selectAbsenClassFilter')?.value || 'ALL';
            const tbody = document.getElementById('absenTableBody');
            if (!tbody) return;

            const filtered = (filterClass === 'ALL')
                ? cachedStudents
                : cachedStudents.filter(s => s.class === filterClass);

            const absenClassEl = document.getElementById('absenClass');
            if (absenClassEl) absenClassEl.innerText = (filterClass === 'ALL') ? 'Semua Kelas' : 'Kelas ' + filterClass;

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-gray-500">Tidak ada data siswa untuk kelas ini.</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map((s, idx) => {
                const no = idx + 1;
                const isOdd = no % 2 !== 0;
                const signLeft = isOdd ? `<span class="font-mono font-bold">${no}. ..................</span>` : '';
                const signRight = !isOdd ? `<span class="font-mono font-bold">${no}. ..................</span>` : '';
                const nisn = s.nisn || s.username || '-';

                return `
                    <tr class="text-[11px] border-b border-gray-300">
                        <td class="p-1.5 text-center font-bold border border-gray-300">${no}</td>
                        <td class="p-1.5 text-center font-mono font-bold border border-gray-300">${nisn}</td>
                        <td class="p-1.5 font-bold uppercase border border-gray-300">${s.name}</td>
                        <td class="p-1.5 text-center border border-gray-300">${s.class || 'VII-A'}</td>
                        <td class="p-1.5 w-24 border border-gray-300 text-left">${signLeft}</td>
                        <td class="p-1.5 w-24 border border-gray-300 text-left">${signRight}</td>
                        <td class="p-1.5 text-center text-[10px] text-gray-500 border border-gray-300 font-semibold">Hadir</td>
                    </tr>
                `;
            }).join('');
        }
    </script>
</body>
</html>
