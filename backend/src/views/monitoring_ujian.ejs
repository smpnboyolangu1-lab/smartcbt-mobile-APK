            } else {
                // ================= STANDARD GRID MODE =================
                container.className = "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4";
                container.innerHTML = students.map((s, idx) => {
                    const isLocked = s.status === 'LOCKED' || s.status === 'STRIKE';
                    const isSubmitted = s.status === 'SUBMITTED';
                    const isWarning = s.status === 'WARNING';

                    let badge = '<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 px-2 py-0.5 rounded-lg text-[10px] font-bold">🟢 Mengerjakan</span>';
                    let cardBg = 'bg-slate-900 border-slate-700';
