                                    🔓 Reset
                                </button>
                                <button onclick="emergencyAddExtraTimeStudent('${s.id}')" class="bg-amber-600/30 hover:bg-amber-600/50 text-amber-300 border border-amber-500/30 px-2 py-1.5 rounded-lg font-bold">
                                    +15m
                                </button>
                                <button onclick="emergencyForceSubmitStudent('${s.id}')" class="bg-red-600/40 hover:bg-red-600 text-red-200 px-2 py-1.5 rounded-lg font-bold">
                                    ⚡ Submit
                                </button>
                                <a href="/admin/files" target="_blank" title="Buka Remote File Manager Siswa" class="bg-blue-600 hover:bg-blue-700 text-white px-2.5 py-1.5 rounded-lg font-bold flex items-center justify-center shadow">
                                    📁
                                </a>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        let activeExamId = null;

        // Modal Quick Action CCTV
        function openStudentActionModal(jsonEncodedStr, deskNo) {
            try {
                const s = JSON.parse(decodeURIComponent(jsonEncodedStr));
                document.getElementById('modalStudentName').innerText = `#${deskNo || ''} ${s.name}`;
                document.getElementById('modalStudentNisn').innerText = `NISN: ${s.nisn || s.username || '-'} • Kelas: ${s.class || '-'}`;
                document.getElementById('modalStudentBattery').innerHTML = getBatteryBadge(s.battery);
                document.getElementById('modalStudentStatus').innerText = s.status || 'NORMAL';
                document.getElementById('modalStudentProgress').innerText = `${s.currentQ !== undefined ? s.currentQ : 0} / ${s.totalQ || 0} Butir Soal`;
                document.getElementById('modalStudentStrikes').innerText = `${s.strikes || 0} / 3 Kali`;
                document.getElementById('modalStudentDevice').innerText = s.device || 'SmartSchool ExamBrowser (Android)';
                document.getElementById('modalStudentIp').innerText = s.ip || '192.168.101.x';

                // Update BAP Student metadata automatically
                const bapStudentEl = document.getElementById('bapStudentName');
                if (bapStudentEl) bapStudentEl.innerText = `(${s.name.toUpperCase()})`;
                const bapNisnEl = document.getElementById('bapStudentNisn');
                if (bapNisnEl) bapNisnEl.innerText = `NISN / Siswa: ${s.nisn || s.username || '-'}`;

                document.getElementById('modalBtnReset').onclick = () => { emergencyUnlockStudent(s.id); closeStudentActionModal(); };
                const btnResetDev = document.getElementById('modalBtnResetDevice');
                if (btnResetDev) btnResetDev.onclick = () => { emergencyProctorResetStudent(s.id); closeStudentActionModal(); };
                document.getElementById('modalBtnAddTime').onclick = () => { emergencyAddExtraTimeStudent(s.id); closeStudentActionModal(); };
                document.getElementById('modalBtnForceSubmit').onclick = () => { emergencyForceSubmitStudent(s.id); closeStudentActionModal(); };

                document.getElementById('modalStudentAction').classList.remove('hidden');
            } catch(e) {
                console.error('Error opening student action modal:', e);
            }
        }

        function closeStudentActionModal() {
            document.getElementById('modalStudentAction').classList.add('hidden');
        }

        async function loadLiveStudents() {
            try {
                const res = await fetch('/api/cbt/monitoring-live?className=ALL', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.exam) {
                    activeExamId = data.exam.id;
                    const titleEl = document.getElementById('activeExamTitle');
                    if (titleEl) titleEl.innerText = data.exam.title;
                    const subEl = document.getElementById('activeExamSubtitle');
                    if (subEl) subEl.innerText = `${data.exam.sessionName || 'Sesi 1'} • Durasi: ${data.exam.durationMinutes || 90} Menit`;
                    const tokenEl = document.getElementById('activeExamToken');
                    if (tokenEl) tokenEl.innerText = data.exam.isTokenActive ? (data.exam.token || 'OFF') : 'OFF';
                    const repToken = document.getElementById('repTokenUsed');
                    if (repToken) repToken.innerText = data.exam.token || 'OFF';
                    const repTitle = document.getElementById('repExamTitle');
                    if (repTitle) repTitle.innerText = data.exam.title;
                    const repSubj = document.getElementById('repSubject');
                    if (repSubj && data.exam.subject) repSubj.innerText = data.exam.subject.name || 'Mata Pelajaran';
                    if (data.exam.remainingSeconds !== undefined && data.exam.isTokenActive) {
                        startTokenCountdown(data.exam.remainingSeconds);
                    }
                } else {
                    activeExamId = null;
                    const titleEl = document.getElementById('activeExamTitle');
                    if (titleEl) titleEl.innerText = 'Tidak Ada Ujian Aktif';
                    const subEl = document.getElementById('activeExamSubtitle');
                    if (subEl) subEl.innerText = 'Aktifkan token ujian di Bank Soal / Menu CBT untuk memulai monitoring';
                    const tokenEl = document.getElementById('activeExamToken');
                    if (tokenEl) tokenEl.innerText = 'OFF';
                    const repToken = document.getElementById('repTokenUsed');
                    if (repToken) repToken.innerText = 'OFF';
                    const repTitle = document.getElementById('repExamTitle');
                    if (repTitle) repTitle.innerText = '-';
                    const repSubj = document.getElementById('repSubject');
                    if (repSubj) repSubj.innerText = '-';
                    const badgeCountdown = document.getElementById('tokenCountdownBadge');
                    if (badgeCountdown) badgeCountdown.innerText = 'OFF';
                }
                if (data.students) {
                    cachedStudents = data.students;
                    renderStudentCards(data.students);
                }
                if (chartBarInstance && data.roomDensity) {
                    if (data.roomDensity.length > 0) {
                        chartBarInstance.data.labels = data.roomDensity.map(r => r.room);
                        chartBarInstance.data.datasets[0].data = data.roomDensity.map(r => r.count);
                    } else {
                        chartBarInstance.data.labels = [];
                        chartBarInstance.data.datasets[0].data = [];
                    }
                    chartBarInstance.update('none');
                }
            } catch(e) {
                console.error('Error loading live student telemetry:', e);
            }
        }

        async function openOfficialReportModal() {
            try {
                if (activeExamId) {
                    const rRes = await fetch(`/api/cbt/exams/${activeExamId}/official-report`, {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    if (rRes.ok) {
                        const rData = await rRes.json();
                        if (rData.date) document.getElementById('repDayDate').innerText = rData.date;
                        if (rData.subjectName) document.getElementById('repSubject').innerText = rData.subjectName;
                        if (rData.examTitle) document.getElementById('repExamTitle').innerText = rData.examTitle;
                        if (rData.targetClasses) document.getElementById('repClass').innerText = rData.targetClasses;
                        if (rData.sessionName) document.getElementById('repSession').innerText = `${rData.sessionName} • ${rData.roomName || 'Ruang CBT'}`;
                        if (rData.registeredCount !== undefined) document.getElementById('repRegisteredCount').innerText = `${rData.registeredCount} Siswa`;
                        if (rData.presentCount !== undefined) document.getElementById('repPresentCount').innerText = `${rData.presentCount} Siswa`;
                        if (rData.absentCount !== undefined) {
                            const absentDetail = rData.absentList && rData.absentList.length > 0 
                                ? ` (${rData.absentList.map(a => a.name).join(', ')})`
                                : '';
                            document.getElementById('repAbsentCount').innerText = `${rData.absentCount} Siswa${absentDetail}`;
                        }
                        if (rData.tokenUsed) document.getElementById('repTokenUsed').innerText = rData.tokenUsed;
                        if (rData.incidentNotes) document.getElementById('repIncidentNotes').innerText = rData.incidentNotes;
                        if (rData.invigilatorName) document.getElementById('bapPengawasName').innerText = rData.invigilatorName;
                        if (rData.proctorName) document.getElementById('bapProktorName').innerText = rData.proctorName;
                        if (rData.headmasterName) document.getElementById('bapHeadmasterName').innerText = rData.headmasterName;
                        if (rData.headmasterNip) document.getElementById('bapHeadmasterNip').innerText = rData.headmasterNip;
                        if (rData.headmasterTitle) document.getElementById('bapHeadmasterTitle').innerText = rData.headmasterTitle;
                    }
                } else {
                    const scRes = await fetch('/api/school-info');
                    if (scRes.ok) {
                        const scData = await scRes.json();
                        if (scData.headmasterName) {
                            document.getElementById('bapHeadmasterName').innerText = scData.headmasterName;
                        }
                        if (scData.headmasterNip) {
                            document.getElementById('bapHeadmasterNip').innerText = 'NIP. ' + scData.headmasterNip;
                        }
                        if (scData.schoolName) {
                            document.getElementById('bapHeadmasterTitle').innerText = 'Kepala ' + scData.schoolName;
                        }
                    }
                }
            } catch (e) {
                console.warn('Gagal memuat berita acara ujian:', e);
            }
            document.getElementById('modalOfficialReport').classList.remove('hidden');
        }

        function closeOfficialReportModal() {
            document.getElementById('modalOfficialReport').classList.add('hidden');
        }

        async function resetExamToken() {
            if (!activeExamId) {
                alert('Tidak ada ujian aktif untuk diacak tokennya.');
                return;
            }
            if (!confirm('Acak ulang token ujian sekarang? Seluruh proktor dan aplikasi APK siswa akan otomatis memperbarui token.')) return;
            try {
                const res = await fetch('/api/cbt/regenerate-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ examId: activeExamId })
                });
                const data = await res.json();
                if (res.ok && data.token) {
                    document.getElementById('activeExamToken').innerText = data.token;
                    const repToken = document.getElementById('repTokenUsed');
                    if (repToken) repToken.innerText = data.token;
                    startTokenCountdown(data.remainingSeconds || 900);
                    alert(`✅ Token ujian berhasil diacak ulang menjadi: ${data.token}\nToken otomatis tampil di seluruh APK Guru Pengawas dan Portal.`);
                } else {
                    alert('Gagal mengacak token: ' + (data.message || 'Error'));
                }
            } catch (err) {
                alert('Terjadi kesalahan jaringan saat mengacak token.');
            }
        }

        async function deactivateExamToken() {
            if (!activeExamId) {
                alert('Tidak ada ujian aktif.');
                return;
            }
            if (!confirm('Nonaktifkan / Hapus token ujian aktif? Siswa tidak akan dapat memulai sesi ujian hingga token diaktifkan kembali.')) return;
            try {
                const res = await fetch('/api/cbt/toggle-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ examId: activeExamId, clearToken: true })
                });
                const data = await res.json();
                if (res.ok) {
                    document.getElementById('activeExamToken').innerText = 'OFF';
                    alert('🛑 Token ujian berhasil dinonaktifkan. Akses ujian via APK ditutup sementara.');
                } else {
                    alert('Gagal menonaktifkan token: ' + (data.message || 'Error'));
                }
            } catch (err) {
                alert('Terjadi kesalahan saat mematikan token.');
            }
        }

        async function emergencyUnlockStudent(id) {
            try {
                const res = await fetch(`/api/cbt/student/${id}/reset-lock`, {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Sesi siswa berhasil di-reset / dibuka kuncinya.'));
                    loadLiveStudents();
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function emergencyProctorResetStudent(id) {
            if (!confirm('Reset kuncian dan lepas binding perangkat siswa ini?\nSiswa dapat langsung login di HP / komputer baru jika HP sebelumnya bermasalah/hang.')) return;
            try {
                const res = await fetch('/api/cbt/proctor-reset-lock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ examId: activeExamId, studentId: id })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Kunci perangkat berhasil dilepas. Siswa dapat login kembali di perangkat baru.'));
                    loadLiveStudents();
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function emergencyAddExtraTimeStudent(id) {
            try {
                const res = await fetch(`/api/cbt/student/${id}/add-time`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ minutes: 15, extraMinutes: 15 })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('⏱️ ' + (data.message || 'Waktu ujian siswa berhasil ditambahkan +15 menit.'));
                    loadLiveStudents();
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function emergencyForceSubmitStudent(id) {
            if (!confirm('Simpan paksa dan selesaikan jawaban ujian siswa ini sekarang?')) return;
            try {
                const res = await fetch(`/api/cbt/student/${id}/force-submit`, {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok) {
                    alert('⚡ ' + (data.message || 'Jawaban ujian siswa berhasil disimpan paksa ke server.'));
                    loadLiveStudents();
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function emergencyUnlockAll() {
            if (!confirm('Buka kunci dan reset seluruh sesi siswa yang terkunci di ruangan?')) return;
            try {
                const res = await fetch('/api/cbt/emergency-unlock-all', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ examId: activeExamId })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('🔓 ' + (data.message || 'Seluruh sesi peserta berhasil di-unlock.'));
                    loadLiveStudents();
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Error'));
                }
            } catch (e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function emergencyBulkAddMinutes(mins) {
            if (!confirm(`Tambahkan ${mins} menit waktu ujian untuk seluruh peserta di ruang ujian?`)) return;
            if (cachedStudents && cachedStudents.length > 0) {
                for (const s of cachedStudents) {
                    fetch(`/api/cbt/student/${s.id}/add-time`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({ minutes: mins, extraMinutes: mins })
                    }).catch(() => {});
                }
            }
            alert(`⏱️ Perintah penambahan +${mins} menit telah dikirim ke seluruh sesi siswa aktif.`);
            loadLiveStudents();
        }

        async function emergencyForceSubmitAll() {
            if (!confirm('PERINGATAN: Simpan paksa seluruh jawaban peserta di ruangan dan akhiri ujian?')) return;
            if (cachedStudents && cachedStudents.length > 0) {
                for (const s of cachedStudents) {
                    if (s.status !== 'SUBMITTED') {
                        fetch(`/api/cbt/student/${s.id}/force-submit`, {
                            method: 'POST',
                            headers: { 'Authorization': 'Bearer ' + token }
                        }).catch(() => {});
                    }
                }
            }
            alert('💾 Seluruh jawaban peserta berhasil disimpan ke database server.');
            loadLiveStudents();
        }

