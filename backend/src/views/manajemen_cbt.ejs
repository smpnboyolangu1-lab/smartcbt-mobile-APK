        async function submitConfirmedAiExam() {
            if(!currentAiDraft || !currentAiDraft.questions) return;

            const btn = document.getElementById('btnConfirmAiExam');
            btn.innerText = '⏳ Menyimpan ke Bank Soal...';
            btn.disabled = true;

            const verifiedQuestions = currentAiDraft.questions.map((q, idx) => {
                const contentEl = document.getElementById('q_content_' + idx);
                const optAEl = document.getElementById('q_optA_' + idx);
                const optBEl = document.getElementById('q_optB_' + idx);
                const optCEl = document.getElementById('q_optC_' + idx);
                const optDEl = document.getElementById('q_optD_' + idx);
                const keyEl = document.getElementById('q_key_' + idx);

                return {
                    orderNum: idx + 1,
                    type: q.type || 'MULTIPLE_CHOICE',
                    content: contentEl ? contentEl.value : q.content,
                    options: {
                        A: optAEl ? optAEl.value : (q.options?.A || ''),
                        B: optBEl ? optBEl.value : (q.options?.B || ''),
                        C: optCEl ? optCEl.value : (q.options?.C || ''),
                        D: optDEl ? optDEl.value : (q.options?.D || '')
                    },
                    correctOption: keyEl ? keyEl.value : q.correctOption,
                    imageUrl: q.imageUrl || null,
                    audioUrl: q.audioUrl || null
                };
            });

            const payload = {
                title: currentAiDraft.title,
                subjectName: currentAiDraft.subjectName,
                durationMinutes: currentAiDraft.durationMinutes,
                assignedClasses: currentAiDraft.assignedClasses,
                questions: verifiedQuestions
            };

            try {
                const res = await fetch('/api/exams/confirm-import', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(res.ok) {
                    alert(data.message || 'Paket soal terverifikasi berhasil disimpan ke Bank Soal!');
                    document.getElementById('modalAiExtract').classList.add('hidden');
                    loadExams();
                } else {
                    alert(data.message || 'Gagal menyimpan paket soal terverifikasi');
                }
            } catch(err) {
                alert('Terjadi kesalahan saat menyimpan paket soal');
            } finally {
                btn.innerText = '✅ Konfirmasi & Simpan ke Bank Soal';
                btn.disabled = false;
            }
        }

