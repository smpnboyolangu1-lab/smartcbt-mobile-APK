        async function cloneHomeworkPrompt(homeworkId, title) {
            const targetClass = prompt(`Kloning tugas "${title}" ke kelas Anda:\nMasukkan Nama Rombel Kelas Tujuan (contoh: VII-A atau VII-B):`);
            if (!targetClass || targetClass.trim().length === 0) return;

            try {
                const res = await fetch(`/api/teacher/homeworks/${homeworkId}/clone`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ targetClassName: targetClass.trim().toUpperCase() })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ ' + data.message);
                    loadCollaborativeHomeworks();
                } else {
                    alert('❌ Gagal: ' + data.message);
                }
            } catch (e) {
                alert('❌ Kesalahan jaringan.');
            }
        }

