        async function handleQuestionImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async () => {
                try {
                    const res = await fetch('/api/questions/upload-image', {
                        method: 'POST',
                        headers: {
                            'Authorization': 'Bearer ' + token,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            imageBase64: reader.result,
                            fileName: file.name
                        })
                    });
                    const data = await res.json();
                    if (res.ok && data.imageUrl) {
                        document.getElementById('qeImageUrl').value = data.imageUrl;
                        document.getElementById('qeImagePreviewNotice').classList.remove('hidden');

                        // Sisipkan otomatis ke TinyMCE atau Textarea
                        if (typeof tinymce !== 'undefined' && tinymce.get('qeContentEditor')) {
                            tinymce.get('qeContentEditor').insertContent(`<p><img src="${data.imageUrl}" alt="Diagram Soal" style="max-width: 100%; height: auto; border-radius: 8px; margin: 8px 0;" /></p>`);
                        } else {
                            const ta = document.getElementById('qeContentEditor');
                            if (ta) ta.value += `<p><img src="${data.imageUrl}" alt="Diagram Soal" style="max-width: 100%; height: auto; border-radius: 8px; margin: 8px 0;" /></p>`;
                        }
                        alert('✅ ' + data.message);
                    } else {
                        alert('❌ ' + (data.message || 'Gagal upload gambar'));
                    }
                } catch(e) {
                    alert('❌ Terjadi kesalahan saat upload gambar');
                }
            };
            reader.readAsDataURL(file);
        }

        async function handleSaveQuestion(e) {
            e.preventDefault();
            if (!activeExamIdForQuestions) return;

            let content = '';
            if (typeof tinymce !== 'undefined' && tinymce.get('qeContentEditor')) {
                content = tinymce.get('qeContentEditor').getContent();
            } else {
                content = document.getElementById('qeContentEditor').value;
            }

            if (!content || content.trim().length === 0) {
                alert('Teks konten soal wajib diisi');
                return;
            }

            const qId = document.getElementById('qeQuestionId').value;
            const qType = document.getElementById('qeType').value;
            const audioUrl = document.getElementById('qeAudioUrl').value.trim();

            let options = null;
            let correctOption = '';

            if (qType === 'ESSAY') {
                correctOption = document.getElementById('qeEssayRubric').value.trim() || 'Jawaban Uraian';
            } else {
                options = {
                    A: document.getElementById('qeOptA').value.trim(),
                    B: document.getElementById('qeOptB').value.trim(),
                    C: document.getElementById('qeOptC').value.trim(),
                    D: document.getElementById('qeOptD').value.trim()
                };
                if (qType === 'MULTIPLE_CHOICE_5') {
                    options.E = document.getElementById('qeOptE').value.trim();
                }
                correctOption = document.getElementById('qeCorrectOption').value;

                if (!options.A || !options.B || !options.C || !options.D) {
                    alert('Harap isi opsi pilihan jawaban A, B, C, dan D');
                    return;
                }
                if (qType === 'MULTIPLE_CHOICE_5' && !options.E) {
                    alert('Harap isi opsi pilihan jawaban E untuk soal pilihan ganda 5 opsi');
                    return;
                }
            }

            const cognitiveLevel = document.getElementById('qeCognitiveLevel').value;
            const kdTag = document.getElementById('qeKdTag').value;
            const imageUrl = document.getElementById('qeImageUrl').value;

            const payload = {
                content,
                type: qType === 'MULTIPLE_CHOICE_5' ? 'MULTIPLE_CHOICE' : qType,
                correctOption,
                options,
                cognitiveLevel,
                kdTag,
                imageUrl: imageUrl || null,
                audioUrl: audioUrl || null
            };

            const btn = document.getElementById('btnSaveQuestion');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            try {
                let res;
                if (qId) {
                    res = await fetch(`/api/guru/exams/${activeExamIdForQuestions}/questions/${qId}`, {
                        method: 'PUT',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                } else {
                    res = await fetch(`/api/guru/exams/${activeExamIdForQuestions}/questions`, {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                }

                if (res.ok) {
                    await loadExamQuestionsList(activeExamIdForQuestions);
                    initNewQuestionForm();
                    alert('✅ Butir soal berhasil disimpan!');
                } else {
                    const data = await res.json();
                    alert('❌ ' + (data.message || 'Gagal menyimpan soal'));
                }
            } catch(err) {
                alert('❌ Terjadi kesalahan jaringan');
            } finally {
                btn.disabled = false;
                btn.innerText = '💾 Simpan Butir Soal';
            }
        }

