        async function submitSendTransfer(event) {
            event.preventDefault();
            const recipientId = document.getElementById('transferRecipientSelect').value;
            const recipientName = document.getElementById('transferRecipientSelect').selectedOptions[0]?.text || '';
            const title = document.getElementById('transferTitleInput').value;
            const subjectName = document.getElementById('transferSubjectInput').value;
            const level = document.getElementById('transferLevelSelect').value;
            const examId = document.getElementById('transferExamSelect').value || null;
            const notes = document.getElementById('transferNotesInput').value;
            const fileInput = document.getElementById('transferFileInput');

            let fileUrl = null;
            let fileName = null;
            let fileType = null;
            let fileSize = 0;

            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                fileName = file.name;
                fileType = file.type || file.name.split('.').pop();
                fileSize = file.size;

                const formData = new FormData();
                formData.append('file', file);
                try {
                    const uploadRes = await fetch('/api/cbt/upload-asset', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token },
                        body: formData
                    });
                    const uploadData = await uploadRes.json();
                    if (uploadData.url) {
                        fileUrl = uploadData.url;
                    }
                } catch (e) {
                    fileUrl = `/uploads/${file.name}`;
                }
            }

            try {
                const res = await fetch('/api/teacher/transfer/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({
                        recipientTeacherId: recipientId,
                        recipientName,
                        title,
                        subjectName,
                        level,
                        examId,
                        fileUrl,
                        fileName,
                        fileType,
                        fileSize,
                        notes
                    })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ Berkas / Naskah soal berhasil dikirim ke guru tujuan.');
                    document.getElementById('modalSendTransfer').classList.add('hidden');
                    loadTeacherTransfers();
                } else {
                    alert('❌ Gagal: ' + data.message);
                }
            } catch (e) {
                alert('❌ Kesalahan jaringan.');
            }
        }

        async function respondTransfer(id, status) {
            try {
                const res = await fetch(`/api/teacher/transfer/${id}/respond`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ status })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ ' + data.message);
                    loadTeacherTransfers();
                    loadExams();
                } else {
                    alert('❌ ' + data.message);
                }
            } catch (e) {
                alert('❌ Kesalahan jaringan.');
            }
        }

