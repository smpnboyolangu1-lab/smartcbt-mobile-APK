<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/js/tailwind.js"></script>
    <!-- TinyMCE CDN -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js"></script>
    <!-- KaTeX CDN untuk rendering rumus matematika LaTeX -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <!-- MathLive CDN untuk keyboard virtual rumus matematika -->
    <script defer src="https://cdn.jsdelivr.net/npm/mathlive"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
        .tab-btn {
            color: #64748B;
            background: transparent;
            border: 1.5px solid transparent;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .tab-btn:hover {
            color: #0F172A;
            background: #F1F5F9;
        }
        .tab-btn.active {
            color: #1D4ED8 !important;
            background: #EFF6FF !important;
            border-color: #BFDBFE !important;
            font-weight: 800;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        @media print {
            body * { visibility: hidden; }
            #printResultArea, #printResultArea *,
            #printableBankSoalArea, #printableBankSoalArea *,
            #printableLjsArea, #printableLjsArea * { visibility: visible; }
            #printResultArea, #printableBankSoalArea, #printableLjsArea {
                position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 16px; background: white !important;
            }
            .no-print { display: none !important; }
        }
        math-field {
            font-size: 1.15rem;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1.5px solid #CBD5E1;
            background: white;
            width: 100%;
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <!-- Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Top Header Bar -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 pb-4 border-b border-slate-200/80">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-7 bg-blue-600 rounded-full"></div>
                        <h1 class="text-2xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                            <span>📝</span> CBT &amp; Bank Soal Sekolah
                        </h1>
                        <span class="bg-blue-50 text-blue-700 text-xs font-bold px-2.5 py-1 rounded-full border border-blue-200/60">CBT Center</span>
                    </div>
                    <p class="text-slate-500 text-xs mt-1 ml-5">Bank Soal Multi-Format (Word, Excel, PDF), Ekstraksi Soal AI Gemini, Penjadwalan Ujian Komprehensif, dan Rekap Hasil</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 self-end md:self-auto">
                <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border border-indigo-500/40 px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-semibold">🕒 Jam Server:</span>
                    <span id="serverLiveClock" class="server-clock-display font-mono text-emerald-400 font-extrabold text-sm tracking-wider">--:--:-- WIB</span>
                </div>
            </div>
        </header>

        <!-- Action Toolbar -->
        <div class="flex flex-wrap justify-between items-center gap-3 mb-6 bg-white p-3.5 rounded-2xl border border-slate-200/80 shadow-sm">
            <div class="flex flex-wrap items-center gap-2">
                <a href="/api/cbt/template/excel" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-xl shadow-sm text-xs font-bold flex items-center gap-1.5 transition-all">
                    <span>📥</span> Template Excel
                </a>
                <a href="/api/cbt/template/word" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-2 rounded-xl shadow-sm text-xs font-bold flex items-center gap-1.5 transition-all">
                    <span>📄</span> Panduan Word
                </a>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button onclick="openAiGeneratorModal()" class="bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white px-3.5 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>🤖</span> Buat Soal AI
                </button>
                <button onclick="openAiModal()" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white px-3.5 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>✨</span> Import Soal AI (Word/Excel/PDF)
                </button>
                <button onclick="openScheduleModal()" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>📅</span> Jadwalkan Ujian
                </button>
                <button onclick="openAddExamModal()" class="bg-slate-800 hover:bg-black text-white px-3.5 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>➕</span> Buat Bank Soal
                </button>
            </div>
        </div>

        <%
            const curTab = typeof activeTab !== 'undefined' ? String(activeTab).toLowerCase() : 'jadwal';
            const isTabHasil = ['hasil', 'grades', 'nilai', 'rekap'].includes(curTab);
            const isTabAnalisis = ['analisis', 'analysis', 'butir'].includes(curTab);
            const isTabSoal = ['soal', 'bank'].includes(curTab);
            const isTabTugas = curTab === 'tugas';
            const isTabTransfer = curTab === 'transfer';
            const isTabJadwal = !isTabHasil && !isTabAnalisis && !isTabSoal && !isTabTugas && !isTabTransfer;
        %>
        <!-- Navigation Tabs Modern Executive Pill Design -->
        <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-sm border border-slate-200/80 mb-6 p-2 flex flex-wrap items-center gap-1.5 text-xs font-bold">
            <button onclick="switchTab('jadwal')" class="tab-btn <%= isTabJadwal ? 'active' : '' %> px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all cursor-pointer" id="tab-jadwal">
                <span class="text-sm">📅</span>
                <span>Jadwal &amp; Sesi Ujian</span>
                <span id="countSchedule" class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full text-[10px] font-extrabold">0</span>
            </button>
            <button onclick="switchTab('soal')" class="tab-btn <%= isTabSoal ? 'active' : '' %> px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all cursor-pointer" id="tab-soal">
                <span class="text-sm">📦</span>
                <span>Bank Paket Soal</span>
                <span id="countExams" class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-full text-[10px] font-extrabold">0</span>
            </button>
            <button onclick="switchTab('tugas')" class="tab-btn <%= isTabTugas ? 'active' : '' %> px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all cursor-pointer" id="tab-tugas">
                <span class="text-sm">📚</span>
                <span>Bank Tugas Kolaboratif</span>
            </button>
            <button onclick="switchTab('transfer')" class="tab-btn <%= isTabTransfer ? 'active' : '' %> px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all cursor-pointer" id="tab-transfer">
                <span class="text-sm">🔄</span>
                <span>Transfer File Antar Guru</span>
            </button>
            <button onclick="switchTab('hasil')" class="tab-btn <%= isTabHasil ? 'active' : '' %> px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all cursor-pointer" id="tab-hasil">
                <span class="text-sm">📊</span>
                <span>Rekap Nilai Siswa</span>
                <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full text-[10px] font-extrabold">KKM 75</span>
            </button>
            <button onclick="switchTab('analisis')" class="tab-btn <%= isTabAnalisis ? 'active' : '' %> px-4 py-2.5 rounded-xl flex items-center gap-2 transition-all cursor-pointer" id="tab-analisis">
                <span class="text-sm">📈</span>
                <span>Analisis Butir &amp; Psikometrik</span>
                <span class="bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded-full text-[10px] font-extrabold">Riset</span>
            </button>
            <a href="/monitoring" class="ml-auto bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-800 hover:to-indigo-800 text-white px-4 py-2 rounded-xl text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all" title="Buka Proctor Command Center UNBK">
                <span>🖥️</span> Ruang Proktor UNBK Live ↗
            </a>
        </div>

        <!-- TAB 1: PENJADWALAN UJIAN -->
        <div id="section-jadwal" class="<%= isTabJadwal ? '' : 'hidden' %> space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="scheduleCardGrid">
                <p class="text-gray-400 py-6 text-sm col-span-3 text-center">Memuat jadwal ujian...</p>
            </div>
        </div>

        <!-- TAB 2: BANK SOAL & PAKET UJIAN -->
        <div id="section-soal" class="<%= isTabSoal ? '' : 'hidden' %> space-y-6">
            <!-- Modern Bank Soal KPI Stats Ribbon -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-black">📦</div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Bank Paket</p>
                        <p class="text-2xl font-black text-slate-800" id="bankStatTotalExams">0</p>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-black">📝</div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Butir Soal</p>
                        <p class="text-2xl font-black text-emerald-700" id="bankStatTotalQuestions">0</p>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-black">⚡</div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Sesi Ujian Aktif</p>
                        <p class="text-2xl font-black text-purple-700" id="bankStatActiveExams">0</p>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-black">⏱️</div>
                    <div>
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Rata-Rata Durasi</p>
                        <p class="text-2xl font-black text-amber-700" id="bankStatAvgDuration">90m</p>
                    </div>
                </div>
            </div>

            <!-- Toolbar & Filter Bar Bank Soal -->
            <div class="bg-white rounded-2xl shadow-sm p-4 border border-slate-200/80 flex flex-wrap justify-between items-center gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <div class="relative min-w-[260px]">
                        <input type="text" id="searchBankSoalInput" placeholder="Cari nama ujian / mapel / token..." oninput="filterBankSoalTable()" class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span class="absolute left-3 top-2.5 text-slate-400 text-xs">🔍</span>
                    </div>
                    <div>
                        <select id="filterBankSubject" onchange="filterBankSoalTable()" class="py-2 px-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700">
                            <option value="ALL">Semua Mata Pelajaran</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="openAddExamModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all">
                        <span>➕</span> Buat Bank Soal
                    </button>
                    <button onclick="openAiGeneratorModal()" class="bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all">
                        <span>🤖</span> Buat Soal AI
                    </button>
                    <button onclick="openAiModal()" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow-sm flex items-center gap-1.5 transition-all">
                        <span>✨</span> Import File AI
                    </button>
                </div>
            </div>

            <!-- Professional Bank Soal Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
                <div class="p-4 border-b bg-slate-50/80 flex justify-between items-center">
                    <div>
                        <h3 class="font-extrabold text-slate-800 text-sm">Repositori Paket Ujian &amp; Naskah Soal Terpadu</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Daftar naskah resmi sekolah untuk Penilaian Harian, PTS, PAS, Asesmen Madrasah / Sekolah</p>
                    </div>
                    <span class="text-xs bg-blue-100 text-blue-800 font-bold px-3 py-1 rounded-full" id="bankTableCountBadge">0 Paket Terdaftar</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse whitespace-nowrap text-xs">
                        <thead>
                            <tr class="bg-slate-100/80 text-slate-700 uppercase tracking-wider font-bold">
                                <th class="p-3.5 border-b text-center w-12">No</th>
                                <th class="p-3.5 border-b">Judul Paket Ujian &amp; Mapel</th>
                                <th class="p-3.5 border-b text-center">Jumlah Soal</th>
                                <th class="p-3.5 border-b text-center">Durasi</th>
                                <th class="p-3.5 border-b text-center">Token Ujian</th>
                                <th class="p-3.5 border-b text-center">Status Sesi</th>
                                <th class="p-3.5 border-b text-center">Aksi Manajemen Naskah</th>
                            </tr>
                        </thead>
                        <tbody id="examTableBody">
                            <tr><td colspan="7" class="p-8 text-center text-gray-500">Memuat data paket soal...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB BARU: AREA 2 - BANK TUGAS & PR GURU KOLABORATIF -->
        <div id="section-tugas" class="<%= isTabTugas ? '' : 'hidden' %> space-y-6">
            <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-2xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-2xl p-2 bg-emerald-100 rounded-xl">📚</span>
                    <div>
                        <h3 class="font-extrabold text-emerald-950 text-sm">Area 2: Bank Tugas &amp; PR Guru (Kolaborasi Rumpun Mapel &amp; Jenjang)</h3>
                        <p class="text-xs text-emerald-800">Ruang kolaborasi guru dengan mata pelajaran dan jenjang yang sama (contoh: PAI Kelas VII). Guru dapat saling melihat dan mengkloning tugas tanpa merusak tugas asli.</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <select id="filterTugasLevel" class="border p-2 rounded-xl text-xs font-bold bg-white" onchange="loadCollaborativeHomeworks()">
                        <option value="ALL">Semua Jenjang</option>
                        <option value="VII">Jenjang Kelas VII</option>
                        <option value="VIII">Jenjang Kelas VIII</option>
                        <option value="IX">Jenjang Kelas IX</option>
                    </select>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow border overflow-hidden">
                <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
                    <h3 class="font-bold text-slate-800 text-sm">Daftar Tugas &amp; PR Rumpun Terbuka</h3>
                    <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-3 py-1 rounded-full" id="tugasCountBadge">0 Tugas</span>
                </div>
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 uppercase tracking-wider font-bold">
                            <th class="p-3 border-b">Judul Tugas</th>
                            <th class="p-3 border-b">Mata Pelajaran</th>
                            <th class="p-3 border-b">Jenjang &amp; Kelas</th>
                            <th class="p-3 border-b">Guru Pembuat Asli</th>
                            <th class="p-3 border-b">Tenggat Waktu</th>
                            <th class="p-3 border-b text-center">Dikloning</th>
                            <th class="p-3 border-b text-center">Aksi Kloning</th>
                        </tr>
                    </thead>
                    <tbody id="collaborativeTugasBody">
                        <tr><td colspan="7" class="p-8 text-center text-slate-400">Memuat bank tugas kolaboratif...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB BARU: AREA 3 - TRANSFER FILE SOAL ANTAR GURU -->
        <div id="section-transfer" class="<%= isTabTransfer ? '' : 'hidden' %> space-y-6">
            <div class="bg-indigo-50 border border-indigo-200 p-4 rounded-2xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-2xl p-2 bg-indigo-100 rounded-xl">🔄</span>
                    <div>
                        <h3 class="font-extrabold text-indigo-950 text-sm">Area 3: Transfer File Naskah &amp; Butir Soal Antar Guru</h3>
                        <p class="text-xs text-indigo-800">Kirim berkas naskah (Word, Excel, PDF, ZIP) atau bagikan langsung butir soal dari bank soal Anda kepada rekan guru lain secara instan.</p>
                    </div>
                </div>
                <button onclick="openSendTransferModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-xs font-bold shadow flex items-center gap-1.5 transition-all">
                    <span>📤</span> Kirim Soal / Berkas ke Guru Lain
                </button>
            </div>

            <!-- Panel Kotak Masuk (Inbox) & Riwayat Kirim -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Kotak Masuk -->
                <div class="bg-white rounded-2xl shadow border overflow-hidden">
                    <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
                        <h3 class="font-extrabold text-slate-800 text-sm flex items-center gap-2">
                            <span>📥</span> Kotak Masuk Naskah Soal Diterima
                        </h3>
                        <span class="text-xs bg-indigo-100 text-indigo-800 font-bold px-2.5 py-0.5 rounded-full" id="transferInboxCount">0 Berkas</span>
                    </div>
                    <div id="transferInboxList" class="p-4 space-y-3 max-h-[400px] overflow-y-auto">
                        <p class="text-slate-400 text-center py-6 text-xs">Tidak ada kiriman soal yang masuk.</p>
                    </div>
                </div>

                <!-- Riwayat Terkirim -->
                <div class="bg-white rounded-2xl shadow border overflow-hidden">
                    <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
                        <h3 class="font-extrabold text-slate-800 text-sm flex items-center gap-2">
                            <span>📤</span> Riwayat Naskah Soal Terkirim
                        </h3>
                        <span class="text-xs bg-slate-100 text-slate-700 font-bold px-2.5 py-0.5 rounded-full" id="transferSentCount">0 Berkas</span>
                    </div>
                    <div id="transferSentList" class="p-4 space-y-3 max-h-[400px] overflow-y-auto">
                        <p class="text-slate-400 text-center py-6 text-xs">Belum ada riwayat pengiriman berkas.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: REKAP HASIL NILAI SISWA -->
        <div id="section-hasil" class="<%= isTabHasil ? '' : 'hidden' %> space-y-6">
            <!-- Filter & Search Bar -->
            <div class="bg-white rounded-2xl shadow-sm p-4 border border-slate-200/80 flex flex-wrap justify-between items-center gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Pilih Paket Ujian</label>
                        <select id="filterExamResult" class="border border-slate-200 bg-slate-50 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 min-w-[200px]" onchange="loadResults()">
                            <option value="ALL">Semua Ujian</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Pilih Rombel / Kelas</label>
                        <select id="filterClassResult" class="border border-slate-200 bg-slate-50 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 min-w-[140px]" onchange="loadResults()">
                            <option value="ALL">Semua Kelas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Cari Peserta</label>
                        <div class="relative">
                            <input type="text" id="searchResultStudentInput" placeholder="Nama / NISN..." oninput="filterResultTableClient()" class="pl-8 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 w-44" />
