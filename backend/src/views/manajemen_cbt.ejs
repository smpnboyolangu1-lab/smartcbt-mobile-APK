        async function printBankSoal(examId) {
            const e = allExams.find(x => x.id === examId);
            if (!e) return;

            try {
                const res = await fetch(`/api/guru/exams/${examId}/questions`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const questions = await res.json();
                const qList = Array.isArray(questions) ? questions : [];

                document.getElementById('printSoalSubject').innerText = e.subject?.name || '-';
                document.getElementById('printSoalType').innerText = e.examType || 'SAS';
                document.getElementById('printSoalClass').innerText = e.assignedClasses === 'ALL' || !e.assignedClasses ? 'Semua Kelas' : 'Kelas ' + e.assignedClasses;
                document.getElementById('printSoalDuration').innerText = `${e.durationMinutes || 90} Menit`;
                document.getElementById('printSoalCount').innerText = `${qList.length} Butir`;
                document.getElementById('printSoalTitle').innerText = e.title;
                document.getElementById('printSoalTeacherName').innerText = e.proctorName || 'Guru Pengampu Mata Pelajaran';
                document.getElementById('printSoalDate').innerText = `Tulungagung, ${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}`;

                try {
                    const scRes = await fetch('/api/school-info');
                    if (scRes.ok) {
                        const scData = await scRes.json();
                        if (scData.headmasterName) {
                            document.getElementById('printSoalHeadmasterName').innerText = scData.headmasterName;
                        }
                        if (scData.headmasterNip) {
                            document.getElementById('printSoalHeadmasterNip').innerText = 'NIP. ' + scData.headmasterNip;
                        }
                        if (scData.schoolName) {
                            document.getElementById('printSoalSchoolHeadmasterTitle').innerText = 'Kepala ' + scData.schoolName;
                        }
                    }
                } catch (errSig) {
                    console.warn('Gagal memuat tanda tangan dinamis:', errSig);
                }

                const container = document.getElementById('printSoalItemsContainer');
                if (qList.length === 0) {
                    container.innerHTML = '<p class="text-center text-gray-500 py-6">Belum ada butir soal pada paket ujian ini.</p>';
                } else {
                    container.innerHTML = qList.map((q, idx) => {
                        let optionsHtml = '';
                        if (q.type !== 'ESSAY' && q.options) {
                            try {
                                const opts = typeof q.options === 'string' ? JSON.parse(q.options) : q.options;
                                if (Array.isArray(opts)) {
                                    const letters = ['A', 'B', 'C', 'D', 'E'];
                                    optionsHtml = '<div class="grid grid-cols-1 md:grid-cols-2 gap-1.5 mt-2 pl-4">';
                                    opts.forEach((opt, oIdx) => {
                                        if (opt) {
                                            optionsHtml += `<div><span class="font-bold">${letters[oIdx]}.</span> ${opt}</div>`;
                                        }
                                    });
                                    optionsHtml += '</div>';
                                } else if (typeof opts === 'object') {
                                    optionsHtml = '<div class="grid grid-cols-1 md:grid-cols-2 gap-1.5 mt-2 pl-4">';
                                    ['A', 'B', 'C', 'D', 'E'].forEach(letter => {
                                        if (opts[letter]) {
                                            optionsHtml += `<div><span class="font-bold">${letter}.</span> ${opts[letter]}</div>`;
                                        }
                                    });
                                    optionsHtml += '</div>';
                                }
                            } catch(err) {}
                        }

                        const imgHtml = q.imageUrl ? `<div class="my-2"><img src="${q.imageUrl}" alt="Diagram Soal" style="max-height: 180px; border-radius: 6px;" /></div>` : '';

                        return `
                            <div class="border-b pb-3 mb-2">
                                <div class="flex gap-2">
                                    <span class="font-bold">${idx + 1}.</span>
                                    <div class="flex-1">${q.content}</div>
                                </div>
                                ${imgHtml}
                                ${optionsHtml}
                            </div>
                        `;
                    }).join('');
                }

                document.getElementById('modalPrintBankSoal').classList.remove('hidden');
            } catch(err) {
                console.error(err);
                alert('Gagal memuat naskah soal untuk dicetak');
            }
        }

