    <script>
        function getCookie(name) {
            const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            return match ? match[2] : null;
        }
        const token = localStorage.getItem('token') || getCookie('token') || '';
        if(!token) window.location.href = '/';

        const schDateInput = document.getElementById('schDate');
        if (schDateInput) schDateInput.value = new Date().toISOString().split('T')[0];

        let allExams = [];
        let allClasses = [];
        let allResults = [];
        let allTeachersList = [];

        initServerClock();
        loadClasses();
        loadTeachersForProctors();
        loadExams();
        loadResults();

        // Real-Time Server Clock (WIB 24 Jam)
        let serverClockOffset = 0;
        async function initServerClock() {
            try {
                const res = await fetch('/api/server-time');
                if (res.ok) {
                    const data = await res.json();
                    serverClockOffset = data.timestamp - Date.now();
                }
            } catch (e) {
                console.warn('Gagal sinkronisasi waktu server:', e);
            }
            updateServerClock();
            setInterval(updateServerClock, 1000);
        }

        function updateServerClock() {
            const clockEls = document.querySelectorAll('.server-clock-display');
            if (!clockEls.length) return;
            const now = new Date(Date.now() + serverClockOffset);
            const timeStr = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Jakarta',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            }).format(now) + ' WIB';
            
            clockEls.forEach(el => {
                el.innerText = timeStr;
            });
        }

        function switchTab(tab, updateUrl = true) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tab)?.classList.add('active');

            document.getElementById('section-jadwal')?.classList.add('hidden');
            document.getElementById('section-soal')?.classList.add('hidden');
            document.getElementById('section-tugas')?.classList.add('hidden');
            document.getElementById('section-transfer')?.classList.add('hidden');
            document.getElementById('section-hasil')?.classList.add('hidden');
            document.getElementById('section-analisis')?.classList.add('hidden');

            document.getElementById('section-' + tab)?.classList.remove('hidden');

            if (updateUrl && window.history && window.history.replaceState) {
                const currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('tab', tab);
                window.history.replaceState(null, '', currentUrl.pathname + '?' + currentUrl.searchParams.toString());
            }

            if (tab === 'soal') renderExamTable();
            if (tab === 'tugas') loadCollaborativeHomeworks();
            if (tab === 'transfer') loadTeacherTransfers();
            if (tab === 'hasil') loadResults();
            if (tab === 'analisis') {
                populateAnalysisExamSelect();
                const sel = document.getElementById('selectAnalysisExam');
                if (sel && !sel.value && sel.options.length > 1) {
                    sel.selectedIndex = 1;
                }
                loadItemAnalysisData();
            }
        }

        function initActiveTabFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const tabParam = (params.get('tab') || window.location.hash.replace('#', '')).toLowerCase();
            if (tabParam === 'hasil' || tabParam === 'grades' || tabParam === 'nilai' || tabParam === 'rekap') {
                switchTab('hasil', false);
            } else if (tabParam === 'analisis' || tabParam === 'analysis' || tabParam === 'butir') {
                switchTab('analisis', false);
            } else if (tabParam === 'soal' || tabParam === 'bank') {
                switchTab('soal', false);
            } else if (tabParam === 'tugas') {
                switchTab('tugas', false);
            } else if (tabParam === 'transfer') {
                switchTab('transfer', false);
            } else {
                switchTab('jadwal', false);
            }
        }
        initActiveTabFromUrl();

        async function loadClasses() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(Array.isArray(data)) {
                    allClasses = data;
                    const schClass = document.getElementById('schClass');
                    const filterClass = document.getElementById('filterClassResult');
                    data.forEach(k => {
                        const cName = k.name || k.nama;
                        if (cName) {
                            schClass.innerHTML += `<option value="${cName}">Kelas ${cName}</option>`;
                            filterClass.innerHTML += `<option value="${cName}">Kelas ${cName}</option>`;
                        }
                    });
                }
            } catch(e) {}
        }

        async function loadExams() {
            try {
                const res = await fetch('/api/guru/exams', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(Array.isArray(data)) {
                    allExams = data;
                    document.getElementById('countExams').innerText = allExams.length;
                    document.getElementById('countSchedule').innerText = allExams.length;

                    const schSelect = document.getElementById('schSelectExam');
                    const resSelect = document.getElementById('filterExamResult');
                    schSelect.innerHTML = '<option value="">Pilih Paket Soal dari Bank Soal</option>';
                    resSelect.innerHTML = '<option value="ALL">Semua Ujian</option>';

                    allExams.forEach(e => {
                        schSelect.innerHTML += `<option value="${e.id}">${e.title} (${e.subject ? e.subject.name : '-'})</option>`;
                        resSelect.innerHTML += `<option value="${e.id}">${e.title}</option>`;
                    });

                    renderScheduleCards();
                    renderExamTable();
                    populateAnalysisExamSelect();

                    // Auto load item analysis if on analysis tab
                    const currentTab = document.querySelector('.tab-btn.active')?.id;
                    if (currentTab === 'tab-analisis') {
                        const sel = document.getElementById('selectAnalysisExam');
                        if (sel && !sel.value && sel.options.length > 1) {
                            sel.selectedIndex = 1;
                        }
                        loadItemAnalysisData();
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderScheduleCards() {
            const container = document.getElementById('scheduleCardGrid');
            container.innerHTML = '';

            if(allExams.length === 0) {
                container.innerHTML = '<div class="col-span-3 text-center py-8 text-gray-400">Belum ada jadwal ujian nasional. Klik "Jadwalkan Ujian Nasional" untuk memulai.</div>';
                return;
            }

            allExams.forEach(e => {
                const isLive = e.isTokenActive;
                const statusBadge = isLive 
                    ? '<span class="bg-green-100 text-green-800 text-xs px-2.5 py-1 rounded-full font-bold animate-pulse border border-green-200">🟢 LIVE BERJALAN</span>'
                    : '<span class="bg-gray-100 text-gray-600 text-xs px-2.5 py-1 rounded-full font-bold border">STANDBY</span>';

                const targetClass = e.assignedClasses === 'ALL' || !e.assignedClasses ? 'Semua Kelas' : 'Kelas ' + e.assignedClasses;

                container.innerHTML += `
                    <div class="bg-white rounded-2xl shadow-sm border p-5 hover:shadow-md transition-all">
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2.5 py-0.5 rounded-lg">${e.subject ? e.subject.name : 'Mapel'}</span>
                            ${statusBadge}
                        </div>
                        <h3 class="font-bold text-gray-900 text-base mb-1">${e.title}</h3>
                        <p class="text-xs text-gray-500 mb-3">Target: <b class="text-blue-900">${targetClass}</b> | Sesi: <b>${e.sessionName || 'Sesi 1'}</b></p>
                        
                        <div class="bg-gray-50 rounded-xl p-3 border mb-4 space-y-1.5 text-xs text-gray-600">
                            <div class="flex justify-between"><span>Tanggal:</span><b class="text-gray-800">${e.executionDate || '-'}</b></div>
                            <div class="flex justify-between"><span>Waktu:</span><b class="text-gray-800">${e.startTimeStr || '07:30'} - ${e.endTimeStr || '09:30'} (${e.durationMinutes}m)</b></div>
                            <div class="pt-1.5 border-t space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <span class="font-medium text-slate-600">Token Master:</span>
                                    <span class="font-mono font-extrabold text-xs bg-amber-100 text-amber-900 px-2 py-0.5 rounded border border-amber-300 select-all">${e.token}</span>
                                </div>
                                ${e.classTokens && Object.keys(e.classTokens).length > 1 ? `
                                    <div class="flex justify-between items-center bg-indigo-50/80 p-2 rounded-xl border border-indigo-200/60">
                                        <div>
                                            <span class="font-bold text-indigo-900 text-[11px] block">🔑 Token Khusus per Rombel</span>
                                            <span class="text-[10px] text-indigo-600 font-semibold">${Object.keys(e.classTokens).length} Token Berbeda (${Object.keys(e.classTokens).slice(0, 4).join(', ')}${Object.keys(e.classTokens).length > 4 ? '...' : ''})</span>
                                        </div>
                                        <button onclick="openClassTokensModal('${e.id}')" class="bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1 rounded-lg text-[11px] font-bold shadow-sm flex items-center gap-1 transition-all cursor-pointer">
                                            <span>📋</span> <span>Lihat ${Object.keys(e.classTokens).length} Token</span>
                                        </button>
                                    </div>
                                ` : ''}
