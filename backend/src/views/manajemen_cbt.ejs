        async function openLjsModal(studentExamId) {
            try {
                const res = await fetch(`/api/cbt/student-exams/${studentExamId}/ljs`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (!res.ok || !data.studentExam) {
                    alert(data.message || 'Gagal memuat lembar jawaban siswa');
                    return;
                }

                const se = data.studentExam;
                const sum = data.summary;
                const u = se.user || {};
                const ex = se.exam || {};

                document.getElementById('ljsStudentName').innerText = u.name || '-';
                document.getElementById('ljsStudentNisn').innerText = u.nisn || u.username || '-';
                document.getElementById('ljsStudentClass').innerText = u.className || '-';
                document.getElementById('ljsSubject').innerText = ex.subjectName || '-';
                document.getElementById('ljsExamTitle').innerText = ex.title || '-';

                document.getElementById('ljsStartTime').innerText = se.startTime ? new Date(se.startTime).toLocaleString('id-ID') : '-';
                document.getElementById('ljsEndTime').innerText = se.endTime ? new Date(se.endTime).toLocaleString('id-ID') : 'Belum Selesai';
                document.getElementById('ljsStrikes').innerText = `${se.strikeCount || 0} Kali`;

                document.getElementById('ljsFinalScore').innerText = Number(sum.finalScore).toFixed(1);
                const passBadge = document.getElementById('ljsPassingBadge');
                if (sum.isPassed) {
                    passBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300';
                    passBadge.innerText = 'TUNTAS';
                } else {
                    passBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-black bg-rose-100 text-rose-800 border border-rose-300';
                    passBadge.innerText = 'BELUM TUNTAS';
                }

                document.getElementById('ljsTotalQ').innerText = sum.totalQuestions;
                document.getElementById('ljsCorrectQ').innerText = sum.totalCorrect;
                document.getElementById('ljsWrongQ').innerText = sum.totalWrong;
                document.getElementById('ljsUnattemptedQ').innerText = sum.totalUnattempted;

                document.getElementById('ljsSignStudentName').innerText = u.name || 'Siswa Peserta';
                document.getElementById('ljsSignProctorName').innerText = ex.proctorName || 'Proktor Ruang';
                document.getElementById('ljsSignDate').innerText = `Tulungagung, ${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}`;

                const tbody = document.getElementById('ljsTableBody');
                if (data.items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-500">Tidak ada butir soal</td></tr>';
                } else {
                    tbody.innerHTML = data.items.map((item, idx) => {
                        let badge = '';
                        if (item.status === 'BENAR') {
                            badge = '<span class="text-emerald-700 font-extrabold bg-emerald-100 px-2 py-0.5 rounded border border-emerald-300">✓ BENAR</span>';
                        } else if (item.status === 'SALAH') {
                            badge = '<span class="text-rose-700 font-extrabold bg-rose-100 px-2 py-0.5 rounded border border-rose-300">✗ SALAH</span>';
                        } else if (item.type === 'ESSAY') {
                            badge = '<span class="text-blue-700 font-extrabold bg-blue-100 px-2 py-0.5 rounded border border-blue-300">ESAI</span>';
                        } else {
                            badge = '<span class="text-gray-600 font-extrabold bg-gray-100 px-2 py-0.5 rounded border border-gray-300">- KOSONG</span>';
                        }

                        const snippet = item.content ? item.content.replace(/<[^>]*>?/gm, '').substring(0, 60) : '-';

                        return `
                            <tr class="hover:bg-slate-50">
                                <td class="p-2.5 text-center font-bold border-r border-slate-200">${item.orderNum || (idx + 1)}</td>
                                <td class="p-2.5 border-r border-slate-200 text-gray-800">${snippet}...</td>
                                <td class="p-2.5 text-center font-mono font-bold text-blue-900 border-r border-slate-200">${item.correctOption || '-'}</td>
                                <td class="p-2.5 text-center font-mono font-bold border-r border-slate-200">${item.studentAnswer || '<span class="text-gray-400">-</span>'}</td>
                                <td class="p-2.5 text-center font-bold">${badge}</td>
                            </tr>
                        `;
                    }).join('');
                }

                document.getElementById('modalLjs').classList.remove('hidden');
            } catch(err) {
                console.error(err);
                alert('Terjadi kesalahan saat memuat LJS siswa');
            }
        }

