        function filterBankSoalTable() {
            const query = (document.getElementById('searchBankSoalInput')?.value || '').toLowerCase().trim();
            const subject = document.getElementById('filterBankSubject')?.value || 'ALL';

            const filtered = allExams.filter(e => {
                const titleMatch = !query || 
                    (e.title || '').toLowerCase().includes(query) || 
                    (e.subject?.name || '').toLowerCase().includes(query) || 
                    (e.token || '').toLowerCase().includes(query);
                const subjMatch = subject === 'ALL' || (e.subject?.name === subject);
                return titleMatch && subjMatch;
            });

            renderExamTable(filtered);
        }

        function renderExamTable(listToRender) {
            const tbody = document.getElementById('examTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const exams = listToRender || allExams;

            // Update KPI Stats Ribbon
            const totalExams = allExams.length;
            const totalQuestions = allExams.reduce((acc, e) => acc + (e._count?.questions || 0), 0);
            const activeExams = allExams.filter(e => e.isTokenActive).length;
            const avgDuration = totalExams > 0 ? Math.round(allExams.reduce((acc, e) => acc + (Number(e.durationMinutes) || 90), 0) / totalExams) : 90;

            if (document.getElementById('bankStatTotalExams')) document.getElementById('bankStatTotalExams').innerText = totalExams;
            if (document.getElementById('bankStatTotalQuestions')) document.getElementById('bankStatTotalQuestions').innerText = totalQuestions;
            if (document.getElementById('bankStatActiveExams')) document.getElementById('bankStatActiveExams').innerText = activeExams;
            if (document.getElementById('bankStatAvgDuration')) document.getElementById('bankStatAvgDuration').innerText = avgDuration + 'm';
            if (document.getElementById('bankTableCountBadge')) document.getElementById('bankTableCountBadge').innerText = exams.length + ' Paket Terdaftar';

            // Populate Mapel Filter if not already populated
            const mapelSel = document.getElementById('filterBankSubject');
            if (mapelSel && mapelSel.options.length <= 1) {
                const mapels = new Set();
                allExams.forEach(e => { if (e.subject?.name) mapels.add(e.subject.name); });
                mapels.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m;
                    opt.innerText = m;
                    mapelSel.appendChild(opt);
                });
