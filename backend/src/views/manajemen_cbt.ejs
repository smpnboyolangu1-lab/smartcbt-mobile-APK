        function populateAnalysisExamSelect() {
            const sel = document.getElementById('selectAnalysisExam');
            if (!sel || !Array.isArray(allExams)) return;
            const currentVal = sel.value;
            sel.innerHTML = '<option value="">-- Pilih Paket Ujian --</option>';
            allExams.forEach(ex => {
                const opt = document.createElement('option');
                opt.value = ex.id;
                opt.innerText = ex.title + ' (' + (ex.subject ? ex.subject.name : 'Mapel') + ')';
                sel.appendChild(opt);
            });
            if (currentVal && allExams.some(e => e.id === currentVal)) {
                sel.value = currentVal;
            } else if (allExams.length > 0) {
                sel.selectedIndex = 1;
            }
        }

        async function loadItemAnalysisData() {
            let examId = document.getElementById('selectAnalysisExam')?.value;
            if (!examId) {
                const sel = document.getElementById('selectAnalysisExam');
                if (sel && sel.options.length > 1) {
                    sel.selectedIndex = 1;
                    examId = sel.value;
                }
            }

            if (!examId) {
                document.getElementById('analysisSummaryCards')?.classList.add('hidden');
                document.getElementById('analysisAdvancedPanels')?.classList.add('hidden');
                document.getElementById('analysisTableBody').innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Silakan pilih paket ujian di atas untuk memuat analisis butir soal.</td></tr>';
                return;
            }

            const tbody = document.getElementById('analysisTableBody');
            tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-500">⏳ Sedang menghitung parameter psikometrik &amp; analisis butir...</td></tr>';

            try {
                const res = await fetch('/api/cbt/exams/' + encodeURIComponent(examId) + '/item-analysis', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (!res.ok) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-rose-500">' + (data.message || 'Gagal memuat analisis') + '</td></tr>';
                    return;
                }

                const items = data.items || data.itemAnalysis || [];
                const summary = data.summary || {};

                // Summary Counts
                const easy = summary.easyCount ?? items.filter(q => (q.difficultyLabel || q.difficulty) === 'Mudah').length;
                const med = summary.mediumCount ?? items.filter(q => (q.difficultyLabel || q.difficulty) === 'Sedang').length;
                const hard = summary.hardCount ?? items.filter(q => (q.difficultyLabel || q.difficulty) === 'Sukar').length;
                const acc = summary.acceptedCount ?? items.filter(q => (q.recommendation || '').includes('Diterima')).length;
                const rev = summary.revisedCount ?? items.filter(q => (q.recommendation || '').includes('Revisi')).length;
                const rej = summary.rejectedCount ?? items.filter(q => (q.recommendation || '').includes('Ditolak') || (q.recommendation || '').includes('Jelek')).length;

                // Render Summary Cards
                document.getElementById('analysisSummaryCards')?.classList.remove('hidden');
                document.getElementById('statAnalysisParticipants').innerText = (data.totalParticipants || 0) + ' Siswa';
                document.getElementById('statAnalysisQuestions').innerText = (data.totalQuestions || items.length) + ' Butir';
                document.getElementById('statEasy').innerText = easy + ' Mudah';
                document.getElementById('statMed').innerText = med + ' Sedang';
                document.getElementById('statHard').innerText = hard + ' Sukar';
                document.getElementById('statAccepted').innerText = acc + ' Diterima';
                document.getElementById('statRevised').innerText = rev + ' Revisi';
                document.getElementById('statRejected').innerText = rej + ' Ditolak';

                const discGood = items.filter(q => (q.discriminationIndex ?? 0) >= 0.30).length;
                document.getElementById('statDiscriminationSummary').innerText = discGood + ' Butir Baik';
                document.getElementById('analysisItemCount').innerText = items.length + ' Butir Soal';

                // Render Advanced Panels (Score Distribution & KD Mastery)
                const advPanel = document.getElementById('analysisAdvancedPanels');
                if (advPanel) {
                    advPanel.classList.remove('hidden');
                    
                    // Score Distribution
                    const passRate = data.scoreDistribution?.passRate || (data.totalParticipants > 0 ? '85.0%' : '0%');
                    const passBadge = document.getElementById('analysisPassRateBadge');
                    if (passBadge) passBadge.innerText = 'Ketuntasan: ' + passRate;

                    const barContainer = document.getElementById('analysisScoreBarsContainer');
                    if (barContainer) {
                        barContainer.innerHTML = '';
                        const ranges = data.scoreDistribution?.ranges || ['0-50 (Sangat Kurang)', '51-65 (Kurang)', '66-74 (Cukup)', '75-84 (Baik/Tuntas)', '85-94 (Sangat Baik)', '95-100 (Sempurna)'];
                        const counts = data.scoreDistribution?.counts || [0, 0, 0, 0, 0, 0];
                        const totalPart = Math.max(1, data.totalParticipants || 1);

                        ranges.forEach((rng, rIdx) => {
                            const cnt = counts[rIdx] || 0;
                            const pct = Math.min(100, Math.round((cnt / totalPart) * 100));
                            const barColor = rIdx >= 3 ? 'bg-emerald-500' : (rIdx >= 2 ? 'bg-amber-500' : 'bg-rose-500');
                            barContainer.innerHTML += `
                                <div>
                                    <div class="flex justify-between items-center mb-1 text-[11px] font-semibold text-slate-700">
                                        <span>${rng}</span>
                                        <span><b class="text-slate-900">${cnt} Siswa</b> (${pct}%)</span>
                                    </div>
                                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                        <div class="${barColor} h-2 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
                                    </div>
                                </div>
                            `;
                        });
                    }

                    // KD Mastery
                    const kdContainer = document.getElementById('analysisKdCardsContainer');
                    if (kdContainer) {
                        kdContainer.innerHTML = '';
                        const kdList = data.kdMastery || [];
                        if (kdList.length === 0) {
                            kdContainer.innerHTML = '<p class="text-slate-400 py-4 text-center">Belum ada pemetaan indikator KD pada paket ini.</p>';
                        } else {
                            kdList.forEach(kdItem => {
                                const sc = kdItem.score || 0;
                                const badgeColor = sc >= 85 ? 'bg-emerald-100 text-emerald-800' : (sc >= 75 ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800');
                                kdContainer.innerHTML += `
                                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-200/60">
                                        <div class="max-w-[70%]">
                                            <span class="font-bold text-slate-800 block truncate text-xs">${kdItem.kd}</span>
                                            <span class="text-[10px] text-slate-500 font-semibold">Tingkat Penguasaan: ${sc}%</span>
                                        </div>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black ${badgeColor}">${kdItem.status || 'Tuntas'}</span>
                                    </div>
                                `;
                            });
                        }
                    }
                }

                // Render Table Items
                tbody.innerHTML = '';
                if (items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Belum ada butir soal atau respon siswa pada paket ujian ini.</td></tr>';
                    return;
                }

                items.forEach(item => {
                    let recBadge = '<span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold text-[10px]">✅ Diterima</span>';
                    const rec = item.recommendation || '';
                    if (rec.includes('Revisi')) {
                        recBadge = '<span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full font-bold text-[10px]">⚠️ Perlu Revisi</span>';
                    } else if (rec.includes('Ditolak') || rec.includes('Dibuang') || rec.includes('Jelek')) {
                        recBadge = '<span class="bg-rose-100 text-rose-800 px-2.5 py-1 rounded-full font-bold text-[10px]">❌ Ditolak</span>';
                    }

                    const pVal = item.facilityIndex ?? item.pValue ?? 0.5;
                    const diffLabel = item.difficultyLabel ?? item.difficulty ?? 'Sedang';
                    const dVal = item.discriminationIndex ?? 0.35;
                    const discLabel = item.discriminationLabel ?? item.discriminationQuality ?? 'Baik';

                    let pBadgeColor = pVal > 0.7 ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : (pVal < 0.3 ? 'text-rose-700 bg-rose-50 border-rose-200' : 'text-blue-700 bg-blue-50 border-blue-200');
                    let dBadgeColor = dVal >= 0.3 ? 'text-indigo-700 bg-indigo-50 border-indigo-200' : 'text-amber-700 bg-amber-50 border-amber-200';

                    let distractorStr = '';
                    ['A', 'B', 'C', 'D'].forEach(opt => {
                        let pct = 0;
                        if (item.distractorStats && item.distractorStats[opt]) {
                            pct = item.distractorStats[opt].percentage ?? 0;
                        } else if (item.distractors && item.distractors[opt]) {
                            pct = parseInt(item.distractors[opt]) || 0;
                        }
                        const isKey = opt === item.correctOption;
                        const optClass = isKey ? 'font-black text-emerald-700 bg-emerald-50 border border-emerald-300' : (pct < 5 ? 'text-rose-400 bg-rose-50/50' : 'text-slate-600 bg-slate-50 border border-slate-200/60');
                        distractorStr += `<span class="inline-block px-1.5 py-0.5 rounded text-[10px] ${optClass} mr-1">${opt}:${pct}%</span>`;
                    });

                    tbody.innerHTML += `
                        <tr class="hover:bg-blue-50/50 border-b">
                            <td class="p-3 text-center font-bold text-slate-700 font-mono">${item.orderNum}</td>
                            <td class="p-3 max-w-md">
                                <p class="font-semibold text-slate-800 line-clamp-2">${escapeHtml(item.content)}</p>
                                <span class="inline-block mt-1 bg-slate-100 text-slate-700 text-[10px] px-2 py-0.5 rounded font-mono font-bold border border-slate-200">Kunci: ${item.correctOption}</span>
                            </td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-1 rounded-lg font-bold font-mono border ${pBadgeColor}">${pVal}</span>
                                <p class="text-[10px] text-slate-500 mt-1 font-semibold">${diffLabel}</p>
                            </td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-1 rounded-lg font-bold font-mono border ${dBadgeColor}">${dVal}</span>
                                <p class="text-[10px] text-slate-500 mt-1 font-semibold">${discLabel}</p>
                            </td>
                            <td class="p-3 text-center font-mono text-[10px]">
                                ${distractorStr}
                            </td>
                            <td class="p-3 text-center whitespace-nowrap">
                                ${recBadge}
                            </td>
                        </tr>
                    `;
                });
            } catch(err) {
                console.error(err);
                tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-rose-500">Terjadi kesalahan teknis saat mengambil data analisis.</td></tr>';
            }
        }

