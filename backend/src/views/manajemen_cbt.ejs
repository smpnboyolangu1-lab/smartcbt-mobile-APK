        function populateRombelCheckboxes() {
            const listContainer = document.getElementById('rombelCheckboxesList');
            if (!listContainer) return;
            listContainer.innerHTML = '';
            ALL_ROMBELS.forEach(r => {
                listContainer.innerHTML += `
                    <label class="flex items-center gap-1.5 p-1 bg-slate-50 rounded border cursor-pointer hover:bg-slate-100">
                        <input type="checkbox" name="rombelCheck" value="${r}" onchange="updateSelectedClassesFromRombelCheck()">
                        <span class="font-bold text-slate-700">${r}</span>
                    </label>
                `;
            });
            updateSelectedClassesFromRombelCheck();
        }

        function updateSelectedClassesFromRombelCheck() {
            const checked = Array.from(document.querySelectorAll('input[name="rombelCheck"]:checked')).map(el => el.value);
            document.getElementById('schClass').value = checked.length > 0 ? checked.join(',') : 'ALL';
            renderProctorAssignmentsGrid(checked.length > 0 ? checked : ALL_ROMBELS);
        }

        async function renderProctorAssignmentsGrid(rombelList, existingProctors = {}) {
            const grid = document.getElementById('proctorAssignmentGrid');
            if (!grid) return;
            await fetchTeachersForProctor();

            grid.innerHTML = '';
            if (rombelList.length === 0) {
                grid.innerHTML = '<p class="text-slate-400 text-center py-6 col-span-3 font-semibold">Pilih target kelas terlebih dahulu untuk mengatur pengawas ruang.</p>';
                return;
            }

            rombelList.forEach((r, idx) => {
                let badgeClass = 'bg-sky-100 text-sky-950 border-sky-300';
                if (r.startsWith('VIII-')) badgeClass = 'bg-indigo-100 text-indigo-950 border-indigo-300';
                if (r.startsWith('IX-')) badgeClass = 'bg-purple-100 text-purple-950 border-purple-300';

                const currentAssigned = existingProctors[r] || '';
                let assignedId = '';
                let assignedName = '';
                if (typeof currentAssigned === 'object' && currentAssigned !== null) {
                    assignedId = String(currentAssigned.proctorId || currentAssigned.id || '').trim();
                    assignedName = String(currentAssigned.proctorName || currentAssigned.name || '').trim();
                } else if (typeof currentAssigned === 'string' && currentAssigned.trim() !== '') {
                    if (currentAssigned.includes('|')) {
                        const parts = currentAssigned.split('|');
                        assignedId = parts[0].trim();
                        assignedName = parts.slice(1).join('|').trim();
                    } else {
                        assignedName = currentAssigned.trim();
                        assignedId = currentAssigned.trim();
                    }
                }
                const hasAssignment = Boolean(assignedId || assignedName);

                let options = '<option value="">-- Pilih Guru Pengawas --</option>';
                let hasMatch = false;
                availableTeachersList.forEach((g, gIdx) => {
                    const gId = String(g.id || '').trim();
                    const gName = String(g.name || g.nama || '').trim();
                    const isSelected = hasAssignment
                        ? ((assignedId && gId === assignedId) ||
                           (assignedName && (gName === assignedName || gName.toLowerCase() === assignedName.toLowerCase())))
                        : ((idx % availableTeachersList.length) === gIdx);
                    if (isSelected) hasMatch = true;
                    options += `<option value="${g.id}|${escapeHtml(gName)}" ${isSelected ? 'selected' : ''}>${escapeHtml(gName)} (${escapeHtml(g.teachingSubject || 'Guru')})</option>`;
                });
                if (hasAssignment && !hasMatch && (assignedName || assignedId)) {
                    const fallbackName = assignedName || assignedId;
                    options = `<option value="${assignedId || fallbackName}|${escapeHtml(fallbackName)}" selected>${escapeHtml(fallbackName)} (Pengawas Terpilih)</option>` + options;
                }

                grid.innerHTML += `
                    <div class="p-2.5 bg-slate-50 border-2 border-slate-200 rounded-xl flex items-center justify-between gap-2 hover:border-purple-300 transition-all">
                        <span class="font-black text-xs px-2.5 py-1 rounded-lg border ${badgeClass} shrink-0">${r}</span>
                        <select class="w-full border border-slate-300 p-1.5 rounded-lg text-xs font-semibold bg-white text-slate-800 proctor-select focus:border-purple-600 outline-none" data-rombel="${r}">
                            ${options}
                        </select>
                    </div>
                `;
            });
        }

