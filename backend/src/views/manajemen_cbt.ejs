        function loadQuestionToForm(questionId) {
            const q = currentEditingQuestionList.find(x => x.id === questionId);
            if (!q) return;

            document.getElementById('qeQuestionId').value = q.id;
            document.getElementById('qeFormTitle').innerText = 'Edit Soal #' + (q.orderNum || 1);
            document.getElementById('qeModeBadge').innerText = 'Mode Edit';
            document.getElementById('qeModeBadge').className = 'text-[10px] bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded';

            if (typeof tinymce !== 'undefined' && tinymce.get('qeContentEditor')) {
                tinymce.get('qeContentEditor').setContent(q.content || '');
            } else {
                document.getElementById('qeContentEditor').value = q.content || '';
            }

            let opts = { A: '', B: '', C: '', D: '', E: '' };
            if (q.options) {
                try {
                    opts = typeof q.options === 'string' ? JSON.parse(q.options) : q.options;
                } catch(e) {}
            }

            let qType = q.type || 'MULTIPLE_CHOICE';
            if (opts.E && opts.E.trim().length > 0 && qType === 'MULTIPLE_CHOICE') {
                qType = 'MULTIPLE_CHOICE_5';
            }
            document.getElementById('qeType').value = qType;
            document.getElementById('qeAudioUrl').value = q.audioUrl || '';
            document.getElementById('qeOptA').value = opts.A || '';
            document.getElementById('qeOptB').value = opts.B || '';
            document.getElementById('qeOptC').value = opts.C || '';
            document.getElementById('qeOptD').value = opts.D || '';
            document.getElementById('qeOptE').value = opts.E || '';
            document.getElementById('qeEssayRubric').value = q.essayRubric || q.correctOption || '';
            document.getElementById('qeCorrectOption').value = q.correctOption || 'A';
            document.getElementById('qeCognitiveLevel').value = q.cognitiveLevel || 'C3 (Aplikasi)';
            document.getElementById('qeKdTag').value = q.kdTag || '';
            document.getElementById('qeImageUrl').value = q.imageUrl || '';

            if (q.imageUrl) {
                document.getElementById('qeImagePreviewNotice').classList.remove('hidden');
            } else {
                document.getElementById('qeImagePreviewNotice').classList.add('hidden');
            }

            onQuestionTypeChange();
        }

