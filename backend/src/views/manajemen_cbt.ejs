        async function openItemResponsesModal(examId, studentExamId, studentName, className) {
            document.getElementById('itemRespModalTitle').innerText = `Jawaban Siswa: ${studentName} (${className})`;
            const list = document.getElementById('itemResponsesList');
            list.innerHTML = '<p class="text-slate-400 text-center py-6">Memuat rincian butir...</p>';
            document.getElementById('modalItemResponses').classList.remove('hidden');

            try {
                const res = await fetch(`/api/cbt/student-exam/${studentExamId}/details`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (!data.success) {
                    list.innerHTML = `<p class="text-rose-500 text-center py-4">${data.message}</p>`;
                    return;
                }

                document.getElementById('itemRespCorrectCount').innerText = data.data.correctCount || 0;
                document.getElementById('itemRespIncorrectCount').innerText = data.data.incorrectCount || 0;
                document.getElementById('itemRespUnansweredCount').innerText = data.data.unansweredCount || 0;
                document.getElementById('itemRespTotalScore').innerText = data.data.score || 0;

                list.innerHTML = '';
                const items = data.data.items || [];
                items.forEach((it, idx) => {
                    const isCorrect = it.isCorrect;
                    const badge = isCorrect 
                        ? '<span class="text-emerald-700 font-extrabold">✅ Benar</span>' 
                        : (it.selectedAnswer ? '<span class="text-rose-700 font-extrabold">❌ Salah</span>' : '<span class="text-slate-500 font-bold">⭕ Kosong</span>');
                    
                    list.innerHTML += `
                        <div class="p-2.5 bg-slate-50 rounded-xl border flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <span class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center font-bold text-slate-800 text-[11px]">${idx + 1}</span>
                                <div>
                                    <span class="font-bold text-slate-800">Jawaban: <b>${it.selectedAnswer || '-'}</b></span>
                                    <span class="text-slate-400 text-[10px] ml-2 font-mono">Kunci: ${it.correctKey || '-'}</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="font-mono text-slate-500 text-[10px]">${it.responseTimeSeconds ? it.responseTimeSeconds + 's' : '-'}</span>
                                ${badge}
                            </div>
                        </div>
                    `;
                });
            } catch (e) {
                list.innerHTML = '<p class="text-rose-500 text-center py-4">Gagal memuat rincian butir.</p>';
            }
        }

