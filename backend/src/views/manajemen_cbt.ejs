        function updateSelectedClassesFromLevel() {
            const selected = getCurrentSelectedRombels();
            document.getElementById('schClass').value = selected.length > 0 ? selected.join(',') : 'ALL';
            renderProctorAssignmentsGrid(selected.length > 0 ? selected : ALL_ROMBELS);
