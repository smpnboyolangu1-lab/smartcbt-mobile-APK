        async function duplicateExamDirect(id) {
            if (!confirm('Duplikasi paket soal ini beserta seluruh butir soalnya?')) return;
            try {
                const res = await fetch(`/api/cbt/exams/${id}/duplicate`, {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message || 'Paket soal berhasil diduplikasi!');
                    loadExams();
                } else {
                    alert('Gagal menduplikasi: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (e) {
                alert('Gagal menduplikasi: ' + e.message);
            }
        }

        let activeResultStatusFilter = 'ALL';

        function filterResultTableByStatus(status) {
            activeResultStatusFilter = status;
            document.querySelectorAll('.result-filter-btn').forEach(b => {
                b.classList.remove('bg-blue-100', 'text-blue-800', 'border-blue-200');
                b.classList.add('bg-slate-100', 'text-slate-600', 'border-transparent');
            });
            const activeBtn = document.getElementById('rf-' + status);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-100', 'text-slate-600', 'border-transparent');
                activeBtn.classList.add('bg-blue-100', 'text-blue-800', 'border-blue-200');
            }
            filterResultTableClient();
        }

        function filterResultTableClient() {
            const query = (document.getElementById('searchResultStudentInput')?.value || '').toLowerCase().trim();
            let filtered = [...allResults];

            if (query) {
                filtered = filtered.filter(r => {
                    const name = (r.user?.name || '').toLowerCase();
                    const nisn = (r.user?.nisn || r.user?.username || '').toLowerCase();
                    const cName = (r.user?.className || '').toLowerCase();
                    return name.includes(query) || nisn.includes(query) || cName.includes(query);
                });
            }

            if (activeResultStatusFilter !== 'ALL') {
                if (activeResultStatusFilter === 'TUNTAS') {
                    filtered = filtered.filter(r => (r.score !== null) && (Number(r.score) >= 75));
                } else if (activeResultStatusFilter === 'BELUM_TUNTAS') {
                    filtered = filtered.filter(r => (r.score !== null) && (Number(r.score) < 75));
                } else if (activeResultStatusFilter === 'SELESAI') {
                    filtered = filtered.filter(r => r.status === 'SELESAI' || r.status === 'TERVERIFIKASI');
                } else if (activeResultStatusFilter === 'RESET') {
                    filtered = filtered.filter(r => r.status === 'TERPUTUS' || r.status === 'RESET');
                }
            }

            renderResultTable(filtered);
        }

        async function loadResults() {
            const examId = document.getElementById('filterExamResult')?.value || 'ALL';
            const className = document.getElementById('filterClassResult')?.value || 'ALL';

            const tbody = document.getElementById('resultTableBody');
            if (tbody) tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-slate-500">⏳ Sedang memuat rekap hasil nilai siswa...</td></tr>';

            try {
                const res = await fetch(`/api/cbt/results?examId=${encodeURIComponent(examId)}&className=${encodeURIComponent(className)}`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if(Array.isArray(data)) {
                    allResults = data;
                    if (document.getElementById('rfCountAll')) document.getElementById('rfCountAll').innerText = allResults.length;
                    filterResultTableClient();
                } else {
                    if (tbody) tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-rose-500">Gagal memuat rekap hasil nilai.</td></tr>';
                }
            } catch(e) {
                console.error(e);
                if (tbody) tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-rose-500">Terjadi kesalahan teknis saat memuat rekap nilai.</td></tr>';
            }
        }

        function renderResultTable(listToRender) {
            const tbody = document.getElementById('resultTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const results = listToRender || allResults;
            document.getElementById('resultTotalStudentCount').innerText = results.length + ' Peserta';

            // Hitung statistik & analisis ketuntasan KKM
            const validScores = allResults.map(r => r.score).filter(s => s !== null && !isNaN(s));
            const total = allResults.length;
            const rataRata = validScores.length ? (validScores.reduce((a, b) => a + Number(b), 0) / validScores.length).toFixed(1) : '0.0';
            const maxScore = validScores.length ? Math.max(...validScores) : 0;
            const minScore = validScores.length ? Math.min(...validScores) : 0;
            const kkm = 75;
            const tuntasCount = validScores.filter(s => Number(s) >= kkm).length;
            const belumTuntasCount = validScores.length - tuntasCount;
            const tuntasPct = validScores.length ? Math.round((tuntasCount / validScores.length) * 100) : 0;
            const belumTuntasPct = validScores.length ? (100 - tuntasPct) : 0;

            if (document.getElementById('statTotalPeserta')) document.getElementById('statTotalPeserta').innerText = total;
            if (document.getElementById('statRataRata')) document.getElementById('statRataRata').innerText = rataRata;
            if (document.getElementById('statNilaiMax')) document.getElementById('statNilaiMax').innerText = maxScore;
            if (document.getElementById('statNilaiMin')) document.getElementById('statNilaiMin').innerText = minScore;
            if (document.getElementById('statTuntasCount')) document.getElementById('statTuntasCount').innerText = tuntasCount;
            if (document.getElementById('statTuntasPct')) document.getElementById('statTuntasPct').innerText = `(${tuntasPct}%)`;
            if (document.getElementById('statBelumTuntasCount')) document.getElementById('statBelumTuntasCount').innerText = belumTuntasCount;
            if (document.getElementById('statBelumTuntasPct')) document.getElementById('statBelumTuntasPct').innerText = `(${belumTuntasPct}%)`;

            if(results.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-slate-400">Tidak ada data pengerjaan ujian yang sesuai dengan kriteria filter.</td></tr>';
                return;
            }

            results.forEach((r, idx) => {
                const s = r.user || {};
                const scoreDisplay = r.score !== null ? `<span class="font-black text-blue-800 text-sm font-mono">${r.score}</span>` : '<span class="text-gray-400 font-mono">-</span>';

                const startStr = r.startTime ? new Date(r.startTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '-';
                const endStr = r.endTime ? new Date(r.endTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : 'Sedang Mengerjakan';

                // Status Badge Color
                let statusBadge = `<span class="bg-blue-100 text-blue-800 text-xs px-2.5 py-0.5 rounded-full font-bold">${r.status || 'BELUM_MULAI'}</span>`;
                if (r.status === 'SELESAI' || r.status === 'TERVERIFIKASI') {
                    statusBadge = `<span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded-full font-bold">✅ ${r.status}</span>`;
                } else if (r.status === 'TERPUTUS' || r.status === 'RESET') {
                    statusBadge = `<span class="bg-rose-100 text-rose-800 text-xs px-2.5 py-0.5 rounded-full font-bold">⚠️ ${r.status}</span>`;
                }

                // Sync status indicator
                const syncBadge = r.syncStatus === 'PENDING' 
                    ? '<span class="text-amber-600 font-bold text-[10px]">🟡 Belum Sinkron</span>'
                    : '<span class="text-emerald-700 font-bold text-[10px]">🟢 Tersinkron</span>';

                tbody.innerHTML += `
                    <tr class="hover:bg-blue-50/60 border-b text-xs transition-colors">
                        <td class="p-3 text-center font-bold text-gray-500 font-mono">${idx + 1}</td>
                        <td class="p-3 font-bold text-gray-800">${escapeHtml(s.name || '-')}</td>
                        <td class="p-3 font-mono text-[11px] text-gray-600">${s.nisn || s.username || '-'}</td>
                        <td class="p-3"><span class="bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-lg text-xs font-semibold border border-blue-200/60">${s.className || '-'}</span></td>
                        <td class="p-3 font-mono text-[11px]">${startStr} - ${endStr}</td>
                        <td class="p-3 text-center font-bold font-mono">
                            <span class="text-emerald-700">${r.correctCount || 0}</span> / 
                            <span class="text-rose-700">${r.incorrectCount || 0}</span> / 
                            <span class="text-slate-400">${r.unansweredCount || 0}</span>
                        </td>
                        <td class="p-3 text-center">${scoreDisplay}</td>
                        <td class="p-3">${statusBadge}</td>
                        <td class="p-3">
                            <div>${syncBadge}</div>
                            <span class="text-[10px] text-gray-400 font-mono">${escapeHtml(r.deviceModel || 'APK Android')}</span>
                        </td>
                        <td class="p-3 text-center no-print">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="openItemResponsesModal('${r.examId}', '${r.id}', '${escapeJsArg(s.name || '-')}', '${escapeJsArg(s.className || '-')}')" class="px-2 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-lg text-[11px] border border-indigo-200 transition-all cursor-pointer" title="Detail Jawaban Butir & Respon">
                                    🔍 Detail
                                </button>
                                <button onclick="openLjsModal('${r.id}')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg text-[11px] border transition-all cursor-pointer" title="Buka Lembar Jawaban Siswa">
                                    📄 LJS
                                </button>
                                <button onclick="openMultiResetModal('${r.examId}', '${s.id}', '${escapeJsArg(s.name || '-')}', '${escapeJsArg(s.className || '-')}')" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-lg text-[11px] border border-rose-200 transition-all cursor-pointer" title="Reset Siswa (Multi-Type)">
                                    🔄 Reset
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
        }

