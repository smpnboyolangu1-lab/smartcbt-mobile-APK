        async function runAiPreviewExtract() {
            const rawText = document.getElementById('aiRawText').value.trim();
            const titleOverride = document.getElementById('aiTitle').value.trim();
            const subjectOverride = document.getElementById('aiSubject').value.trim();

            if (currentAiImportTab === 'file' && !selectedAiFile && rawText.length < 10) {
                alert('Silakan pilih berkas dokumen (Word, Excel, PDF) atau salin teks naskah soal');
                return;
            }
            if (currentAiImportTab === 'text' && rawText.length < 10) {
                alert('Teks naskah soal ujian wajib diisi minimal 10 karakter');
                return;
            }

            const btn = document.getElementById('btnRunAiPreview');
            btn.innerText = '⏳ AI Sedang Mengekstrak Dokumen & Menata Soal...';
            btn.disabled = true;

            try {
                let res;
                if (currentAiImportTab === 'file' && selectedAiFile) {
                    const formData = new FormData();
                    formData.append('file', selectedAiFile);
                    if (titleOverride) formData.append('titleOverride', titleOverride);
                    if (subjectOverride) formData.append('subjectOverride', subjectOverride);

                    res = await fetch('/api/exams/extract-ai-preview', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token },
                        body: formData
                    });
                } else {
                    res = await fetch('/api/exams/extract-ai-preview', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({ rawText, titleOverride, subjectOverride })
                    });
                }

                const data = await res.json();
                if(res.ok && data.draft) {
                    currentAiDraft = data.draft;
                    renderAiVerificationTable(data.draft);
                    document.getElementById('aiStep1').classList.add('hidden');
                    document.getElementById('aiStep2').classList.remove('hidden');
                } else {
                    alert(data.message || 'Gagal mengekstrak soal dengan AI');
                }
            } catch(e) {
                alert('Terjadi kesalahan saat memproses draft ekstraksi AI');
            } finally {
                btn.innerText = '🚀 Proses Ekstraksi AI & Tata Soal →';
                btn.disabled = false;
            }
        }

