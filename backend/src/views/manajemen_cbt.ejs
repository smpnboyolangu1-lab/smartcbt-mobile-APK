        function editSchedule(examId) {
            const e = allExams.find(x => x.id === examId);
            if(!e) return;

            document.getElementById('schExamId').value = e.id;
            document.getElementById('schSelectExam').value = e.id;
            if (document.getElementById('schExamType')) {
                document.getElementById('schExamType').value = e.examType || 'SAS';
                toggleSpecialExamTitleInput();
            }
            if (document.getElementById('schSpecialExamName')) {
                document.getElementById('schSpecialExamName').value = e.isSpecialExam && e.title ? e.title : '';
            }
            document.getElementById('schClass').value = e.assignedClasses || 'ALL';
            document.getElementById('schSession').value = e.sessionName || 'Sesi 1 (Pagi)';
            if (document.getElementById('schRoom')) {
                document.getElementById('schRoom').value = e.roomName || 'Lab Komputer 1';
            }
            if (document.getElementById('schProctor')) {
                document.getElementById('schProctor').value = e.proctorName || 'Proktor Utama';
            }
            document.getElementById('schDate').value = e.executionDate || new Date().toISOString().split('T')[0];
            document.getElementById('schStartTime').value = e.startTimeStr || '07:30';
            document.getElementById('schEndTime').value = e.endTimeStr || '09:30';
            document.getElementById('schDuration').value = e.durationMinutes || 90;
            if (document.getElementById('schMinDuration')) {
                document.getElementById('schMinDuration').value = e.minDurationMinutes || 30;
            }
            if (document.getElementById('schPassingGrade')) {
                document.getElementById('schPassingGrade').value = e.passingGrade || 75;
            }
            document.getElementById('schTokenActive').value = e.isTokenActive ? 'true' : 'false';
            if (document.getElementById('schMaxStrikes')) {
                document.getElementById('schMaxStrikes').value = e.maxStrikes || 3;
            }
            document.getElementById('schRandomQ').checked = e.randomizeQuestions !== false;
            document.getElementById('schRandomOpt').checked = e.randomizeOptions !== false;
            document.getElementById('schShowScore').checked = Boolean(e.showScoreToStudent);

            // Restore target classes & proctors
            const assigned = (e.assignedClasses || 'ALL').trim();
            const proctors = e.classProctors || {};
            if (assigned === 'ALL' || assigned === '') {
                if (document.getElementById('lvlKelas7')) document.getElementById('lvlKelas7').checked = true;
                if (document.getElementById('lvlKelas8')) document.getElementById('lvlKelas8').checked = true;
                if (document.getElementById('lvlKelas9')) document.getElementById('lvlKelas9').checked = true;
                const rLevel = document.querySelector('input[name="schTargetMode"][value="LEVEL"]');
                if (rLevel) rLevel.checked = true;
                toggleTargetClassMode();
                renderProctorAssignmentsGrid(ALL_ROMBELS, proctors);
            } else {
                const parts = assigned.split(',').map(s => s.trim());
                const isAllRombelsOfLevel = parts.some(p => p.startsWith('VII-') || p.startsWith('VIII-') || p.startsWith('IX-'));
                if (isAllRombelsOfLevel && parts.length > 3) {
                    const rRombel = document.querySelector('input[name="schTargetMode"][value="ROMBEL"]');
                    if (rRombel) rRombel.checked = true;
                    toggleTargetClassMode();
                    document.querySelectorAll('input[name="rombelCheck"]').forEach(cb => {
                        cb.checked = parts.includes(cb.value);
                    });
                    renderProctorAssignmentsGrid(parts, proctors);
                } else {
                    if (document.getElementById('lvlKelas7')) document.getElementById('lvlKelas7').checked = parts.includes('VII') || parts.some(p => p.startsWith('VII-'));
                    if (document.getElementById('lvlKelas8')) document.getElementById('lvlKelas8').checked = parts.includes('VIII') || parts.some(p => p.startsWith('VIII-'));
                    if (document.getElementById('lvlKelas9')) document.getElementById('lvlKelas9').checked = parts.includes('IX') || parts.some(p => p.startsWith('IX-'));
                    const rLevel = document.querySelector('input[name="schTargetMode"][value="LEVEL"]');
                    if (rLevel) rLevel.checked = true;
                    toggleTargetClassMode();
                    const selected = getCurrentSelectedRombels();
                    renderProctorAssignmentsGrid(selected, proctors);
                }
            }

            document.getElementById('modalSchedule').classList.remove('hidden');
        }

