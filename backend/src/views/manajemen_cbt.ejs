        const ALL_ROMBELS = [
            'VII-A','VII-B','VII-C','VII-D','VII-E','VII-F','VII-G','VII-H','VII-I','VII-J','VII-K',
            'VIII-A','VIII-B','VIII-C','VIII-D','VIII-E','VIII-F','VIII-G','VIII-H','VIII-I','VIII-J','VIII-K',
            'IX-A','IX-B','IX-C','IX-D','IX-E','IX-F','IX-G','IX-H','IX-I','IX-J','IX-K'
        ];

        let availableTeachersList = [];
        async function fetchTeachersForProctor(forceReload = false) {
            if (!forceReload && availableTeachersList.length > 0) return availableTeachersList;
            try {
                let res = await fetch('/api/teachers', { headers: { 'Authorization': 'Bearer ' + token } });
                if (!res.ok) {
                    res = await fetch('/api/guru', { headers: { 'Authorization': 'Bearer ' + token } });
                }
                const list = await res.json();
                if (Array.isArray(list)) {
                    availableTeachersList = list;
                } else if (list && Array.isArray(list.data)) {
                    availableTeachersList = list.data;
                }
            } catch (err) {
                console.warn('Gagal memuat daftar guru pengawas:', err);
            }
            return availableTeachersList;
        }

        async function reloadProctorTeachersList() {
            availableTeachersList = [];
            await fetchTeachersForProctor(true);
            const currentRombels = getCurrentSelectedRombels();
            await renderProctorAssignmentsGrid(currentRombels);
            alert(`✅ Data guru berhasil dimuat ulang! (${availableTeachersList.length} guru ditemukan)`);
        }

        function getCurrentSelectedRombels() {
            const mode = document.querySelector('input[name="schTargetMode"]:checked')?.value || 'LEVEL';
            if (mode === 'ROMBEL') {
                const checked = Array.from(document.querySelectorAll('input[name="rombelCheck"]:checked')).map(el => el.value);
                return checked.length > 0 ? checked : ALL_ROMBELS;
            } else {
                const c7 = document.getElementById('lvlKelas7')?.checked;
                const c8 = document.getElementById('lvlKelas8')?.checked;
                const c9 = document.getElementById('lvlKelas9')?.checked;
                const selected = [];
                if (c7) selected.push(...ALL_ROMBELS.filter(r => r.startsWith('VII-')));
                if (c8) selected.push(...ALL_ROMBELS.filter(r => r.startsWith('VIII-')));
                if (c9) selected.push(...ALL_ROMBELS.filter(r => r.startsWith('IX-')));
                return selected.length > 0 ? selected : ALL_ROMBELS;
            }
        }

