    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/';

        let chartTrendInstance = null;
        let chartSubjectInstance = null;
        let chartDonutInstance = null;

        loadChildData();
        loadParentConsultations();
        loadParentEFiles();
        loadBiodataStatus();

        function openConsultationModal() {
            document.getElementById('modalConsultation').classList.remove('hidden');
        }

        function closeConsultationModal() {
            document.getElementById('modalConsultation').classList.add('hidden');
        }

        async function loadParentConsultations() {
            try {
                const res = await fetch('/api/parent/bk-consultations', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const list = await res.json();
                const container = document.getElementById('parentConsultationList');

                if (!Array.isArray(list) || list.length === 0) {
                    container.innerHTML = `
                        <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed">
                            <span class="text-4xl mb-2 block">💬</span>
                            <p class="font-bold text-xs text-gray-700">Belum ada percakapan konsultasi dengan Guru BK</p>
                            <p class="text-[11px] text-gray-400 mt-0.5">Klik tombol "Tulis Pesan Konsultasi Baru" di atas untuk bertanya langsung kepada Guru BK.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = list.map(item => {
                    const isReplied = !!item.replyMessage;
                    const d = new Date(item.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    const replyDate = item.replyDate ? new Date(item.replyDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';

                    return `
                        <div class="p-4 bg-slate-50 rounded-2xl border hover:border-teal-400 transition-all">
                            <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-xs text-gray-800">${item.subject}</span>
                                    <span class="bg-blue-100 text-blue-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase">${item.category}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] text-gray-400">${d}</span>
                                    ${isReplied 
                                        ? '<span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded-full font-bold">🟢 Dibalas Guru BK</span>' 
                                        : '<span class="bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded-full font-bold">🟡 Menunggu Tanggapan</span>'}
                                </div>
                            </div>
                            <p class="text-xs text-gray-700 bg-white p-3 rounded-xl border mb-2">${item.message}</p>
                            
                            ${isReplied ? `
                                <div class="p-3 bg-teal-50 rounded-xl border border-teal-200 text-xs text-teal-900 mt-2">
                                    <div class="flex items-center justify-between mb-1 font-bold text-[11px] text-teal-800">
                                        <span>👩‍🏫 Tanggapan Guru BK (${item.counselor ? item.counselor.name : 'Guru BK'}):</span>
                                        <span class="text-[10px] font-normal text-teal-600">${replyDate}</span>
                                    </div>
                                    <p class="text-xs leading-relaxed">${item.replyMessage}</p>
                                </div>
                            ` : ''}
                        </div>
                    `;
                }).join('');
            } catch(e) {
                console.error(e);
            }
        }

        async function loadParentEFiles() {
            const container = document.getElementById('parentEFilesList');
            if (!container) return;
            try {
                const res = await fetch('/api/parent/e-files', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                const files = (data && data.files) ? data.files : (Array.isArray(data) ? data : []);
                if (files.length === 0) {
                    container.innerHTML = '<div class="col-span-full text-center py-6 text-gray-400 text-xs">Belum ada dokumen digital (rapor/kartu/sertifikat) yang dibagikan untuk siswa ini.</div>';
                    return;
                }
                container.innerHTML = files.map(f => {
                    let catIcon = '📄';
                    let catColor = 'border-blue-200 text-blue-700 bg-blue-50';
                    if (f.category === 'RAPOR') { catIcon = '📊'; catColor = 'border-indigo-200 text-indigo-700 bg-indigo-50'; }
                    else if (f.category === 'KARTU_PELAJAR') { catIcon = '💳'; catColor = 'border-teal-200 text-teal-700 bg-teal-50'; }
                    else if (f.category === 'SERTIFIKAT') { catIcon = '🏆'; catColor = 'border-purple-200 text-purple-700 bg-purple-50'; }
                    else if (f.category === 'SURAT') { catIcon = '📜'; catColor = 'border-amber-200 text-amber-700 bg-amber-50'; }

                    const fileUrl = f.fileUrl || '#';
                    return `
                        <div class="p-4 rounded-2xl border ${catColor} bg-white shadow-xs flex flex-col justify-between hover:shadow-md transition-all">
                            <div class="flex items-start gap-3">
                                <span class="text-3xl">${catIcon}</span>
                                <div class="overflow-hidden">
                                    <h4 class="font-bold text-xs text-gray-800 truncate" title="${f.title}">${f.title}</h4>
                                    <span class="inline-block mt-1 text-[10px] font-bold px-2 py-0.5 rounded-full border ${catColor}">${f.category || 'DOKUMEN'}</span>
                                    <p class="text-[10px] text-gray-400 mt-1">${f.fileSize || 'PDF Resmi'}</p>
                                </div>
