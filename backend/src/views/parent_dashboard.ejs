                            if(a.status === 'SICK') badge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-bold text-[10px]">🔵 Sakit</span>';
                            if(a.status === 'PERMISSION') badge = '<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-bold text-[10px]">🟣 Izin</span>';
                            if(a.status === 'ABSENT') badge = '<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded font-bold text-[10px]">🔴 Alpa</span>';

                            const d = new Date(a.scanTime);
