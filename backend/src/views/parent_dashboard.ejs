                    }

                    // 5. Presensi Table
                    const tbody = document.getElementById('parentAttendanceTable');
                    tbody.innerHTML = '';
                    if(data.recentAttendances && data.recentAttendances.length > 0) {
                        data.recentAttendances.forEach(a => {
