        async function handleSendConsultation(e) {
            e.preventDefault();
            const category = document.getElementById('consultCategory').value;
            const subject = document.getElementById('consultSubject').value;
            const message = document.getElementById('consultMessage').value;

            try {
                const res = await fetch('/api/parent/bk-consultation', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ category, subject, message })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ Pesan konsultasi Anda berhasil dikirim ke Guru BK!');
                    closeConsultationModal();
                    document.getElementById('formConsultation').reset();
                    loadParentConsultations();
                } else {
                    alert('❌ ' + (data.message || 'Gagal mengirim pesan'));
                }
            } catch(e) {
                alert('❌ Terjadi kesalahan saat mengirim konsultasi');
            }
        }


        async function loadChildData() {
            try {
                const res = await fetch('/api/parent/my-child', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if(res.ok && data.child) {
                    const c = data.child;
                    document.getElementById('childName').innerText = c.name;
                    document.getElementById('childClass').innerText = 'Kelas ' + (c.className || 'VII-A');
                    document.getElementById('childNisn').innerText = c.nisn || '-';
                    const cleanMother = (c.motherName && c.motherName !== 'Ibu Siswa') ? c.motherName.trim() : '';
                    const pName = cleanMother ? ('Ibu ' + cleanMother) : (c.fatherName ? ('Bapak ' + c.fatherName.trim()) : 'Ibu Wali Murid');
                    document.getElementById('childParentName').innerText = pName;
                    document.getElementById('parentHeaderWelcome').innerText = `Selamat Datang, ${pName}! 👋`;
                    document.getElementById('parentHeaderSub').innerText = `Orang Tua / Wali dari ${c.name} • Kelas ${c.className || '-'}`;
                    document.getElementById('childAvatar').innerText = c.name.charAt(0).toUpperCase();

                    const growth = data.academicGrowth || {};
                    document.getElementById('scoreOverall').innerText = (growth.overallAverage != null) ? growth.overallAverage : '-';
                    document.getElementById('badgeRank').innerText = growth.rankInClass ? ('🏆 ' + growth.rankInClass) : '🏆 Siswa Aktif';
                    document.getElementById('trendStatusText').innerText = growth.trendStatus || 'Data Nilai Terkini';

                    // 1. Render Line Chart (Tren Nilai Ujian)
                    renderTrendChart(growth.timelineLabels || ['UH 1', 'PTS', 'UH 2', 'PAS'], growth.studentScores || [0, 0, 0, 0], growth.classAverages || [0, 0, 0, 0]);

                    // 2. Render Bar Chart (Performa Mapel)
                    renderSubjectChart(growth.subjectPerformance || []);

                    // 3. Render Subject Progress Bars
                    renderSubjectList(growth.subjectPerformance || []);

                    // 4. Render Donut Kehadiran
                    const att = data.attendanceSummary || {};
                    const presCount = att.present != null ? att.present : 0;
                    const lateCount = att.late != null ? att.late : 0;
                    const sickCount = att.sick != null ? att.sick : 0;
                    const permCount = att.permission != null ? att.permission : 0;
                    const totalAtt = (att.totalScans || (presCount + lateCount + sickCount + permCount + alpaCount)) || 1;
                    document.getElementById('attPresentCount').innerText = presCount;
                    document.getElementById('attLateCount').innerText = lateCount;
                    if (document.getElementById('attSickPermitCount')) document.getElementById('attSickPermitCount').innerText = sickCount + permCount;
                    if (document.getElementById('attAbsentCount')) document.getElementById('attAbsentCount').innerText = alpaCount;

                    if (document.getElementById('attPresentPercent')) document.getElementById('attPresentPercent').innerText = att.percentPresent || `${((presCount / totalAtt) * 100).toFixed(1)}%`;
                    if (document.getElementById('attLatePercent')) document.getElementById('attLatePercent').innerText = att.percentLate || `${((lateCount / totalAtt) * 100).toFixed(1)}%`;
                    if (document.getElementById('attSickPermitPercent')) document.getElementById('attSickPermitPercent').innerText = `${(((sickCount + permCount) / totalAtt) * 100).toFixed(1)}%`;
                    if (document.getElementById('attAbsentPercent')) document.getElementById('attAbsentPercent').innerText = att.percentAbsent || `${((alpaCount / totalAtt) * 100).toFixed(1)}%`;
                    if (document.getElementById('attTotalPercent')) document.getElementById('attTotalPercent').innerText = att.percentTotalKehadiran || `${(((presCount + lateCount) / totalAtt) * 100).toFixed(1)}%`;

                    renderAttendanceDonut(presCount, lateCount, sickCount, permCount, alpaCount);
                    renderParentAttendanceTrend(data.attendanceTrend || (data.attendanceSummary && data.attendanceSummary.trend) || data.recentAttendances);

                    // 4b. Render Statistik Keterlambatan Ananda
                    const lateData = data.lateAnalytics || {};
                    const totalLate = lateData.totalLate || 0;
                    document.getElementById('lateCountStat').innerHTML = `${totalLate} <span class="text-xs font-bold text-gray-500">Kali</span>`;
                    document.getElementById('lateAvgMinutesStat').innerHTML = `${lateData.averageLateMinutes || 0} <span class="text-xs font-bold text-gray-500">Menit</span>`;
                    document.getElementById('lateAvgTimeStat').innerHTML = `${lateData.averageArrivalTime || '--:--'} <span class="text-xs font-bold text-gray-500">WIB</span>`;
                    document.getElementById('lateFrequentDayStat').innerText = `Hari sering terlambat: ${lateData.mostFrequentLateDay || '-'}`;
                    document.getElementById('latePointsStat').innerHTML = `${lateData.totalDisciplinePoints || 0} <span class="text-xs font-bold text-gray-500">Poin</span>`;

                    const riskBadge = document.getElementById('lateRiskBadge');
                    if (totalLate >= 5) {
                        riskBadge.className = 'bg-red-100 text-red-800 text-xs px-3.5 py-1.5 rounded-full font-bold border border-red-300 animate-pulse';
