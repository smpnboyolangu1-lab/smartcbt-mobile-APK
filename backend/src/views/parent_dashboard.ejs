        function renderAttendanceDonut(present, late, sick, permission, absent) {
            const ctx = document.getElementById('chartAttendanceDonut').getContext('2d');
            if (chartDonutInstance) chartDonutInstance.destroy();

            chartDonutInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Hadir Tepat', 'Terlambat', 'Sakit', 'Izin', 'Alpa'],
                    datasets: [{
                        data: [present, late, sick, permission, absent],
                        backgroundColor: ['#10B981', '#F59E0B', '#3B82F6', '#8B5CF6', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                    },
                    cutout: '70%'
                }
            });
        }

        let chartParentTrendInstance = null;
        function renderParentAttendanceTrend(trendList) {
            const canvas = document.getElementById('chartParentAttendanceTrend');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (chartParentTrendInstance) chartParentTrendInstance.destroy();

            let labels = [];
            let scores = [];
            let pointColors = [];

            if (trendList && trendList.length > 0) {
                labels = trendList.map(t => t.label || (t.scanTime ? new Date(t.scanTime).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) : 'Hari'));
                scores = trendList.map(t => {
                    if (t.score !== undefined) return t.score;
                    const st = (t.status || '').toUpperCase();
                    if (st === 'LATE' || st === 'TERLAMBAT') return 80;
                    if (st === 'SICK' || st === 'PERMISSION' || st === 'SAKIT' || st === 'IZIN') return 50;
                    if (st === 'ABSENT' || st === 'ALPA') return 0;
                    return 100;
                });
                pointColors = scores.map(s => s >= 100 ? '#10B981' : (s >= 80 ? '#F59E0B' : (s >= 50 ? '#3B82F6' : '#EF4444')));
            } else {
                labels = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sen', 'Sel'];
                scores = [100, 100, 100, 80, 100, 100, 100];
                pointColors = scores.map(s => s >= 100 ? '#10B981' : '#F59E0B');
            }

            chartParentTrendInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tingkat Kehadiran (%)',
                        data: scores,
                        borderColor: '#059669',
                        backgroundColor: 'rgba(5, 150, 105, 0.08)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: pointColors,
                        pointBorderColor: '#FFFFFF',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 0,
                            max: 105,
                            ticks: {
                                stepSize: 25,
                                callback: function(val) { return val + '%'; },
                                font: { size: 9, weight: 'bold' }
                            },
                            grid: { color: '#F1F5F9' }
                        },
                        x: {
                            ticks: { font: { size: 9 } },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const score = context.parsed.y;
                                    let statusText = 'Hadir Tepat (100%)';
                                    if (score === 80) statusText = 'Terlambat (80%)';
                                    else if (score === 50) statusText = 'Izin/Sakit (50%)';
                                    else if (score === 0) statusText = 'Alpa (0%)';
                                    return `Status: ${statusText}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // ========================================================
        // MODUL POPUP FORMULIR BIODATA & BUKU INDUK SISWA (SIAKAD)
        // ========================================================
        let currentBiodataStep = 1;
        let portalBiodataSubmission = null;
        let portalFiles = { kk: null, akta: null, bantuan: null };
        let existingFileUrls = { kk: null, akta: null, bantuan: null };
        let isBiodataLocked = false;

        function openBiodataModal() {
            document.getElementById('modalBiodataParent').classList.remove('hidden');
            goToBiodataStep(1);
        }

        function closeBiodataModal() {
            document.getElementById('modalBiodataParent').classList.add('hidden');
        }

        function togglePortalKesejahteraan(show) {
            const box = document.getElementById('boxPortalKesejahteraan');
            const summary = document.getElementById('portalStep5BantuanSummary');
            if (show) {
                box.classList.remove('hidden');
                summary.classList.remove('hidden');
            } else {
                box.classList.add('hidden');
                summary.classList.add('hidden');
            }
        }

        function handlePortalFilePicked(type, input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            portalFiles[type] = file;

            const isImg = file.type.startsWith('image/');
            const fileName = file.name;

            if (type === 'kk') {
                document.getElementById('portalKkFileName').innerText = '📄 ' + fileName;
                document.getElementById('badgePortalKkStatus').innerText = '✅ Siap Dikirim';
                document.getElementById('badgePortalKkStatus').className = 'text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md';
                if (isImg) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const img = document.getElementById('portalKkImgPreview');
                        img.src = e.target.result;
                        img.classList.remove('hidden');
                        document.getElementById('portalKkPlaceholder').classList.add('hidden');
                    };
                    reader.readAsDataURL(file);
                } else {
                    document.getElementById('portalKkPlaceholder').innerText = '📄 Berkas PDF: ' + fileName;
                    document.getElementById('portalKkPlaceholder').classList.remove('hidden');
                    document.getElementById('portalKkImgPreview').classList.add('hidden');
                }
            } else if (type === 'akta') {
                document.getElementById('portalAktaFileName').innerText = '📄 ' + fileName;
                document.getElementById('badgePortalAktaStatus').innerText = '✅ Siap Dikirim';
                document.getElementById('badgePortalAktaStatus').className = 'text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md';
                if (isImg) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const img = document.getElementById('portalAktaImgPreview');
                        img.src = e.target.result;
                        img.classList.remove('hidden');
                        document.getElementById('portalAktaPlaceholder').classList.add('hidden');
                    };
                    reader.readAsDataURL(file);
                } else {
                    document.getElementById('portalAktaPlaceholder').innerText = '📄 Berkas PDF: ' + fileName;
                    document.getElementById('portalAktaPlaceholder').classList.remove('hidden');
                    document.getElementById('portalAktaImgPreview').classList.add('hidden');
                }
            } else if (type === 'bantuan') {
                document.getElementById('portalBantuanFileName').innerText = '📄 ' + fileName;
                document.getElementById('badgePortalBantuanStatus').innerText = '✅ Siap Dikirim';
                document.getElementById('badgePortalBantuanStatus').className = 'text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md';
                if (isImg) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const img = document.getElementById('portalBantuanImgPreview');
                        img.src = e.target.result;
                        document.getElementById('portalBantuanPreviewContainer').classList.remove('hidden');
                    };
                    reader.readAsDataURL(file);
                } else {
                    document.getElementById('portalBantuanPreviewContainer').classList.add('hidden');
                }
            }
        }

        function validatePortalStep(step) {
            if (step === 1) {
                const name = document.getElementById('w_studentName').value.trim();
                const nisn = document.getElementById('w_nisn').value.trim();
                const nik = document.getElementById('w_nik').value.trim();
                const pob = document.getElementById('w_pob').value.trim();
                const dob = document.getElementById('w_dob').value.trim();
                if (!name) { alert('Nama Lengkap Siswa wajib diisi.'); return false; }
                if (nisn.length < 10) { alert('NISN wajib 10 digit.'); return false; }
                if (nik.length < 16) { alert('NIK Siswa wajib 16 digit sesuai KK.'); return false; }
                if (!pob || !dob) { alert('Tempat dan Tanggal Lahir siswa wajib diisi.'); return false; }
            } else if (step === 2) {
                const street = document.getElementById('w_street').value.trim();
                const rt = document.getElementById('w_rt').value.trim();
                const rw = document.getElementById('w_rw').value.trim();
                const village = document.getElementById('w_village').value.trim();
                const district = document.getElementById('w_district').value.trim();
                const city = document.getElementById('w_city').value.trim();
                const province = document.getElementById('w_province').value.trim();
                if (!street || !rt || !rw || !village || !district || !city || !province) {
                    alert('Harap lengkapi alamat domisili (Jalan, RT, RW, Kelurahan, Kecamatan, Kota, Provinsi).');
                    return false;
                }
            } else if (step === 3) {
                const fName = document.getElementById('w_fatherName').value.trim();
                const mName = document.getElementById('w_motherName').value.trim();
                const phone = document.getElementById('w_parentPhone').value.trim();
                if (!fName) { alert('Nama Ayah Kandung wajib diisi.'); return false; }
                if (!mName) { alert('Nama Ibu Kandung wajib diisi.'); return false; }
                if (!phone || phone.length < 9) { alert('Nomor WhatsApp aktif Orang Tua wajib diisi.'); return false; }
            } else if (step === 4) {
                const hasKesejahteraan = document.getElementById('rbKesejahteraanYes').checked;
                if (hasKesejahteraan) {
                    const bNumber = document.getElementById('w_bantuanNumber').value.trim();
                    if (!bNumber) { alert('Nomor Kartu Bantuan wajib diisi.'); return false; }
                    if (!portalFiles.bantuan && !existingFileUrls.bantuan) {
                        alert('Harap lampirkan foto/scan Kartu Bantuan Anda.');
                        return false;
                    }
                }
            }
            return true;
        }

        function goToBiodataStep(step) {
            if (step > currentBiodataStep) {
                for (let i = currentBiodataStep; i < step; i++) {
                    if (!validatePortalStep(i)) return;
                }
            }
            currentBiodataStep = step;

            for (let i = 1; i <= 5; i++) {
                const stepEl = document.getElementById('portalStep' + i);
                const indEl = document.getElementById('stepTabIndicator' + i);
                if (stepEl) {
                    if (i === step) stepEl.classList.remove('hidden');
                    else stepEl.classList.add('hidden');
                }
                if (indEl) {
                    if (i === step) {
                        indEl.className = 'flex items-center gap-2 text-xs font-bold px-3 py-1.5 rounded-xl bg-blue-600 text-white shrink-0 shadow-xs';
                    } else if (i < step) {
                        indEl.className = 'flex items-center gap-2 text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 shrink-0';
                    } else {
                        indEl.className = 'flex items-center gap-2 text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-200 text-slate-600 shrink-0';
                    }
                }
            }

            document.getElementById('portalCurrentStepIndicator').innerText = step;
            const btnPrev = document.getElementById('btnPortalStepPrev');
            const btnNext = document.getElementById('btnPortalStepNext');
            const btnSubmit = document.getElementById('btnPortalGlowingSubmit');

            btnPrev.disabled = (step === 1);

            if (step === 5) {
                btnNext.classList.add('hidden');
                if (!isBiodataLocked) {
                    btnSubmit.classList.remove('hidden');
                } else {
                    btnSubmit.classList.add('hidden');
                }
            } else {
                btnNext.classList.remove('hidden');
                btnSubmit.classList.add('hidden');
            }
        }

        function navigatePortalStep(delta) {
            goToBiodataStep(currentBiodataStep + delta);
        }

        async function loadBiodataStatus() {
            try {
                const res = await fetch('/api/v1/mobile/biodata/my-submission', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (!data.success) return;

                const status = data.status || 'NOT_SUBMITTED';
                const submission = data.submission;
                const student = data.student;
                const topBadge = document.getElementById('badgeBiodataTop');
                const btnText = document.getElementById('btnOpenBiodataText');
                const headerBadge = document.getElementById('modalBiodataHeaderBadge');
                const rejNotice = document.getElementById('biodataRejectionNotice');
                const rejText = document.getElementById('biodataRejectionText');

                isBiodataLocked = data.isLocked || (status === 'APPROVED');
                headerBadge.innerText = status;

                if (status === 'APPROVED') {
                    topBadge.innerText = '🟢 TERVERIFIKASI & DISETUJUI TU';
                    topBadge.className = 'text-xs px-3 py-0.5 rounded-full font-bold bg-emerald-400 text-emerald-950';
                    btnText.innerText = 'Lihat Biodata Terverifikasi';
                    headerBadge.className = 'bg-emerald-400 text-emerald-950 text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full shadow-xs';
                    rejNotice.classList.add('hidden');
                } else if (status === 'PENDING') {
                    topBadge.innerText = '🟡 MENUNGGU VERIFIKASI TU';
                    topBadge.className = 'text-xs px-3 py-0.5 rounded-full font-bold bg-amber-400 text-amber-950';
                    btnText.innerText = 'Periksa / Edit Pengajuan';
                    headerBadge.className = 'bg-amber-400 text-amber-950 text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full shadow-xs';
                    rejNotice.classList.add('hidden');
                } else if (status === 'REJECTED') {
                    topBadge.innerText = '🔴 PERLU PERBAIKAN';
                    topBadge.className = 'text-xs px-3 py-0.5 rounded-full font-bold bg-rose-500 text-white';
                    btnText.innerText = 'Perbaiki Biodata Sekarang';
                    headerBadge.className = 'bg-rose-500 text-white text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full shadow-xs';
                    if (data.rejectionReason) {
                        rejText.innerText = data.rejectionReason;
                        rejNotice.classList.remove('hidden');
                    }
                } else {
                    topBadge.innerText = '⚪ BELUM MENGISI';
                    topBadge.className = 'text-xs px-3 py-0.5 rounded-full font-bold bg-blue-300 text-blue-950';
                    btnText.innerText = 'Isi Biodata Sekarang';
                    headerBadge.className = 'bg-slate-300 text-slate-900 text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full shadow-xs';
                    rejNotice.classList.add('hidden');
                }

                // Pre-populate student data
                if (student) {
                    if (student.name) document.getElementById('w_studentName').value = student.name;
                    if (student.nisn) document.getElementById('w_nisn').value = student.nisn;
                    if (student.nik) document.getElementById('w_nik').value = student.nik;
                    if (student.pob) document.getElementById('w_pob').value = student.pob;
                    if (student.dob) {
                        const dobStr = new Date(student.dob).toISOString().split('T')[0];
                        document.getElementById('w_dob').value = dobStr;
                    }
                    if (student.gender) document.getElementById('w_gender').value = student.gender;
                    if (student.religion) document.getElementById('w_religion').value = student.religion;
                    if (student.address) document.getElementById('w_street').value = student.address;
                    if (student.fatherName) document.getElementById('w_fatherName').value = student.fatherName;
                    if (student.motherName) document.getElementById('w_motherName').value = student.motherName;
                    if (student.parentPhone) document.getElementById('w_parentPhone').value = student.parentPhone;
                }

                // Pre-populate submission data
                if (submission) {
                    try {
                        const s1 = typeof submission.step1Data === 'string' ? JSON.parse(submission.step1Data || '{}') : (submission.step1Data || {});
                        if (s1.siblingOrder) document.getElementById('w_siblingOrder').value = s1.siblingOrder;
                        if (s1.siblingsCount) document.getElementById('w_siblingsCount').value = s1.siblingsCount;
                        if (s1.height) document.getElementById('w_height').value = s1.height;
                        if (s1.weight) document.getElementById('w_weight').value = s1.weight;

                        const s2 = typeof submission.step2Data === 'string' ? JSON.parse(submission.step2Data || '{}') : (submission.step2Data || {});
                        if (s2.address) document.getElementById('w_street').value = s2.address;
                        if (s2.rt) document.getElementById('w_rt').value = s2.rt;
                        if (s2.rw) document.getElementById('w_rw').value = s2.rw;
                        if (s2.village) document.getElementById('w_village').value = s2.village;
                        if (s2.district) document.getElementById('w_district').value = s2.district;
                        if (s2.city) document.getElementById('w_city').value = s2.city;
                        if (s2.province) document.getElementById('w_province').value = s2.province;
                        if (s2.postalCode) document.getElementById('w_postalCode').value = s2.postalCode;
                        if (s2.liveWith) document.getElementById('w_liveWith').value = s2.liveWith;
                        if (s2.transportation) document.getElementById('w_transportation').value = s2.transportation;
                        if (s2.distance) document.getElementById('w_distance').value = s2.distance;
                        if (s2.travelTime) document.getElementById('w_travelTime').value = s2.travelTime;

                        const s3 = typeof submission.step3Data === 'string' ? JSON.parse(submission.step3Data || '{}') : (submission.step3Data || {});
                        if (s3.fatherName) document.getElementById('w_fatherName').value = s3.fatherName;
                        if (s3.fatherNik) document.getElementById('w_fatherNik').value = s3.fatherNik;
                        if (s3.fatherStatus) document.getElementById('w_fatherStatus').value = s3.fatherStatus;
                        if (s3.fatherJob) document.getElementById('w_fatherJob').value = s3.fatherJob;
                        if (s3.fatherIncome) document.getElementById('w_fatherIncome').value = s3.fatherIncome;

                        if (s3.motherName) document.getElementById('w_motherName').value = s3.motherName;
                        if (s3.motherNik) document.getElementById('w_motherNik').value = s3.motherNik;
                        if (s3.motherStatus) document.getElementById('w_motherStatus').value = s3.motherStatus;
                        if (s3.motherJob) document.getElementById('w_motherJob').value = s3.motherJob;
                        if (s3.motherIncome) document.getElementById('w_motherIncome').value = s3.motherIncome;

                        if (s3.parentPhone) document.getElementById('w_parentPhone').value = s3.parentPhone;

                        const s4 = typeof submission.step4Data === 'string' ? JSON.parse(submission.step4Data || '{}') : (submission.step4Data || {});
                        if (s4.hasKesejahteraan === true || s4.hasKesejahteraan === '1' || s4.hasKesejahteraan === 'true') {
                            document.getElementById('rbKesejahteraanYes').checked = true;
                            togglePortalKesejahteraan(true);
                            if (s4.bantuanType) document.getElementById('w_bantuanType').value = s4.bantuanType;
                            if (s4.bantuanNumber) document.getElementById('w_bantuanNumber').value = s4.bantuanNumber;
                        }

                        // Preserved Files
                        if (submission.kkFileUrl) {
                            existingFileUrls.kk = submission.kkFileUrl;
                            document.getElementById('badgePortalKkStatus').innerText = '✅ Tersimpan';
                            document.getElementById('badgePortalKkStatus').className = 'text-[10px] font-bold text-blue-800 bg-blue-100 px-2 py-0.5 rounded-md';
                            document.getElementById('portalKkFileName').innerText = '📄 ' + submission.kkFileUrl.split('/').pop();
                            const img = document.getElementById('portalKkImgPreview');
                            img.src = submission.kkFileUrl;
                            img.classList.remove('hidden');
                            document.getElementById('portalKkPlaceholder').classList.add('hidden');
                        }

                        if (submission.aktaFileUrl) {
                            existingFileUrls.akta = submission.aktaFileUrl;
                            document.getElementById('badgePortalAktaStatus').innerText = '✅ Tersimpan';
                            document.getElementById('badgePortalAktaStatus').className = 'text-[10px] font-bold text-blue-800 bg-blue-100 px-2 py-0.5 rounded-md';
                            document.getElementById('portalAktaFileName').innerText = '📄 ' + submission.aktaFileUrl.split('/').pop();
                            const img = document.getElementById('portalAktaImgPreview');
                            img.src = submission.aktaFileUrl;
                            img.classList.remove('hidden');
                            document.getElementById('portalAktaPlaceholder').classList.add('hidden');
                        }

                        const s4BantuanUrl = s4.bantuanFileUrl || (submission.payloadJson ? JSON.parse(submission.payloadJson).bantuanFileUrl : null);
                        if (s4BantuanUrl) {
                            existingFileUrls.bantuan = s4BantuanUrl;
                            document.getElementById('badgePortalBantuanStatus').innerText = '✅ Tersimpan';
                            document.getElementById('badgePortalBantuanStatus').className = 'text-[10px] font-bold text-blue-800 bg-blue-100 px-2 py-0.5 rounded-md';
                            document.getElementById('portalBantuanFileName').innerText = '📄 ' + s4BantuanUrl.split('/').pop();
                            const img = document.getElementById('portalBantuanImgPreview');
                            img.src = s4BantuanUrl;
                            document.getElementById('portalBantuanPreviewContainer').classList.remove('hidden');
                        }
                    } catch (e) {
                        console.error('Error parsing submission:', e);
                    }
                }
            } catch (err) {
                console.error('Error loadBiodataStatus:', err);
            }
        }

        async function handleBiodataSubmit(e) {
            if (e && e.preventDefault) e.preventDefault();

            // Validate all 5 steps
            for (let step = 1; step <= 4; step++) {
                if (!validatePortalStep(step)) {
                    goToBiodataStep(step);
                    return;
                }
            }

            // Step 5 validation: KK & Akta
            if (!portalFiles.kk && !existingFileUrls.kk) {
                alert('⚠️ Foto Kartu Keluarga (KK) wajib diunggah!');
                goToBiodataStep(5);
                return;
            }
            if (!portalFiles.akta && !existingFileUrls.akta) {
                alert('⚠️ Foto Akta Kelahiran wajib diunggah!');
                goToBiodataStep(5);
                return;
            }

            const btnSubmit = document.getElementById('btnPortalGlowingSubmit');
            const origHtml = btnSubmit.innerHTML;
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span>⏳</span> <span>Mengirim ke Staf TU...</span>';

            try {
                const formData = new FormData();

                // Step 1 Payload
                const step1Obj = {
                    name: document.getElementById('w_studentName').value.trim(),
                    nisn: document.getElementById('w_nisn').value.trim(),
                    nik: document.getElementById('w_nik').value.trim(),
                    gender: document.getElementById('w_gender').value,
                    pob: document.getElementById('w_pob').value.trim(),
                    dob: document.getElementById('w_dob').value,
                    religion: document.getElementById('w_religion').value,
                    siblingOrder: document.getElementById('w_siblingOrder').value,
                    siblingsCount: document.getElementById('w_siblingsCount').value,
                    height: document.getElementById('w_height').value,
                    weight: document.getElementById('w_weight').value
                };
                formData.append('step1Data', JSON.stringify(step1Obj));

                // Step 2 Payload
                const step2Obj = {
                    address: document.getElementById('w_street').value.trim(),
                    rt: document.getElementById('w_rt').value.trim(),
                    rw: document.getElementById('w_rw').value.trim(),
                    village: document.getElementById('w_village').value.trim(),
                    district: document.getElementById('w_district').value.trim(),
                    city: document.getElementById('w_city').value.trim(),
                    province: document.getElementById('w_province').value.trim(),
                    postalCode: document.getElementById('w_postalCode').value.trim(),
                    liveWith: document.getElementById('w_liveWith').value,
                    transportation: document.getElementById('w_transportation').value,
                    distance: document.getElementById('w_distance').value,
                    travelTime: document.getElementById('w_travelTime').value
                };
                formData.append('step2Data', JSON.stringify(step2Obj));

                // Step 3 Payload (Ayah & Ibu separated)
                const step3Obj = {
                    fatherName: document.getElementById('w_fatherName').value.trim(),
                    fatherNik: document.getElementById('w_fatherNik').value.trim(),
                    fatherStatus: document.getElementById('w_fatherStatus').value,
                    fatherJob: document.getElementById('w_fatherJob').value,
                    fatherIncome: document.getElementById('w_fatherIncome').value,

                    motherName: document.getElementById('w_motherName').value.trim(),
                    motherNik: document.getElementById('w_motherNik').value.trim(),
                    motherStatus: document.getElementById('w_motherStatus').value,
                    motherJob: document.getElementById('w_motherJob').value,
                    motherIncome: document.getElementById('w_motherIncome').value,

                    parentPhone: document.getElementById('w_parentPhone').value.trim()
                };
                formData.append('step3Data', JSON.stringify(step3Obj));

                // Step 4 Payload (Kesejahteraan)
                const hasKesejahteraan = document.getElementById('rbKesejahteraanYes').checked;
                const step4Obj = {
                    hasKesejahteraan,
                    bantuanType: hasKesejahteraan ? document.getElementById('w_bantuanType').value : null,
                    bantuanNumber: hasKesejahteraan ? document.getElementById('w_bantuanNumber').value.trim() : null
                };
                formData.append('step4Data', JSON.stringify(step4Obj));

                // Step 5 Payload
                formData.append('step5Data', JSON.stringify({ isComplete: true }));

                // Append Files
                if (portalFiles.kk) formData.append('kk', portalFiles.kk);
                if (portalFiles.akta) formData.append('akta', portalFiles.akta);
                if (hasKesejahteraan && portalFiles.bantuan) formData.append('bantuan', portalFiles.bantuan);

                const res = await fetch('/api/v1/mobile/biodata/submit', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token },
                    body: formData
                });
                const result = await res.json();

                if (res.ok && result.success) {
                    alert('🎉 Formulir Biodata & Buku Induk Siswa berhasil dikirimkan ke antrean verifikasi Petugas TU!');
                    closeBiodataModal();
                    loadBiodataStatus();
                } else {
                    alert('❌ ' + (result.message || 'Gagal mengirimkan formulir biodata'));
                }
            } catch (err) {
                alert('❌ Terjadi kesalahan jaringan saat mengirim biodata.');
                console.error(err);
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = origHtml;
            }
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            sessionStorage.clear();
            window.location.href = '/';
        }
    </script>
</body>
