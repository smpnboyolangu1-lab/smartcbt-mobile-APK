<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Orang Tua Siswa - Grafik & Analitik Perkembangan Anak</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/chart.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0A2E5C; }
        .bg-unbk-blue { background-color: #1565C0; }
        .gradient-card-growth {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }
        .progress-pill { transition: all 0.2s ease; }
        .progress-pill:hover { transform: translateY(-2px); }
        .gradient-header-biodata {
            background: linear-gradient(135deg, #1E3A8A 0%, #3B82F6 50%, #7C3AED 100%);
        }
        @keyframes glowPulse {
            0%, 100% {
                box-shadow: 0 0 15px rgba(59, 130, 246, 0.6), 0 0 30px rgba(124, 58, 237, 0.4);
                transform: scale(1);
            }
            50% {
                box-shadow: 0 0 25px rgba(59, 130, 246, 0.9), 0 0 45px rgba(124, 58, 237, 0.7);
                transform: scale(1.01);
            }
        }
        .btn-glowing-submit {
            background: linear-gradient(135deg, #2563EB 0%, #7C3AED 50%, #EC4899 100%);
            animation: glowPulse 2.5s infinite ease-in-out;
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        .btn-glowing-submit:hover {
            filter: brightness(1.1);
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen pb-16">
    <!-- Top Header Navigation -->
    <header class="bg-[#0e1d40] text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center font-bold text-2xl shadow">
                    👨‍👩‍👧
                </div>
                <div>
                    <h1 class="font-black text-lg leading-tight" id="parentHeaderWelcome">Portal Orang Tua / Wali Siswa</h1>
                    <p class="text-xs text-blue-200" id="parentHeaderSub">Monitoring Realtime Grafik Perkembangan Akademik & Karakter Anak</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs bg-blue-800/80 px-3.5 py-1.5 rounded-full font-bold border border-blue-600/50" id="parentUserBadge">Wali Murid</span>
                <button onclick="logout()" class="bg-red-600 hover:bg-red-700 text-white text-xs font-bold px-4 py-2 rounded-xl shadow transition-colors">Logout</button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
        <!-- 1. IDENTITAS PROFIL ANAK & HIGHLIGHT PRESTASI -->
        <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col md:flex-row items-center gap-6">
            <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-blue-600 to-indigo-700 text-white flex items-center justify-center font-black text-4xl shadow-xl border-4 border-white" id="childAvatar">
                S
            </div>
            <div class="flex-1 text-center md:text-left">
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mb-1.5">
                    <h2 class="text-2xl font-black text-gray-900" id="childName">Nama Siswa</h2>
                    <span class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold">🟢 Siswa Aktif CBT</span>
                    <span class="bg-purple-100 text-purple-800 text-xs px-3 py-1 rounded-full font-bold" id="badgeRank">🏆 Peringkat 3 di Kelas</span>
                </div>
                <p class="text-sm font-bold text-blue-800 mb-2">Tingkat & Rombel: <span id="childClass" class="bg-blue-50 px-2 py-0.5 rounded-lg border border-blue-200">Kelas VII-A</span></p>
                <div class="flex flex-wrap justify-center md:justify-start gap-4 text-xs text-gray-500 font-mono">
                    <span>NISN: <b class="text-gray-800" id="childNisn">-</b></span>
                    <span>NIS: <b class="text-gray-800" id="childNis">-</b></span>
                    <span>Wali / Orang Tua: <b class="text-gray-800" id="childParentName">-</b></span>
                </div>
            </div>
            <div class="flex flex-col items-center md:items-end gap-2">
                <div class="bg-gradient-to-br from-emerald-500 to-teal-700 text-white p-4 rounded-2xl shadow-lg text-center min-w-[160px]">
                    <p class="text-[11px] uppercase tracking-wider font-bold opacity-90">Rata-rata Nilai</p>
                    <p class="text-3xl font-black" id="scoreOverall">88.6</p>
                    <p class="text-[10px] font-semibold mt-0.5">Predikat A (Sangat Baik)</p>
                </div>
            </div>
        </div>

        <!-- 📋 BANNER FORMULIR BIODATA & BUKU INDUK SISWA (SIAKAD) -->
        <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 rounded-3xl p-6 text-white shadow-xl border border-blue-700/50 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>
            <div class="flex items-start gap-4 z-10">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-500 to-indigo-500 flex items-center justify-center text-3xl shadow-lg border border-white/20 shrink-0">
                    📋
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                        <h3 class="text-lg font-black tracking-tight text-white">Formulir Biodata & Buku Induk Siswa (SIAKAD)</h3>
                        <span id="badgeBiodataTop" class="text-xs px-3 py-0.5 rounded-full font-bold bg-amber-400 text-amber-950">Memuat status...</span>
                    </div>
                    <p class="text-xs text-blue-200 max-w-2xl leading-relaxed">
                        Pengisian data pokok siswa, identitas orang tua (ayah & ibu), status penghasilan terpisah, data afirmasi/kesejahteraan sosial, serta unggah berkas resmi Kartu Keluarga & Akta Kelahiran langsung ke Staf Tata Usaha (TU).
                    </p>
                    <div id="biodataRejectionNotice" class="hidden mt-3 p-3 bg-red-950/80 border border-red-500/50 rounded-xl text-xs text-red-200">
                        <span class="font-bold">⚠️ Catatan Revisi dari Petugas TU:</span> <span id="biodataRejectionText"></span>
                    </div>
                </div>
            </div>
            <div class="z-10 shrink-0 w-full md:w-auto flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="openBiodataModal()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl font-black text-xs uppercase tracking-wider text-white shadow-lg flex items-center justify-center gap-2 transition-all transform hover:scale-105" style="background: linear-gradient(135deg, #2563EB 0%, #4F46E5 50%, #7C3AED 100%); box-shadow: 0 0 20px rgba(79, 70, 229, 0.4);">
                    <span>📝</span> <span id="btnOpenBiodataText">Isi / Perbarui Biodata</span>
                </button>
            </div>
        </div>

        <!-- 🕒 PRESENSI HARI INI & JADWAL TUGAS ANAK -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Kartu Presensi Hari Ini (Datang jam berapa & Pulang jam berapa) -->
            <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-sm text-gray-800 flex items-center gap-2">
                            <span>🕒</span> Presensi Real-Time Hari Ini
                        </h3>
                        <span id="badgeTodayStatus" class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold">HADIR TEPAT WAKTU</span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <!-- Datang Jam Berapa -->
                        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4">
                            <p class="text-[11px] font-bold text-emerald-800 uppercase tracking-wider">🚪 Jam Datang (Masuk)</p>
                            <p class="text-2xl font-black text-emerald-900 mt-1" id="webTodayGateIn">06:45 WIB</p>
                            <p class="text-[11px] text-emerald-700 mt-1">Scan Gate Barcode Kelas</p>
                        </div>
                        <!-- Pulang Jam Berapa -->
                        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4">
                            <p class="text-[11px] font-bold text-blue-800 uppercase tracking-wider">🏠 Jam Pulang (Keluar)</p>
                            <p class="text-2xl font-black text-blue-900 mt-1" id="webTodayGateOut">--:-- WIB</p>
                            <p class="text-[11px] text-blue-700 mt-1" id="webTodayGateOutNote">Belum scan pulang</p>
                        </div>
                    </div>
                </div>

                <!-- Notifikasi Absensi Otomatis untuk Orang Tua -->
                <div class="mt-4 p-3.5 bg-amber-50 border border-amber-200 rounded-2xl flex items-start gap-3">
                    <span class="text-xl">🔔</span>
                    <div class="text-xs text-amber-900 flex-1">
                        <p class="font-bold" id="webNotifTitle">✅ Notifikasi Kehadiran Terverifikasi</p>
                        <p class="mt-0.5 text-amber-800" id="webNotifMessage">Ananda telah melakukan scan barcode di ruang kelas tepat waktu pada pukul 06:45 WIB.</p>
                    </div>
                </div>

                <!-- Pemberitahuan Sholat Berjamaah & Scan di Mushola untuk Orang Tua -->
                <div class="mt-3 p-3.5 bg-teal-50 border border-teal-200 rounded-2xl flex items-start gap-3" id="webCardPrayerNotice">
                    <span class="text-xl">🕌</span>
                    <div class="text-xs text-teal-950 flex-1">
                        <div class="flex items-center justify-between">
                            <p class="font-black text-teal-900" id="webPrayerNoticeTitle">🕌 Pemberitahuan Sholat Berjamaah</p>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-teal-200 text-teal-900" id="webPrayerStatusBadge">Terjadwal</span>
                        </div>
                        <p class="mt-1 text-teal-800 leading-relaxed font-medium" id="webPrayerNoticeText">
                            Hari ini ada sholat jam 12:00 - 12:30 WIB dan ananda scan di mushola pukul --:-- WIB.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Kartu Jadwal Tugas & PR Anak -->
            <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-sm text-gray-800 flex items-center gap-2">
                            <span>📚</span> Jadwal Tugas &amp; PR Anak
                        </h3>
                        <span id="badgeHomeworkCount" class="bg-indigo-100 text-indigo-800 text-xs px-3 py-1 rounded-full font-bold">0 Tugas</span>
                    </div>
                    <div id="webHomeworkContainer" class="space-y-2.5 max-h-52 overflow-y-auto pr-1 text-xs">
                        <div class="p-3 bg-slate-50 border rounded-xl text-gray-500 text-center">Memuat jadwal tugas anak...</div>
                    </div>
                </div>
                <p class="text-[11px] text-gray-400 mt-3 pt-3 border-t">Memantau batas waktu pengumpulan tugas agar ananda tidak terlambat mengumpulkan.</p>
            </div>
        </div>

        <!-- 2. SECTION UTAMA: GRAFIK PERKEMBANGAN ANAK -->
        <div class="bg-white rounded-3xl shadow-sm border p-6">
            <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b gap-3">
                <div>
                    <h3 class="text-lg font-black text-gray-800 flex items-center gap-2">
                        <span>📈</span> Grafik Perkembangan Belajar & Nilai Anak
                    </h3>
                    <p class="text-xs text-gray-500">Visualisasi kenaikan nilai ujian berkala dan perbandingan terhadap rata-rata kelas</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-xl font-bold flex items-center gap-1">
                        <span>↗️</span> <span id="trendStatusText">Meningkat (+14.8%)</span>
                    </span>
                </div>
            </div>

            <!-- Grid 2 Grafik Visual: Tren Line Chart & Bar Mapel Chart -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Grafik 1: Tren Nilai Ujian dari Waktu ke Waktu -->
                <div class="bg-slate-50 p-5 rounded-2xl border flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 mb-1 flex items-center gap-1.5">
                            <span>📊</span> Tren Nilai Ujian (UH 1 ➔ PTS ➔ UH 2 ➔ PAS)
                        </h4>
                        <p class="text-[11px] text-gray-500 mb-4">Garis biru menunjukkan nilai anak, garis abu-abu rata-rata kelas</p>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="chartTrendExam"></canvas>
                    </div>
                </div>

                <!-- Grafik 2: Penguasaan per Mata Pelajaran -->
                <div class="bg-slate-50 p-5 rounded-2xl border flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 mb-1 flex items-center gap-1.5">
                            <span>🎯</span> Penguasaan Nilai per Mata Pelajaran (Target KKM: 75)
                        </h4>
                        <p class="text-[11px] text-gray-500 mb-4">Seluruh mata pelajaran berada di atas standar KKM</p>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="chartSubjectPerformance"></canvas>
                    </div>
                </div>
            </div>

            <!-- Rincian Nilai Mapel Interaktif & Progress Bar -->
            <div class="mt-6 pt-6 border-t">
                <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 mb-4 flex items-center gap-1.5">
                    <span>📚</span> Rincian Penguasaan Materi Belajar di Sekolah
                </h4>
                <div id="subjectProgressList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
                    <!-- Injected via JS -->
                </div>
            </div>
        </div>

        <!-- 3. SECTION DISIPLIN, KEHADIRAN & RADAR KARAKTER -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Donut Kehadiran -->
            <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <h3 class="font-black text-sm text-gray-800 flex items-center gap-2 mb-1">
                        <span>🟢</span> Persentase Kehadiran Gerbang
                    </h3>
                    <p class="text-xs text-gray-400 mb-4">Presensi harian anak (Gate In & Gate Out)</p>
                    <div class="h-52 relative flex items-center justify-center">
                        <canvas id="chartAttendanceDonut"></canvas>
                    </div>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4 text-center text-xs">
                    <div class="p-2.5 bg-emerald-50 text-emerald-800 rounded-xl font-bold border border-emerald-200">
                        <div class="text-[10px] text-emerald-600 font-semibold">Hadir Tepat</div>
                        <div class="text-sm font-black" id="attPresentCount">0</div>
                        <div class="text-[10px] font-bold text-emerald-700" id="attPresentPercent">0.0%</div>
                    </div>
                    <div class="p-2.5 bg-amber-50 text-amber-800 rounded-xl font-bold border border-amber-200">
                        <div class="text-[10px] text-amber-600 font-semibold">Terlambat</div>
                        <div class="text-sm font-black" id="attLateCount">0</div>
                        <div class="text-[10px] font-bold text-amber-700" id="attLatePercent">0.0%</div>
                    </div>
                    <div class="p-2.5 bg-sky-50 text-sky-800 rounded-xl font-bold border border-sky-200">
                        <div class="text-[10px] text-sky-600 font-semibold">Sakit / Izin</div>
                        <div class="text-sm font-black" id="attSickPermitCount">0</div>
                        <div class="text-[10px] font-bold text-sky-700" id="attSickPermitPercent">0.0%</div>
                    </div>
                    <div class="p-2.5 bg-rose-50 text-rose-800 rounded-xl font-bold border border-rose-200">
                        <div class="text-[10px] text-rose-600 font-semibold">Alpa</div>
                        <div class="text-sm font-black" id="attAbsentCount">0</div>
                        <div class="text-[10px] font-bold text-rose-700" id="attAbsentPercent">0.0%</div>
                    </div>
                </div>
                <div class="mt-3 p-2 bg-blue-50/80 rounded-xl border border-blue-200 flex items-center justify-between text-xs font-bold text-blue-900">
                    <span>Persentase Kehadiran Total:</span>
                    <span class="text-sm font-black text-blue-700" id="attTotalPercent">96.7%</span>
                </div>

                <!-- 📈 GRAFIK TREN KEHADIRAN ANANDA -->
                <div class="mt-4 pt-3 border-t border-slate-100">
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="text-xs font-bold text-gray-700 uppercase flex items-center gap-1.5">
                            <span>📈</span> Grafik Tren Kehadiran Ananda (%)
                        </h4>
                        <span class="text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">14 Hari Terakhir</span>
                    </div>
                    <div class="h-40 relative">
                        <canvas id="chartParentAttendanceTrend"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tips & Rekomendasi Belajar untuk Orang Tua -->
            <div class="lg:col-span-2 bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <h3 class="font-black text-sm text-gray-800 flex items-center gap-2 mb-1">
                        <span>💡</span> Catatan Evaluasi & Rekomendasi untuk Orang Tua
                    </h3>
                    <p class="text-xs text-gray-400 mb-4">Rekomendasi dari wali kelas dan guru bimbingan konseling</p>
                    
                    <div class="space-y-3" id="parentTipsContainer">
                        <div class="p-3.5 bg-blue-50/80 rounded-2xl border border-blue-200 text-xs text-blue-900 flex items-start gap-2.5">
                            <span class="text-lg">🌟</span>
                            <div>
                                <p class="font-bold">Keunggulan di Bidang Sains & Informatika</p>
                                <p class="text-[11px] text-blue-700 mt-0.5">Ananda memiliki kemampuan penalaran logika yang sangat baik. Dukung minatnya dalam eksplorasi komputer dan teknologi.</p>
                            </div>
                        </div>
                        <div class="p-3.5 bg-emerald-50/80 rounded-2xl border border-emerald-200 text-xs text-emerald-900 flex items-start gap-2.5">
                            <span class="text-lg">⏰</span>
                            <div>
                                <p class="font-bold">Kedisiplinan Waktu Belajar Sangat Tertib</p>
                                <p class="text-[11px] text-emerald-700 mt-0.5">Tingkat kehadiran tepat waktu mencapai 95%. Selalu hadir sebelum bel masuk sekolah berbunyi.</p>
                            </div>
                        </div>
                        <div class="p-3.5 bg-purple-50/80 rounded-2xl border border-purple-200 text-xs text-purple-900 flex items-start gap-2.5">
                            <span class="text-lg">📖</span>
                            <div>
                                <p class="font-bold">Pengembangan Bahasa Inggris</p>
                                <p class="text-[11px] text-purple-700 mt-0.5">Disarankan menambah waktu membaca artikel atau mendengarkan audio edukasi berbahasa Inggris 15 menit per hari di rumah.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <!-- 3.5. ⚠️ EVALUASI & STATISTIK KETERLAMBATAN ANANDA -->
        <div class="bg-white rounded-3xl shadow-sm border p-6 border-amber-200/80 bg-gradient-to-br from-white via-amber-50/20 to-orange-50/30">
            <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b border-amber-100 gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-2xl font-black shadow-xs">
                        ⚠️
                    </div>
                    <div>
                        <h3 class="text-base font-black text-gray-900 flex items-center gap-2">
                            Evaluasi &amp; Statistik Keterlambatan Ananda
                        </h3>
                        <p class="text-xs text-gray-500">Monitoring mendalam selisih waktu tiba vs batas gerbang sekolah (07:15 WIB), poin pelanggaran, dan pola hari</p>
                    </div>
                </div>
                <span id="lateRiskBadge" class="bg-emerald-100 text-emerald-800 text-xs px-3.5 py-1.5 rounded-full font-bold border border-emerald-300">
                    🟢 STATUS: TERTIB / AMAN
                </span>
            </div>

            <!-- 4 Kartu Metrik Keterlambatan -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <!-- Metrik 1: Total Terlambat -->
                <div class="bg-white p-4 rounded-2xl border border-amber-200 shadow-xs">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Frekuensi Terlambat</p>
                    <p class="text-2xl font-black text-amber-600 mt-1" id="lateCountStat">0 <span class="text-xs font-bold text-gray-500">Kali</span></p>
                    <p class="text-[11px] text-gray-400 mt-0.5">Selama 30 hari terakhir</p>
                </div>
                <!-- Metrik 2: Rata-rata Menit Keterlambatan -->
                <div class="bg-white p-4 rounded-2xl border border-amber-200 shadow-xs">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Rata-rata Menit</p>
                    <p class="text-2xl font-black text-orange-600 mt-1" id="lateAvgMinutesStat">0 <span class="text-xs font-bold text-gray-500">Menit</span></p>
                    <p class="text-[11px] text-gray-400 mt-0.5">Dari batas 07:15 WIB</p>
                </div>
                <!-- Metrik 3: Rata-rata Jam Tiba Saat Terlambat -->
                <div class="bg-white p-4 rounded-2xl border border-amber-200 shadow-xs">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Rata-rata Jam Tiba</p>
                    <p class="text-2xl font-black text-blue-600 mt-1" id="lateAvgTimeStat">--:-- <span class="text-xs font-bold text-gray-500">WIB</span></p>
                    <p class="text-[11px] text-gray-400 mt-0.5" id="lateFrequentDayStat">Hari sering terlambat: -</p>
                </div>
                <!-- Metrik 4: Akumulasi Poin Pelanggaran -->
                <div class="bg-white p-4 rounded-2xl border border-amber-200 shadow-xs">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-gray-500">Poin Pelanggaran</p>
                    <p class="text-2xl font-black text-red-600 mt-1" id="latePointsStat">0 <span class="text-xs font-bold text-gray-500">Poin</span></p>
                    <p class="text-[11px] text-gray-400 mt-0.5">5 Poin / Keterlambatan</p>
                </div>
            </div>

