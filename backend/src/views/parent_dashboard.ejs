                        riskBadge.innerText = '⚠️ STATUS: PERINGATAN DINI / WASPADA';
                    } else {
                        riskBadge.className = 'bg-emerald-100 text-emerald-800 text-xs px-3.5 py-1.5 rounded-full font-bold border border-emerald-300';
                        riskBadge.innerText = '🟢 STATUS: TERTIB / AMAN';
                    }

                    const lateTbody = document.getElementById('lateHistoryTable');
                    lateTbody.innerHTML = '';
                    const lateList = lateData.lateHistory || [];
                    if (lateList.length > 0) {
                        lateList.forEach(l => {
