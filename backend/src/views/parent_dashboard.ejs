                    document.getElementById('badgeHomeworkCount').innerText = `${hwList.length} Tugas`;
                    if (hwList.length === 0) {
                        hwBox.innerHTML = '<div class="p-4 bg-slate-50 border rounded-2xl text-center text-gray-400">✅ Belum ada tugas atau PR baru untuk kelas ananda.</div>';
                    } else {
