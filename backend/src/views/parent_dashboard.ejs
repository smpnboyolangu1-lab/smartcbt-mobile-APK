                            <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-2xl flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-lg">${h.subject || 'Mata Pelajaran'}</span>
                                    <p class="font-bold text-gray-800 text-xs mt-1">${h.title || 'Tugas'}</p>
                                    <p class="text-[11px] text-gray-500 mt-0.5">${h.description || ''}</p>
                                </div>
                                <div class="text-right flex flex-col items-end gap-1">
                                    <span class="text-[10px] ${h.isSubmitted ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : 'bg-amber-100 text-amber-800 border-amber-200'} border px-2.5 py-0.5 rounded-full font-bold">
                                        ${h.isSubmitted ? '✅ Selesai' : '⏳ Belum'}
                                    </span>
                                    <span class="text-[10px] font-bold text-red-600 font-mono">⏰ ${h.deadline || '-'}</span>
                                </div>
                            </div>
                        `).join('');
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderTrendChart(labels, studentScores, classAverages) {
            const ctx = document.getElementById('chartTrendExam').getContext('2d');
            if (chartTrendInstance) chartTrendInstance.destroy();

            chartTrendInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Nilai Siswa (Anak)',
                            data: studentScores,
                            borderColor: '#2563EB',
                            backgroundColor: 'rgba(37, 99, 235, 0.12)',
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#1D4ED8',
                            pointBorderColor: '#FFFFFF',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            borderWidth: 3
                        },
                        {
                            label: 'Rata-rata Kelas',
                            data: classAverages,
                            borderColor: '#94A3B8',
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.2,
                            pointRadius: 3,
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 50,
                            max: 100,
                            ticks: { stepSize: 10, font: { size: 10 } }
                        },
                        x: {
                            ticks: { font: { size: 10, weight: 'bold' } }
                        }
                    },
                    plugins: {
                        legend: { position: 'top', labels: { font: { size: 11 } } }
                    }
                }
            });
        }

        function renderSubjectChart(subjects) {
            const ctx = document.getElementById('chartSubjectPerformance').getContext('2d');
            if (chartSubjectInstance) chartSubjectInstance.destroy();

            const labels = subjects.map(s => s.subject);
            const scores = subjects.map(s => s.score);
            const colors = subjects.map(s => s.color || '#3B82F6');

            chartSubjectInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nilai Akhir',
                        data: scores,
                        backgroundColor: colors,
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 50,
                            max: 100,
                            ticks: { stepSize: 10, font: { size: 10 } }
                        },
                        x: {
                            ticks: { font: { size: 9, weight: 'bold' } }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

