                    badgeSub: 'text-rose-800'
                },
                instructions: [
                    'Seluruh siswi putri muslimah (kondisi suci maupun sedang berhalangan/haid) <strong>WAJIB mengikuti kegiatan keputrian</strong> pada hari Jumat pukul 11.45 - 12.45 WIB bersamaan dengan pelaksanaan Sholat Jumat siswa putra di masjid.',
                    'Siswi yang dalam kondisi suci akan mengikuti pembinaan materi fiqih wanita dan melaksanakan Sholat Dhuhur berjamaah di pos keputrian bersama Guru Pembina GPAI Putri (B. Eny Astuti & B. Mavrik).',
                    'Siswi yang berhalangan haid tetap wajib hadir dan menyimak materi kajian keputrian tanpa melaksanakan sholat.',
                    'Pindai barcode <strong>BARCODE_KEPUTRIAN_MASUK</strong> pada aplikasi Smart School CBT Siswa saat memasuki ruang kegiatan.',
                    'Pindai barcode <strong>BARCODE_KEPUTRIAN_PULANG</strong> saat sesi pembinaan telah selesai pada pukul 12.45 WIB untuk notifikasi kepulangan ke Orang Tua.'
                ]
            }
        ];

        async function init() {
            try {
                const res = await fetch('/api/attendance/class-barcodes', {
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                });
                const data = await res.json();
                const rawList = Array.isArray(data) ? data : (data.classes || []);
                allClasses = rawList.map(item => {
                    const rawLat = item.lat;
                    const rawLng = item.lng;
                    const lat = (rawLat !== undefined && rawLat !== null && !isNaN(Number(rawLat)) && Number(rawLat) !== 0) ? Number(rawLat) : SMP_DEFAULT_LAT;
                    const lng = (rawLng !== undefined && rawLng !== null && !isNaN(Number(rawLng)) && Number(rawLng) !== 0) ? Number(rawLng) : SMP_DEFAULT_LNG;
                    const radius = (item.radiusMeters !== undefined && item.radiusMeters !== null && !isNaN(Number(item.radiusMeters)) && Number(item.radiusMeters) > 0) ? Number(item.radiusMeters) : SMP_DEFAULT_RADIUS;

                    return {
                        specialType: 'CLASS',
                        name: item.className || item.name,
                        gateInBarcode: item.gateInCode || item.gateInBarcode || `GATE_IN_${item.className || item.name}`,
                        gateOutBarcode: item.gateOutCode || item.gateOutBarcode || `GATE_OUT_${item.className || item.name}`,
                        radiusMeters: radius,
                        lat: lat,
                        lng: lng
                    };
                });

                // Populate Class Optgroup in Select
                const optClasses = document.getElementById('optgroupClasses');
                optClasses.innerHTML = '';
                allClasses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.name;
                    opt.textContent = `Kelas ${c.name}`;
                    optClasses.appendChild(opt);
                });

                // Combine special stations + class stations
                allItems = [...specialStations, ...allClasses];

                // Check URL parameter filter
                const urlParams = new URLSearchParams(window.location.search);
                const filterParam = (urlParams.get('filter') || urlParams.get('type') || '').toUpperCase();

                if (filterParam.includes('BK')) {
                    quickFilter('BK');
                } else if (filterParam.includes('KEPUTRIAN')) {
                    quickFilter('KEPUTRIAN');
                } else if (filterParam.includes('MUSHOLA') || filterParam.includes('SHOLAT') || filterParam.includes('MASJID')) {
                    quickFilter('MUSHOLA');
                } else if (filterParam && filterParam !== 'ALL') {
                    const selectEl = document.getElementById('filterClassSelect');
                    selectEl.value = urlParams.get('filter') || urlParams.get('type');
                    filterClassCards();
                } else {
                    renderSheets(allItems);
                }
            } catch (err) {
                console.error(err);
                document.getElementById('loadingNotice').innerHTML = '<p class="text-red-500">Gagal memuat data barcode kelas.</p>';
            }
        }

        function quickFilter(type) {
            const btnAll = document.getElementById('btnFilterAll');
            const btnBk = document.getElementById('btnFilterBk');
            const btnMushola = document.getElementById('btnFilterMushola');
            const btnKeputrian = document.getElementById('btnFilterKeputrian');
            const btnClasses = document.getElementById('btnFilterClasses');
            const selectEl = document.getElementById('filterClassSelect');

            [btnAll, btnBk, btnMushola, btnKeputrian, btnClasses].forEach(b => {
                if (b) b.className = 'px-2.5 py-1 rounded-lg font-bold text-slate-300 hover:text-white';
            });

            if (type === 'ALL') {
                btnAll.className = 'px-2.5 py-1 rounded-lg font-bold bg-blue-600 text-white';
                selectEl.value = 'ALL';
                renderSheets(allItems);
            } else if (type === 'BK') {
                btnBk.className = 'px-2.5 py-1 rounded-lg font-bold bg-amber-600 text-white';
                selectEl.value = 'BK';
                renderSheets(allItems.filter(x => x.specialType === 'BK'));
            } else if (type === 'MUSHOLA') {
                btnMushola.className = 'px-2.5 py-1 rounded-lg font-bold bg-emerald-600 text-white';
                selectEl.value = 'MUSHOLA';
                renderSheets(allItems.filter(x => x.specialType === 'MUSHOLA'));
            } else if (type === 'KEPUTRIAN') {
                btnKeputrian.className = 'px-2.5 py-1 rounded-lg font-bold bg-pink-600 text-white';
                selectEl.value = 'KEPUTRIAN';
                renderSheets(allItems.filter(x => x.specialType === 'KEPUTRIAN'));
            } else if (type === 'CLASSES') {
                btnClasses.className = 'px-2.5 py-1 rounded-lg font-bold bg-indigo-600 text-white';
                selectEl.value = 'CLASSES_ONLY';
                renderSheets(allItems.filter(x => x.specialType === 'CLASS'));
            }
        }

        function filterClassCards() {
            const val = document.getElementById('filterClassSelect').value;
            if (val === 'ALL') {
                quickFilter('ALL');
            } else if (val === 'BK') {
                quickFilter('BK');
            } else if (val === 'MUSHOLA') {
                quickFilter('MUSHOLA');
            } else if (val === 'KEPUTRIAN') {
                quickFilter('KEPUTRIAN');
            } else if (val === 'CLASSES_ONLY') {
                quickFilter('CLASSES');
            } else {
                const filtered = allItems.filter(c => c.name === val || c.specialType === val);
                renderSheets(filtered);
            }
        }

        function downloadQrImage(canvasId, fileName) {
            const container = document.getElementById(canvasId);
            if (!container) return;
            const canvas = container.querySelector('canvas');
            if (!canvas) {
                const img = container.querySelector('img');
                if (img && img.src) {
                    const link = document.createElement('a');
                    link.href = img.src;
                    link.download = fileName;
                    link.click();
                    return;
                }
                alert('Gambar barcode belum siap');
                return;
            }
            const link = document.createElement('a');
            link.download = fileName;
            link.href = canvas.toDataURL('image/png');
            link.click();
        }

        function renderSheets(list) {
            const container = document.getElementById('printContainer');
            container.innerHTML = '';

            if (!list || list.length === 0) {
                container.innerHTML = '<div class="text-center py-12 text-gray-500"><p>Tidak ada lembar barcode untuk ditampilkan.</p></div>';
                return;
            }

            list.forEach((item, index) => {
                const sheet = document.createElement('div');
                sheet.className = 'sheet bg-white rounded-xl shadow-lg border-2 border-slate-900 p-5 mb-8 page-break flex flex-col justify-between';

                const isSpecial = item.specialType === 'BK' || item.specialType === 'MUSHOLA';

                let badgeText = item.badgeText || 'POS PINTU KELAS';
                let badgeSub = item.badgeSub || 'Laminating &amp; Tempel di Pintu Depan';
                let bannerSubtitle = item.bannerSubtitle || 'TITIK PRESENSI RESMI SISWA';
                let bannerTitle = item.bannerTitle || `RUANG KELAS ${item.name}`;
                let bannerGradient = item.bannerGradient || 'from-blue-900 via-indigo-900 to-slate-900';
                let locationInfo = item.locationInfo || `📍 GPS Geofence: <strong class="text-white font-bold">${item.radiusMeters || 10} Meter</strong>`;

                let gateInLabel = item.gateInLabel || '1. PRESENSI DATANG (GATE-IN)';
                let gateInSub = item.gateInSub || 'Scan saat tiba di kelas pagi hari';
                let gateInCode = item.gateInBarcode || `GATE_IN_${item.name}`;
                let gateInFooter = item.gateInFooter || 'Batas Tepat Waktu: Sesuai Jam Gate Sekolah';
                let gateInColor = item.gateInColor || '#065f46';

                let gateOutLabel = item.gateOutLabel || '2. PRESENSI PULANG (GATE-OUT)';
                let gateOutSub = item.gateOutSub || 'Scan saat jam kepulangan berakhir';
                let gateOutCode = item.gateOutBarcode || `GATE_OUT_${item.name}`;
                let gateOutFooter = item.gateOutFooter || 'Terbuka otomatis saat bel pulang berbunyi';
                let gateOutColor = item.gateOutColor || '#1e40af';

                let instructionsList = item.instructions || [
                    `Buka aplikasi <strong>Smart School CBT</strong> pada ponsel Android Anda dan klik menu <strong>"Scan Gate Barcode"</strong>.`,
                    `Pastikan <strong>GPS/Lokasi Aktif</strong> pada perangkat Anda dan Anda berada di area ruang kelas (dalam radius ${item.radiusMeters || 10} meter).`,
                    `Arahkan kamera ke QR Code di atas. Sistem akan otomatis memverifikasi GPS & anti-fake mock location di background.`,
                    `Notifikasi jam presensi otomatis terkirim langsung ke ponsel orang tua / wali murid Anda.`,
                    `<strong>Dilarang keras memalsukan lokasi (Fake GPS / Mock). Sistem akan memblokir presensi otomatis dan mencatat pelanggaran ke Guru BK.</strong>`
                ];

                const instructionHtml = instructionsList.map(li => `<li>${li}</li>`).join('');

                sheet.innerHTML = `
                    <!-- Header Kop Resmi -->
                    <div>
                        <div class="flex items-center justify-between border-b-2 border-double border-slate-800 pb-2 mb-3">
                            <div class="flex items-center gap-3">
                                <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-14 h-14 object-contain drop-shadow" onerror="this.src='/images/logo-smpn1boyolangu.png'">
                                <div class="leading-tight">
                                    <h3 class="text-[11px] font-bold text-slate-700 tracking-wider uppercase">PEMERINTAH KABUPATEN TULUNGAGUNG</h3>
                                    <h3 class="text-[11px] font-bold text-slate-700 tracking-wider uppercase">DINAS PENDIDIKAN</h3>
                                    <h2 class="text-lg font-black text-slate-950 tracking-wider uppercase my-0.5">SMP NEGERI 1 BOYOLANGU</h2>
                                    <p class="text-[10px] font-bold text-blue-900 tracking-tight">SISTEM PRESENSI TERPADU DIGITAL TERINTEGRASI (SMART CBT &amp; PRESENSI)</p>
                                    <p class="text-[9px] text-slate-500 mt-0.5">Jalan Raya Boyolangu, Kec. Boyolangu, Kab. Tulungagung 66271 | Telp. (0355) 324146</p>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <div class="bg-blue-100 text-blue-900 px-3 py-1 rounded-lg font-black text-[11px] border border-blue-300 inline-block shadow-sm">
                                    ${badgeText}
                                </div>
                                <p class="text-[8.5px] text-slate-500 mt-1">${badgeSub}</p>
                            </div>
                        </div>

                        <!-- Banner Nama Titik Presensi -->
                        <div class="bg-gradient-to-r ${bannerGradient} text-white py-2.5 px-4 rounded-xl text-center shadow-md mb-3.5">
                            <span class="text-[10px] uppercase tracking-widest text-blue-200 font-bold block mb-0.5">${bannerSubtitle}</span>
                            <h1 class="text-2xl font-black tracking-wide">${bannerTitle}</h1>
                            <div class="mt-1 flex items-center justify-center gap-3 text-[11px] text-blue-200 font-medium">
                                <span>${locationInfo}</span>
                            </div>
                        </div>

                        <!-- 2 Barcode Columns (Gate-In & Gate-Out) -->
                        <div class="grid grid-cols-2 gap-4 mb-3">
                            <!-- Left Card (Gate-In / Dhuhur) -->
                            <div class="border-2 border-emerald-500 rounded-xl p-3 bg-emerald-50/40 flex flex-col items-center text-center justify-between">
                                <div>
                                    <span class="bg-emerald-600 text-white font-extrabold text-[11px] uppercase px-3 py-0.5 rounded-full shadow-sm mb-1 inline-block">
                                        ${gateInLabel}
                                    </span>
                                    <p class="text-[10px] text-emerald-800 font-semibold mb-2">${gateInSub}</p>
                                </div>
                                
                                <div class="bg-white p-2.5 rounded-xl border border-emerald-300 shadow-inner mb-2 flex flex-col items-center">
                                    <div id="qr-in-${index}" class="flex justify-center"></div>
                                    <button type="button" onclick="downloadQrImage('qr-in-${index}', 'QR_${gateInCode}.png')" class="no-print mt-2 text-[9.5px] bg-slate-800 hover:bg-slate-900 text-white font-bold py-1 px-2.5 rounded-lg flex items-center gap-1 shadow-sm transition-all" title="Unduh gambar PNG barcode ini">
                                        <span>📥</span> Unduh PNG
                                    </button>
                                </div>

                                <div>
                                    <span class="font-mono text-[11px] font-bold text-emerald-950 bg-emerald-200/70 px-2 py-0.5 rounded border border-emerald-400 block mb-1">
                                        ${gateInCode}
                                    </span>
                                    <p class="text-[9.5px] text-emerald-700 font-medium">${gateInFooter}</p>
                                </div>
                            </div>

                            <!-- Right Card (Gate-Out / Jumat) -->
                            <div class="border-2 border-blue-500 rounded-xl p-3 bg-blue-50/40 flex flex-col items-center text-center justify-between">
                                <div>
                                    <span class="bg-blue-600 text-white font-extrabold text-[11px] uppercase px-3 py-0.5 rounded-full shadow-sm mb-1 inline-block">
                                        ${gateOutLabel}
                                    </span>
                                    <p class="text-[10px] text-blue-800 font-semibold mb-2">${gateOutSub}</p>
                                </div>

                                <div class="bg-white p-2.5 rounded-xl border border-blue-300 shadow-inner mb-2 flex flex-col items-center">
                                    <div id="qr-out-${index}" class="flex justify-center"></div>
                                    <button type="button" onclick="downloadQrImage('qr-out-${index}', 'QR_${gateOutCode}.png')" class="no-print mt-2 text-[9.5px] bg-slate-800 hover:bg-slate-900 text-white font-bold py-1 px-2.5 rounded-lg flex items-center gap-1 shadow-sm transition-all" title="Unduh gambar PNG barcode ini">
                                        <span>📥</span> Unduh PNG
                                    </button>
                                </div>

                                <div>
                                    <span class="font-mono text-[11px] font-bold text-blue-950 bg-blue-200/70 px-2 py-0.5 rounded border border-blue-400 block mb-1">
                                        ${gateOutCode}
                                    </span>
                                    <p class="text-[9.5px] text-blue-700 font-medium">${gateOutFooter}</p>
                                </div>
                            </div>
                        </div>

                        <!-- Petunjuk Pemindaian Siswa -->
                        <div class="border border-slate-300 bg-slate-50 rounded-lg p-2.5 text-slate-700 text-[10px] leading-relaxed mb-2.5">
                            <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-1.5 text-[10.5px]">
                                <span>ℹ️</span> PETUNJUK PENGGUNAAN UNTUK SISWA:
                            </h4>
                            <ol class="list-decimal list-inside space-y-0.5 text-[9.5px] text-slate-600 font-medium">
                                ${instructionHtml}
                            </ol>
                        </div>
                    </div>

                    <!-- Footer Kartu -->
                    <div class="border-t border-slate-200 pt-2 flex justify-between items-center text-[9px] text-slate-400">
                        <span>Dokumen Resmi SMPN 1 Boyolangu • Dicetak pada ${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                        <span class="font-mono">ID: SS-GATE-${item.specialType || 'CLASS'}-${item.name.replace(/\s+/g, '')}-${Date.now().toString().slice(-4)}</span>
                    </div>
                `;

                container.appendChild(sheet);

                // Generate QR Codes using local qrcode.min.js
                setTimeout(() => {
                    const elIn = document.getElementById(`qr-in-${index}`);
                    const elOut = document.getElementById(`qr-out-${index}`);
                    if (elIn && !elIn.hasChildNodes()) {
                        new QRCode(elIn, {
                            text: gateInCode,
                            width: 155,
                            height: 155,
                            colorDark: gateInColor,
                            colorLight: "#ffffff",
                            correctLevel: QRCode.CorrectLevel.H
                        });
                    }

                    if (elOut && !elOut.hasChildNodes()) {
                        new QRCode(elOut, {
                            text: gateOutCode,
                            width: 155,
                            height: 155,
                            colorDark: gateOutColor,
                            colorLight: "#ffffff",
                            correctLevel: QRCode.CorrectLevel.H
                        });
                    }
                }, 50);
            });
        }

        window.onload = init;
    </script>
</body>
</html>
