<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📁 Remote File Manager & Distribusi E-File - Smart School Admin</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-4 md:p-8 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📁</span> Remote File Manager &amp; Distribusi Berkas Digital
                    </h1>
                    <p class="text-slate-500 text-xs">Manajemen Berkas Terpusat: Rapor Digital, Kartu Siswa, Sertifikat &amp; Push File Remote ke HP Siswa</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="openUploadModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow flex items-center gap-2">
                    <span>📤</span> Upload & Distribusikan Berkas
                </button>
                <button onclick="loadRemoteFiles()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3.5 py-2 rounded-lg text-sm font-semibold shadow">
                    ⟳ Refresh
                </button>
            </div>
        </div>

        <!-- Storage Capacity & Analytics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Total Berkas Digital</p>
                    <p class="text-2xl font-bold text-gray-800" id="statTotalFiles">0 File</p>
                    <p class="text-xs text-green-600 font-semibold mt-1">🟢 Tersinkron Realtime</p>
                </div>
                <div class="p-3 bg-blue-50 text-blue-700 rounded-xl text-2xl">📑</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Rapor Digital Siswa</p>
                    <p class="text-2xl font-bold text-blue-900" id="statRaporFiles">0</p>
                    <p class="text-xs text-gray-400 mt-1">Format PDF Resmi</p>
                </div>
                <div class="p-3 bg-amber-50 text-amber-700 rounded-xl text-2xl">📊</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Kartu Pelajar Siswa</p>
                    <p class="text-2xl font-bold text-teal-900" id="statKartuFiles">0</p>
                    <p class="text-xs text-gray-400 mt-1">Barcode &amp; QR Pass</p>
                </div>
                <div class="p-3 bg-teal-50 text-teal-700 rounded-xl text-2xl">💳</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Sertifikat & Surat</p>
                    <p class="text-2xl font-bold text-purple-900" id="statSertifikatFiles">0</p>
                    <p class="text-xs text-gray-400 mt-1">Arsip Prestasi Sekolah</p>
                </div>
                <div class="p-3 bg-purple-50 text-purple-700 rounded-xl text-2xl">🏆</div>
            </div>
        </div>

        <!-- File Explorer Table -->
        <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
            <div class="p-5 border-b flex flex-wrap justify-between items-center gap-4 bg-gray-50">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-bold text-gray-700">🗂️ Direktori Berkas E-File Siswa</span>
                    <select id="filterCategory" onchange="filterFiles()" class="border text-xs rounded-lg px-3 py-1.5 bg-white text-gray-700 font-medium">
                        <option value="ALL">Semua Kategori</option>
                        <option value="RAPOR">Rapor Digital</option>
                        <option value="KARTU_PELAJAR">Kartu Pelajar</option>
                        <option value="SERTIFIKAT">Sertifikat</option>
                        <option value="SURAT">Surat Keterangan</option>
                        <option value="MODUL_CBT">Modul & Lampiran CBT</option>
                    </select>
                </div>
                <div>
                    <input type="text" id="searchFileName" onkeyup="filterFiles()" placeholder="Cari nama berkas / siswa..." class="border text-xs rounded-lg px-3.5 py-1.5 w-64">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 uppercase text-[11px] font-bold border-b">
                            <th class="py-3.5 px-4">Nama Berkas Digital</th>
                            <th class="py-3.5 px-4">Kategori</th>
                            <th class="py-3.5 px-4">Penerima (Siswa/Kelas)</th>
                            <th class="py-3.5 px-4">Ukuran</th>
                            <th class="py-3.5 px-4">Tanggal Upload</th>
                            <th class="py-3.5 px-4 text-center">Aksi Remote</th>
                        </tr>
                    </thead>
                    <tbody id="fileTableBody" class="text-xs divide-y">
                        <tr>
                            <td colspan="6" class="text-center py-8 text-gray-400">Memuat berkas remote storage...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Upload & Push Modal -->
    <div id="uploadModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <span>📤</span> Upload & Distribusikan E-File
                </h3>
                <button onclick="closeUploadModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">×</button>
            </div>
            
            <form onsubmit="handleFileUpload(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Judul / Nama Dokumen</label>
                    <input type="text" id="uploadTitle" required placeholder="Cth: Rapor Semester Ganjil 2025/2026" class="w-full border rounded-lg p-2.5">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Kategori Dokumen</label>
                        <select id="uploadCategory" class="w-full border rounded-lg p-2.5">
                            <option value="RAPOR">Rapor Digital Siswa</option>
                            <option value="KARTU_PELAJAR">Kartu Pelajar &amp; QR Siswa</option>
                            <option value="SERTIFIKAT">Sertifikat Prestasi</option>
                            <option value="SURAT">Surat Keterangan Sekolah</option>
                            <option value="MODUL_CBT">Modul & Bank Soal CBT</option>
                            <option value="LAINNYA">Dokumen Lainnya</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Target Distribusi</label>
                        <select id="uploadTargetType" class="w-full border rounded-lg p-2.5">
                            <option value="ALL_STUDENTS">Seluruh Siswa Sekolah</option>
                            <option value="CLASS">Per Kelas (Cth: Kelas VII-A)</option>
                            <option value="SINGLE_STUDENT">Siswa Tertentu</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Target Kelas (Opsional)</label>
                    <input type="text" id="uploadTargetClass" value="VII-A" placeholder="Cth: VII-A, VII-B, atau VIII" class="w-full border rounded-lg p-2.5">
                </div>

                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Pilih File dari Komputer Admin</label>
                    <input type="file" id="uploadFileInput" class="w-full border rounded-lg p-2 bg-gray-50">
                    <p class="text-[10px] text-gray-400 mt-1">Mendukung file PDF, DOCX, XLSX, JPG/PNG, ZIP (Maks 25 MB per berkas)</p>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeUploadModal()" class="px-4 py-2 border rounded-lg font-semibold text-gray-600 hover:bg-gray-100">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow">
                        🚀 Upload & Push ke HP Siswa
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let allRemoteFiles = [];

        async function loadRemoteFiles() {
            try {
                const res = await fetch('/api/admin/files');
                const data = await res.json();
                if (data.success) {
                    allRemoteFiles = data.files;
                    document.getElementById('statTotalFiles').innerText = data.totalFiles + ' File';
                    document.getElementById('statRaporFiles').innerText = data.storageSummary.categories.rapor;
                    document.getElementById('statKartuFiles').innerText = data.storageSummary.categories.kartuPelajar;
                    document.getElementById('statSertifikatFiles').innerText = data.storageSummary.categories.sertifikat + data.storageSummary.categories.surat;
                    renderFileTable(allRemoteFiles);
                }
            } catch (e) {
                console.error('Failed to load files:', e);
            }
        }

        function renderFileTable(files) {
            const tbody = document.getElementById('fileTableBody');
            if (files.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Belum ada berkas remote tersimpan.</td></tr>';
                return;
            }

            tbody.innerHTML = files.map(f => {
                let catBadge = '<span class="bg-gray-100 text-gray-800 px-2 py-0.5 rounded font-bold">UMUM</span>';
                if (f.category === 'RAPOR') catBadge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-bold">📊 RAPOR</span>';
                else if (f.category === 'KARTU_PELAJAR') catBadge = '<span class="bg-teal-100 text-teal-800 px-2 py-0.5 rounded font-bold">💳 KARTU</span>';
                else if (f.category === 'SERTIFIKAT') catBadge = '<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-bold">🏆 SERTIFIKAT</span>';
                else if (f.category === 'SURAT') catBadge = '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-bold">📜 SURAT</span>';

                return `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="py-3 px-4 font-semibold text-gray-800 flex items-center gap-2">
                            <span>📄</span> ${f.title}
                        </td>
                        <td class="py-3 px-4">${catBadge}</td>
                        <td class="py-3 px-4 text-gray-600">
                            ${f.recipient.name} <span class="text-gray-400 text-[10px]">(${f.recipient.className})</span>
                        </td>
                        <td class="py-3 px-4 text-gray-500 font-mono">${f.fileSize}</td>
                        <td class="py-3 px-4 text-gray-500">${f.uploadedAt}</td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="previewFile('${f.title.replace(/'/g, "\\'")}', '${f.fileUrl || ''}')" class="bg-blue-50 text-blue-600 hover:bg-blue-100 px-2.5 py-1 rounded font-bold text-[11px]">
                                    👁️ Buka
                                </button>
                                <button onclick="downloadFile('${f.title.replace(/'/g, "\\'")}', '${f.fileUrl || ''}')" class="bg-green-50 text-green-700 hover:bg-green-100 px-2.5 py-1 rounded font-bold text-[11px]">
                                    ⬇️ Unduh
                                </button>
                                <button onclick="deleteFile('${f.id}')" class="bg-red-50 text-red-600 hover:bg-red-100 px-2.5 py-1 rounded font-bold text-[11px]">
                                    🗑️ Hapus
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterFiles() {
            const cat = document.getElementById('filterCategory').value;
            const search = document.getElementById('searchFileName').value.toLowerCase();

            const filtered = allRemoteFiles.filter(f => {
                const matchCat = cat === 'ALL' || f.category === cat;
                const matchSearch = f.title.toLowerCase().includes(search) || f.recipient.name.toLowerCase().includes(search);
                return matchCat && matchSearch;
            });
            renderFileTable(filtered);
        }

        function openUploadModal() {
            document.getElementById('uploadModal').classList.remove('hidden');
        }

        function closeUploadModal() {
            document.getElementById('uploadModal').classList.add('hidden');
        }

        async function handleFileUpload(e) {
            e.preventDefault();
            const title = document.getElementById('uploadTitle').value;
            const category = document.getElementById('uploadCategory').value;
            const targetType = document.getElementById('uploadTargetType').value;
            const targetClass = document.getElementById('uploadTargetClass').value;
            const fileInput = document.getElementById('uploadFileInput');
            const selectedFile = fileInput?.files?.[0];

            let fileSizeStr = '1.5 MB';
            if (selectedFile) {
                fileSizeStr = selectedFile.size > 1048576 
                    ? (selectedFile.size / 1048576).toFixed(1) + ' MB' 
                    : (selectedFile.size / 1024).toFixed(0) + ' KB';
            }

            const token = localStorage.getItem('token') || '';
            try {
                const res = await fetch('/api/admin/files/upload-distribute', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({
                        title,
                        category,
                        targetType,
                        targetClass,
                        fileSize: fileSizeStr,
                        fileUrl: selectedFile ? `/storage/efiles/${encodeURIComponent(title.toLowerCase().replace(/\s+/g, '_'))}.pdf` : null
                    })
                });
                const data = await res.json();
                alert('✅ ' + data.message);
                closeUploadModal();
                loadRemoteFiles();
            } catch (err) {
                alert('Gagal mendistribusikan berkas.');
            }
        }

        async function deleteFile(id) {
            if (!confirm('Apakah Anda yakin ingin menghapus berkas remote ini?')) return;
            const token = localStorage.getItem('token') || '';
            try {
                const res = await fetch('/api/admin/files/' + id, { 
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert('✅ ' + data.message);
                loadRemoteFiles();
            } catch (e) {
                alert('Gagal menghapus berkas.');
            }
        }

        function previewFile(title, fileUrl) {
            if (fileUrl && fileUrl !== 'null' && fileUrl !== 'undefined') {
                window.open(fileUrl, '_blank');
            } else {
                alert('📄 Berkas "' + title + '" tersimpan aman di cloud server.');
            }
        }

        function downloadFile(title, fileUrl) {
            if (fileUrl && fileUrl !== 'null' && fileUrl !== 'undefined') {
                const a = document.createElement('a');
                a.href = fileUrl;
                a.download = title || 'dokumen';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            } else {
                alert('⬇️ Mengunduh salinan berkas: ' + title);
            }
        }

        function logout() {
            window.location.href = '/';
        }

        loadRemoteFiles();
    </script>
</body>
</html>
