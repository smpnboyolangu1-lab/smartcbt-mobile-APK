<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Kiosk Presensi Tap Kartu RFID - SMPN 1 Boyolangu</title>
    <script src="/js/tailwind.js"></script>
    <style>
        @keyframes pulse-emerald {
            0%, 100% { border-color: rgba(16, 185, 129, 0.4); box-shadow: 0 0 35px rgba(16, 185, 129, 0.25); }
            50% { border-color: rgba(16, 185, 129, 0.9); box-shadow: 0 0 60px rgba(16, 185, 129, 0.6); }
        }
        @keyframes pulse-amber {
            0%, 100% { border-color: rgba(239, 68, 68, 0.5); box-shadow: 0 0 40px rgba(239, 68, 68, 0.3); }
            50% { border-color: rgba(239, 68, 68, 1); box-shadow: 0 0 70px rgba(239, 68, 68, 0.7); }
        }
        .scanner-card-idle {
            animation: pulse-emerald 3s infinite;
        }
        .scanner-card-late {
            animation: pulse-amber 1.2s infinite;
        }
        .custom-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: #020617;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-950 text-white min-h-screen flex flex-col font-sans select-none overflow-x-hidden" onclick="focusCardInput()">
    
    <!-- Top Header -->
    <header class="px-6 py-4 bg-slate-900/90 border-b border-slate-800 flex flex-wrap justify-between items-center backdrop-blur-md gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-2xl shadow-lg shadow-blue-500/30">
                💳
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl font-black tracking-wide bg-gradient-to-r from-blue-400 via-sky-300 to-teal-300 bg-clip-text text-transparent">
                        MONITORING PRESENSI RFID & KIOSK SEKOLAH
                    </h1>
                    <span class="bg-emerald-500/20 text-emerald-400 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border border-emerald-500/40">
                        RULE: 07:00:00 WIB
                    </span>
                </div>
                <p class="text-xs text-slate-400">SMP NEGERI 1 BOYOLANGU &bull; Mendukung RFID Reader USB 13.56 MHz, 125 KHz, Barcode Kartu, &amp; Bypass Manual</p>
            </div>
        </div>

        <!-- Mode Toggle, Manual Button & Clock -->
        <div class="flex items-center gap-4 flex-wrap">
            <!-- Mode Switcher -->
            <div class="bg-slate-950 p-1.5 rounded-2xl border border-slate-800 flex gap-1 text-xs font-bold shadow-inner">
                <button onclick="setGateMode('GATE_IN')" id="btnModeIn" class="px-4 py-2 rounded-xl bg-emerald-600 text-white shadow-md transition-all">
                    🟢 GATE-IN (Masuk)
                </button>
                <button onclick="setGateMode('GATE_OUT')" id="btnModeOut" class="px-4 py-2 rounded-xl text-slate-400 hover:text-white transition-all">
                    🔵 GATE-OUT (Pulang)
                </button>
            </div>

            <!-- Manual Bypass Button (Guru BK / Wali Kelas) -->
            <button onclick="openManualBypassModal(event)" class="px-3.5 py-2 rounded-xl bg-indigo-600/30 hover:bg-indigo-600 text-indigo-200 hover:text-white border border-indigo-500/40 text-xs font-bold transition-all flex items-center gap-1.5 shadow">
                <span>➕</span> Presensi Tombol Manual (BK / Wali)
            </button>

            <!-- Digital Clock -->
            <div class="text-right pl-2 border-l border-slate-800">
                <div class="text-2xl font-black font-mono tracking-wider text-emerald-400" id="liveClock">07:00:00 WIB</div>
                <div class="text-[11px] text-slate-400" id="liveDate">Memuat tanggal...</div>
            </div>
        </div>
    </header>

    <!-- Stat Bar Counters -->
    <div class="bg-slate-900/60 border-b border-slate-800 px-6 py-2.5 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center text-xs">
        <div class="bg-slate-950/60 p-2 rounded-xl border border-slate-800/80">
            <span class="text-slate-400 block text-[10px]">TOTAL TAP HARI INI</span>
            <span class="text-lg font-black text-white" id="statTotalTap">0</span>
        </div>
        <div class="bg-slate-950/60 p-2 rounded-xl border border-emerald-900/40">
            <span class="text-emerald-400 block text-[10px]">TEPAT WAKTU (≤ 07:00:00)</span>
            <span class="text-lg font-black text-emerald-400" id="statOnTime">0</span>
        </div>
        <div class="bg-slate-950/60 p-2 rounded-xl border border-red-900/40">
            <span class="text-red-400 block text-[10px]">TERLAMBAT (> 07:00:00)</span>
            <span class="text-lg font-black text-red-400" id="statLate">0</span>
        </div>
        <div class="bg-slate-950/60 p-2 rounded-xl border border-blue-900/40">
            <span class="text-blue-400 block text-[10px]">PULANG (GATE-OUT)</span>
            <span class="text-lg font-black text-blue-400" id="statOut">0</span>
        </div>
    </div>

    <!-- Main Dual Panel -->
    <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 p-6 gap-6 items-start max-w-7xl mx-auto w-full">
        
        <!-- LEFT: Tap Target Display (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col items-center justify-center space-y-4">
            
            <!-- Hidden input that constantly captures USB RFID Reader & Barcode Scanner -->
            <input type="text" id="cardInput" class="opacity-0 absolute -top-96" autofocus autocomplete="off">

            <!-- Center Scanner Box -->
            <div id="scannerMainCard" class="w-full bg-slate-900/90 border-2 border-emerald-500/50 rounded-3xl p-6 scanner-card-idle text-center flex flex-col items-center justify-center relative overflow-hidden backdrop-blur-xl transition-all duration-300 min-h-[460px]">
                
                <!-- Status Banner -->
                <div id="gateStatusBanner" class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs px-5 py-2 rounded-full font-bold uppercase tracking-widest mb-4 shadow">
                    🟢 SIAP SCAN: TEMPELKAN KARTU PELAJAR RFID
                </div>

                <!-- Default Idle Instructions -->
                <div id="idleInstructionArea" class="space-y-4 py-8">
                    <div id="cardAnimationBox" class="w-32 h-32 rounded-3xl bg-blue-600/10 border-2 border-dashed border-blue-400/40 flex items-center justify-center text-6xl text-blue-400 mx-auto shadow-inner transition-transform duration-300 hover:scale-105">
                        💳
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-slate-100">Tempelkan Kartu RFID Siswa</h3>
                        <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1">Reader USB otomatis membaca chip kartu pelajar. Batas resmi masuk sekolah pukul <span class="text-emerald-400 font-bold">07:00:00 WIB</span>.</p>
                    </div>
                    <div class="text-[11px] text-amber-400/90 bg-amber-500/10 border border-amber-500/20 px-4 py-2 rounded-2xl max-w-md mx-auto">
                        ⚠️ Lebih dari pukul 07:00:00 WIB otomatis tercatat <b>TERLAMBAT</b>. Siswa tanpa kartu/HP dapat difasilitasi tombol manual oleh Guru BK/Wali Kelas.
                    </div>
                </div>

                <!-- Student Result Details (Populated on Tap) -->
                <div id="studentDetailArea" class="w-full hidden space-y-4">
                    
                    <!-- Foto Siswa & Status Badge -->
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 bg-slate-950/70 p-5 rounded-3xl border border-slate-800">
                        <div class="relative">
                            <img id="resStudentPhoto" src="" alt="Foto Siswa" class="w-28 h-28 rounded-2xl object-cover border-2 border-blue-500/40 shadow-xl hidden">
                            <div id="resStudentAvatar" class="w-28 h-28 rounded-2xl bg-gradient-to-tr from-blue-700 to-indigo-800 text-white font-black text-4xl flex items-center justify-center shadow-xl border-2 border-blue-500/30">
                                S
                            </div>
                            <span id="resLatePill" class="hidden absolute -bottom-2 -right-2 bg-red-600 text-white text-[10px] font-black px-2 py-0.5 rounded-full shadow border border-red-400">
                                TERLAMBAT
                            </span>
                        </div>

                        <div class="text-center sm:text-left space-y-1">
                            <span id="resBadgeStatus" class="inline-block px-4 py-1.5 rounded-xl font-black text-xs uppercase tracking-wider bg-emerald-600 text-white shadow-lg">
                                ✅ HADIR TEPAT WAKTU (06:55:12 WIB)
                            </span>
                            <h2 class="text-2xl font-black text-white" id="resStudentName">NAMA LENGKAP SISWA</h2>
                            <p class="text-xs text-sky-300 font-semibold" id="resStudentMeta">Kelas VII-A &bull; NISN: 1234567890 &bull; NIS: 1234</p>
                            <p class="text-xs text-slate-300" id="resHomeroom">👨‍🏫 Wali Kelas: Drs. Budi Santoso</p>
                        </div>
                    </div>

                    <!-- Meta Grid (Notifikasi Ortu, Waktu, Poin) -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left">
                        <div class="bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 block font-bold">WAKTU TAP RESMI</span>
                            <span class="text-sm font-mono font-black text-emerald-400" id="resTapTime">06:55:12 WIB</span>
                            <span class="text-[10px] text-slate-500 block" id="resLateDetail">Batas Masuk: 07:00:00 WIB</span>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 block font-bold">NOTIFIKASI WALI MURID</span>
                            <span class="text-xs font-bold text-sky-400 block" id="resParentNotifStatus">📲 Terkirim ke Orang Tua</span>
                            <span class="text-[10px] text-slate-500 block truncate" id="resParentPhone">No HP: 08123456789</span>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
                            <span class="text-[10px] text-slate-400 block font-bold">POIN KEDISIPLINAN</span>
                            <span class="text-sm font-black text-amber-400" id="resStudentPoints">0 Poin</span>
                            <span class="text-[10px] text-slate-500 block">Status: Tertib</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hint Status Connection -->
            <div class="flex items-center justify-between w-full text-xs text-slate-400 bg-slate-900/60 px-5 py-2.5 rounded-2xl border border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>USB RFID Reader Standby &bull; Auto-Focus Input Aktif</span>
                </div>
                <span class="text-slate-500 text-[11px]">Sistem SIBOY 2026</span>
            </div>
        </div>

        <!-- RIGHT: Live Activity Feed (5 Cols) -->
        <div class="lg:col-span-5 bg-slate-900/70 border border-slate-800 rounded-3xl p-5 h-[620px] flex flex-col backdrop-blur-md">
            <div class="flex justify-between items-center pb-3 border-b border-slate-800 mb-3">
                <h3 class="font-black text-sm text-slate-200 flex items-center gap-2">
                    <span>📋</span> AKTIVITAS TAP REAL-TIME
                </h3>
                <span id="tapCountBadge" class="bg-blue-600/30 text-blue-300 text-xs font-bold px-2.5 py-1 rounded-xl border border-blue-500/30">0 Siswa</span>
            </div>

            <!-- Feed Search -->
            <div class="mb-3">
                <input type="text" id="feedSearch" oninput="renderFeed()" placeholder="Cari nama atau kelas..." class="w-full bg-slate-950 text-xs text-slate-200 px-3.5 py-2 rounded-xl border border-slate-800 focus:outline-none focus:border-blue-500">
            </div>

            <!-- Feed List -->
            <div class="flex-1 overflow-y-auto space-y-2 pr-1 custom-scroll" id="tapFeedList">
                <div class="text-center py-16 text-slate-500 text-xs">
                    Belum ada siswa yang tap kartu pada sesi ini.
                </div>
            </div>
        </div>
    </main>

    <!-- Modal Presensi Tombol Manual (Guru BK / Wali Kelas) -->
    <div id="modalManualBypass" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="text-base font-black text-white flex items-center gap-2">
                    <span>➕</span> Presensi Tombol Manual BK / Wali Kelas
                </h3>
                <button onclick="closeManualBypassModal()" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
            </div>
            
            <p class="text-xs text-slate-400">
                Fasilitas presensi darurat untuk siswa yang tidak memiliki HP dan lupa membawa kartu RFID. Jam resmi sistem otomatis mencatat keterlambatan jika melewati pukul 07:00:00 WIB.
            </p>

            <div class="space-y-3">
                <div>
                    <label class="text-[11px] font-bold text-slate-300 block mb-1">NISN / Nama Siswa</label>
                    <input type="text" id="manualStudentInput" placeholder="Masukkan NISN atau Nama Siswa" class="w-full bg-slate-950 text-sm px-3.5 py-2.5 rounded-xl border border-slate-800 text-white focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="text-[11px] font-bold text-slate-300 block mb-1">Jenis Presensi</label>
                    <select id="manualTypeSelect" class="w-full bg-slate-950 text-sm px-3.5 py-2.5 rounded-xl border border-slate-800 text-white focus:outline-none focus:border-indigo-500">
                        <option value="GATE_IN">🚪 Masuk Sekolah (GATE_IN)</option>
                        <option value="GATE_OUT">🏃 Kepulangan Resmi (GATE_OUT)</option>
                    </select>
                </div>

                <div>
                    <label class="text-[11px] font-bold text-slate-300 block mb-1">Alasan Presensi Tombol</label>
                    <select id="manualReasonSelect" class="w-full bg-slate-950 text-sm px-3.5 py-2.5 rounded-xl border border-slate-800 text-white focus:outline-none focus:border-indigo-500">
                        <option value="KARTU_TERTINGGAL">Kartu RFID Tertinggal di Rumah &amp; Tidak Bawa HP</option>
                        <option value="KARTU_RUSAK_HILANG">Kartu RFID Rusak / Hilang (Menunggu Cetak Baru)</option>
                        <option value="KENDALA_TEKNIS_HP">HP Siswa Rusak / Mati / Baterai Habis</option>
                        <option value="LAINNYA">Alasan Khusus Lainnya</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button onclick="closeManualBypassModal()" class="flex-1 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-300">
                    Batal
                </button>
                <button onclick="submitManualBypass()" id="btnSubmitManualBypass" class="flex-1 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-xs font-bold text-white shadow-lg">
                    Simpan Presensi
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentMode = 'GATE_IN';
        let recentTaps = [];
        const cardInput = document.getElementById('cardInput');

        let totalTaps = 0;
        let onTimeCount = 0;
        let lateCount = 0;
        let outCount = 0;

        // Clock & Date Live
        setInterval(() => {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('id-ID', { hour12: false }).replace(/\./g, ':');
            document.getElementById('liveClock').innerText = timeStr + ' WIB';
            document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        }, 1000);

        function focusCardInput() {
            cardInput.focus();
        }

        // Keep input focused automatically for USB RFID Reader
        setInterval(() => {
            if (document.activeElement !== cardInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
                cardInput.focus();
            }
        }, 1500);

        function setGateMode(mode) {
            currentMode = mode;
            const btnIn = document.getElementById('btnModeIn');
            const btnOut = document.getElementById('btnModeOut');
            const banner = document.getElementById('gateStatusBanner');

            if (mode === 'GATE_IN') {
                btnIn.className = 'px-4 py-2 rounded-xl bg-emerald-600 text-white shadow-md transition-all';
                btnOut.className = 'px-4 py-2 rounded-xl text-slate-400 hover:text-white transition-all';
                banner.className = 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs px-5 py-2 rounded-full font-bold uppercase tracking-widest mb-4 shadow';
                banner.innerText = '🟢 SIAP SCAN: GATE-IN (MASUK SEKOLAH & RULE 07:00:00 WIB)';
            } else {
                btnOut.className = 'px-4 py-2 rounded-xl bg-blue-600 text-white shadow-md transition-all';
                btnIn.className = 'px-4 py-2 rounded-xl text-slate-400 hover:text-white transition-all';
                banner.className = 'bg-blue-500/20 text-blue-400 border border-blue-500/40 text-xs px-5 py-2 rounded-full font-bold uppercase tracking-widest mb-4 shadow';
                banner.innerText = '🔵 SIAP SCAN: GATE-OUT (KEPULANGAN RESMI SISWA)';
            }
            focusCardInput();
        }

        // Listen for USB Reader Enter Key
        cardInput.addEventListener('keypress', async (e) => {
            if (e.key === 'Enter') {
                const cardIdentifier = cardInput.value.trim();
                cardInput.value = '';
                if (cardIdentifier.length > 0) {
                    await processCardTap(cardIdentifier);
                }
            }
        });

        async function processCardTap(cardIdentifier, isManual = false, manualReason = '') {
            try {
                const res = await fetch('/api/attendance/tap-card', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cardIdentifier,
                        type: currentMode,
                        method: isManual ? 'MANUAL_BUTTON' : 'RFID',
                        reason: manualReason
                    })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    updateStats(data);
                    showStudentSuccess(data);
                    speakAttendance(data.student.name, data.status, data.isLate);
                    addToFeed(data);
                } else {
                    showErrorTap(data.message || 'Kartu Tidak Terdaftar di Sekolah');
                    speakText('Kartu tidak terdaftar atau presensi ditolak');
                }
            } catch (err) {
                console.error(err);
                showErrorTap('Gagal terhubung ke server');
            }
        }

        function updateStats(data) {
            totalTaps++;
            if (currentMode === 'GATE_OUT') {
                outCount++;
            } else {
                if (data.isLate) lateCount++;
                else onTimeCount++;
            }

            document.getElementById('statTotalTap').innerText = totalTaps;
            document.getElementById('statOnTime').innerText = onTimeCount;
            document.getElementById('statLate').innerText = lateCount;
            document.getElementById('statOut').innerText = outCount;
        }

        function showStudentSuccess(data) {
            const s = data.student;
            document.getElementById('idleInstructionArea').classList.add('hidden');
            const detailArea = document.getElementById('studentDetailArea');
            detailArea.classList.remove('hidden');

            const scannerBox = document.getElementById('scannerMainCard');
            if (data.isLate) {
                scannerBox.className = 'w-full bg-slate-900/90 border-2 border-red-500 rounded-3xl p-6 scanner-card-late text-center flex flex-col items-center justify-center relative overflow-hidden backdrop-blur-xl min-h-[460px]';
            } else {
                scannerBox.className = 'w-full bg-slate-900/90 border-2 border-emerald-500 rounded-3xl p-6 scanner-card-idle text-center flex flex-col items-center justify-center relative overflow-hidden backdrop-blur-xl min-h-[460px]';
            }

            // Photo / Avatar
            const imgPhoto = document.getElementById('resStudentPhoto');
            const avatarBox = document.getElementById('resStudentAvatar');
            if (s.photoUrl && s.photoUrl.length > 5) {
                imgPhoto.src = s.photoUrl;
                imgPhoto.classList.remove('hidden');
                avatarBox.classList.add('hidden');
            } else {
                imgPhoto.classList.add('hidden');
                avatarBox.classList.remove('hidden');
                avatarBox.innerText = (s.name || 'S')[0];
            }

            // Name & Meta
            document.getElementById('resStudentName').innerText = s.name;
            document.getElementById('resStudentMeta').innerText = `Kelas ${s.className || '-'} • NISN: ${s.nisn || '-'} • NIS: ${s.nis || '-'}`;
            document.getElementById('resHomeroom').innerText = `👨‍🏫 Wali Kelas: ${s.homeroomTeacher || '-'}`;

            // Status Badge
            const badge = document.getElementById('resBadgeStatus');
            const latePill = document.getElementById('resLatePill');

            if (currentMode === 'GATE_OUT') {
                badge.className = 'inline-block px-5 py-2 rounded-xl font-black text-sm uppercase tracking-wider bg-blue-600 text-white shadow-lg';
                badge.innerText = `🔵 KEPULANGAN RESMI (${data.scanTime} WIB)`;
                latePill.classList.add('hidden');
            } else if (data.isLate) {
                badge.className = 'inline-block px-5 py-2 rounded-xl font-black text-sm uppercase tracking-wider bg-red-600 text-white shadow-xl animate-pulse';
                badge.innerText = `🚨 TERLAMBAT +${data.lateMinutes || 1}m (${data.scanTime} WIB)`;
                latePill.classList.remove('hidden');
            } else {
                badge.className = 'inline-block px-5 py-2 rounded-xl font-black text-sm uppercase tracking-wider bg-emerald-600 text-white shadow-lg';
                badge.innerText = `✅ HADIR TEPAT WAKTU (${data.scanTime} WIB)`;
                latePill.classList.add('hidden');
            }

            // Tap Time, Parent & Points
            document.getElementById('resTapTime').innerText = data.scanTime + ' WIB';
            document.getElementById('resLateDetail').innerText = data.isLate 
                ? `Terlambat ${data.lateMinutes} menit (Batas 07:00:00 WIB)` 
                : 'Tepat Waktu (Batas 07:00:00 WIB)';
            document.getElementById('resParentPhone').innerText = `No HP: ${s.parentPhone || '-'}`;
            document.getElementById('resStudentPoints').innerText = `${s.points || 0} Poin`;

            // Auto-revert to idle after 5.5 seconds
            setTimeout(() => {
                detailArea.classList.add('hidden');
                document.getElementById('idleInstructionArea').classList.remove('hidden');
                scannerBox.className = 'w-full bg-slate-900/90 border-2 border-emerald-500/50 rounded-3xl p-6 scanner-card-idle text-center flex flex-col items-center justify-center relative overflow-hidden backdrop-blur-xl min-h-[460px]';
            }, 5500);
        }

        function showErrorTap(msg) {
            const banner = document.getElementById('gateStatusBanner');
            const origClass = banner.className;
            const origText = banner.innerText;

            banner.className = 'bg-red-500/30 text-red-300 border border-red-500/60 text-xs px-5 py-2 rounded-full font-bold uppercase tracking-widest mb-4 animate-pulse';
            banner.innerText = '❌ ' + msg;

            setTimeout(() => {
                banner.className = origClass;
                banner.innerText = origText;
            }, 4000);
        }

        function addToFeed(data) {
            recentTaps.unshift(data);
            if (recentTaps.length > 50) recentTaps.pop();
            renderFeed();
        }

        function renderFeed() {
            const container = document.getElementById('tapFeedList');
            const search = (document.getElementById('feedSearch')?.value || '').toLowerCase().trim();

            const filtered = recentTaps.filter(item => {
                if (!search) return true;
                const s = item.student || {};
                return (s.name || '').toLowerCase().includes(search) || (s.className || '').toLowerCase().includes(search);
            });

            document.getElementById('tapCountBadge').innerText = filtered.length + ' Siswa';

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-16 text-slate-500 text-xs">Belum ada catatan yang cocok.</div>`;
                return;
            }

            container.innerHTML = filtered.map(item => {
                const s = item.student;
                const statusColor = item.isLate 
                    ? 'text-red-400 bg-red-500/20 border-red-500/40' 
                    : (item.status.includes('PULANG') ? 'text-blue-400 bg-blue-500/20 border-blue-500/40' : 'text-emerald-400 bg-emerald-500/20 border-emerald-500/40');

                return `
                    <div class="bg-slate-950/70 p-3 rounded-2xl border border-slate-800/90 flex items-center justify-between shadow-sm hover:border-slate-700 transition-all">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 to-indigo-800 text-white font-bold flex items-center justify-center text-sm border border-blue-500/40 shadow">
                                ${(s.name || 'S')[0]}
                            </div>
                            <div>
                                <p class="font-bold text-xs text-white">${s.name}</p>
                                <p class="text-[10px] text-slate-400">Kelas ${s.className || '-'} &bull; ${item.scanTime} WIB</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-black px-2.5 py-1 rounded-xl border ${statusColor}">
                            ${item.status}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function playKioskBeep(isSuccess) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                if (isSuccess) {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1); // A5
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.35);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + 0.35);
                } else {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, ctx.currentTime); // A3
                    osc.frequency.setValueAtTime(164.81, ctx.currentTime + 0.15); // E3
                    gain.gain.setValueAtTime(0.35, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.45);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + 0.45);
                }
            } catch (_) {}
        }

        function speakAttendance(name, status, isLate) {
            playKioskBeep(!isLate);
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                let speech = name + ', presensi berhasil dicatat.';
                if (isLate) {
                    speech = 'Perhatian, ' + name + ', Anda hadir terlambat. Silakan melapor ke Ruang Bimbingan Konseling.';
                } else if (currentMode === 'GATE_OUT') {
                    speech = 'Selamat jalan ' + name + ', selamat pulang ke rumah.';
                }
                const utterance = new SpeechSynthesisUtterance(speech);
                utterance.lang = 'id-ID';
                utterance.rate = 1.05;
                window.speechSynthesis.speak(utterance);
            }
        }

        function speakText(text) {
            playKioskBeep(false);
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                window.speechSynthesis.speak(utterance);
            }
        }

        // Modal Presensi Tombol Manual
        function openManualBypassModal(e) {
            if (e) e.stopPropagation();
            document.getElementById('modalManualBypass').classList.remove('hidden');
            document.getElementById('manualStudentInput').focus();
        }

        function closeManualBypassModal() {
            document.getElementById('modalManualBypass').classList.add('hidden');
            focusCardInput();
        }

        async function submitManualBypass() {
            const studentInput = document.getElementById('manualStudentInput').value.trim();
            const type = document.getElementById('manualTypeSelect').value;
            const reason = document.getElementById('manualReasonSelect').value;

            if (!studentInput) {
                alert('Harap isi Nama atau NISN Siswa');
                return;
            }

            const btn = document.getElementById('btnSubmitManualBypass');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            const origMode = currentMode;
            currentMode = type;
            await processCardTap(studentInput, true, reason);
            currentMode = origMode;

            btn.disabled = false;
            btn.innerText = 'Simpan Presensi';
            closeManualBypassModal();
        }
    </script>
</body>
</html>