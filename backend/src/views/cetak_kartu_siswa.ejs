<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak &amp; Unduh QR Code Siswa - SMPN 1 Boyolangu</title>
    <script src="/js/tailwind.js"></script>
    <!-- QRCode.js Library (Local & Offline) -->
    <script src="/js/qrcode.min.js"></script>
    <!-- JSZip Library (Local & Offline) -->
    <script src="/js/jszip.min.js"></script>
    <style>
        @page {
            size: A4 portrait;
            margin: 6mm 8mm;
        }
        @media screen {
            .page-sheet {
                max-width: 210mm;
                min-height: 285mm;
                margin: 0 auto 2rem auto;
                background: white;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                padding: 16px;
            }
        }
        @media print {
            html, body {
                width: 100% !important;
                height: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            #printRoot {
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
                width: 100% !important;
            }
            .page-sheet {
                box-shadow: none !important;
                border: none !important;
                margin: 0 auto !important;
                width: 100% !important;
                height: 285mm !important;
                max-height: 285mm !important;
                padding: 4mm !important;
                box-sizing: border-box !important;
                page-break-after: always !important;
                break-after: page !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: flex-start !important;
            }
        }
        .student-id-card {
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            box-sizing: border-box;
            background: #ffffff;
            transition: all 0.2s ease;
        }
        @media screen {
            .student-id-card:hover {
                border-color: #3b82f6;
                box-shadow: 0 4px 12px -2px rgba(59, 130, 246, 0.2);
            }
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen font-sans text-slate-800">

    <!-- Top Action Bar (Non-Printable) -->
    <header class="no-print bg-slate-900 text-white p-4 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <a href="/admin/siswa" class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-600 transition-all flex items-center gap-1.5">
                    <span>←</span> Data Siswa
                </a>
                <div>
                    <h1 class="font-bold text-base md:text-lg flex items-center gap-2">
                        <span>🪪</span> Cetak &amp; Unduh QR Code Siswa Terpadu
                    </h1>
                    <p class="text-xs text-slate-400">Format Kartu A4 (8 Kartu / Lembar) • Kompatibel Presensi Kiosk, Gate Kelas &amp; Login APK CBT</p>
                </div>
            </div>

            <!-- Filters & Batch Download Controls -->
            <div class="flex items-center gap-2.5 flex-wrap">
                <!-- Filter Tingkat -->
                <select id="filterTingkatSelect" onchange="handleTingkatChange()" class="bg-slate-800 border border-slate-600 text-white text-xs rounded-xl px-3 py-2 font-bold focus:outline-none">
                    <option value="ALL">📋 Semua Tingkat (VII, VIII, IX)</option>
                    <option value="VII">🟢 Tingkat VII (Kelas 7)</option>
                    <option value="VIII">🔵 Tingkat VIII (Kelas 8)</option>
                    <option value="IX">🟣 Tingkat IX (Kelas 9)</option>
                </select>

                <!-- Filter Rombel -->
                <select id="filterRombelSelect" onchange="handleFilterChange()" class="bg-slate-800 border border-slate-600 text-white text-xs rounded-xl px-3 py-2 font-bold focus:outline-none">
                    <option value="ALL">Semua Rombel (33 Kelas)</option>
                </select>

                <!-- Search Input -->
                <input type="text" id="searchStudentInput" oninput="handleFilterChange()" placeholder="🔍 Cari Nama / NISN..." class="bg-slate-800 border border-slate-600 text-white text-xs rounded-xl px-3 py-2 w-44 placeholder-slate-400 focus:outline-none focus:border-blue-500">

                <!-- Print Action -->
                <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-xl font-bold text-xs shadow-md flex items-center gap-1.5 transition-all">
                    <span>🖨️</span> Cetak (Ctrl + P)
                </button>

                <!-- ZIP Download Action -->
                <button onclick="downloadAllQrZip()" id="btnZipAll" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl font-bold text-xs shadow-md flex items-center gap-1.5 transition-all" title="Unduh seluruh QR Code siswa yang terpilih dalam satu berkas ZIP">
                    <span>📦</span> Unduh ZIP Semua QR
                </button>
            </div>
        </div>
    </header>

    <!-- Info Banner (Non-Printable) -->
    <div class="no-print max-w-7xl mx-auto mt-4 px-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-3.5 flex flex-wrap justify-between items-center gap-3 shadow-sm">
            <div class="flex items-center gap-3 text-xs">
                <span class="bg-blue-100 text-blue-800 font-extrabold px-3 py-1 rounded-full" id="statFilteredBadge">
                    Menampilkan 0 Siswa
                </span>
                <span class="text-slate-500 font-medium">
                    Total Halaman Cetak A4: <strong class="text-slate-800 font-bold" id="statTotalPages">0 Lembar</strong>
                </span>
                <span class="text-slate-400">|</span>
                <span class="text-slate-500">
                    Format QR Code: <code class="bg-slate-100 px-2 py-0.5 rounded text-blue-700 font-bold">STUDENT_MEMBER:[ID]:[NISN]:[NAMA]:[KELAS]</code>
                </span>
            </div>
            <div class="flex items-center gap-2 text-xs">
                <button onclick="downloadCurrentClassZip()" id="btnZipClass" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-3 py-1.5 rounded-xl border border-indigo-200 transition-all flex items-center gap-1">
                    <span>📥</span> Unduh ZIP Rombel Terpilih Saja
                </button>
            </div>
        </div>
    </div>

    <!-- Main Container for Printable Pages -->
    <main class="max-w-7xl mx-auto py-6 px-4" id="printRoot">
        <div class="text-center py-16 text-slate-500" id="loadingState">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-blue-600 border-t-transparent mb-2"></div>
            <p class="font-medium text-sm">Menyiapkan kartu &amp; QR Code siswa...</p>
        </div>
    </main>

    <!-- Modal Progress Pengemasan ZIP -->
    <div id="zipProgressModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl p-6 max-w-md w-full shadow-2xl border text-center">
            <div class="text-4xl mb-3 animate-bounce">📦</div>
            <h3 class="font-bold text-base text-slate-800 mb-1">Mengemas QR Code Siswa ke Berkas ZIP</h3>
            <p class="text-xs text-slate-500 mb-4" id="zipProgressText">Sedang merender gambar QR Code...</p>
            
            <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden mb-3">
                <div id="zipProgressBar" class="bg-gradient-to-r from-blue-600 to-emerald-500 h-full w-0 transition-all duration-150"></div>
            </div>
            
            <p class="text-[11px] font-mono text-slate-400" id="zipProgressCounter">0 / 0 siswa</p>
        </div>
    </div>

    <script>
        const initialStudents = <%- JSON.stringify(initialStudents || []) %>;
        let allStudents = [...initialStudents];
        let filteredStudents = [];
        const CARDS_PER_SHEET = 8; // 8 kartu per lembar A4 (2 kolom x 4 baris)

        // Rombel list
        const ROMBEL_ALL = [
            'VII-A','VII-B','VII-C','VII-D','VII-E','VII-F','VII-G','VII-H','VII-I','VII-J','VII-K',
            'VIII-A','VIII-B','VIII-C','VIII-D','VIII-E','VIII-F','VIII-G','VIII-H','VIII-I','VIII-J','VIII-K',
            'IX-A','IX-B','IX-C','IX-D','IX-E','IX-F','IX-G','IX-H','IX-I','IX-J','IX-K'
        ];

        function init() {
            populateRombelDropdown();

            // Check URL param filter
            const urlParams = new URLSearchParams(window.location.search);
            const classParam = urlParams.get('class') || urlParams.get('rombel');
            const tingkatParam = urlParams.get('tingkat');

            if (tingkatParam) {
                document.getElementById('filterTingkatSelect').value = tingkatParam;
                handleTingkatChange();
            }
            if (classParam) {
                document.getElementById('filterRombelSelect').value = classParam;
            }

            handleFilterChange();
        }

        function populateRombelDropdown() {
            const tingkat = document.getElementById('filterTingkatSelect').value;
            const select = document.getElementById('filterRombelSelect');
            
            let list = ROMBEL_ALL;
            if (tingkat === 'VII') list = ROMBEL_ALL.filter(r => r.startsWith('VII-'));
            else if (tingkat === 'VIII') list = ROMBEL_ALL.filter(r => r.startsWith('VIII-'));
            else if (tingkat === 'IX') list = ROMBEL_ALL.filter(r => r.startsWith('IX-'));

            select.innerHTML = '<option value="ALL">📋 Semua Rombel (' + list.length + ' Kelas)</option>' +
                list.map(r => `<option value="${r}">Kelas ${r}</option>`).join('');
        }

        function handleTingkatChange() {
            populateRombelDropdown();
            handleFilterChange();
        }

        function handleFilterChange() {
            const tingkat = document.getElementById('filterTingkatSelect').value;
            const rombel = document.getElementById('filterRombelSelect').value;
            const query = (document.getElementById('searchStudentInput').value || '').trim().toLowerCase();

            filteredStudents = allStudents.filter(s => {
                const cName = s.className || '';
                
                // Filter Tingkat
                if (tingkat === 'VII' && !cName.startsWith('VII-')) return false;
                if (tingkat === 'VIII' && !cName.startsWith('VIII-')) return false;
                if (tingkat === 'IX' && !cName.startsWith('IX-')) return false;

                // Filter Rombel
                if (rombel !== 'ALL' && cName !== rombel) return false;

                // Search query
                if (query) {
                    const matchName = (s.name || '').toLowerCase().includes(query);
                    const matchNisn = (s.nisn || '').toLowerCase().includes(query);
                    const matchUser = (s.username || '').toLowerCase().includes(query);
                    const matchClass = cName.toLowerCase().includes(query);
                    if (!matchName && !matchNisn && !matchUser && !matchClass) return false;
                }

                return true;
            });

            // Update stats
            document.getElementById('statFilteredBadge').innerText = `Menampilkan ${filteredStudents.length.toLocaleString('id-ID')} Siswa`;
            const totalPages = Math.ceil(filteredStudents.length / CARDS_PER_SHEET);
            document.getElementById('statTotalPages').innerText = `${totalPages} Lembar A4`;

            renderCardsGrid(filteredStudents);
        }

        function renderCardsGrid(students) {
            const root = document.getElementById('printRoot');
            root.innerHTML = '';

            if (students.length === 0) {
                root.innerHTML = '<div class="text-center py-16 text-slate-400 font-medium">Tidak ada data siswa yang cocok dengan filter.</div>';
                return;
            }

            const totalSheets = Math.ceil(students.length / CARDS_PER_SHEET);

            for (let sheetIdx = 0; sheetIdx < totalSheets; sheetIdx++) {
                const sheetDiv = document.createElement('div');
                sheetDiv.className = 'page-sheet flex flex-col justify-between';

                const startIdx = sheetIdx * CARDS_PER_SHEET;
                const endIdx = Math.min(startIdx + CARDS_PER_SHEET, students.length);
                const pageStudents = students.slice(startIdx, endIdx);

                // Top sheet banner (subtle official marker)
                const sheetHeader = `
                    <div class="border-b border-slate-300 pb-1 mb-2 flex justify-between items-center text-[9px] text-slate-500 uppercase tracking-wider font-semibold">
                        <span>SMP NEGERI 1 BOYOLANGU • LEMBAR KARTU PELAJAR &amp; QR CODE DIGITAL</span>
                        <span>HALAMAN ${sheetIdx + 1} DARI ${totalSheets}</span>
                    </div>
                `;

                // 2x4 Grid Container for 8 Cards
                let cardsGridHtml = '<div class="grid grid-cols-2 gap-2.5 flex-1">';

                pageStudents.forEach((s, itemIdx) => {
                    const globalIdx = startIdx + itemIdx;
                    const cName = s.className || '-';
                    const nisn = s.nisn || s.username || '-';
                    const qrPayload = `STUDENT_MEMBER:${s.id}:${nisn}:${s.name}:${cName}`;
                    const canvasId = `qr-student-${globalIdx}`;

                    cardsGridHtml += `
                        <div class="student-id-card p-2.5 flex flex-col justify-between relative overflow-hidden bg-white shadow-sm">
                            <!-- Card Kop -->
                            <div class="flex items-center gap-2 border-b border-slate-200 pb-1.5 mb-1.5">
                                <img src="/logo-smpn1boyolangu.png" alt="Logo" class="w-8 h-8 object-contain flex-shrink-0" onerror="this.src='/images/logo-smpn1boyolangu.png'">
                                <div class="leading-tight flex-1">
                                    <h4 class="text-[8px] font-bold text-blue-900 uppercase tracking-wider">SMP NEGERI 1 BOYOLANGU</h4>
                                    <h3 class="text-[9.5px] font-black text-slate-900 uppercase">KARTU ANGGOTA &amp; QR RESMI</h3>
                                    <p class="text-[7.5px] text-slate-400 font-medium">Sistem Presensi &amp; CBT Terintegrasi</p>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <span class="bg-blue-100 text-blue-900 text-[8.5px] font-extrabold px-2 py-0.5 rounded-full border border-blue-200">
                                        ${cName}
                                    </span>
                                </div>
                            </div>

                            <!-- Card Middle: Biodata & QR Code -->
                            <div class="flex items-center justify-between gap-2 my-auto">
                                <!-- Left: Student Info -->
                                <div class="flex-1 pr-1 min-w-0">
                                    <h2 class="text-xs font-black text-slate-900 truncate" title="${s.name}">${s.name}</h2>
                                    <p class="text-[9.5px] font-mono font-bold text-slate-600 mt-0.5">NISN: ${nisn}</p>
                                    <p class="text-[8.5px] text-slate-500 font-semibold">Kelas: <strong>${cName}</strong></p>
                                    <div class="mt-1.5 flex items-center gap-1">
                                        <span class="bg-emerald-100 text-emerald-800 text-[8px] font-extrabold px-1.5 py-0.5 rounded">🟢 AKTIF</span>
                                        <span class="text-[8px] text-slate-400 font-mono">PRESENSI &amp; CBT</span>
                                    </div>
                                </div>

                                <!-- Right: QR Code Canvas -->
                                <div class="flex flex-col items-center flex-shrink-0">
                                    <div class="p-1 bg-white border border-slate-300 rounded-lg shadow-inner">
                                        <div id="${canvasId}" class="flex justify-center items-center w-[95px] h-[95px]"></div>
                                    </div>
                                    <button type="button" onclick="downloadSingleQr('${canvasId}', '${nisn}', '${(s.name || '').replace(/'/g, '')}', '${cName}')" class="no-print mt-1 text-[8.5px] bg-slate-800 hover:bg-slate-900 text-white font-bold py-0.5 px-2 rounded flex items-center gap-0.5 shadow-sm transition-all" title="Unduh gambar PNG barcode siswa ini">
                                        <span>📥</span> PNG
                                    </button>
                                </div>
                            </div>

                            <!-- Card Footer -->
                            <div class="border-t border-slate-100 pt-1 mt-1.5 flex justify-between items-center text-[7.5px] text-slate-400 font-mono">
                                <span>Presensi Mandiri / Bantuan Pengurus Kelas</span>
                                <span>SMPN 1 BOYOLANGU</span>
                            </div>
                        </div>
                    `;
                });

                cardsGridHtml += '</div>';

                // Bottom sheet footer
                const sheetFooter = `
                    <div class="border-t border-slate-200 pt-1 mt-2 flex justify-between items-center text-[8.5px] text-slate-400">
                        <span>Dicetak dari Portal Smart School CBT • Tanggal: ${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                        <span>Dokumen Identitas Resmi Sekolah</span>
                    </div>
                `;

                sheetDiv.innerHTML = sheetHeader + cardsGridHtml + sheetFooter;
                root.appendChild(sheetDiv);

                // Asynchronously render QR codes on this sheet
                setTimeout(() => {
                    pageStudents.forEach((s, itemIdx) => {
                        const globalIdx = startIdx + itemIdx;
                        const cName = s.className || '-';
                        const nisn = s.nisn || s.username || '-';
                        const qrPayload = `STUDENT_MEMBER:${s.id}:${nisn}:${s.name}:${cName}`;
                        const el = document.getElementById(`qr-student-${globalIdx}`);
                        if (el && !el.hasChildNodes()) {
                            new QRCode(el, {
                                text: qrPayload,
                                width: 95,
                                height: 95,
                                colorDark: "#0f172a",
                                colorLight: "#ffffff",
                                correctLevel: QRCode.CorrectLevel.M
                            });
                        }
                    });
                }, 40);
            }
        }

        // 1. Download Single Student QR Image
        function downloadSingleQr(canvasId, nisn, studentName, className) {
            const container = document.getElementById(canvasId);
            if (!container) return;
            const canvas = container.querySelector('canvas');
            if (!canvas) {
                const img = container.querySelector('img');
                if (img && img.src) {
                    const link = document.createElement('a');
                    link.href = img.src;
                    link.download = `QR_${className}_${nisn}_${studentName}.png`;
                    link.click();
                    return;
                }
                alert('Gambar QR belum siap, coba sesaat lagi.');
                return;
            }
            const link = document.createElement('a');
            link.download = `QR_${className}_${nisn}_${studentName.replace(/\s+/g, '_')}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
        }

        // 2. Download All QR Codes into ZIP
        async function downloadAllQrZip() {
            if (filteredStudents.length === 0) {
                alert('Tidak ada siswa yang dipilih.');
                return;
            }

            if (typeof JSZip === 'undefined') {
                alert('Pustaka ZIP belum dimuat, coba refresh halaman.');
                return;
            }

            const total = filteredStudents.length;
            if (!confirm(`Unduh ${total} QR Code Siswa dalam format ZIP?\n\nProses akan merender seluruh gambar PNG secara otomatis dan mengemasnya ke dalam satu berkas ZIP.`)) {
                return;
            }

            const modal = document.getElementById('zipProgressModal');
            const pBar = document.getElementById('zipProgressBar');
            const pCounter = document.getElementById('zipProgressCounter');
            const pText = document.getElementById('zipProgressText');
            modal.classList.remove('hidden');

            const zip = new JSZip();
            const rootFolder = zip.folder('QR_Code_Siswa_SMPN1_Boyolangu');

            // Hidden offline renderer div to guarantee all QR codes are rendered at high resolution
            const renderDiv = document.createElement('div');
            renderDiv.style.position = 'fixed';
            renderDiv.style.left = '-9999px';
            renderDiv.style.top = '-9999px';
            document.body.appendChild(renderDiv);

            try {
                for (let i = 0; i < total; i++) {
                    const s = filteredStudents[i];
                    const cName = s.className || 'Tanpa_Kelas';
                    const nisn = s.nisn || s.username || `SISWA_${i+1}`;
                    const safeName = (s.name || 'Siswa').replace(/[/\\?%*:|"<>]/g, '_').trim();
                    const qrPayload = `STUDENT_MEMBER:${s.id}:${nisn}:${s.name}:${cName}`;

                    // Update UI progress
                    const pct = Math.round(((i + 1) / total) * 100);
                    pBar.style.width = pct + '%';
                    pCounter.innerText = `${i + 1} / ${total} siswa (${pct}%)`;
                    pText.innerText = `Memproses [${cName}] ${safeName}...`;

                    // Render high-res QR code on off-screen canvas
                    renderDiv.innerHTML = '';
                    const tempQr = new QRCode(renderDiv, {
                        text: qrPayload,
                        width: 300,
                        height: 300,
                        colorDark: "#0f172a",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });

                    // Wait a moment for canvas draw
                    await new Promise(r => setTimeout(r, 15));

                    const canvas = renderDiv.querySelector('canvas');
                    if (canvas) {
                        const dataUrl = canvas.toDataURL('image/png');
                        const base64Data = dataUrl.replace(/^data:image\/png;base64,/, '');
                        const classFolder = rootFolder.folder(`Kelas_${cName}`);
                        const fileName = `${String(i + 1).padStart(3, '0')}_${nisn}_${safeName}.png`;
                        classFolder.file(fileName, base64Data, { base64: true });
                    }
                }

                pText.innerText = 'Mengompresi berkas ZIP final...';
                const content = await zip.generateAsync({ type: 'blob' }, (metadata) => {
                    pBar.style.width = metadata.percent + '%';
                    pCounter.innerText = `Kompresi: ${Math.round(metadata.percent)}%`;
                });

                // Trigger download
                const downloadUrl = URL.createObjectURL(content);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = `QR_Code_Siswa_SMPN1_Boyolangu_${Date.now().toString().slice(-6)}.zip`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(downloadUrl);

                setTimeout(() => {
                    modal.classList.add('hidden');
                    alert(`✅ Berhasil! Seluruh ${total} QR Code Siswa telah diunduh dalam berkas ZIP.`);
                }, 500);

            } catch (err) {
                console.error(err);
                modal.classList.add('hidden');
                alert('Gagal mengemas berkas ZIP: ' + err.message);
            } finally {
                if (renderDiv.parentNode) {
                    renderDiv.parentNode.removeChild(renderDiv);
                }
            }
        }

        // 3. Download ZIP for Selected Class only
        function downloadCurrentClassZip() {
            const rombel = document.getElementById('filterRombelSelect').value;
            if (rombel === 'ALL') {
                alert('Silakan pilih salah satu rombel kelas terlebih dahulu pada dropdown filter rombel.');
                return;
            }
            downloadAllQrZip();
        }

        window.onload = init;
    </script>
</body>
</html>
