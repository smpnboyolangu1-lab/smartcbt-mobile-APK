<script>
    // ==================== THEME TOGGLE (DARK / LIGHT MODE) ====================
    function updateThemeUI(isDark) {
        const icon1 = document.getElementById('themeToggleIcon');
        const icon2 = document.getElementById('floatingThemeIcon');
        if (icon1) icon1.innerText = isDark ? '☀️' : '🌙';
        if (icon2) icon2.innerText = isDark ? '☀️' : '🌙';
    }

    function togglePortalTheme() {
        const isDark = document.body.classList.toggle('dark-mode');
        localStorage.setItem('portal_theme', isDark ? 'dark' : 'light');
        updateThemeUI(isDark);
    }

    // Auto-apply saved theme on page load
    (function applySavedTheme() {
        const savedTheme = localStorage.getItem('portal_theme');
        const isDark = savedTheme === 'dark';
        if (isDark) {
            document.body.classList.add('dark-mode');
        }
        updateThemeUI(isDark);
    })();

    // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
    function togglePortalSidebar() {
        const isMobile = window.innerWidth < 768;
        const expandBtn = document.getElementById('sidebarExpandBtn');
        const floatingTheme = document.getElementById('floatingThemeToggleBtn');
        const backdrop = document.getElementById('portalSidebarBackdrop');

        if (isMobile) {
            const isOpen = document.body.classList.toggle('sidebar-mobile-open');
            if (backdrop) backdrop.classList.toggle('hidden', !isOpen);
            if (expandBtn) expandBtn.classList.toggle('hidden', isOpen);
            if (floatingTheme) floatingTheme.classList.toggle('hidden', isOpen);
        } else {
            const isCollapsed = document.body.classList.toggle('sidebar-collapsed');
            if (expandBtn) expandBtn.classList.toggle('hidden', !isCollapsed);
            if (floatingTheme) floatingTheme.classList.toggle('hidden', !isCollapsed);
            localStorage.setItem('portal_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        }
    }

    // Keyboard shortcut Ctrl+B or Cmd+B to toggle sidebar
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
            e.preventDefault();
            togglePortalSidebar();
        }
    });

    // Auto-apply saved sidebar collapse state on page load / refresh
    (function applySavedSidebarState() {
        const isMobile = window.innerWidth < 768;
        const expandBtn = document.getElementById('sidebarExpandBtn');
        const floatingTheme = document.getElementById('floatingThemeToggleBtn');
        const backdrop = document.getElementById('portalSidebarBackdrop');

        if (isMobile) {
            document.body.classList.remove('sidebar-mobile-open');
            if (backdrop) backdrop.classList.add('hidden');
            if (expandBtn) expandBtn.classList.remove('hidden');
            if (floatingTheme) floatingTheme.classList.remove('hidden');
        } else {
            const savedCollapsed = localStorage.getItem('portal_sidebar_collapsed');
            if (savedCollapsed === 'true') {
                document.body.classList.add('sidebar-collapsed');
                if (expandBtn) expandBtn.classList.remove('hidden');
                if (floatingTheme) floatingTheme.classList.remove('hidden');
            } else {
                document.body.classList.remove('sidebar-collapsed');
                if (expandBtn) expandBtn.classList.add('hidden');
                if (floatingTheme) floatingTheme.classList.add('hidden');
            }
        }
    })();

    // Highlight active menu item based on current URL path
    (function highlightActiveMenu() {
        const path = window.location.pathname;
        const links = document.querySelectorAll('aside nav a');
        links.forEach(a => {
            const href = a.getAttribute('href');
            if (href && (href === path || (href !== '/' && href !== '/admin' && path.startsWith(href)))) {
                a.classList.add('bg-indigo-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-indigo-500');
                a.classList.remove('text-slate-300');
            }
        });

        // Set user name if available in localStorage
        try {
            const userStr = localStorage.getItem('user');
            if (userStr) {
                const user = JSON.parse(userStr);
                const el = document.getElementById('sidebarAdminName');
                if (el) el.innerText = user.name || 'Administrator';
            }
        } catch(e) {}
    })();

    // Accordion Toggle Logic (Auto Expands Active & Collapses Others)
    function toggleSidebarMenu(menuId) {
        const menu = document.getElementById(menuId);
        const arrow = document.getElementById('arrow-' + menuId);
        if (!menu) return;

        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
            menu.classList.remove('hidden');
            if (arrow) arrow.innerText = '▼';
            sessionStorage.setItem(menuId, 'OPEN');
        } else {
            menu.classList.add('hidden');
            if (arrow) arrow.innerText = '▶';
            sessionStorage.setItem(menuId, 'CLOSED');
        }
    }

    // Auto-open active menu on page load & setup mouseleave auto-close
    (function initSidebarState() {
        const path = window.location.pathname;
        const menus = [
            { id: 'menu-remote', paths: ['/admin/remote-devices', '/admin/files', '/admin/client-logs'] },
            { id: 'menu-presensi', paths: ['/admin/absensi', '/admin/geofence-attendance', '/bk', '/satpam/gatepass', '/absensi/tap-kartu'] },
            { id: 'menu-sekolah', paths: ['/admin/guru', '/admin/siswa', '/admin/kelas', '/admin/biodata', '/admin/pengumuman', '/admin/surat', '/admin/tugas', '/admin/perpus', '/uks'] },
            { id: 'menu-ujian', paths: ['/admin/monitoring', '/admin/cbt'] },
            { id: 'menu-pengaturan', paths: ['/admin/users', '/admin/pengaturan', '/admin/server-monitoring', '/admin/app-releases', '/admin/feature-panel'] }
        ];

        menus.forEach(m => {
            const el = document.getElementById(m.id);
            const arrow = document.getElementById('arrow-' + m.id);
            const isCurrentActive = m.paths.some(p => path.startsWith(p));
            const savedState = sessionStorage.getItem(m.id);

            if (isCurrentActive || savedState === 'OPEN') {
                el?.classList.remove('hidden');
                if (arrow) arrow.innerText = '▼';
            } else {
                el?.classList.add('hidden');
                if (arrow) arrow.innerText = '▶';
            }
        });

        // Setup mouseleave auto-close: Ketika kursor berpindah keluar dari section dropdown
        document.querySelectorAll('[id^="section-menu-"]').forEach(section => {
            section.addEventListener('mouseleave', function() {
                const submenu = this.querySelector('div[id^="menu-"]');
                if (!submenu) return;
                const menuId = submenu.id;
                const arrow = document.getElementById('arrow-' + menuId);
                const matchedConfig = menus.find(m => m.id === menuId);
                const isCurrentActive = matchedConfig ? matchedConfig.paths.some(p => path.startsWith(p)) : false;

                // Jika bukan halaman aktif saat ini, tutup otomatis dropdown ketika cursor di pindah
                if (!isCurrentActive) {
                    submenu.classList.add('hidden');
                    if (arrow) arrow.innerText = '▶';
                    sessionStorage.setItem(menuId, 'CLOSED');
                }
            });
        });
    })();

    // Remote Menu Security
    function openRemoteProtectedPage() {
        window.location.href = '/admin/remote-devices';
    }

    function closeRemotePinModal() {
        document.getElementById('remotePinModal').classList.add('hidden');
    }

    function submitRemotePin() {
        closeRemotePinModal();
        window.location.href = '/admin/remote-devices';
    }

    function logoutAdmin() {
        localStorage.removeItem('token');
        sessionStorage.clear();
        window.location.href = '/';
    }
</script>
