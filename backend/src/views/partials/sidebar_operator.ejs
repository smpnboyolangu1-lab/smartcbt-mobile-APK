<script>
    // ==================== THEME TOGGLE (DARK / LIGHT MODE) ====================
    function updateThemeUI(isDark) {
        const icon1 = document.getElementById('themeToggleIcon');
        const icon2 = document.getElementById('floatingThemeIcon');
        if (icon1) icon1.innerText = isDark ? '☀️' : '🌙';
        if (icon2) icon2.innerText = isDark ? '☀️' : '🌙';
    }

    function togglePortalTheme() {
        const isDark = document.body.classList.toggle('dark-mode');
        localStorage.setItem('portal_theme', isDark ? 'dark' : 'light');
        updateThemeUI(isDark);
    }

    // Auto-apply saved theme on page load
    (function applySavedTheme() {
        const savedTheme = localStorage.getItem('portal_theme');
        const isDark = savedTheme === 'dark';
        if (isDark) {
            document.body.classList.add('dark-mode');
        }
        updateThemeUI(isDark);
    })();

    // ==================== OPERATOR SIDEBAR TOGGLE & PERSISTENCE ====================
    function togglePortalSidebar() {
        const isMobile = window.innerWidth < 768;
        const expandBtn = document.getElementById('sidebarExpandBtn');
        const floatingTheme = document.getElementById('floatingThemeToggleBtn');
        const backdrop = document.getElementById('portalSidebarBackdrop');
        const sidebar = document.getElementById('portalSidebar');

        if (isMobile) {
            const isOpen = document.body.classList.toggle('sidebar-mobile-open');
            if (backdrop) backdrop.classList.toggle('hidden', !isOpen);
            if (expandBtn) expandBtn.classList.toggle('hidden', isOpen);
            if (floatingTheme) floatingTheme.classList.toggle('hidden', isOpen);
        } else {
            const isCollapsed = document.body.classList.toggle('sidebar-collapsed');
            if (expandBtn) expandBtn.classList.toggle('hidden', !isCollapsed);
            if (floatingTheme) floatingTheme.classList.toggle('hidden', !isCollapsed);
            localStorage.setItem('portal_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        }
    }

    // Shortcut Ctrl+B
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
            e.preventDefault();
            togglePortalSidebar();
        }
    });

    // Apply saved state
    (function applySavedSidebarState() {
        const isMobile = window.innerWidth < 768;
        const expandBtn = document.getElementById('sidebarExpandBtn');
        const floatingTheme = document.getElementById('floatingThemeToggleBtn');
        const backdrop = document.getElementById('portalSidebarBackdrop');

        if (isMobile) {
            document.body.classList.remove('sidebar-mobile-open');
            if (backdrop) backdrop.classList.add('hidden');
            if (expandBtn) expandBtn.classList.remove('hidden');
            if (floatingTheme) floatingTheme.classList.remove('hidden');
        } else {
            const savedCollapsed = localStorage.getItem('portal_sidebar_collapsed');
            if (savedCollapsed === 'true') {
                document.body.classList.add('sidebar-collapsed');
                if (expandBtn) expandBtn.classList.remove('hidden');
                if (floatingTheme) floatingTheme.classList.remove('hidden');
            } else {
                document.body.classList.remove('sidebar-collapsed');
                if (expandBtn) expandBtn.classList.add('hidden');
                if (floatingTheme) floatingTheme.classList.add('hidden');
            }
        }
    })();

    // Highlight active link in operator sidebar
    (function highlightOperatorSidebar() {
        const path = window.location.pathname;
        if (path === '/operator/cbt') {
            const el = document.getElementById('opnav-cbt');
            if (el) el.classList.add('bg-sky-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-sky-500');
        } else if (path === '/operator/monitoring') {
            const el = document.getElementById('opnav-monitor');
            if (el) el.classList.add('bg-sky-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-sky-500');
        } else if (path === '/operator') {
            const el = document.getElementById('opnav-token');
            if (el) el.classList.add('bg-sky-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-sky-500');
        } else if (path.includes('/jam-pelajaran')) {
            const el = document.getElementById('opnav-jp');
            if (el) el.classList.add('bg-emerald-600/30', 'text-emerald-300', 'font-bold', 'border-l-4', 'border-emerald-500');
        } else if (path.includes('/piket')) {
            const el = document.getElementById('opnav-piket');
            if (el) el.classList.add('bg-emerald-600/30', 'text-emerald-300', 'font-bold', 'border-l-4', 'border-emerald-500');
        } else if (path.includes('/feature-panel')) {
            const el = document.getElementById('opnav-feature-panel');
            if (el) el.classList.add('bg-amber-600/30', 'text-amber-200', 'font-bold', 'border-l-4', 'border-amber-500');
        }

        try {
            const userStr = localStorage.getItem('user');
            if (userStr) {
                const user = JSON.parse(userStr);
                const el = document.getElementById('sidebarOperatorName');
                if (el) el.innerText = user.name || 'Operator';
            }
        } catch(e) {}
    })();

    function logoutOperator() {
        localStorage.removeItem('token');
        sessionStorage.clear();
        window.location.href = '/';
    }
</script>
