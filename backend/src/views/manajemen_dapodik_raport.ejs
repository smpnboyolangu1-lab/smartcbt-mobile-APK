<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Buku Induk & Dapodik (Spreadsheet) - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
    <script src="/js/xlsx.full.min.js"></script>
    <style>
        .tab-btn.active {
            background-color: #0284c7;
            color: white;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
            font-weight: 800;
        }
    </style>
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <!-- Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-0 md:ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-black text-slate-800 flex items-center gap-2">
                        <span>📊</span> Buku Induk &amp; Dapodik Kemendikbud
                    </h1>
                    <p class="text-slate-500 text-xs">Pusat Data 17 Item Raport &amp; Sinkronisasi Spreadsheet Excel untuk Pembetulan Siswa (Fokus Kelas VII)</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
                <a href="/api/dapodik/template-excel" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 px-3.5 py-2 rounded-xl font-bold text-xs flex items-center gap-2 shadow-sm transition-all">
                    <span>📥</span> <span>Download Template Excel</span>
                </a>
                <button onclick="exportExcelCurrentFilter()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl font-bold text-xs flex items-center gap-2 shadow-sm transition-all">
                    <span>📊</span> <span>Ekspor Spreadsheet (.xlsx)</span>
                </button>
                <button onclick="openImportModal()" class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-xl font-bold text-xs flex items-center gap-2 shadow-md transition-all">
                    <span>📤</span> <span>Impor Excel Dapodik</span>
                </button>
            </div>
        </div>

        <!-- Official Dapodik Notice Banner -->
        <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-xl shadow-xs mb-6">
            <div class="flex items-start gap-3">
                <div class="text-amber-600 text-xl font-black mt-0.5">⚠️</div>
                <div class="flex-1 text-xs text-amber-900 leading-relaxed">
                    <p class="font-extrabold text-[13px] text-amber-950 mb-0.5">Ketentuan Pembetulan Biodata Siswa &amp; Buku Induk Raport</p>
                    <p>Data 17 item di bawah ini ditampilkan pada aplikasi siswa dan orang tua dalam status <strong>TETAP (READ-ONLY)</strong>. Siswa dan orang tua tidak dapat mengubah biodata sendiri di aplikasi. Seluruh pembetulan (nama, tanggal lahir, NIK, orang tua, dll.) dilakukan secara resmi oleh Operator Dapodik Sekolah dan <strong>WAJIB SESUAI DENGAN DOKUMEN ASLI / FOTOKOPI KARTU KELUARGA (KK) SERTA AKTA KELAHIRAN</strong> yang diserahkan wali murid.</p>
                </div>
            </div>
        </div>

        <!-- 4 KPI Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div onclick="selectTingkatTab('ALL')" class="bg-white p-4 rounded-2xl border shadow-xs cursor-pointer hover:border-sky-400 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-slate-500 font-bold uppercase">Total Siswa Buku Induk</p>
                    <p class="text-2xl font-black text-slate-800" id="statTotalStudents">0</p>
                    <p class="text-[10px] text-sky-600 font-semibold mt-0.5">Seluruh Rombel Terdaftar</p>
                </div>
                <div class="p-3 bg-sky-50 text-sky-600 rounded-2xl text-2xl">👨‍🎓</div>
            </div>
            <div onclick="selectTingkatTab('VII')" class="bg-white p-4 rounded-2xl border shadow-xs cursor-pointer hover:border-emerald-400 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-emerald-700 font-bold uppercase">Tingkat VII (Kelas 7)</p>
                    <p class="text-2xl font-black text-emerald-600" id="statKelasVII">0</p>
                    <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">Fokus Verifikasi &amp; Dapodik Baru</p>
                </div>
                <div class="p-3 bg-emerald-50 text-emerald-600 rounded-2xl text-2xl">🟢</div>
            </div>
            <div onclick="selectTingkatTab('VIII')" class="bg-white p-4 rounded-2xl border shadow-xs cursor-pointer hover:border-blue-400 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-blue-700 font-bold uppercase">Tingkat VIII (Kelas 8)</p>
                    <p class="text-2xl font-black text-blue-600" id="statKelasVIII">0</p>
                    <p class="text-[10px] text-blue-600 font-semibold mt-0.5">Buku Induk Tahun ke-2</p>
                </div>
                <div class="p-3 bg-blue-50 text-blue-600 rounded-2xl text-2xl">🔵</div>
            </div>
            <div onclick="selectTingkatTab('IX')" class="bg-white p-4 rounded-2xl border shadow-xs cursor-pointer hover:border-purple-400 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-purple-700 font-bold uppercase">Tingkat IX (Kelas 9)</p>
                    <p class="text-2xl font-black text-purple-600" id="statKelasIX">0</p>
                    <p class="text-[10px] text-purple-600 font-semibold mt-0.5">Persiapan Kelulusan &amp; Ijazah</p>
                </div>
                <div class="p-3 bg-purple-50 text-purple-600 rounded-2xl text-2xl">🟣</div>
            </div>
        </div>

        <!-- Filter & Search Bar -->
        <div class="bg-white p-4 rounded-2xl border shadow-xs mb-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <!-- Level Tabs -->
                <div class="flex items-center bg-slate-100 p-1.5 rounded-xl gap-1">
                    <button onclick="selectTingkatTab('ALL')" id="tabAll" class="tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5">
                        <span>📋</span> <span>Semua Kelas</span>
                    </button>
                    <button onclick="selectTingkatTab('VII')" id="tabVII" class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-slate-700 hover:text-slate-900 transition-all flex items-center gap-1.5">
                        <span>🟢</span> <span>Kelas VII</span>
                    </button>
                    <button onclick="selectTingkatTab('VIII')" id="tabVIII" class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-slate-700 hover:text-slate-900 transition-all flex items-center gap-1.5">
                        <span>🔵</span> <span>Kelas VIII</span>
                    </button>
                    <button onclick="selectTingkatTab('IX')" id="tabIX" class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-slate-700 hover:text-slate-900 transition-all flex items-center gap-1.5">
                        <span>🟣</span> <span>Kelas IX</span>
                    </button>
                </div>

                <!-- Sub-Filter Rombel & Live Search -->
                <div class="flex items-center gap-3 flex-1 max-w-xl justify-end">
                    <select id="filterRombelSelect" onchange="onRombelChange()" class="text-xs font-bold border-2 border-sky-100 rounded-xl px-3 py-2 bg-sky-50/50 text-sky-900 focus:outline-hidden">
                        <option value="ALL">Semua Rombel</option>
                    </select>

                    <input type="text" id="searchInput" placeholder="🔍 Cari Nama / NISN / NIS..."
                           class="border rounded-xl px-3.5 py-2 text-xs w-64 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-sky-500 outline-hidden"
                           oninput="debounceSearch()">
                </div>
            </div>
        </div>

        <!-- Student Dapodik Table -->
        <div class="bg-white rounded-2xl shadow-xs overflow-hidden flex flex-col border">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse whitespace-nowrap text-xs" id="dapodikTable">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 uppercase tracking-wider font-bold border-b">
                            <th class="p-3.5">No</th>
                            <th class="p-3.5">Identitas Siswa (1, 2)</th>
                            <th class="p-3.5">Rombel</th>
                            <th class="p-3.5">TTL &amp; JK (3, 4)</th>
                            <th class="p-3.5">Keluarga &amp; Anak Ke (6, 7)</th>
                            <th class="p-3.5">Alamat &amp; Telp (8, 9)</th>
                            <th class="p-3.5">Orang Tua / Ayah &amp; Ibu (12, 15)</th>
                            <th class="p-3.5 text-right">Aksi Operator</th>
                        </tr>
                    </thead>
                    <tbody id="dapodikTableBody" class="divide-y divide-slate-100">
                        <tr><td colspan="8" class="p-8 text-center text-slate-400">Memuat data dari database...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="p-4 bg-slate-50 border-t flex justify-between items-center text-xs text-slate-600">
                <span id="pageInfo">Menampilkan 0-0 dari 0 siswa</span>
                <div class="space-x-2">
                    <button onclick="prevPage()" class="px-3 py-1.5 bg-slate-200 rounded-lg hover:bg-slate-300 disabled:opacity-50 font-bold" id="btnPrev">Sebelumnya</button>
                    <button onclick="nextPage()" class="px-3 py-1.5 bg-sky-600 text-white rounded-lg hover:bg-sky-700 disabled:opacity-50 font-bold shadow-xs" id="btnNext">Selanjutnya</button>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL 1: EDIT INDIVIDUAL SISWA (17 ITEM) -->
    <div id="modalEditStudent" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl w-full max-w-4xl max-h-[92vh] overflow-y-auto shadow-2xl border">
            <div class="p-5 border-b flex justify-between items-center bg-gradient-to-r from-sky-800 to-indigo-900 text-white rounded-t-3xl sticky top-0 z-10">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📝</span>
                    <div>
                        <h2 class="text-base font-bold" id="editModalTitle">Pembetulan Biodata Siswa (Operator Dapodik)</h2>
                        <p class="text-xs text-sky-200">Seluruh data wajib diselaraskan dengan Kartu Keluarga &amp; Akta Kelahiran</p>
                    </div>
                </div>
                <button type="button" onclick="closeEditModal()" class="text-white hover:text-slate-300 text-2xl font-bold">&times;</button>
            </div>

            <form id="formEditStudent" onsubmit="saveStudentChanges(event)" class="p-6 space-y-6">
                <input type="hidden" id="editStudentId">

                <!-- Section A: 1. Nama, 2. NISN, NIS, Kelas, TTL, JK, Agama -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                    <h3 class="text-xs font-black uppercase text-sky-700 mb-3 flex items-center gap-2">
                        <span>👤</span> <span>A. Keterangan Tentang Diri Peserta Didik (Item 1 - 7)</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div class="md:col-span-2">
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">1. Nama Lengkap (Sesuai Akta Kelahiran) *</label>
                            <input type="text" id="editNamaLengkap" required class="w-full border rounded-xl px-3 py-2 text-xs bg-white font-bold outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Kelas / Rombel *</label>
                            <input type="text" id="editClassName" required class="w-full border rounded-xl px-3 py-2 text-xs bg-white font-bold outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">2. NISN (10 Digit) *</label>
                            <input type="text" id="editNisn" required class="w-full border rounded-xl px-3 py-2 text-xs bg-white font-bold outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">NIS Sekolah</label>
                            <input type="text" id="editNis" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">4. Jenis Kelamin *</label>
                            <select id="editGender" class="w-full border rounded-xl px-3 py-2 text-xs bg-white font-bold outline-hidden focus:ring-2 focus:ring-sky-500">
                                <option value="Laki-laki">Laki-laki</option>
                                <option value="Perempuan">Perempuan</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">3a. Tempat Lahir</label>
                            <input type="text" id="editPob" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">3b. Tanggal Lahir (YYYY-MM-DD)</label>
                            <input type="text" id="editDob" placeholder="Contoh: 2011-08-17" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">5. Agama</label>
                            <select id="editReligion" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                                <option value="Islam">Islam</option>
                                <option value="Kristen">Kristen</option>
                                <option value="Katolik">Katolik</option>
                                <option value="Hindu">Hindu</option>
                                <option value="Buddha">Buddha</option>
                                <option value="Konghucu">Konghucu</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">6. Status Dalam Keluarga</label>
                            <input type="text" id="editStatusKeluarga" placeholder="Anak Kandung" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">7. Anak Ke</label>
                            <input type="number" id="editAnakKe" min="1" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                    </div>
                </div>

                <!-- Section B: 8. Alamat, 9. Telepon, 10. Sekolah Asal, 11. Diterima -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                    <h3 class="text-xs font-black uppercase text-sky-700 mb-3 flex items-center gap-2">
                        <span>🏡</span> <span>B. Tempat Tinggal &amp; Riwayat Masuk (Item 8 - 11)</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div class="md:col-span-3">
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">8. Alamat Lengkap Peserta Didik</label>
                            <input type="text" id="editAlamat" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">RT / RW</label>
                            <div class="flex gap-2">
                                <input type="text" id="editRt" placeholder="RT" class="w-1/2 border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                                <input type="text" id="editRw" placeholder="RW" class="w-1/2 border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Dusun / Lingkungan</label>
                            <input type="text" id="editDusun" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Desa / Kelurahan</label>
                            <input type="text" id="editDesa" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Kecamatan</label>
                            <input type="text" id="editKecamatan" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Kabupaten / Kota</label>
                            <input type="text" id="editKabupaten" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Kode Pos</label>
                            <input type="text" id="editKodePos" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">9. No. Telepon Rumah / Siswa</label>
                            <input type="text" id="editTeleponRumah" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">10. Sekolah Asal (SD/MI)</label>
                            <input type="text" id="editSekolahAsal" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">11b. Tanggal Diterima di Sekolah</label>
                            <input type="text" id="editDiterimaTanggal" placeholder="15 Juli 2024" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                    </div>
                </div>

                <!-- Section C: 12. Orang Tua, 13. Alamat Ortu, 14. Telepon Ortu, 15. Pekerjaan Ortu -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                    <h3 class="text-xs font-black uppercase text-sky-700 mb-3 flex items-center gap-2">
                        <span>👨‍👩‍👧</span> <span>C. Keterangan Tentang Orang Tua (Item 12 - 15)</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">12a. Nama Ayah Kandung</label>
                            <input type="text" id="editNamaAyah" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">15a. Pekerjaan Ayah</label>
                            <input type="text" id="editPekerjaanAyah" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">12b. Nama Ibu Kandung</label>
                            <input type="text" id="editNamaIbu" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden focus:ring-2 focus:ring-sky-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">15b. Pekerjaan Ibu</label>
                            <input type="text" id="editPekerjaanIbu" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">13. Alamat Orang Tua</label>
                            <input type="text" id="editAlamatOrtu" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">14. No. Telepon Rumah / HP Orang Tua</label>
                            <input type="text" id="editTeleponOrtu" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                    </div>
                </div>

                <!-- Section D: 16. Wali Peserta Didik, 17. Pekerjaan Wali -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
                    <h3 class="text-xs font-black uppercase text-sky-700 mb-3 flex items-center gap-2">
                        <span>🤝</span> <span>D. Keterangan Tentang Wali (Item 16 - 17, Jika Ada)</span>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">16a. Nama Wali Peserta Didik</label>
                            <input type="text" id="editNamaWali" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">17. Pekerjaan Wali Peserta Didik</label>
                            <input type="text" id="editPekerjaanWali" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">16b. Alamat Wali Peserta Didik</label>
                            <input type="text" id="editAlamatWali" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1">16c. No. Telepon Rumah Wali</label>
                            <input type="text" id="editTeleponWali" class="w-full border rounded-xl px-3 py-2 text-xs bg-white outline-hidden">
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-3 border-t">
                    <button type="button" onclick="closeEditModal()" class="px-5 py-2.5 rounded-xl border border-slate-300 font-bold text-xs text-slate-600 hover:bg-slate-100 transition-all">Batal</button>
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-black text-xs shadow-md transition-all flex items-center gap-2">
                        <span>💾</span> <span>Simpan Perubahan Dapodik</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2: IMPORT EXCEL SPREADSHEET DAPODIK -->
    <div id="modalImport" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl w-full max-w-xl shadow-2xl border p-6">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📤</span>
                    <div>
                        <h2 class="text-base font-bold text-slate-800">Impor Spreadsheet Excel Dapodik</h2>
                        <p class="text-xs text-slate-500">Pembetulan massal data siswa kelas VII &amp; tingkat lainnya</p>
                    </div>
                </div>
                <button type="button" onclick="closeImportModal()" class="text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
            </div>

            <div class="space-y-4">
                <div class="bg-blue-50 border border-blue-200 rounded-xl p-3.5 text-xs text-blue-900 leading-relaxed">
                    <p class="font-bold mb-1">💡 Petunjuk Impor Spreadsheet:</p>
                    <ul class="list-disc list-inside space-y-1">
                        <li>Gunakan file <strong>.xlsx</strong> atau <strong>.csv</strong> dari ekspor Dapodik Kemendikbud.</li>
                        <li>Sistem otomatis mengenali header kolom seperti NISN, Nama, Tempat Lahir, Tanggal Lahir, Nama Orang Tua, dll.</li>
                        <li>Jika siswa sudah ada di database, biodata akan otomatis <strong>diperbarui</strong>. Jika belum ada (misal siswa baru kelas VII), akun siswa &amp; orang tua akan otomatis <strong>dibuat</strong>.</li>
                    </ul>
                </div>

                <div class="border-2 border-dashed border-sky-300 hover:border-sky-500 rounded-2xl p-6 text-center cursor-pointer transition-all bg-sky-50/30" onclick="document.getElementById('inputExcelFile').click()">
                    <input type="file" id="inputExcelFile" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleFileSelected(event)">
                    <div class="text-3xl mb-2">📊</div>
                    <p class="text-xs font-bold text-slate-700" id="labelFileName">Klik untuk memilih file spreadsheet (.xlsx / .csv)</p>
                    <p class="text-[11px] text-slate-400 mt-1">Maksimal 25MB per file</p>
                </div>

                <div id="importLoading" class="hidden text-center py-4">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-sky-600 border-t-transparent"></div>
                    <p class="text-xs font-bold text-sky-700 mt-2">Sedang memproses dan menyelaraskan data spreadsheet ke database...</p>
                </div>

                <div class="flex justify-end gap-3 pt-3 border-t">
                    <button type="button" onclick="closeImportModal()" class="px-4 py-2 rounded-xl border border-slate-300 font-bold text-xs text-slate-600 hover:bg-slate-100">Batal</button>
                    <button type="button" id="btnConfirmImport" onclick="processExcelImport()" disabled class="px-5 py-2 rounded-xl bg-sky-600 disabled:opacity-50 hover:bg-sky-700 text-white font-black text-xs shadow-md transition-all flex items-center gap-2">
                        <span>🚀</span> <span>Mulai Impor &amp; Selaraskan</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        let currentTingkat = 'ALL';
        let currentRombel = 'ALL';
        let currentSearch = '';
        let currentPage = 1;
        let searchTimeout = null;
        let selectedExcelFile = null;

        document.addEventListener('DOMContentLoaded', () => {
            initRombelOptions();
            loadDapodikStudents();
            loadSummaryStats();
        });

        function initRombelOptions() {
            const select = document.getElementById('filterRombelSelect');
            select.innerHTML = '<option value="ALL">Semua Rombel</option>';
            const classes = [];
            for (let i = 65; i <= 75; i++) classes.push('VII-' + String.fromCharCode(i));
            for (let i = 65; i <= 75; i++) classes.push('VIII-' + String.fromCharCode(i));
            for (let i = 65; i <= 75; i++) classes.push('IX-' + String.fromCharCode(i));
            classes.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c;
                opt.textContent = 'Kelas ' + c;
                select.appendChild(opt);
            });
        }

        async function loadSummaryStats() {
            try {
                const res = await fetch('/api/dapodik/students?limit=1');
                const data = await res.json();
                if (data.success && data.stats) {
                    document.getElementById('statTotalStudents').textContent = data.stats.totalAll || data.total || 0;
                    document.getElementById('statKelasVII').textContent = data.stats.totalVII || 0;
                    document.getElementById('statKelasVIII').textContent = data.stats.totalVIII || 0;
                    document.getElementById('statKelasIX').textContent = data.stats.totalIX || 0;
                }
            } catch (e) {
                console.error(e);
            }
        }

        function selectTingkatTab(tingkat) {
            currentTingkat = tingkat;
            ['tabAll', 'tabVII', 'tabVIII', 'tabIX'].forEach(id => {
                document.getElementById(id).classList.remove('active');
            });
            if (tingkat === 'ALL') document.getElementById('tabAll').classList.add('active');
            else if (tingkat === 'VII') document.getElementById('tabVII').classList.add('active');
            else if (tingkat === 'VIII') document.getElementById('tabVIII').classList.add('active');
            else if (tingkat === 'IX') document.getElementById('tabIX').classList.add('active');

            currentRombel = 'ALL';
            document.getElementById('filterRombelSelect').value = 'ALL';
            currentPage = 1;
            loadDapodikStudents();
        }

        function onRombelChange() {
            currentRombel = document.getElementById('filterRombelSelect').value;
            currentPage = 1;
            loadDapodikStudents();
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentSearch = document.getElementById('searchInput').value.trim();
                currentPage = 1;
                loadDapodikStudents();
            }, 300);
        }

        async function loadDapodikStudents() {
            const tbody = document.getElementById('dapodikTableBody');
            tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400">Memuat data dari database...</td></tr>';

            let targetClass = currentRombel !== 'ALL' ? currentRombel : currentTingkat;
            let url = `/api/dapodik/students?page=${currentPage}&limit=30`;
            if (targetClass && targetClass !== 'ALL') url += `&className=${encodeURIComponent(targetClass)}`;
            if (currentSearch) url += `&search=${encodeURIComponent(currentSearch)}`;

            try {
                const res = await fetch(url);
                const result = await res.json();
                if (!result.success || !result.data || result.data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400">Tidak ada data siswa ditemukan.</td></tr>';
                    document.getElementById('pageInfo').textContent = 'Menampilkan 0 dari 0 siswa';
                    document.getElementById('btnPrev').disabled = true;
                    document.getElementById('btnNext').disabled = true;
                    return;
                }

                const students = result.data;
                const startIdx = (result.page - 1) * result.limit + 1;
                const endIdx = startIdx + students.length - 1;
                document.getElementById('pageInfo').textContent = `Menampilkan ${startIdx}-${endIdx} dari ${result.total} siswa`;
                document.getElementById('btnPrev').disabled = result.page <= 1;
                document.getElementById('btnNext').disabled = result.page >= result.totalPages;

                tbody.innerHTML = students.map((s, idx) => {
                    const rowNo = startIdx + idx;
                    const studentJson = encodeURIComponent(JSON.stringify(s));
                    const ttl = (s.pob ? s.pob + ', ' : '') + (s.dob || '-');
                    const jkBadge = s.gender === 'Perempuan' 
                        ? '<span class="bg-rose-100 text-rose-800 px-2 py-0.5 rounded-full text-[10px] font-bold">P</span>'
                        : '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full text-[10px] font-bold">L</span>';
                    const dapodikBadge = s.isImportedFromDapodik
                        ? '<span class="bg-emerald-100 text-emerald-800 border border-emerald-300 px-2 py-0.5 rounded-md text-[10px] font-bold inline-flex items-center gap-1"><span>✓</span> Terverifikasi Dapodik</span>'
                        : '<span class="bg-amber-100 text-amber-800 border border-amber-300 px-2 py-0.5 rounded-md text-[10px] font-bold inline-flex items-center gap-1"><span>⚠️</span> Belum Import Dapodik</span>';

                    return `
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="p-3.5 font-bold text-slate-500">${rowNo}</td>
                            <td class="p-3.5">
                                <div class="font-extrabold text-slate-900">${s.name || '-'}</div>
                                <div class="text-[11px] text-slate-500 font-mono mt-0.5">NISN: ${s.nisn || s.username || '-'} ${s.nis ? '• NIS: ' + s.nis : ''}</div>
                                <div class="mt-1">${dapodikBadge}</div>
                            </td>
                            <td class="p-3.5">
                                <span class="bg-sky-100 text-sky-800 px-2.5 py-1 rounded-lg font-black text-[11px]">${s.className || '-'}</span>
                            </td>
                            <td class="p-3.5">
                                <div>${ttl}</div>
                                <div class="mt-1">${jkBadge} <span class="text-[11px] text-slate-500 font-semibold">${s.religion || 'Islam'}</span></div>
                            </td>
                            <td class="p-3.5">
                                <div class="font-semibold">${s.statusDalamKeluarga || 'Anak Kandung'}</div>
                                <div class="text-[11px] text-slate-500">Anak ke-${s.anakKe || 1}</div>
                            </td>
                            <td class="p-3.5">
                                <div class="max-w-[200px] truncate" title="${s.alamat || s.address || '-'}">${s.alamat || s.address || '-'}</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">📞 ${s.teleponRumah || s.parentPhone || '-'}</div>
                            </td>
                            <td class="p-3.5">
                                <div><span class="font-bold">Ayah:</span> ${s.namaAyah || s.fatherName || '-'} <span class="text-[11px] text-slate-400">(${s.pekerjaanAyah || '-'})</span></div>
                                <div class="mt-0.5"><span class="font-bold">Ibu:</span> ${s.namaIbu || s.motherName || '-'} <span class="text-[11px] text-slate-400">(${s.pekerjaanIbu || '-'})</span></div>
                            </td>
                            <td class="p-3.5 text-right">
                                <button onclick="openEditModal('${studentJson}')" class="bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-300 px-3 py-1.5 rounded-xl font-bold text-xs transition-all shadow-2xs">
                                    ✏️ Edit Dapodik
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                console.error(err);
                tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-rose-500 font-bold">Gagal memuat data dari server.</td></tr>';
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                loadDapodikStudents();
            }
        }

        function nextPage() {
            currentPage++;
            loadDapodikStudents();
        }

        function exportExcelCurrentFilter() {
            let targetClass = currentRombel !== 'ALL' ? currentRombel : currentTingkat;
            let url = `/api/dapodik/export-excel?className=${encodeURIComponent(targetClass)}`;
            window.location.href = url;
        }

        function openEditModal(studentEncoded) {
            const s = JSON.parse(decodeURIComponent(studentEncoded));
            document.getElementById('editStudentId').value = s.id;
            document.getElementById('editNamaLengkap').value = s.name || '';
            document.getElementById('editClassName').value = s.className || '';
            document.getElementById('editNisn').value = s.nisn || s.username || '';
            document.getElementById('editNis').value = s.nis || '';
            document.getElementById('editGender').value = (s.gender === 'P' || s.gender === 'Perempuan') ? 'Perempuan' : 'Laki-laki';
            document.getElementById('editPob').value = s.pob || '';
            document.getElementById('editDob').value = s.dob || '';
            document.getElementById('editReligion').value = s.religion || 'Islam';
            document.getElementById('editStatusKeluarga').value = s.statusDalamKeluarga || 'Anak Kandung';
            document.getElementById('editAnakKe').value = s.anakKe || 1;
            document.getElementById('editAlamat').value = s.alamat || s.address || '';
            document.getElementById('editRt').value = s.rt || '';
            document.getElementById('editRw').value = s.rw || '';
            document.getElementById('editDusun').value = s.dusun || '';
            document.getElementById('editDesa').value = s.desa || '';
            document.getElementById('editKecamatan').value = s.kecamatan || '';
            document.getElementById('editKabupaten').value = s.kabupaten || 'Tulungagung';
            document.getElementById('editKodePos').value = s.kodePos || '';
            document.getElementById('editTeleponRumah').value = s.teleponRumah || '';
            document.getElementById('editSekolahAsal').value = s.sekolahAsal || '';
            document.getElementById('editDiterimaTanggal').value = s.diterimaTanggal || '15 Juli 2024';
            document.getElementById('editNamaAyah').value = s.namaAyah || s.fatherName || '';
            document.getElementById('editPekerjaanAyah').value = s.pekerjaanAyah || '';
            document.getElementById('editNamaIbu').value = s.namaIbu || s.motherName || '';
            document.getElementById('editPekerjaanIbu').value = s.pekerjaanIbu || '';
            document.getElementById('editAlamatOrtu').value = s.alamatOrtu || s.alamat || s.address || '';
            document.getElementById('editTeleponOrtu').value = s.teleponOrtu || s.parentPhone || '';
            document.getElementById('editNamaWali').value = s.namaWali || '';
            document.getElementById('editPekerjaanWali').value = s.pekerjaanWali || '';
            document.getElementById('editAlamatWali').value = s.alamatWali || '';
            document.getElementById('editTeleponWali').value = s.teleponWali || '';

            document.getElementById('modalEditStudent').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('modalEditStudent').classList.add('hidden');
        }

        async function saveStudentChanges(e) {
            e.preventDefault();
            const payload = {
                studentId: document.getElementById('editStudentId').value,
                namaLengkap: document.getElementById('editNamaLengkap').value,
                className: document.getElementById('editClassName').value,
                nisn: document.getElementById('editNisn').value,
                nis: document.getElementById('editNis').value,
                gender: document.getElementById('editGender').value,
                pob: document.getElementById('editPob').value,
                dob: document.getElementById('editDob').value,
                religion: document.getElementById('editReligion').value,
                statusDalamKeluarga: document.getElementById('editStatusKeluarga').value,
                anakKe: document.getElementById('editAnakKe').value,
                alamat: document.getElementById('editAlamat').value,
                rt: document.getElementById('editRt').value,
                rw: document.getElementById('editRw').value,
                dusun: document.getElementById('editDusun').value,
                desa: document.getElementById('editDesa').value,
                kecamatan: document.getElementById('editKecamatan').value,
                kabupaten: document.getElementById('editKabupaten').value,
                kodePos: document.getElementById('editKodePos').value,
                teleponRumah: document.getElementById('editTeleponRumah').value,
                sekolahAsal: document.getElementById('editSekolahAsal').value,
                diterimaTanggal: document.getElementById('editDiterimaTanggal').value,
                namaAyah: document.getElementById('editNamaAyah').value,
                pekerjaanAyah: document.getElementById('editPekerjaanAyah').value,
                namaIbu: document.getElementById('editNamaIbu').value,
                pekerjaanIbu: document.getElementById('editPekerjaanIbu').value,
                alamatOrtu: document.getElementById('editAlamatOrtu').value,
                teleponOrtu: document.getElementById('editTeleponOrtu').value,
                namaWali: document.getElementById('editNamaWali').value,
                pekerjaanWali: document.getElementById('editPekerjaanWali').value,
                alamatWali: document.getElementById('editAlamatWali').value,
                teleponWali: document.getElementById('editTeleponWali').value
            };

            try {
                const res = await fetch('/api/dapodik/update-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) {
                    alert('✅ ' + result.message);
                    closeEditModal();
                    loadDapodikStudents();
                    loadSummaryStats();
                } else {
                    alert('❌ ' + (result.message || 'Gagal menyimpan pembetulan data'));
                }
            } catch (err) {
                alert('❌ Terjadi kesalahan koneksi server');
            }
        }

        function openImportModal() {
            selectedExcelFile = null;
            document.getElementById('labelFileName').textContent = 'Klik untuk memilih file spreadsheet (.xlsx / .csv)';
            document.getElementById('btnConfirmImport').disabled = true;
            document.getElementById('importLoading').classList.add('hidden');
            document.getElementById('modalImport').classList.remove('hidden');
        }

        function closeImportModal() {
            document.getElementById('modalImport').classList.add('hidden');
        }

        function handleFileSelected(e) {
            const file = e.target.files[0];
            if (file) {
                selectedExcelFile = file;
                document.getElementById('labelFileName').textContent = `📄 File terpilih: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                document.getElementById('btnConfirmImport').disabled = false;
            }
        }

        async function processExcelImport() {
            if (!selectedExcelFile) return;

            const formData = new FormData();
            formData.append('file', selectedExcelFile);

            document.getElementById('importLoading').classList.remove('hidden');
            document.getElementById('btnConfirmImport').disabled = true;

            try {
                const res = await fetch('/api/dapodik/import-excel', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();
                document.getElementById('importLoading').classList.add('hidden');
                if (result.success) {
                    alert('🎉 ' + result.message);
                    closeImportModal();
                    loadDapodikStudents();
                    loadSummaryStats();
                } else {
                    alert('❌ ' + (result.message || 'Gagal mengimpor spreadsheet'));
                    document.getElementById('btnConfirmImport').disabled = false;
                }
            } catch (err) {
                document.getElementById('importLoading').classList.add('hidden');
                document.getElementById('btnConfirmImport').disabled = false;
                alert('❌ Terjadi kendala saat mengunggah file ke server: ' + err.message);
            }
        }
    </script>
</body>
</html>
