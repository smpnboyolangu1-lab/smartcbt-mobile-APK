<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top App Bar with Colorful Indigo Gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_operator"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackOperator"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOpTopTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Dashboard Operator Sekolah"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOpTopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approval Izin Guru • Broadcast PDF • CBT • Reset Device"
                    android:textColor="#C7D2FE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSwitchToTeacherMode"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_btn_amber_rounded"
                android:paddingHorizontal="12dp"
                android:text="✨"
                android:textColor="#1E1B4B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCheckUpdateOperator"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_amber_rounded"
                android:paddingHorizontal="10dp"
                android:text="✨"
                android:textColor="#1E1B4B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Scrollable Pill Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 0: Izin Guru -->
            <LinearLayout
                android:id="@+id/tabBtnOpLeaves"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="#312E81"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvTabOpLeaves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 1: Broadcast PDF -->
            <LinearLayout
                android:id="@+id/tabBtnOpBroadcast"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvTabOpBroadcast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tab 2: Token CBT -->
            <LinearLayout
                android:id="@+id/tabBtnOpCbt"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvTabOpCbt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tab 3: Reset Device -->
            <LinearLayout
                android:id="@+id/tabBtnOpDevice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvTabOpDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tab 4: Jadwal Sholat -->
            <LinearLayout
                android:id="@+id/tabBtnOpPrayer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvTabOpPrayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tab 5: Rekap Presensi PDF -->
            <LinearLayout
                android:id="@+id/tabBtnOpAttendancePdf"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvTabOpAttendancePdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= TAB 0: APPROVAL IZIN GURU ================= -->
            <LinearLayout
                android:id="@+id/containerTabOpLeaves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textColor="#312E81"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOpLeavesSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Izin yang disetujui otomatis meneruskan tugas mandiri ke Posko Guru Piket"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnRefreshOpLeaves"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="#EEF2FF"
                            android:text="✨"
                            android:textColor="#312E81"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/llOpLeavesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ================= TAB 1: BROADCAST RESMI & PDF ================= -->
            <LinearLayout
                android:id="@+id/containerTabOpBroadcast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textColor="#312E81"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Kirim pengumuman langsung ke portal dan APK siswa/orang tua dengan lampiran PDF resmi"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etOpBroadcastTitle"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:background="#F1F5F9"
                            android:hint="Judul Pengumuman / Surat Resmi"
                            android:paddingHorizontal="14dp"
                            android:textSize="12.5sp" />

                        <EditText
                            android:id="@+id/etOpBroadcastMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="#F1F5F9"
                            android:gravity="top"
                            android:hint="Isi pengumuman / ringkasan edaran surat..."
                            android:minLines="3"
                            android:padding="14dp"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Target Sasaran Pengumuman:"
                            android:textColor="#334155"
                            android:textSize="11.5sp" />

                        <Spinner
                            android:id="@+id/spinnerOpBroadcastTarget"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@android:drawable/btn_dropdown" />

                        <EditText
                            android:id="@+id/etOpBroadcastClass"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="#F1F5F9"
                            android:hint="Nama Kelas (Contoh: VII-A)"
                            android:paddingHorizontal="14dp"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#F8FAFC"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <Button
                                android:id="@+id/btnOpPickPdf"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="#4338CA"
                                android:text="✨"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvOpPdfFileName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Belum ada file PDF dipilih"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnOpSendBroadcast"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#312E81"
                            android:text="✨"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="✨"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llOpBroadcastHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ================= TAB 2: TOKEN & SESI CBT ================= -->
            <LinearLayout
                android:id="@+id/containerTabOpCbt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textColor="#312E81"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pantau ujian aktif dan kelola token ruang ujian CBT secara real-time"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnRefreshOpCbt"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="#EEF2FF"
                            android:text="✨"
                            android:textColor="#312E81"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/llOpCbtExamsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ================= TAB 3: RESET DEVICE & KELOLA SISWA ================= -->
            <LinearLayout
                android:id="@+id/containerTabOpDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textColor="#312E81"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Reset kunci perangkat, buka kunci biodata orang tua untuk perbaikan data, atau ubah status Siswa Tanpa HP"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etOpDeviceStudentQuery"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="14dp"
                            android:background="#F1F5F9"
                            android:hint="Ketik NISN atau Username Siswa"
                            android:paddingHorizontal="14dp"
                            android:textSize="12.5sp" />

                        <!-- Tombol 1: Reset Device -->
                        <Button
                            android:id="@+id/btnOpDoResetDevice"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#059669"
                            android:text="✨"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Tombol 2: Unlock Biodata -->
                        <Button
                            android:id="@+id/btnOpUnlockBiodata"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#3B82F6"
                            android:text="✨"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Tombol 3: Toggle Tanpa HP -->
                        <Button
                            android:id="@+id/btnOpToggleNoPhone"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#F59E0B"
                            android:text="✨"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#F8FAFC"
                            android:padding="10dp"
                            android:text="✨"
                            android:textColor="#475569"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ================= TAB 4: KELOLA JADWAL SHOLAT ================= -->
            <LinearLayout
                android:id="@+id/containerTabOpPrayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕌 ROTASI JADWAL SHOLAT BERJAMAAH MASJID"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Atur rotasi giliran kelas sholat berjamaah di masjid per hari"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Pilih Hari:"
                            android:textColor="#334155"
                            android:textSize="11.5sp" />

                        <Spinner
                            android:id="@+id/spinnerOpPrayerDay"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@android:drawable/btn_dropdown" />

                        <!-- Live Summary Badge -->
                        <TextView
                            android:id="@+id/tvOpPrayerSummaryBadge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="#ECFDF5"
                            android:padding="8dp"
                            android:text="🕌 Pilih Rombel Terjadwal (Per Tingkat &amp; Centang Kelas)"
                            android:textColor="#065F46"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <!-- Quick Grade Selection Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnOpQuickAll7"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="#0284C7"
                                android:padding="0dp"
                                android:text="+ VII (11)"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnOpQuickAll8"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="#4F46E5"
                                android:padding="0dp"
                                android:text="+ VIII (11)"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnOpQuickAll9"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:backgroundTint="#7C3AED"
                                android:padding="0dp"
                                android:text="+ IX (11)"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnOpQuickAllMale"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="#059669"
                                android:padding="0dp"
                                android:text="🕌 Putra (JUMAT)"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnOpQuickClear"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:backgroundTint="#DC2626"
                                android:padding="0dp"
                                android:text="🔄 Bersihkan"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Dynamic Checkboxes Container for Grades VII, VIII, IX -->
                        <LinearLayout
                            android:id="@+id/llOpPrayerCheckboxesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <EditText
                            android:id="@+id/etOpPrayerClasses"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:background="#F1F5F9"
                            android:hint="Rombel terpilih otomatis tersinkron di sini"
                            android:paddingHorizontal="14dp"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnOpSavePrayerSchedule"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#059669"
                            android:text="💾 Simpan Jadwal Rotasi Sholat"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/llOpPrayerTodayInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- TAB 5 CONTAINER: REKAP PRESENSI PDF LENGKAP -->
            <LinearLayout
                android:id="@+id/containerTabOpAttendancePdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📄 Unduh Laporan Rekap Presensi Siswa (A4)"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Dokumen laporan presensi resmi SMPN 1 Boyolangu. Dilengkapi rekapitulasi kehadiran per kelas, status hadir, terlambat, sakit, izin, dan alpa."
                            android:textColor="#64748B"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Pilih Cakupan Laporan (Scope):"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinnerOpPdfScope"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp" />

                        <TextView
                            android:id="@+id/tvOpPdfClassLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pilih Rombel Kelas:"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <Spinner
                            android:id="@+id/spinnerOpPdfClass"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnOpPrintPdf"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:backgroundTint="#0284C7"
                            android:text="✨"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnOpOpenBrowserPdf"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#059669"
                            android:text="✨"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer Konsisten Sistem -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Smart CBT v1.0.0 • SMP Negeri 1 Boyolangu"
        android:textColor="#94A3B8"
        android:textSize="11sp" />
</LinearLayout>