<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Banner (Deep Crimson & Navy Gradient Feel) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#991B1B"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="26dp"
                android:paddingBottom="22dp"
                android:paddingHorizontal="20dp">

                <!-- Glowing Icon Ring -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_translucent_white"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁"
                        android:textSize="36sp" />
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#DC2626"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:text="🚨 PERINGATAN INTEGRITAS SISTEM CBT"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Main Title -->
                <TextView
                    android:id="@+id/tvMandatoryFileTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AKSES SEMUA FILE WAJIB - INTEGRITAS UJIAN CBT"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- Subtitle: Keterangan jelas ketika di disable -->
                <TextView
                    android:id="@+id/tvMandatoryFileSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Akses semua file untuk CBT ujian belum di-enable!"
                    android:textColor="#FEE2E2"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Body Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Alert Disabled Features Notice Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FEF2F2"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ STATUS: SELURUH FITUR APLIKASI DI-DISABLE"
                        android:textColor="#991B1B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Akses semua file untuk CBT ujian belum di-enable. Fitur Ujian CBT, Materi Belajar, Tugas Siswa, Presensi Scanner, dan E-Library dinonaktifkan total sampai izin diaktifkan."
                        android:textColor="#7F1D1D"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Explanation Box: Peruntukan Izin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#EFF6FF"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peruntukan Wajib Izin Berkas Sekolah:"
                        android:textColor="#1E40AF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- Item 1: CBT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 "
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Integritas Ujian CBT: Penguncian bank soal terenkripsi &amp; proteksi anti-modifikasi storage lembar jawaban siswa."
                            android:textColor="#334155"
                            android:textSize="11.5sp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>

                    <!-- Item 2: Tugas & Materi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📂 "
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Materi Belajar &amp; Tugas: Pengunduhan modul KBM guru dan pengunggahan berkas jawaban tugas sekolah."
                            android:textColor="#334155"
                            android:textSize="11.5sp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>

                    <!-- Item 3: Remote Sync -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ "
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Keamanan &amp; Verifikasi: Menghubungkan perangkat siswa ke dashboard sekolah &amp; memastikan bebas dari aplikasi joki/injeksi."
                            android:textColor="#334155"
                            android:textSize="11.5sp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Helpful Info Notice Box (Auto-enable notice) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#F0FDF4"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="18sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Jika posisi di-enable akses semua file, maka otomatis SEMUA FITUR APLIKASI AKAN DI-ENABLE dan siap digunakan."
                        android:textColor="#166534"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="1dp" />
                </LinearLayout>

                <!-- Action Button 1 (Activate) -->
                <Button
                    android:id="@+id/btnActivateAllFilesAccess"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#2563EB"
                    android:text="BERIKAN IZIN SEMUA FILE SEKARANG"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

                <!-- Action Button 2 (Exit) -->
                <Button
                    android:id="@+id/btnExitApp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#F1F5F9"
                    android:text="Keluar Dari Aplikasi"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
