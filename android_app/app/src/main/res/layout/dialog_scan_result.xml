<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Banner (Fixed Header) -->
        <LinearLayout
            android:id="@+id/layoutHeaderBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#059669"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="22dp">

            <TextView
                android:id="@+id/tvScanResultIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_white_alpha"
                android:gravity="center"
                android:text="✓"
                android:textColor="#059669"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScanResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Presensi Berhasil Dicatat!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvScanResultSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Data kehadiran terverifikasi &amp; tersimpan di sistem"
                android:textColor="#D1FAE5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Scrollable Body Content (Guarantees content never pushes buttons behind system navbar) -->
        <ScrollView
            android:id="@+id/scrollScanResultContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <!-- Scan Type Label -->
                <TextView
                    android:id="@+id/tvScanTypeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="PRESENSI MASUK PAGI"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Student Profile Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F8FAFC"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginBottom="10dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#E2E8F0">

                            <ImageView
                                android:id="@+id/ivStudentPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_avatar_placeholder"
                                android:contentDescription="Foto Siswa" />

                            <TextView
                                android:id="@+id/tvStudentAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#059669"
                                android:gravity="center"
                                android:text="S"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Siswa"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvStudentClassNisn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelas VII-A • NISN: 12345678"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:gravity="center" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <!-- Receipt Detail Rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Waktu row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Waktu Presensi"
                            android:textColor="#64748B"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvScanTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="07:12:45 WIB"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGateTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- Location row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lokasi"
                            android:textColor="#64748B"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvLocationVerified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Terverifikasi di Lingkungan Sekolah"
                            android:textColor="#059669"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:gravity="end" />

                        <TextView
                            android:id="@+id/tvGpsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Duration Info (optional) -->
                    <LinearLayout
                        android:id="@+id/layoutDurationInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Durasi di Sekolah"
                            android:textColor="#64748B"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvDurationInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7 Jam 30 Menit"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Late Info (optional) -->
                    <LinearLayout
                        android:id="@+id/layoutLateInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Keterlambatan"
                            android:textColor="#64748B"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvLateInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terlambat 15 Menit"
                            android:textColor="#DC2626"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <!-- Parent Notification Area -->
                <LinearLayout
                    android:id="@+id/layoutParentNotifBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F0FDF4"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvParentNotifText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Notifikasi Terkirim ke Orang Tua"
                            android:textColor="#166534"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvParentNotifDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="24dp"
                        android:text="Notifikasi resmi telah diteruskan via WhatsApp."
                        android:textColor="#166534"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Message Detail Description -->
                <TextView
                    android:id="@+id/tvScanResultMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#F1F5F9"
                    android:padding="12dp"
                    android:text="Keterangan presensi..."
                    android:textColor="#334155"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Fixed Bottom Action Bar (Pinned, Always fully visible above System Navbar) -->
        <LinearLayout
            android:id="@+id/layoutDialogBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnScanResultSecondary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:backgroundTint="#F1F5F9"
                android:text="🔄 Scan Ulang"
                android:textAllCaps="false"
                android:textColor="#1E293B"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="26dp" />

            <Button
                android:id="@+id/btnScanResultPrimary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.2"
                android:backgroundTint="#059669"
                android:text="🏠 Tutup &amp; Dashboard"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>