<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar Inisial -->
            <TextView
                android:id="@+id/tvStudentAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_badge_rounded"
                android:gravity="center"
                android:text="A"
                android:textColor="#0F766E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Nama Siswa Lengkap"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudentOfficerRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="Ketua"
                        android:textColor="#0F766E"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStudentNisn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NISN: 0012345678 • Poin: 0"
                    android:textColor="#64748B"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Status Presensi Hari Ini Badge -->
            <TextView
                android:id="@+id/tvAttendanceStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="🟢 Hadir"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Garis Divider & Tombol Aksi -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#F1F5F9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAttendanceTimes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="In: 06:45 • Out: --:--"
                android:textColor="#475569"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnStudentPdf"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#EDE9FE"
                android:text="📂 Berkas"
                android:textColor="#5B21B6"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStudentManual"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0284C7"
                android:text="✍️ Absen"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnStudentWa"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chat WhatsApp Orang Tua"
                android:src="@android:drawable/stat_notify_chat"
                app:tint="#16A34A" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
