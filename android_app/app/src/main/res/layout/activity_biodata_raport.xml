                                    android:layout_height="wrap_content"
                                    android:text="8. Alamat Peserta Didik"
                                    android:textColor="#334155"
                                    android:textSize="12.5sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" : "
