                                    android:layout_width="145dp"
                                    android:layout_height="wrap_content"
                                    android:text="7. Anak ke"
                                    android:textColor="#334155"
                                    android:textSize="12.5sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
