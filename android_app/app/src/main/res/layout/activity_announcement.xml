<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3A8A"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackAnnouncement"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢 Pusat Pengumuman Sekolah"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAnnouncementSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seluruh informasi &amp; surat edaran resmi"
                android:textColor="#BFDBFE"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnRefreshAnnouncement"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Muat Ulang"
            android:padding="4dp"
            android:src="@drawable/ic_refresh"
            app:tint="#FFFFFF" />

        <Button
            android:id="@+id/btnUpdateAnnouncement"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="🔄 Update"
            android:textSize="11sp"
            android:textColor="#1E3A8A"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_amber_rounded"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Search Input & Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/etSearchAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#F1F5F9"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Cari judul pengumuman, ujian, jadwal..."
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <!-- Category Horizontal Scroll Filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerCategoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCatAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#1E3A8A"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Semua"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCatImportant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="📌 PENTING"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCatExam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="📝 UJIAN"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCatAcademic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="🎓 AKADEMIK"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCatGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="📢 UMUM"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Announcement List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>
</LinearLayout>
