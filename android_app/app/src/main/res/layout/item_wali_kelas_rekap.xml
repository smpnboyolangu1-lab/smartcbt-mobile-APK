<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRekapNo"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="1."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRekapName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nama Siswa"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRekapPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="100%"
                android:textColor="#0F766E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- H -->
            <TextView
                android:id="@+id/tvRekapH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="H: 20"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- ? (Tdk Scan Pulang) -->
            <TextView
                android:id="@+id/tvRekapQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="?: 0"
                android:textColor="#0369A1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- T -->
            <TextView
                android:id="@+id/tvRekapT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="T: 0"
                android:textColor="#B45309"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- S -->
            <TextView
                android:id="@+id/tvRekapS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="S: 0"
                android:textColor="#1E40AF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- I -->
            <TextView
                android:id="@+id/tvRekapI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="I: 0"
                android:textColor="#6B21A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- A -->
            <TextView
                android:id="@+id/tvRekapA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="A: 0"
                android:textColor="#B91C1C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnRekapItemDetail"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:backgroundTint="#0F766E"
                android:text="📄 Detail"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
