<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top E-Commerce App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1B4B"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackEkskul"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEkskulTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EKSTRAKURIKULER"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvEkskulSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMPN 1 Boyolangu • Pengembangan Bakat &amp; Prestasi"
                    android:textColor="#C7D2FE"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Status Ekskul Terdaftar Pill -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCartEkskul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#312E81"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCartCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Ekskul Saya: 0/2"
                        android:textColor="#FDE047"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Search Bar E-Commerce Style -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="21dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etSearchEkskul"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Cari futsal, basket, pramuka, pembina, hari..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Navigation Segment Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/tabCatalog"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#4F46E5"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🏆 Pilihan Ekstra"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabMyRegistrations"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="📋 Ekstra Saya"
                android:textColor="#475569"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tabSchedule"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="📅 Jadwal &amp; Presensi"
                android:textColor="#475569"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tabPortfolio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🎖️ Portofolio"
                android:textColor="#475569"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Sections -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. SECTION KATALOG PRODUK -->
            <LinearLayout
                android:id="@+id/sectionCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Hero Promo Banner Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#4F46E5"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#4338CA"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="EKSTRAKURIKULER UNGGULAN SPENBOY"
                                android:textColor="#FDE047"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐ RESMI SEKOLAH"
                                android:textColor="#A5B4FC"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Kembangkan Bakat &amp; Raih Juara!"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pilih maksimal 2 ekstrakurikuler unggulan SMPN 1 Boyolangu. Pelatihan intensif bersama pembina &amp; pelatih profesional."
                            android:textColor="#E0E7FF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Category Chips Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutCategoryChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#1E1B4B"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Semua (11)"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/chipSports"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#F1F5F9"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="⚽ Olahraga (3)"
                            android:textColor="#475569"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/chipArts"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#F1F5F9"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="🎨 Seni &amp; Musik (2)"
                            android:textColor="#475569"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/chipLeadership"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#F1F5F9"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="⛺ PMR &amp; Pramuka (3)"
                            android:textColor="#475569"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/chipAcademic"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#F1F5F9"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="🔬 KIR &amp; Sains (1)"
                            android:textColor="#475569"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/chipLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#F1F5F9"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="🗣️ English Club (1)"
                            android:textColor="#475569"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/chipReligion"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:backgroundTint="#F1F5F9"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="🕌 Rohis (1)"
                            android:textColor="#475569"
                            android:textSize="10sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCatalogCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DAFTAR PILIHAN RESMI (11)"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maksimal 2 Pilihan"
                        android:textColor="#6366F1"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2-Column Grid Layout Programmatic Container -->
                <LinearLayout
                    android:id="@+id/containerProductGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 2. SECTION PENDAFTARAN SAYA (ORDERS / CART TRACKER) -->
            <LinearLayout
                android:id="@+id/sectionMyRegistrations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#FEF3C7"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ℹ️"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Sesuai kebijakan kurikulum SMPN 1 Boyolangu, setiap siswa terdaftar maksimal 2 ekstrakurikuler. Pendaftaran akan ditinjau oleh Pembina masing-masing."
                            android:textColor="#92400E"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/containerMyEkskulList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 3. SECTION JADWAL & PRESENSI QR (REVAMP PROFESIONAL) -->
            <LinearLayout
                android:id="@+id/sectionSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- 🪪 KARTU DIGITAL PRESENSI RESMI SISWA -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#1E1B4B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#312E81"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="SMPN 1 BOYOLANGU"
                                android:textColor="#FDE047"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#065F46"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="✓ PESERTA AKTIF 2026/2027"
                                android:textColor="#6EE7B7"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvScheduleStudentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Nama Peserta Didik"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScheduleStudentInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="NISN: - • Kelas: -"
                            android:textColor="#C7D2FE"
                            android:textSize="11.5sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="#312E81" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📲 Sistem Presensi Berbasis QR Dinamis Pembina"
                                android:textColor="#94A3B8"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 📷 ACTION CARD SCAN QR KEHADIRAN SESI LATIHAN -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardScanQrAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#047857"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 SCAN QR PRESENSI LATIHAN"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Pindai QR Token yang dibuka oleh Pembina atau Pelatih di lokasi kegiatan"
                            android:textColor="#D1FAE5"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 🗓️ HEADER AGENDA LATIHAN MINGGUAN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🗓️ JADWAL &amp; AGENDA LATIHAN MINGGUAN"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terverifikasi"
                        android:textColor="#059669"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerScheduleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 4. SECTION PORTOFOLIO & PRESTASI -->
            <LinearLayout
                android:id="@+id/sectionPortfolio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🏆 PRESTASI &amp; KEJUARAAN SAYA"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerPortfolioList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
