<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Top Security Command Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_satpam"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="🛡️"
                android:textSize="22sp"
                android:background="#334155" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSatpamHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POS KEAMANAN &amp; GATEPASS"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSatpamOfficerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petugas Satpam • SMPN 1 Boyolangu"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSatpamRefresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔄"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSatpamUpdateApp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Update"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSatpamLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Keluar"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DC2626" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvSatpamLiveClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏰ --:--:-- WIB"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSatpamSwitchRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Pindah Role"
                android:textColor="#FDE047"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- KPI Summary Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="14dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <TextView
                            android:id="@+id/tvStatWaitingExit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#F59E0B"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Siap Keluar"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <TextView
                            android:id="@+id/tvStatOutside"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#EF4444"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Di Luar"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <TextView
                            android:id="@+id/tvStatReturned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#38BDF8"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kembali"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">
                        <TextView
                            android:id="@+id/tvStatTotalToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#10B981"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Izin"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Scanner Action Cards -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️ SCANNER GERBANG &amp; POS KEAMANAN"
                        android:textColor="#38BDF8"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnScanCheckoutGatepass"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🚪 SCAN QR GATEPASS KELUAR (PULANG SAKIT / DISPENSASI)"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="#DC2626"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnScanReturnGatepass"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:text="🏫 SCAN KEMBALI"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:backgroundTint="#0284C7" />

                        <Button
                            android:id="@+id/btnManualTokenGatepass"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:text="⌨️ INPUT KODE TOKEN"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:backgroundTint="#475569" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Filter Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Semua Hari Ini"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2563EB"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnFilterWaiting"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Siap Keluar (Approved BK)"
                        android:textSize="11sp"
                        android:textColor="#CBD5E1"
                        android:backgroundTint="#334155"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnFilterOutside"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Sedang Di Luar"
                        android:textSize="11sp"
                        android:textColor="#CBD5E1"
                        android:backgroundTint="#334155" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvSatpamListSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Daftar Gatepass Siswa Hari Ini"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Container for Gatepass Cards -->
            <LinearLayout
                android:id="@+id/llSatpamGatepassContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

        <!-- Footer Konsisten Sistem -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Smart CBT v1.0.0 • SMP Negeri 1 Boyolangu"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
</LinearLayout>
