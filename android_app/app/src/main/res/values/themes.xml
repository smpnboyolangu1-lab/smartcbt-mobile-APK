<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Material 3 Theme -->
    <style name="Theme.SmartCBT" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Shared colors -->
        <item name="android:colorBackground">@color/colorBackgroundLight</item>
        <item name="colorSurface">@color/colorSurfaceLight</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <!-- Typography, shapes, etc. inherit defaults from Material3 -->
    </style>

    <style name="Theme.SmartCBT.NoActionBar" parent="Theme.SmartCBT" />

    <!-- Role‑specific overlay themes -->
    <style name="Theme.SmartCBT.Teacher" parent="Theme.SmartCBT">
        <item name="colorPrimary">@color/colorPrimaryTeacher</item>
        <item name="colorSecondary">@color/colorSecondaryTeacher</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryTeacher</item>
    </style>

    <style name="Theme.SmartCBT.Student" parent="Theme.SmartCBT">
        <item name="colorPrimary">@color/colorPrimaryStudent</item>
        <item name="colorSecondary">@color/colorSecondaryStudent</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryStudent</item>
    </style>

    <style name="Theme.SmartCBT.Parent" parent="Theme.SmartCBT">
        <item name="colorPrimary">@color/colorPrimaryParent</item>
        <item name="colorSecondary">@color/colorSecondaryParent</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryParent</item>
    </style>

    <style name="Theme.SmartCBT.Admin" parent="Theme.SmartCBT">
        <item name="colorPrimary">@color/colorPrimaryAdmin</item>
        <item name="colorSecondary">@color/colorSecondaryAdmin</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryAdmin</item>
    </style>
</resources>
